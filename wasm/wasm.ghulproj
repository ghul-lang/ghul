<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Exe (with a stub entry()) rather than Library: the ghūl toolchain only
         emits executables for ordinary projects. Nothing in the compiler calls
         this code, so the project exists to be built, tested and reasoned
         about on its own. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>

    <!-- The ghūl toolchain emits no PDB; without this, pack fails looking
         for one. Not packed today: no external consumer is in view, so
         there is no PackageId and no pack step. -->
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="src/**/*.ghul" />

    <!-- Terminator-free sources; an error everywhere so stray `;`
         cannot creep back in. Same arrangement as ghul.ghulproj. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" />
  </ItemGroup>
</Project>
