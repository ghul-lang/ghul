<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Referenced by the compiler, whose WasmGC backend writes modules
         through it, and shipped inside the ghul.compiler package. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>

    <!-- The ghūl toolchain emits no PDB; without this, pack fails looking
         for one. Not packed on its own: it reaches users inside the
         compiler package. -->
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="src/**/*.ghul" />

    <!-- Terminator-free sources; an error everywhere so stray `;`
         cannot creep back in. Same arrangement as ghul.ghulproj. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" />
  </ItemGroup>
</Project>
