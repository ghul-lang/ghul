namespace Wasm is
    // A name and the index it names, which is one entry of a name map.
    class NAMED_INDEX is
        index: int
        name: string

        init(index: int, name: string) is
            self.index = index
            self.name = name
        si
    si

    // The names of one index space, in increasing index order.
    class NAME_MAP is
        _entries: Collections.LIST[NAMED_INDEX]

        init() is
            _entries = Collections.LIST[NAMED_INDEX]()
        si

        init(entries: NAMED_INDEX[]) is
            _entries = Collections.LIST[NAMED_INDEX]()

            for entry in entries do
                _entries.add(entry)
            od
        si

        add(index: int, name: string) is
            _entries.add(NAMED_INDEX(index, name))
        si

        // The name an index carries, or absence when it has none.
        name_of(index: int) -> string? is
            for entry in _entries do
                if entry.index == index then
                    return entry.name
                fi
            od

            return null
        si

        // The bytes the section is written as, which is what a module
        // carries behind the name it is filed under.
        bytes() -> ubyte[] is
            let buffer = BYTE_BUFFER()

            write(buffer)

            return buffer.to_array()
        si

        write(buffer: BYTE_BUFFER) is
            buffer.write_length(_entries.count)

            for entry in _entries do
                buffer.write_u32(entry.index)
                buffer.write_name(entry.name)
            od
        si

        // Reads a name map back from the bytes `write` produces. Entries
        // come back in the order they were written, which is the index
        // order the format asks for.
        of_bytes(bytes: ubyte[]) -> NAME_MAP static is
            return of_cursor(_NAME_CURSOR(bytes))
        si

        // Reads a name map from a cursor shared with whatever encloses
        // it, which is how a part of a section reads its own.
        of_cursor(cursor: _NAME_CURSOR) -> NAME_MAP static is
            let result = NAME_MAP()
            let count = cursor.read_u32()
            let i mut = 0

            while i < count do
                let index = cursor.read_u32()

                result.add(index, cursor.read_name())

                i = i + 1
            od

            return result
        si
    si

    // The names of the locals of one function, which is a name map and
    // the function it belongs to.
    class LOCAL_NAME_MAP is
        function_index: int
        locals: NAME_MAP

        init(function_index: int, locals: NAME_MAP) is
            self.function_index = function_index
            self.locals = locals
        si
    si

    // The name section: the module's own name, the names of its
    // functions and the names of their locals.
    //
    // It is a custom section rather than a section of its own, so a
    // reader that does not know the name skips it and loses nothing but
    // the names. The three parts are optional and written in the order
    // of the identifiers the format gives them, which is the order a
    // reader expects them in.
    class NAME_SECTION is
        _module_name: string?
        _function_names: NAME_MAP?
        _local_names: Collections.LIST[LOCAL_NAME_MAP]?

        init() is si

        // Each part is set on the section rather than replacing it, so
        // that a section carrying all three is built by chaining.
        with_module_name(name: string) -> NAME_SECTION is
            _module_name = name

            return self
        si

        with_functions(function_names: NAME_MAP) -> NAME_SECTION is
            _function_names = function_names

            return self
        si

        add_locals(function_index: int, locals: NAME_MAP) -> NAME_SECTION is
            if !(_local_names?) then
                _local_names = Collections.LIST[LOCAL_NAME_MAP]()
            fi

            _local_names!.add(LOCAL_NAME_MAP(function_index, locals))

            return self
        si

        module_name() -> string is
            if let name = _module_name then
                return name
            fi

            return ""
        si

        // The function names, or absence when the section has none.
        function_names() -> NAME_MAP? => _function_names

        // The per-function local names, or absence when it has none.
        local_maps() -> Collections.LIST[LOCAL_NAME_MAP]? => _local_names

        // The bytes the section is written as, which is what a module
        // carries behind the name it is filed under.
        bytes() -> ubyte[] is
            let buffer = BYTE_BUFFER()

            write(buffer)

            return buffer.to_array()
        si

        // Reads a name section back from the bytes `write` produces, or
        // from any section shaped as the format gives it: a run of
        // subsections, each an identifier, a size and the part it
        // introduces. Subsections the format gains later are skipped by
        // their size, which is what the size is for.
        of_bytes(bytes: ubyte[]) -> NAME_SECTION static is
            let cursor = _NAME_CURSOR(bytes)
            let result = NAME_SECTION()

            while !cursor.at_end() do
                let id = cursor.read_byte()
                let part = cursor.read_bytes(cursor.read_u32())

                if id == 0x00ub then
                    result._module_name = _NAME_CURSOR(part).read_name()
                elif id == 0x01ub then
                    result._function_names = NAME_MAP.of_bytes(part)
                elif id == 0x02ub then
                    result._local_names = _read_local_maps(part)
                fi
            od

            return result
        si

        // The local names of one subsection: a run of functions, each an
        // index and a name map that runs to the next one, which is why
        // the maps are read off the cursor the function indexes share.
        _read_local_maps(bytes: ubyte[]) -> Collections.LIST[LOCAL_NAME_MAP] static is
            let cursor = _NAME_CURSOR(bytes)
            let maps = Collections.LIST[LOCAL_NAME_MAP]()
            let count = cursor.read_u32()
            let i mut = 0

            while i < count do
                let function_index = cursor.read_u32()

                maps.add(LOCAL_NAME_MAP(function_index, NAME_MAP.of_cursor(cursor)))

                i = i + 1
            od

            return maps
        si

        write(buffer: BYTE_BUFFER) is
            if let name = _module_name then
                _write_subsection(buffer, 0x00ub, name)
            fi

            if let names = _function_names then
                _write_subsection(buffer, 0x01ub, names)
            fi

            if let locals = _local_names then
                _write_subsection(buffer, 0x02ub, locals)
            fi
        si

        _write_subsection(buffer: BYTE_BUFFER, id: ubyte, name: string) is
            let content = BYTE_BUFFER()

            content.write_name(name)

            buffer.write_byte(id)
            buffer.write_length(content.length())
            buffer.write_bytes(content.to_array())
        si

        _write_subsection(buffer: BYTE_BUFFER, id: ubyte, writable: NAME_MAP) is
            let content = BYTE_BUFFER()

            writable.write(content)

            buffer.write_byte(id)
            buffer.write_length(content.length())
            buffer.write_bytes(content.to_array())
        si

        _write_subsection(buffer: BYTE_BUFFER, id: ubyte, maps: Collections.LIST[LOCAL_NAME_MAP]) is
            let content = BYTE_BUFFER()

            content.write_length(maps.count)

            for map in maps do
                content.write_u32(map.function_index)
                map.locals.write(content)
            od

            buffer.write_byte(id)
            buffer.write_length(content.length())
            buffer.write_bytes(content.to_array())
        si
    si

    // A reading cursor over a run of bytes, which is what the name
    // section and its parts are read through: unsigned integers in
    // LEB128, names as a length and that many UTF-8 bytes, and a run of
    // a known size taken whole.
    class _NAME_CURSOR is
        _bytes: ubyte[]
        _pos: int

        init(bytes: ubyte[]) is
            _bytes = bytes
            _pos = 0
        si

        at_end() -> bool => _pos >= _bytes.count

        read_byte() -> ubyte is
            let byte = _bytes[_pos]

            _pos = _pos + 1

            return byte
        si

        read_u32() -> int is
            let result mut = 0
            let shift mut = 0

            while shift < 35 do
                let byte = cast int(read_byte())

                result = result | ((byte & 0x7F) << shift)

                if byte & 0x80 == 0 then
                    return result
                fi

                shift = shift + 7
            od

            return result
        si

        read_name() -> string is
            let length = read_u32()

            return _text(read_bytes(length))
        si

        read_bytes(count: int) -> ubyte[] is
            let result = Collections.LIST[ubyte]()
            let i mut = 0

            while i < count do
                result.add(read_byte())

                i = i + 1
            od

            return result.to_array()
        si

        _text(bytes: ubyte[]) -> string static is
            return System.Text.UTF8Encoding().get_string(bytes)
        si
    si
si
