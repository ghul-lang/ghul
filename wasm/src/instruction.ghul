namespace Wasm is
    // One instruction of a function body or a constant expression.
    //
    // An instruction is an opcode and whatever immediate that opcode
    // takes, so the classes differ by immediate rather than by meaning:
    // most are the opcode alone, and the rest are an opcode and one
    // index, an opcode and a literal, or a structured body.
    //
    // Writing an instruction is writing its opcode, which every one of
    // them starts with. `write` does that, and a subclass with an
    // immediate calls it and writes the immediate after.
    class INSTRUCTION abstract is
        opcode: Opcode

        write(buffer: BYTE_BUFFER) is
            write_opcode(buffer, opcode)
        si
    si

    // An opcode with nothing behind it, which is the large majority of
    // them.
    class SIMPLE_INSTRUCTION: INSTRUCTION is
        init(opcode: Opcode) is
            self.opcode = opcode
        si
    si

    // An opcode and one index: a local, a global, a label or a function.
    class INDEX_INSTRUCTION: INSTRUCTION is
        index: int

        init(opcode: Opcode, index: int) is
            self.opcode = opcode
            self.index = index
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_u32(index)
        si
    si

    // A constant of one of the four types that carry a literal.
    class CONSTANT_INSTRUCTION: INSTRUCTION is
        init(opcode: Opcode) is
            self.opcode = opcode
        si
    si

    class I32_CONSTANT: CONSTANT_INSTRUCTION is
        value: int

        init(value: int) is
            super.init(Opcode.I32_CONST)
            self.value = value
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_i32(value)
        si
    si

    class I64_CONSTANT: CONSTANT_INSTRUCTION is
        value: long

        init(value: long) is
            super.init(Opcode.I64_CONST)
            self.value = value
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_i64(value)
        si
    si

    class F32_CONSTANT: CONSTANT_INSTRUCTION is
        value: single

        init(value: single) is
            super.init(Opcode.F32_CONST)
            self.value = value
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_f32(value)
        si
    si

    class F64_CONSTANT: CONSTANT_INSTRUCTION is
        value: double

        init(value: double) is
            super.init(Opcode.F64_CONST)
            self.value = value
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_f64(value)
        si
    si

    // `br_table` takes every label a branch can take, in order, and the
    // one it takes when none of them matched. The vector is the labels
    // alone; the default follows it rather than being counted in it.
    class BR_TABLE_INSTRUCTION: INSTRUCTION is
        _labels: int[]
        _default: int

        init(labels: int[], default_label: int) is
            self.opcode = Opcode.BR_TABLE
            _labels = labels
            _default = default_label
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_length(_labels.count)

            for label in _labels do
                buffer.write_u32(label)
            od

            buffer.write_u32(_default)
        si
    si

    // The type the callee has to have, and the table it is read from.
    // The table index is written even when it is zero, which is what
    // makes the instruction longer than the module it is in.
    class CALL_INDIRECT_INSTRUCTION: INSTRUCTION is
        type_index: int
        table_index: int

        init(type_index: int, table_index: int) is
            self.opcode = Opcode.CALL_INDIRECT
            self.type_index = type_index
            self.table_index = table_index
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_u32(type_index)
            buffer.write_u32(table_index)
        si
    si

    // `select` picks one of two values of a type it infers from the
    // values themselves, which has to be a numeric or vector type. The
    // typed form says what the type is, and is what lets `select` work
    // over a reference type.
    class TYPED_SELECT_INSTRUCTION: INSTRUCTION is
        _type: VALUE_TYPE

        init(type: VALUE_TYPE) is
            self.opcode = Opcode.SELECT_T
            _type = type
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_length(1)
            _type.write(buffer)
        si
    si

    // A structured block. The body is written as its own run of
    // instructions between the block type and the `end` that closes it.
    class BLOCK_INSTRUCTION: INSTRUCTION is
        _block_type: BLOCK_TYPE
        _body: Collections.List[INSTRUCTION]

        init(
            opcode: Opcode,
            block_type: BLOCK_TYPE,
            body: Collections.List[INSTRUCTION]
        ) is
            self.opcode = opcode
            _block_type = block_type
            _body = body
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            _block_type.write(buffer)

            write_instructions(buffer, _body)
            buffer.write_byte(cast ubyte(Opcode.END))
        si
    si

    // `if` has two bodies rather than one, since the `else` it may carry
    // sits between them and a block with no else has none to write.
    class IF_INSTRUCTION: INSTRUCTION is
        _block_type: BLOCK_TYPE
        _then: Collections.List[INSTRUCTION]
        _otherwise: Collections.List[INSTRUCTION]

        init(
            block_type: BLOCK_TYPE,
            then_branch: Collections.List[INSTRUCTION],
            else_branch: Collections.List[INSTRUCTION]
        ) is
            self.opcode = Opcode.IF
            _block_type = block_type
            _then = then_branch
            _otherwise = else_branch
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            _block_type.write(buffer)

            write_instructions(buffer, _then)

            if _otherwise.count > 0 then
                buffer.write_byte(cast ubyte(Opcode.ELSE))

                write_instructions(buffer, _otherwise)
            fi

            buffer.write_byte(cast ubyte(Opcode.END))
        si
    si


    // An opcode and a type index. Most of the structured types are
    // constructed, read and written through their type index alone, and
    // `call_ref` names a signature the same way.
    class TYPE_INSTRUCTION: INSTRUCTION is
        type_index: int

        init(opcode: Opcode, type_index: int) is
            self.opcode = opcode
            self.type_index = type_index
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_u32(type_index)
        si
    si

    // An opcode, a type index, and a second index into it: a field of a
    // struct, or a data or element segment an array is built from.
    class TYPE_FIELD_INSTRUCTION: INSTRUCTION is
        type_index: int
        field_index: int

        init(opcode: Opcode, type_index: int, field_index: int) is
            self.opcode = opcode
            self.type_index = type_index
            self.field_index = field_index
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_u32(type_index)
            buffer.write_u32(field_index)
        si
    si

    // An opcode, a type index, and a count - which for `array.new_fixed`
    // is the length of the array being built.
    class TYPE_LENGTH_INSTRUCTION: INSTRUCTION is
        type_index: int
        length: int

        init(opcode: Opcode, type_index: int, length: int) is
            self.opcode = opcode
            self.type_index = type_index
            self.length = length
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_u32(type_index)
            buffer.write_u32(length)
        si
    si

    // `array.copy` names both the type it writes and the type it reads,
    // which need not be the same.
    class TWO_TYPE_INSTRUCTION: INSTRUCTION is
        target_type_index: int
        source_type_index: int

        init(opcode: Opcode, target_type_index: int, source_type_index: int) is
            self.opcode = opcode
            self.target_type_index = target_type_index
            self.source_type_index = source_type_index
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_u32(target_type_index)
            buffer.write_u32(source_type_index)
        si
    si

    // An opcode and the heap type it names: what `ref.null` produces, and
    // what `ref.test` and `ref.cast` test against. Whether the reference
    // those last two are about can be absent is not in the heap type -
    // it is in the opcode, which is why there are four of them.
    class HEAP_TYPE_INSTRUCTION: INSTRUCTION is
        _heap_type: HEAP_TYPE

        init(opcode: Opcode, heap_type: HEAP_TYPE) is
            self.opcode = opcode
            _heap_type = heap_type
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            _heap_type.write(buffer)
        si
    si

    // `br_on_cast` and `br_on_cast_fail` take a pair of heap types and
    // a label, and the nullability of each of the two goes in a flags
    // byte ahead of the label rather than in the types themselves. The
    // low bit is the source's and the next is the target's.
    class CAST_BRANCH_INSTRUCTION: INSTRUCTION is
        label: int
        source: HEAP_TYPE
        source_nullable: bool
        target: HEAP_TYPE
        target_nullable: bool

        init(
            opcode: Opcode,
            label: int,
            source: HEAP_TYPE,
            source_nullable: bool,
            target: HEAP_TYPE,
            target_nullable: bool
        ) is
            self.opcode = opcode
            self.label = label
            self.source = source
            self.source_nullable = source_nullable
            self.target = target
            self.target_nullable = target_nullable
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            let source_bit = if source_nullable then 0x01 else 0x00 fi
            let target_bit = if target_nullable then 0x02 else 0x00 fi

            let flags = source_bit + target_bit

            buffer.write_u32(flags)
            buffer.write_u32(label)

            source.write(buffer)
            target.write(buffer)
        si
    si

    // A run of instructions, which is a function body, a block body or
    // the initialiser of a global.
    write_instructions(buffer: BYTE_BUFFER, instructions: Collections.Iterable[INSTRUCTION]) is
        for instruction in instructions do
            instruction.write(buffer)
        od
    si

    // An opcode at `0xFB00` or above is two bytes, a prefix and the
    // member's own value after it.
    write_opcode(buffer: BYTE_BUFFER, opcode: Opcode) is
        let value = cast int(opcode)

        if value >= 0xFB00 then
            buffer.write_byte(cast ubyte(value >> 8))
            buffer.write_u32(value & 0xFF)
        else
            buffer.write_byte(cast ubyte(value))
        fi
    si
    // The exception a tag describes, thrown with the values its
    // signature takes.
    class THROW_INSTRUCTION: INSTRUCTION is
        tag_index: int

        init(tag_index: int) is
            self.opcode = Opcode.THROW
            self.tag_index = tag_index
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            buffer.write_u32(tag_index)
        si
    si

    // A handler: the catch clauses it answers to, and the body they
    // guard. The clauses are written ahead of the body, which is what
    // lets a single-pass reader find them before it reads it.
    class TRY_TABLE_INSTRUCTION: INSTRUCTION is
        _block_type: BLOCK_TYPE
        _clauses: Collections.List[CATCH_CLAUSE]
        _body: Collections.List[INSTRUCTION]

        init(
            block_type: BLOCK_TYPE,
            clauses: Collections.List[CATCH_CLAUSE],
            body: Collections.List[INSTRUCTION]
        ) is
            self.opcode = Opcode.TRY_TABLE
            _block_type = block_type
            _clauses = clauses
            _body = body
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            _block_type.write(buffer)

            buffer.write_length(_clauses.count)

            for clause in _clauses do
                clause.write(buffer)
            od

            write_instructions(buffer, _body)
            buffer.write_byte(cast ubyte(Opcode.END))
        si
    si
si
