namespace Wasm is
    // A minimum size and, when the declaration gives one, a maximum.
    class LIMITS is
        _minimum: int
        _maximum: int?

        init(minimum: int) is
            _minimum = minimum
        si

        init(minimum: int, maximum: int) is
            _minimum = minimum
            _maximum = maximum
        si

        minimum() -> int => _minimum
        maximum() -> int? => _maximum

        write(buffer: BYTE_BUFFER) is
            if _maximum? then
                buffer.write_byte(0x01ub)
                buffer.write_u32(_minimum)
                buffer.write_u32(_maximum!)
            else
                buffer.write_byte(0x00ub)
                buffer.write_u32(_minimum)
            fi
        si
    si
si
