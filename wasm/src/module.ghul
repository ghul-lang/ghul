namespace Wasm is
    // A module: its types, what it imports, what it defines, and what it
    // exports.
    //
    // Except for the type section, the lists are each the index space of
    // one kind, and an import enters the space of the kind it brings in
    // before every defined entry of that kind. The counts a caller needs
    // to write an index are therefore the sizes of both lists, which is
    // what `function_count` and `global_count` add up.
    //
    // The type section is the exception. Its list holds the entries as
    // they are written, and a recursion group is one entry declaring one
    // type per member, so the index a type takes is not the position of
    // the entry declaring it. Every `add` hands back the index rather
    // than the position, and `type_count` is what the two agree on.
    //
    // Indices are left to the caller. Adding a function or a global
    // hands back the index it took, which is enough to build the
    // instruction bodies in order, but nothing is rewritten afterwards:
    // an import added after a body was built changes what that body
    // means.
    class MODULE is
        _types: Collections.LIST[TYPE_ENTRY]
        _imports: Collections.LIST[IMPORT]
        _functions: Collections.LIST[FUNCTION]
        _tables: Collections.LIST[TABLE]
        _tags: Collections.LIST[TAG]
        _globals: Collections.LIST[GLOBAL]
        _exports: Collections.LIST[EXPORT]
        _element_segments: Collections.LIST[ELEMENT_SEGMENT]
        _custom_sections: Collections.LIST[CUSTOM_SECTION]

        _start: int?

        init() is
            _types = Collections.LIST[TYPE_ENTRY]()
            _imports = Collections.LIST[IMPORT]()
            _functions = Collections.LIST[FUNCTION]()
            _tables = Collections.LIST[TABLE]()
            _tags = Collections.LIST[TAG]()
            _globals = Collections.LIST[GLOBAL]()
            _exports = Collections.LIST[EXPORT]()
            _element_segments = Collections.LIST[ELEMENT_SEGMENT]()
            _custom_sections = Collections.LIST[CUSTOM_SECTION]()
        si

        // The index a signature already written at describes, or the one
        // it is written at now. Two signatures that take and return the
        // same types are one entry, so a module that reaches for the
        // same shape twice gets the same index back.
        add_type(type: COMPOSITE_TYPE) -> int is
            return add_sub_type(SUB_TYPE(type))
        si

        add_sub_type(sub_type: SUB_TYPE) -> int is
            let index mut = 0
            let i mut = 0

            while i < _types.count do
                let entry = _types[i]

                if entry.matches(TYPE_ENTRY(sub_type)) then
                    return index
                fi

                index = index + entry.type_count()
                i = i + 1
            od

            _types.add(TYPE_ENTRY(sub_type))

            return index
        si

        // A run of types that may each name another's index in the same
        // run. The indices it takes are the ones it is written at and
        // those after it, so nothing is added while its own types are
        // being built.
        add_rec_group(group: Collections.List[SUB_TYPE]) -> int is
            let index = type_count()

            _types.add(TYPE_ENTRY.of_rec_group(group))

            return index
        si

        // The number of types the type section declares, which is not the
        // number of entries in it: a recursion group is one entry and
        // declares one type per member.
        type_count() -> int is
            let count mut = 0

            for entry in _types do
                count = count + entry.type_count()
            od

            return count
        si

        add_element_segment(segment: ELEMENT_SEGMENT) is
            _element_segments.add(segment)
        si

        element_segments() -> Collections.List[ELEMENT_SEGMENT] => _element_segments

        types() -> Collections.List[TYPE_ENTRY] => _types

        add_import(imported: IMPORT) -> int is
            let index = _imports.count

            _imports.add(imported)

            return index
        si

        imports() -> Collections.List[IMPORT] => _imports

        // The index the function takes in the function index space,
        // which counts the imported functions ahead of the defined ones.
        add_function(function: FUNCTION) -> int is
            let index = _functions.count

            _functions.add(function)

            return _imports_of(ImportKind.FUNCTION) + index
        si

        functions() -> Collections.List[FUNCTION] => _functions

        // The index the table takes in the table index space, which
        // counts the imported tables ahead of the defined ones.
        add_table(table: TABLE) -> int is
            let index = _tables.count

            _tables.add(table)

            return _imports_of(ImportKind.TABLE) + index
        si

        tables() -> Collections.List[TABLE] => _tables

        // The index the tag takes in the tag index space, which counts
        // the imported tags ahead of the defined ones.
        add_tag(tag: TAG) -> int is
            let index = _tags.count

            _tags.add(tag)

            return _imports_of(ImportKind.TAG) + index
        si

        tags() -> Collections.List[TAG] => _tags

        tag_count() -> int is
            return _imports_of(ImportKind.TAG) + _tags.count
        si

        add_global(global: GLOBAL) -> int is
            let index = _globals.count

            _globals.add(global)

            return _imports_of(ImportKind.GLOBAL) + index
        si

        globals() -> Collections.List[GLOBAL] => _globals

        add_export(exported: EXPORT) is
            _exports.add(exported)
        si

        exports() -> Collections.List[EXPORT] => _exports

        // The function the module starts at, or nothing when it names
        // none.
        start() -> int? => _start

        set_start(index: int) is
            _start = index
        si

        add_custom_section(section: CUSTOM_SECTION) is
            _custom_sections.add(section)
        si

        custom_sections() -> Collections.List[CUSTOM_SECTION] => _custom_sections

        function_count() -> int is
            return _imports_of(ImportKind.FUNCTION) + _functions.count
        si

        global_count() -> int is
            return _imports_of(ImportKind.GLOBAL) + _globals.count
        si

        table_count() -> int is
            return _imports_of(ImportKind.TABLE) + _tables.count
        si

        _imports_of(kind: ImportKind) -> int is
            let count mut = 0

            for imported in _imports do
                if imported.kind == kind then
                    count = count + 1
                fi
            od

            return count
        si
    si
si
