namespace Wasm is
    // A run of bytes an instruction can build an array from or copy into
    // one: `array.new_data` and `array.init_data` name a segment by its
    // index in the data section.
    //
    // Only the passive form is written. The two active forms copy their
    // bytes into a memory when the module starts, and this library does
    // not model memories, so a module holding one could not validate.
    class DATA_SEGMENT is
        _bytes: ubyte[]

        init(bytes: ubyte[]) is
            _bytes = bytes
        si

        bytes() -> ubyte[] => _bytes

        write(buffer: BYTE_BUFFER) is
            buffer.write_byte(0x01ub)
            buffer.write_length(_bytes.count)
            buffer.write_bytes(_bytes)
        si
    si
si
