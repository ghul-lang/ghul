namespace Wasm is
    /// What a `WAT_PRINTER` adds to or leaves out of the text it prints,
    /// beyond what the module itself holds. The module and the binary it
    /// writes are unaffected.
    trait WatAnnotations open is
        /// A comment to print on its own line before `instruction`, without
        /// the leading `;;`, or null for none.
        ///
        /// - instruction: an instruction about to be printed, at any depth
        ///   of a function's body
        comment_before(instruction: INSTRUCTION) -> string?

        /// The name to print for a local of a function whose locals the
        /// name section does not name, or null to print its index.
        ///
        /// - function_index: the function's index, counting imported
        ///   functions
        /// - local_index: the local's index, counting the parameters
        local_name(function_index: int, local_index: int) -> string?

        /// Whether the function with index `index` is printed.
        ///
        /// - index: the function's index, counting imported functions
        includes_function(index: int) -> bool

        /// Whether the module's types, imports, tables, tags, globals,
        /// exports, start function, element and data segments are printed.
        /// Where they are not, only the functions are.
        includes_declarations: bool
    si
si
