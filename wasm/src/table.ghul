namespace Wasm is
    // A table of references of one type. `call_indirect` reads a
    // function reference out of one, so a module using that instruction
    // has to declare one; the elements themselves come from element
    // segments.
    class TABLE is
        _element_type: VALUE_TYPE
        _limits: LIMITS

        init(element_type: VALUE_TYPE, limits: LIMITS) is
            _element_type = element_type
            _limits = limits
        si

        write(buffer: BYTE_BUFFER) is
            _element_type.write(buffer)
            _limits.write(buffer)
        si
    si
si
