namespace Wasm is
    // A section under a name the specification does not define, written
    // where any other section may be and ignored by a reader that does
    // not know the name. The name section that carries function and
    // local names is one of these.
    class CUSTOM_SECTION is
        _name: string
        _payload: ubyte[]

        init(name: string, payload: ubyte[]) is
            _name = name
            _payload = payload
        si

        name() -> string => _name
        payload() -> ubyte[] => _payload

        write(buffer: BYTE_BUFFER) is
            buffer.write_name(_name)
            buffer.write_bytes(_payload)
        si
    si
si
