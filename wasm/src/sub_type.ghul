namespace Wasm is
    // A composite type, whether it is closed, and the declared types it
    // is a subtype of.
    //
    // There are three encodings. A type written as `sub` is open, one
    // written as `sub final` is closed, and a composite type with
    // neither marker is closed with no supertypes. The first two carry
    // a supertype list that may be empty - an open type with no
    // supertypes is how a base type is declared - so what decides the
    // encoding is the marker, not the length of that list.
    class SUB_TYPE is
        _final: bool
        _declared: bool
        _super_types: int[]
        _composite: COMPOSITE_TYPE

        // A closed type with no supertypes, which is what a bare
        // composite type means.
        init(composite: COMPOSITE_TYPE) is
            _final = true
            _declared = false
            _composite = composite
            _super_types = []
        si

        init(composite: COMPOSITE_TYPE, final: bool, super_types: int[]) is
            _final = final
            _declared = true
            _composite = composite
            _super_types = super_types
        si

        // The supertypes are indices, so they compare as themselves
        // rather than through a rendering of them.
        same_indices(one: int[], other: int[]) -> bool is
            if one.count != other.count then
                return false
            fi

            let i mut = 0

            while i < one.count do
                if one[i] != other[i] then
                    return false
                fi

                i = i + 1
            od

            return true
        si

        final() -> bool => _final

        super_types() -> int[] => _super_types

        composite() -> COMPOSITE_TYPE => _composite

        write(buffer: BYTE_BUFFER) is
            if _declared then
                buffer.write_byte(if _final then 0x4Fub else 0x50ub fi)

                buffer.write_length(_super_types.count)

                for super_type in _super_types do
                    buffer.write_u32(super_type)
                od
            fi

            _composite.write(buffer)
        si

        matches(other: SUB_TYPE) -> bool is
            if _final != other._final then
                return false
            elif _declared != other._declared then
                return false
            elif !same_indices(_super_types, other._super_types) then
                return false
            fi

            return _composite.matches(other._composite)
        si
    si
si
