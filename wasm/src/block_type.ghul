namespace Wasm is
    // What a `block`, `loop` or `if` produces, which decides what the
    // instructions after it can assume is on the stack.
    //
    // The three encodings are not one. The empty block and a single value
    // type are a byte each, and those bytes are what the negative values
    // of a signed 33-bit integer spell - which is what a type index is,
    // so a reader tells the three apart by the sign.
    //
    // That makes the signed encoding the only one an index can be written
    // in. Unsigned, the indices from 64 to 127 would each be a single byte
    // that reads back as one of those value types: 64 is the empty block,
    // 111 and 112 are externref and funcref, and 124 to 127 are the
    // numeric types. The signed encoding holds every one of them to two
    // bytes, so no index can be mistaken for a type.
    //
    // Which of the three this is, is what the two fields are: neither
    // means the empty block, and the specification's own representation
    // of the other two is the same distinction.
    class BLOCK_TYPE is
        _value_type: VALUE_TYPE?
        _type_index: int?

        init() is si

        of_value(type: VALUE_TYPE) -> BLOCK_TYPE static is
            let result = BLOCK_TYPE()

            result._value_type = type

            return result
        si

        of_type_index(index: int) -> BLOCK_TYPE static is
            let result = BLOCK_TYPE()

            result._type_index = index

            return result
        si

        value_type() -> VALUE_TYPE? => _value_type
        type_index() -> int? => _type_index

        write(buffer: BYTE_BUFFER) is
            if let index = _type_index then
                buffer.write_i64(cast long(index))
            elif let type = _value_type then
                type.write(buffer)
            else
                buffer.write_byte(0x40ub)
            fi
        si
    si
si