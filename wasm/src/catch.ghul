namespace Wasm is
    // Which exceptions a `try_table` hands to which label.
    //
    // The four kinds are two questions: whether the handler names a tag
    // it catches or takes every exception, and whether the exception's
    // payload travels with it to the handler or is left behind. The
    // first question is what decides whether a tag index is written,
    // and the second is what decides whether the handler is given the
    // exception reference to rethrow.
    enum CatchKind is
        CATCH,
        CATCH_REF,
        CATCH_ALL,
        CATCH_ALL_REF
    si

    class CATCH_CLAUSE is
        kind: CatchKind
        tag_index: int
        label: int

        init(kind: CatchKind, tag_index: int, label: int) is
            self.kind = kind
            self.tag_index = tag_index
            self.label = label
        si

        // The two clauses that take every exception name no tag, and the
        // format writes them without one.
        names_a_tag() -> bool is
            return kind == CatchKind.CATCH \/ kind == CatchKind.CATCH_REF
        si

        write(buffer: BYTE_BUFFER) is
            case kind
                when CatchKind.CATCH then buffer.write_byte(0x00ub)
                when CatchKind.CATCH_REF then buffer.write_byte(0x01ub)
                when CatchKind.CATCH_ALL then buffer.write_byte(0x02ub)
                else buffer.write_byte(0x03ub)
            esac

            if names_a_tag() then
                buffer.write_u32(tag_index)
            fi

            buffer.write_u32(label)
        si
    si
si
