namespace Wasm is
    // Every opcode this library encodes, as the byte or bytes the
    // specification gives it. Which instruction class carries an
    // immediate is the class's business; the opcode itself is only
    // where it sits in the instruction stream.
    //
    // A member at `0xFB00` or above is a two-byte opcode: a prefix
    // byte, `0xFB` or `0xFC`, followed by the member's own value as an
    // unsigned LEB128.
    enum Opcode is
        UNREACHABLE = 0x0000,
        NOP = 0x0001,
        BLOCK = 0x0002,
        LOOP = 0x0003,
        IF = 0x0004,
        ELSE = 0x0005,
        END = 0x000B,
        BR = 0x000C,
        BR_IF = 0x000D,
        BR_TABLE = 0x000E,
        RETURN = 0x000F,
        CALL = 0x0010,
        CALL_INDIRECT = 0x0011,
        DROP = 0x001A,
        THROW = 0x0008,
        THROW_REF = 0x000A,
        TRY_TABLE = 0x001F,
        SELECT = 0x001B,
        SELECT_T = 0x001C,
        LOCAL_GET = 0x0020,
        LOCAL_SET = 0x0021,
        LOCAL_TEE = 0x0022,
        GLOBAL_GET = 0x0023,
        GLOBAL_SET = 0x0024,
        I32_CONST = 0x0041,
        I64_CONST = 0x0042,
        F32_CONST = 0x0043,
        F64_CONST = 0x0044,
        I32_EQZ = 0x0045,
