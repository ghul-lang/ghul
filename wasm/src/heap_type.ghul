namespace Wasm is
    // The heap types the specification names rather than numbers. One of
    // these says how general a reference is rather than what it points
    // at, and a reference to a declared type names that type's index
    // instead.
    enum AbstractHeapType is
        EXN = 0x69,
        ARRAY = 0x6A,
        STRUCT = 0x6B,
        I31 = 0x6C,
        EQ = 0x6D,
        ANY = 0x6E,
        EXTERN = 0x6F,
        FUNC = 0x70,
        NONE = 0x71,
        NOEXTERN = 0x72,
        NOFUNC = 0x73,
        NOEXN = 0x74
    si

    // What a reference points at: one of the abstract heap types, or a
    // type from the type section. The index is written as a signed
    // 33-bit value, which is what keeps an index from being read as one
    // of the abstract bytes above.
    class HEAP_TYPE is
        _abstract: AbstractHeapType?
        _type_index: int?

        init() is si

        of_abstract(type: AbstractHeapType) -> HEAP_TYPE static is
            let result = HEAP_TYPE()

            result._abstract = type

            return result
        si

        of_type_index(index: int) -> HEAP_TYPE static is
            let result = HEAP_TYPE()

            result._type_index = index

            return result
        si

        is_abstract() -> bool => _abstract?

        abstract_type() -> AbstractHeapType? => _abstract
        type_index() -> int? => _type_index

        write(buffer: BYTE_BUFFER) is
            if let type = _abstract then
                buffer.write_byte(cast ubyte(type))
            else
                buffer.write_i64(cast long(_type_index!))
            fi
        si

        matches(other: HEAP_TYPE) -> bool is
            if _abstract? then
                return other._abstract =~ _abstract
            fi

            return other._type_index =~ _type_index
        si
    si
si
