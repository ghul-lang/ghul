namespace Wasm is
    // An exception and the signature its payload is carried in. The tag
    // section is a list of these, and a tag import enters the same index
    // space ahead of them.
    //
    // A tag's type is a function type from the type section, which is
    // what makes the payload a tuple the throw and the catch agree on.
    class TAG is
        type_index: int

        init(type_index: int) is
            self.type_index = type_index
        si

        write(buffer: BYTE_BUFFER) is
            // The byte ahead of the index is reserved for attributes the
            // format does not define yet.
            buffer.write_byte(0x00ub)
            buffer.write_u32(type_index)
        si
    si

    class TAG_IMPORT: IMPORT is
        tag: TAG

        init(module: string, name: string, tag: TAG) is
            super.init(module, name, ImportKind.TAG)
            self.tag = tag
        si

        write(buffer: BYTE_BUFFER) is
            super.write(buffer)

            tag.write(buffer)
        si
    si
si
