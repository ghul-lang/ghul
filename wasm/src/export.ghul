namespace Wasm is
    // What kind of thing an export names, which is the byte the
    // specification encodes the kind as. The indices are the same index
    // space the imports share.
    enum ExportKind is
        FUNCTION = 0x00,
        TABLE = 0x01,
        MEMORY = 0x02,
        GLOBAL = 0x03,
        TAG = 0x04
    si

    class EXPORT is
        _name: string
        _kind: ExportKind
        _index: int

        init(name: string, kind: ExportKind, index: int) is
            _name = name
            _kind = kind
            _index = index
        si

        write(buffer: BYTE_BUFFER) is
            buffer.write_name(_name)
            buffer.write_byte(cast ubyte(_kind))
            buffer.write_u32(_index)
        si
    si
si
