namespace Wasm.UnitTests is
    use Collections.LIST

    use Wasm.BYTE_BUFFER
    use Wasm.NAME_MAP
    use Wasm.NAME_SECTION
    use Wasm.NAMED_INDEX

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // The name section is three optional parts behind a name of its own,
    // and the parts are written in the order of the identifiers the
    // format gives them rather than in the order a caller set them.
    @TestClass()
    class NAME_SECTION_TESTS is
        init() is si

        _encoded(section: NAME_SECTION) -> ubyte[] is
            let buffer = BYTE_BUFFER()

            section.write(buffer)

            return buffer.to_array()
        si

        @Test()
        write__the_module_name__is_a_subsection_of_its_own() is
            BYTES.are(
                [0x00, 0x04, 0x03, 0x61, 0x62, 0x63],
                _encoded(NAME_SECTION().with_module_name("abc")))
        si

        @Test()
        write__function_names__is_a_subsection() is
            let names = NAME_MAP()

            names.add(2, "hi")

            BYTES.are(
                [0x01, 0x05, 0x01, 0x02, 0x02, 0x68, 0x69],
                _encoded(NAME_SECTION().with_functions(names)))
        si

        @Test()
        write__local_names__is_a_map_behind_a_function_index() is
            let section = NAME_SECTION()
            let locals = NAME_MAP()

            locals.add(0, "a")

            section.add_locals(4, locals)

            BYTES.are(
                [0x02, 0x06, 0x01, 0x04, 0x01, 0x00, 0x01, 0x61],
                _encoded(section))
        si

        @Test()
        write__all_three__is_the_module_name_then_each_subsection() is
            let functions = NAME_MAP()
            functions.add(0, "f")

            let section = NAME_SECTION()
                .with_module_name("m")
                .with_functions(functions)

            section.add_locals(0, NAME_MAP([NAMED_INDEX(1, "l")]))

            BYTES.are(
                [0x00, 0x02, 0x01, 0x6D,
                 0x01, 0x04, 0x01, 0x00, 0x01, 0x66,
                 0x02, 0x06, 0x01, 0x00, 0x01, 0x01, 0x01, 0x6C],
                _encoded(section))
        si
    si
si
