namespace Wasm.UnitTests is
    use Collections.LIST
    use Assertions

    // Shared by the tests that compare encoded bytes: a byte sequence
    // written the way a test reads better than an array of literals.
    class BYTES is
        // The bytes a test expects, written as the hex octets they are.
        of(values: int[]) -> ubyte[] static is
            let result = LIST[ubyte]()

            for value in values do
                result.add(cast ubyte(value))
            od

            return result.to_array()
        si

        // Compared as text so a mismatch names the bytes rather than
        // reporting that two arrays differ.
        describe(bytes: ubyte[]) -> string static is
            let result = System.Text.StringBuilder()

            for byte in bytes do
                if result.length > 0 then
                    result.append(' ')
                fi

                result.append("{cast int(byte):x2}")
            od

            return result.to_string()
        si

        // The bytes a buffer or a writer produced, against the bytes a
        // test wrote out.
        are(expected: int[], actual: ubyte[]) static is
            are_equal(describe(of(expected)), describe(actual))
        si
    si
si
