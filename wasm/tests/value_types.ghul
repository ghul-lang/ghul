namespace Wasm.UnitTests is
    // The value types the tests name, so that a case reads as the type it
    // is about rather than as how that type is built.
    class VALUE_TYPES is
        i32() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_numeric(Wasm.NumericType.I32)
        si

        i64() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_numeric(Wasm.NumericType.I64)
        si

        f32() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_numeric(Wasm.NumericType.F32)
        si

        f64() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_numeric(Wasm.NumericType.F64)
        si

        func_ref() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.FUNC)
        si

        extern_ref() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.EXTERN)
        si

        any() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.ANY)
        si

        none() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.NONE)
        si

        eq() -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.EQ)
        si

        // A reference to the declared type at an index, in the two
        // forms that differ in whether it can be absent.
        ref_to(index: int) -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_type_index(index, false)
        si

        nullable_ref_to(index: int) -> Wasm.VALUE_TYPE static is
            return Wasm.VALUE_TYPE.of_type_index(index, true)
        si
    si
si
