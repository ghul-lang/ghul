namespace Wasm.UnitTests is
    use Wasm.BYTE_BUFFER
    use Wasm.VALUE_TYPE
    use Assertions

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // The encodings a value type has, and the one of them that is not a
    // byte. A reference to a declared type is a marker and an index, and
    // the index is signed so that it cannot be read as one of the bytes
    // around it.
    @TestClass()
    class VALUE_TYPE_TESTS is
        init() is si

        _encoded(type: VALUE_TYPE) -> ubyte[] is
            let buffer = BYTE_BUFFER()

            type.write(buffer)

            return buffer.to_array()
        si

        @Test()
        write__a_numeric_type__is_its_byte() is
            BYTES.are([0x7F], _encoded(VALUE_TYPES.i32()))
        si

        @Test()
        write__a_nullable_abstract_reference__is_the_heap_type_byte() is
            BYTES.are([0x70], _encoded(VALUE_TYPES.func_ref()))
        si

        @Test()
        write__a_nullable_reference_to_a_type__is_a_marker_and_an_index() is
            BYTES.are([0x63, 0x00], _encoded(VALUE_TYPES.nullable_ref_to(0)))
        si

        @Test()
        write__a_reference_to_a_type__is_a_marker_and_an_index() is
            BYTES.are([0x64, 0x00], _encoded(VALUE_TYPES.ref_to(0)))
        si

        // The window where an unsigned index would be one byte that
        // reads back as a heap type.
        @Test()
        write__a_nullable_reference_to_sixty_four__spans_two_bytes() is
            BYTES.are([0x63, 0xC0, 0x00], _encoded(VALUE_TYPES.nullable_ref_to(64)))
        si

        @Test()
        write__a_reference_to_one_hundred_and_eleven__spans_two_bytes() is
            BYTES.are([0x64, 0xEF, 0x00], _encoded(VALUE_TYPES.ref_to(111)))
        si

        @Test()
        write__a_reference_to_one_hundred_and_twenty_seven__spans_two_bytes() is
            BYTES.are([0x64, 0xFF, 0x00], _encoded(VALUE_TYPES.ref_to(127)))
        si

        @Test()
        write__a_reference_to_one_hundred_and_twenty_eight__is_two_bytes() is
            BYTES.are([0x64, 0x80, 0x01], _encoded(VALUE_TYPES.ref_to(128)))
        si

        @Test()
        matches__the_same_numeric_type__is_the_same() is
            is_true(VALUE_TYPES.i32().matches(VALUE_TYPES.i32()))
        si

        @Test()
        matches__a_different_numeric_type__is_not_the_same() is
            is_false(VALUE_TYPES.i32().matches(VALUE_TYPES.i64()))
        si

        @Test()
        matches__a_numeric_type_and_a_reference__are_not_the_same() is
            is_false(VALUE_TYPES.i32().matches(VALUE_TYPES.any()))
        si

        @Test()
        matches__a_nullable_reference_and_one_that_is_not__are_not_the_same() is
            is_false(VALUE_TYPES.nullable_ref_to(0).matches(VALUE_TYPES.ref_to(0)))
        si
    si
si
