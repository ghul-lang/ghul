namespace Wasm.UnitTests is
    use Wasm.BYTE_BUFFER
    use Wasm.FIELD_TYPE
    use Wasm.NumericType
    use Assertions
    use Wasm.PackedType

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // A field is what it holds and whether it can be assigned through,
    // which is a byte and then a marker for the second.
    @TestClass()
    class FIELD_TYPE_TESTS is
        init() is si

        _encoded(one: FIELD_TYPE) -> ubyte[] is
            let buffer = BYTE_BUFFER()

            one.write(buffer)

            return buffer.to_array()
        si

        // The format leaves the mutability byte out for a field that
        // cannot be assigned through, and an engine rejects that, so it
        // is written either way.
        @Test()
        write__an_immutable_field__carries_a_zero() is
            BYTES.are([0x7F, 0x00], _encoded(FIELD_TYPE(NumericType.I32, false)))
        si

        @Test()
        write__a_mutable_field__adds_the_marker() is
            BYTES.are([0x7F, 0x01], _encoded(FIELD_TYPE(NumericType.I32, true)))
        si

        // A packed type has no value type of its own, and is read and
        // written through the instructions that extend it.
        @Test()
        write__a_packed_byte_field__is_its_own_byte() is
            BYTES.are([0x78, 0x01], _encoded(FIELD_TYPE.of_packed(PackedType.I8, true)))
        si

        @Test()
        write__a_packed_half_word_field__is_its_own_byte() is
            BYTES.are([0x77, 0x00], _encoded(FIELD_TYPE.of_packed(PackedType.I16, false)))
        si

        // A field is where one declared type points at another, so the
        // reference half of a value type has to reach here.
        @Test()
        write__a_field_holding_a_declared_type__is_the_marker_and_the_index() is
            BYTES.are(
                [0x63, 0x02, 0x00],
                _encoded(FIELD_TYPE.of_reference(VALUE_TYPES.nullable_ref_to(2), false)))
        si

        @Test()
        write__a_field_holding_a_reference_that_cannot_be_absent__is_the_other_marker() is
            BYTES.are(
                [0x64, 0x02, 0x00],
                _encoded(FIELD_TYPE.of_reference(VALUE_TYPES.ref_to(2), false)))
        si

        @Test()
        write__a_field_holding_an_abstract_reference__is_its_byte() is
            BYTES.are([0x6E, 0x01], _encoded(FIELD_TYPE.of_reference(VALUE_TYPES.any(), true)))
        si

        @Test()
        matches__the_same_declared_type__is_the_same() is
            is_true(
                FIELD_TYPE.of_reference(VALUE_TYPES.nullable_ref_to(1), false)
                    .matches(FIELD_TYPE.of_reference(VALUE_TYPES.nullable_ref_to(1), false)))
        si

        @Test()
        matches__a_declared_type_and_a_different_one__are_not_the_same() is
            is_false(
                FIELD_TYPE.of_reference(VALUE_TYPES.nullable_ref_to(1), false)
                    .matches(FIELD_TYPE.of_reference(VALUE_TYPES.nullable_ref_to(2), false)))
        si

        @Test()
        matches__a_packed_field_and_a_value_type__are_not_the_same() is
            is_false(
                FIELD_TYPE.of_packed(PackedType.I8, false)
                    .matches(FIELD_TYPE(NumericType.I32, false)))
        si

        @Test()
        write__a_reference_field__is_its_heap_type_byte() is
            BYTES.are([0x70, 0x00], _encoded(FIELD_TYPE.of_reference(VALUE_TYPES.func_ref(), false)))
        si
    si
si
