namespace Wasm.UnitTests is
    use Wasm.BINARY_WRITER
    use Collections.LIST

    use Wasm.BYTE_BUFFER
    use Wasm.Tests.MODULE_MATRIX

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Every module of the matrix is written here, so that a module the
    // writer cannot encode is caught by the suite rather than by the
    // engine run that follows it.
    //
    // What the suite cannot do is say whether the bytes are the ones an
    // engine accepts, which is the other half of the matrix's job. That
    // is done while the tests are written, by handing every module to
    // Node's `WebAssembly.validate` and recording the result in the
    // pull request. The README says which modules cover what.
    @TestClass()
    class MODULE_MATRIX_TESTS is
        init() is si

        @Test()
        every_module_in_the_matrix__is_written() is
            for name in MODULE_MATRIX.names() do
                let bytes = BINARY_WRITER().write(MODULE_MATRIX.by_name(name))

                is_true(bytes.count >= 8)
            od
        si

        // The preamble, which is what every module opens with whatever
        // else it holds.
        @Test()
        every_module__opens_with_the_magic_and_the_version() is
            for name in MODULE_MATRIX.names() do
                let bytes = BINARY_WRITER().write(MODULE_MATRIX.by_name(name))

                let preamble = LIST[ubyte]()

                for i in 0..8 do
                    preamble.add(bytes[i])
                od

                BYTES.are(
                    [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00],
                    preamble.to_array())
            od
        si
    si
si
