<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Framework -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Package -->
    <Title>ghūl compiler</Title>
    <Description>compiler for the ghūl programming language</Description>
    <RepositoryUrl>https://github.com/degory/ghul</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>    

    <Authors>degory</Authors>
    <Company>ghul.dev</Company>
    <LicenseExpression>AGPL-3.0-or-later</LicenseExpression>

    <PackageId>ghul.compiler</PackageId>
    <PackageDescription>compiler for the ghūl programming language</PackageDescription>
    <PackageTags>ghul;ghūl;compiler;dotnet;tool</PackageTags>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageProjectUrl>https://ghul.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>

    <PackageIcon>ghul-logo-icon.png</PackageIcon>
    <PackageIconUrl>ghul-logo-icon.png</PackageIconUrl>

    <!-- Tool -->
    <IsTool>true</IsTool>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ghul-compiler</ToolCommandName>

    <!-- Build options -->
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <GhulCompiler>dotnet ghul-compiler --show-analysis-stats</GhulCompiler>
    <GhulUnderscoreAccess>legacy</GhulUnderscoreAccess>
    <!-- The compiler behaves the same whatever locale the machine is
         set to: numbers parse and print the same way, an imported
         name converts case the same way, and strings compare the same
         way. The cost is that no ICU data is loaded, so the runtime
         has no Unicode normalisation. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Run time options -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sources -->
    <GhulSources Include="src/**/*.ghul" />
    <GhulOptions Include="--define release" Condition="'$(CI)' != ''" />

    <!-- A `|>` call can land on a same-named local or field rather than an
         imported free function it shares a name with (e.g. Ghul.Pipes.count),
         and the shadowed-non-callable fallback resolves it to the function
         anyway. The compiler's own sources hit this pattern repeatedly enough
         that the warning is more noise than signal here; demoting it to a
         hint drops it from batch output (this build, CI, bootstrap) while
         ghul-vsce and ghul-mcp still surface it for a file a client has open,
         since both forward unconditioned GhulOptions to the analyser. -->
    <GhulOptions Include="--warn-as-hint shadowed-non-callable" />

    <!-- Nearly every lambda here reads a virtual property or calls
         to_string on a symbol or a type, and neither can be proved
         store-free while an override could store, so the argument form
         of the pure-slot report fires on ordinary code throughout. It
         is advice - the enclosing call is judged on its own callee
         either way - so it goes to a hint on the same terms as above.
         The store form keeps its own slug and stays a warning: that one
         is what makes a pure-typed slot's claim true. -->
    <GhulOptions Include="--warn-as-hint impure-function-argument" />

    <!-- The sources are written terminator-free; a written `;` the line
         break would infer draws the warning, promoted to an error so
         stray terminators cannot creep back in. The same everywhere,
         so a local build says what a CI one will. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" />

    <!-- Package dependencies -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="System.IO.Abstractions" />

    <!-- Shared protocol DTOs (single source of truth for the JSON analysis
         protocol; consumed by the client too, via analysis-tests). -->
    <ProjectReference Include="analysis-protocol/analysis-protocol.ghulproj" />

    <!-- The WebAssembly module writer the WasmGC backend writes through. -->
    <ProjectReference Include="wasm/wasm.ghulproj" />

    <!-- Build outputs -->
    <None Include="nuget-readme/README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE*" Pack="true" PackagePath="\" />

    <!-- Icon -->
    <None Include="./images/ghul-logo-icon.png" Pack="true" PackagePath=""/>

    <Content Include="lib/**/*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>false</Pack>
    </Content>

    <None Include="lib/**/*.*" Pack="true" PackagePath="tools/$(TargetFramework)/any/lib/" />
  </ItemGroup>
</Project>
