@@IF.dotnet()

namespace Analysis.Protocol is
    use Ghul.Disposable
    use Ghul.Pipes
    use System.Exception
    use System.Diagnostics.Process
    use System.Diagnostics.ProcessStartInfo
    use System.Text.StringBuilder
    use System.Text.UTF8Encoding
    use System.Text.Json.JsonSerializer
    use System.Text.Json.JsonSerializerOptions

    use Collections.Iterable
    use Collections.MutableList
    use Collections.LIST

    use IO.Directory
    use IO.File
    use IO.Path

    // Long-lived wrapper around a `dotnet ghul-compiler --analyse @...`
    // subprocess speaking the JSON analysis protocol: one JSON object per line,
    // newline-terminated, requests and responses both discriminated by `kind`.
    // Each test constructs one in [@test_initialize] and dispose()s it in
    // [@test_cleanup]: the compiler carries persistent global state that
    // `clear_symbols` doesn't fully scrub, so a process can't be safely reused
    // across tests.
    //
    // `capabilities` is read off the LISTEN frame inside the try that
    // blocks for it; every path that leaves the constructor without
    // setting it throws.
    @suppress("field-definite-assignment")
    class ANALYSER_PROCESS: Disposable is
        _process: Process
        _stderr_capture: StringBuilder
        _options: JsonSerializerOptions
        _response_directory: string

        // The capabilities list the compiler advertised on its LISTEN
        // frame. Clients consult this before opting into optional
        // features (an absent capability means the spawned binary
        // doesn't recognise the corresponding CLI flag, so a setting
        // honouring it would have been a no-op). Always non-null; empty
        // on a compiler that doesn't yet emit the field.
        capabilities: Collections.LIST[string] public

        // The version string the compiler advertised on its LISTEN frame,
        // or null if the field is absent - the compiler is old enough not
        // to emit it. Clients use this for version negotiation: reject a
        // compiler older than their minimum supported version with a
        // clean error instead of trailing edge behaviour on the wire.
        compiler_version: string? public

        // Walk up from the running assembly to the consuming project's root —
        // the first ancestor directory that holds a .ghulproj.
        find_project_directory() -> string static is
            let assembly_path = System.Reflection.Assembly.get_executing_assembly().location
            let dir mut = Path.get_directory_name(assembly_path)

            while let d: string = dir do
                if Directory.get_files(d, "*.ghulproj").count > 0 then
                    return d
                fi

                let parent = Path.get_directory_name(d)

                if !parent? \/ parent =~ d then
                    break
                fi

                dir = parent
            od

            throw Exception("could not find a .ghulproj project directory from assembly path: {assembly_path}")
        si

        // Read .assemblies.json and return the list of "-a <path>" args plus a
        // trailing "-A". The compiler's own ghul.dll is filtered out — it lands
        // in our bin via the ProjectReference but exposing it to the analyser
        // would pollute the symbol table with the compiler's own metadata.
        build_analyser_arguments(project_directory: string) -> Iterable[string] static =>
            build_analyser_arguments(project_directory, LIST[string]())

        build_analyser_arguments(project_directory: string, without_assemblies: Iterable[string]) -> Iterable[string] static is
            let excluded = Collections.SET[string]()

            for name in without_assemblies do
                excluded.add(name.to_lower_invariant())
            od

            if let libraries = wasm_libraries then
                let result = LIST[string]()

                result.add("--target")
                result.add("wasm")

                add_library_sources(libraries, excluded, result)
                add_common_arguments(result)

                return result
            fi

            let assemblies_json_path = Path.combine(project_directory, ".assemblies.json")

            if !File.exists(assemblies_json_path) then
                throw Exception(".assemblies.json not found at {assemblies_json_path} — is the GenerateAssembliesJson target wired into Build?")
            fi

            let content = File.read_all_text(assemblies_json_path)

            let result = LIST[string]()
            let in_string mut = false
            let current = StringBuilder()
            let escape_next mut = false

            for c in content do
                if escape_next then
                    if c == 'n' then
                        current.append('\n')
                    elif c == 't' then
                        current.append('\t')
                    elif c == '"' then
                        current.append('"')
                    elif c == '\\' then
                        current.append('\\')
                    else
                        current.append(c)
                    fi
                    escape_next = false
                elif c == '\\' /\ in_string then
                    escape_next = true
                elif c == '"' then
                    if in_string then
                        let captured = current.to_string()

                        if
                            captured !~ "assemblies" /\
                            captured.length > 0 /\
                            !is_compiler_own_dll(captured) /\
                            !excluded.contains(Path.get_file_name(captured)!.to_lower_invariant())
                        then
                            result.add("-a")
                            result.add(captured)
                        fi

                        current.clear()
                    fi

                    in_string = !in_string
                elif in_string then
                    current.append(c)
                fi
            od

            add_common_arguments(result)

            return result
        si

        // The library sources a wasm analyser compiles, from the response file
        // `libraries` names, one argument a line: each `--library-source`
        // declaration followed by its files. A library whose assembly is in
        // `excluded` is left out, so a test standing in for a project that
        // declares the runtime itself works on wasm as it does on .NET.
        add_library_sources(libraries: string, excluded: Collections.SET[string], result: LIST[string]) static is
            let skipping mut = false
            let lines = File.read_all_lines(libraries)
            let i mut = 0

            while i < lines.count do
                let line = lines[i].trim()

                if line =~ "--library-source" /\ i + 1 < lines.count then
                    let declaration = lines[i + 1].trim()
                    let name = declaration.split(['@'])[0]

                    skipping = excluded.contains("{name}.dll".to_lower_invariant())

                    if !skipping then
                        result.add(line)
                        result.add(declaration)
                    fi

                    i = i + 2
                    continue
                fi

                if line.length > 0 /\ !skipping then
                    result.add(line)
                fi

                i = i + 1
            od
        si

        // The flags every analyser the harness starts is given, whichever
        // compiler runs it.
        add_common_arguments(result: LIST[string]) static is
            // The analysis-test fixtures exercise IPC / query / state behaviour,
            // not the definite-return / definite-assignment flow warnings.
            result.add("--no-warn-definite-return")
            result.add("--no-warn-definite-assignment")

            let extra = Ghul.ENVIRONMENT.instance["ANALYSER_EXTRA_ARGS"]

            if !string.is_null_or_white_space(extra) then
                for arg in extra!.split([' ']) do
                    if arg.length > 0 then
                        result.add(arg)
                    fi
                od
            fi

            result.add("-A")
        si

        // The wasm-built compiler's loader, where ANALYSIS_TESTS_WASM_COMPILER
        // names one: the harness then starts it under node rather than
        // starting ghul.dll under dotnet.
        wasm_compiler: string? static => _non_empty("ANALYSIS_TESTS_WASM_COMPILER")

        // The response file of library sources a wasm analyser compiles,
        // which ANALYSIS_TESTS_WASM_LIBRARIES names alongside the compiler.
        wasm_libraries: string? static =>
            if wasm_compiler? then _non_empty("ANALYSIS_TESTS_WASM_LIBRARIES") else null fi

        _non_empty(variable: string) -> string? static =>
            if let value: string = Ghul.ENVIRONMENT.instance[variable] /\ !string.is_null_or_white_space(value) then
                value
            else
                null
            fi

        is_compiler_own_dll(path: string) -> bool static =>
            Path.get_file_name(path)!.to_lower_invariant() =~ "ghul.dll"

        // Resolve the path of the ghul.dll the harness spawns as the
        // compiler-under-test. ANALYSIS_TESTS_COMPILER_DLL overrides; default is
        // bin/.../ghul.dll, copied in via the ProjectReference.
        resolve_compiler_dll() -> string static is
            let override_path = Ghul.ENVIRONMENT.instance["ANALYSIS_TESTS_COMPILER_DLL"]

            if let p: string = override_path /\ !string.is_null_or_white_space(p) then
                if !File.exists(p) then
                    throw Exception("ANALYSIS_TESTS_COMPILER_DLL='{p}' does not exist")
                fi

                return p
            fi

            let assembly_path = System.Reflection.Assembly.get_executing_assembly().location
            let bin_dir = Path.get_directory_name(assembly_path) ?? "."
            let compiler_dll = Path.combine(bin_dir, "ghul.dll")

            if !File.exists(compiler_dll) then
                throw Exception("compiler ghul.dll not found at {compiler_dll} — is the ProjectReference to ghul.ghulproj wired up? Or set ANALYSIS_TESTS_COMPILER_DLL=<path> to spawn a specific dll.")
            fi

            return compiler_dll
        si

        // Write the arguments into `directory` in the form
        // `dotnet ghul-compiler @<rsp>` reads back, and return the path.
        // Where that directory is, and who removes it, are the caller's.
        write_response_file(directory: string, arguments: Iterable[string]) -> string static is
            let path = Path.combine(directory, "analyser.rsp")

            let line = arguments
                |> map(a -> string => "\"{a}\"")
                |> join(" ")

            File.write_all_text(path, line)

            return path
        si

        init() is
            init(LIST[string]())
        si

        // Spawn with additional driver flags appended after the assemblies
        // and sources, for tests that need a non-default analyser
        // configuration (a short `--analysis-idle-timeout`, say). Later
        // flags win, so an extra argument can override what
        // build_analyser_arguments produced.
        init(extra_arguments: Iterable[string]) is
            init(extra_arguments, LIST[string]())
        si

        // Spawn with the named assemblies (file name, case-insensitive)
        // left out of the `-a` list, for a test standing in for a project
        // that declares in source what it would otherwise reference - the
        // runtime, which declares the compiler's own magic types.
        init(extra_arguments: Iterable[string], without_assemblies: Iterable[string]) is
            _options = JSON_OPTIONS.create()

            let project_directory = find_project_directory()

            let left_out = LIST[string](without_assemblies)

            // A test that names its own library sources stands in for the
            // libraries a wasm analyser is otherwise given.
            if wasm_compiler? /\ extra_arguments |> any(a => a =~ "--library-source") then
                left_out.add("ghul-core.dll")
                left_out.add("ghul-runtime.dll")
            fi

            let arguments = LIST[string](build_analyser_arguments(project_directory, left_out))
            arguments.add_range(extra_arguments)

            // A directory of this instance's own, so parallel analyser
            // instances cannot race on one response file: the loser of the
            // write race reads a truncated file, and the spawned compiler
            // either exits with just the version line
            // (`arguments.count == 0`) or aborts on a malformed assembly
            // path - either way the harness sees the analyser's stdout close
            // before the first response line. Under the system temporary
            // directory so a run killed before dispose() leaves it where the
            // system reclaims it rather than in the project.
            //
            // Both the directory and the name inside it are internal to the
            // test and profiler harness; the VS Code server chooses its own
            // (`server-manager.ts`).
            _response_directory = Path.combine(Path.get_temp_path(), "ghul-analyser-{System.Guid.new_guid()}")

            Directory.create_directory(_response_directory)

            let response_file = write_response_file(_response_directory, arguments)

            let start_info = ProcessStartInfo()

            if let loader = wasm_compiler then
                if !wasm_libraries? then
                    throw Exception("ANALYSIS_TESTS_WASM_COMPILER is set but ANALYSIS_TESTS_WASM_LIBRARIES, the library sources, is not")
                fi

                start_info.file_name = "node"
                start_info.argument_list.add(loader)
            else
                start_info.file_name = "dotnet"
                start_info.argument_list.add(resolve_compiler_dll())
            fi

            start_info.argument_list.add("@{response_file}")
            start_info.working_directory = project_directory

            start_info.use_shell_execute = false
            start_info.redirect_standard_input = true
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            start_info.standard_input_encoding = UTF8Encoding()
            start_info.standard_output_encoding = UTF8Encoding()
            start_info.standard_error_encoding = UTF8Encoding()

            let started = Process.start(start_info)

            if !started? then
                throw Exception("failed to start ghul-compiler analyser process")
            fi

            _process = started

            _stderr_capture = StringBuilder()

            // Drain stderr in the background so a chatty analyser doesn't fill
            // its stderr pipe and block.
            Tasks.TASK.run(
                () is
                    try
                        do
                            let line = _process.standard_error.read_line()

                            if !line? then
                                break
                            fi

                            _stderr_capture.append(line)
                            _stderr_capture.append('\n')
                        od
                    catch ex: Exception
                    yrt
                si
            )

            // Block until the analyser writes its initial listen frame.
            try
                let first = read_response()

                if let listen: Response.LISTEN = first then
                    capabilities =
                        if listen.capabilities? then
                            listen.capabilities
                        else
                            Collections.LIST[string]()
                        fi

                    compiler_version = listen.compiler_version
                else
                    throw Exception("expected listen as first response, got a different Response variant.\nstderr so far:\n{_stderr_capture}")
                fi
            catch ex: Exception
                dispose()
                throw ex
            yrt
        si

        supports(capability: string) -> bool is
            for c in capabilities do
                if c =~ capability then
                    return true
                fi
            od
            return false
        si

        // Read a response that may be preceded by an unsolicited diagnostics
        // frame. Query commands (hover / definition / …) fall through to a
        // compile_all when the queried position isn't cached; that path writes a
        // diagnostics response before the handler's own response. Tests
        // asserting on a query response use this so the optional diagnostics is
        // drained transparently.
        read_query_response() -> Response is
            let response mut = read_response()

            if isa Response.DIAGNOSTICS(response) then
                response = read_response()
            fi

            return response
        si

        // Read one JSON line from stdout (char-by-char until newline; a JSON
        // message never contains a raw newline) and deserialize into a Response.
        read_response() -> Response is
            let buffer = StringBuilder()

            do
                let c = _process.standard_output.read()

                if c < 0 then
                    throw Exception(
                        "analyser stdout closed before a response line.\n"
                        "buffer so far:\n{buffer}\n"
                        "stderr so far:\n{_stderr_capture}"
                    )
                fi

                if c == 10 then
                    break
                fi

                if c != 13 then
                    buffer.append(cast char(c))
                fi
            od

            let response = JsonSerializer.deserialize[Response](buffer.to_string(), _options)

            if !response? then
                throw Exception("analyser returned null deserialising response")
            fi

            return response
        si

        // Serialize with the variant's name under `kind`.
        write_request(request: Request) is
            _process.standard_input.write(Json.write(Json.to_json(request)))
            _process.standard_input.write("\n")
            _process.standard_input.flush()
        si

        // Write a raw JSON line straight to the analyser's stdin, bypassing
        // the typed request serializer. Only for tests that need to send a
        // deliberately-malformed frame to exercise the analyser's protocol
        // error paths; production clients always go through write_request.
        write_raw_line(line: string) is
            _process.standard_input.write(line)
            _process.standard_input.write("\n")
            _process.standard_input.flush()
        si

        // Send `edit` for one or more files.
        send_edit_files(files: Collections.Iterable[EDIT_FILE]) is
            let list = LIST[EDIT_FILE]()

            for f in files do
                list.add(f)
            od

            write_request(Request.EDIT(list))
        si

        // Convenience for single-file edit — the common case.
        send_edit(path: string, source: string) is
            send_edit_files([EDIT_FILE(path, source)])
        si

        // Send `edit_delta` for one or more files. Only valid against an
        // analyser advertising the `edit-deltas` capability.
        send_edit_delta_files(files: Collections.Iterable[EDIT_DELTA_FILE]) is
            let list = LIST[EDIT_DELTA_FILE]()

            for f in files do
                list.add(f)
            od

            write_request(Request.EDIT_DELTA(list))
        si

        // Convenience for a single-file delta, taking the length the
        // analyser's retained text is expected to have from the caller's
        // own copy of the pre-edit text.
        send_edit_delta(
            path: string,
            start_line: int, start_column: int, end_line: int, end_column: int,
            new_text: string,
            previous_source: string
        ) is
            send_edit_delta_files([
                EDIT_DELTA_FILE(
                    path,
                    start_line, start_column, end_line, end_column,
                    new_text,
                    previous_source.length
                )
            ])
        si

        // Declare the client's currently-open files. Fire-and-forget (no
        // response). Editor-only hints are produced only for these paths, so
        // a consumer that wants them must send this before COMPILE.
        send_open_files(paths: Collections.Iterable[string]) is
            let list = LIST[string]()

            for p in paths do
                list.add(p)
            od

            write_request(Request.SET_OPEN_FILES(list))
        si

        send_format(path: string, source: string) is
            write_request(Request.FORMAT(path, source))
        si

        send_format_range(path: string, start_line: int, start_column: int, end_line: int, end_column: int, source: string) is
            write_request(Request.FORMAT_RANGE(path, start_line, start_column, end_line, end_column, source))
        si

        send_compile() is
            write_request(Request.COMPILE())
        si

        // Ask the analyser to recycle. It answers with a restart response and
        // then exits, so the IDE can spawn a fresh process.
        send_restart() is
            write_request(Request.RESTART())
        si

        // Adds assemblies to the running analyser's reference set. It
        // answers with an add_references frame.
        send_add_references(paths: Collections.Iterable[string]) is
            write_request(Request.ADD_REFERENCES(Collections.LIST[string](paths)))
        si

        // Ask the analyser to sample the heap. It answers with a heap_check
        // response — or, if the heap has grown past the recycle threshold, with
        // restart and then exits.
        send_heap_check() is
            write_request(Request.HEAP_CHECK())
        si

        // Ask the analyser how much memory its process occupies. It answers
        // with a memory_usage response.
        send_memory_usage() is
            write_request(Request.MEMORY_USAGE())
        si

        // Ask the analyser for a snapshot of its internal timers and
        // counters. It answers with a stats response carrying one entry
        // per named timer, including the edit-path tallies.
        send_stats() is
            write_request(Request.STATS())
        si

        // Send STATS and return the count of a single named timer, or 0
        // when the analyser has never recorded it. Tests read a counter
        // before and after an edit and assert on the delta.
        stat_count(name: string) -> int is
            send_stats()

            let response = read_response()
            assert isa Response.STATS(response) else "expected STATS response"

            for entry in response.entries do
                if entry.name =~ name then
                    return entry.count
                fi
            od

            return 0
        si

        // Send STATS once and return every counter as a map. Asserting on
        // several counters over one action wants a single snapshot: a
        // counter read per name would be one round trip each, and the
        // reads would not describe the same instant.
        stat_counts() -> Collections.MutableMap[string,int] is
            send_stats()

            let response = read_response()
            assert isa Response.STATS(response) else "expected STATS response"

            let result = Collections.MAP[string,int]()

            for entry in response.entries do
                result[entry.name] = entry.count
            od

            return result
        si

        // Block until the subprocess exits, up to timeout_ms. True if it exited.
        wait_for_exit(timeout_ms: int) -> bool =>
            _process.wait_for_exit(timeout_ms)

        // Status the analyser exited with. The analyser distinguishes a
        // deliberate idle exit (0) from a watchdog recycle (1), so a client
        // that missed the frame can still tell whether to relaunch at once.
        // Only meaningful once wait_for_exit has returned true.
        exit_code: int => _process.exit_code

        // OS process id of the spawned analyser — lets an external sampling
        // profiler (dotnet-trace) attach to the process under test.
        process_id: int => _process.id

        send_hover(path: string, line: int, column: int) is
            write_request(Request.HOVER(path, line, column))
        si

        send_hover_map(path: string) is
            write_request(Request.HOVER_MAP(path))
        si

        send_semantic_tokens(path: string) is
            write_request(Request.SEMANTIC_TOKENS(path))
        si

        send_inlay_hints(path: string) is
            send_inlay_hints(path, null)
        si

        // `range` is the viewport to answer within, as (start_line,
        // start_column, end_line, end_column) with the end exclusive;
        // null asks for the whole file.
        send_inlay_hints(
            path: string,
            range: (int, int, int, int)?
        ) is
            if let (start_line, start_column, end_line, end_column) = range then
                write_request(
                    Request.INLAY_HINTS(path, start_line, start_column, end_line, end_column)
                )
            else
                write_request(
                    Request.INLAY_HINTS(path, null, null, null, null)
                )
            fi
        si

        send_definition(path: string, line: int, column: int) is
            write_request(Request.DEFINITION(path, line, column))
        si

        send_declaration(path: string, line: int, column: int) is
            write_request(Request.DECLARATION(path, line, column))
        si

        send_references(path: string, line: int, column: int) is
            write_request(Request.REFERENCES(path, line, column))
        si

        send_implementation(path: string, line: int, column: int) is
            write_request(Request.IMPLEMENTATION(path, line, column))
        si

        send_type_definition(path: string, line: int, column: int) is
            write_request(Request.TYPE_DEFINITION(path, line, column))
        si

        send_completion(path: string, line: int, column: int) is
            write_request(Request.COMPLETE(path, line, column, false))
        si

        send_member_completion(path: string, line: int, column: int) is
            write_request(Request.COMPLETE(path, line, column, true))
        si

        send_signature(path: string, line: int, column: int) is
            write_request(Request.SIGNATURE(path, line, column))
        si

        send_symbols(path: string) is
            write_request(Request.SYMBOLS(path))
        si

        // Ask for the quick fixes of one file's diagnostics over one range.
        send_code_actions(
            path: string,
            start_line: int, start_column: int,
            end_line: int, end_column: int
        ) is
            write_request(Request.CODE_ACTIONS(path, start_line, start_column, end_line, end_column))
        si

        send_describe_type(type_expression: string) is
            write_request(Request.DESCRIBE_TYPE(type_expression))
        si

        send_rename_request(path: string, line: int, column: int, new_name: string) is
            write_request(Request.RENAME(path, line, column, new_name))
        si

        // Drain stdin, wait for exit, kill on overrun — a runaway analyser
        // shouldn't leak across tests.
        dispose() is
            try
                _process.standard_input.close()
            catch ex: Exception
            yrt

            if !_process.wait_for_exit(2000) then
                try
                    _process.kill()
                catch ex: Exception
                yrt
            fi

            try
                Directory.delete(_response_directory, true)
            catch ex: Exception
            yrt
        si

        stderr_capture: string => _stderr_capture.to_string()

        // Wait until the compiler's startup banner appears in captured stderr
        // and return the version string from it.
        await_compiler_version(timeout_ms: int) -> string is
            let deadline_ticks = System.DateTime.now.add_milliseconds(cast double(timeout_ms)).ticks

            do
                let captured = _stderr_capture.to_string()
                let version = parse_version_from_banner(captured)

                if version? then
                    return version
                fi

                if System.DateTime.now.ticks > deadline_ticks then
                    throw Exception("timed out waiting for compiler version banner.\nstderr captured so far:\n{captured}")
                fi

                System.Threading.Thread.sleep(10)
            od
        si

        // The banner is the process's first stderr write, which on a cold
        // runner comes after a full JIT of the compiler - the ceiling has to
        // cover that first-spawn cost, not just a warm process. The poll
        // returns the moment the banner arrives, so a longer ceiling costs
        // nothing on a healthy spawn.
        await_compiler_version() -> string => await_compiler_version(15000)

        BANNER_PREFIX: string static => "ghūl compiler "
        BANNER_SUFFIX: string static => ": serving analysis requests"

        parse_version_from_banner(captured: string) -> string? static is
            let prefix_index = captured.index_of(BANNER_PREFIX)

            if prefix_index < 0 then
                return null
            fi

            let after_prefix = prefix_index + BANNER_PREFIX.length
            let suffix_index = captured.index_of(BANNER_SUFFIX, after_prefix)

            if suffix_index < 0 then
                return null
            fi

            // The banner reports the host the compiler runs on beside the
            // version (`ghūl compiler 66.3.0 dotnet-jit: ...`); callers
            // compare against a minimum version, so only the version
            // token comes back.
            let middle = captured.substring(after_prefix, suffix_index - after_prefix)
            let space_index = middle.index_of(' ')

            if space_index >= 0 then
                return middle.substring(0, space_index)
            fi

            return middle
