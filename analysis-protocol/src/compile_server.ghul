@@IF.dotnet()

namespace Analysis.Protocol is
    use Ghul.Disposable
    use System.Exception
    use System.Diagnostics.Process
    use System.Diagnostics.ProcessStartInfo
    use System.Text.Json.JsonSerializer
    use System.Text.Json.JsonSerializerOptions

    use Collections.Iterable
    use Collections.LIST

    // One compile, sent to `ghul-compiler --compile-server` as one line of
    // JSON. `source` names the file to compile; `text` carries the source
    // itself instead, and the file is then named `<name>.ghul` in the
    // diagnostics. `output` is the assembly to write, and `references` the
    // assemblies of earlier submissions the compile can see.
    //
    // With `check` set, the request asks only whether the source is
    // complete, incomplete or invalid, as `--check-complete` answers it:
    // nothing is compiled, and only `source` or `text` is needed.
    //
    // JSON DTO: the parameterless constructor is for the deserializer,
    // which populates fields by reflection after construction.
    @suppress("field-definite-assignment")
    @reflected()
    class COMPILE_REQUEST is
        name: string public
        source: string? public
        text: string? public
        output: string public
        references: LIST[string]? public
        check: bool public

        init() is si

        init(name: string, source: string?, text: string?, output: string, references: Iterable[string]) is
            self.name = name
            self.source = source
            self.text = text
            self.output = output
            self.references = LIST[string](references)
        si

        checking(text: string) -> COMPILE_REQUEST static is
            let result = COMPILE_REQUEST()

            result.name = "check"
            result.text = text
            result.output = ""
            result.check = true

            return result
        si
    si

    // The answer to one line from the compile server. The server's first
    // line has `ready` set and nothing else. After that each request gets
    // one reply: `status` is 0 when the assembly was written, 1 when the
    // source has errors, and 2 when the request could not be carried out,
    // with `message` saying why. `diagnostics` is what the compile
    // reported, in the analysis protocol's shape.
    //
    // JSON DTO: the parameterless constructor is for the deserializer,
    // which populates fields by reflection after construction.
    @suppress("field-definite-assignment")
    @reflected()
    class COMPILE_REPLY is
        ready: bool public
        status: int public
        message: string? public
        diagnostics: LIST[DIAGNOSTIC] public

        // The answer to a `check` request: "complete", "incomplete" or
        // "invalid". Null for a compile.
        completeness: string? public

        // For a complete `check`, what the last thing at the root of the
        // source is: "expression", "loop", "let", "assignment",
        // "function", "definition" or "statement". Null otherwise.
        last_statement: string? public

        init() is
            diagnostics = LIST[DIAGNOSTIC]()
        si

        init(ready: bool, status: int, message: string?, diagnostics: LIST[DIAGNOSTIC]) is
            self.ready = ready
            self.status = status
            self.message = message
            self.diagnostics = diagnostics
        si

        ready_reply() -> COMPILE_REPLY static => COMPILE_REPLY(true, 0, null, LIST[DIAGNOSTIC]())

        failure(message: string) -> COMPILE_REPLY static => COMPILE_REPLY(false, 2, message, LIST[DIAGNOSTIC]())

        checked(completeness: string, last_statement: string?) -> COMPILE_REPLY static is
            let result = COMPILE_REPLY(false, 0, null, LIST[DIAGNOSTIC]())

            result.completeness = completeness
            result.last_statement = last_statement

            return result
        si
    si

    // A `ghul-compiler --compile-server` process, and the one line each
    // way per compile it speaks. The constructor returns once the server
    // has said it is ready.
    @suppress("field-definite-assignment")
    class COMPILE_SERVER_PROCESS: Disposable is
        _process: Process
        _options: JsonSerializerOptions

        // `compiler_dll` is the ghul.dll to run; `arguments` are the
        // driver flags that set up the reference set, as a batch compile
        // would take them.
        init(compiler_dll: string, arguments: Iterable[string]) is
            _options = JSON_OPTIONS.create()

            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.argument_list.add(compiler_dll)

            for argument in arguments do
                start_info.argument_list.add(argument)
            od

            start_info.argument_list.add("--compile-server")

            start_info.use_shell_execute = false
            start_info.redirect_standard_input = true
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            let process = Process.start(start_info)

            if !process? then
                throw Exception("could not start the compile server")
            fi

            _process = process

            // Drained so a server writing to standard error cannot fill the
            // pipe and stall.
            _process.begin_error_read_line()

            let reply = _read_reply()

            if !reply.ready then
                throw Exception("the compile server did not say it was ready")
            fi
        si

        compile(request: COMPILE_REQUEST) -> COMPILE_REPLY is
            send_line(JsonSerializer.serialize[COMPILE_REQUEST](request, _options))

            return _read_reply()
        si

        // Whether `text` is complete, incomplete or invalid, without
        // compiling it.
        check(text: string) -> COMPILE_REPLY => compile(COMPILE_REQUEST.checking(text))

        // Sends one line as it stands, for a test of what the server makes
        // of a request that is not one; the reply is read as usual.
        send_raw(line: string) -> COMPILE_REPLY is
            send_line(line)

            return _read_reply()
        si

        send_line(line: string) is
            _process.standard_input.write(line)
            _process.standard_input.write("\n")
            _process.standard_input.flush()
        si

        _read_reply() -> COMPILE_REPLY is
            let line = _process.standard_output.read_line()

            if !line? then
                throw Exception("the compile server closed its output")
            fi

            let reply = JsonSerializer.deserialize[COMPILE_REPLY](line, _options)

            if !reply? then
                throw Exception("the compile server sent a line that is not a reply: {line}")
            fi

            return reply
        si

        dispose() is
            try
                _process.standard_input.close()

                if !_process.wait_for_exit(10000) then
                    _process.kill()
                fi
            catch e: Exception
                // The process is going regardless; nothing to report.
            yrt

            _process.dispose()
        si
    si
si
