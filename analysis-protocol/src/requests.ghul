namespace Analysis.Protocol is
    use Collections.LIST

    // Client-side request DTOs. The compiler routes on the `kind`
    // discriminator, the variant's name in lower case.

    // JSON DTO: the parameterless constructor is for the deserializer,
    // which populates fields by reflection after construction.
    @suppress("field-definite-assignment")
    class EDIT_FILE is
        path: string public
        source: string public

        init() is si

        init(path: string, source: string) is
            self.path = path
            self.source = source
        si
    si

    // One replaced span of a file the analyser already holds. The client
    // sends only the span it changed; the analyser splices it into its own
    // retained copy of the file and proceeds as it would for the whole
    // text.
    // JSON DTO: the parameterless constructor is for the deserializer,
    // which populates fields by reflection after construction.
    @suppress("field-definite-assignment")
    class EDIT_DELTA_FILE is
        path: string public

        // The replaced span, in the analyser's retained text for this
        // file. 1-based lines and columns with the end position
        // exclusive, matching DIAGNOSTIC ranges; a zero-width span is an
        // insertion.
        start_line: int public
        start_column: int public
        end_line: int public
        end_column: int public

        new_text: string public

        // Length in characters of the text the span was computed
        // against. A span applied to text that is not the text it was
        // computed against yields a plausible file rather than a
        // failure, so the analyser checks this against its own copy and
        // recycles rather than splicing on a guess. Keeping the two
        // copies in step is the client's job; this only catches it
        // having gone wrong.
        expected_length: int public

        init() is si

        init(
            path: string,
            start_line: int, start_column: int, end_line: int, end_column: int,
            new_text: string,
            expected_length: int
        ) is
            self.path = path
            self.start_line = start_line
            self.start_column = start_column
            self.end_line = end_line
            self.end_column = end_column
            self.new_text = new_text
            self.expected_length = expected_length
        si
    si

    // A variant carrying an optional field lowers through a checked
    // `object` cast the compiler synthesizes; nothing in this file
    // constructs a variant by hand, so the throw path is unreachable.
    @suppress("cast-may-throw")
    union Request is
        EDIT(files: LIST[EDIT_FILE])

        // The same thing as EDIT, with each file's text given as the one
        // span that changed rather than in full. Whole-text sends are the
        // dominant cost of an edit on a large file, and almost all of
        // what they carry the analyser already has.
        //
        // A separate command rather than extra fields on EDIT: unknown
        // JSON members are ignored, so an analyser too old to know about
        // deltas would read an EDIT carrying them as a file whose source
        // is empty and blank the file. Clients send this only after
        // seeing the `edit-deltas` capability on the listen frame.
        //
        // A delta is answered by the diagnostics an EDIT carrying the
        // same text would have produced.
        //
        // Valid only for a file this client has already sent as full
        // text in an EDIT. A file's text is retained only when an EDIT
        // carried it - the analyser's own parse of a project source file
        // keeps a tree and no text - so having parsed a file, or the
        // file existing on disk, does not qualify it. Send full text the
        // first time a file is edited and again for every open file
        // after a restart; send deltas only for files sent since.
        //
        // Sending one for a file whose text the analyser does not hold,
        // or whose retained text is not what the spans were computed
        // against, is a client bug rather than a routine case: the
        // analyser recycles, and the client re-primes the replacement
        // with full text as it does after any restart.
        EDIT_DELTA(files: LIST[EDIT_DELTA_FILE])

        // The set of files the client currently has open. Fire-and-forget:
        // the analyser records it and only produces editor-only hints (which
        // are invisible for a file the user is not viewing) for these paths.
        // Full-set-replace; sent before the diagnostics-producing requests.
        SET_OPEN_FILES(paths: LIST[string])

        /// Asks the analyser to report its progress through work that can
        /// take a long time: a REBUILDING frame when an edit falls back to a
        /// whole-project rebuild, and a WORKING frame at most once a second
        /// while a build runs. Neither frame is written until this has been
        /// sent. Fire-and-forget. Only send it to an analyser that
        /// advertises the `progress-frames` capability.
        REPORT_PROGRESS

        COMPILE

        HOVER(path: string, line: int, column: int)
        HOVER_MAP(path: string)
        SEMANTIC_TOKENS(path: string)

        // The optional range limits the answer to the hints whose position
        // falls within it - the editor's viewport - so a high-volume kind
        // does not pay encode, transport and parse for a whole file. 1-based
        // lines and columns with the end position exclusive, matching
        // EDIT_DELTA spans. Any field absent means whole file: an older
        // client's frame reads the same as no range at all.
        INLAY_HINTS(
            path: string,
            start_line: int?,
            start_column: int?,
            end_line: int?,
            end_column: int?
        )

        DEFINITION(path: string, line: int, column: int)
        DECLARATION(path: string, line: int, column: int)
        // `is_member_trigger` says the client asked because the user
        // typed a member-access `.`, so the only useful answer is the
        // members of what precedes it. An analyser that finds no member
        // access at the position is looking at text older than the
        // client's, and answers with nothing rather than with the
        // enclosing scope. Absent from an older client's frame, where it
        // reads as false and the answer is unchanged.
        COMPLETE(path: string, line: int, column: int, is_member_trigger: bool)
        SIGNATURE(path: string, line: int, column: int)
        SYMBOLS(path: string?)

        REFERENCES(path: string, line: int, column: int)
        IMPLEMENTATION(path: string, line: int, column: int)
        TYPE_DEFINITION(path: string, line: int, column: int)

        RENAME(path: string, line: int, column: int, new_name: string)
        FORMAT(path: string, source: string)
        FORMAT_RANGE(
            path: string,
            start_line: int,
            start_column: int,
            end_line: int,
            end_column: int,
            source: string
        )

        RESTART
        HEAP_CHECK

        // Ask the analyser how much memory its process occupies. Unlike
        // HEAP_CHECK it never collects. Only sent to an analyser that
        // advertises the `memory-usage` capability.
        MEMORY_USAGE

        // Ask the analyser for a snapshot of its internal timers and
        // counters, notably the edit-path tallies that record how each
        // EDIT was handled. Read-only; touches no compile state.
        STATS

        // Resolve a type by qualified name (dotted, e.g.
        // `System.Text.StringBuilder`, `Semantic.Symbols.SIGNATURE_PART`),
        // returning its kind, ancestors and members. Trailing generic
        // brackets are ignored — `Collections.LIST[int]` and
        // `Collections.LIST` resolve to the same member list, since generic
        // argument substitution is not yet applied to member signatures.
        DESCRIBE_TYPE(type_expression: string)

        // Quick fixes for the diagnostics of one file overlapping one
        // range, computed on demand. Fixes are not attached to the
        // diagnostics a compile reports: synthesizing them costs a full
        // AST sweep per file holding a diagnostic, which on the edit path
        // is paid for the whole project on every keystroke and thrown
        // away. A client asks for the range it is about to offer actions
        // for instead.
        CODE_ACTIONS(
            path: string,
            start_line: int,
            start_column: int,
            end_line: int,
            end_column: int
        )

        // Assemblies to add to the reference set of a running analyser,
        // by path: the earlier cells of an interactive session, which
        // exist only once the session has compiled them. Every file is
        // resolved again against the larger set by the next build. Naming
        // an assembly already in the set is harmless; naming a different
        // assembly under a name the set already holds is refused. Sent
        // only after seeing the `add-references` capability on the listen
        // frame: an analyser that does not know the command fails the
        // request.
        ADD_REFERENCES(paths: LIST[string])
    si
si
