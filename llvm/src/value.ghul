namespace LLVM is
    /// A value an instruction or an initialiser can name: a local or global
    /// by name, or a constant. Every value carries its type, since LLVM
    /// writes the type beside almost every operand.
    union Value(type: Type) is
        /// A value local to a function, written `%name`: a parameter or the
        /// result of an instruction.
        LOCAL(name: string, ..)

        /// A global variable or a function, written `@name`. Its type is
        /// always a pointer.
        GLOBAL(name: string, ..)

        /// An integer constant. Written as the signed value its bits hold at
        /// the type's width, and as `true` or `false` for `i1`.
        INTEGER(value: bigint, ..)

        /// A floating point constant, held as the bits of its own type.
        FLOATING(bits: ulong, ..)

        /// The null pointer.
        NULL(..)

        /// The value of any type whose bits are all zero, written
        /// `zeroinitializer`.
        ZERO(..)

        /// A value of no particular bits, written `undef`.
        UNDEF(..)

        /// A value that makes any instruction depending on it undefined,
        /// written `poison`.
        POISON(..)

        /// A struct, array or vector constant, as its type says.
        AGGREGATE(elements: ARRAY[Value], ..)

        /// An array of bytes, written `c"..."`. Its type is `[N x i8]`.
        STRING(bytes: ARRAY[ubyte], ..)
    si

    /// Constructors for the values a module needs most often.
    class Values is
        /// A local value of the given type.
        /// - type: the value's type
        /// - name: the name it is written with, without the `%`
        local(type: Type, name: string) -> Value static => Value.LOCAL(name, type)

        /// A reference to a global variable or a function.
        /// - name: the name it is written with, without the `@`
        global(name: string) -> Value static => Value.GLOBAL(name, Types.pointer)

        /// An integer constant.
        /// - type: an integer type
        /// - value: the value, which must fit the type's width signed or unsigned
        integer(type: Type, value: bigint) -> Value static is
            if let (width): Type.INTEGER = type then
                let limit = bigint.one << width

                if value >= limit \/ value < -(limit >> 1) then
                    throw Ghul.ArgumentException("{value} does not fit in i{width}")
                fi

                return Value.INTEGER(value, type)
            fi

            throw Ghul.ArgumentException("an integer constant needs an integer type")
        si

        /// An `i32` constant.
        i32(value: int) -> Value static => integer(Types.i32, bigint(value))

        /// An `i64` constant.
        i64(value: long) -> Value static => integer(Types.i64, bigint(value))

        /// An `i1` constant, written `true` or `false`.
        boolean(value: bool) -> Value static => integer(Types.i1, if value then bigint.one else bigint.zero fi)

        /// A `double` constant.
        @IF.dotnet()
        of_double(value: double) -> Value static =>
            Value.FLOATING(cast ulong(System.BitConverter.double_to_int64_bits(value)), Type.DOUBLE)

        @IF.not.dotnet()
        of_double(value: double) -> Value static =>
            Value.FLOATING(cast ulong(value.to_bits()), Type.DOUBLE)

        /// A `float` constant.
        @IF.dotnet()
        of_single(value: single) -> Value static =>
            Value.FLOATING(cast ulong(cast uint(System.BitConverter.single_to_int32_bits(value))), Type.FLOAT)

        @IF.not.dotnet()
        of_single(value: single) -> Value static =>
            Value.FLOATING(cast ulong(cast uint(value.to_bits())), Type.FLOAT)

        /// A `half` constant, from its bits.
        /// - bits: the IEEE binary16 encoding of the value
        of_half(bits: ushort) -> Value static => Value.FLOATING(cast ulong(bits), Type.HALF)

        /// The null pointer in the default address space.
        null_pointer: Value static => Value.NULL(Types.pointer)

        /// The value of `type` whose bits are all zero.
        zero(type: Type) -> Value static => Value.ZERO(type)

        /// A value of `type` with no particular bits.
        undef(type: Type) -> Value static => Value.UNDEF(type)

        /// A poison value of `type`.
        poison(type: Type) -> Value static => Value.POISON(type)

        /// An array of bytes holding the UTF-8 encoding of `text`.
        /// - text: the characters to encode
        /// - terminated: whether a zero byte follows them
        c_string(text: string, terminated: bool) -> Value static is
            let encoded = System.Text.Encoding.utf8.get_bytes(text)
            let bytes = Collections.LIST[ubyte](encoded)

            if terminated then
                bytes.add(0ub)
            fi

            return Value.STRING(bytes.to_array(), Type.ARRAY(bytes.count, Types.i8))
        si
    si
si
