namespace LLVM is
    use Collections.LIST

    /// The integer operations LLVM can check for overflow.
    enum Overflow is
        SIGNED_ADD,
        UNSIGNED_ADD,
        SIGNED_SUB,
        UNSIGNED_SUB,
        SIGNED_MUL,
        UNSIGNED_MUL
    si

    /// Declarations of the LLVM intrinsics the backend calls. Each call
    /// makes a fresh declaration; `MODULE.declare_intrinsic` adds one to a
    /// module only once.
    class Intrinsics is
        /// `llvm.memcpy`, copying `i64` bytes between non-overlapping
        /// memory. Its last argument says whether the copy is volatile.
        memcpy() -> FUNCTION static =>
            _declare(
                "llvm.memcpy.p0.p0.i64",
                Type.VOID,
                [Types.pointer, Types.pointer, Types.i64, Types.i1])

        /// `llvm.memset`, filling `i64` bytes with one byte value. Its last
        /// argument says whether the fill is volatile.
        memset() -> FUNCTION static =>
            _declare(
                "llvm.memset.p0.i64",
                Type.VOID,
                [Types.pointer, Types.i8, Types.i64, Types.i1])

        /// `llvm.trap`, which stops the program abnormally.
        trap() -> FUNCTION static => _declare("llvm.trap", Type.VOID, [])

        /// `llvm.fptosi.sat`: a floating point value converted to a signed
        /// integer, saturating at the integer's limits, with NaN giving zero.
        /// - to: the integer type
        /// - from: the floating point type
        float_to_signed_saturating(to: Type, from: Type) -> FUNCTION static =>
            _declare("llvm.fptosi.sat.{suffix(to)}.{suffix(from)}", to, [from])

        /// `llvm.fptoui.sat`: a floating point value converted to an
        /// unsigned integer, saturating at the integer's limits, with NaN
        /// giving zero.
        /// - to: the integer type
        /// - from: the floating point type
        float_to_unsigned_saturating(to: Type, from: Type) -> FUNCTION static =>
            _declare("llvm.fptoui.sat.{suffix(to)}.{suffix(from)}", to, [from])

        /// An integer operation that also says whether it overflowed. The
        /// result is a struct of the wrapped value and an `i1`.
        /// - operation: the operation and whether it is signed
        /// - type: the integer type of both operands
        with_overflow(operation: Overflow, type: Type) -> FUNCTION static is
            let name =
                case operation
                when Overflow.SIGNED_ADD then "sadd"
                when Overflow.UNSIGNED_ADD then "uadd"
                when Overflow.SIGNED_SUB then "ssub"
                when Overflow.UNSIGNED_SUB then "usub"
                when Overflow.SIGNED_MUL then "smul"
                when Overflow.UNSIGNED_MUL then "umul"
                esac

            return _declare(
                "llvm.{name}.with.overflow.{suffix(type)}",
                Types.structure([type, Types.i1]),
                [type, type])
        si

        /// The part of an overloaded intrinsic's name that stands for a
        /// type: `i32`, `f64`, `p0`, `v4f32`.
        suffix(type: Type) -> string static =>
            case type
            when integer: Type.INTEGER then "i{integer.width}"
            when Type.HALF then "f16"
            when Type.FLOAT then "f32"
            when Type.DOUBLE then "f64"
            when pointer: Type.POINTER then "p{pointer.address_space}"
            when vector: Type.VECTOR then "v{vector.count}{suffix(vector.element)}"
            else throw Ghul.ArgumentException("no intrinsic suffix for this type")
            esac

        _declare(name: string, result: Type, parameters: ARRAY[Type]) -> FUNCTION static is
            let declared = LIST[PARAMETER]()

            for (i, type) in parameters |> Ghul.Pipes.index() do
                declared.add(PARAMETER(type, "a{i}"))
            od

            return FUNCTION(name, result, declared.to_array())
        si
    si
si
