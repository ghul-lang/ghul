namespace LLVM is
    use Collections.LIST
    use Collections.List

    use Argument = (value: Value, attributes: ARRAY[Attribute])
    use SwitchCase = (value: Value, target: string)

    /// One instruction in a block: what it does, and the value it
    /// produces, if any.
    class INSTRUCTION is
        /// What the instruction does.
        operation: Operation

        /// The value the instruction produces, or absent when it produces
        /// none.
        result: Value?

        /// Metadata attached to the instruction, such as its `!dbg`
        /// location, in the order it was attached.
        attachments: LIST[(kind: string, node: Metadata)]

        /// - operation: what the instruction does
        /// - result: the value it produces, or absent when it produces none
        init(operation: Operation, result: Value?) is
            self.operation = operation
            self.result = result
            attachments = LIST[(kind: string, node: Metadata)]()
        si

        /// Attaches metadata to the instruction.
        /// - kind: the attachment's kind without the `!`, such as `dbg`
        /// - node: the metadata attached, a reference to a node
        attach(kind: string, node: Metadata) is
            attachments.add((kind = kind, node = node))
        si

        /// Whether the instruction ends a block.
        is_terminator: bool =>
            case operation
            when _: Operation.RETURN then true
            when _: Operation.BRANCH then true
            when _: Operation.CONDITIONAL_BRANCH then true
            when _: Operation.SWITCH then true
            when _: Operation.UNREACHABLE then true
            when _: Operation.INVOKE then true
            when _: Operation.RESUME then true
            else false
            esac

        /// The labels of the blocks the instruction can branch to.
        targets: Collections.Iterable[string] is
            let result = LIST[string]()

            case operation
            when branch: Operation.BRANCH then
                result.add(branch.target)
            when branch: Operation.CONDITIONAL_BRANCH then
                result.add(branch.if_true)
                result.add(branch.if_false)
            when switch: Operation.SWITCH then
                result.add(switch.otherwise)

                for case_ in switch.cases do
                    result.add(case_.target)
                od
            when invoke: Operation.INVOKE then
                result.add(invoke.normal)
                result.add(invoke.unwind)
            else
                return result
            esac

            return result
        si
    si

    /// A basic block: a label and a run of instructions that ends in
    /// exactly one terminator. The methods that add an instruction add it
    /// at the end and return the value it produces, named with the
    /// function's next free name.
    class BLOCK is
        _function: FUNCTION
        _instructions: LIST[INSTRUCTION]

        /// The block's label, without the `%`.
        name: string

        /// The block's instructions, in order.
        instructions: List[INSTRUCTION] => _instructions

        /// The instruction added last, to attach metadata to.
        last_instruction: INSTRUCTION => _instructions[_instructions.count - 1]

        /// The location attached as `!dbg` to every instruction added from
        /// now on, or absent to attach none.
        debug_location: Metadata? public

        /// The block as a branch names it.
        label: Value => Values.local(Type.LABEL, name)

        /// - function: the function the block belongs to
        /// - name: the block's label, without the `%`
        init(function: FUNCTION, name: string) is
            _function = function
            self.name = name

            _instructions = LIST[INSTRUCTION]()
        si

        /// Replaces the block's terminator with an unconditional branch to
        /// `target`, keeping the old terminator's attached metadata.
        ///
        /// - target: the block the branch goes to
        replace_terminator(target: BLOCK) is
            let old = _instructions[_instructions.count - 1]
            let replacement = INSTRUCTION(Operation.BRANCH(target.name), null)

            for (kind, node) in old.attachments do
                replacement.attach(kind, node)
            od

            _instructions[_instructions.count - 1] = replacement
        si

        /// Adds an instruction, with the value it produces if any.
        /// - operation: what the instruction does
        /// - result: the value it produces, or absent when it produces none
        append(operation: Operation, result: Value?) -> INSTRUCTION is
            let instruction = INSTRUCTION(operation, result)

            if let location = debug_location /\ !isa Operation.DEBUG_DECLARE(operation) then
                instruction.attach("dbg", location)
            fi

            _instructions.add(instruction)

            return instruction
        si

        _produce(operation: (string) -> Operation, type: Type) -> Value is
            let name = _function.fresh_name()
            let result = Values.local(type, name)

            append(operation(name), result)

            return result
        si

        /// Reserves stack space for one value of `type`.
        /// - type: the type of the value the space holds
        /// - alignment: its alignment in bytes, or zero to leave it to the target
        alloca(type: Type, alignment: int) -> Value =>
            _produce(name => Operation.ALLOCA(name, type, null, alignment), Types.pointer)

        /// Reads a value of `type` through `pointer`.
        /// - type: the type of the value read
        /// - pointer: where to read it from
        /// - alignment: the alignment of the address in bytes, or zero for the type's own
        load(type: Type, pointer: Value, alignment: int) -> Value =>
            _produce(name => Operation.LOAD(name, type, pointer, alignment, false), type)

        /// Writes `value` through `pointer`.
        /// - value: the value written
        /// - pointer: where to write it
        /// - alignment: the alignment of the address in bytes, or zero for the type's own
        store(value: Value, pointer: Value, alignment: int) =>
            append(Operation.STORE(value, pointer, alignment, false), null)

        /// Computes the address of an element within a value of `source`
        /// that `pointer` points at.
        /// - source: the type the indices step through
        /// - pointer: the address of the value
        /// - indices: the first steps over values of `source`, the rest into it
        /// - in_bounds: whether the address is promised to stay within the object
        element_pointer(source: Type, pointer: Value, indices: ARRAY[Value], in_bounds: bool) -> Value =>
            _produce(name => Operation.GET_ELEMENT_POINTER(name, source, pointer, indices, in_bounds), Types.pointer)

        /// Applies an integer operator, with any flags it allows.
        /// - operator: an integer operator
        /// - flags: the promises made about the operands and the result
        /// - left: the first operand, whose type is the result's
        /// - right: the second operand
        binary(operator: BinaryOperator, flags: IntegerFlags, left: Value, right: Value) -> Value =>
            _produce(name => Operation.BINARY(name, operator, flags, FastMath.NONE, left, right), left.type)

        /// Applies a floating point operator, with any fast-math flags.
        /// - operator: a floating point operator
        /// - fast_math: what the operation need not preserve
        /// - left: the first operand, whose type is the result's
        /// - right: the second operand
        floating(operator: BinaryOperator, fast_math: FastMath, left: Value, right: Value) -> Value =>
            _produce(name => Operation.BINARY(name, operator, IntegerFlags.NONE, fast_math, left, right), left.type)

        /// Negates a floating point value.
        negate(operand: Value) -> Value =>
            _produce(name => Operation.NEGATE(name, FastMath.NONE, operand), operand.type)

        /// Compares two integers or pointers.
        compare(predicate: IntegerPredicate, left: Value, right: Value) -> Value =>
            _produce(name => Operation.INTEGER_COMPARE(name, predicate, left, right), Types.i1)

        /// Compares two floating point values.
        compare(predicate: FloatPredicate, left: Value, right: Value) -> Value =>
            _produce(name => Operation.FLOAT_COMPARE(name, predicate, FastMath.NONE, left, right), Types.i1)

        /// Converts `value` to `to`.
        /// - operator: the conversion
        /// - value: the value converted
        /// - to: the type it is converted to
        convert(operator: Conversion, value: Value, to: Type) -> Value =>
            _produce(name => Operation.CONVERT(name, operator, IntegerFlags.NONE, value, to), to)

        /// Chooses between two values of the same type by an `i1`.
        select(condition: Value, if_true: Value, if_false: Value) -> Value =>
            _produce(name => Operation.SELECT(name, condition, if_true, if_false), if_true.type)

        /// Calls a function. A call to a function returning `void` produces
        /// no value, and the result is absent.
        /// - function_type: the callee's type, a `Type.FUNCTION`
        /// - callee: the function called, directly by name or through a pointer
        /// - arguments: the arguments, in order
        call(function_type: Type, callee: Value, arguments: ARRAY[Value]) -> Value? =>
            call(TailCall.NONE, function_type, callee, arguments)

        /// Calls a function, as a tail call or not.
        /// - tail: whether the call is, may be or must be a tail call
        /// - function_type: the callee's type, a `Type.FUNCTION`
        /// - callee: the function called, directly by name or through a pointer
        /// - arguments: the arguments, in order
        call(tail: TailCall, function_type: Type, callee: Value, arguments: ARRAY[Value]) -> Value? is
            let result_type = _result_of(function_type)

            if result_type =~ Type.VOID then
                append(
                    Operation.CALL(null, tail, CallingConvention.C, function_type, callee, _arguments(arguments), [], []),
                    null)

                return null
            fi

            return _produce(
                name => Operation.CALL(name, tail, CallingConvention.C, function_type, callee, _arguments(arguments), [], []),
                result_type)
        si

        /// Calls a function defined or declared in the module.
        /// - function: the function called
        /// - arguments: the arguments, in order
        call(function: FUNCTION, arguments: ARRAY[Value]) -> Value? =>
            call(TailCall.NONE, function.type, function.reference, arguments)

        /// Reads one member out of a struct or array value.
        /// - type: the type of the member read
        /// - aggregate: the struct or array value
        /// - indices: the path to the member, outermost first
        extract_value(type: Type, aggregate: Value, indices: ARRAY[int]) -> Value =>
            _produce(name => Operation.EXTRACT_VALUE(name, aggregate, indices), type)

        /// A copy of a struct or array value with one member replaced.
        /// - aggregate: the struct or array value
        /// - element: the new value of the member
        /// - indices: the path to the member, outermost first
        insert_value(aggregate: Value, element: Value, indices: ARRAY[int]) -> Value =>
            _produce(name => Operation.INSERT_VALUE(name, aggregate, element, indices), aggregate.type)

        /// Returns `value` from the function.
        return_value(value: Value) => append(Operation.RETURN(value), null)

        /// Returns from a function returning `void`.
        return_void() => append(Operation.RETURN(null), null)

        /// Branches to `target`.
        branch(target: BLOCK) => append(Operation.BRANCH(target.name), null)

        /// Branches to `if_true` or `if_false` by an `i1`, answering the branch
        /// so metadata can be attached to it.
        branch(condition: Value, if_true: BLOCK, if_false: BLOCK) -> INSTRUCTION =>
            append(Operation.CONDITIONAL_BRANCH(condition, if_true.name, if_false.name), null)

        /// Branches to the block whose case matches `value`, or to
        /// `otherwise` when none does.
        /// - value: an integer
        /// - otherwise: the block branched to when no case matches
        /// - cases: the constant each case matches, with its block
        switch(value: Value, otherwise: BLOCK, cases: ARRAY[(Value, BLOCK)]) is
            let named = LIST[SwitchCase]()

            for (constant, target) in cases do
                named.add((value = constant, target = target.name))
            od

            append(Operation.SWITCH(value, otherwise.name, named.to_array()), null)
        si

        /// Marks the end of the block as never reached.
        unreachable() => append(Operation.UNREACHABLE, null)

        /// Records that the source variable `variable` lives at `address`,
        /// declared at `location`.
        declare(address: Value, variable: Metadata, location: Metadata) =>
            append(Operation.DEBUG_DECLARE(address, variable, location), null)

        /// Calls a function and continues at `normal`, or at `unwind` if it
        /// throws. A call to a function returning `void` produces no value,
        /// and the result is absent.
        /// - function_type: the callee's type, a `Type.FUNCTION`
        /// - callee: the function called, directly by name or through a pointer
        /// - arguments: the arguments, in order
        /// - normal: the block entered when the callee returns
        /// - unwind: the block entered when the callee throws, which starts with a landing pad
        invoke(function_type: Type, callee: Value, arguments: ARRAY[Value], normal: BLOCK, unwind: BLOCK) -> Value? is
            let result_type = _result_of(function_type)

            let operation = (name: string?) =>
                Operation.INVOKE(
                    name, CallingConvention.C, function_type, callee, _arguments(arguments), [], [], normal.name, unwind.name)

            if result_type =~ Type.VOID then
                append(operation(null), null)

                return null
            fi

            return _produce(name => operation(name), result_type)
        si

        /// Produces the exception value at the start of a block an invoke
        /// unwinds to.
        /// - type: the type of the exception value
        /// - is_cleanup: whether the block is entered for every exception, to clean up
        /// - catches: the type information values the block catches
        landing_pad(type: Type, is_cleanup: bool, catches: ARRAY[Value]) -> Value =>
            _produce(name => Operation.LANDING_PAD(name, type, is_cleanup, catches), type)

        /// Continues unwinding with an exception value.
        resume(value: Value) => append(Operation.RESUME(value), null)

        _result_of(function_type: Type) -> Type is
            if let (result, _, _): Type.FUNCTION = function_type then
                return result
            fi

            throw Ghul.ArgumentException("a call needs a function type")
        si

        _arguments(values: ARRAY[Value]) -> ARRAY[Argument] is
            let result = LIST[Argument]()

            for value in values do
                result.add((value = value, attributes = []))
            od

            return result.to_array()
        si
    si
si
