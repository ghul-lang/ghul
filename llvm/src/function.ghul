namespace LLVM is
    use Collections.LIST
    use Collections.List

    /// A parameter of a function: its type, the name its body knows it
    /// by, and its attributes.
    class PARAMETER is
        /// The parameter's type.
        type: Type

        /// The name it is written with, without the `%`.
        name: string

        /// The parameter's attributes, such as `noundef` or `nonnull`.
        attributes: LIST[Attribute]

        /// The parameter as a value the body can use.
        value: Value => Values.local(type, name)

        /// - type: the parameter's type
        /// - name: the name it is written with, without the `%`
        init(type: Type, name: string) is
            self.type = type
            self.name = name
            attributes = LIST[Attribute]()
        si
    si

    /// A function. With no blocks it is a declaration of a function defined
    /// elsewhere; with blocks it is a definition, whose first block is its
    /// entry.
    class FUNCTION is
        _blocks: LIST[BLOCK]
        _next_temporary: int

        /// The name it is written with, without the `@`.
        name: string

        /// The type the function returns.
        result: Type

        /// The function's parameters, in order.
        parameters: List[PARAMETER]

        /// Whether the function takes further arguments after its
        /// parameters, written `...`.
        is_variadic: bool public

        /// How far outside its module the function can be seen.
        linkage: Linkage public

        /// Whether the function is known to resolve within the linked
        /// executable, written `dso_local`.
        dso_local: bool public

        /// Whether the function's address is significant.
        unnamed_address: UnnamedAddress public

        /// The function's calling convention, which every call to it must
        /// share.
        calling_convention: CallingConvention public

        /// Attributes on the value the function returns, such as `noundef`.
        result_attributes: LIST[Attribute]

        /// Attributes on the function itself, such as `nounwind`.
        attributes: LIST[Attribute]

        /// The function that decides which landing pads an exception
        /// enters, or absent when nothing in the function catches.
        personality: Value? public

        /// Metadata attached to the function, such as its `!dbg`
        /// subprogram, in the order it was attached.
        attachments: LIST[(kind: string, node: Metadata)]

        /// The function's blocks, entry first. Empty for a declaration.
        blocks: List[BLOCK] => _blocks

        /// Whether the function is a declaration rather than a definition.
        is_declaration: bool => _blocks.count == 0

        /// The function's type.
        type: Type is
            let parameter_types = LIST[Type]()

            for parameter in parameters do
                parameter_types.add(parameter.type)
            od

            return Type.FUNCTION(result, parameter_types.to_array(), is_variadic)
        si

        /// A reference to the function, as a call or an initialiser names it.
        reference: Value => Values.global(name)

        /// - name: the name it is written with, without the `@`
        /// - result: the type it returns
        /// - parameters: its parameters, in order
        init(name: string, result: Type, parameters: ARRAY[PARAMETER]) is
            self.name = name
            self.result = result
            self.parameters = LIST[PARAMETER](parameters)

            result_attributes = LIST[Attribute]()
            attributes = LIST[Attribute]()
            attachments = LIST[(kind: string, node: Metadata)]()

            _blocks = LIST[BLOCK]()
        si

        /// Attaches metadata to the function.
        /// - kind: the attachment's kind without the `!`, such as `dbg`
        /// - node: the metadata attached, a reference to a node
        attach(kind: string, node: Metadata) is
            attachments.add((kind = kind, node = node))
        si

        /// The parameter at `index` as a value the body can use.
        parameter(index: int) -> Value => parameters[index].value

        /// Adds a block after every block already added. The first block
        /// added is the function's entry.
        /// - name: the block's label, without the `%`
        add_block(name: string) -> BLOCK is
            let block = BLOCK(self, name)

            _blocks.add(block)

            return block
        si

        /// Throws unless the definition is well formed: every block holds
        /// at least one instruction and ends in its only terminator, no two
        /// parameters, blocks or results share a name, and every block a
        /// terminator names is one of the function's own.
        check() is
            let names = Collections.SET[string]()
            let block_names = Collections.SET[string]()

            for parameter in parameters do
                _claim(names, parameter.name)
            od

            for block in _blocks do
                _claim(names, block.name)
                block_names.add(block.name)
            od

            for block in _blocks do
                let instructions = block.instructions

                if instructions.count == 0 then
                    throw Ghul.InvalidOperationException("block %{block.name} in @{name} is empty")
                fi

                for i in 0..instructions.count do
                    let instruction = instructions[i]
                    let is_last = i == instructions.count - 1

                    if instruction.is_terminator != is_last then
                        if is_last then
                            throw Ghul.InvalidOperationException("block %{block.name} in @{name} does not end in a terminator")
                        fi

                        throw Ghul.InvalidOperationException("block %{block.name} in @{name} has a terminator before its end")
                    fi

                    if let result: Value.LOCAL = instruction.result then
                        _claim(names, result.name)
                    fi

                    for target in instruction.targets do
                        if !block_names.contains(target) then
                            throw Ghul.InvalidOperationException("@{name} branches to %{target}, which is not one of its blocks")
                        fi
                    od
                od
            od
        si

        _claim(names: Collections.SET[string], local: string) is
            if !names.add(local) then
                throw Ghul.InvalidOperationException("%{local} is defined more than once in @{name}")
            fi
        si

        /// A name for an instruction's result that no other result in the
        /// function has: `t0`, `t1` and so on.
        fresh_name() -> string is
            let name = "t{_next_temporary}"

            _next_temporary = _next_temporary + 1

            return name
        si
    si
si
