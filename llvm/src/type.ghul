namespace LLVM is
    /// An LLVM type. Pointers are opaque: a pointer type says which address
    /// space it points into and nothing about what it points at.
    union Type is
        /// An integer of any width from 1 bit up, written `iN`.
        INTEGER(width: int)

        /// The 16-bit IEEE floating point type.
        HALF

        /// The 32-bit IEEE floating point type.
        FLOAT

        /// The 64-bit IEEE floating point type.
        DOUBLE

        /// An opaque pointer into an address space, written `ptr`, or
        /// `ptr addrspace(N)` for any space but 0.
        POINTER(address_space: int)

        /// The type of a function that returns nothing.
        VOID

        /// The type of a basic block, as a branch names one.
        LABEL

        /// The type of a metadata operand.
        METADATA

        /// A fixed number of elements of one type, written `[N x T]`.
        ARRAY(count: int, element: Type)

        /// A SIMD vector, written `<N x T>`.
        VECTOR(count: int, element: Type)

        /// A struct with no name, identified by its fields. A packed one has
        /// no padding between fields.
        STRUCT(fields: Collections.List[Type], packed: bool)

        /// A struct defined by name in the module, written `%name`.
        NAMED(name: string)

        /// The type of a function: what it returns and what it takes.
        FUNCTION(result: Type, parameters: Collections.List[Type], variadic: bool)
    si

    /// The types a module reaches for most often.
    class Types is
        /// `i1`, the type of a comparison's result.
        i1: Type static => Type.INTEGER(1)

        /// `i8`.
        i8: Type static => Type.INTEGER(8)

        /// `i16`.
        i16: Type static => Type.INTEGER(16)

        /// `i32`.
        i32: Type static => Type.INTEGER(32)

        /// `i64`.
        i64: Type static => Type.INTEGER(64)

        /// `ptr`, a pointer into the default address space.
        pointer: Type static => Type.POINTER(0)

        /// A literal, unpacked struct of the given fields.
        /// - fields: the field types, in order
        structure(fields: ARRAY[Type]) -> Type static => Type.STRUCT(fields, false)

        /// A function type that takes a fixed list of parameters.
        /// - result: what the function returns
        /// - parameters: the parameter types, in order
        function(result: Type, parameters: ARRAY[Type]) -> Type static => Type.FUNCTION(result, parameters, false)
    si
si
