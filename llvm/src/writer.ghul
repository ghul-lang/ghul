namespace LLVM is
    use Collections.LIST
    use Collections.SET

    use Argument = (value: Value, attributes: ARRAY[Attribute])

    /// Writes a module, or any part of one, as LLVM IR text.
    class WRITER is
        _out: Text.STRING_BUILDER
        _module: MODULE?
        _sink: ((string) -> void)?

        /// What has been written so far.
        text: string => _out.to_string()

        init() is
            _out = Text.STRING_BUILDER()
        si

        /// A whole module as LLVM IR text.
        module_text(module: MODULE) -> string static is
            let writer = WRITER()

            writer.write(module)

            return writer.text
        si

        /// Writes a whole module as LLVM IR text to `sink`, a piece at a
        /// time: the header, then each named type, global, function and
        /// metadata entry, so the module's text as a whole is never held.
        ///
        /// - module: the module to write
        /// - sink: given each piece of text in order
        write_module(module: MODULE, sink: (string) -> void) static is
            let writer = WRITER()

            writer._sink = sink
            writer.write(module)
            writer._flush()
        si

        // Hands what has been written to the sink, where there is one, and
        // starts again with an empty builder.
        _flush() is
            if let sink = _sink /\ _out.length > 0 then
                sink(_out.to_string())
                _out.clear()
            fi
        si

        /// The definitions of the functions of `module` that `include`
        /// accepts, as LLVM IR text, in the module's order, with none of
        /// its types, globals or metadata. A reference to anything left out
        /// is written as it would be in the whole module.
        ///
        /// - module: the module the functions belong to
        /// - include: whether a function is written
        functions_text(module: MODULE, include: (FUNCTION) -> bool) -> string static is
            let writer = WRITER()

            writer._module = module

            for function in module.functions do
                if include(function) then
                    writer._start_section()
                    writer.write(function)
                    writer._end_section()
                fi
            od

            writer._module = null

            return writer.text
        si

        /// A type as LLVM IR writes it.
        type_text(type: Type) -> string static is
            let writer = WRITER()

            writer.write(type)

            return writer.text
        si

        /// A value as LLVM IR writes it where its type is already known.
        value_text(value: Value) -> string static is
            let writer = WRITER()

            writer.write(value)

            return writer.text
        si

        /// A value with its type in front, as most operands are written.
        operand_text(value: Value) -> string static is
            let writer = WRITER()

            writer.write_operand(value)

            return writer.text
        si

        /// An instruction as LLVM IR writes it, without its indentation.
        instruction_text(instruction: INSTRUCTION) -> string static is
            let writer = WRITER()

            writer.write(instruction)

            return writer.text
        si

        /// An attribute as LLVM IR writes it.
        attribute_text(attribute: Attribute) -> string static is
            let writer = WRITER()

            writer.write(attribute)

            return writer.text
        si

        /// Writes a whole module: its header, named types, globals and
        /// functions, each group separated from the next by a blank line.
        write(module: MODULE) is
            _module = module

            let sections = LIST[string]()

            let header = Text.STRING_BUILDER()

            if let source_filename = module.source_filename then
                header.append("source_filename = {Names.quoted(source_filename)}\n")
            fi

            if let data_layout = module.data_layout then
                header.append("target datalayout = {Names.quoted(data_layout)}\n")
            fi

            if let target_triple = module.target_triple then
                header.append("target triple = {Names.quoted(target_triple)}\n")
            fi

            _section(header.to_string())

            for definition in module.types do
                _start_section()

                _out.append(Names.local(definition.name))
                _out.append(" = type ")

                if let body = definition.body then
                    if !isa Type.STRUCT(body) then
                        throw Ghul.InvalidOperationException("named type %{definition.name} must be a struct")
                    fi

                    write(body)
                else
                    _out.append("opaque")
                fi

                _out.append('\n')
            od

            _end_section()

            for global in module.globals do
                _start_section()

                write(global)

                _out.append('\n')

                _flush()
            od

            _end_section()

            for function in module.functions do
                _start_section()

                write(function)

                _end_section()
            od

            for named in module.named_metadata do
                _start_section()

                _out.append(Names.metadata(named.name))
                _out.append(" = !{{")

                let first mut = true

                for operand in named.operands do
                    if !first then
                        _out.append(", ")
                    fi

                    first = false

                    write(operand)
                od

                _out.append("}}\n")
            od

            _end_section()

            for definition in module.metadata do
                _start_section()

                _out.append("!{definition.index} = ")

                if definition.is_distinct then
                    _out.append("distinct ")
                fi

                write(definition.node)
                _out.append('\n')

                _flush()
            od

            _end_section()

            _module = null
        si

        _pending_blank: bool
        _section_open: bool

        _section(text: string) is
            if text.length > 0 then
                _start_section()
                _out.append(text)
                _end_section()
            fi
        si

        _start_section() is
            if _pending_blank /\ !_section_open then
                _out.append('\n')
            fi

            _section_open = true
        si

        _end_section() is
            if _section_open then
                _pending_blank = true
                _section_open = false
            fi

            _flush()
        si

        /// Writes a global variable's definition or declaration.
        write(global: GLOBAL_VARIABLE) is
            _out.append(Names.global(global.name))
            _out.append(" =")

            if let initializer = global.initializer then
                _linkage(global.linkage)
            elif global.linkage == Linkage.EXTERNAL then
                _out.append(" external")
            elif global.linkage == Linkage.EXTERN_WEAK then
                _out.append(" extern_weak")
            else
                throw Ghul.InvalidOperationException("@{global.name} has no initializer, so it must be external")
            fi

            if global.dso_local then
                _out.append(" dso_local")
            fi

            _unnamed_address(global.unnamed_address)

            _out.append(if global.is_constant then " constant " else " global " fi)

            write(global.type)

            if let initializer = global.initializer then
                _out.append(' ')
                write(initializer)
            fi

            if global.alignment > 0 then
                _out.append(", align {global.alignment}")
            fi
        si

        /// Writes a function's declaration, or its definition with its
        /// blocks. Throws if a definition's blocks are not well formed.
        write(function: FUNCTION) is
            let is_declaration = function.is_declaration

            if is_declaration then
                if function.linkage != Linkage.EXTERNAL /\ function.linkage != Linkage.EXTERN_WEAK then
                    throw Ghul.InvalidOperationException("@{function.name} has no body, so it must be external")
                fi

                _out.append("declare")
            else
                function.check()

                _out.append("define")
            fi

            _linkage(function.linkage)

            if function.dso_local then
                _out.append(" dso_local")
            fi

            _calling_convention(function.calling_convention)
            _attributes(function.result_attributes)

            _out.append(' ')
            write(function.result)
            _out.append(' ')
            _out.append(Names.global(function.name))
            _out.append('(')

            let first mut = true

            for parameter in function.parameters do
                if !first then
                    _out.append(", ")
                fi

                first = false

                write(parameter.type)
                _attributes(parameter.attributes)

                if !is_declaration then
                    _out.append(' ')
                    _out.append(Names.local(parameter.name))
                fi
            od

            if function.is_variadic then
                _out.append(if first then "..." else ", ..." fi)
            fi

            _out.append(')')

            _unnamed_address(function.unnamed_address)
            _attributes(function.attributes)

            if let personality = function.personality then
                _out.append(" personality ")
                write_operand(personality)
            fi

            if is_declaration /\ function.attachments.count > 0 then
                throw Ghul.InvalidOperationException("@{function.name} is a declaration, which this writer does not attach metadata to")
            fi

            for attachment in function.attachments do
                _out.append(' ')
                _out.append(Names.metadata(attachment.kind))
                _out.append(' ')
                write(attachment.node)
            od

            if is_declaration then
                _out.append('\n')
                return
            fi

            _out.append(" {{\n")

            let first_block mut = true

            for block in function.blocks do
                if !first_block then
                    _out.append('\n')
                fi

                first_block = false

                _out.append(Names.identifier(block.name))
                _out.append(":\n")

                for instruction in block.instructions do
                    _out.append("  ")
                    write(instruction)
                    _out.append('\n')
                od
            od

            _out.append("}}\n")
        si

        /// Writes a type.
        write(type: Type) is
            case type
            when integer: Type.INTEGER then
                _out.append("i{integer.width}")
            when Type.HALF then
                _out.append("half")
            when Type.FLOAT then
                _out.append("float")
            when Type.DOUBLE then
                _out.append("double")
            when pointer: Type.POINTER then
                _out.append("ptr")

                if pointer.address_space != 0 then
                    _out.append(" addrspace({pointer.address_space})")
                fi
            when Type.VOID then
                _out.append("void")
            when Type.LABEL then
                _out.append("label")
            when Type.METADATA then
                _out.append("metadata")
            when array: Type.ARRAY then
                _out.append("[{array.count} x ")
                write(array.element)
                _out.append(']')
            when vector: Type.VECTOR then
                _out.append("<{vector.count} x ")
                write(vector.element)
                _out.append('>')
            when structure: Type.STRUCT then
                if structure.packed then
                    _out.append('<')
                fi

                if structure.fields.count == 0 then
                    _out.append("{{}}")
                else
                    _out.append("{{ ")

                    let first mut = true

                    for member in structure.fields do
                        if !first then
                            _out.append(", ")
                        fi

                        first = false

                        write(member)
                    od

                    _out.append(" }}")
                fi

                if structure.packed then
                    _out.append('>')
                fi
            when named: Type.NAMED then
                _out.append(Names.local(named.name))
            when function: Type.FUNCTION then
                write(function.result)
                _out.append(" (")

                let first mut = true

                for parameter in function.parameters do
                    if !first then
                        _out.append(", ")
                    fi

                    first = false

                    write(parameter)
                od

                if function.variadic then
                    _out.append(if first then "..." else ", ..." fi)
                fi

                _out.append(')')
            esac
        si

        /// Writes a value with its type in front.
        write_operand(value: Value) is
            write(value.type)
            _out.append(' ')
            write(value)
        si

        /// Writes a value without its type.
        write(value: Value) is
            case value
            when local: Value.LOCAL then
                _out.append(Names.local(local.name))
            when global: Value.GLOBAL then
                _out.append(Names.global(global.name))
            when integer: Value.INTEGER then
                _integer(integer.value, integer.type)
            when floating: Value.FLOATING then
                _floating(floating.bits, floating.type)
            when _: Value.NULL then
                _out.append("null")
            when _: Value.ZERO then
                _out.append("zeroinitializer")
            when _: Value.UNDEF then
                _out.append("undef")
            when _: Value.POISON then
                _out.append("poison")
            when aggregate: Value.AGGREGATE then
                _aggregate(aggregate.elements, aggregate.type)
            when bytes: Value.STRING then
                _out.append('c')
                _out.append(Names.quoted(bytes.bytes))
            esac
        si

        _integer(value: bigint, type: Type) is
            let width =
                if let integer: Type.INTEGER = type then
                    integer.width
                else
                    throw Ghul.InvalidOperationException("an integer constant needs an integer type")
                fi

            if width == 1 then
                _out.append(if value.is_zero then "false" else "true" fi)
                return
            fi

            let modulus = bigint.one << width
            let reduced mut = value % modulus

            if reduced < bigint.zero then
                reduced = reduced + modulus
            fi

            if reduced >= modulus >> 1 then
                reduced = reduced - modulus
            fi

            @IF.dotnet()
            _out.append(reduced.to_string(System.Globalization.CultureInfo.invariant_culture))

            @IF.not.dotnet()
            _out.append(reduced.to_string())
        si

        // LLVM writes a `float` constant in hexadecimal as the `double` of
        // the same value, and a NaN keeps its payload in the upper bits of
        // the double's mantissa. The conversion is done on the bits rather
        // than by the hardware, which would quiet a signalling NaN.
        _floating(bits: ulong, type: Type) is
            case type
            when Type.HALF then
                _out.append("0xH")
                _out.append((bits & 0xFFFFul).to_string("X4"))
            when Type.FLOAT then
                _out.append("0x")
                _out.append(_single_as_double(cast uint(bits & 0xFFFF_FFFFul)).to_string("X16"))
            when Type.DOUBLE then
                _out.append("0x")
                _out.append(bits.to_string("X16"))
            else
                throw Ghul.InvalidOperationException("a floating point constant needs half, float or double")
            esac
        si

        _single_as_double(bits: uint) -> ulong static is
            let sign = cast ulong(bits >> 31) << 63
            let exponent = cast int((bits >> 23) & 0xFFu)
            let mantissa mut = cast ulong(bits & 0x7F_FFFFu)

            if exponent == 0xFF then
                return sign | (0x7FFul << 52) | (mantissa << 29)
            fi

            if exponent == 0 then
                if mantissa == 0ul then
                    return sign
                fi

                let scale mut = -126

                while mantissa & 0x80_0000ul == 0ul do
                    mantissa = mantissa << 1
                    scale = scale - 1
                od

                mantissa = mantissa & 0x7F_FFFFul

                return sign | (cast ulong(scale + 1023) << 52) | (mantissa << 29)
            fi

            return sign | (cast ulong(exponent - 127 + 1023) << 52) | (mantissa << 29)
        si

        _aggregate(elements: ARRAY[Value], type: Type) is
            let (open, close) =
                case _shape(type)
                when _: Type.ARRAY then ("[", "]")
                when _: Type.VECTOR then ("<", ">")
                when s: Type.STRUCT /\ s.packed then ("<{{", "}}>")
                else ("{{", "}}")
                esac

            if elements.count == 0 then
                _out.append(open)
                _out.append(close)
                return
            fi

            let is_struct = isa Type.STRUCT(_shape(type))

            _out.append(open)

            if is_struct then
                _out.append(' ')
            fi

            let first mut = true

            for element in elements do
                if !first then
                    _out.append(", ")
                fi

                first = false

                write_operand(element)
            od

            if is_struct then
                _out.append(' ')
            fi

            _out.append(close)
        si

        // The type an aggregate constant is written for, with a named
        // struct replaced by its body where the module defining it is known.
        // A named struct with no module to look it up in is taken to be
        // unpacked.
        _shape(type: Type) -> Type is
            if let named: Type.NAMED = type then
                if let body = _module?.type_named(named.name)?.body then
                    return body
                fi

                return Type.STRUCT([], false)
            fi

            return type
        si

        /// Writes a metadata operand.
        write(metadata: Metadata) is
            case metadata
            when text: Metadata.STRING then
                _out.append('!')
                _out.append(Names.quoted(text.text))
            when value: Metadata.VALUE then
                write_operand(value.value)
            when node: Metadata.NODE then
                _out.append("!{node.index}")
            when Metadata.NULL then
                _out.append("null")
            esac
        si

        /// Writes a metadata node's content, as it follows `!N = `.
        write(node: MetadataNode) is
            case node
            when tuple: MetadataNode.TUPLE then
                _out.append("!{{")

                let first mut = true

                for element in tuple.elements do
                    if !first then
                        _out.append(", ")
                    fi

                    first = false

                    write(element)
                od

                _out.append('}')
            when file: MetadataNode.FILE then
                _out.append("!DIFile(")
                _string_field("filename", file.filename)
                _out.append(", ")
                _string_field("directory", file.directory)
                _out.append(')')
            when unit: MetadataNode.COMPILE_UNIT then
                _out.append("!DICompileUnit(language: {unit.language}, ")
                _field("file", unit.file)
                _out.append(", ")
                _string_field("producer", unit.producer)
                _out.append(", isOptimized: {if unit.is_optimized then "true" else "false" fi}, emissionKind: ")
                _out.append(
                    case unit.emission
                    when DebugEmission.NO_DEBUG then "NoDebug"
                    when DebugEmission.FULL_DEBUG then "FullDebug"
                    when DebugEmission.LINE_TABLES_ONLY then "LineTablesOnly"
                    esac)
                _out.append(')')
            when type: MetadataNode.SUBROUTINE_TYPE then
                _out.append("!DISubroutineType(")
                _field("types", type.types)
                _out.append(')')
            when subprogram: MetadataNode.SUBPROGRAM then
                _out.append("!DISubprogram(")
                _string_field("name", subprogram.name)

                if let linkage_name = subprogram.linkage_name then
                    _out.append(", ")
                    _string_field("linkageName", linkage_name)
                fi

                _out.append(", ")
                _field("scope", subprogram.scope)
                _out.append(", ")
                _field("file", subprogram.file)
                _out.append(", line: {subprogram.line}, ")
                _field("type", subprogram.type)
                _out.append(", scopeLine: {subprogram.scope_line}")

                // LLVM takes a subprogram with no flags for a definition,
                // so a declaration says so with an explicit zero.
                _out.append(if subprogram.is_definition then ", spFlags: DISPFlagDefinition" else ", spFlags: 0" fi)

                if let unit = subprogram.unit then
                    _out.append(", ")
                    _field("unit", unit)
                fi

                _out.append(')')
            when location: MetadataNode.LOCATION then
                _out.append("!DILocation(line: {location.line}, column: {location.column}, ")
                _field("scope", location.scope)

                if let inlined_at = location.inlined_at then
                    _out.append(", ")
                    _field("inlinedAt", inlined_at)
                fi

                _out.append(')')
            when basic: MetadataNode.BASIC_TYPE then
                _out.append("!DIBasicType(")
                _string_field("name", basic.name)
                _out.append(", size: {basic.size}, encoding: {basic.encoding})")
            when pointer: MetadataNode.POINTER_TYPE then
                _out.append("!DIDerivedType(tag: DW_TAG_pointer_type, ")
                _field("baseType", pointer.base)
                _out.append(", size: {pointer.size})")
            when variable: MetadataNode.LOCAL_VARIABLE then
                _out.append("!DILocalVariable(")
                _string_field("name", variable.name)

                if variable.argument > 0 then
                    _out.append(", arg: {variable.argument}")
                fi

                _out.append(", ")
                _field("scope", variable.scope)
                _out.append(", ")
                _field("file", variable.file)
                _out.append(", line: {variable.line}, ")
                _field("type", variable.type)
                _out.append(')')
            when structure: MetadataNode.STRUCTURE_TYPE then
                _out.append("!DICompositeType(tag: DW_TAG_structure_type, ")
                _string_field("name", structure.name)
                _out.append(", ")
                _field("file", structure.file)
                _out.append(", line: {structure.line}, size: {structure.size}, ")
                _field("elements", structure.elements)
                _out.append(')')
            when member: MetadataNode.MEMBER then
                _out.append("!DIDerivedType(tag: DW_TAG_member, ")
                _string_field("name", member.name)
                _out.append(", ")
                _field("file", member.file)
                _out.append(", line: {member.line}, ")
                _field("baseType", member.base)
                _out.append(", size: {member.size}, offset: {member.offset})")
            esac
        si

        _field(name: string, value: Metadata) is
            _out.append(name)
            _out.append(": ")
            write(value)
        si

        _string_field(name: string, value: string) is
            _out.append(name)
            _out.append(": ")
            _out.append(Names.quoted(value))
        si

        /// Writes an attribute.
        write(attribute: Attribute) is
            case attribute
            when flag: Attribute.FLAG then
                _out.append(flag.name)
            when integer: Attribute.INTEGER then
                _out.append("{integer.name}({integer.value})")
            when align: Attribute.ALIGN then
                _out.append("align {align.bytes}")
            when typed: Attribute.TYPED then
                _out.append(typed.name)
                _out.append('(')
                write(typed.type)
                _out.append(')')
            when keyed: Attribute.STRING then
                _out.append(Names.quoted(keyed.key))

                if let value = keyed.value then
                    _out.append('=')
                    _out.append(Names.quoted(value))
                fi
            esac
        si

        _attributes(attributes: Collections.Iterable[Attribute]) is
            for attribute in attributes do
                _out.append(' ')
                write(attribute)
            od
        si

        _linkage(linkage: Linkage) is
            let keyword =
                case linkage
                when Linkage.EXTERNAL then ""
                when Linkage.PRIVATE then "private"
                when Linkage.INTERNAL then "internal"
                when Linkage.AVAILABLE_EXTERNALLY then "available_externally"
                when Linkage.LINKONCE then "linkonce"
                when Linkage.LINKONCE_ODR then "linkonce_odr"
                when Linkage.WEAK then "weak"
                when Linkage.WEAK_ODR then "weak_odr"
                when Linkage.COMMON then "common"
                when Linkage.APPENDING then "appending"
                when Linkage.EXTERN_WEAK then "extern_weak"
                esac

            if keyword.length > 0 then
                _out.append(' ')
                _out.append(keyword)
            fi
        si

        _unnamed_address(unnamed_address: UnnamedAddress) is
            case unnamed_address
            when UnnamedAddress.NONE then
                return
            when UnnamedAddress.LOCAL then
                _out.append(" local_unnamed_addr")
            when UnnamedAddress.GLOBAL then
                _out.append(" unnamed_addr")
            esac
        si

        _calling_convention(calling_convention: CallingConvention) is
            case calling_convention
            when CallingConvention.C then
                return
            when CallingConvention.FAST then
                _out.append(" fastcc")
            when CallingConvention.COLD then
                _out.append(" coldcc")
            when CallingConvention.TAIL then
                _out.append(" tailcc")
            esac
        si

        _alignment(alignment: int) is
            if alignment > 0 then
                _out.append(", align {alignment}")
            fi
        si

        _result(name: string) is
            _out.append(Names.local(name))
            _out.append(" = ")
        si

        _label(name: string) is
            _out.append("label ")
            _out.append(Names.local(name))
        si

        /// Writes an instruction, without its indentation. Throws if it
        /// carries flags its operation does not allow.
        write(instruction: INSTRUCTION) is
            case instruction.operation
            when alloca: Operation.ALLOCA then
                _result(alloca.result)
                _out.append("alloca ")
                write(alloca.type)

                if let count = alloca.count then
                    _out.append(", ")
                    write_operand(count)
                fi

                _alignment(alloca.alignment)
            when load: Operation.LOAD then
                _result(load.result)
                _out.append(if load.is_volatile then "load volatile " else "load " fi)
                write(load.type)
                _out.append(", ")
                write_operand(load.pointer)
                _alignment(load.alignment)
            when store: Operation.STORE then
                _out.append(if store.is_volatile then "store volatile " else "store " fi)
                write_operand(store.value)
                _out.append(", ")
                write_operand(store.pointer)
                _alignment(store.alignment)
            when gep: Operation.GET_ELEMENT_POINTER then
                _result(gep.result)
                _out.append(if gep.in_bounds then "getelementptr inbounds " else "getelementptr " fi)
                write(gep.source)
                _out.append(", ")
                write_operand(gep.pointer)

                for index in gep.indices do
                    _out.append(", ")
                    write_operand(index)
                od
            when binary: Operation.BINARY then
                _result(binary.result)
                _out.append(_binary_mnemonic(binary.operator))

                if _is_floating(binary.operator) then
                    _no_integer_flags(binary.flags, _binary_mnemonic(binary.operator))
                    _fast_math(binary.fast_math)
                else
                    _no_fast_math(binary.fast_math, _binary_mnemonic(binary.operator))
                    _integer_flags(binary.flags, _allowed_flags(binary.operator), _binary_mnemonic(binary.operator))
                fi

                _out.append(' ')
                write_operand(binary.left)
                _out.append(", ")
                write(binary.right)
            when negate: Operation.NEGATE then
                _result(negate.result)
                _out.append("fneg")
                _fast_math(negate.fast_math)
                _out.append(' ')
                write_operand(negate.operand)
            when compare: Operation.INTEGER_COMPARE then
                _result(compare.result)
                _out.append("icmp ")
                _out.append(_predicate(compare.predicate))
                _out.append(' ')
                write_operand(compare.left)
                _out.append(", ")
                write(compare.right)
            when compare: Operation.FLOAT_COMPARE then
                _result(compare.result)
                _out.append("fcmp")
                _fast_math(compare.fast_math)
                _out.append(' ')
                _out.append(_predicate(compare.predicate))
                _out.append(' ')
                write_operand(compare.left)
                _out.append(", ")
                write(compare.right)
            when convert: Operation.CONVERT then
                _result(convert.result)
                _out.append(_conversion_mnemonic(convert.operator))
                _integer_flags(convert.flags, _allowed_flags(convert.operator), _conversion_mnemonic(convert.operator))
                _out.append(' ')
                write_operand(convert.value)
                _out.append(" to ")
                write(convert.to)
            when select: Operation.SELECT then
                _result(select.result)
                _out.append("select ")
                write_operand(select.condition)
                _out.append(", ")
                write_operand(select.if_true)
                _out.append(", ")
                write_operand(select.if_false)
            when call: Operation.CALL then
                if let result = call.result then
                    _result(result)
                fi

                _out.append(
                    case call.tail
                    when TailCall.NONE then ""
                    when TailCall.TAIL then "tail "
                    when TailCall.MUST_TAIL then "musttail "
                    when TailCall.NO_TAIL then "notail "
                    esac)

                _out.append("call")
                _call(
                    call.calling_convention,
                    call.function_type,
                    call.callee,
                    call.arguments,
                    call.result_attributes,
                    call.attributes)
            when extract: Operation.EXTRACT_VALUE then
                _result(extract.result)
                _out.append("extractvalue ")
                write_operand(extract.aggregate)
                _indices(extract.indices)
            when insert: Operation.INSERT_VALUE then
                _result(insert.result)
                _out.append("insertvalue ")
                write_operand(insert.aggregate)
                _out.append(", ")
                write_operand(insert.element)
                _indices(insert.indices)
            when ret: Operation.RETURN then
                if let value = ret.value then
                    _out.append("ret ")
                    write_operand(value)
                else
                    _out.append("ret void")
                fi
            when branch: Operation.BRANCH then
                _out.append("br ")
                _label(branch.target)
            when branch: Operation.CONDITIONAL_BRANCH then
                _out.append("br ")
                write_operand(branch.condition)
                _out.append(", ")
                _label(branch.if_true)
                _out.append(", ")
                _label(branch.if_false)
            when switch: Operation.SWITCH then
                _out.append("switch ")
                write_operand(switch.value)
                _out.append(", ")
                _label(switch.otherwise)
                _out.append(" [")

                for case_ in switch.cases do
                    _out.append("\n    ")
                    write_operand(case_.value)
                    _out.append(", ")
                    _label(case_.target)
                od

                _out.append(if switch.cases.count > 0 then "\n  ]" else "]" fi)
            when Operation.UNREACHABLE then
                _out.append("unreachable")
            when invoke: Operation.INVOKE then
                if let result = invoke.result then
                    _result(result)
                fi

                _out.append("invoke")
                _call(
                    invoke.calling_convention,
                    invoke.function_type,
                    invoke.callee,
                    invoke.arguments,
                    invoke.result_attributes,
                    invoke.attributes)
                _out.append(" to ")
                _label(invoke.normal)
                _out.append(" unwind ")
                _label(invoke.unwind)
            when pad: Operation.LANDING_PAD then
                _result(pad.result)
                _out.append("landingpad ")
                write(pad.type)

                if pad.is_cleanup then
                    _out.append(" cleanup")
                fi

                for caught in pad.catches do
                    _out.append(" catch ")
                    write_operand(caught)
                od
            when resume: Operation.RESUME then
                _out.append("resume ")
                write_operand(resume.value)
            when declare: Operation.DEBUG_DECLARE then
                _out.append("#dbg_declare(")
                write_operand(declare.address)
                _out.append(", ")
                write(declare.variable)
                _out.append(", !DIExpression(), ")
                write(declare.location)
                _out.append(')')
            esac

            for attachment in instruction.attachments do
                _out.append(", ")
                _out.append(Names.metadata(attachment.kind))
                _out.append(' ')
                write(attachment.node)
            od
        si

        // A call or an invoke from the calling convention to the closing
        // parenthesis and the attributes after it. The callee's whole type
        // is written only when it is variadic, which is the one case LLVM
        // needs it; otherwise the result type alone.
        _call(
            calling_convention: CallingConvention,
            function_type: Type,
            callee: Value,
            arguments: ARRAY[Argument],
            result_attributes: ARRAY[Attribute],
            attributes: ARRAY[Attribute]
        ) is
            _calling_convention(calling_convention)
            _attributes(result_attributes)
            _out.append(' ')

            if let function: Type.FUNCTION = function_type then
                if function.variadic then
                    write(function_type)
                else
                    write(function.result)
                fi
            else
                throw Ghul.InvalidOperationException("a call needs a function type")
            fi

            _out.append(' ')
            write(callee)
            _out.append('(')

            let first mut = true

            for argument in arguments do
                if !first then
                    _out.append(", ")
                fi

                first = false

                write(argument.value.type)
                _attributes(argument.attributes)
                _out.append(' ')
                write(argument.value)
            od

            _out.append(')')
            _attributes(attributes)
        si

        _indices(indices: ARRAY[int]) is
            for index in indices do
                _out.append(", {index}")
            od
        si

        _is_floating(operator: BinaryOperator) -> bool =>
            case operator
            when BinaryOperator.FADD, BinaryOperator.FSUB, BinaryOperator.FMUL, BinaryOperator.FDIV, BinaryOperator.FREM then true
            else false
            esac

        _binary_mnemonic(operator: BinaryOperator) -> string =>
            case operator
            when BinaryOperator.ADD then "add"
            when BinaryOperator.SUB then "sub"
            when BinaryOperator.MUL then "mul"
            when BinaryOperator.UDIV then "udiv"
            when BinaryOperator.SDIV then "sdiv"
            when BinaryOperator.UREM then "urem"
            when BinaryOperator.SREM then "srem"
            when BinaryOperator.SHL then "shl"
            when BinaryOperator.LSHR then "lshr"
            when BinaryOperator.ASHR then "ashr"
            when BinaryOperator.AND then "and"
            when BinaryOperator.OR then "or"
            when BinaryOperator.XOR then "xor"
            when BinaryOperator.FADD then "fadd"
            when BinaryOperator.FSUB then "fsub"
            when BinaryOperator.FMUL then "fmul"
            when BinaryOperator.FDIV then "fdiv"
            when BinaryOperator.FREM then "frem"
            esac

        _allowed_flags(operator: BinaryOperator) -> IntegerFlags =>
            case operator
            when BinaryOperator.ADD, BinaryOperator.SUB, BinaryOperator.MUL, BinaryOperator.SHL then
                IntegerFlags.NO_UNSIGNED_WRAP | IntegerFlags.NO_SIGNED_WRAP
            when BinaryOperator.UDIV, BinaryOperator.SDIV, BinaryOperator.LSHR, BinaryOperator.ASHR then
                IntegerFlags.EXACT
            when BinaryOperator.OR then
                IntegerFlags.DISJOINT
            else
                IntegerFlags.NONE
            esac

        _conversion_mnemonic(operator: Conversion) -> string =>
            case operator
            when Conversion.TRUNCATE then "trunc"
            when Conversion.ZERO_EXTEND then "zext"
            when Conversion.SIGN_EXTEND then "sext"
            when Conversion.FLOAT_TRUNCATE then "fptrunc"
            when Conversion.FLOAT_EXTEND then "fpext"
            when Conversion.FLOAT_TO_UNSIGNED then "fptoui"
            when Conversion.FLOAT_TO_SIGNED then "fptosi"
            when Conversion.UNSIGNED_TO_FLOAT then "uitofp"
            when Conversion.SIGNED_TO_FLOAT then "sitofp"
            when Conversion.POINTER_TO_INTEGER then "ptrtoint"
            when Conversion.INTEGER_TO_POINTER then "inttoptr"
            when Conversion.BIT_CAST then "bitcast"
            when Conversion.ADDRESS_SPACE_CAST then "addrspacecast"
            esac

        _allowed_flags(operator: Conversion) -> IntegerFlags =>
            case operator
            when Conversion.TRUNCATE then
                IntegerFlags.NO_UNSIGNED_WRAP | IntegerFlags.NO_SIGNED_WRAP
            when Conversion.ZERO_EXTEND, Conversion.UNSIGNED_TO_FLOAT then
                IntegerFlags.NON_NEGATIVE
            else
                IntegerFlags.NONE
            esac

        _integer_flags(flags: IntegerFlags, allowed: IntegerFlags, mnemonic: string) is
            if flags & allowed != flags then
                throw Ghul.InvalidOperationException("{mnemonic} does not take the flags {flags}")
            fi

            if flags & IntegerFlags.NO_UNSIGNED_WRAP != IntegerFlags.NONE then
                _out.append(" nuw")
            fi

            if flags & IntegerFlags.NO_SIGNED_WRAP != IntegerFlags.NONE then
                _out.append(" nsw")
            fi

            if flags & IntegerFlags.EXACT != IntegerFlags.NONE then
                _out.append(" exact")
            fi

            if flags & IntegerFlags.DISJOINT != IntegerFlags.NONE then
                _out.append(" disjoint")
            fi

            if flags & IntegerFlags.NON_NEGATIVE != IntegerFlags.NONE then
                _out.append(" nneg")
            fi
        si

        _no_integer_flags(flags: IntegerFlags, mnemonic: string) =>
            _integer_flags(flags, IntegerFlags.NONE, mnemonic)

        _no_fast_math(fast_math: FastMath, mnemonic: string) is
            if fast_math != FastMath.NONE then
                throw Ghul.InvalidOperationException("{mnemonic} does not take fast-math flags")
            fi
        si

        _fast_math(fast_math: FastMath) is
            if fast_math == FastMath.FAST then
                _out.append(" fast")
                return
            fi

            if fast_math & FastMath.REASSOCIATE != FastMath.NONE then
                _out.append(" reassoc")
            fi

            if fast_math & FastMath.NO_NANS != FastMath.NONE then
                _out.append(" nnan")
            fi

            if fast_math & FastMath.NO_INFINITIES != FastMath.NONE then
                _out.append(" ninf")
            fi

            if fast_math & FastMath.NO_SIGNED_ZEROS != FastMath.NONE then
                _out.append(" nsz")
            fi

            if fast_math & FastMath.ALLOW_RECIPROCAL != FastMath.NONE then
                _out.append(" arcp")
            fi

            if fast_math & FastMath.CONTRACT != FastMath.NONE then
                _out.append(" contract")
            fi

            if fast_math & FastMath.APPROXIMATE_FUNCTIONS != FastMath.NONE then
                _out.append(" afn")
            fi
        si

        _predicate(predicate: IntegerPredicate) -> string =>
            case predicate
            when IntegerPredicate.EQ then "eq"
            when IntegerPredicate.NE then "ne"
            when IntegerPredicate.UGT then "ugt"
            when IntegerPredicate.UGE then "uge"
            when IntegerPredicate.ULT then "ult"
            when IntegerPredicate.ULE then "ule"
            when IntegerPredicate.SGT then "sgt"
            when IntegerPredicate.SGE then "sge"
            when IntegerPredicate.SLT then "slt"
            when IntegerPredicate.SLE then "sle"
            esac

        _predicate(predicate: FloatPredicate) -> string =>
            case predicate
            when FloatPredicate.FALSE then "false"
            when FloatPredicate.OEQ then "oeq"
            when FloatPredicate.OGT then "ogt"
            when FloatPredicate.OGE then "oge"
            when FloatPredicate.OLT then "olt"
            when FloatPredicate.OLE then "ole"
            when FloatPredicate.ONE then "one"
            when FloatPredicate.ORD then "ord"
            when FloatPredicate.UEQ then "ueq"
            when FloatPredicate.UGT then "ugt"
            when FloatPredicate.UGE then "uge"
            when FloatPredicate.ULT then "ult"
            when FloatPredicate.ULE then "ule"
            when FloatPredicate.UNE then "une"
            when FloatPredicate.UNO then "uno"
            when FloatPredicate.TRUE then "true"
            esac
    si
si
