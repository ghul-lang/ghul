namespace LLVM is
    /// An argument to a call or an invoke: the value passed, and any
    /// attributes on that parameter at this call.
    use Argument = (value: Value, attributes: ARRAY[Attribute])

    /// One case of a switch: the constant compared against, and the block
    /// branched to when it matches.
    use SwitchCase = (value: Value, target: string)

    /// What an instruction does. An operation that produces a value names
    /// it with `result`; the blocks a terminator branches to are named by
    /// their labels.
    union Operation is
        /// Reserves stack space for `count` values of `type`, or for one
        /// when `count` is absent, and produces a pointer to it.
        ALLOCA(result: string, type: Type, count: Value?, alignment: int)

        /// Reads a value of `type` through `pointer`.
        LOAD(result: string, type: Type, pointer: Value, alignment: int, is_volatile: bool)

        /// Writes `value` through `pointer`.
        STORE(value: Value, pointer: Value, alignment: int, is_volatile: bool)

        /// Computes the address of an element within `source`, starting
        /// at `pointer`.
        GET_ELEMENT_POINTER(result: string, source: Type, pointer: Value, indices: ARRAY[Value], in_bounds: bool)

        /// An integer or floating point operator over two values of the
        /// same type.
        BINARY(result: string, operator: BinaryOperator, flags: IntegerFlags, fast_math: FastMath, left: Value, right: Value)

        /// Floating point negation, written `fneg`.
        NEGATE(result: string, fast_math: FastMath, operand: Value)

        /// Compares two integers or pointers, producing an `i1`.
        INTEGER_COMPARE(result: string, predicate: IntegerPredicate, left: Value, right: Value)

        /// Compares two floating point values, producing an `i1`.
        FLOAT_COMPARE(result: string, predicate: FloatPredicate, fast_math: FastMath, left: Value, right: Value)

        /// Converts `value` to the type `to`.
        CONVERT(result: string, operator: Conversion, flags: IntegerFlags, value: Value, to: Type)

        /// Chooses `if_true` or `if_false` by an `i1`.
        SELECT(result: string, condition: Value, if_true: Value, if_false: Value)

        /// Calls `callee`, whose type is `function_type`. A call to a
        /// function returning `void` has no result.
        CALL(
            result: string?,
            tail: TailCall,
            calling_convention: CallingConvention,
            function_type: Type,
            callee: Value,
            arguments: ARRAY[Argument],
            result_attributes: ARRAY[Attribute],
            attributes: ARRAY[Attribute])

        /// Reads one member out of a struct or array value.
        EXTRACT_VALUE(result: string, aggregate: Value, indices: ARRAY[int])

        /// Produces a copy of a struct or array value with one member
        /// replaced.
        INSERT_VALUE(result: string, aggregate: Value, element: Value, indices: ARRAY[int])

        /// Returns from the function, with a value unless it returns
        /// `void`.
        RETURN(value: Value?)

        /// Branches to a block unconditionally.
        BRANCH(target: string)

        /// Branches to one of two blocks by an `i1`.
        CONDITIONAL_BRANCH(condition: Value, if_true: string, if_false: string)

        /// Branches to the block whose case matches `value`, or to
        /// `otherwise` when none does.
        SWITCH(value: Value, otherwise: string, cases: ARRAY[SwitchCase])

        /// Marks a point control never reaches.
        UNREACHABLE

        /// Calls `callee` and continues at `normal`, or at `unwind` if the
        /// callee throws.
        INVOKE(
            result: string?,
            calling_convention: CallingConvention,
            function_type: Type,
            callee: Value,
            arguments: ARRAY[Argument],
            result_attributes: ARRAY[Attribute],
            attributes: ARRAY[Attribute],
            normal: string,
            unwind: string)

        /// The first instruction of a block an invoke unwinds to. Produces
        /// the exception value, of `type`, when the block is entered for a
        /// cleanup or for one of the types in `catches`.
        LANDING_PAD(result: string, type: Type, is_cleanup: bool, catches: ARRAY[Value])

        /// Continues unwinding with an exception value a landing pad
        /// produced.
        RESUME(value: Value)

        /// Records that the source variable `variable` lives at `address`,
        /// for a debugger, written as a `#dbg_declare` record. It carries its
        /// own location, and must be followed by an instruction.
        DEBUG_DECLARE(address: Value, variable: Metadata, location: Metadata)
    si

    /// The two-operand operators, integer and floating point.
    enum BinaryOperator is
        ADD,
        SUB,
        MUL,
        UDIV,
        SDIV,
        UREM,
        SREM,
        SHL,
        LSHR,
        ASHR,
        AND,
        OR,
        XOR,
        FADD,
        FSUB,
        FMUL,
        FDIV,
        FREM
    si

    /// Flags promising something about an integer operation's operands
    /// or result. Which are allowed depends on the operation.
    @System.Flags()
    enum IntegerFlags is
        NONE = 0,

        /// `nuw`, on `add`, `sub`, `mul`, `shl` and `trunc`.
        NO_UNSIGNED_WRAP = 1,

        /// `nsw`, on `add`, `sub`, `mul`, `shl` and `trunc`.
        NO_SIGNED_WRAP = 2,

        /// `exact`, on `udiv`, `sdiv`, `lshr` and `ashr`.
        EXACT = 4,

        /// `disjoint`, on `or`.
        DISJOINT = 8,

        /// `nneg`, on `zext` and `uitofp`.
        NON_NEGATIVE = 16
    si

    /// Fast-math flags, relaxing what a floating point operation must
    /// preserve.
    @System.Flags()
    enum FastMath is
        NONE = 0,
        NO_NANS = 1,
        NO_INFINITIES = 2,
        NO_SIGNED_ZEROS = 4,
        ALLOW_RECIPROCAL = 8,
        CONTRACT = 16,
        APPROXIMATE_FUNCTIONS = 32,
        REASSOCIATE = 64,

        /// Every flag, written `fast`.
        FAST = 127
    si

    /// The predicates of `icmp`.
    enum IntegerPredicate is
        EQ,
        NE,
        UGT,
        UGE,
        ULT,
        ULE,
        SGT,
        SGE,
        SLT,
        SLE
    si

    /// The predicates of `fcmp`. `O` predicates are false when either
    /// operand is a NaN, `U` predicates true.
    enum FloatPredicate is
        FALSE,
        OEQ,
        OGT,
        OGE,
        OLT,
        OLE,
        ONE,
        ORD,
        UEQ,
        UGT,
        UGE,
        ULT,
        ULE,
        UNE,
        UNO,
        TRUE
    si

    /// The conversion operators.
    enum Conversion is
        TRUNCATE,
        ZERO_EXTEND,
        SIGN_EXTEND,
        FLOAT_TRUNCATE,
        FLOAT_EXTEND,
        FLOAT_TO_UNSIGNED,
        FLOAT_TO_SIGNED,
        UNSIGNED_TO_FLOAT,
        SIGNED_TO_FLOAT,
        POINTER_TO_INTEGER,
        INTEGER_TO_POINTER,
        BIT_CAST,
        ADDRESS_SPACE_CAST
    si

    /// Whether a call is, may be, or must be a tail call.
    enum TailCall is
        NONE,
        TAIL,
        MUST_TAIL,
        NO_TAIL
    si
si
