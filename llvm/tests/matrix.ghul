namespace LLVM.Tests is
    use Collections.LIST
    use Ghul.Pipes

    use LLVM.MODULE
    use LLVM.FUNCTION
    use LLVM.PARAMETER
    use LLVM.GLOBAL_VARIABLE
    use LLVM.Type
    use LLVM.Types
    use LLVM.Value
    use LLVM.Values
    use LLVM.Attribute
    use LLVM.Linkage
    use LLVM.UnnamedAddress
    use LLVM.CallingConvention
    use LLVM.BinaryOperator
    use LLVM.IntegerFlags
    use LLVM.FastMath
    use LLVM.IntegerPredicate
    use LLVM.FloatPredicate
    use LLVM.Conversion
    use LLVM.TailCall
    use LLVM.Operation
    use LLVM.Intrinsics
    use LLVM.Overflow
    use LLVM.Metadata
    use LLVM.MetadataNode
    use LLVM.DebugEmission
    use LLVM.ModuleFlagBehavior

    // The whole modules the suite checks against LLVM itself, one named
    // method each.
    //
    // The per-class tests pin exact text. The matrix exists for the other
    // claim, that the text the writer produces is text LLVM accepts: every
    // module here is written out by llvm-check.sh and handed to llvm-as,
    // to opt's verifier and to llc. It holds every shape the library can
    // produce, so that adding one means adding a method here.
    class MODULE_MATRIX is
        // The modules of the matrix, by the name the tests and the
        // README know them by.
        names() -> LIST[string] static =>
            LIST[string]([
                "empty",
                "header",
                "types",
                "constants",
                "globals",
                "declarations",
                "attributes",
                "names",
                "memory",
                "integer-arithmetic",
                "float-arithmetic",
                "comparisons",
                "conversions",
                "aggregates",
                "calls",
                "control",
                "exceptions",
                "intrinsics",
                "metadata",
                "debug-info"
            ])

        by_name(name: string) -> MODULE static =>
            case name
            when "empty" then MODULE()
            when "header" then header()
            when "types" then types()
            when "constants" then constants()
            when "globals" then globals()
            when "declarations" then declarations()
            when "attributes" then attributes()
            when "names" then names_module()
            when "memory" then memory()
            when "integer-arithmetic" then integer_arithmetic()
            when "float-arithmetic" then float_arithmetic()
            when "comparisons" then comparisons()
            when "conversions" then conversions()
            when "aggregates" then aggregates()
            when "calls" then calls()
            when "control" then control()
            when "exceptions" then exceptions()
            when "intrinsics" then intrinsics()
            when "metadata" then metadata()
            when "debug-info" then debug_info()
            else throw Ghul.ArgumentException("no module named {name} in the matrix")
            esac

        // --- helpers the module bodies read better with ---

        _function(module: MODULE, name: string, result: Type, parameters: ARRAY[PARAMETER]) -> FUNCTION static =>
            module.add_function(FUNCTION(name, result, parameters))

        _parameter(type: Type, name: string) -> PARAMETER static => PARAMETER(type, name)

        // --- the modules ---

        header() -> MODULE static is
            let module = MODULE()

            module.source_filename = "header.ghul"
            module.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
            module.target_triple = "x86_64-unknown-linux-musl"

            return module
        si

        types() -> MODULE static is
            let module = MODULE()

            let node = module.add_type("node", null)

            node.body = Types.structure([Types.i32, Types.pointer])

            module.add_type("opaque", null)
            module.add_type("packed", Type.STRUCT([Types.i8, Types.i32], true))
            module.add_type("empty", Types.structure([]))
            module.add_type(
                "everything",
                Types.structure([
                    Type.INTEGER(1),
                    Type.INTEGER(17),
                    Type.INTEGER(128),
                    Type.HALF,
                    Type.FLOAT,
                    Type.DOUBLE,
                    Type.POINTER(0),
                    Type.POINTER(1),
                    Type.ARRAY(4, Types.i32),
                    Type.ARRAY(0, Types.i8),
                    Type.VECTOR(4, Type.FLOAT),
                    Types.structure([Types.i64, Type.ARRAY(2, Types.pointer)]),
                    node.type
                ]))

            module.add_global(GLOBAL_VARIABLE("uses", Type.NAMED("everything"), Values.zero(Type.NAMED("everything")), false))
            module.add_global(GLOBAL_VARIABLE("uses_packed", Type.NAMED("packed"), Values.zero(Type.NAMED("packed")), false))

            return module
        si

        constants() -> MODULE static is
            let module = MODULE()

            let add = (name: string, value: Value) =>
                module.add_global(GLOBAL_VARIABLE(name, value.type, value, true))

            add("true", Values.boolean(true))
            add("false", Values.boolean(false))
            add("byte_max", Values.integer(Types.i8, bigint(255)))
            add("byte_min", Values.integer(Types.i8, bigint(-128)))
            add("int_min", Values.i32(int.min_value))
            add("long_max", Values.i64(9223372036854775807L))
            add("wide", Values.integer(Type.INTEGER(128), bigint.parse("170141183460469231731687303715884105727")))
            add("odd", Values.integer(Type.INTEGER(17), bigint(65535)))
            add("double_one", Values.of_double(1.0))
            add("double_tenth", Values.of_double(0.1))
            add("double_negative_zero", Values.of_double(-0.0))
            add("double_infinity", Values.of_double(double.positive_infinity))
            add("double_nan", Values.of_double(double.na_n))
            add("float_tenth", Values.of_single(0.1s))
            add("float_smallest", Values.of_single(single.epsilon))
            add("float_infinity", Values.of_single(single.negative_infinity))
            add("float_signalling", Value.FLOATING(0x7F80_0001ul, Type.FLOAT))
            add("half_one", Values.of_half(0x3C00us))
            add("half_infinity", Values.of_half(0x7C00us))
            add("pointer_null", Values.null_pointer)
            add("zero", Values.zero(Type.ARRAY(3, Types.i32)))
            add("undef", Values.undef(Types.i32))
            add("poison", Values.poison(Types.i64))
            add("string", Values.c_string("hello, \"world\"\n\\", true))
            add("unterminated", Values.c_string("é", false))
            add("array", Value.AGGREGATE([Values.i32(1), Values.i32(2), Values.i32(3)], Type.ARRAY(3, Types.i32)))
            add("empty_array", Value.AGGREGATE([], Type.ARRAY(0, Types.i32)))
            add("vector", Value.AGGREGATE([Values.of_single(1.0s), Values.of_single(2.0s)], Type.VECTOR(2, Type.FLOAT)))
            add(
                "structure",
                Value.AGGREGATE(
                    [Values.i64(7L), Values.global("true"), Value.AGGREGATE([Values.i32(1)], Type.ARRAY(1, Types.i32))],
                    Types.structure([Types.i64, Types.pointer, Type.ARRAY(1, Types.i32)])))
            add("packed", Value.AGGREGATE([Values.integer(Types.i8, bigint(1)), Values.i32(2)], Type.STRUCT([Types.i8, Types.i32], true)))
            add("empty_struct", Value.AGGREGATE([], Types.structure([])))

            let pair = module.add_type("pair", Types.structure([Types.i32, Types.i32]))
            let tight = module.add_type("tight", Type.STRUCT([Types.i8, Types.i8], true))

            add("named", Value.AGGREGATE([Values.i32(1), Values.i32(2)], pair.type))
            add("named_packed", Value.AGGREGATE([Values.integer(Types.i8, bigint(1)), Values.integer(Types.i8, bigint(2))], tight.type))

            return module
        si

        globals() -> MODULE static is
            let module = MODULE()

            let counter = module.add_global(GLOBAL_VARIABLE("counter", Types.i64, Values.i64(0L), false))
            counter.alignment = 8
            counter.dso_local = true

            let message = module.add_global(GLOBAL_VARIABLE("message", Types.i8, null, false))
            message.linkage = Linkage.EXTERN_WEAK

            module.add_global(GLOBAL_VARIABLE("elsewhere", Types.i32, null, true))

            let linkages = [
                Linkage.EXTERNAL,
                Linkage.PRIVATE,
                Linkage.INTERNAL,
                Linkage.AVAILABLE_EXTERNALLY,
                Linkage.LINKONCE,
                Linkage.LINKONCE_ODR,
                Linkage.WEAK,
                Linkage.WEAK_ODR,
                Linkage.COMMON
            ]

            for (i, linkage) in linkages |> index() do
                let global = module.add_global(GLOBAL_VARIABLE("linkage_{i}", Types.i32, Values.zero(Types.i32), false))

                global.linkage = linkage
            od

            let text = module.add_global(GLOBAL_VARIABLE("text", Type.ARRAY(3, Types.i8), Values.c_string("hi", true), true))
            text.linkage = Linkage.PRIVATE
            text.unnamed_address = UnnamedAddress.GLOBAL
            text.alignment = 1

            let local = module.add_global(GLOBAL_VARIABLE("local", Types.i32, Values.i32(1), false))
            local.unnamed_address = UnnamedAddress.LOCAL

            let table = module.add_global(
                GLOBAL_VARIABLE(
                    "table",
                    Type.ARRAY(2, Types.pointer),
                    Value.AGGREGATE([counter.reference, text.reference], Type.ARRAY(2, Types.pointer)),
                    true))
            table.linkage = Linkage.INTERNAL

            let ctors_type = Type.ARRAY(0, Types.structure([Types.i32, Types.pointer, Types.pointer]))
            let ctors = module.add_global(GLOBAL_VARIABLE("llvm.global_ctors", ctors_type, Value.AGGREGATE([], ctors_type), false))
            ctors.linkage = Linkage.APPENDING

            return module
        si

        declarations() -> MODULE static is
            let module = MODULE()

            _function(module, "nothing", Type.VOID, [])
            _function(module, "one", Types.i32, [_parameter(Types.i32, "x")])

            let printf = _function(module, "printf", Types.i32, [_parameter(Types.pointer, "format")])
            printf.is_variadic = true

            let only_variadic = _function(module, "only_variadic", Type.VOID, [])
            only_variadic.is_variadic = true

            let weak = _function(module, "maybe", Type.VOID, [])
            weak.linkage = Linkage.EXTERN_WEAK

            let local = _function(module, "local", Type.VOID, [])
            local.dso_local = true

            let fast = _function(module, "fast", Type.VOID, [])
            fast.calling_convention = CallingConvention.FAST

            return module
        si

        attributes() -> MODULE static is
            let module = MODULE()

            let node = module.add_type("node", Types.structure([Types.i64, Types.i64]))

            let f = _function(
                module,
                "attributed",
                Types.pointer,
                [_parameter(Types.pointer, "out"), _parameter(Types.pointer, "in"), _parameter(Types.i32, "n")])

            f.result_attributes.add(Attribute.FLAG("noalias"))
            f.result_attributes.add(Attribute.ALIGN(16))
            f.parameters[0].attributes.add(Attribute.TYPED("byval", node.type))
            f.parameters[0].attributes.add(Attribute.ALIGN(8))
            f.parameters[1].attributes.add(Attribute.FLAG("nonnull"))
            f.parameters[1].attributes.add(Attribute.INTEGER("dereferenceable", 16L))
            f.parameters[1].attributes.add(Attribute.FLAG("readonly"))
            f.parameters[2].attributes.add(Attribute.FLAG("noundef"))
            f.attributes.add(Attribute.FLAG("nounwind"))
            f.attributes.add(Attribute.FLAG("uwtable"))
            f.attributes.add(Attribute.STRING("frame-pointer", "all"))
            f.attributes.add(Attribute.STRING("no-trapping-math", null))
            f.unnamed_address = UnnamedAddress.GLOBAL
            f.linkage = Linkage.INTERNAL
            f.calling_convention = CallingConvention.COLD

            let entry = f.add_block("entry")
            entry.return_value(f.parameter(1))

            let declared = _function(module, "declared", Type.VOID, [_parameter(Types.i32, "x")])
            declared.parameters[0].attributes.add(Attribute.FLAG("signext"))
            declared.attributes.add(Attribute.FLAG("noreturn"))
            declared.attributes.add(Attribute.FLAG("nounwind"))

            let returns_through = _function(module, "returns_through", Type.VOID, [_parameter(Types.pointer, "out")])
            returns_through.parameters[0].attributes.add(Attribute.TYPED("sret", node.type))
            returns_through.add_block("entry").return_void()

            return module
        si

        names_module() -> MODULE static is
            let module = MODULE()

            module.add_type("a type with spaces", Types.structure([Types.i32]))
            module.add_global(GLOBAL_VARIABLE("1", Types.i32, Values.i32(1), false))
            module.add_global(GLOBAL_VARIABLE("with \"quotes\" and \\", Types.i32, Values.i32(2), false))
            module.add_global(GLOBAL_VARIABLE("ünïcode", Types.i32, Values.i32(3), false))
            module.add_global(GLOBAL_VARIABLE("$dollar.dot-dash_", Types.i32, Values.i32(4), false))

            let f = _function(module, "Ghul.Pipes.map[int]", Types.i32, [_parameter(Types.i32, "2")])
            let entry = f.add_block("0 entry")
            let other = f.add_block("then")

            entry.branch(other)
            other.return_value(f.parameter(0))

            return module
        si

        memory() -> MODULE static is
            let module = MODULE()

            let pair = module.add_type("pair", Types.structure([Types.i32, Types.i64]))

            let f = _function(module, "memory", Types.i64, [_parameter(Types.pointer, "p"), _parameter(Types.i64, "n")])
            let entry = f.add_block("entry")

            let slot = entry.alloca(Types.i32, 4)
            entry.store(Values.i32(42), slot, 4)
            let value = entry.load(Types.i32, slot, 4)
            entry.store(value, f.parameter(0), 0)

            let space = entry.alloca(pair.type, 0)
            let member = entry.element_pointer(pair.type, space, [Values.i32(0), Values.i32(1)], true)
            entry.store(Values.i64(7L), member, 8)

            let element = entry.element_pointer(Types.i64, f.parameter(0), [f.parameter(1)], false)
            let read = entry.load(Types.i64, element, 0)

            let many = entry.alloca(Types.i8, 0)

            entry.append(
                Operation.ALLOCA("counted", Types.i8, Values.i32(16), 16),
                Values.local(Types.pointer, "counted"))
            entry.append(
                Operation.LOAD("volatile", Types.i64, many, 1, true),
                Values.local(Types.i64, "volatile"))
            entry.append(Operation.STORE(Values.i64(1L), f.parameter(0), 0, true), null)

            entry.return_value(read)

            return module
        si

        integer_arithmetic() -> MODULE static is
            let module = MODULE()

            let f = _function(module, "integers", Types.i32, [_parameter(Types.i32, "a"), _parameter(Types.i32, "b")])
            let entry = f.add_block("entry")

            let a = f.parameter(0)
            let b = f.parameter(1)

            let operators = [
                BinaryOperator.ADD,
                BinaryOperator.SUB,
                BinaryOperator.MUL,
                BinaryOperator.UDIV,
                BinaryOperator.SDIV,
                BinaryOperator.UREM,
                BinaryOperator.SREM,
                BinaryOperator.SHL,
                BinaryOperator.LSHR,
                BinaryOperator.ASHR,
                BinaryOperator.AND,
                BinaryOperator.OR,
                BinaryOperator.XOR
            ]

            let total mut = a

            for operator in operators do
                total = entry.binary(operator, IntegerFlags.NONE, total, b)
            od

            total = entry.binary(BinaryOperator.ADD, IntegerFlags.NO_UNSIGNED_WRAP | IntegerFlags.NO_SIGNED_WRAP, total, b)
            total = entry.binary(BinaryOperator.SUB, IntegerFlags.NO_SIGNED_WRAP, total, b)
            total = entry.binary(BinaryOperator.MUL, IntegerFlags.NO_UNSIGNED_WRAP, total, b)
            total = entry.binary(BinaryOperator.SHL, IntegerFlags.NO_SIGNED_WRAP, total, Values.i32(1))
            total = entry.binary(BinaryOperator.SDIV, IntegerFlags.EXACT, total, b)
            total = entry.binary(BinaryOperator.LSHR, IntegerFlags.EXACT, total, Values.i32(1))
            total = entry.binary(BinaryOperator.OR, IntegerFlags.DISJOINT, total, Values.i32(1))

            entry.return_value(total)

            return module
        si

        float_arithmetic() -> MODULE static is
            let module = MODULE()

            let f = _function(module, "floats", Type.DOUBLE, [_parameter(Type.DOUBLE, "a"), _parameter(Type.DOUBLE, "b")])
            let entry = f.add_block("entry")

            let a = f.parameter(0)
            let b = f.parameter(1)

            let total mut = a

            for operator in [BinaryOperator.FADD, BinaryOperator.FSUB, BinaryOperator.FMUL, BinaryOperator.FDIV, BinaryOperator.FREM] do
                total = entry.floating(operator, FastMath.NONE, total, b)
            od

            total = entry.floating(BinaryOperator.FADD, FastMath.FAST, total, Values.of_double(0.5))
            total = entry.floating(BinaryOperator.FMUL, FastMath.NO_NANS | FastMath.NO_INFINITIES | FastMath.CONTRACT, total, b)
            total = entry.negate(total)

            let half = _function(module, "halves", Type.HALF, [_parameter(Type.HALF, "h")])
            let half_entry = half.add_block("entry")
            half_entry.return_value(half_entry.floating(BinaryOperator.FADD, FastMath.NONE, half.parameter(0), Values.of_half(0x3C00us)))

            entry.return_value(total)

            return module
        si

        comparisons() -> MODULE static is
            let module = MODULE()

            let f = _function(
                module,
                "comparisons",
                Types.i1,
                [_parameter(Types.i32, "a"), _parameter(Type.DOUBLE, "x"), _parameter(Types.pointer, "p")])
            let entry = f.add_block("entry")

            let all mut = Values.boolean(true)

            let integer_predicates = [
                IntegerPredicate.EQ, IntegerPredicate.NE, IntegerPredicate.UGT, IntegerPredicate.UGE, IntegerPredicate.ULT,
                IntegerPredicate.ULE, IntegerPredicate.SGT, IntegerPredicate.SGE, IntegerPredicate.SLT, IntegerPredicate.SLE
            ]

            for predicate in integer_predicates do
                all = entry.binary(BinaryOperator.AND, IntegerFlags.NONE, all, entry.compare(predicate, f.parameter(0), Values.i32(3)))
            od

            let float_predicates = [
                FloatPredicate.FALSE, FloatPredicate.OEQ, FloatPredicate.OGT, FloatPredicate.OGE, FloatPredicate.OLT,
                FloatPredicate.OLE, FloatPredicate.ONE, FloatPredicate.ORD, FloatPredicate.UEQ, FloatPredicate.UGT,
                FloatPredicate.UGE, FloatPredicate.ULT, FloatPredicate.ULE, FloatPredicate.UNE, FloatPredicate.UNO,
                FloatPredicate.TRUE
            ]

            for predicate in float_predicates do
                all = entry.binary(BinaryOperator.AND, IntegerFlags.NONE, all, entry.compare(predicate, f.parameter(1), Values.of_double(1.5)))
            od

            all = entry.binary(BinaryOperator.AND, IntegerFlags.NONE, all, entry.compare(IntegerPredicate.EQ, f.parameter(2), Values.null_pointer))

            entry.append(
                Operation.FLOAT_COMPARE("fast", FloatPredicate.OLT, FastMath.FAST, f.parameter(1), Values.of_double(0.0)),
                Values.local(Types.i1, "fast"))

            entry.return_value(entry.select(all, Values.boolean(false), Values.local(Types.i1, "fast")))

            return module
        si

        conversions() -> MODULE static is
            let module = MODULE()

            let f = _function(
                module,
                "conversions",
                Types.i64,
                [_parameter(Types.i64, "n"), _parameter(Type.DOUBLE, "x"), _parameter(Types.pointer, "p")])
            let entry = f.add_block("entry")

            let n = f.parameter(0)
            let x = f.parameter(1)
            let p = f.parameter(2)

            let narrow = entry.convert(Conversion.TRUNCATE, n, Types.i32)
            let wide = entry.convert(Conversion.ZERO_EXTEND, narrow, Types.i64)
            let signed = entry.convert(Conversion.SIGN_EXTEND, narrow, Type.INTEGER(128))
            let single = entry.convert(Conversion.FLOAT_TRUNCATE, x, Type.FLOAT)
            let double = entry.convert(Conversion.FLOAT_EXTEND, single, Type.DOUBLE)
            let unsigned = entry.convert(Conversion.FLOAT_TO_UNSIGNED, double, Types.i32)
            let truncated = entry.convert(Conversion.FLOAT_TO_SIGNED, x, Types.i64)
            entry.convert(Conversion.UNSIGNED_TO_FLOAT, unsigned, Type.FLOAT)
            entry.convert(Conversion.SIGNED_TO_FLOAT, signed, Type.DOUBLE)
            let address = entry.convert(Conversion.POINTER_TO_INTEGER, p, Types.i64)
            let pointer = entry.convert(Conversion.INTEGER_TO_POINTER, address, Types.pointer)
            entry.convert(Conversion.BIT_CAST, x, Types.i64)
            entry.convert(Conversion.ADDRESS_SPACE_CAST, pointer, Type.POINTER(1))

            entry.append(
                Operation.CONVERT("exact_trunc", Conversion.TRUNCATE, IntegerFlags.NO_UNSIGNED_WRAP | IntegerFlags.NO_SIGNED_WRAP, n, Types.i8),
                Values.local(Types.i8, "exact_trunc"))
            entry.append(
                Operation.CONVERT("nneg_zext", Conversion.ZERO_EXTEND, IntegerFlags.NON_NEGATIVE, narrow, Types.i64),
                Values.local(Types.i64, "nneg_zext"))
            entry.append(
                Operation.CONVERT("nneg_uitofp", Conversion.UNSIGNED_TO_FLOAT, IntegerFlags.NON_NEGATIVE, narrow, Type.DOUBLE),
                Values.local(Type.DOUBLE, "nneg_uitofp"))

            let sum = entry.binary(BinaryOperator.ADD, IntegerFlags.NONE, wide, truncated)

            entry.return_value(sum)

            return module
        si

        aggregates() -> MODULE static is
            let module = MODULE()

            let pair_type = Types.structure([Types.i32, Type.ARRAY(2, Type.DOUBLE)])

            let f = _function(module, "aggregates", pair_type, [_parameter(pair_type, "pair"), _parameter(Type.DOUBLE, "x")])
            let entry = f.add_block("entry")

            let first = entry.extract_value(Types.i32, f.parameter(0), [0])
            let inner = entry.extract_value(Type.DOUBLE, f.parameter(0), [1, 1])
            let sum = entry.floating(BinaryOperator.FADD, FastMath.NONE, inner, f.parameter(1))
            let replaced = entry.insert_value(f.parameter(0), sum, [1, 0])
            let incremented = entry.binary(BinaryOperator.ADD, IntegerFlags.NONE, first, Values.i32(1))
            let result = entry.insert_value(replaced, incremented, [0])

            entry.return_value(result)

            let built = _function(module, "built", pair_type, [])
            let built_entry = built.add_block("entry")
            let from_undef = built_entry.insert_value(Values.undef(pair_type), Values.i32(1), [0])
            let from_poison = built_entry.insert_value(from_undef, Values.zero(Type.ARRAY(2, Type.DOUBLE)), [1])
            built_entry.return_value(from_poison)

            return module
        si

        calls() -> MODULE static is
            let module = MODULE()

            let callee = _function(module, "callee", Types.i32, [_parameter(Types.i32, "x")])
            let callee_entry = callee.add_block("entry")
            callee_entry.return_value(callee.parameter(0))

            let effect = _function(module, "effect", Type.VOID, [])

            let printf = _function(module, "printf", Types.i32, [_parameter(Types.pointer, "format")])
            printf.is_variadic = true

            let fast = _function(module, "fast", Types.i32, [])
            fast.calling_convention = CallingConvention.FAST

            let format = module.add_global(GLOBAL_VARIABLE("format", Type.ARRAY(4, Types.i8), Values.c_string("%d\n", true), true))
            format.linkage = Linkage.PRIVATE
            format.unnamed_address = UnnamedAddress.GLOBAL

            let f = _function(module, "caller", Types.i32, [_parameter(Types.pointer, "through")])
            let entry = f.add_block("entry")

            let direct = entry.call(callee, [Values.i32(1)])!
            entry.call(effect, [])
            let indirect = entry.call(callee.type, f.parameter(0), [direct])!
            entry.call(printf, [format.reference, indirect])

            entry.append(
                Operation.CALL(
                    "fast_result",
                    TailCall.NONE,
                    CallingConvention.FAST,
                    fast.type,
                    fast.reference,
                    [],
                    [Attribute.FLAG("noundef")],
                    [Attribute.FLAG("nounwind")]),
                Values.local(Types.i32, "fast_result"))

            let noundef: ARRAY[Attribute] = [Attribute.FLAG("noundef")]

            entry.append(
                Operation.CALL(
                    null,
                    TailCall.NO_TAIL,
                    CallingConvention.C,
                    callee.type,
                    callee.reference,
                    [(value = Values.i32(2), attributes = noundef)],
                    [],
                    []),
                null)

            let tail = entry.call(TailCall.TAIL, callee.type, callee.reference, [indirect])!
            let total = entry.binary(BinaryOperator.ADD, IntegerFlags.NONE, tail, Values.local(Types.i32, "fast_result"))

            entry.return_value(total)

            let forward = _function(module, "forward", Types.i32, [_parameter(Types.i32, "x")])
            let forward_entry = forward.add_block("entry")
            let forwarded = forward_entry.call(TailCall.MUST_TAIL, callee.type, callee.reference, [forward.parameter(0)])!
            forward_entry.return_value(forwarded)

            return module
        si

        control() -> MODULE static is
            let module = MODULE()

            let f = _function(module, "control", Types.i32, [_parameter(Types.i32, "n"), _parameter(Types.i1, "flag")])

            let entry = f.add_block("entry")
            let choose = f.add_block("choose")
            let one = f.add_block("one")
            let two = f.add_block("two")
            let other = f.add_block("other")
            let never = f.add_block("never")
            let done = f.add_block("done")

            entry.branch(f.parameter(1), choose, never)

            choose.switch(f.parameter(0), other, [(Values.i32(1), one), (Values.i32(2), two)])

            one.branch(done)
            two.branch(done)
            other.branch(done)

            never.unreachable()

            done.return_value(f.parameter(0))

            let empty_switch = _function(module, "empty_switch", Type.VOID, [_parameter(Types.i8, "n")])
            let empty_entry = empty_switch.add_block("entry")
            let empty_done = empty_switch.add_block("done")

            empty_entry.switch(empty_switch.parameter(0), empty_done, [])
            empty_done.return_void()

            return module
        si

        exceptions() -> MODULE static is
            let module = MODULE()

            let personality = _function(module, "__gxx_personality_v0", Types.i32, [])
            personality.is_variadic = true

            let may_throw = _function(module, "may_throw", Types.i32, [_parameter(Types.i32, "x")])
            let effect = _function(module, "effect", Type.VOID, [])

            let typeinfo = module.add_global(GLOBAL_VARIABLE("typeinfo", Types.pointer, null, true))

            let f = _function(module, "catches", Types.i32, [_parameter(Types.i32, "x")])
            f.personality = personality.reference

            let entry = f.add_block("entry")
            let normal = f.add_block("normal")
            let done = f.add_block("done")
            let landing = f.add_block("landing")

            let result = entry.invoke(may_throw.type, may_throw.reference, [f.parameter(0)], normal, landing)!

            normal.invoke(effect.type, effect.reference, [], done, landing)

            done.return_value(result)

            let pad_type = Types.structure([Types.pointer, Types.i32])
            let exception = landing.landing_pad(pad_type, true, [typeinfo.reference])

            landing.call(effect, [])
            landing.resume(exception)

            let cleanup_only = _function(module, "cleanup_only", Type.VOID, [])
            cleanup_only.personality = personality.reference

            let cleanup_entry = cleanup_only.add_block("entry")
            let cleanup_done = cleanup_only.add_block("done")
            let cleanup_landing = cleanup_only.add_block("landing")

            cleanup_entry.invoke(effect.type, effect.reference, [], cleanup_done, cleanup_landing)
            cleanup_done.return_void()
            cleanup_landing.resume(cleanup_landing.landing_pad(pad_type, true, []))

            return module
        si

        intrinsics() -> MODULE static is
            let module = MODULE()

            let memcpy = module.declare_intrinsic(Intrinsics.memcpy())
            let memset = module.declare_intrinsic(Intrinsics.memset())
            let trap = module.declare_intrinsic(Intrinsics.trap())

            let f = _function(
                module,
                "uses",
                Types.i32,
                [_parameter(Types.pointer, "to"), _parameter(Types.pointer, "from"), _parameter(Type.DOUBLE, "x"), _parameter(Types.i32, "n")])

            let entry = f.add_block("entry")
            let overflowed = f.add_block("overflowed")
            let fine = f.add_block("fine")

            entry.call(memcpy, [f.parameter(0), f.parameter(1), Values.i64(16L), Values.boolean(false)])
            entry.call(memset, [f.parameter(0), Values.integer(Types.i8, bigint(0)), Values.i64(16L), Values.boolean(false)])

            let conversions = [
                (Types.i32, Type.DOUBLE),
                (Types.i64, Type.DOUBLE),
                (Types.i8, Type.FLOAT),
                (Types.i16, Type.HALF)
            ]

            for (to, from) in conversions do
                let value =
                    if from =~ Type.DOUBLE then
                        f.parameter(2)
                    else
                        entry.convert(Conversion.FLOAT_TRUNCATE, f.parameter(2), from)
                    fi

                entry.call(module.declare_intrinsic(Intrinsics.float_to_signed_saturating(to, from)), [value])
                entry.call(module.declare_intrinsic(Intrinsics.float_to_unsigned_saturating(to, from)), [value])
            od

            let overflow_operations = [
                Overflow.SIGNED_ADD,
                Overflow.UNSIGNED_ADD,
                Overflow.SIGNED_SUB,
                Overflow.UNSIGNED_SUB,
                Overflow.SIGNED_MUL,
                Overflow.UNSIGNED_MUL
            ]

            let any mut = Values.boolean(false)
            let last mut = f.parameter(3)

            for operation in overflow_operations do
                let checked = entry.call(module.declare_intrinsic(Intrinsics.with_overflow(operation, Types.i32)), [last, f.parameter(3)])!

                last = entry.extract_value(Types.i32, checked, [0])
                any = entry.binary(BinaryOperator.OR, IntegerFlags.NONE, any, entry.extract_value(Types.i1, checked, [1]))
            od

            let wide = entry.call(module.declare_intrinsic(Intrinsics.with_overflow(Overflow.SIGNED_ADD, Types.i64)), [Values.i64(1L), Values.i64(2L)])!
            entry.extract_value(Types.i64, wide, [0])

            module.declare_intrinsic(Intrinsics.memcpy())

            entry.branch(any, overflowed, fine)

            overflowed.call(trap, [])
            overflowed.unreachable()

            fine.return_value(last)

            return module
        si

        metadata() -> MODULE static is
            let module = MODULE()

            let empty = module.add_metadata(MetadataNode.TUPLE([]), false)
            let mixed = module.add_metadata(
                MetadataNode.TUPLE([
                    Metadata.STRING("text with \"quotes\""),
                    Metadata.VALUE(Values.i32(7)),
                    Metadata.VALUE(Values.of_double(1.5)),
                    Metadata.NULL,
                    empty
                ]),
                false)
            let unique = module.add_metadata(MetadataNode.TUPLE([Metadata.STRING("unique")]), true)

            module.named("ghul.notes").operands.add(mixed)
            module.named("ghul.notes").operands.add(unique)
            module.named("1 odd name").operands.add(empty)

            module.add_module_flag(ModuleFlagBehavior.WARNING, "some flag", Values.i32(1))

            let f = _function(module, "annotated", Types.i32, [_parameter(Types.i32, "x")])
            f.attach("ghul.function", unique)

            let entry = f.add_block("entry")
            let sum = entry.binary(BinaryOperator.ADD, IntegerFlags.NONE, f.parameter(0), Values.i32(1))
            entry.instructions[0].attach("ghul.note", mixed)
            entry.return_value(sum)

            return module
        si

        debug_info() -> MODULE static is
            let module = MODULE()

            module.source_filename = "example.ghul"

            let file = module.add_metadata(MetadataNode.FILE("example.ghul", "/src/project"), false)
            let unit = module.add_metadata(
                MetadataNode.COMPILE_UNIT("DW_LANG_C99", file, "ghul", false, DebugEmission.FULL_DEBUG),
                true)

            module.named("llvm.dbg.cu").operands.add(unit)
            module.add_module_flag(ModuleFlagBehavior.WARNING, "Debug Info Version", Values.i32(3))
            module.add_module_flag(ModuleFlagBehavior.MAX, "Dwarf Version", Values.i32(5))

            let types = module.add_metadata(MetadataNode.TUPLE([Metadata.NULL]), false)
            let type = module.add_metadata(MetadataNode.SUBROUTINE_TYPE(types), false)

            let helper_program = module.add_metadata(
                MetadataNode.SUBPROGRAM("helper", "Example.helper", file, file, 3, type, 3, true, unit),
                true)

            let helper = _function(module, "helper", Type.VOID, [])
            helper.linkage = Linkage.INTERNAL
            helper.attach("dbg", helper_program)

            let helper_entry = helper.add_block("entry")
            let helper_location = module.add_metadata(MetadataNode.LOCATION(4, 5, helper_program, null), false)
            helper_entry.debug_location = helper_location

            let int_type = module.add_metadata(MetadataNode.BASIC_TYPE("int", 32, "DW_ATE_signed"), false)
            let pointer_type = module.add_metadata(MetadataNode.POINTER_TYPE(Metadata.NULL, 64), false)

            let count = helper_entry.alloca(Types.i32, 0)
            helper_entry.declare(count, module.add_metadata(MetadataNode.LOCAL_VARIABLE("count", 0, helper_program, file, 4, int_type), false), helper_location)
            helper_entry.store(Values.i32(0), count, 0)

            let owner = helper_entry.alloca(Types.pointer, 0)
            helper_entry.declare(owner, module.add_metadata(MetadataNode.LOCAL_VARIABLE("owner", 1, helper_program, file, 3, pointer_type), false), helper_location)
            helper_entry.store(Values.null_pointer, owner, 0)

            helper_entry.return_void()

            let main_program = module.add_metadata(
                MetadataNode.SUBPROGRAM("main", null, file, file, 10, type, 11, true, unit),
                true)

            let main = _function(module, "main", Types.i32, [])
            main.attach("dbg", main_program)

            let entry = main.add_block("entry")

            entry.debug_location = module.add_metadata(MetadataNode.LOCATION(12, 9, main_program, null), false)
            entry.call(helper, [])

            let call_site = module.add_metadata(MetadataNode.LOCATION(13, 9, main_program, null), false)
            entry.debug_location = module.add_metadata(MetadataNode.LOCATION(4, 5, helper_program, call_site), false)
            entry.call(helper, [])

            entry.debug_location = module.add_metadata(MetadataNode.LOCATION(14, 5, main_program, null), false)
            entry.return_value(Values.i32(0))

            let declared_program = module.add_metadata(
                MetadataNode.SUBPROGRAM("declared", null, file, file, 20, type, 20, false, null),
                false)
            module.named("ghul.declarations").operands.add(declared_program)

            return module
        si
    si
si
