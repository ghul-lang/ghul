namespace LLVM.UnitTests is
    use LLVM

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class INSTRUCTION_TESTS is
        init() is si

        _text(operation: Operation) -> string => WRITER.instruction_text(INSTRUCTION(operation, null))

        _a: Value => Values.local(Types.i32, "a")
        _b: Value => Values.local(Types.i32, "b")
        _x: Value => Values.local(Type.DOUBLE, "x")
        _y: Value => Values.local(Type.DOUBLE, "y")
        _p: Value => Values.local(Types.pointer, "p")

        @Test()
        alloca__writes_its_count_and_alignment_when_given() is
            are_equal("%r = alloca i32", _text(Operation.ALLOCA("r", Types.i32, null, 0)))
            are_equal("%r = alloca i32, align 4", _text(Operation.ALLOCA("r", Types.i32, null, 4)))
            are_equal("%r = alloca i8, i64 16, align 16", _text(Operation.ALLOCA("r", Types.i8, Values.i64(16L), 16)))
        si

        @Test()
        load_and_store__write_their_alignment_and_volatility() is
            are_equal("%r = load i32, ptr %p", _text(Operation.LOAD("r", Types.i32, _p, 0, false)))
            are_equal("%r = load volatile i32, ptr %p, align 4", _text(Operation.LOAD("r", Types.i32, _p, 4, true)))
            are_equal("store i32 %a, ptr %p", _text(Operation.STORE(_a, _p, 0, false)))
            are_equal("store volatile i32 %a, ptr %p, align 4", _text(Operation.STORE(_a, _p, 4, true)))
        si

        @Test()
        get_element_pointer__writes_the_source_type_and_every_index() is
            are_equal(
                "%r = getelementptr inbounds %pair, ptr %p, i32 0, i32 1",
                _text(Operation.GET_ELEMENT_POINTER("r", Type.NAMED("pair"), _p, [Values.i32(0), Values.i32(1)], true)))
            are_equal(
                "%r = getelementptr i64, ptr %p, i64 %n",
                _text(Operation.GET_ELEMENT_POINTER("r", Types.i64, _p, [Values.local(Types.i64, "n")], false)))
        si

        @Test()
        binary__writes_the_type_once() is
            are_equal(
                "%r = add i32 %a, %b",
                _text(Operation.BINARY("r", BinaryOperator.ADD, IntegerFlags.NONE, FastMath.NONE, _a, _b)))
            are_equal(
                "%r = xor i32 %a, -1",
                _text(Operation.BINARY("r", BinaryOperator.XOR, IntegerFlags.NONE, FastMath.NONE, _a, Values.i32(-1))))
        si

        @Test()
        binary__each_operator_has_its_mnemonic() is
            let expected = [
                (BinaryOperator.ADD, "add"), (BinaryOperator.SUB, "sub"), (BinaryOperator.MUL, "mul"),
                (BinaryOperator.UDIV, "udiv"), (BinaryOperator.SDIV, "sdiv"), (BinaryOperator.UREM, "urem"),
                (BinaryOperator.SREM, "srem"), (BinaryOperator.SHL, "shl"), (BinaryOperator.LSHR, "lshr"),
                (BinaryOperator.ASHR, "ashr"), (BinaryOperator.AND, "and"), (BinaryOperator.OR, "or"),
                (BinaryOperator.XOR, "xor")
            ]

            for (operator, mnemonic) in expected do
                are_equal(
                    "%r = {mnemonic} i32 %a, %b",
                    _text(Operation.BINARY("r", operator, IntegerFlags.NONE, FastMath.NONE, _a, _b)))
            od

            let floating = [
                (BinaryOperator.FADD, "fadd"), (BinaryOperator.FSUB, "fsub"), (BinaryOperator.FMUL, "fmul"),
                (BinaryOperator.FDIV, "fdiv"), (BinaryOperator.FREM, "frem")
            ]

            for (operator, mnemonic) in floating do
                are_equal(
                    "%r = {mnemonic} double %x, %y",
                    _text(Operation.BINARY("r", operator, IntegerFlags.NONE, FastMath.NONE, _x, _y)))
            od
        si

        @Test()
        binary__writes_the_flags_its_operator_allows() is
            let both = IntegerFlags.NO_UNSIGNED_WRAP | IntegerFlags.NO_SIGNED_WRAP

            are_equal("%r = add nuw nsw i32 %a, %b", _text(Operation.BINARY("r", BinaryOperator.ADD, both, FastMath.NONE, _a, _b)))
            are_equal("%r = shl nsw i32 %a, %b", _text(Operation.BINARY("r", BinaryOperator.SHL, IntegerFlags.NO_SIGNED_WRAP, FastMath.NONE, _a, _b)))
            are_equal("%r = sdiv exact i32 %a, %b", _text(Operation.BINARY("r", BinaryOperator.SDIV, IntegerFlags.EXACT, FastMath.NONE, _a, _b)))
            are_equal("%r = or disjoint i32 %a, %b", _text(Operation.BINARY("r", BinaryOperator.OR, IntegerFlags.DISJOINT, FastMath.NONE, _a, _b)))
        si

        @Test()
        binary__refuses_flags_its_operator_does_not_allow() is
            are_equal(
                "add does not take the flags EXACT",
                throws(() => _text(Operation.BINARY("r", BinaryOperator.ADD, IntegerFlags.EXACT, FastMath.NONE, _a, _b))))
            throws(() => _text(Operation.BINARY("r", BinaryOperator.AND, IntegerFlags.NO_SIGNED_WRAP, FastMath.NONE, _a, _b)))
            throws(() => _text(Operation.BINARY("r", BinaryOperator.FADD, IntegerFlags.NO_SIGNED_WRAP, FastMath.NONE, _x, _y)))
            throws(() => _text(Operation.BINARY("r", BinaryOperator.ADD, IntegerFlags.NONE, FastMath.FAST, _a, _b)))
        si

        @Test()
        fast_math__is_written_flag_by_flag_or_as_fast() is
            are_equal(
                "%r = fadd fast double %x, %y",
                _text(Operation.BINARY("r", BinaryOperator.FADD, IntegerFlags.NONE, FastMath.FAST, _x, _y)))
            are_equal(
                "%r = fmul nnan ninf contract double %x, %y",
                _text(Operation.BINARY("r", BinaryOperator.FMUL, IntegerFlags.NONE, FastMath.NO_NANS | FastMath.NO_INFINITIES | FastMath.CONTRACT, _x, _y)))
            are_equal(
                "%r = fsub reassoc nsz arcp afn double %x, %y",
                _text(
                    Operation.BINARY(
                        "r",
                        BinaryOperator.FSUB,
                        IntegerFlags.NONE,
                        FastMath.REASSOCIATE | FastMath.NO_SIGNED_ZEROS | FastMath.ALLOW_RECIPROCAL | FastMath.APPROXIMATE_FUNCTIONS,
                        _x,
                        _y)))
        si

        @Test()
        negate__is_fneg() is
            are_equal("%r = fneg double %x", _text(Operation.NEGATE("r", FastMath.NONE, _x)))
            are_equal("%r = fneg fast double %x", _text(Operation.NEGATE("r", FastMath.FAST, _x)))
        si

        @Test()
        compare__writes_its_predicate() is
            are_equal("%r = icmp slt i32 %a, %b", _text(Operation.INTEGER_COMPARE("r", IntegerPredicate.SLT, _a, _b)))
            are_equal("%r = icmp eq ptr %p, null", _text(Operation.INTEGER_COMPARE("r", IntegerPredicate.EQ, _p, Values.null_pointer)))
            are_equal("%r = fcmp une double %x, %y", _text(Operation.FLOAT_COMPARE("r", FloatPredicate.UNE, FastMath.NONE, _x, _y)))
            are_equal("%r = fcmp nnan olt double %x, %y", _text(Operation.FLOAT_COMPARE("r", FloatPredicate.OLT, FastMath.NO_NANS, _x, _y)))
            are_equal("%r = fcmp true double %x, %y", _text(Operation.FLOAT_COMPARE("r", FloatPredicate.TRUE, FastMath.NONE, _x, _y)))
        si

        @Test()
        convert__writes_the_source_and_target_types() is
            let expected = [
                (Conversion.TRUNCATE, "trunc"), (Conversion.ZERO_EXTEND, "zext"), (Conversion.SIGN_EXTEND, "sext"),
                (Conversion.FLOAT_TRUNCATE, "fptrunc"), (Conversion.FLOAT_EXTEND, "fpext"),
                (Conversion.FLOAT_TO_UNSIGNED, "fptoui"), (Conversion.FLOAT_TO_SIGNED, "fptosi"),
                (Conversion.UNSIGNED_TO_FLOAT, "uitofp"), (Conversion.SIGNED_TO_FLOAT, "sitofp"),
                (Conversion.POINTER_TO_INTEGER, "ptrtoint"), (Conversion.INTEGER_TO_POINTER, "inttoptr"),
                (Conversion.BIT_CAST, "bitcast"), (Conversion.ADDRESS_SPACE_CAST, "addrspacecast")
            ]

            for (operator, mnemonic) in expected do
                are_equal(
                    "%r = {mnemonic} i32 %a to i64",
                    _text(Operation.CONVERT("r", operator, IntegerFlags.NONE, _a, Types.i64)))
            od
        si

        @Test()
        convert__writes_the_flags_its_operator_allows() is
            are_equal(
                "%r = trunc nuw nsw i32 %a to i8",
                _text(Operation.CONVERT("r", Conversion.TRUNCATE, IntegerFlags.NO_UNSIGNED_WRAP | IntegerFlags.NO_SIGNED_WRAP, _a, Types.i8)))
            are_equal(
                "%r = zext nneg i32 %a to i64",
                _text(Operation.CONVERT("r", Conversion.ZERO_EXTEND, IntegerFlags.NON_NEGATIVE, _a, Types.i64)))
            are_equal(
                "%r = uitofp nneg i32 %a to double",
                _text(Operation.CONVERT("r", Conversion.UNSIGNED_TO_FLOAT, IntegerFlags.NON_NEGATIVE, _a, Type.DOUBLE)))
            throws(() => _text(Operation.CONVERT("r", Conversion.SIGN_EXTEND, IntegerFlags.NON_NEGATIVE, _a, Types.i64)))
        si

        @Test()
        select__writes_every_operand_with_its_type() is
            are_equal(
                "%r = select i1 %c, i32 %a, i32 %b",
                _text(Operation.SELECT("r", Values.local(Types.i1, "c"), _a, _b)))
        si

        @Test()
        call__writes_the_result_type_and_typed_arguments() is
            let type = Types.function(Types.i32, [Types.i32, Types.i32])

            are_equal(
                "%r = call i32 @f(i32 %a, i32 1)",
                _text(Operation.CALL("r", TailCall.NONE, CallingConvention.C, type, Values.global("f"), _arguments([_a, Values.i32(1)]), [], [])))
        si

        @Test()
        call__to_a_void_function__has_no_result() is
            are_equal(
                "call void @f()",
                _text(Operation.CALL(null, TailCall.NONE, CallingConvention.C, Types.function(Type.VOID, []), Values.global("f"), [], [], [])))
        si

        @Test()
        call__to_a_variadic_function__writes_the_whole_function_type() is
            let type = Type.FUNCTION(Types.i32, [Types.pointer], true)

            are_equal(
                "%r = call i32 (ptr, ...) @printf(ptr %p, i32 %a)",
                _text(Operation.CALL("r", TailCall.NONE, CallingConvention.C, type, Values.global("printf"), _arguments([_p, _a]), [], [])))
        si

        @Test()
        call__through_a_pointer__names_the_pointer() is
            are_equal(
                "%r = call i32 %p()",
                _text(Operation.CALL("r", TailCall.NONE, CallingConvention.C, Types.function(Types.i32, []), _p, [], [], [])))
        si

        @Test()
        call__writes_its_tail_marker_convention_and_attributes() is
            let type = Types.function(Types.i32, [Types.i32])
            let noundef: ARRAY[Attribute] = [Attribute.FLAG("noundef")]
            let nounwind: ARRAY[Attribute] = [Attribute.FLAG("nounwind")]
            let arguments: ARRAY[(value: Value, attributes: ARRAY[Attribute])] = [(value = _a, attributes = noundef)]

            let expected = [
                (TailCall.TAIL, "tail "),
                (TailCall.MUST_TAIL, "musttail "),
                (TailCall.NO_TAIL, "notail ")
            ]

            for (tail, marker) in expected do
                are_equal(
                    "%r = {marker}call fastcc noundef i32 @f(i32 noundef %a) nounwind",
                    _text(Operation.CALL("r", tail, CallingConvention.FAST, type, Values.global("f"), arguments, noundef, nounwind)))
            od
        si

        @Test()
        extract_and_insert_value__write_their_indices() is
            let pair = Values.local(Types.structure([Types.i32, Type.ARRAY(2, Types.i32)]), "s")

            are_equal("%r = extractvalue {{ i32, [2 x i32] }} %s, 1, 0", _text(Operation.EXTRACT_VALUE("r", pair, [1, 0])))
            are_equal("%r = insertvalue {{ i32, [2 x i32] }} %s, i32 %a, 0", _text(Operation.INSERT_VALUE("r", pair, _a, [0])))
        si

        @Test()
        terminators__are_written_as_llvm_spells_them() is
            are_equal("ret i32 %a", _text(Operation.RETURN(_a)))
            are_equal("ret void", _text(Operation.RETURN(null)))
            are_equal("br label %next", _text(Operation.BRANCH("next")))
            are_equal("br i1 %c, label %yes, label %no", _text(Operation.CONDITIONAL_BRANCH(Values.local(Types.i1, "c"), "yes", "no")))
            are_equal("unreachable", _text(Operation.UNREACHABLE))
        si

        @Test()
        switch__writes_one_case_a_line() is
            let cases: ARRAY[(value: Value, target: string)] = [(value = Values.i32(1), target = "one"), (value = Values.i32(2), target = "two")]

            are_equal(
                "switch i32 %a, label %other [\n    i32 1, label %one\n    i32 2, label %two\n  ]",
                _text(Operation.SWITCH(_a, "other", cases)))
            are_equal("switch i32 %a, label %other []", _text(Operation.SWITCH(_a, "other", [])))
        si

        @Test()
        invoke__names_where_it_continues_and_where_it_unwinds() is
            let type = Types.function(Types.i32, [Types.i32])

            are_equal(
                "%r = invoke i32 @f(i32 %a) to label %normal unwind label %landing",
                _text(Operation.INVOKE("r", CallingConvention.C, type, Values.global("f"), _arguments([_a]), [], [], "normal", "landing")))
            are_equal(
                "invoke void @g() to label %normal unwind label %landing",
                _text(Operation.INVOKE(null, CallingConvention.C, Types.function(Type.VOID, []), Values.global("g"), [], [], [], "normal", "landing")))
        si

        @Test()
        landing_pad__writes_cleanup_and_its_catches() is
            let pad = Types.structure([Types.pointer, Types.i32])

            are_equal("%r = landingpad {{ ptr, i32 }} cleanup", _text(Operation.LANDING_PAD("r", pad, true, [])))
            are_equal(
                "%r = landingpad {{ ptr, i32 }} catch ptr @a catch ptr null",
                _text(Operation.LANDING_PAD("r", pad, false, [Values.global("a"), Values.null_pointer])))
            are_equal(
                "%r = landingpad {{ ptr, i32 }} cleanup catch ptr @a",
                _text(Operation.LANDING_PAD("r", pad, true, [Values.global("a")])))
        si

        @Test()
        resume__writes_the_exception_value() is
            are_equal(
                "resume {{ ptr, i32 }} %e",
                _text(Operation.RESUME(Values.local(Types.structure([Types.pointer, Types.i32]), "e"))))
        si

        @Test()
        attachments__follow_the_instruction() is
            let instruction = INSTRUCTION(Operation.RETURN(null), null)

            instruction.attach("dbg", Metadata.NODE(4))
            instruction.attach("ghul.note", Metadata.NODE(5))

            are_equal("ret void, !dbg !4, !ghul.note !5", WRITER.instruction_text(instruction))
        si

        @Test()
        is_terminator__holds_for_the_terminators_only() is
            is_true(INSTRUCTION(Operation.RETURN(null), null).is_terminator)
            is_true(INSTRUCTION(Operation.UNREACHABLE, null).is_terminator)
            is_true(INSTRUCTION(Operation.RESUME(_a), null).is_terminator)
            is_false(INSTRUCTION(Operation.STORE(_a, _p, 0, false), null).is_terminator)
            is_false(INSTRUCTION(Operation.LANDING_PAD("r", Types.i32, true, []), null).is_terminator)
        si

        _arguments(values: ARRAY[Value]) -> ARRAY[(value: Value, attributes: ARRAY[Attribute])] is
            let result = Collections.LIST[(value: Value, attributes: ARRAY[Attribute])]()

            for value in values do
                result.add((value = value, attributes = []))
            od

            return result.to_array()
        si
    si
si
