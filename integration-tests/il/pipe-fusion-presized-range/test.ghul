@@suppress("deprecated")

namespace Test is
    use Ghul.Pipes;

    // Pins that a collect over a range is sized up front too: the extent
    // is `to - from`, clamped at zero because a range whose end precedes
    // its start yields nothing, and the result is allocated at it and
    // filled by index. The range types resolve only as reflected
    // ghul-runtime types, so this also pins that recognising one still
    // works where they are reflected - which is every compilation except
    // the runtime's own.
    class FUSION is
        doubled(from: int, to: int) -> int[] is
            @IL.output("il.out")
            return (from..to) |> map(n => n * 2) |> collect();
        si
    si
si
