use IO.Std.write_line;

test_narrowing_binding(o: object) -> bool is
    @IL.output("il.out")
    if let flag: bool = o then
        return flag;
    fi

    return false;
si

test_optional_cast(o: object) -> int? is
    @IL.output("il.out")
    let i = cast int?(o);

    return i;
si

test_isa(o: object) -> bool is
    @IL.output("il.out")
    let result = isa int?(o);

    return result;
si
