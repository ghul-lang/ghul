namespace Test is
    use Ghul.Pipes

    // A fused consumer over an array or an int range calls no dispose:
    // their iterators hold nothing. Over any other source it disposes the
    // iterator it took, as the runtime terminal does.
    class FUSED is
        over_array(xs: ARRAY[int]) -> bool is
            @IL.output("il.out")
            return xs |> any(x => x > 2)
        si

        over_range() -> bool is
            @IL.output("il.out")
            return 0..10 |> any(x => x > 2)
        si

        over_source(xs: Collections.Iterable[int]) -> bool is
            @IL.output("il.out")
            return xs |> any(x => x > 2)
        si
    si
si
