// Which carrier each emitted signature names: `Nullable<T>` for an optional
// of a value type, `MAYBE<T>` for an optional of an unconstrained type
// parameter, and both together where a signature mixes them.

namespace Test is
    struct POINT is
        x: int;
        init() is si
    si

    class Carriers[T] abstract is
        value_field: int? field;
        parameter_field: T? field;
        struct_field: POINT? field;

        mixed(x: T?, y: int?) -> T?;
        mixed_generic[U](x: U?, y: T?, z: double?) -> U?;
        tuple(t: (T?, int?)) -> (int?, T?);
        function(f: (T?) -> int?) -> (int?) -> T?;
        nested(x: T?) -> Collections.LIST[T?];
        value_list(x: Collections.LIST[int?]) -> Collections.LIST[int?];
    si
si
