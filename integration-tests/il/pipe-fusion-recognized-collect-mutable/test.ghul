@@suppress("deprecated")

namespace Test is
    use Collections;
    use Ghul.Pipes;

    // Pins that collect_mutable is recognised as a fusible consumer: the
    // fused chain drives the source's own enumerator and adds to a fresh
    // LIST inline, calling no Ghul.Pipes combinator.
    class FUSION is
        doubled(xs: LIST[int]) -> LIST[int] is
            @IL.output("il.out")
            return xs |> map(n => n * 2) |> collect_mutable();
        si
    si
si
