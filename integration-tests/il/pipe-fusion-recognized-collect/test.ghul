@@suppress("deprecated")

namespace Test is
    use Collections;
    use Ghul.Pipes;

    // Pins that collect is recognised as a fusible consumer: the fused
    // chain drives the source's own enumerator and adds to a fresh LIST
    // inline exactly as collect_mutable does, then hands back that
    // list's array, calling no Ghul.Pipes combinator.
    class FUSION is
        doubled(xs: LIST[int]) -> int[] is
            @IL.output("il.out")
            return xs |> map(n => n * 2) |> collect();
        si
    si
si
