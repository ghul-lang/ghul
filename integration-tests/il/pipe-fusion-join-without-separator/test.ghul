namespace Test is
    use Collections;
    use Ghul.Pipes;

    // Pins that a join naming no separator fuses: the statement reads the
    // runtime's own JOIN_SEPARATOR and calls no Ghul.Pipes combinator.
    class JOIN is
        text(xs: LIST[int]) -> string is
            @IL.output("il.out")
            return xs |> filter(n => n % 2 == 0) |> join();
        si
    si
si
