namespace Test is
    use Ghul.Pipes;

    // Pins that an innermost reverse over a range reads it backwards
    // through Ghul.Internal.REVERSE_ITERATORS rather than collecting it.
    // The runtime's Ghul.Internal is declined when an imported name is
    // resolved, so this also pins that the compiler still reaches the
    // reflected class.
    class FUSION is
        total(from: int, to: int) -> int is
            @IL.output("il.out")
            return (from..to) |> reverse() |> map(n => n * 2) |> sum();
        si
    si
si
