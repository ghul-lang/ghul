namespace Test is
    // Pins the two ways a list comprehension fills its result. With one
    // source of known length and no filter, the array is allocated at the
    // source's count and each element stored by index. With a filter, the
    // elements go into a list that becomes the array at the end.
    class MAIN is
        init() is si

        doubled(xs: ARRAY[int]) -> int[] is
            @IL.output("il.out")
            return [x * 2 for x in xs]
        si

        evens(xs: ARRAY[int]) -> int[] is
            @IL.output("il.out")
            return [x for x in xs if x % 2 == 0]
        si
    si
si
