namespace Test is
    use Collections
    use Ghul.Pipes

    // Pins that a chain ending in `LIST(...)` fuses as `collect_mutable`
    // does: the fused chain drives the source's own enumerator and adds
    // to a fresh list inline, calling no Ghul.Pipes combinator and not
    // the list's constructor from a sequence.
    class FUSION is
        doubled(xs: LIST[int]) -> LIST[int] is
            @IL.output("il.out")
            return LIST(xs |> map(n => n * 2))
        si
    si
si
