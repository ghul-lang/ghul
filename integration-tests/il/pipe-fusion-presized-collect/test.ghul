@@suppress("deprecated")

namespace Test is
    use Collections;
    use Ghul.Pipes;

    // Pins that a collect over an array through a map stage is sized up
    // front: the array's own count is read once, the result is allocated
    // at it, and each element is stored by index - no list is filled and
    // no copy is made.
    class FUSION is
        doubled(xs: ARRAY[int]) -> int[] is
            @IL.output("il.out")
            return xs |> map(n => n * 2) |> collect();
        si
    si
si
