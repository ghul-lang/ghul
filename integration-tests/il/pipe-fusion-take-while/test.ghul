namespace Test is
    use Collections;
    use Ghul;
    use Ghul.Pipes;

    // Pins that a chain carrying a take_while still lowers to its
    // generated generator: the statement constructs it and calls no
    // Ghul.Pipes combinator. The chain produces the same answer either
    // way, so only the emitted code shows whether the lowering fired.
    class TAKEWHILE is
        is_odd(n: int) -> bool => n % 2 == 1

        taken(xs: LIST[int]) -> int{} is
            @IL.output("il.out")
            return xs |> filter(is_odd) |> take_while(n => n < 10);
        si
    si
si
