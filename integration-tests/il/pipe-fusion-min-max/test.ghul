namespace Test is
    use Collections;
    use Ghul;
    use Ghul.Pipes;

    // Pins that a min over a chain with a named filter runs in the fused
    // consumer loop: the statement calls no Ghul.Pipes combinator and no
    // MAYBE-wrapping library min. The chain produces the same answer
    // either way, so only the emitted code shows whether fusion fired.
    class MINMAX is
        is_odd(n: int) -> bool => n % 2 == 1

        least(xs: LIST[int]) -> int? is
            @IL.output("il.out")
            return xs |> filter(is_odd) |> min();
        si
    si
si
