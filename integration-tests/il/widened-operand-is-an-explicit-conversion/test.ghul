// A widened operand is converted as an explicit conversion converts it: each
// pair of statements below emits the same instructions.
namespace Test is
    class Main is
        entry() static is
            let n = 3
            let big = 3_000_000_000L

            @IL.output("il.out")
            let widened = n * 0.5

            @IL.output("il.out")
            let explicit = double(n) * 0.5

            @IL.output("il.out")
            let widened_long = n + big

            @IL.output("il.out")
            let explicit_long = long(n) + big

            IO.Std.write_line("{widened} {explicit} {widened_long} {explicit_long}")
        si
    si
si
