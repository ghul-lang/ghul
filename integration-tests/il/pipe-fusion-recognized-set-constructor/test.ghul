namespace Test is
    use Collections
    use Ghul.Pipes

    // Pins that a chain ending in `SET(...)` fuses as `collect_set` does:
    // the fused chain drives the source's own enumerator and adds to a
    // fresh set inline, calling no Ghul.Pipes combinator and not the
    // set's constructor from a sequence.
    class FUSION is
        residues(xs: LIST[int]) -> SET[int] is
            @IL.output("il.out")
            return xs |> map(n => n % 3) |> SET()
        si
    si
si
