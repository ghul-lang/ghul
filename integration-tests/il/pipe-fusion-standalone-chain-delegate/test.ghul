namespace Test is
    use Collections;
    use Ghul.Pipes;

    // Pins that a standalone chain whose filter is a named function
    // still lowers to a generated generator: the statement that returns
    // the chain constructs the generator and calls no Ghul.Pipes
    // combinator. The chain produces the same answer either way, so
    // only the emitted code shows whether the lowering fired.
    class STANDALONE is
        is_odd(n: int) -> bool => n % 2 == 1

        odds(xs: LIST[int]) -> int{} is
            @IL.output("il.out")
            return xs |> filter(is_odd) |> take(3);
        si
    si
si
