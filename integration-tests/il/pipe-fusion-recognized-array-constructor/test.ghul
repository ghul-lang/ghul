namespace Test is
    use Collections
    use Ghul.Pipes

    // Pins that a chain ending in `ARRAY(...)` fuses as `collect` does:
    // the fused chain drives the source's own enumerator and fills the
    // array inline, calling no Ghul.Pipes combinator and no constructor
    // from a sequence.
    class FUSION is
        doubled(xs: LIST[int]) -> ARRAY[int] is
            @IL.output("il.out")
            return xs |> map(n => n * 2) |> ARRAY()
        si
    si
si
