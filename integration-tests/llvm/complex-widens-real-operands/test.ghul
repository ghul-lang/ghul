// A real operand of any of int, long, single and double widens to complex,
// through the core's marked widenings, to reach complex's marked operators,
// on either side. A parameter that only a complex operator decides is
// inferred as complex.
namespace Test is
    show(z: complex) -> string => "{int(z.real * 10.0)} {int(z.imaginary * 10.0)}"

    entry() is
        let c = complex(3.0, 4.0)

        IO.Std.write_line(show(c * 2))
        IO.Std.write_line(show(2 * c))
        IO.Std.write_line(show(c + 1.5))
        IO.Std.write_line(show(c * 2L))
        IO.Std.write_line(show(c * 0.5s))

        let times_c = y => c * y
        IO.Std.write_line(show(times_c(complex(1.0, 1.0))))
    si
si
