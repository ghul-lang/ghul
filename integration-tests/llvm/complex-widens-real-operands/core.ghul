namespace Ghul.Intrinsics.Staging is
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @widen_operands() @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.neg") -(a: long) -> long pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @widen_operands() @intrinsic("arithmetic.div") /(a: long, b: long) -> long pure
    @widen_operands() @intrinsic("arithmetic.rem") %(a: long, b: long) -> long pure
    @widen_operands() @intrinsic("compare.order") <>(a: long, b: long) -> int pure
    @widen_operands() @intrinsic("arithmetic.mul") *(a: long, b: long) -> long pure
    @widen_operands() @intrinsic("arithmetic.add") +(a: long, b: long) -> long pure
    @intrinsic("arithmetic.add") +(a: double, b: double) -> double pure
    @intrinsic("arithmetic.sub") -(a: double, b: double) -> double pure
    @intrinsic("arithmetic.mul") *(a: double, b: double) -> double pure
    @intrinsic("arithmetic.div") /(a: double, b: double) -> double pure
    @intrinsic("string.equals") =~(a: string?, b: string?) -> bool pure
    @intrinsic("string.concat") _string_concat(left: string?, right: string?) -> string pure
    @intrinsic("string.from_char") _string_from_char(unit: char) -> string pure
    @intrinsic("string.length") _string_length(text: string) -> int pure
    @intrinsic("object.type_name") _type_name(value: object) -> string pure
si

namespace Ghul.Internal is
    class WIDENINGS is
        @widening() int_to_long(value: int) -> long static pure => long(value)
        @widening() int_to_double(value: int) -> double static pure => double(value)
        @widening() int_to_complex(value: int) -> complex static pure => complex(value)
        @widening() long_to_complex(value: long) -> complex static pure => complex(value)
        @widening() single_to_complex(value: single) -> complex static pure => complex(value)
        @widening() double_to_complex(value: double) -> complex static pure => complex(value)

        // the widened forms: a real operand widened to reach complex's *
        // reaches these instead, and is multiplied part by part
        @widened_form() *(left: complex, right: double) -> complex static pure => complex(left.real * right, left.imaginary * right)
        @widened_form() *(left: double, right: complex) -> complex static pure => complex(left * right.real, left * right.imaginary)
    si
si

namespace Ghul is
    partial complex is
        real: double
        imaginary: double

        init(real: double, imaginary: double) is
            self.real = real
            self.imaginary = imaginary
        si

        init(value: double) is self.real = value; self.imaginary = 0.0; si
        init(value: single) is self.real = double(value); self.imaginary = 0.0; si
        init(value: int) is self.real = double(value); self.imaginary = 0.0; si
        init(value: long) is self.real = double(value); self.imaginary = 0.0; si

        @widen_operands()
        +(left: complex, right: complex) -> complex static pure =>
            complex(left.real + right.real, left.imaginary + right.imaginary)

        @widen_operands()
        *(left: complex, right: complex) -> complex static pure =>
            complex(
                left.real * right.real - left.imaginary * right.imaginary,
                left.real * right.imaginary + left.imaginary * right.real)
    si

    partial object is
        to_string() -> string => _type_name(self)
    si

    partial string is
        length: int => _string_length(self)
    si
si
namespace Ghul is
    /// Accumulates the text of an interpolated string, a piece at a time.
si
namespace Ghul is
    partial char is
        /// The string holding just this UTF-16 code unit.
        to_string() -> string => _string_from_char(self)
    si

    partial int is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial long is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string is
            if self == 0L then
                return "0"
            fi

            let text mut = ""
            let rest mut = self

            // The digits come out lowest first. A negative value's
            // remainders are negative too, so each is turned to its
            // magnitude rather than the value as a whole, which has no
            // positive counterpart at its minimum.
            while !(rest == 0L) do
                let digit mut = cast int(rest % 10L)

                if digit < 0 then
                    digit = -digit
                fi

                text = _string_concat(_string_from_char(cast char(48 + digit)), text)
                rest = rest / 10L
            od

            if self < 0L then
                text = _string_concat("-", text)
            fi

            return text
        si
    si
si
namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool;
        current: E;
        dispose();
    si

    trait Iterable[E: out] is
        iterator: Iterator[E];
    si
si

namespace IO is
    class Std is
        write_line(text: string) static is
            _write(text, 1)
            _write("\n", 1)
        si

        write_line(value: object) static =>
            write_line(value.to_string())

        @intrinsic("host.write")
        _write(text: string, stream: int) static
    si
si

namespace Text is
    class StringBuilder is
        _text: string?

        init() is si

        /// Appends `text` to the text built so far.
        ///
        /// - text: the text to append
        append(text: string) is
            _text = _string_concat(_text, text)
        si

        /// The text built so far.
        to_string() -> string => _string_concat(_text, "")
    si
si
