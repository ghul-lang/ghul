// Which in-place writes to a captured local end flow narrowing in the
// function that declares it. A mutable local a closure writes lives in a box
// the closure shares, so calling the closure can rewrite it: what was
// narrowed no longer holds. An immutable local is captured by value and is
// never boxed, so the closure's write is to its own copy and the narrowing
// stands, and a write made in the declaring function, outside the closure,
// is seen by ordinary flow analysis. The forms are a ref operand, the
// receiver of a method call and the root of a member assignment. Each
// function narrows `x`, calls the closure or writes in place, then uses it;
// a line in err.expected is a use that is no longer known to hold a value.
namespace Test is
    class THING is
        count: int field public

        init() is
            count = 0
        si

        touch() is
            count = count + 1
        si

        consume() is si
    si

    clear(slot: THING? ref) is
        slot! = null
    si

    // ref operand, mutable, in the closure: ends
    ref_mut_in_closure(source: THING?) is
        let x mut = source
        let c = () -> void => clear(x ref)

        if x? then
            c()

            x.consume()
        fi
    si

    // ref operand, immutable, in the closure: stands
    ref_immutable_in_closure(source: THING?) is
        let x = source
        let c = () -> void => clear(x ref)

        if x? then
            c()

            x.consume()
        fi
    si

    // receiver, mutable, in the closure: ends
    receiver_mut_in_closure(source: THING?) is
        let x mut = source

        let c = () is
            if x? then
                x.touch()
            fi
        si

        if x? then
            c()

            x.consume()
        fi
    si

    // receiver, mutable, outside the closure: stands
    receiver_mut_outside(source: THING?) is
        let x mut = source
        let c = () -> bool => x?

        if x? then
            x.touch()

            x.consume()
        fi
    si

    // receiver, immutable, in the closure: stands
    receiver_immutable_in_closure(source: THING?) is
        let x = source

        let c = () is
            if x? then
                x.touch()
            fi
        si

        if x? then
            c()

            x.consume()
        fi
    si

    // member assignment root, mutable, in the closure: ends
    member_mut_in_closure(source: THING?) is
        let x mut = source

        let c = () is
            if x? then
                x.count = 1
            fi
        si

        if x? then
            c()

            x.consume()
        fi
    si

    // member assignment root, mutable, outside the closure: stands
    member_mut_outside(source: THING?) is
        let x mut = source
        let c = () -> bool => x?

        if x? then
            x.count = 1

            x.consume()
        fi
    si

    // member assignment root, immutable, in the closure: stands
    member_immutable_in_closure(source: THING?) is
        let x = source

        let c = () is
            if x? then
                x.count = 1
            fi
        si

        if x? then
            c()

            x.consume()
        fi
    si
si
