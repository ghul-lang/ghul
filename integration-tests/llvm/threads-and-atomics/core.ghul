// The operators the program uses, declared as the core library declares
// them, and the thread and atomic operations, declared as the runtime's
// thread types reach them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
si

namespace Test is
    @intrinsic("host.thread_start")
    thread_start(action: () -> void, stack_size: long) -> object?

    @intrinsic("host.thread_join")
    thread_join(thread: object)

    @intrinsic("host.sleep")
    sleep(milliseconds: int)

    @intrinsic("atomic.load")
    atomic_load[T](location: T ref) -> T

    @intrinsic("atomic.store")
    atomic_store[T](location: T ref, value: T)

    @intrinsic("atomic.add")
    atomic_add[T](location: T ref, value: T) -> T

    @intrinsic("atomic.exchange")
    atomic_exchange[T](location: T ref, value: T) -> T

    @intrinsic("atomic.compare_exchange")
    atomic_compare_exchange[T](location: T ref, expected: T, replacement: T) -> bool
si
