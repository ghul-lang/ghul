namespace Test is
    // Tests: what extern cannot be written on for an llvm build. A string
    // answer needs the declaration to say who owns it, a type that is not a
    // scalar or a string cannot cross, and LLVM keeps the names beginning
    // llvm. for itself.

    @extern("libc", "x")
    returns_a_string() -> string;

    @extern("libc", "x", result = "copy")
    returns_a_list() -> ARRAY[int];

    @extern("libc", "x")
    takes_a_list(values: ARRAY[int]) -> int;

    @extern("libc", "x")
    takes_a_ref(value: int ref) -> int;

    @extern("libc", "x")
    takes_a_tuple(value: (int, int)) -> int;

    @extern("libc", "llvm.memcpy")
    reserved() -> int;

    @extern("libc", "x", result = "copy")
    copies_an_int() -> int;

    @extern("libc", "x", free = "release")
    frees_without_taking() -> string?;

    @extern("libc", "x")
    takes_a_tuple_ref(value: (int, int) ref) -> int;

    @extern("libc", "v", variadic = 1)
    variadic_once(first: int, rest: int) -> int;

    @extern("libc", "v", variadic = 2)
    variadic_again(first: int, second: int) -> int;

    @extern("libc", "x", variadic = 3)
    too_few_fixed(first: int) -> int;

    entry() is si
si
