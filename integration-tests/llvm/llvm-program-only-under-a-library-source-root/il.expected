define internal i32 @entry() {
entry:
  %t0 = alloca i32
  store i32 0, ptr %t0
  %t1 = alloca i32
  store i32 0, ptr %t1
  br label %b0

b0:
  store i32 3, ptr %t0
  %t2 = load i32, ptr %t0
  %t3 = load i32, ptr %t0
  %t4 = call i32 @Library.twice(i32 %t3)
  %t5 = mul i32 %t2, %t4
  store i32 %t5, ptr %t1
  %t6 = load i32, ptr %t1
  %t7 = add i32 %t6, 1
  ret i32 %t7

b1:
  ret i32 0
}
