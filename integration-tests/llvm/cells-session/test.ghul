// The session's own entry, as a host writes it: each cell's statements
// run in order, and the newest cell's final value is the exit status.
namespace Session is
    entry() -> int is
        let args: ARRAY[string] = []
        let environment = Ghul.ENVIRONMENT.instance

        cell1.entry(args, environment)
        cell2.entry(args, environment)

        if let value: int = cell3.entry(args, environment) then
            return value
        fi

        return 0
    si
si
