// The core library declarations the llvm integration tests share: the
// built-in operators they use, each lowered to its operation, and the
// console, through the native runtime's host operations.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("arithmetic.div") /(a: int, b: int) -> int pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("arithmetic.add") +(a: byte, b: byte) -> byte pure
    @intrinsic("arithmetic.shl") <<(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool
    @intrinsic("compare.value") !=[T](a: T, b: T) -> bool
si

namespace IO is
    class Std is
        write_line(text: string) static is
            _write(text, 1)
            _write("\n", 1)
        si

        read_line() -> string? static => _read_line()

        @intrinsic("host.write")
        _write(text: string, stream: int) static

        @intrinsic("host.stdin_read_line")
        _read_line() -> string? static
    si
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count

        @intrinsic("array.get")
        [index: int]: E => self[index]
    si

    @intrinsic("array.new")
    _array_new[E](count: int) -> ARRAY[E] pure

    @intrinsic("array.set")
    _array_set[E](array: ARRAY[E], index: int, value: E)
si
