@@suppress("non-upper-snake-case-name")

// The operators the program uses, an array's element access, the exception
// an index out of range throws, and MethodImpl, declared as the core
// library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count

        @intrinsic("array.get")
        [index: int]: E => self[index]
    si

    class Type is
        init(name: string) is si
    si

    class Exception is
        message: string

        init(message: string) is
            self.message = message
        si
    si

    class IndexOutOfRangeException: Exception is
        init() is super.init("index out of range") si
    si
si

namespace System.Runtime.CompilerServices is
    enum MethodImplOptions is
        NO_INLINING = 8,
        AGGRESSIVE_INLINING = 256
    si

    class MethodImplAttribute is
        value: MethodImplOptions

        init(options: MethodImplOptions) is
            value = options
        si
    si
si
