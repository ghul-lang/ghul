// The llvm module's text form with only the program's own functions. An
// index out of range is thrown by one call to a function the module holds
// for that exception, so each check adds a call rather than an allocation
// and a constructor. MethodImpl's AGGRESSIVE_INLINING and NO_INLINING carry
// over as alwaysinline and noinline.
namespace Test is
    use System.Runtime.CompilerServices.MethodImpl
    use System.Runtime.CompilerServices.MethodImplOptions

    first(values: ARRAY[int]) -> int => values[0]

    @MethodImpl(MethodImplOptions.AGGRESSIVE_INLINING)
    second(values: ARRAY[int]) -> int => values[1]

    @MethodImpl(MethodImplOptions.NO_INLINING)
    both(values: ARRAY[int]) -> int => first(values) + second(values)

    entry() is
        both([1, 2])
    si
si
