// A thread that recurses until its stack runs out ends the process with
// the signal, after what was written before it is flushed. How many frames
// the report holds depends on the code generated for `deep`, so its text is
// not compared here.
use default
use Ghul.Threads

deep(n: int) -> int => deep(n + 1) + 1

write_line("before")
IO.Std.out.flush()

let worker = start(() => deep(0), 256 * 1024)
write_line("joined {worker.join()}")
