use IO.Std.write_line

// Arrays of scalars, of narrow scalars, of strings and of arrays, built
// from literals and through the core library's allocation, read back
// element by element. The last read is out of range, so the program ends
// as an unhandled exception does.
entry() -> int is
    let numbers = [3, 4, 5]
    let bytes: ARRAY[ubyte] = [253ub, 100ub]
    let words = ["alpha", "beta"]
    let grid = [[1, 2], [3, 4, 5]]
    let made = Ghul._array_new[int](3)

    Ghul._array_set(made, 2, 40)

    let total mut = 0
    let i mut = 0

    while i < numbers.count do
        total = total + numbers[i]
        i = i + 1
    od

    write_line(words[1])

    if total != 12 then return 1 fi
    if cast int(bytes[0]) != 253 then return 2 fi
    if grid[1][2] != 5 then return 3 fi
    if grid.count != 2 then return 4 fi
    if made[2] != 40 then return 5 fi
    if made[0] != 0 then return 6 fi

    write_line("read")

    return grid[2][0]
si
