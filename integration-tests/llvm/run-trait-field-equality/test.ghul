// A struct field typed as a generic class or trait instantiation that
// declares no =~ - int{} among them - compares by reference, as the
// runtime's comparer does on .NET, rather than being reported as having
// nothing to compare it. The exit status is the number of the first check
// that fails, or 0.
namespace Test is
    trait SHAPE[T] is
        sides: T
    si

    class SQUARE: SHAPE[int] is
        sides: int => 4
        init() is si
    si

    class BOX[T] is
        init() is si
    si

    struct HOLDER(shape: SHAPE[int] public, box: BOX[int] public, items: Collections.Iterable[int] public)

    entry() -> int is
        let square = SQUARE()
        let box = BOX[int]()
        let items = [1, 2, 3]

        let checks = [
            HOLDER(square, box, items) =~ HOLDER(square, box, items),
            !(HOLDER(square, box, items) =~ HOLDER(SQUARE(), box, items)),
            !(HOLDER(square, box, items) =~ HOLDER(square, BOX[int](), items)),
            !(HOLDER(square, box, items) =~ HOLDER(square, box, [1, 2, 3]))
        ]

        let i mut = 0

        while i < checks.count do
            if !checks[i] then
                return i + 1
            fi

            i = i + 1
        od

        return 0
    si
si
