// A mixed int and long operation converts the int operand to long first,
// on either side, so a product past the int range is exact. Where an
// operand is still unsettled, the weak mixed overload yields to the
// same-kind one: `y * 2L` settles `y` as long. An ordering between an int
// and a long compares in long.
namespace Test is
    entry() is
        let big = 3_000_000_000L
        let n = 3

        IO.Std.write_line(big * n)
        IO.Std.write_line(n * big)
        IO.Std.write_line(n + big)

        let doubled = y => y * 2L
        IO.Std.write_line(doubled(4_000_000_000L))

        IO.Std.write_line(n <> big)
        IO.Std.write_line(big <> n)
    si
si
