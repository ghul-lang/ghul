// The core here declares Iterator with no implementation written in
// source, so only generators implement it. A call to move_next through
// Iterator runs the generator's body, which clears the narrowed field,
// so the narrowing must end at the call.
namespace Test is
    use Collections.Iterable
    use Collections.Iterator

    class CAT is
        init() is si
        purr() -> int => 7
    si

    class CARRIER is
        occupant: CAT? public;
        init(occupant: CAT?) is self.occupant = occupant si
    si

    clears(carrier: CARRIER) -> Iterable[int] is
        carrier.occupant = null
        yield 1
    si

    describe(carrier: CARRIER, it: Iterator[int]) -> int is
        if carrier.occupant? then
            it.move_next()
            return carrier.occupant.purr()
        fi
        return 0
    si

    entry() -> int is
        let carrier = CARRIER(CAT())
        return describe(carrier, clears(carrier).iterator)
    si
si
