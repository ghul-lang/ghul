// An atomic operation on a type LLVM's atomicrmw or cmpxchg does not take
// is reported, rather than written into a module that does not verify.
namespace Test is
    class BOX is
        number: double field
        flag: bool field
        init() is si
    si

    entry() -> int is
        let box = BOX()

        atomic_add(box.number ref, 1.0)
        atomic_add(box.flag ref, true)
        atomic_exchange(box.number ref, 2.0)
        atomic_compare_exchange(box.number ref, 0.0, 1.0)

        return 0
    si
si
