use default
use Ghul.Pipes

// The first call is correct and resolves; the second passes a
// two-parameter literal where a one-parameter function is wanted.
// Only the second is reported.

plain[T, U](source: Collections.Iterable[T], f: T -> U) -> U{} => source |> map(f)

let pairs = [(1, 2), (3, 4)]

write_line("{pairs |> plain(((a, b)) => a + b)}")
write_line("{pairs |> plain((a, b) => a + b)}")
