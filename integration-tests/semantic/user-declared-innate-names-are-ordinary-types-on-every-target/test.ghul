// A program cannot supply the task type: the core library declares
// Concurrency.Future, which Tasks.TASK also names, so a program declaring its own
// TASK in the same namespace redefines it, which is an error.
namespace Tasks is
    class TASK is
        init() is si

        describe() -> string => "a program's own TASK"
    si
si

namespace Test is
    use IO.Std.write_line

    entry() is
        write_line(Tasks.TASK().describe())
    si
si
