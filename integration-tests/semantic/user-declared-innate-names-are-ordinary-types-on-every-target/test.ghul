// A program's own Tasks.TASK is an ordinary type: the core library declares
// the task type as Concurrency.Future, and nothing else names it.
namespace Tasks is
    class TASK is
        init() is si

        describe() -> string => "a program's own TASK"
    si
si

namespace Test is
    use IO.Std.write_line

    entry() is
        write_line(Tasks.TASK().describe())
    si
si
