use Ghul.Pipes

use IO.File
use IO.Directory

first_long_line(path: string) -> string? is
    for line in File.read_lines(path) do
        if line.length > 10 then
            return line
        fi
    od

    return null
si

has_blank(path: string) -> bool is
    let found mut = false

    outer: for line in File.read_lines(path) do
        for c in line do
            if c == 'x' then
                break outer
            fi
        od

        if line.length == 0 then
            found = true
            break
        fi
    od

    return found
si

early_exit_terminals(path: string) is
    let a = File.read_lines(path) |> first()
    let b = first(Directory.enumerate_files("."))
    let c = File.read_lines(path) |> map(line => line.length) |> filter(n => n > 0) |> any(n => n > 5)
    let d = File.read_lines(path) |> take(2) |> map(line => line.trim()) |> collect()
    let e = Directory.enumerate_directories(".") |> find(name => name.length > 3)
    let f = Directory.enumerate_file_system_entries(".") |> only()
si

reads_to_the_end(path: string) is
    for line in File.read_lines(path) do
        for c in line do
            if c == 'x' then
                break
            fi
        od
    od

    let a = File.read_lines(path) |> map(line => line.length) |> collect()
    let b = File.read_lines(path) |> sort() |> take(3) |> collect()
    let c = [line for line in File.read_lines(path)]
    let d = File.read_lines(path) |> count()

    let held = File.read_lines(path)

    for line in held do
        break
    od
si
