// On a wasm build the dotnet declaration is dropped whole, so the error in
// it is never reported, and the wasm one is kept, so its error is. The
// code generation error follows, because the wasm target has no backend.
entry() is
    IO.Std.write_line(report())
si

@IF.dotnet()
report() -> string => a_function_this_target_does_not_have()

@IF.wasm()
report() -> string => another_function_this_target_does_not_have()
