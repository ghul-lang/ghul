// A parameter typed only by being called, in a function nothing calls,
// has a type nothing settles. It is reported once, at the parameter,
// rather than reaching the end of compilation half-inferred.

class RGB(red: int, green: int)

run(a: RGB) -> int is
    mix(pick) -> int => pick(a)

    return 0
si

run_literal(a: RGB) -> string is
    let describe = pick => "{pick(a)}"

    return "none"
si
