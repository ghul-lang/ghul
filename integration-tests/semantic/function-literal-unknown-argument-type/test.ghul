// A function literal whose argument names a type that does not exist
// reports the missing name, rather than stopping the front end with an
// exception.
namespace Test is
    apply(f: (int) -> int) -> int => f(1);

    entry() is
        let a = apply((t: NOPE) -> int => 2);
        let b = apply((t: Nope.THING) -> int => 3);
    si
si
