use default

counting(limit: int) -> int{} is
    let i mut = 0;
    while i < limit do
        yield i;
        i = i + 1;
    od
si

// A while let re-reads its scrutinee every test, so a lazy sequence
// pattern there would never see the sequence advance.
while_let_lazy() is
    while let [x, ..rest] = counting(3) do
        write_line("{x} {rest |> count()}");
    od
si

// A guard runs after the pull; a failing one falls through to the next
// arm, which cannot see the elements the pull already took.
guarded_arm() -> string =>
    case counting(3)
    when [x, ..rest] /\ x > 1 then "big"
    else "small"
    esac

// A group nested inside a case pattern is not hoisted to the case's
// pull yet.
nested_in_case() -> string =>
    case (counting(2), 1)
    when ([x, ..rest], 1) then "seq"
    else "no"
    esac

// An assignment has no arm to share a pull with; the destructuring
// assignment is not built for a lazy source.
assign_lazy() is
    let a mut = 0;
    let b mut = 0;
    [a, b] = counting(2);
    write_line("{a} {b}");
si

// A generator body's locals do not survive a suspend, so a pull's
// locals cannot be hoisted there.
gen_head(xs: int{}) -> int{} is
    case xs
    when [] then
    when [h, ..t] then
        yield h;
    esac
si

entry() is
    write_line("unreachable");
si
