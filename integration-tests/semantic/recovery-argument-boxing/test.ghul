// A call whose argument an earlier error left without a type is reported
// rather than crashing the compiler.

use IO.Std.write_line
use Ghul.Pipes

entry() is
    let rows = [[2, 3], [5]]

    for (n, primes) in rows |> undefined_stage() do
        write_line(primes |> map(p => "{p}") |> join(" "))
    od
si
