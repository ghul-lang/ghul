namespace Test is
    use IO.Std.write_line

    class Cat is
        init() is si
    si

    class C is
        init() is si

        typed_by_group((a, b): (int, int)) -> int => a + b
        typed_by_leaves((a: int, b: int)) -> int => a + b
        typed_mixed(((a, b): (int, int), c: int)) -> int => a + b + c

        one_untyped((a: int, b)) -> int => a
        all_untyped((a, b)) -> int => 0
        nested_untyped(((a, b), c: int)) -> int => c
    si

    typed_twice(s: object) is
        if let ((a, b): (Cat, Cat), (c, d)): ((Cat, Cat), (Cat, Cat)) = s then
            write_line("matched")
        fi

        if let (x: int, y): (int, int) = s then
            write_line("matched")
        fi
    si

    impossible(s: (int, string)) is
        if let (x: double, y) = s then
            write_line("matched")
        fi
    si

    mismatch() is
        let (a, b): (string, int) = (1, 2)
    si
si
