use default

scale(x: int, by: int) -> int => x * by

find(id: int) -> int? => if id > 0 then id else null fi

// `*` where there is no call to take it as an argument
let pair = (*, 1)

// an overloaded callee gives a lone `*` no type to take
let say = write_line(*)

// `~>` and `*` do not combine
let scaled = find(1) ~> scale(*, 2)

// an argument that does not fit is reported as in any call
let wrong = scale(*, "two")

// `*` is not an operator operand
let doubled = scale(* + 1, 2)
