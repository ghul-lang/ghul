// A marked leaf in a `case` arm runs the test a written `=~` would, so a
// narrowing ends at a call whose leaf reaches a `=~` that stores.
// The operator is rejected for storing as well, but the narrowing
// still ends at the call, as it does at a written `=~`: an operator
// imported from another assembly is not checked by that rule.
class HOLDER is
    name: string? public;
    init() is name = "x"; si
si

class TAG(n: int public, holder: HOLDER public);

=~(tag: TAG, other: TAG) -> bool is
    tag.holder.name = null;
    return tag.n == other.n;
si

classify(tag: TAG, other: TAG) -> int =>
    case (tag, 1)
    when (~other, _) then 1
    else 2
    esac

length_after(holder: HOLDER) -> int is
    if holder.name? then
        classify(TAG(1, holder), TAG(1, holder));

        return holder.name.length;
    fi

    return 0;
si

entry() is si
