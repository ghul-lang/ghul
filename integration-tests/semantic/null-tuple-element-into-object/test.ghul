class HOLDER is
    held: object public

    init() is held = 1 si
si

take(o: object) is si

give() -> object => ("x", null)

// A tuple literal with a null element can be given no type by a context that
// expects something other than a tuple, so the null is reported rather than
// reaching code generation with no type.
entry() is
    let o: object = ("x", null)

    let h = HOLDER()
    h.held = ("x", null)

    take(("x", null))
si
