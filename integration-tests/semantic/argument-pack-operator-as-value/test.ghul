namespace Test is
    use Ghul.Functional.`>>;

    // Tests: the composition operator referenced as a value with no
    // expected function type to infer its type arguments from reports
    // rather than guessing.

    inc(n: int) -> int => n + 1;
    show(n: int) -> string => "{n}";

    entry() is
        let c = `>>;
        c(inc, show);
    si
si
