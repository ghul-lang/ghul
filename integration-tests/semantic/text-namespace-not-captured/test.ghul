namespace Test is
    // The Text namespace holds the text family under its own names: the
    // types left in System.Text, such as the concrete encodings, are
    // reached as they always were, and System.Text.RegularExpressions is
    // not a namespace under Text.
    entry() is
        let builder = Text.STRING_BUILDER()
        let encoding = System.Text.Encoding.utf8
        let bytes = encoding.get_bytes("{builder}")
        let options = System.Text.RegularExpressions.RegexOptions.NONE

        let not_moved = Text.UTF8Encoding(false)
        let not_moved_either = Text.RegularExpressions.RegexOptions.NONE
    si
si
