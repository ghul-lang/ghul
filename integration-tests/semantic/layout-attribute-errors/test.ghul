use System.Runtime.InteropServices.LayoutKind

// An explicit layout places every instance field, so one left without
// a FieldOffset is reported, by its member name.
@System.Runtime.InteropServices.StructLayout(LayoutKind.EXPLICIT)
struct MISSING_OFFSETS is
    @System.Runtime.InteropServices.FieldOffset(0)
    placed: int field

    unplaced: int field
    property: int

    init() is si
si

// A layout is a type's, and a trait has no fields to lay out.
@System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL)
trait Laid is
si

// An offset places a field, and a property is not one.
struct OFFSET_ON_PROPERTY is
    @System.Runtime.InteropServices.FieldOffset(0)
    value: int

    init() is si
si

// An offset only places a field in a type laid out explicitly, whether
// the type says nothing about its layout or asks for another kind.
struct OFFSET_WITHOUT_LAYOUT is
    @System.Runtime.InteropServices.FieldOffset(0)
    value: int field

    init() is si
si

@System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL)
struct OFFSET_IN_SEQUENTIAL is
    @System.Runtime.InteropServices.FieldOffset(4)
    value: int field

    init() is si
si
