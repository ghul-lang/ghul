// Tests: what layout "c" refuses. A struct that holds a field C has no
// same-sized equivalent for, a generic struct, layout on a class, a layout
// other than "c", and a reference to a struct without layout "c" passed to
// foreign code.

@layout("c")
struct HOLDS_NOT_C is
    flag: bool field public;
    letter: char field public;
    text: string field public;
    maybe: int? field public;
    fine: int field public;
si

@layout("c")
struct GENERIC[T] is
    value: T field public;
si

@layout("c")
class NOT_A_STRUCT is
    value: int field public;
si

@layout("packed")
struct UNKNOWN_LAYOUT is
    value: int field public;
si

struct PLAIN is
    value: int field public;
si

@extern("libc", "x")
take_plain(p: PLAIN ref);
