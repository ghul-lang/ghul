// Tests: what layout "c" refuses. The pragma promises a layout, so what
// is refused is a use of it that promises nothing: layout on a class, and
// a layout other than "c". Nothing about the fields is checked.

@layout("c")
struct HOLDS_ANYTHING is
    flag: bool field public;
    letter: char field public;
    text: string field public;
    maybe: int? field public;
si

@layout("c")
struct GENERIC[T] is
    value: T field public;
si

@layout("c")
class NOT_A_STRUCT is
    value: int field public;
si

@layout("packed")
struct UNKNOWN_LAYOUT is
    value: int field public;
si
