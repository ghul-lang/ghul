use Ghul.Result

union Failure: Ghul.Error is
    DISK_FULL(device: string)
si

union AppError: Ghul.Error is
    STARTUP(reason: string)
si

read() -> Result[int, Failure] => Result.ERROR(Failure.DISK_FULL("sda"))

// the function returns the same union, but a Failure is not an AppError
start() -> Result[int, AppError] => Result.OK(read()! + 1)

// widening the declared error type is accepted
widened() -> Result[int, Ghul.Error] => Result.OK(read()! + 1)

// a function that does not return a Result throws instead
plain() -> int => read()!

// outside an argument
start_statement() -> Result[int, AppError] is
    let n = read()!
    return Result.OK(n)
si
