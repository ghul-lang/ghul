use Ghul.Pipes
use IO.Std.write_line

// Tests: a bare operator spelling needs an expected function type to
// find its type by, that type has to declare the operator, a derived
// comparison spelling is not a function, an instance operator has no
// value through its type, and an operator's type has to fit the slot.

class BOX(v: int public) is
    =~(other: BOX) -> bool => v == other.v
    get_hash_code() -> int => v
si

entry() is
    let unknown = `+
    let text: (string, string) -> string = `+
    let less: (int, int) -> bool = `<
    let differs: (int, int) -> bool = `!=
    let equal: (BOX, BOX) -> bool = BOX.`=~
    let predicate: (int, int) -> bool = int.`+
si
