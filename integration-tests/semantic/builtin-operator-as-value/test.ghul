use Ghul.Pipes
use IO.Std.write_line

// Tests: a bare operator spelling needs an expected function type to
// resolve against, an operator has to resolve for the slot's operand
// types, a derived comparison spelling is not a function, an instance
// operator has no value through its type or by its bare spelling, and
// an operator's type has to fit the slot.

class BOX(v: int public) is
    =~(other: BOX) -> bool => v == other.v
    get_hash_code() -> int => v
si

entry() is
    let unknown = `+
    let text: (string, string) -> string = `+
    let less: (int, int) -> bool = `<
    let differs: (int, int) -> bool = `!=
    let equal: (BOX, BOX) -> bool = BOX.`=~
    let bare_equal: (BOX, BOX) -> bool = `=~
    let predicate: (int, int) -> bool = int.`+
si
