// The runtime adds is_digit, to_upper and char's other classification and
// case members to char, so char's own statics of those names are not
// imported: only the runtime's members are found under them.
namespace Main is
    entry() is
        let digit = char.is_digit('5')
        let upper = char.to_upper('q')

        // A static the runtime doesn't replace is still found.
        let category = char.get_unicode_category('q')

        let member = '5'.is_digit /\ 'q'.to_upper() == 'Q'
    si
si
