// Where the runtime adds a replacement for one of char's own statics, the
// static is not imported, so only the replacement is found under its name.
namespace Ghul.Internal is
    partial char is
        is_digit: bool => self >= '0' /\ self <= '9'

        to_upper() -> char => if self >= 'a' /\ self <= 'z' then char(int(self) - 32) else self fi
    si
si

namespace Main is
    entry() is
        let digit = char.is_digit('5')
        let upper = char.to_upper('q')

        // A static the table doesn't hide is still found.
        let letter = char.is_letter('q')
    si
si
