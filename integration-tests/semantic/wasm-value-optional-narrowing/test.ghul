// Under the wasm target a presence test narrows a value-type optional to
// its payload, as it does on .NET, so a struct's Equals bridge reaches
// the struct's own =~. The one error below keeps the program short of
// code generation.
struct S is
    init() is si

    =~(other: S) -> bool pure => true
    get_hash_code() -> int => 0
si

payload(x: int?) -> int => if x? then x else 0 fi

unboxed(o: object?) -> S is
    let n = cast S?(o)

    if n? then
        let s: S = n
        return s
    fi

    return S()
si

entry() is
    let wrong: string = payload(1)
si
