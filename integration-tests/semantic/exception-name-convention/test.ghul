// A class with Exception among its ancestors, at any depth, is named in
// PascalCase whether or not it is abstract. Any other concrete class
// keeps UPPER_SNAKE_CASE.
use System.Exception

class ParseFailure(message: string): Exception is
    super(message)
si

class BAD_INPUT(message: string): Exception is
    super(message)
si

class TooDeep(message: string): BAD_INPUT is
    super(message)
si

class STILL_BAD(message: string): ParseFailure is
    super(message)
si

class Failure: Exception abstract is
    init() is super.init() si
si

class Ordinary is
    init() is si
si

entry() is si
