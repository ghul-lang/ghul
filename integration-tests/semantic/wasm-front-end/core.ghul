@@suppress("non-upper-snake-case-name")

// The WasmGC core library, minimal slice: an ordinary declaration, an
// intrinsic operator, a partial reopening of a constructed type.
namespace IO is
    namespace Std is
        write_line(text: string) is si
    si
si

namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
si

namespace Ghul is
    class Exception is
        message: string;
        init(message: string) is self.message = message; si
    si
si

namespace Ghul.Core is
    partial int is
        to_string() -> string => "an int";
    si

    // A generic family the compiler constructs, reopened with its own
    // type parameter in scope.
    partial ARRAY[E] is
        iterator: Collections.Iterator[E] => throw Exception("array.iterator");
    si
si

namespace Collections is
    trait Iterator[E] is
        move_next() -> bool;
        current: E;
    si
si
