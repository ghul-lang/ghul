// A top-level statement passing a function declared later in the file
// leaves the synthesised entry's effects inexact, so its body is walked
// again once the function's are known. The entry's location spans the
// whole file from its first statement to its last; the re-walk must keep
// the diagnostics of the functions declared between those statements.

use default

let numbers = [1, 2, 3]

double(x: int) -> int is
    nonexistent(x)
    x * 2
si

write_line(numbers |> map(double) |> sum())
