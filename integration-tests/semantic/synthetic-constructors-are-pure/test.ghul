use IO.Std.write_line
use Ghul.Pipes
use Collections

halve(f: (bigint) -> double pure, x: bigint) -> double => f(x)
scale(f: (decimal) -> int pure, x: decimal) -> int => f(x)
index(f: (int[]) -> Map[int, int] pure, xs: int[]) -> Map[int, int] => f(xs)

write_line("{halve(n => double(n) / 2.0, 7n)}")
write_line("{scale(d => int(d) * 2, 3.9m)}")
write_line("{index(xs => MAP(xs |> map(x => (x, x * x))), [1, 2, 3])[3]}")
