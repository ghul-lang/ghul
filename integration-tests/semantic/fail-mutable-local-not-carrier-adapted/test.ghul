// A mutable local is deliberately not adapted across optional carriers:
// the eta-expansion wrapper is a closure over the value it wraps, and a
// mutable local captured by value can no longer be assigned. The call is
// rejected rather than freezing the local as a side effect.
namespace Test is
    bind[T, U](value: T?, f: (T) -> U?) -> U? =>
        if value? then f(value) else null fi;

    halve(n: int) -> int? => if n % 2 == 0 then n / 2 else null fi;

    unit[T](value: T) -> T? => value;

    class Main is
        entry() static is
            let chooser mut = halve;
            let bound = bind(unit(8), chooser);
            chooser = (n: int) -> int? => n + 100;
        si
    si
si
