use IO.Std.write_line

class NOTED(name: string): Ghul.Disposable is
    count: int => name.length

    dispose() is
        write_line("dispose {name}")
    si
si

not_disposable() is
    let n = use 5
    let c = use NOTED("x").count
si

reassignable() is
    let use r mut = NOTED("y")
si

async_expression_body() -> Tasks.TASK[int] => (use NOTED("z")).count
