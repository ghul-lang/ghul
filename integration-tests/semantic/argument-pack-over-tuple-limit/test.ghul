namespace Test is
    use Ghul.Functional.apply;

    // Tests: eight arguments is past the tuple limit a pack binds to;
    // the call reports as an ordinary overload failure.

    s8(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int =>
        a + b + c + d + e + f + g + h;

    entry() is
        apply(s8, 1, 2, 3, 4, 5, 6, 7, 8);
    si
si
