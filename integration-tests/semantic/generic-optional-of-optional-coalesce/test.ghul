use Collections.Iterator

next[T](iter: Iterator[T]) -> T? =>
    if iter.move_next() then iter.current else null fi

lengths(words: string?[]) -> int? is
    let it = words.iterator
    let word = it |> next()

    // word is string?? here: ?. tests only the outer layer, so the
    // string it reads length from may be absent.
    let unchecked = word?.length

    // Unwrapping the outer layer first leaves a string? to test.
    return (word!)?.length
si
