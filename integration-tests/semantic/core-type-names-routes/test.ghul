namespace Test.Qualified is
    // A qualified name, in a declared type, a base class, a catch, a
    // cast, an isa, a type argument, typeof, and a pragma argument.

    class OLD_BASE: System.InvalidOperationException is
        init() is super.init("old base") si
    si

    class NEW_BASE: Ghul.InvalidOperationException is
        init() is super.init("new base") si
    si

    class OLD_MATH_HOLDER is
        init() is si

        @System.Diagnostics.DebuggerDisplay("old")
        message_of(e: System.Exception) -> string => e.message
    si

    old_routes(o: object) -> string is
        let declared: System.Exception = System.Exception("declared")
        let typed: Collections.LIST[System.Exception] = Collections.LIST[System.Exception]()

        typed.add(declared)

        try
            throw OLD_BASE()
        catch e: System.InvalidOperationException
            typed.add(e)
        yrt

        let is_one = isa System.Exception(o)
        let as_one = cast System.Exception?(o)
        let type = typeof System.Exception
        let builder = System.Text.StringBuilder()
        let biggest = System.Math.max(1, 2)
        let random = System.Random(1)
        let split = System.StringSplitOptions.NONE
        let ordinal = System.StringComparison.ORDINAL
        let pair = Collections.KeyValuePair[string, int]("k", biggest)

        return "{is_one} {as_one?.message} {type.name} {builder} {random.next(2)} {split} {ordinal} {pair.key}"
    si

    new_routes(o: object) -> string is
        let declared: Ghul.Exception = Ghul.Exception("declared")
        let typed: Collections.LIST[Ghul.Exception] = Collections.LIST[Ghul.Exception]()

        typed.add(declared)

        try
            throw NEW_BASE()
        catch e: Ghul.InvalidOperationException
            typed.add(e)
        yrt

        let is_one = isa Ghul.Exception(o)
        let as_one = cast Ghul.Exception?(o)
        let type = typeof Ghul.Exception
        let builder = Text.STRING_BUILDER()
        let biggest = Ghul.Math.max(1, 2)
        let random = Ghul.RANDOM(1)
        let split = Ghul.StringSplitOptions.NONE
        let ordinal = Ghul.StringComparison.ORDINAL
        let pair = Collections.KEY_VALUE_PAIR[string, int]("k", biggest)

        return "{is_one} {as_one?.message} {type.name} {builder} {random.next(2)} {split} {ordinal} {pair.key}"
    si
si

namespace Test.UseOld is
    // A use of the type itself, and one giving it a name of its own.
    use System.Exception
    use System.Text.StringBuilder
    use OLD = System.InvalidOperationException
    use Collections.KeyValuePair

    f() -> Exception => OLD("use old")
    g() -> StringBuilder => StringBuilder()
    h() -> KeyValuePair[string, int] => KeyValuePair[string, int]("k", 1)
si

namespace Test.UseNew is
    use Ghul.Exception
    use Text.STRING_BUILDER
    use NEW = Ghul.InvalidOperationException
    use Collections.KEY_VALUE_PAIR

    f() -> Exception => NEW("use new")
    g() -> STRING_BUILDER => STRING_BUILDER()
    h() -> KEY_VALUE_PAIR[string, int] => KEY_VALUE_PAIR[string, int]("k", 1)
si

namespace Test.BareOld is
    // A bare name reached through a use of the namespace.
    use System

    f() -> Exception => InvalidOperationException("bare old")
    g() -> int => Math.max(1, Math.min(2, 3))
    h() -> Random => Random(1)
si

namespace Test.BareNew is
    use Ghul

    f() -> Exception => InvalidOperationException("bare new")
    g() -> int => Math.max(1, Math.min(2, 3))
    h() -> RANDOM => RANDOM(1)
si

namespace Test.BareBoth is
    // Both namespaces in use: one type, so nothing is ambiguous.
    use System
    use Ghul

    f() -> Exception => Exception("both")
    g() -> Math? => null
si
