use default

class THING(label: string public) is
    close() is write_line("closed {label}") si
si

make(label: string) -> THING? => THING(label)

declared_inside() is
    let outer = make("outer")

    if outer? then
        try
            let outer mut = make("inner")
        finally
            outer.close()
        yrt
    fi
si

written_inside() is
    let outer = make("outer")

    if outer? then
        try
            let outer mut = make("inner")
            outer = make("second")
        finally
            outer.close()
        yrt
    fi
si

declared_inside()
written_inside()
