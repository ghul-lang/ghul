// A marked leaf in an `if let` runs the test a written `=~` would, so a
// narrowing ends at a call whose leaf reaches a `=~` that stores.
class HOLDER is
    name: string? public;
    init() is name = "x"; si
si

class TAG(n: int public, holder: HOLDER public);

=~(tag: TAG, other: TAG) -> bool is
    tag.holder.name = null;
    return tag.n == other.n;
si

matches(tag: TAG, other: TAG) -> bool is
    if let (~other, _) = (tag, 1) then
        return true;
    fi

    return false;
si

length_after(holder: HOLDER) -> int is
    if holder.name? then
        matches(TAG(1, holder), TAG(1, holder));

        return holder.name.length;
    fi

    return 0;
si

entry() is si
