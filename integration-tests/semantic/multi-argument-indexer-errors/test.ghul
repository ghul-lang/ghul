namespace Test is
    use IO.Std.write_line

    class TABLE is
        init() is si

        [row: int, column: int]: int => row * column
    si

    entry() is
        let table = TABLE()

        let fewer = table[1]
        let wrong_type = table[1, "x"]
        let more = table[1, 2, 3]

        table[1, 2] = 3

        write_line("{fewer} {wrong_type} {more}")
    si
si
