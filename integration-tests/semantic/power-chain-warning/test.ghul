// A chain of power operators without parentheses groups to the left, and is
// warned about; with parentheses around one pair it is not.

struct D(v: int public) is
    **(other: D) -> D => D(v * 10 + other.v)
    ***(other: D) -> D => D(v * 100 + other.v)
si

chains(a: D, b: D, c: D) -> D[] =>
    [
        a ** b ** c,
        a ** b *** c,
        (a ** b) ** c,
        a ** (b ** c)
    ]
