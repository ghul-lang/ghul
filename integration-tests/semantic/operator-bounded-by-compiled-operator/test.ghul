namespace Test is
    use IO.Std.write_line

    class Animal(name: string public);

    class Tag(n: int public) is
        hits: int public;
    si

    class Counter(n: int public) is
        hits: int public;
    si

    // Stores, so it is an error. The operators below never call it.
    =~(a: Tag, b: Tag) -> bool is
        a.hits = a.hits + 1;

        return a.n == b.n;
    si

    // Stores, so it is an error. The operators below never call it.
    ~(a: Counter, b: Counter) -> bool is
        a.hits = a.hits + 1;

        return a.n == b.n;
    si

    // A written `=~` calls the string `=~`: no error.
    =~(a: Animal, b: Animal) -> bool => a.name =~ b.name

    // A `case` value is tested with the string `=~`: no error.
    <>(a: Animal, b: Animal) -> int =>
        case a.name
        when "cat" then 0
        else 1
        esac

    class Pair(left: string public, right: string public);

    // A pattern leaf is tested with the string `=~`: no error.
    =~(a: Pair, b: Pair) -> bool =>
        if let ("cat", right) = (a.left, a.right) then
            right =~ b.right
        else
            false
        fi

    // Stores, so it is an error.
    <>(a: Counter, b: Counter) -> int is
        a.hits = a.hits + 1;

        return a.n - b.n;
    si

    // Calls the storing `=~` through `!~`: an error.
    <>(a: Tag, b: Tag) -> int => if a !~ b then 1 else 0 fi

    // Calls the storing `<>` through `<`: an error.
    =~(a: Counter, b: Counter) -> bool => !(a < b) /\ !(b < a)

    class Holder(tag: Tag public);

    // A `case` value is tested with the storing `=~`: an error.
    =~(a: Holder, b: Holder) -> bool =>
        case a.tag
        when b.tag then true
        else false
        esac

    entry() is
        write_line("{Animal("x") =~ Animal("x")}");
    si
si
