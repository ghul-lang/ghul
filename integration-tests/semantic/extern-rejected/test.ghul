namespace Test is
    // Tests: what extern cannot be written on for a .NET build. A type the
    // runtime has not been told how to marshal, a returned string, a body of
    // its own, an instance method, a generic function, a missing library, a
    // missing name, and arguments extern does not take.

    @extern("libc", "x")
    takes_a_list(values: Collections.LIST[int]) -> int;

    @extern("libc", "x")
    returns_a_string() -> string;

    @extern("libc", "printf", variadic = 1)
    print(format: string, value: int) -> int;

    @extern("libc", "close", errno = -1)
    close(fd: int) -> int;

    @extern("libc", "x")
    has_a_body() -> int => 3;

    @extern("libc", "x")
    generic[T](value: int) -> int;

    @extern("", "x")
    no_library() -> int;

    @extern("libc", "")
    no_name() -> int;

    @extern("libc")
    one_argument() -> int;

    @extern("libc", "x", result = "borrow")
    bad_result() -> int;

    @extern("libc", "x", other = "copy")
    unknown_argument() -> int;

    class HOLDER is
        @extern("libc", "x")
        is_an_instance() -> int;

        init() is si
    si

    entry() is si
si
