use default

class Holder(inner: Holder? public) is si

find_holder() -> Holder => Holder(Holder(null))

// the let cannot change, but the field it reaches through can: a call
// whose effects are unknown still ends a narrowing of the path
let holder = find_holder()
let act = () => write_line("acting")

if holder.inner? then
    act()
    write_line("{holder.inner.inner?}")
fi
