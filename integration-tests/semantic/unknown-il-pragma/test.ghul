namespace Test is
    use Std = IO.Std

    // A pragma in the `IL.` family that the compiler does not act on is
    // reported. Acted on as a built-in it would emit nothing at all, so a
    // misspelling would compile and leave the program quietly meaning
    // something other than what it says. Reported on a class, a function
    // and a property, whatever the pragma was written against, so one
    // inside a body reports too.

    @IL.nmae("Thing")
    class MISSPELLED is
        init() is
        si
    si

    class WORKER is
        @IL.nmae("Run")
        run() -> int => 1

        @IL.nmae("Value")
        value: int public

        init() is
            value = 0
        si
    si

    // The five the compiler does act on, each used as it is meant to be,
    // and each reported by nothing.

    @IL.name("Renamed")
    renamed() -> int => 2

    class COUNTER is
        _count: int;

        init() is
            _count = 0
        si

        @IL.name.read("Read_Count")
        count: int public => _count

        @IL.name.assign("Write_Count")
        total: int public, = written is
            _count = _count + written
        si
    si

    @IL.entrypoint()
    launch() -> int is
        announce();

        return 0
    si

    announce() is
        @IL.output("il.out")
        Std.write_line("hello")
    si
si
