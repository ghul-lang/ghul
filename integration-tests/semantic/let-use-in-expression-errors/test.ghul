class RESOURCE: Ghul.Disposable is
    init() is si

    value: int => 5

    dispose() is si
si

delay(n: int) -> Tasks.TASK[int] => Tasks.TASK.from_result(n)

awaiting_body() -> Tasks.TASK[int] => let use r = RESOURCE() in await delay(r.value)

not_disposable() -> int is
    let x = let use n = 5 in n + 1

    return x
si
