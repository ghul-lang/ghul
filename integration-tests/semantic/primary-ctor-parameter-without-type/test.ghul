class C(first);

class D(first, second: int) is
    sum() -> int => second
si

struct S(first);

union U(first) is
    A(..);
si

// On wasm and llvm the union's synthesised equality also reports that it
// can't compare the untyped field (err.wasm.expected, err.llvm.expected):
// .NET's default comparer accepts any type, and the core library has none.
