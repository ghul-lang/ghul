// Under the wasm target with no core library there is no Ghul.Box. A
// mutable local a closure assigns is held in one, so compiling it
// reports, once, the runtime version that declares it, rather than
// stopping the compiler.
count() -> int is
    let n mut = 0;
    let bump = () => (n = n + 1; n);
    bump();
    n
si

entry() is
    count();
si
