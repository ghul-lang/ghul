// A generator's iterator is a class the compiler synthesises, and its
// dispose runs the generator's finally, which here clears the narrowed
// field. A call to dispose through Disposable must end the narrowing on
// every target, including those that compile the core library from source.
namespace Test is
    use Collections.Iterable
    use Collections.Iterator

    class CAT is
        init() is si
        purr() -> int => 7
    si

    class CARRIER is
        occupant: CAT? public;
        init(occupant: CAT?) is self.occupant = occupant si
    si

    clears(carrier: CARRIER) -> Iterable[int] is
        try
            yield 1
            yield 2
        finally
            carrier.occupant = null
        yrt
    si

    describe(carrier: CARRIER, it: Ghul.Disposable) -> int is
        if carrier.occupant? then
            it.dispose()
            return carrier.occupant.purr()
        fi
        return 0
    si

    entry() -> int is
        let carrier = CARRIER(CAT())
        let it = clears(carrier).iterator
        it.move_next()
        return describe(carrier, it)
    si
si
