use IO.Std.write_line

shout(s: string) memo is
    write_line(s)
si

counting(n: int) -> int{} memo is
    yield n
si

later(n: int) -> Tasks.TASK[int] memo is
    let r = await Tasks.TASK.from_result(n)
    return r
si

swap(x: int ref) -> int memo => 0

ident[T](x: T) -> T memo => x

struct POINT(x: int) is
    doubled() -> int memo => x * 2
si

trait SHAPE is
    area(scale: int) -> int memo;
    perimeter(scale: int) -> int memo => scale
si

class BASE abstract is
    size(scale: int) -> int memo;
si

eventually(n: int) -> Tasks.TASK[int] memo => Tasks.TASK.from_result(n)

class MADE is
    init(n: int) memo is
    si
si

twice(n: int) -> int memo memo => n

announce(s: string) -> void memo => write_line(s)
