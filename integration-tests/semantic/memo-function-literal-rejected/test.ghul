use IO.Std.write_line

entry() is
    let shout = (s: string) memo => write_line(s)

    let counting = (n: int) memo is
        yield n
    si

    let later = (n: int) -> Tasks.TASK[int] memo is
        let r = await Tasks.TASK.from_result(n)
        return r
    si

    let eventually = (n: int) -> Tasks.TASK[int] memo => Tasks.TASK.from_result(n)

    let twice = (n: int) -> int memo memo => n

    let again = (n: int) -> int pure rec pure => n

    let looped = (n: int) -> int rec memo rec => n
si
