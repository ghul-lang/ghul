use IO.Std.write_line

entry() is
    let shout = (s: string) memo => write_line(s)

    let counting = (n: int) memo is
        yield n
    si

    let later = (n: int) -> Concurrency.Future[int] memo is
        let r = await Concurrency.Future.from_result(n)
        return r
    si

    let eventually = (n: int) -> Concurrency.Future[int] memo => Concurrency.Future.from_result(n)

    let twice = (n: int) -> int memo memo => n

    let again = (n: int) -> int pure rec pure => n

    let looped = (n: int) -> int rec memo rec => n
si
