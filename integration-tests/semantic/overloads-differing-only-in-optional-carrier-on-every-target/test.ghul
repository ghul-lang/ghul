// Two overloads whose parameters differ only in how the optional is held,
// `int?` against a `T?` instantiated at `int`, are both declared, and an
// `int` argument that could reach either is ambiguous. Naming the type
// argument picks the generic one.

use IO.Std.write_line

class C[T] is
    init() is si
    g(x: T?) -> string => "g maybe"
    g(x: int?) -> string => "g nullable"
si

f(x: int?) -> string => "f nullable"
f[T](x: T?) -> string => "f maybe"

let v: int? = 1
write_line(f(v))
write_line(f[int](v))
write_line(f(1))
write_line(C[string]().g(v))
write_line(C[int]().g(v))
write_line(C[int]().g(1))
