// A source library compiled in with the program is another assembly to
// it, as the library's compiled form is: its closed types can't be
// extended, its types can't be reopened, and its underscore names are
// private to it. Its open types can be extended.
namespace Test is
    partial string is
        extra() -> int => 1
    si

    class MY_RANDOM: Ghul.Random is
        init() is si
    si

    class RESOURCE: Ghul.Disposable is
        init() is si
        dispose() is si
    si

    class Failure: Ghul.Exception is
        init() is super.init("failed") si
    si

    entry() is
        let capacity = Ghul._grown_capacity(1, 2)
    si
si
