// An attribute blob carries an ARRAY[T], not a T[] list: a constructor
// parameter declared as the list is reported at the pragma rather than
// failing in the emitter.
class TAGGED(tags: string[] public): System.Attribute is si

class NAMED(names: ARRAY[string] public): System.Attribute is si

@TAGGED(["x", "y"])
class LISTED is si

@NAMED(["x", "y"])
class ARRAYED is si

entry() is si
