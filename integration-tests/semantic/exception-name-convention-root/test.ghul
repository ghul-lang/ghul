// The root exception type is an exception class itself, so it is named
// in PascalCase like the classes that derive from it. Declared here as a
// core library declares it, for a target whose exceptions are source.
namespace Ghul is
    class Exception is
        init() is si
    si

    class InvalidThing: Exception is
        init() is super.init() si
    si

    class LOUD_THING: Exception is
        init() is super.init() si
    si
si
