// A type declaring only a binary - member has no unary -, so a prefix -
// on one of its values is reported rather than read as self - value.

class ONLY_BINARY(v: int public) is
    -(other: ONLY_BINARY) -> ONLY_BINARY => ONLY_BINARY(v - other.v)

    negated(other: ONLY_BINARY) -> ONLY_BINARY => -other
si
