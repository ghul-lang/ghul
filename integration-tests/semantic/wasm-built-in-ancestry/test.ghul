// Under the wasm target the built-in types are constructed by the
// compiler rather than reflected. Each takes the ancestry a .NET
// program sees: a reference type is an object, a value type is an
// object through ValueType, and an array is a List and an Iterable of
// its element, covariantly.
class ANIMAL is
    init() is si
si

class CAT: ANIMAL is
    init() is super.init(); si
si

accepted(cats: CAT[], names: string[]) is
    let o: object = "text";
    let boxed: object = 1;
    let sequence: Collections.Iterable[string] = names;
    let list: Collections.List[string] = names;
    let animals: Collections.Iterable[ANIMAL] = cats;
    let objects: Collections.Iterable[object] = names;
si

rejected(numbers: int[], o: object) is
    let s: string = 1;
    let back: string = o;
    let strings: Collections.List[string] = numbers;
si

entry() is si
