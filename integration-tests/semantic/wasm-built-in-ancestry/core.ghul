// The collection traits the constructed array family takes its
// ancestry from, and the members the core library gives that family,
// as the core library declares them.
namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool;
        current: E;
    si

    trait Iterable[E: out] is
        iterator: Iterator[E];
    si

    trait List[E: out]: Iterable[E] is
        count: int;
    si
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count;

        iterator: Collections.Iterator[E] => iterator;
    si
si
