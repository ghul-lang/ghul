// The range types and operators, declared as the core library declares
// them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("range.exclusive") ..(from: int, to: int) -> INT_RANGE pure
    @intrinsic("range.inclusive") ::(from: int, to: int) -> INT_RANGE_INCLUSIVE pure
si

namespace Ghul is
    struct INT_RANGE is
        _from: int field
        _to: int field

        init(from: int, to: int) is
            _from = from
            _to = to
        si
    si

    struct INT_RANGE_INCLUSIVE is
        _from: int field
        _to: int field

        init(from: int, to: int) is
            _from = from
            _to = to
        si
    si
si

namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool
        current: E
        dispose()
    si

    trait Iterable[E: out] is
        iterator: Iterator[E]
    si

    trait List[E: out]: Iterable[E] is
        count: int;
        [index: int]: E;
    si
si

namespace Ghul is
    partial ARRAY is
        count: int => 0;

        [index: int]: E => _;

        iterator: Collections.Iterator[E] => _;
    si
si
