namespace Test is
    use IO.Std.write_line

    // A use written inside a declaration that is itself deprecated is not
    // reported, however deeply it is nested; a use anywhere else still is.
    @System.Obsolete("use current instead")
    oldest(x: int) -> int => x + 1

    @System.Obsolete("use current instead")
    older(x: int) -> int => oldest(x)

    current(x: int) -> int => x + 1

    @System.Obsolete("use NEW instead")
    class OLD is
        init() is si

        value: int => older(1)

        again() -> OLD => OLD()
    si

    class NEW is
        init() is si

        value: int => current(1)
    si

    entry() is
        write_line("{older(2)} {NEW().value}")
    si
si
