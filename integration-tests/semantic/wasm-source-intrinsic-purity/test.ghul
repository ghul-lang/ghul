// An operator whose body only calls intrinsics declared pure in source is
// store-free, as the equality operator must be. The one error below keeps
// the program short of code generation.
class POINT(x: int field, y: int field): Ghul.Equatable[POINT] is
    =~(other: POINT) -> bool => x == other.x

    get_hash_code() -> int => x
si

entry() is
    let wrong: int = POINT(1, 2)
si
