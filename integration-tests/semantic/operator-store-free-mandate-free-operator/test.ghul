// The store-free mandate reaches a namespace-scope `=~` and `<>` as it
// does a member one: an operator of either name that stores is an
// error, wherever it is declared.

use IO.Std.write_line;

// Private state, so the class gets no memberwise operator of its
// own: one would answer before the globals below do.
class TAG is
    _v: int;
    v: int => _v;
    init(v: int) is _v = v; si
si

_calls: int static;

=~(a: TAG, b: TAG) -> bool is
    _calls = _calls + 1;
    return a.v == b.v;
si

<>(a: TAG, b: TAG) -> int is
    _calls = _calls + 1;
    return a.v - b.v;
si

entry() is
    write_line("{TAG(1) =~ TAG(1)} {TAG(1) < TAG(2)} calls={_calls}");
si
