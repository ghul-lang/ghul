// An optional of a type parameter instantiated at `int` and a written `int?`
// are held differently, so a collection of one is not taken where a
// collection of the other is expected. Both read as `int?` in the message.

use Collections.LIST

with_absent[T](a: T) -> LIST[T?] is
    let result = LIST[T?]()
    let none: T? = null
    result.add(a)
    result.add(none)
    return result
si

count(values: int?{}) -> int => 0

count(with_absent(1))
