// A fused chain is still a call to whatever its callback is. The loop the
// consumer lowers to is not a call shape the purity check recognises, so
// asking it about the loop rather than about the call the source wrote
// answered that nothing was called - and a field narrowed before the
// chain stayed narrowed across a callback that nulls it.
class HOLDER is
    _name: string?
    _total: int

    init() is
        _name = "x"
        _total = 0
    si

    clear() is
        _name = null
    si

    bump(value: int) -> int is
        _total = _total + value

        return value
    si

    // each, whose callback nulls the narrowed field
    fused_each(xs: Collections.LIST[int]) is
        if _name? then
            xs |> Ghul.Pipes.map(x => x) |> Ghul.Pipes.each(x => clear())

            IO.Std.write_line("{_name.length}")
        fi
    si

    // sum_by, whose selector stores
    fused_sum_by(xs: Collections.LIST[int]) is
        if _name? then
            let total = xs |> Ghul.Pipes.map(x => x) |> Ghul.Pipes.sum_by(x => bump(x))

            IO.Std.write_line("{_name.length} {total}")
        fi
    si

    // The same chain with a store-free callback keeps the narrowing and
    // still fuses.
    fused_pure(xs: Collections.LIST[int]) is
        if _name? then
            let total = xs |> Ghul.Pipes.map(x => x) |> Ghul.Pipes.sum()

            IO.Std.write_line("{_name.length} {total}")
        fi
    si
si

entry() is
    HOLDER().fused_each(Collections.LIST[int]([1, 2]))
si
