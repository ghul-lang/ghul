namespace Test is
    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(NO_SET_RESULT))
    class NO_RESULT[T] is
        value: T;

        init(value: T) is self.value = value; si
    si

    // Complete except for set_result, so the diagnostic the function
    // sees is that one.
    class NO_SET_RESULT[T] is
        init() is si

        create() -> NO_SET_RESULT[T] static => NO_SET_RESULT[T]();
        start(state_machine: object ref) is si
        task: NO_SET_RESULT[T] => self;
        set_exception(e: System.Exception) is si
        await_on_completed(awaiter: object ref, state_machine: object) is si
        await_unsafe_on_completed(awaiter: object ref, state_machine: object) is si
    si

    f(x: int) -> NO_RESULT[int] is
        await Tasks.TASK.yield();
        return x;
    si
si
