// An ordinary program can write none of the widening marks, and equality never
// widens: `==` and `=~` over an int and a double are still rejected.
namespace Test is
    struct AMOUNT(cents: long public) is
        @widen_operands()
        +(other: AMOUNT) -> AMOUNT => AMOUNT(cents + other.cents)
    si

    entry() is
        let i = 2
        let d = 2.0

        let same = i == d
        let equal = i =~ d
    si
si

namespace Ghul.Internal is
    class WIDENINGS is
        @widening() long_to_amount(value: long) -> Test.AMOUNT static => Test.AMOUNT(value)

        @widened_form() +(left: Test.AMOUNT, right: long) -> Test.AMOUNT static => Test.AMOUNT(left.cents + right)
    si
si
