namespace Test is
    use Collections.Matrix2

    // Tests: T[,] and T[,,] display as written, an array of rank above
    // three is rejected, and literal rows or planes that disagree in
    // length are rejected where they are written.

    row() -> int[] => [1, 2]

    test() is
        let m: int[,] = [[1, 2], [3, 4]]
        let wrong: string = m

        let c: string[,,] = [[["a"]]]
        let wrong_too: int = c

        let spelled: Matrix2[int] = m
        let same: int[,] = spelled

        let ragged: int[,] = [[1, 2, 3], [4, 5]]
        let unknown_row_is_fine: int[,] = [[1, 2], row()]
        let ragged_planes: int[,,] = [[[1, 2], [3, 4]], [[5, 6]]]
        let ragged_inner: int[,,] = [[[1, 2], [3, 4]], [[5, 6], [7]]]

        let four: int[,,,] = null
    si
si
