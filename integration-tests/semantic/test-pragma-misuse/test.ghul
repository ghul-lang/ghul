namespace Test is
    class Good is
        init() is si

        @test()
        passes() is si

        @test()
        generic[T]() is si

        @test()
        takes(x: int) is si

        @test()
        gives() -> int => 1

        @test()
        later() -> Concurrency.Future => Concurrency.Future.completed_task

        @test()
        value: int => 1

        @test()
        init(x: int) is si

        uses() is
            @test()
            let nothing = 0
        si
    si

    class NoParameterless is
