// A generic `T?` formal nested inside a function type is taken
// literally by the CLR: `(int) -> U?` is `Func<int, MAYBE<U>>`, and a
// `Func<int, string?>` is not that delegate for any U. The slot-boundary
// coercion between the optional carriers cannot apply to a nested
// position, so a function value whose shape differs only in the carrier
// of such a position - here a literal with its return written out - is
// eta-expanded instead: the wrapper literal is compiled under the slot,
// whose boundary coerces one carrier into the other. Named references,
// locals holding function values and literals alike.
namespace Test is
    use Std = IO.Std;

    bind[T, U](value: T?, f: (T) -> U?) -> U? =>
        if value? then f(value) else null fi;

    class Main is
        entry() static is
            let annotated = bind(30, (n: int) -> string? => null);
        si
    si
si
