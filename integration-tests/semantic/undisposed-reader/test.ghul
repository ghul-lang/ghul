namespace Test is
    use IO.File
    use Ghul.Pipes

    // A reader, stream or writer made in the call that reads or writes it,
    // with no `use`, is never disposed: the adaptors borrow what they are
    // given.
    class READERS is
        not_held(path: string) -> int =>
            File.open_text(path) |> lines() |> count()

        not_held_in_a_loop(path: string) is
            for line in File.open_text(path) |> lines() do
                IO.Std.write_line(line)
            od
        si

        stream_not_held(path: string) -> int =>
            File.open_read(path) |> bytes() |> count()

        writer_not_held(path: string, text: string[]) is
            text |> write_lines(File.create_text(path))
        si

        held(path: string) -> int =>
            use File.open_text(path) |> lines() |> count()

        held_by_a_local(path: string) -> int is
            let use reader = File.open_text(path)

            return reader |> lines() |> count()
        si

        borrowed(reader: IO.TextReader) -> int =>
            reader |> lines() |> count()

        writer_held(path: string, text: string[]) is
            (let use writer = File.create_text(path); text |> write_lines(writer))
        si

        an_iterator_is_not_a_reader(xs: int[]) -> int? =>
            xs.iterator |> next()
    si
si
