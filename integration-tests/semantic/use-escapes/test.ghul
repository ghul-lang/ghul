namespace Test is
    use IO.File
    use Ghul.Pipes

    // A lazy sequence over a value `use` disposes, leaving the block that
    // disposes it, is read after the dispose.
    class ESCAPES is
        returned(path: string) -> Pipe[string] is
            return use File.open_text(path) |> lines()
        si

        expression_body(path: string) -> string{} =>
            (let use reader = File.open_text(path) in reader |> lines() |> map(l => l.trim()))

        from_a_local(path: string) -> string[] is
            let use reader = File.open_text(path)

            return reader |> lines() |> list()
        si

        yielded(path: string) -> Pipe[string]{} is
            yield use File.open_text(path) |> lines()
        si

        read_here(path: string) -> int =>
            use File.open_text(path) |> lines() |> count()

        collected_here(path: string) -> Collections.LIST[string] is
            let use reader = File.open_text(path)

            return reader |> lines() |> Collections.LIST()
        si

        not_held(reader: IO.TextReader) -> Pipe[string] =>
            reader |> lines()
    si
si
