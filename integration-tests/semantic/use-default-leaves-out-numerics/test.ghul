// `use default` does not import `Ghul.Numerics`: the number theory
// functions are in `Ghul.NumberTheory`. The namespace is declared here, so
// the test doesn't depend on what the runtime defines.
namespace Ghul.Numerics is
    is_lucky(n: int) -> bool => n == 7
si

namespace Test is
    use default

    entry() is
        let lucky = is_lucky(7)
    si
si
