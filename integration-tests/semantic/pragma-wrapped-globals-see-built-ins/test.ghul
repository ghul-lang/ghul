// Every definition in this file carries a pragma, and the file still gets
// the namespace a file without one is given, so the built-in type names
// resolve in each of them.
@suppress("non-snake-case-name")
work(n: int) -> int => n * 2

@suppress("non-snake-case-name")
entry() is
    let total: int = work(5)
    let label: string = "total"

    IO.Std.write_line("{label} {total}")
si
