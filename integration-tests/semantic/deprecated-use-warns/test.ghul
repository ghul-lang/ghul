namespace Test is
    use IO.Std.write_line

    // A declaration carrying System.Obsolete is reported where it is used,
    // with its message when it has one; the declaration itself is not a
    // use, and a suppressed use is not reported.
    @System.Obsolete("use twice instead")
    double(x: int) -> int => x * 2

    twice(x: int) -> int => x * 2

    @System.Obsolete()
    class OLD is
        init() is si

        value: int => 1
    si

    class NEW is
        init() is si

        @System.Obsolete("read size instead")
        count: int => 1

        size: int => 1
    si

    entry() is
        write_line("{double(2)}")

        let old = OLD()
        let old_again: OLD = old

        write_line("{NEW().count}")

        @suppress("deprecated")
        let quiet = double(3)

        let request = System.Net.WebRequest.create("http://example.com")
    si
si
