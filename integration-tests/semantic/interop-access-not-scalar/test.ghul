// Ghul.Interop.read and write take a scalar or word type: anything else has no
// single machine load or store.
use default

@intrinsic("interop.read")
read[T](address: word, offset: int) -> T

struct POINT(x: int, y: int);

let a = read[string](0w, 0)
let b = read[POINT](0w, 0)
let c = read[int](0w, 0)
