// What a `partial` of an imported type can't add, in a runtime-library build.
namespace Ghul.Internal is
    partial string is
        to_upper() -> string => "taken"

        length: int => 0

        twice(s: string) -> string static => s

        stored: int

        init(x: int) is si

        fine() -> int => 1
    si

    // The same member added by a second partial.
    partial string is
        fine() -> int => 2
    si

    partial System.Exception is
        to_string() -> string => "overrides"
    si

    partial Collections.MAP[K, V] is
        nothing() -> int => 0
    si
si

// Outside Ghul.Internal it is still refused outright.
namespace App is
    partial string is
        elsewhere() -> int => 2
    si
si
