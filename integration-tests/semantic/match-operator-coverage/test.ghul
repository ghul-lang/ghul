struct Yes(n: int public);

~(value: bool, y: Yes) -> bool => value

// a ~ arm covers nothing, so the bool is not covered
whole_arm(b: bool) -> string =>
    case b
    when Yes(0) then "yes"
    when false then "no"
    esac

// nor does a ~ leaf
leaf(p: (bool, int)) -> string =>
    case p
    when (~Yes(0), _) then "yes"
    when (false, _) then "no"
    esac

// ~ arms are never reported as redundant
repeated(b: bool) -> string =>
    case b
    when true then "true"
    when false then "false"
    when Yes(0) then "never"
    esac
