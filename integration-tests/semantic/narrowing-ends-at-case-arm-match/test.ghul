// A `case` value arm that tests with a `~` calls it, so a narrowing ends
// at a call whose arm reaches a `~` that stores.
// The operator is rejected for storing as well, but the narrowing
// still ends at the call: an operator imported from another assembly is
// not checked by that rule.
class HOLDER is
    name: string? public;
    init() is name = "x"; si
si

class LABEL(n: int public);
class TAG(n: int public, holder: HOLDER public);

~(tag: TAG, label: LABEL) -> bool is
    tag.holder.name = null;
    return tag.n == label.n;
si

classify(tag: TAG, label: LABEL) -> int =>
    case tag when label then 1 else 2 esac

leaf(tag: TAG, label: LABEL) -> int =>
    case (tag, 0) when (~label, _) then 1 else 2 esac

length_after(holder: HOLDER) -> int is
    if holder.name? then
        classify(TAG(1, holder), LABEL(1));

        return holder.name.length;
    fi

    return 0;
si

length_after_leaf(holder: HOLDER) -> int is
    if holder.name? then
        leaf(TAG(1, holder), LABEL(1));

        return holder.name.length;
    fi

    return 0;
si

entry() is si
