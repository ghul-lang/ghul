use Ghul.Pipes

use IO.File
use IO.Directory

first_long_line(path: string) -> string? is
    let use lines = File.read_lines(path).iterator

    for line in cursor(lines) do
        if line.length > 10 then
            return line
        fi
    od

    return null
si

first_line(path: string) -> string? is
    let use lines = File.read_lines(path).iterator

    return cursor(lines) |> map(line => line.trim()) |> first()
si

first_entry(path: string) -> string? =>
    (let use entries = Directory.enumerate_files(path).iterator in cursor(entries) |> first())

is_empty(path: string) -> bool is
    let use entries = Directory.enumerate_file_system_entries(path).iterator

    return !entries.move_next()
si
