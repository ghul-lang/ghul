use default

// An index that failed to compile matches any indexer, so the read must not
// take the type of the one that accepts it: neither the int indexer of a
// string nor, for a range, the char that indexer reads.

let s = "abc"
let c = s[no_such_thing]
let n: int = c
let d = s[1..no_such_thing]
let m: int = d
write_line("{n} {m}")
