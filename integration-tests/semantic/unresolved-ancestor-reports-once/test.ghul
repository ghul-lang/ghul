// An ancestor naming a type that does not exist reports the missing name
// once, for each kind of type that can name one.
namespace Test is
    trait Named is
        name: string;
    si

    class FOO: NOPE is
        init() is si
    si

    class BAR: Named, MISSING is
        name: string => "bar";
        init() is si
    si

    struct POINT: ABSENT is
        init() is si
    si

    trait Labelled: GONE is
    si

    union U: LOST is
        A;
    si
si
