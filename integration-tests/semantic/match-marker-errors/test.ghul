namespace Test is
    use Ghul.Pipes
    class Main is
        entry() static is
            irrefutable((1, "one"), 1);
        si

        // A leaf in a plain `let` can only bind, so there is nothing
        // for a match marker to mean there.
        irrefutable(pair: (int, string), expected: int) static is
            let (~expected, b) = pair;

            IO.Std.write_line(b);
        si

        // Nor in a formal argument list.
        formal_argument((~a: int, b: int): (int, int)) -> int static => b;

        // Nor in a lambda parameter, where the group is speculated as
        // a tuple expression before it becomes a pattern.
        lambda_parameter(pairs: (int, int)[]) static is
            let doubled = pairs |> map(((~a, b)) => b) |> collect_mutable();

            IO.Std.write_line("{doubled.count}");
        si

        // A marker has no reading on a group, only on a leaf.
        on_group(triple: ((int, int), string)) static is
            if let (~(a, b), s) = triple then
                IO.Std.write_line(s);
            fi
        si

        // A variable outside a destructure always binds.
        outside_a_leaf(x: int, expected: int) static is
            if let ~expected = x then
                IO.Std.write_line("matched");
            fi
        si
    si
si
