use Ghul.Pipes
use IO.Std.write_line

// Tests: a type named as a value needs a constructor that the expected
// function type's parameters pick, cannot be abstract, must have its
// type arguments pinned by the parameters or the return slot, and the
// constructor's type has to fit the slot.

class PERSON(name: string public, age: int public) is si

class ANIMAL abstract is
    init() is si
si

class EMPTY[T] is
    init() is si
si

trait NAMED is
    name: string
si

entry() is
    let wrong_arity: (bool) -> PERSON = PERSON
    let abstract_class: () -> ANIMAL = ANIMAL
    let open_arguments: () -> object = EMPTY
    let not_a_class: () -> NAMED = NAMED
    let wrong_result: (string, int) -> int = PERSON
    let no_shape = PERSON
si
