namespace Test is
    use IO.Std.write_line;

    class Main is
        entry() static is
            // `n` says bigint, which has no unsigned counterpart, so
            // the sign selector has nothing to select.
            let unsigned = 1un;

            // `==` compares two bigints by value, but an optional bigint
            // is a struct of its own, so `==` on one is rejected as it is
            // on every other struct.
            let identity = maybe_big() == maybe_big();

            // And there is no implicit widening, so a mixed expression
            // is rejected the way `1.0D + 1` is.
            let mixed = 1n + 1;

            write_line("{unsigned} {identity} {mixed}");
        si

        maybe_big() -> bigint? static => 1n;
    si
si
