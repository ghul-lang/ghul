use default

let words = ["alpha", "beta"]

// no function type is expected, so nothing gives the receiver `*` a type
let untyped = * .length

// a `*` chain is an operand of one operator, not of the operator above it
let deeper = words |> map((* .length + 1) * 2)

// written without the space, `*.` is one operator token
let spaceless = words |> map(*.length)

// the member is looked up on the type the context gives the `*`
let missing: string -> int = * .size
let deep: string -> int = * .length.size

// under a generic call, the `*` takes the element type, which lacks the member
let mapped = words |> map(* .size)
