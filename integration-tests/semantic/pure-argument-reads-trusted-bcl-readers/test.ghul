// Arguments that only read regular-expression results, an enum's name, a
// rune's value, a date's parts or a parsed JSON document are proven pure:
// those readers are trusted in the overloads the compiler pins by their
// parameter types.
use default

let re = Text.REGEX("([a-z]+)([0-9]+)")

let words = ["ab12", "cd3", "!"] |> map(s => re.match(s).groups[1].value) |> join(",")
let numbers = ["ab12", "cd3"] |> map(s => re.match(s).groups[2].length) |> sum()
let hits = ["ab12", "!"] |> filter(s => re.is_match(s)) |> count()

let days = [System.DayOfWeek.MONDAY, System.DayOfWeek.FRIDAY] |> map(d => d.to_string()) |> join(",")
let weekdays = [Time.DATE_TIME(2026, 11, 13)] |> map(t => t.day_of_week.to_string()) |> join()
let code_points = "hé" |> runes() |> map(r => r.value) |> sum()

let document = System.Text.Json.JsonDocument.parse("{{\"a\": 1, \"b\": \"two\"}}", _)
let keys = document.root_element.enumerate_object() |> map(p => p.name) |> join(",")
let texts = document.root_element.enumerate_object() |> filter(p => p.value.value_kind == System.Text.Json.JsonValueKind.STRING) |> map(p => p.value.get_string()) |> join(",")

write_line("{words} {numbers} {hits} {days} {weekdays} {code_points} {keys} {texts}")
