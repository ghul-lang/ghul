namespace Test is
    use IO.Std.write_line

    class Tag(n: int public);

    class LOG is
        count: int public static;
    si

    class Base is
        _v: int field;

        init() is
            _v = 1;
        si

        init(v: int) is
            _v = v;
        si
    si

    class Derived: Base is
        init() is
            super.init();
        si
    si

    // A secondary constructor chaining to another of its own type.
    class Twice: Base is
        _w: int field;

        init(w: int) is
            super.init(w);
            _w = w;
        si

        init() is
            self.init(2);
        si
    si

    // Three levels, each writing its own state.
    class Fault open is
        _message: string field;

        init(message: string) is
            _message = message;
        si
    si

    class BadState: Fault open is
        init(message: string) is
            super.init(message);
        si
    si

    class Worse: BadState is
        code: int;

        init(message: string, code: int) is
            super.init(message);
            self.code = code;
        si
    si

    // The constructor chained to writes a static, which is not the
    // object being built.
    class Counted is
        init() is
            LOG.count = LOG.count + 1;
        si
    si

    class CountedTwice: Counted is
        init() is
            super.init();
        si
    si

    // The constructor chained to assigns a property an override could
    // replace.
    class Named open is
        name: string;

        init(name: string) is
            self.name = name;
        si
    si

    class Renamed: Named is
        init() is
            super.init("renamed");
        si
    si

    // Each of these builds an object and writes nothing else: no error.
    =~(a: Tag, b: Tag) -> bool => (let d = Derived(); a.n == b.n)

    <>(a: Tag, b: Tag) -> int => (let t = Twice(); a.n - b.n)

    ~(a: Tag, b: Tag) -> bool => (let w = Worse("worse", a.n); a.n == b.n)

    class Other(n: int public);

    // The chain reaches a constructor that writes a static: an error.
    =~(a: Other, b: Other) -> bool => (let c = CountedTwice(); a.n == b.n)

    // The chain reaches a constructor that calls an overridable assign
    // accessor: an error.
    <>(a: Other, b: Other) -> int => (let r = Renamed(); a.n - b.n)

    entry() is
        write_line("{Tag(1) =~ Tag(1)}");
    si
si
