namespace Test is
    use IO.Std.write_line

    class Main is
        entry() static is
            let a = 1r + 2j

            // A complex number's arithmetic takes two complex numbers: a
            // double on either side is rejected, as `1.0 + 1` is.
            let scaled = a * 2.0
            let shifted = 1.0 + a
            let halved = a / 2

            // System.Numerics.Complex is reached only as `complex`.
            let named: System.Numerics.Complex = a

            write_line("{scaled} {shifted} {halved} {named}")
        si
    si
si
