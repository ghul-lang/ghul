namespace Test is
    use IO.Std.write_line

    class Main is
        entry() static is
            let a = 1r + 2j

            // A complex number's arithmetic takes two complex numbers, and
            // a decimal has no widening to complex.
            let scaled = a * 2.0m
            let shifted = 1.0m + a

            // System.Numerics.Complex is reached only as `complex`.
            let named: System.Numerics.Complex = a

            write_line("{scaled} {shifted} {named}")
        si
    si
si
