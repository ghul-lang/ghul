// Nothing widens unless both marks are present: an operator not marked to
// accept widened operands is not reached through a marked widening, and a
// function in the holder without the widening mark is not a widening.
// Equality never widens: `==` and `=~` over an int and a double are still
// rejected.
namespace Test is
    struct AMOUNT(cents: long public) is
        *(other: AMOUNT) -> AMOUNT => AMOUNT(cents * other.cents)

        @widen_operands()
        +(other: AMOUNT) -> AMOUNT => AMOUNT(cents + other.cents)
    si

    entry() is
        let a = AMOUNT(250L)

        let product = a * 2L
        let sum = a + 2

        let i = 2
        let d = 2.0

        let same = i == d
        let equal = i =~ d
    si
si

namespace Ghul.Internal is
    class WIDENINGS is
        @widening() long_to_amount(value: long) -> Test.AMOUNT static => Test.AMOUNT(value)

        int_to_amount(value: int) -> Test.AMOUNT static => Test.AMOUNT(long(value))
    si
si
