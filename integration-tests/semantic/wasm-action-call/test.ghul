// Under the wasm target a function type returning void is constructed
// rather than reflected. A value of one takes the arguments its type
// names, as it does on .NET; only the wrong count is reported.
namespace Test is
    each(f: int -> void, x: int) is f(x) si
    each_pair(f: (int, bool) -> void, x: int) is f(x, true) si
    each_none(f: () -> void) is f() si
    wrong_count(f: int -> void) is f(1, 2) si
si
