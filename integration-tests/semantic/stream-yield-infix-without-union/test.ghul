// `a || b` still lowers to Ghul.Pipes.STREAM.YIELD, which the runtime no
// longer declares: a stream's step returns an optional tuple instead. A use
// of `||` is reported as a missing symbol, and the rest of the program
// compiles as usual.
use IO.Std.write_line
use Ghul.Pipes

let old = stream(0, n => n || n + 1)

let current = stream(0, n => (n, n + 1))
write_line(current |> take(3) |> join(","))
