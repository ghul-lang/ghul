use default

// In the first walk `right` is not typed yet, so the map fails and `list`
// is called on the failure. That call must not hand on its own unbound
// element type: comparing against it would decide the element type of
// `matched` before `add` says it holds characters.
differ(left, right) is
    let matched = LIST()

    for i in 0..left.length do
        matched.add(left[i])
    od

    let others = (0..right.length) |> map(j => right[j]) |> list()

    let differing = (0..matched.count) |> filter(i => matched[i] != others[i]) |> count()
    let element_type_is_char: int = matched
si

differ("MARTHA", "MARHTA")
