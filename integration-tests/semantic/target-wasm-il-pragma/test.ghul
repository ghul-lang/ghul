namespace Test is
    // An `IL.` pragma names a fact about the .NET assembly the program
    // becomes, which the wasm target does not produce: each one is an
    // error here. The `IL.name` the compiler synthesises on a primary
    // constructor's `deconstruct` is its own, not a use the program wrote,
    // and reports nothing.

    class RENAMED is
        @IL.name("X")
        run() -> int => 1

        init() is
        si
    si

    class PAIR(first: int, second: int) is
        show() -> string => "{first}/{second}"
    si

    entry() is
        let pair = PAIR(1, 2)

        IO.Std.write_line(pair.show())
    si
si
