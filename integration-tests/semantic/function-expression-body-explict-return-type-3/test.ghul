namespace Test is
    use Std = IO.Std;
    use Collections;

    class Main[T] is
        test(t: T) -> List[T] static => [t, t, t];
    si

    entry() is
        let s: List[string] = Main`[string].test("hello");
        let o: List[object] = Main`[object].test(1);

        let ss: ARRAY[string] mut = ["hello", "world"]; // OK array literal is ARRAY[string]

        ss = Main`[string].test("hello"); // expect error string[] is not ARRAY[string]
    si
si