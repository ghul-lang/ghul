struct Below(limit: double public);

~(value: double, b: Below) -> bool => value < b.limit

struct Odd(n: int public);

~(value: int, o: Odd) -> int => value

// an arm value that neither matches nor compares
unmatchable(x: int) -> string =>
    case x
    when "hello" then "string"
    else "other"
    esac

// a leaf value that neither matches nor compares
unmatchable_leaf(p: (int, string)) -> string =>
    case p
    when (~Below(1.0), _) then "below"
    else "other"
    esac

// a ~ whose result is not bool
not_bool(x: int) -> string =>
    case x
    when Odd(1) then "odd"
    else "other"
    esac

// a ~ in an expression does not fall back to =~
no_fallback(a: int, b: int) -> bool => a ~ b

~[T](value: T, test: (T) -> bool) -> bool => test(value)

// a placeholder covers only the operator it is an operand of, so this
// compares a function with zero, as it would in an argument list
placeholder_scope(p: (int, int)) -> string =>
    case p
    when (~(* % 2 == 0), _) then "even"
    else "other"
    esac
