// An operator that really calls a member operator which stores is still
// charged with that member's effects.
class LOG is
    count: int static public
si

struct B is
    value: int public

    init(value: int) is self.value = value si

    -(other: B) -> B is
        LOG.count = LOG.count + 1
        return B(value - other.value)
    si

    <>(other: B) -> int => (self - other).value
si
