// A fragment written with a format specifier is formatted by its type's own
// to_string, as one without is, so it leaves a function literal pure. A
// literal that stores something is still reported, format or not.
use default

let bytes: ARRAY[ubyte] = [1ub, 255ub]

write_line(bytes |> map(b => "{int(b):x2}") |> join(""))
write_line([1, 2] |> map(n => "{n:X}") |> join(" "))
write_line([1.5, 2.25] |> map(d => "{d,8:F2}") |> join(" "))
write_line([1, 2] |> map(n => n.to_string("X")) |> join(" "))
write_line([1, 2] |> map(n => "{n}") |> join(" "))

let count mut = 0

write_line([1, 2] |> map(n => (count = count + 1; "{n:X}")) |> join(" "))
