// A literal written `pure` is trusted as pure wherever its value goes, so
// its body is checked against the marker: one that writes a captured
// mutable local is reported, as a value stored into a pure slot would be.
use default

let count mut = 0

let bump = (n: int) -> int pure => (count = count + 1; n)
let double = (n: int) -> int pure => n * 2

let add = (n: int) -> int pure is
    count = count + n
    n
si

write_line("{bump(1)} {double(2)} {add(3)} {count}")
