// The operators the program uses, and one library function, declared as
// a source library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
si

namespace Library is
    twice(x: int) -> int => x + x
si
