// A substring is a new string holding a run of another's code units.
namespace Test is
    check(text: string, expected: string) -> int => if text =~ expected then 1 else 0 fi

    entry() -> int =>
        check(_string_substring("hello", 1, 3), "ell") +
        check(_string_substring("hello", 0, 5), "hello") * 2 +
        check(_string_substring("hello", 5, 0), "") * 4 +
        _string_length(_string_substring("café!", 3, 2)) * 8
si
