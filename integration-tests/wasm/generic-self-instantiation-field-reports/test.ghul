// A generic class with a field holding a deeper instantiation of itself
// would need a type for every depth, without end. The target reports the
// class rather than adding types forever.
class NODE[T] is
    value: T
    inner: NODE[NODE[T]]?

    init(value: T) is
        self.value = value
    si
si

entry() -> int is
    let node = NODE(1)

    return node.value
si
