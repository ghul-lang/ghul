// A bigint too wide for a double converts as .NET's BigInteger does: the
// magnitude is truncated to the 53 bits a double holds rather than rounded
// to the nearest, and only 2^1024 and beyond is infinite. The exit status
// sets a bit for each that holds.
namespace Test is
    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    entry() -> int is
        let result mut = 0

        result = result + bit(bigint.to_double(9007199254740993n) == 9007199254740992.0, 1)
        result = result + bit(bigint.to_double(9007199254740995n) == 9007199254740994.0, 2)
        result = result + bit(bigint.to_double(-9007199254740995n) == -9007199254740994.0, 4)
        result = result + bit(bigint.to_double(9223372036854775807n) == 9223372036854774784.0, 8)
        result = result + bit(bigint.to_double(bigint.parse("9223372036854775809")) == 9223372036854775808.0, 16)

        let limit = bigint.pow(bigint(2L), 1024)

        result = result + bit(bigint.to_double(limit - bigint(1L)) == 1.7976931348623157E308, 32)
        result = result + bit(bigint.to_double(-limit) == -1.0 / 0.0, 64)
        result = result + bit(bigint.to_double(bigint(2147483647L)) == 2147483647.0, 128)

        return result
    si
si
