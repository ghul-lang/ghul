// Runs pipe chains that fusion lowers to a loop with counters: an index
// stage, a take stage and a skip stage, alone and chained, over a concrete
// source. The exit status is 100 plus a bit for each check that failed.
namespace Test is
    use Collections.Iterable
    use Collections.Iterator
    use Ghul.Pipes

    class TENS: Iterable[int] is
        init() is si

        iterator: Iterator[int] => _values().iterator

        _values() -> Iterable[int] is
            yield 10
            yield 20
            yield 30
            yield 40
            yield 50
        si
    si

    check(passed: bool, bit: int) -> int => if passed then 0 else bit fi

    entry() -> int is
        let weighted mut = 0

        for iv in TENS() |> index() do
            weighted = weighted + iv.index * iv.value
        od

        let taken mut = 0

        for v in TENS() |> take(2) do
            taken = taken + v
        od

        let skipped mut = 0

        for v in TENS() |> skip(3) do
            skipped = skipped + v
        od

        let chained mut = 0

        for iv in TENS() |> skip(1) |> take(3) |> index() do
            chained = chained + iv.index * iv.value
        od

        return 100 +
            check(weighted == 400, 1) +
            check(taken == 30, 2) +
            check(skipped == 90, 4) +
            check(chained == 110, 8)
    si
si
