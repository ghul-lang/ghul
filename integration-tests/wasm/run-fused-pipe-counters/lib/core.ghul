// The operators, iteration traits and pipe combinators the program uses,
// declared as the core and runtime libraries declare them. Fusion
// recognises index, take and skip by name in Ghul.Pipes and lowers a chain
// of them to one loop, so a fused chain never calls these bodies, which
// ignore their counts: a chain that did call them would fail its checks.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
si

namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool
        current: E
        dispose()
    si

    trait Iterable[E: out] is
        iterator: Iterator[E]
    si
si

namespace Ghul.Pipes is
    use Collections.Iterable

    class INDEXED_VALUE[T] is
        index: int
        value: T

        init(index: int, value: T) pure is
            self.index = index
            self.value = value
        si
    si

    index[T](source: Iterable[T]) -> Iterable[INDEXED_VALUE[T]] is
        for value in source do
            yield INDEXED_VALUE[T](0, value)
        od
    si

    take[T](source: Iterable[T], count: int) -> Iterable[T] is
        yield in source
    si

    skip[T](source: Iterable[T], count: int) -> Iterable[T] is
        yield in source
    si
si
