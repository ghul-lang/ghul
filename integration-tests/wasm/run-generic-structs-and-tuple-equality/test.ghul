// A struct with type parameters calls its own members on its box, as a
// struct with none does, and `=~` over a type parameter instantiated with a
// tuple compares the tuples element by element.
namespace Test is
    struct PAIR[T] is
        `0: int
        `1: T

        index: int => `0
        value: T => `1

        init(index: int, value: T) is
            `0 = index
            `1 = value
        si

        doubled() -> int => index + index
    si

    same[T](a: T, b: T) -> bool => a =~ b

    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    entry() -> int is
        let result mut = 0

        // 1: a generic struct's properties
        let p = PAIR[int](3, 40)
        result = result + bit(p.index == 3 /\ p.value == 40, 1)

        // 2: a generic struct's method
        result = result + bit(p.doubled() == 6, 2)

        // 4: equal tuples
        result = result + bit(same((1, 2), (1, 2)), 4)

        // 8: tuples differing in one element
        result = result + bit(!same((1, 2), (1, 3)), 8)

        // 16: nested tuples
        result = result + bit(same(((1, 2), 3), ((1, 2), 3)) /\ !same(((1, 2), 3), ((1, 9), 3)), 16)

        return result
    si
si
