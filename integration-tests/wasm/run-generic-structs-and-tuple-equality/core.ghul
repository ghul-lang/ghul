// The operators the program uses, the root's hash code, the collection
// traits a struct's equality needs, and the members the core library
// gives arrays, declared as the core library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("arithmetic.xor") ^(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("compare.value") !=[T](a: T, b: T) -> bool pure
    @intrinsic("compare.reference") ==(a: object?, b: object?) -> bool pure
    @intrinsic("string.equals") =~(a: string?, b: string?) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.div") /(a: double, b: double) -> double pure
    @intrinsic("arithmetic.neg") -(a: double) -> double pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
si

namespace Ghul is
    partial int is
        =~(other: int) -> bool pure => self == other
    si

    partial object is
        get_hash_code() -> int => 0
    si
si
namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool
        current: E
        dispose()
    si

    trait Iterable[E: out] is
        iterator: Iterator[E]
    si

    trait List[E: out]: Iterable[E] is
        count: int;
        [index: int]: E;
    si
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count;

        @intrinsic("array.get")
        [index: int]: E => self[index]

        iterator: Collections.Iterator[E] => ARRAY_ITERATOR[E](self)
    si

    class ARRAY_ITERATOR[E]: Collections.Iterator[E] is
        _array: E[]
        _index: int
        init(array: E[]) is _array = array; _index = -1 si
        move_next() -> bool is _index = _index + 1; return _index < _array.count si
        current: E => _array[_index]
        dispose() is si
    si
si
namespace Ghul.Intrinsics is
    partial TUPLE_2[T1, T2] is
        `0: T1 field
        `1: T2 field

        init(first: T1, second: T2) is
            `0 = first
            `1 = second
        si
    si
si
