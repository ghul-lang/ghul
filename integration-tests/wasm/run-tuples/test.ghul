namespace Test is
    class Animal abstract is
        init() is si
        legs: int => 4
    si

    class CAT: Animal is
        init() is super.init() si
    si

    widen(pair: (int, CAT)) -> (int, Animal) => pair

    class THING is
        init() is si
    si

    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    swap(pair: (int, int)) -> (int, int) => (pair.`1, pair.`0)

    entry() -> int is
        let result mut = 0

        // 1: construct and read
        let p = (3, 4)
        result = result + bit(p.`0 == 3 /\ p.`1 == 4, 1)

        // 2: named elements
        let named = (x = 5, y = 6)
        result = result + bit(named.x == 5 /\ named.y == 6, 2)

        // 4: pass and return
        let s = swap(p)
        result = result + bit(s.`0 == 4 /\ s.`1 == 3, 4)

        // 8: destructure
        let (a, b) = s
        result = result + bit(a == 4 /\ b == 3, 8)

        // 16: a tuple holding a reference
        let thing = THING()
        let t = (1, thing)
        result = result + bit(t.`0 == 1 /\ t.`1 == thing, 16)

        // 32: a tuple widened to a wider element type
        let widened = widen((2, CAT()))
        result = result + bit(widened.`0 == 2 /\ widened.`1.legs == 4, 32)

        return result
    si
si
