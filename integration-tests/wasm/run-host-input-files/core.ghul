// The host imports that hand the program the files it starts with, declared as
// the core library declares them: how many there are, and the path and the
// content of each, the content as one code unit for each byte.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
si

namespace Test is
    @intrinsic("host.input_file_count") input_file_count() -> int
    @intrinsic("host.input_file_path") input_file_path(index: int) -> string
    @intrinsic("host.input_file_content") input_file_content(index: int) -> string
    @intrinsic("host.file_written") file_written(path: string, content: string)
si
