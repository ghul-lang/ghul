// An asynchronous function with no core library to declare the task
// types reports the missing name at each use, rather than stopping the
// front end with an exception.
namespace Test is
    double_async(x: int) -> Tasks.TASK[int] =>
        Tasks.TASK.delay(2).continue_with((t: Tasks.TASK) -> int => x);

    compute(x: int) -> Tasks.TASK[int] is
        let y = await double_async(x);
        return y;
    si
si
