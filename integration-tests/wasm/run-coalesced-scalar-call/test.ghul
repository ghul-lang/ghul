// A coalescing call to a method returning a scalar gives an optional,
// boxing the call's result. The call reads its receiver from the stack,
// so the box has to be built after it. The exit status is 7 + 100.
namespace Test is
    class THING is
        init() is si
        size() -> int => 7
    si

    size_of(thing: THING?) -> int? => thing?.size()

    entry() -> int =>
        (size_of(THING()) ?? 0) + 100
si
