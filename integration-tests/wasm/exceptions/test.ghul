// Exceptions thrown and caught, catches chosen by type, finallies run on
// every way out of their try, and exits that cross several finallies.
// The exit status is the number of the first check that fails.
namespace Test is
    use Ghul.Exception

    class NotFound: Exception is
        init(code: int) is super.init(code) si
    si

    class Refused: Exception is
        init(code: int) is super.init(code) si
    si

    trace: int

    note(digit: int) is
        trace = trace * 10 + digit
    si

    fail(which: int) is
        if which == 1 then
            throw NotFound(10)
        elif which == 2 then
            throw Refused(20)
        fi

        throw Exception(30)
    si

    caught(which: int) -> int is
        try
            fail(which)
        catch e: NotFound
            return e.code + 1
        catch e: Refused
            return e.code + 2
        yrt

        return 0
    si

    caught_by_base(which: int) -> int is
        try
            fail(which)
        catch e: NotFound
            return 1
        catch e: Exception
            return e.code
        yrt

        return 0
    si

    rethrown() -> int is
        try
            try
                fail(2)
            catch e: NotFound
                return 1
            yrt
        catch e: Refused
            return e.code
        yrt

        return 0
    si

    finally_on_fall_through() -> int is
        trace = 0

        try
            note(1)
        finally
            note(2)
        yrt

        note(3)

        return trace
    si

    finally_on_return() -> int is
        trace = 0

        try
            note(1)
            return 5
        finally
            note(2)
        yrt

        return 9
    si

    finally_on_exception() -> int is
        trace = 0

        try
            try
                note(1)
                fail(1)
                note(9)
            finally
                note(2)
            yrt
        catch e: NotFound
            note(3)
        yrt

        return trace
    si

    finally_on_break() -> int is
        trace = 0

        let i mut = 0

        while i < 5 do
            i = i + 1

            try
                try
                    if i == 3 then
                        break
                    fi

                    note(1)
                finally
                    note(2)
                yrt
            finally
                note(3)
            yrt
        od

        return trace
    si

    finally_on_continue() -> int is
        trace = 0

        let i mut = 0

        while i < 3 do
            i = i + 1

            try
                if i == 2 then
                    continue
                fi

                note(1)
            finally
                note(2)
            yrt

            note(3)
        od

        return trace
    si

    finally_and_catch() -> int is
        trace = 0

        try
            fail(2)
        catch e: Refused
            note(1)
        finally
            note(2)
        yrt

        return trace
    si

    check(which: int, actual: int, expected: int) -> int =>
        if actual == expected then 0 else which fi

    entry() -> int is
        let result mut = check(1, caught(1), 11)

        if result == 0 then result = check(2, caught(2), 22) fi
        if result == 0 then result = check(3, caught_by_base(3), 30) fi
        if result == 0 then result = check(4, caught_by_base(1), 1) fi
        if result == 0 then result = check(5, rethrown(), 20) fi
        if result == 0 then result = check(6, finally_on_fall_through(), 123) fi
        if result == 0 then result = check(7, finally_on_return(), 5) fi
        if result == 0 then result = check(8, trace, 12) fi
        if result == 0 then result = check(9, finally_on_exception(), 123) fi
        if result == 0 then result = check(10, finally_on_break(), 12312323) fi
        if result == 0 then result = check(11, finally_on_continue(), 1232123) fi
        if result == 0 then result = check(12, finally_and_catch(), 12) fi

        return result
    si
si
