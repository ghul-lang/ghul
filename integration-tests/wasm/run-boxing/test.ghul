// Runs boxing: scalars stored as object answer type tests by their own
// type, and a cast back unboxes. The exit status is the low byte of the
// same value the .NET build returns.
namespace Test is
    class HOLDER is
        held: object
        init(held: object) is self.held = held si
    si

    kind(o: object) -> int is
        if isa int(o) then
            return 1
        fi
        if isa long(o) then
            return 2
        fi
        if isa HOLDER(o) then
            return 3
        fi
        return 0
    si

    entry() -> int is
        let a: object = 5
        let b: object = 7L
        let h = HOLDER(a)
        let c: object = h
        let back = cast int(h.held)
        return kind(a) + kind(b) * 10 + kind(c) * 100 + kind(h.held) * 1000 + back * 10000000
    si
si
