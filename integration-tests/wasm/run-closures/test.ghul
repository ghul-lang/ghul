// Runs function values: lambdas, a bound method, a function held in a
// field. The exit status is the low byte of the same value the .NET build
// returns.
namespace Test is
    apply(f: int -> int, x: int) -> int => f(x)

    class SINK is
        seen: int
        init() is si
        take(x: int) -> int is seen = seen + x; return 0 si
    si

    class HOLDER is
        f: int -> int
        init(f: int -> int) is self.f = f si
        run(x: int) -> int => f(x)
    si

    each(f: int -> int, x: int) is f(x) si

    entry() -> int is
        let s = SINK()
        each(s.take, 3)
        each(x => s.take(x * 2), 4)
        let h = HOLDER(x => x * x)
        return apply(x => x + 1, 5) + h.run(7) * 10 + s.seen * 1000
    si
si
