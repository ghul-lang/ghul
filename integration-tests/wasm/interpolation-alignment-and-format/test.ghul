// An interpolated value with an alignment is padded to it, on the left when
// it is positive and on the right when it is negative; one with a format is
// written by its type's to_string(format), and a value .NET would not format,
// such as a string or a bool, is written as it is without one.
namespace Test is
    entry() is
        let n = 42
        let name = "ghūl"

        IO.Std.write_line("[{n,6}] [{n,-6}] [{name,8}] [{name,-8}] [{n,1}]")
        IO.Std.write_line("[{n:X4}] [{n,10:N0}] [{n,-10:D3}] [{1.5:F2}]")
        IO.Std.write_line("[{true:X}] [{name,6:F2}]")
    si
si
