@@suppress("non-upper-snake-case-name")
// What the program uses, declared as the core library declares it: the
// operators, the root's members, an exception, the type objects `typeof`
// makes, and the types an asynchronous function's lowering reaches.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("compare.value") !=[T](a: T, b: T) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
    @intrinsic("bool.or_else") \/ (a: bool, b: bool) -> bool pure
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
si

namespace Ghul is
    partial object is
        get_hash_code() -> int => 0
    si

    class Type is
        init(name: string) is si
    si

    class Exception is
        init() is si
    si
si

namespace System.Runtime.CompilerServices is
    trait IAsyncStateMachine is
        move_next();
        set_state_machine(state_machine: IAsyncStateMachine);
    si

    trait INotifyCompletion is
        on_completed(continuation: () -> void);
    si

    trait ICriticalNotifyCompletion: INotifyCompletion is
        unsafe_on_completed(continuation: () -> void);
    si

    class AsyncMethodBuilderAttribute is
        init(builder_type: Ghul.Type) is si
    si
si
