// An interpolation builds its text through the core library's builder,
// taking each value's text from its to_string: the same text .NET makes.
namespace Test is
    class THING is
        init() is si
    si

    class NAMED_THING is
        init() is si

        to_string() -> string => "named"
    si

    check(text: string, expected: string) -> int => if text =~ expected then 1 else 0 fi

    entry() -> int is
        let name = "ghul"
        let count = 42
        let negative = -7
        let lowest = -2147483647 + -1
        let wide = 9000000000L
        let letter = 'Z'
        let flag = true

        return
            check("hello {name}", "hello ghul") +
            check("{count} items", "42 items") * 2 +
            check("{negative}|{lowest}", "-7|-2147483648") * 4 +
            check("{wide}{letter}", "9000000000Z") * 8 +
            check("{flag} {0}", "true 0") * 16 +
            check("{THING()} {NAMED_THING()}", "Test.THING named") * 32 +
            check("{"abc".length}", "3") * 64
    si
si
