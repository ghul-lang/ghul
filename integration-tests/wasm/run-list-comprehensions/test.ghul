// Runs list comprehensions: one clause, one with a filter, and two nested
// clauses filtered on both of their variables. The exit status is the low
// byte of the same value the .NET build returns.
namespace Test is
    sum(xs: int[]) -> int is
        let total mut = 0
        for x in xs do total = total + x od
        return total
    si

    entry() -> int is
        let xs = [1, 2, 3, 4]

        let squares = [x * x for x in xs]
        let others = [x for x in xs if !(x == 2)]
        let pairs = [a * b for a in xs for b in xs if !(a == b)]

        let result mut = 0
        result = result + squares.count * 1000
        result = result + sum(squares)
        result = result + sum(others) * 100
        result = result + pairs.count * 10000

        return result
    si
si
