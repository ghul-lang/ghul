namespace Test is
    // Tests: what extern cannot be written on for a wasm build. The name is
    // a function the program's caller supplies, so there is no library to
    // name, and only numbers and strings cross.

    @extern("libc", "x")
    names_a_library() -> int;

    @extern("", "x")
    takes_a_list(values: ARRAY[int]) -> int;

    @extern("", "x")
    returns_a_list() -> ARRAY[int];

    entry() is si
si
