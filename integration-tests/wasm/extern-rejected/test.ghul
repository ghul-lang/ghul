namespace Test is
    // Tests: what extern cannot be written on for a wasm build. The name is
    // a function the program's caller supplies, so there is no library to
    // name, and only numbers and strings cross: the host cannot write through a
    // reference or read a WasmGC array, and there is no errno to report.

    @extern("libc", "x")
    names_a_library() -> int;

    @extern("", "x")
    takes_a_list(values: ARRAY[int]) -> int;

    @extern("", "x")
    returns_a_list() -> ARRAY[int];

    @extern("", "x")
    takes_a_ref(value: int ref) -> int;

    @extern("", "x")
    takes_bytes(bytes: ARRAY[ubyte]) -> int;

    @extern("", "x", errno = 0)
    reports_errno() -> int;

    entry() is si
si
