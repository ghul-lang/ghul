// A generic class whose method instantiates it at a deeper type argument
// would be compiled at ever deeper instantiations, one for each, without
// end. The target reports the class rather than compiling forever.
class NODE[T] is
    value: T

    init(value: T) is
        self.value = value
    si

    wrap() -> NODE[NODE[T]] => NODE(self)
si

entry() -> int is
    let node = NODE(1)

    return if node.wrap().value.value == 1 then 0 else 1 fi
si
