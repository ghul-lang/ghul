// A generic class whose method calls itself on an instantiation at a deeper
// type argument would be compiled at ever deeper instantiations, one for
// each, without end. The target reports the class rather than compiling
// forever.
class NODE[T] is
    value: T

    init(value: T) is
        self.value = value
    si

    wrap() -> NODE[NODE[T]] => NODE(self)

    depth(n: int) -> int => if n == 0 then 0 else wrap().depth(n - 1) fi
si

entry() -> int is
    let node = NODE(1)

    return node.depth(3)
si
