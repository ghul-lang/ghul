// The console writer, the members the core library gives arrays, and the
// core library's environment as it declares them: the arguments and the
// variables come from host operations the loader provides, answering with
// JavaScript strings.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.reference") ==(a: object?, b: object?) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
si

namespace IO is
    class Std is
        write_line(text: string) static is
            _write(text, 1)
            _write("\n", 1)
        si

        @intrinsic("host.write")
        _write(text: string, stream: int) static
    si
si

namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool
        current: E
        dispose()
    si

    trait Iterable[E: out] is
        iterator: Iterator[E]
    si

    trait List[E: out]: Iterable[E] is
        count: int;
        [index: int]: E;
    si
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count;

        @intrinsic("array.get")
        [index: int]: E => self[index]

        iterator: Collections.Iterator[E] => ARRAY_ITERATOR[E](self)
    si

    class ARRAY_ITERATOR[E]: Collections.Iterator[E] is
        _array: E[]
        _index: int
        init(array: E[]) is _array = array; _index = -1 si
        move_next() -> bool is _index = _index + 1; return _index < _array.count si
        current: E => _array[_index]
        dispose() is si
    si

    @intrinsic("array.new")
    _array_new[E](count: int) -> E[] pure

    @intrinsic("array.set")
    _array_set[E](array: E[], index: int, value: E)

    class ENVIRONMENT is
        init() is si

        arguments: string[] static is
            let count = _argument_count()
            let result = _array_new[string](count)
            let i mut = 0

            while i < count do
                _array_set(result, i, _argument(i))
                i = i + 1
            od

            return result
        si

        lookup(name: string) -> string? static => _environment_lookup(name)

        @intrinsic("host.argument_count")
        _argument_count() -> int static

        @intrinsic("host.argument")
        _argument(index: int) -> string static

        @intrinsic("host.environment_lookup")
        _environment_lookup(name: string) -> string? static
    si
si
