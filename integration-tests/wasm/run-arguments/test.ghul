// An entry point that takes the command-line arguments is given them, and a
// host operation can answer with a string, or with none.
entry(args: string[]) is
    for argument in args do
        IO.Std.write_line(argument)
    od

    IO.Std.write_line(if Ghul.ENVIRONMENT.lookup("PATH")? then "PATH is set" else "PATH is not set" fi)
    IO.Std.write_line(Ghul.ENVIRONMENT.lookup("GHUL_TEST_NOT_SET") ?? "GHUL_TEST_NOT_SET is not set")
si
