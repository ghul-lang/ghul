// Interpolating a value whose type is a type parameter takes the text the
// instantiation gives it: generic code is compiled per instantiation.
namespace Test is
    class NAMED is
        init() is si

        to_string() -> string => "named"
    si

    show[T](value: T) -> string => "<{value}>"

    entry() is
        IO.Std.write_line(show(42))
        IO.Std.write_line(show("text"))
        IO.Std.write_line(show('c'))
        IO.Std.write_line(show(NAMED()))
    si
si
