// A call through a trait no class in the program implements can only be
// made on null, since no value is one. It compiles, and a type test that
// guards it is simply never taken. The exit status is 7.
namespace Test is
    trait Shown is
        show() -> int
    si

    class THING is
        init() is si
    si

    probe(o: object) -> int is
        if let s: Shown = o then
            return s.show()
        fi

        return 7
    si

    entry() -> int => probe(THING())
si
