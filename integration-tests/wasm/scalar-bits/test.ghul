// A floating value's bits read as the unsigned integer of the same width.
// The exit status is the number of the first check that fails.
namespace Test is
    use Ghul._double_bits
    use Ghul._single_bits

    entry() -> int is
        if !(_double_bits(1.0) == 0x3FF0000000000000ul) then return 1 fi
        if !(_double_bits(0.1) == 0x3FB999999999999Aul) then return 2 fi
        if !(_double_bits(0.0) == 0ul) then return 3 fi
        if !(_single_bits(1.0s) == 0x3F800000u) then return 4 fi
        if !(_single_bits(2.5s) == 0x40200000u) then return 5 fi

        return 0
    si
si
