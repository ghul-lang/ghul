// The operators and intrinsics the program uses, declared as the core
// library declares them: each lowers to its operation rather than to a
// call.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
si

namespace Ghul is
    @intrinsic("double.bits")
    _double_bits(value: double) -> ulong pure

    @intrinsic("single.bits")
    _single_bits(value: single) -> uint pure
si
