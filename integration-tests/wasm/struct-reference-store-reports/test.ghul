// Storing through a reference to a struct is reported as code generation
// the target does not support yet, rather than stopping the compiler.
namespace Test is
    struct POINT is
        x: int
        init(x: int) is self.x = x si
    si

    replace(target: POINT ref) is
        target! = POINT(10)
    si

    entry() -> int is
        let p mut = POINT(1)
        replace(p ref)
        return p.x
    si
si
