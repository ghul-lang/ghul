// The operations the program uses, declared as the core library declares
// them: each lowers to its operation rather than to a call.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("string.equals") =~(a: string?, b: string?) -> bool pure
    @intrinsic("compare.reference") ==(a: object?, b: object?) -> bool pure
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("string.length") _string_length(text: string) -> int pure
    @intrinsic("string.char_at") _string_char_at(text: string, index: int) -> char pure
    @intrinsic("string.concat") _string_concat(left: string, right: string) -> string pure
    @intrinsic("object.type_name") _type_name(value: object) -> string pure
si
