// Strings as structs of a descriptor, a hash and their UTF-16 code units:
// literals interned, so equal literals are the same string; == compares
// references and =~ compares code units; the length and the code units
// read from the representation; and an object's type name read from its
// descriptor. Joining two strings makes a new one holding both runs of
// code units.
namespace Test is
    class THING is
        init() is si
    si

    greeting() -> string => "hello"

    // 1 when two equal literals are the same string
    interned() -> int => if "hello" == greeting() then 1 else 0 fi

    // 1 when strings with the same code units compare equal by content
    equal(a: string, b: string) -> int => if a =~ b then 1 else 0 fi

    length(text: string) -> int => _string_length(text)

    first(text: string) -> int => cast int(_string_char_at(text, 0))

    // 1 when joining gives the code units of both, in order
    joined() -> int => if _string_concat("ab", "cd") =~ "abcd" then 1 else 0 fi

    entry() -> int =>
        interned() +
        equal("abc", "abc") * 10 +
        equal("abc", "abd") * 100 +
        length(_string_concat("", "xyz")) * 100 +
        length("hello") * 1000 +
        first("A") * 10000 +
        length(_type_name(THING())) * 1000000 +
        joined() * 100000000
si
