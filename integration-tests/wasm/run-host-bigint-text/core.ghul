// The operators the program uses, and the bigint members the core library
// takes from the host, declared as the core library declares them: bigint
// is a box around the host's arbitrary-precision integer.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
    @intrinsic("string.equals") =~(a: string?, b: string?) -> bool pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("arithmetic.neg") -(a: long) -> long pure

    @intrinsic("host.bigint_divide") /(a: bigint, b: bigint) -> bigint pure
    @intrinsic("host.bigint_remainder") %(a: bigint, b: bigint) -> bigint pure
    @intrinsic("host.bigint_negate") -(a: bigint) -> bigint pure
    @intrinsic("host.bigint_shift_left") <<(a: bigint, places: int) -> bigint pure
    @intrinsic("host.bigint_shift_right") >>(a: bigint, places: int) -> bigint pure
si

namespace Ghul is
    partial bigint is
        @intrinsic("host.bigint_multiply")
        *(a: bigint, b: bigint) -> bigint static pure

        @intrinsic("host.bigint_from_int")
        init(value: int)

        @intrinsic("host.bigint_to_string")
        _text(value: bigint) -> string static pure

        to_string() -> string => _text(self)

        op_implicit(value: int) -> bigint static pure => bigint(value)

        @intrinsic("host.bigint_from_ulong")
        init(value: ulong)

        @intrinsic("host.bigint_to_hex")
        hex(value: bigint, upper: bool) -> string static pure

        @intrinsic("host.bigint_parse")
        parse(text: string) -> bigint static pure

        @intrinsic("host.bigint_equals")
        equals(a: bigint, b: bigint) -> bool static pure

        @intrinsic("host.bigint_compare")
        compare(a: bigint, b: bigint) -> int static pure

        @intrinsic("host.bigint_to_long")
        to_long(value: bigint) -> long static pure

        @intrinsic("host.bigint_pow")
        pow(value: bigint, exponent: int) -> bigint static pure

        @intrinsic("host.bigint_mod_pow")
        mod_pow(value: bigint, exponent: bigint, modulus: bigint) -> bigint static pure
    si
si

namespace Ghul is
    partial object is
        to_string() -> string => "object"
    si
si
