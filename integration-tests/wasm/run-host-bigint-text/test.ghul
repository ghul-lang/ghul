// The host writes a bigint in hexadecimal as .NET does under X: the fewest
// digits of two's complement that hold the value and its sign, with a
// leading 0 or f where the top digit would otherwise read as the wrong
// sign; a ulong too large for a long arrives as its unsigned value; and a
// scalar is constructed from a bigint, as cast converts one, through the
// conversion the core library declares. The exit status sets a bit for each
// that holds.
namespace Test is
    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    entry() -> int is
        let result mut = 0

        result = result + bit(bigint.hex(255n, true) =~ "0FF" /\ bigint.hex(128n, true) =~ "080" /\ bigint.hex(127n, true) =~ "7F", 1)
        result = result + bit(bigint.hex(-256n, true) =~ "F00" /\ bigint.hex(-128n, true) =~ "80" /\ bigint.hex(-129n, true) =~ "F7F", 2)
        result = result + bit(bigint.hex(-1n, false) =~ "f" /\ bigint.hex(0n, true) =~ "0" /\ bigint.hex(4096n, false) =~ "1000", 4)
        result = result + bit(bigint.equals(bigint(18446744073709551615UL), 18446744073709551615n), 8)
        result = result + bit(int(bigint(42)) == 42 /\ cast int(bigint(7)) == 7, 16)

        return result
    si
si
