// An interpolated string prints through the loader with the text .NET
// gives each value.
namespace Test is
    class THING is
        init() is si

        to_string() -> string => "a thing"
    si

    entry() is
        let name = "ghūl"
        let lowest = -2147483647 + -1

        IO.Std.write_line("hello {name}: {42} {lowest} {9000000000L} {'Z'} {true} {THING()}")
    si
si
