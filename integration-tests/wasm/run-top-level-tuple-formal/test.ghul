// A file of top-level statements whose function destructures a tuple
// formal, where the tuple is declared by another source file.
IO.Std.write_line(describe(scale((2, 3), 4)))

scale((a, b): (int, int), s: int) -> int => a + s * b

describe(n: int) -> string => if n == 14 then "fourteen" else "other" fi
