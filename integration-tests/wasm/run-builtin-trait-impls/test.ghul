// A trait an `impl` block gives a built-in type is reached through a value
// of the trait and through a type parameter bounded by it, where the type
// alone implements the trait and where a class and another built-in type do
// too. The exit status is 5 + 10 * 2 + 4 * 3 + 7 * 4 + 6 * 5.
namespace Test is
    trait Sized is
        size() -> int
    si

    trait Counted is
        count() -> int
    si

    impl Sized for int is
        size() -> int => self
    si

    impl Counted for int is
        count() -> int => self * 2
    si

    impl Counted for string is
        count() -> int => _string_length(self)
    si

    class BOX: Counted is
        init() is si
        count() -> int => 7
    si

    size_of[T: Sized](value: T) -> int => value.size()

    count_of(value: Counted) -> int => value.count()

    entry() -> int is
        let sized: Sized = 5

        return sized.size() + size_of(10) * 2 + count_of("four") * 3 + count_of(BOX()) * 4 + count_of(3) * 5
    si
si
