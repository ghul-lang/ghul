// A chain ending in a join with a separator lowers to one loop on a target
// that compiles the runtime from source, as it does on .NET.
namespace Test is
    use Collections.Iterable
    use Ghul.Pipes

    class TENS: Iterable[int] is
        init() is si

        iterator: Collections.Iterator[int] => _values().iterator

        _values() -> Iterable[int] is
            yield 10
            yield 20
            yield 30
        si
    si

    entry() is
        IO.Std.write_line(TENS() |> join(", "))
        IO.Std.write_line(TENS() |> map(x => x + 1) |> join("-"))
        IO.Std.write_line(TENS() |> map(x => "<{x}>") |> join(""))
    si
si
