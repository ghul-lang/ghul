// Classes as WasmGC structs: a hierarchy with fields, constructors that
// chain to their superclass, methods called directly where nothing
// overrides them, type tests and casts against classes, references
// compared and tested for null, a static field and a global variable.
namespace Test is
    class Shape abstract is
        sides: int

        init(sides: int) is
            self.sides = sides
        si
    si

    class SQUARE: Shape is
        side: int

        init(side: int) is
            super.init(4)
            self.side = side
        si

        area() -> int => side * side
    si

    class CIRCLE: Shape is
        radius: int

        init(radius: int) is
            super.init(0)
            self.radius = radius
        si
    si

    class COUNTER is
        total: int static

        init() is si

        bump(by: int) is
            total = total + by
        si
    si

    created: int

    make(side: int) -> Shape is
        created = created + 1

        return SQUARE(side)
    si

    area(shape: Shape) -> int is
        if let square: SQUARE = shape then
            return square.area()
        fi

        return 0
    si

    sides(shape: Shape?) -> int is
        if !shape? then
            return 100
        fi

        if isa CIRCLE(shape) then
            return shape.radius
        fi

        return shape.sides
    si

    @suppress("cast-may-throw")
    as_square(shape: Shape) -> SQUARE => cast SQUARE(shape)

    same(a: Shape, b: Shape) -> bool => a == b

    total(shape: Shape) -> int is
        let counter = COUNTER()

        counter.bump(area(shape))
        counter.bump(sides(shape))

        return COUNTER.total + created
    si
si
