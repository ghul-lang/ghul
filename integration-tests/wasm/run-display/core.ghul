// The operators, string operations and scalar text the program uses,
// declared as the core library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("arithmetic.div") /(a: long, b: long) -> long pure
    @intrinsic("arithmetic.rem") %(a: long, b: long) -> long pure
    @intrinsic("compare.order") <>(a: long, b: long) -> int pure
    @intrinsic("string.equals") =~(a: string?, b: string?) -> bool pure
    @intrinsic("string.concat") _string_concat(left: string?, right: string?) -> string pure
    @intrinsic("string.from_char") _string_from_char(unit: char) -> string pure
    @intrinsic("string.length") _string_length(text: string) -> int pure
    @intrinsic("object.type_name") _type_name(value: object) -> string pure
si

namespace Ghul is
    partial object is
        to_string() -> string => _type_name(self)
    si

    partial string is
        length: int => _string_length(self)
    si
si
namespace Ghul is
    /// Accumulates the text of an interpolated string, a piece at a time.
    class STRING_BUILDER is
        _text: string?

        init() is si

        /// Appends `text` to the text built so far.
        ///
        /// - text: the text to append
        append(text: string) is
            _text = _string_concat(_text, text)
        si

        /// The text built so far.
        to_string() -> string => _string_concat(_text, "")
    si
si
namespace Ghul is
    partial char is
        /// The string holding just this UTF-16 code unit.
        to_string() -> string => _string_from_char(self)
    si

    partial int is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial long is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string is
            if self == 0L then
                return "0"
            fi

            let text mut = ""
            let rest mut = self

            // The digits come out lowest first. A negative value's
            // remainders are negative too, so each is turned to its
            // magnitude rather than the value as a whole, which has no
            // positive counterpart at its minimum.
            while !(rest == 0L) do
                let digit mut = cast int(rest % 10L)

                if digit < 0 then
                    digit = -digit
                fi

                text = _string_concat(_string_from_char(cast char(48 + digit)), text)
                rest = rest / 10L
            od

            if self < 0L then
                text = _string_concat("-", text)
            fi

            return text
        si
    si
si
namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool;
        current: E;
        dispose();
    si

    trait Iterable[E: out] is
        iterator: Iterator[E];
    si

    trait List[E: out]: Iterable[E] is
        count: int;
        [index: int]: E;
    si
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count;

        @intrinsic("array.get")
        [index: int]: E => self[index];

        iterator: Collections.Iterator[E] => ARRAY_ITERATOR[E](self);
    si

    class ARRAY_ITERATOR[E]: Collections.Iterator[E] is
        _array: E[];
        _index: int;
        init(array: E[]) is _array = array; _index = -1; si
        move_next() -> bool is _index = _index + 1; return _index < _array.count; si
        current: E => _array[_index];
        dispose() is si
    si
si

namespace IO is
    class Std is
        write_line(text: string) static is
            _write(text, 1)
            _write("\n", 1)
        si

        @intrinsic("host.write")
        _write(text: string, stream: int) static
    si
si
