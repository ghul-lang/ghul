// The display surface the program uses, declared as the core library
// declares it: `$` renders what has no text of its own through the
// displayer the compiler gives its type.
namespace Ghul is
    trait Displayable open is
        display(state: DISPLAY_STATE)
    si

    class DISPLAY_STATE is
        _text: STRING_BUILDER
        _count: int

        init() is
            _text = STRING_BUILDER()
        si

        append(text: string) is
            _text.append(text)
        si

        render(value: object?) is
            if !value? then
                append("null")
            elif let text: string = value then
                append(text)
            elif let flag: bool = value then
                append(if flag then "true" else "false" fi)
            elif let displayable: Displayable = value then
                displayable.display(self)
            elif !_display(value, self) then
                append(value.to_string())
            fi
        si

        to_string() -> string => _text.to_string()

        _begin_members(type_name: string) is
            append(type_name)
            _count = 0
        si

        _member[T](name: string, value: T) -> bool is
            append(if _count == 0 then "(" else ", " fi)
            append(name)
            append(" = ")
            render(value)
            _count = _count + 1

            return true
        si

        _end_members() is
            if !(_count == 0) then
                append(")")
            fi
        si

        _begin_parts() is
            append("(")
            _count = 0
        si

        _part[T](value: T) is
            if !(_count == 0) then
                append(", ")
            fi

            render(value)
            _count = _count + 1
        si

        _end_parts() is
            append(")")
        si

        _elements[T](items: Collections.Iterable[T]) is
            append("[...]")
        si
    si

    partial TUPLE_2 is
        `0: T1 field

        `1: T2 field

        init(e0: T1, e1: T2) is
            `0 = e0
            `1 = e1
        si
    si

    @intrinsic("object.display")
    _display(value: object, state: DISPLAY_STATE) -> bool
si

namespace Ghul.Intrinsics is
    $(value: object?) -> string is
        let state = Ghul.DISPLAY_STATE()

        state.render(value)

        return state.to_string()
    si
si
