// A format the core library's formatter does not cover, and a format on a
// value .NET formats that the wasm target has no formatter for, are reported
// at the function rather than written differently.
namespace Test is
    enum Colour is
        RED,
        GREEN
    si

    dated(n: int) -> string => "{n:yyyy-MM-dd}"

    hex(d: double) -> string => "{d:X4}"

    named(c: Colour) -> string => "{c:D}"
si
