// A method the core library gives every object and overrides for strings
// reaches the string's override through a type parameter instantiated at
// string and through an object holding a string, as well as directly. The
// exit status is 40 + 40 * 2 + 40 * 3 + 7.
namespace Test is
    class THING is
        init() is si
    si

    of_generic[T](x: T) -> int => x.code()

    of_object(o: object) -> int => o.code()

    entry() -> int =>
        of_generic("s") + of_object("s") * 2 + "s".code() * 3 + of_generic(THING())
si
