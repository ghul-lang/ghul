// Runs =~ and get_hash_code over a type parameter, compiled for each
// instantiation: scalars, a class with its own =~, a class compared by
// reference, and a struct. The exit status is the number of the first
// check that fails, or 0, as the .NET build returns.
namespace Test is
    class POINT is
        x: int
        init(x: int) is self.x = x si
        =~(other: POINT) -> bool pure => x == other.x
        get_hash_code() -> int => x
    si

    struct KEY(a: int public, b: int public)

    class THING is
        init() is si
    si

    same[T](a: T, b: T) -> bool => a =~ b

    hash[T](a: T) -> int => a.get_hash_code()

    entry() -> int is
        let t = THING()

        let checks = [
            same(1, 1), !same(1, 2),
            same(7L, 7L), !same(7L, 8L),
            same(2.5, 2.5), !same(2.5, 3.5),
            same(POINT(3), POINT(3)), !same(POINT(3), POINT(4)),
            same(t, t), !same(t, THING()),
            same(KEY(1, 2), KEY(1, 2)), !same(KEY(1, 2), KEY(2, 1)),
            hash(7) == 7, hash(POINT(9)) == 9,
            hash(KEY(1, 2)) == hash(KEY(1, 2)), hash(KEY(1, 2)) != hash(KEY(2, 1))
        ]

        let i mut = 0

        while i < checks.count do
            if !checks[i] then
                return i + 1
            fi

            i = i + 1
        od

        return 0
    si
si
