// A static constructor runs once, before its type is first used: here
// on the first call to a static method, and not again when an instance
// is made later.
namespace Test is
    class LOG is
        steps: int static
        init() is si
        step(n: int) static is steps = steps * 10 + n si
    si

    class LAZY is
        value: int static

        init() static is
            LOG.step(1)
            value = 7
        si

        init() is si

        get() -> int static => value
    si

    run() -> int is
        LOG.step(2)
        let first = LAZY.get()
        LOG.step(3)
        let second = LAZY.get()
        let thing = LAZY()
        return LOG.steps * 1000 + first * 10 + second
    si
si
