// Virtual calls through a class's vtable, trait calls through the trait
// table with a default method filling the rows of the classes that do
// not override it, and type tests and casts against a trait, which a
// boxed scalar does not implement.
namespace Test is
    trait Named is
        id() -> int
        twice() -> int => id() * 2
    si

    class ANIMAL: Named is
        init() is si
        legs() -> int => 4
        id() -> int => 1
    si

    class BIRD: ANIMAL is
        init() is super.init() si
        legs() -> int => 2
        id() -> int => 3
    si

    class ROBOT: Named is
        init() is si
        id() -> int => 5
        twice() -> int => 100
    si

    count(a: ANIMAL) -> int => a.legs()

    class PLAIN is
        init() is si
    si

    kind(o: object) -> int is
        if isa Named(o) then
            return 1
        fi
        return 0
    si

    as_named(o: object) -> int is
        if let n: Named = o then
            return n.id()
        fi
        return 7
    si

    name_of(n: Named) -> int => n.id() * 10 + n.twice()
si
