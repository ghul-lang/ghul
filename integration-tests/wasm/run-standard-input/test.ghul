// Standard input read a line, a character and the rest at a time, with
// lines ending at a line feed, a carriage return, or both.
if let line = IO.Std.read_line() then
    IO.Std.write_line(line)
fi

if IO.Std.peek() == 88 /\ IO.Std.read() == 88 then
    IO.Std.write_line("X")
fi

while let line = IO.Std.read_line() do
    IO.Std.write_line(line)

    if line =~ "stop" then
        break
    fi
od

IO.Std.write_line(IO.Std.read_to_end())

if !IO.Std.read_line()? /\ IO.Std.read() == -1 then
    IO.Std.write_line("end")
fi
