// Runs named tuple elements read through an array literal of tuple
// literals, a for over it, a local initialised from one, and a function's
// return. The exit status is 736, low byte.
namespace Test is
    corner() -> (x: int, y: int) => (x = 7, y = 9)

    entry() -> int is
        let points = [(x = 1, y = 3), (x = 2, y = 4)]
        let first = points[0]

        let total mut = first.y

        for point in points do
            total = total + point.x * 10
        od

        let pair = (a = 6, b = 7)
        total = total + pair.b * 100

        let c = corner()

        return total + c.y - pair.a + points[1].y - 4
    si
si
