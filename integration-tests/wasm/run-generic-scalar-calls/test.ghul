// A call on a type parameter's value reaches a scalar's own member once
// the instantiation makes it a scalar, and a call through a trait nothing
// in the program implements compiles, since no value can reach it.
namespace Test is
    class NAMED is
        init() is si

        to_string() -> string => "named"
    si

    class COUNTDOWN(limit: int): Collections.Iterable[int], Collections.Iterator[int] is
        _left: int

        iterator: Collections.Iterator[int] is
            _left = limit
            return self
        si

        move_next() -> bool is
            _left = _left - 1
            return !(_left < 0)
        si

        current: int => _left

        dispose() is si
    si

    text_of[T](value: T) -> string => value.to_string()

    size[T](source: Collections.Iterable[T]) -> int is
        if isa Collections.MutableBag[T](source) then
            return source.count
        fi

        let counted mut = 0

        for _ in source do
            counted = counted + 1
        od

        return counted
    si

    entry() is
        IO.Std.write_line(text_of(42))
        IO.Std.write_line(text_of(-9000000000L))
        IO.Std.write_line(text_of('q'))
        IO.Std.write_line(text_of(NAMED()))
        IO.Std.write_line("{size(COUNTDOWN(3))}")
    si
si
