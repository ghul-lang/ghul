// Runs generic code compiled once per instantiation: generic classes and
// functions, a generic method, a generic trait with a default method,
// static state per instantiation, and an override in a generic subclass.
// The exit status is the low byte of the same value the .NET build returns.
namespace Test is
    trait Source[T] is
        next() -> T
        twice() -> T => next()
    si

    class COUNTER: Source[int] is
        n: int
        init() is si
        next() -> int is n = n + 1; return n si
    si

    class REPEAT[T]: Source[T] is
        value: T
        init(value: T) is self.value = value si
        next() -> T => value
    si

    class CELL[T] is
        made: int static
        value: T
        init(value: T) is self.value = value; made = made + 1 si
        map[U](f: T -> U) -> CELL[U] => CELL[U](f(value))
        get() -> T => value
    si

    class BASE[T] is
        init() is si
        pick(a: T, b: T) -> T => a
    si

    class SECOND[T]: BASE[T] is
        init() is super.init() si
        pick(a: T, b: T) -> T => b
    si

    pull[T](s: Source[T]) -> T => s.next()

    choose[T](chooser: BASE[T], a: T, b: T) -> T => chooser.pick(a, b)

    entry() -> int is
        let c = COUNTER()
        let r = REPEAT[int](7)
        let total mut = pull(c) + pull(c) * 10 + pull(r) * 100 + r.twice() * 1000
        let cell = CELL[int](3)
        let mapped = cell.map(x => cast long(x) * 2L)
        let other = CELL[long](5L)
        total = total + cast int(mapped.get()) * 10000 + CELL[int].made * 100000 + CELL[long].made * 1000000
        total = total + choose(BASE[int](), 1, 2) * 10000000 + choose(SECOND[int](), 1, 2) * 100000000
        return total
    si
si
