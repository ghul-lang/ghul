// Runs a scalar type called as a constructor from another scalar, which
// converts exactly as a cast to it does: widening, narrowing with
// wrapping, between integer and floating, and to and from char. The exit
// status is 100 plus a bit for each check that failed.
namespace Test is
    check(passed: bool, bit: int) -> int => if passed then 0 else bit fi

    entry() -> int is
        let n = 7
        let big = 300
        let c = 'A'
        let d = 3.75

        return 100 +
            check(double(n) == 7.0, 1) +
            check(int(c) == 65, 2) +
            check(char(66) == 'B', 4) +
            check(long(n) == 7L, 8) +
            check(ubyte(big) == 44ub, 16) +
            check(int(d) == 3, 32) +
            check(single(n) == 7.0s, 64) +
            check(byte(200) == cast byte(200), 128)
    si
si
