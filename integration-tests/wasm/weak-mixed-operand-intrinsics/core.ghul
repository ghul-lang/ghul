// A core library's arithmetic, with a weak mixed overload beside the
// same-kind ones: each lowers to its operation rather than to a call, and
// the mixed one converts its int operand to double first.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: double, b: double) -> double pure

    @weak_overload()
    @intrinsic("arithmetic.mul") *(a: int, b: double) -> double pure

    @weak_overload()
    @intrinsic("arithmetic.mul") *(a: double, b: int) -> double pure
si
