// A mixed int and double operation converts the int operand to double and
// multiplies in double, on whichever side the int is. Where an operand is
// still unsettled, the weak mixed overload yields: `y * 2.0` settles `y`
// as double, not int.
namespace Test is
    scale(x: int, f: double) -> double => x * f
    scale_right(f: double, x: int) -> double => f * x
    same_kind(a: int, b: int) -> int => a * b
    twice(f: double) -> double =>
        let doubled = y => y * 2.0 in doubled(f)
si
