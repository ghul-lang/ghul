// Function values: a lambda capturing a local through its frame, a
// lambda capturing nothing, a global function and a bound method taken as
// values, a function value held in a field, and calls through each.
namespace Test is
    apply(f: int -> int, x: int) -> int => f(x)

    double(x: int) -> int => x * 2

    class ADDER is
        n: int
        init(n: int) is self.n = n si
        add(x: int) -> int => x + n
    si

    class SINK is
        seen: int
        init() is si
        take(x: int) -> int is seen = seen + x; return 0 si
    si

    class HOLDER is
        f: int -> int
        init(f: int -> int) is self.f = f si
        run(x: int) -> int => f(x)
    si

    each(f: int -> int, x: int) is f(x) si

    run() -> int is
        let k = 3
        let addk = (x: int) => x + k
        let a = ADDER(10)
        let s = SINK()
        each(s.take, 3)
        each(x => s.take(x * 2), 4)
        let h = HOLDER(x => x * x)
        return apply(addk, 1) + apply(double, 2) * 10 + apply(a.add, 4) * 100 + apply(x => x + 1, 5) * 1000 + h.run(7) * 10000 + s.seen * 1000000
    si
si
