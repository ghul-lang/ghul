// A struct holding state that is not public gets no synthesised =~, so
// comparing two of them, directly or as a field of another struct, is
// reported on the wasm target as on .NET rather than compared by reference.
namespace Test is
    struct SECRET(_value: int)

    struct OUTER(inner: SECRET public)

    same_outer(a: OUTER, b: OUTER) -> bool => a =~ b

    same(a: SECRET, b: SECRET) -> bool => a =~ b
si
