// A scalar stored as object is boxed with its own type's descriptor, so a
// boxed int and a boxed long answer type tests differently, and a cast
// back to the scalar unboxes.
namespace Test is
    class HOLDER is
        held: object
        init(held: object) is self.held = held si
    si

    kind(o: object) -> int is
        if isa int(o) then
            return 1
        fi
        if isa long(o) then
            return 2
        fi
        if isa HOLDER(o) then
            return 3
        fi
        return 0
    si

    run() -> int is
        let a: object = 5
        let b: object = 7L
        let h = HOLDER(a)
        let c: object = h
        let back = cast int(h.held)
        return kind(a) + kind(b) * 10 + kind(c) * 100 + kind(h.held) * 1000 + back * 10000000
    si
si
