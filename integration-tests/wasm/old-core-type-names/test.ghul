// The core types' old .NET names are second spellings of the types the
// core library declares under their ghūl names: imported, constructed,
// caught and named in a whole-namespace import.
namespace Test is
    use IO.Std
    use System.InvalidOperationException

    raise(code: int) is
        throw InvalidOperationException(code)
    si

    entry() is
        try
            raise(1)
        catch e: System.Exception
            Std.write_line(if e.code == 1 then "caught by old name" else "wrong code" fi)
        yrt

        try
            throw System.Exception(2)
        catch e: Ghul.Exception
            Std.write_line(if e.code == 2 then "old name constructs the new type" else "wrong code" fi)
        yrt

        Std.write_line(Other.describe())
    si
si

namespace Other is
    use System

    describe() -> string =>
        if isa Exception(Ghul.Exception(3)) then "namespace import reaches old names" else "not reached" fi
si
