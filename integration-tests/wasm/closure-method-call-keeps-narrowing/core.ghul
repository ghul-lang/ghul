// The operators the program uses, and the box a captured local is held in,
// as the core library declares them: the value in a field.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("bool.not") !(a: bool) -> bool pure
si

namespace Ghul is
    class BOX[T] is
        value: T field public

        init() is si

        init(value: T) is self.value = value si
    si
si
