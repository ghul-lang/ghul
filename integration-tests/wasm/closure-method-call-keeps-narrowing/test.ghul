// A method called on an immutable local inside a closure leaves the local's
// narrowing alone: a closure calling a method of a local is not assigning it.
namespace Test is
    class THING is
        hook: () -> void

        init(hook: () -> void) is
            self.hook = hook
        si

        // Calls a function value, which the analysis cannot see into: like
        // a call into another assembly, it may write anything.
        touch() is
            hook()
        si

        run() -> int => 1
    si

    capture(f: () -> int) -> int => f()

    find(source: THING?) -> int is
        let entry = source

        if !entry? then
            return 0
        fi

        entry.touch()

        return capture(() -> int => entry.run())
    si
si
