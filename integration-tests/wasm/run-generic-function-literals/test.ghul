// Function literals written inside generic functions and generic classes,
// with and without captures, called at the type arguments the program
// gives them.
twice[T](value: T, f: (T) -> T) -> T is
    let again = (x: T) -> T => f(f(x))

    return again(value)
si

same[T]() -> (T) -> T => (x: T) -> T => x

class BOX[T] is
    value: T

    init(value: T) is
        self.value = value
    si

    map(f: (T) -> T) -> BOX[T] => BOX(f(value))

    with(other: T) -> BOX[T] => BOX(same[T]()(other))
si

entry() -> int is
    let doubled = twice(3, x => x * 2)
    let mapped = BOX(5).map(x => x + 1).value
    let replaced = BOX(0).with(7).value

    // The exit status is 12 + 6 + 7.
    return doubled + mapped + replaced
si
