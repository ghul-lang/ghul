// The operators the program uses, declared as the core library declares
// them: each lowers to its operation rather than to a call.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("range.exclusive") ..(from: int, to: int) -> Ghul.INT_RANGE pure
    @intrinsic("range.inclusive") ::(from: int, to: int) -> Ghul.INT_RANGE_INCLUSIVE pure
si

namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool
        current: E
        dispose()
    si

    trait Iterable[E: out] is
        iterator: Iterator[E]
    si

    trait List[E: out]: Iterable[E] is
        count: int;
        [index: int]: E;
    si
si

// The two range types, declared as the core library declares them.
namespace Ghul is
    use Collections

    struct INT_RANGE: Iterable[int], Iterator[int] is
        iterator: Iterator[int] => self

        from: int
        to: int
        current: int

        init(from: int, to: int) is
            self.from = from
            self.to = to

            current = from - 1
        si

        move_next() -> bool is
            current = current + 1
            return current < to
        si

        dispose() is si

        get_hash_code() -> int => from
    si

    struct INT_RANGE_INCLUSIVE: Iterable[int], Iterator[int] is
        iterator: Iterator[int] => self

        from: int
        to: int
        current: int

        init(from: int, to: int) is
            self.from = from
            self.to = to

            current = from - 1
        si

        move_next() -> bool is
            current = current + 1
            return current <= to
        si

        dispose() is si

        get_hash_code() -> int => from
    si
si
