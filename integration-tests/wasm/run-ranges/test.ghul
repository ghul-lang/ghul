// Loops over both kinds of range, in a function and in a generator. The
// exit status is the low byte of the same value the .NET build returns.
namespace Test is
    squares(n: int) -> Collections.Iterable[int] is
        for i in 1::n do
            yield i * i
        od
    si

    entry() -> int is
        let total mut = 0

        for i in 0..4 do
            total = total * 10 + i
        od

        for square in squares(3) do
            total = total * 10 + square
        od

        return total - 123142
    si
si
