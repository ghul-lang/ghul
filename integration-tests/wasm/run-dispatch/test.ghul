// Runs virtual calls, trait calls with a default method, and type tests
// against a trait. The exit status is the low byte of the same value the
// .NET build returns.
namespace Test is
    trait Named is
        id() -> int
        twice() -> int => id() * 2
    si

    class ANIMAL: Named is
        init() is si
        legs() -> int => 4
        id() -> int => 1
    si

    class BIRD: ANIMAL is
        init() is super.init() si
        legs() -> int => 2
        id() -> int => 3
    si

    class ROBOT: Named is
        init() is si
        id() -> int => 5
        twice() -> int => 100
    si

    count(a: ANIMAL) -> int => a.legs()

    class PLAIN is
        init() is si
    si

    kind(o: object) -> int is
        if isa Named(o) then
            return 1
        fi
        return 0
    si

    as_named(o: object) -> int is
        if let n: Named = o then
            return n.id()
        fi
        return 7
    si

    name_of(n: Named) -> int => n.id() * 10 + n.twice()

    entry() -> int is
        let a = ANIMAL()
        let b = BIRD()
        let r = ROBOT()
        let p = PLAIN()
        let tests = kind(a) + kind(b) * 2 + kind(r) * 4 + kind(p) * 8 + kind(5) * 16 + as_named(b) * 100 + as_named(p) * 1000
        return tests * 1000000000 * 0 + tests + 0 * count(a) + count(b) * 10 + name_of(a) * 100 + name_of(b) * 10000 + name_of(r) * 1000000
    si
si
