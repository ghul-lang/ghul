// Runs a growable collection built over arrays the core library allocates
// and stores into: of a scalar, and of a class with a subclass, whose
// stores are checked. The exit status is the low byte of
// 3 + 5 * 10 + 4 * 100 + 1 * 1000 + 2 * 10000.
namespace Ghul is
    class BAG[T] is
        _items: T[]
        _count: int
        init() is _items = _array_new[T](4); _count = 0 si
        add(item: T) is _array_set(_items, _count, item); _count = _count + 1 si
        at(i: int) -> T => _items[i]
        count: int => _count
    si
si

namespace Test is
    class SHAPE is
        init() is si
        area() -> int => 1
    si
    class SQUARE: SHAPE is
        init() is super.init() si
        area() -> int => 4
    si

    entry() -> int is
        let ints = Ghul.BAG[int]()
        ints.add(3)
        ints.add(5)
        let shapes = Ghul.BAG[SHAPE]()
        shapes.add(SQUARE())
        shapes.add(SHAPE())
        return ints.at(0) + ints.at(1) * 10 + shapes.at(0).area() * 100 + shapes.at(1).area() * 1000 + ints.count * 10000
    si
si
