// Runs value-type optionals: an int? present and absent, passed, returned
// and tested, a defaulted one, ?? over one, and a struct? present and
// absent. The exit status is the low byte of the same value the .NET
// build returns.
namespace Test is
    struct POINT is
        x: int field
        _tag: int

        init(x: int) is
            self.x = x
            _tag = 0
        si
    si

    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    payload(x: int?) -> int => if x? then x else 0 fi

    some(x: int) -> int? => x

    none() -> int? => null

    x_of(p: POINT?) -> int => if p? then p.x else -1 fi

    entry() -> int is
        let result mut = 0

        // 1: a present int? reads its value
        result = result + bit(payload(5) == 5, 1)

        // 2: an absent int? is absent
        result = result + bit(payload(null) == 0, 2)

        // 4: returned and tested
        result = result + bit(some(3)? /\ !none()?, 4)

        // 8: a defaulted int? local is absent
        let d: int? mut = _
        result = result + bit(!d?, 8)

        // 16: ?? falls back only when absent
        result = result + bit((some(7) ?? 1) == 7 /\ (none() ?? 1) == 1, 16)

        // 32: a struct? present and absent
        result = result + bit(x_of(POINT(9)) == 9 /\ x_of(null) == -1, 32)

        return result
    si
si
