// On wasm a mutable local that a closure captures cannot be passed by
// reference, whatever it holds, and a method that can change a struct
// cannot be called on one: the closures would not see the change.
namespace Test is
    struct COUNTER is
        count: int field

        init(count: int) is
            self.count = count
        si

        step() is
            count = count + 1
        si
    si

    bump(value: int ref) is
        value! = 2
    si

    set_text(value: string ref) is
        value! = "set"
    si

    scalar() is
        let n mut = 1
        let read = () => n
        bump(n ref)
    si

    reference() is
        let s mut = ""
        let read = () => s
        set_text(s ref)
    si

    struct_method() is
        let c mut = COUNTER(1)
        let read = () => c.count
        c.step()
    si

    entry() is
        scalar()
        reference()
        struct_method()
    si
si
