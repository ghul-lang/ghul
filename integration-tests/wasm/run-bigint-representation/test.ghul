// A bigint holds its value in the box's i64 exactly when the value fits:
// from a literal or a constructor, at both ends of the i64's range, and
// when the host answers a value that fits. A value held either way reaches
// the host as its own integer. The exit status sets a bit for each that
// holds.
namespace Test is
    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    entry() -> int is
        let result mut = 0

        result = result + bit(bigint.is_small(5n) /\ bigint.small(5n) == 5L, 1)
        result = result + bit(bigint.is_small(9223372036854775807n), 2)
        result = result + bit(!bigint.is_small(9223372036854775808n), 4)

        let lowest = -9223372036854775808n
        result = result + bit(bigint.is_small(lowest) /\ bigint.small(lowest) == -9223372036854775807L - 1L, 8)

        let large = bigint.pow(bigint(2L), 70)
        result = result + bit(!bigint.is_small(large) /\ bigint.text(large) =~ "1180591620717411303424", 16)

        let quotient = large / bigint.pow(bigint(2L), 65)
        result = result + bit(bigint.is_small(quotient) /\ bigint.small(quotient) == 32L, 32)

        result = result + bit(bigint.is_small(bigint(7L)) /\ bigint.text(bigint(7L)) =~ "7", 64)
        result = result + bit(bigint.equals(quotient, 32n) /\ !bigint.equals(large, 32n), 128)

        return result
    si
si
