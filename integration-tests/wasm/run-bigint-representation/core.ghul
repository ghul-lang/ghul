// The bigint members the test reaches, declared as the core library
// declares them: a bigint holds its value in an i64 while it fits, and the
// host's integer otherwise, and whatever the host answers is moved back into
// the i64 where it fits.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
    @intrinsic("bool.or_else") \/ (a: bool, b: bool) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("string.equals") =~(a: string?, b: string?) -> bool pure
    @intrinsic("arithmetic.neg") -(a: long) -> long pure
    @intrinsic("arithmetic.sub") -(a: long, b: long) -> long pure

    @intrinsic("host.bigint_divide") /(a: bigint, b: bigint) -> bigint pure
    @intrinsic("host.bigint_negate") -(a: bigint) -> bigint pure
si

namespace Ghul is
    partial bigint is
        @intrinsic("bigint.of_small")
        init(value: long)

        @intrinsic("bigint.is_small")
        is_small(value: bigint) -> bool static pure

        @intrinsic("bigint.small")
        small(value: bigint) -> long static pure

        @intrinsic("host.bigint_from_long")
        _host_from_long(value: long) -> bigint static pure

        @intrinsic("host.bigint_bit_length")
        _bit_length(value: bigint) -> int static pure

        @intrinsic("host.bigint_to_long")
        _host_to_long(value: bigint) -> long static pure

        _canonical(value: bigint) -> bigint static =>
            if is_small(value) \/ _bit_length(value) > 63 then value else bigint(_host_to_long(value)) fi

        @intrinsic("host.bigint_parse")
        parse(text: string) -> bigint static pure

        @intrinsic("host.bigint_to_string")
        text(value: bigint) -> string static pure

        @intrinsic("host.bigint_equals")
        equals(a: bigint, b: bigint) -> bool static pure

        @intrinsic("host.bigint_pow")
        pow(value: bigint, exponent: int) -> bigint static pure
    si
si
