// A generic class whose methods instantiate it at type arguments built from
// its own has no finite set of instantiations to compile. That is reported,
// rather than followed until the compiler runs out of time or memory.
namespace Test is
    class BOX[T] is
        value: T
        init(value: T) is self.value = value si
    si

    class NODE[T] is
        value: T
        init(value: T) is self.value = value si

        boxed(value: T) -> NODE[BOX[T]] => NODE(BOX(value))
        wrap() -> NODE[NODE[T]] => NODE(self)
    si

    entry() -> int is
        let n = NODE(1)
        return 0
    si
si
