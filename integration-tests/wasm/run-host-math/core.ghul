// The operators the program uses, and some of the floating-point
// functions the core library's Math takes from the host, declared as the
// core library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: double, b: double) -> double pure
si

namespace Test is
    @intrinsic("host.math_sqrt") sqrt(x: double) -> double pure
    @intrinsic("host.math_floor") floor(x: double) -> double pure
    @intrinsic("host.math_ceiling") ceiling(x: double) -> double pure
    @intrinsic("host.math_pow") pow(x: double, y: double) -> double pure
    @intrinsic("host.math_atan2") atan2(y: double, x: double) -> double pure
    @intrinsic("host.math_log10") log10(x: double) -> double pure
si
