// The floating-point functions the host provides answer as .NET's Math
// does. The exit status is 12 + 2 + 3 + 32 + 45 + 3.
namespace Test is
    entry() -> int =>
        cast int(sqrt(144.0)) +
        cast int(floor(2.7)) +
        cast int(ceiling(2.1)) +
        cast int(pow(2.0, 5.0)) +
        cast int(atan2(1.0, 1.0) * 57.29577951308232) +
        cast int(log10(1000.0))
si
