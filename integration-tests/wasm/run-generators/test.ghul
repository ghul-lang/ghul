// Runs generators of each shape the lowering re-enters: a resume point in
// the body, in a loop, in nested loops, under a condition, after an early
// return, through `yield in`, and in a function literal. The exit status
// is 100 plus a bit for each check that failed.
namespace Test is
    use Collections.Iterable

    plain() -> Iterable[int] is
        yield 1
        yield 2
        yield 3
    si

    count(n: int) -> Iterable[int] is
        let i mut = 0

        while i < n do
            yield i
            i = i + 1
        od
    si

    pairs(n: int) -> Iterable[int] is
        for i in count(n) do
            for j in count(i) do
                yield i * 10 + j
            od
        od
    si

    evens(n: int) -> Iterable[int] is
        for i in count(n) do
            if i % 2 == 0 then
                yield i
            fi
        od
    si

    stops_early() -> Iterable[int] is
        yield 1
        yield 2
        return
        yield 3
    si

    down(n: int) -> Iterable[int] is
        if n > 0 then
            yield n
            yield in down(n - 1)
        fi
    si

    digits(values: Iterable[int]) -> int is
        let result mut = 0

        for value in values do
            result = result * 10 + value
        od

        return result
    si

    sum(values: Iterable[int]) -> int is
        let result mut = 0

        for value in values do
            result = result + value
        od

        return result
    si

    check(passed: bool, bit: int) -> int => if passed then 0 else bit fi

    entry() -> int is
        let squares = (n: int) -> Iterable[int] is
            for i in count(n) do
                yield i * i
            od
        si

        let twice = plain()

        let failed =
            check(digits(plain()) == 123, 1) +
            check(sum(count(5)) == 10, 2) +
            check(digits(pairs(3)) == 10 * 100 + 20 * 10 + 21, 4) +
            check(digits(evens(5)) == 24, 8) +
            check(digits(stops_early()) == 12, 16) +
            check(digits(down(4)) == 4321, 32) +
            check(sum(squares(4)) == 14, 64) +
            check(digits(twice) + digits(twice) == 246, 128)

        return 100 + failed
    si
si
