// The operators the program uses, declared as the core library declares
// them: each lowers to its operation rather than to a call.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure

    @intrinsic("arithmetic.add") +(a: byte, b: byte) -> byte pure
    @intrinsic("arithmetic.sub") -(a: byte, b: byte) -> byte pure
    @intrinsic("arithmetic.mul") *(a: byte, b: byte) -> byte pure
    @intrinsic("arithmetic.neg") -(a: byte) -> byte pure
    @intrinsic("arithmetic.not") \(a: byte) -> byte pure
    @intrinsic("arithmetic.shl") <<(a: byte, b: int) -> byte pure
    @intrinsic("arithmetic.ushr") >>>(a: byte, b: int) -> byte pure

    @intrinsic("arithmetic.add") +(a: ubyte, b: ubyte) -> ubyte pure
    @intrinsic("arithmetic.sub") -(a: ubyte, b: ubyte) -> ubyte pure
    @intrinsic("arithmetic.mul") *(a: ubyte, b: ubyte) -> ubyte pure
    @intrinsic("arithmetic.not") \(a: ubyte) -> ubyte pure
    @intrinsic("arithmetic.shl") <<(a: ubyte, b: int) -> ubyte pure

    @intrinsic("arithmetic.add") +(a: short, b: short) -> short pure
    @intrinsic("arithmetic.sub") -(a: short, b: short) -> short pure
    @intrinsic("arithmetic.mul") *(a: short, b: short) -> short pure
    @intrinsic("arithmetic.neg") -(a: short) -> short pure
    @intrinsic("arithmetic.not") \(a: short) -> short pure
    @intrinsic("arithmetic.shl") <<(a: short, b: int) -> short pure
    @intrinsic("arithmetic.ushr") >>>(a: short, b: int) -> short pure

    @intrinsic("arithmetic.add") +(a: ushort, b: ushort) -> ushort pure
    @intrinsic("arithmetic.sub") -(a: ushort, b: ushort) -> ushort pure
    @intrinsic("arithmetic.mul") *(a: ushort, b: ushort) -> ushort pure
    @intrinsic("arithmetic.not") \(a: ushort) -> ushort pure
    @intrinsic("arithmetic.shl") <<(a: ushort, b: int) -> ushort pure
si
