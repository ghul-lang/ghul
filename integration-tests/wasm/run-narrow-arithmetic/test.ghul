// Runs arithmetic on each narrow integer kind and compares each result,
// unstored, with the value .NET gives: a result past the kind's range
// wraps to its width. The exit status is the number of results that
// differ.
namespace Test is
    entry() -> int is
        let ub: ubyte = 255ub
        let ub_zero: ubyte = 0ub
        let ub_sixteen: ubyte = 16ub
        let b: byte = 127b
        let us: ushort = 65535us
        let us_zero: ushort = 0us
        let s: short = 32767s

        let failures mut = 0

        if !(ub + 1ub == 0ub) then failures = failures + 1 fi
        if !(ub_zero - 1ub == 255ub) then failures = failures + 1 fi
        if !(ub * ub == 1ub) then failures = failures + 1 fi
        if !(ub_sixteen << 4 == 0ub) then failures = failures + 1 fi
        if !(\ub_zero == 255ub) then failures = failures + 1 fi

        if !(b + 1b == \127b) then failures = failures + 1 fi
        if !(-b - 2b == 127b) then failures = failures + 1 fi
        if !(b * b == 1b) then failures = failures + 1 fi
        if !(b << 1 == -2b) then failures = failures + 1 fi

        if !(us + 1us == 0us) then failures = failures + 1 fi
        if !(us_zero - 1us == 65535us) then failures = failures + 1 fi
        if !(us * us == 1us) then failures = failures + 1 fi
        if !(us << 1 == 65534us) then failures = failures + 1 fi
        if !(\us_zero == 65535us) then failures = failures + 1 fi

        if !(s + 1s == \32767s) then failures = failures + 1 fi
        if !(-s - 2s == 32767s) then failures = failures + 1 fi
        if !(s * s == 1s) then failures = failures + 1 fi
        if !(s << 1 == -2s) then failures = failures + 1 fi

        return failures
    si
si
