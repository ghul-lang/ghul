// A tuple's own get_hash_code fills the root's slot, so a call through an
// object runs it: two pairs that differ hash differently, and equal pairs alike.
namespace Test is
    hash(value: object) -> int => value.get_hash_code()

    entry() -> int is
        let first: object = (1, 2)
        let second: object = (3, 4)
        let again: object = (1, 2)

        if hash(first) != hash(second) /\ hash(first) == hash(again) /\ hash(first) == 33 then
            return 0
        fi

        return 1
    si
si
