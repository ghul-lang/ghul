// What the program uses, declared as the core library declares it: the root's
// get_hash_code, and a pair that hashes its elements, so a tuple reached as an
// object answers with its own hash rather than the root's.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("compare.value") !=[T](a: T, b: T) -> bool pure
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
si

namespace Ghul is
    partial object is
        get_hash_code() -> int => 1
    si

    partial int is
        get_hash_code() -> int => self
    si

    partial TUPLE_2 is
        `0: T1 field
        `1: T2 field

        init(e0: T1, e1: T2) is
            `0 = e0
            `1 = e1
        si

        get_hash_code() -> int => `0.get_hash_code() * 31 + `1.get_hash_code()
    si
si
