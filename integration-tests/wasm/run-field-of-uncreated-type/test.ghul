// A field can hold an array, or an instance of a generic class, that the
// program never creates: the field's own type is enough to lay it out.
namespace Test is
    class BOX[T] is
        value: T

        init(value: T) is
            self.value = value
        si
    si

    class HOLDER is
        _values: long[]?
        _box: BOX[double]?
        _boxes: BOX[long][]?
        count: int
        _shared: BOX[string][]? static

        init() is
            count = 3
        si

        describe() -> string => "{count} {_values?} {_box?} {_boxes?} {_shared?}"
    si

    entry() is
        IO.Std.write_line(HOLDER().describe())
    si
si
