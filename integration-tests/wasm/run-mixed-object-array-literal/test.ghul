// Runs an array literal whose elements are a string, an int and a long,
// typed object[]: each value-typed element is boxed as it is stored, so it
// answers a type test as its own type and casts back. The exit status is
// 100 plus a bit for each check that failed.
namespace Test is
    kind(o: object) -> int is
        if isa int(o) then
            return 1
        fi
        if isa long(o) then
            return 2
        fi
        if isa string(o) then
            return 3
        fi
        return 0
    si

    check(passed: bool, bit: int) -> int => if passed then 0 else bit fi

    entry() -> int is
        let mixed = ["one", 2, 3L]

        return 100 +
            check(kind(mixed[0]) == 3, 1) +
            check(kind(mixed[1]) == 1, 2) +
            check(kind(mixed[2]) == 2, 4) +
            check(cast int(mixed[1]) == 2, 8)
    si
si
