// An index by a from-the-end range resolves its endpoints against the
// source's length. The exit status is where the slice starts times ten
// plus its length.
namespace Test is
    class SOURCE: Collections.List[int] is
        count: int;

        [index: int]: int => index

        init(count: int) is
            self.count = count
        si
    si

    entry() -> int => SOURCE(5)[1..<1]
si
