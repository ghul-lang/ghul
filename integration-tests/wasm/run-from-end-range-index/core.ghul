@@suppress("non-upper-snake-case-name")

// The operators the program uses, declared as the core library declares
// them: each lowers to its operation rather than to a call.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
si

namespace Collections is
    trait List[E: out] is
        count: int => 0
        [index: int]: E => _[E]
    si
si

// A from-the-end range operator, as the runtime declares it.
namespace Ghul.Intrinsics is
    ..<(from: int, to: int) -> System.Range pure =>
        System.Range(System.Index(from, false), System.Index(to, true))
si

// The index and range types, declared as the core library declares them.
namespace System is
    struct Index is
        value: int
        is_from_end: bool

        init(value: int, from_end: bool) is
            self.value = value
            is_from_end = from_end
        si

        get_offset(length: int) -> int => if is_from_end then length - value else value fi

        get_hash_code() -> int => value
    si

    struct Range is
        start: Index
        end: Index

        init(start: Index, end: Index) is
            self.start = start
            self.end = end
        si

        get_hash_code() -> int => start.value
    si
si

// The slice an index by a range lowers to, here over a source that only
// knows its length: it answers where the slice starts and how long it is.
namespace Ghul.Pipes is
    slice(source: Test.SOURCE, r: System.Range) -> int is
        let first = r.start.get_offset(source.count)
        let last = r.end.get_offset(source.count)

        return first * 10 + last - first
    si
si
