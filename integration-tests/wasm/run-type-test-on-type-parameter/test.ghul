// A type test on a value whose type is a type parameter, compiled for each
// instantiation: a class that implements the trait, one that does not, and
// a scalar, which is boxed for the test. The exit status is the number of
// the first check that fails, or 0, as the .NET build returns.
namespace Test is
    trait Named is
        name() -> int
    si

    class CAT: Named is
        init() is si
        name() -> int => 7
    si

    class ROCK is
        init() is si
    si

    name_of[T](value: T) -> int =>
        if let named: Named = value then named.name() else -1 fi

    is_int[T](value: T) -> bool => isa int(value)

    entry() -> int is
        let checks = [
            name_of(CAT()) == 7,
            name_of(ROCK()) == -1,
            name_of(42) == -1,
            is_int(42),
            !is_int(CAT())
        ]

        let i mut = 0

        while i < checks.count do
            if !checks[i] then
                return i + 1
            fi

            i = i + 1
        od

        return 0
    si
si
