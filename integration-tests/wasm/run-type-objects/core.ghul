// The operators the program uses, and the type object and the root's
// get_type and hash code, declared as the core library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.reference") ==(a: object?, b: object?) -> bool pure
    @intrinsic("string.equals") =~(a: string?, b: string?) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
si

namespace Ghul is
    @suppress("non-upper-snake-case-name")
    class Type is
        _full_name: string

        init(full_name: string) is
            _full_name = full_name
        si

        full_name: string => _full_name
    si

    partial object is
        get_hash_code() -> int => 0

        @intrinsic("object.get_type")
        get_type() -> Type => _type_of(self)
    si

    @intrinsic("object.get_type")
    _type_of(value: object) -> Type pure
si
