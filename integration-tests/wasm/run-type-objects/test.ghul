// A type object is one per type, whether it comes from typeof or from a
// value's get_type, for a class, a scalar directly and through a type
// parameter, and a generic class at each of its instantiations. get_type
// cannot be overridden, so a struct declaring its own hides the root's
// rather than answering for an object holding one. The name is the one
// .NET gives. Each check sets one bit of the exit status, 127 when all
// pass.
namespace Test is
    class THING is
        init() is si
    si

    class BOX[T] is
        value: T
        init(value: T) is self.value = value si
    si

    struct HIDES is
        init() is si
        get_type() -> Ghul.Type => typeof THING
    si

    type_of[T](value: T) -> Ghul.Type => value.get_type()

    bit(passed: bool, value: int) -> int => if passed then value else 0 fi

    entry() -> int is
        let o: object = HIDES()

        return
            bit(typeof THING == THING().get_type(), 1) +
            bit(typeof int == 5 .get_type(), 2) +
            bit(type_of(7) == typeof int, 4) +
            bit(o.get_type() == typeof HIDES, 8) +
            bit(HIDES().get_type() == typeof THING, 16) +
            bit(!(typeof BOX[int] == typeof BOX[string]), 32) +
            bit(BOX(1).get_type().full_name =~ "Test.BOX[System.Int32]", 64)
    si
si
