// Runs function literals written in methods that a partial and an impl
// block add to a class, capturing and capturing nothing. The exit status
// is 10 + 15 + 12 + 18 = 55.
namespace Test is
    apply(f: int -> int, x: int) -> int => f(x)

    trait Scaled is
        scaled(x: int) -> int
        offset(x: int) -> int
    si

    class BOX is
        width: int

        init(width: int) is
            self.width = width
        si
    si

    partial BOX is
        doubled(x: int) -> int => apply(y => y * 2, x)

        widened(x: int) -> int => apply(y => y + width, x)
    si

    impl Scaled for BOX is
        scaled(x: int) -> int => apply(y => y * 3, x)

        offset(x: int) -> int => apply(y => y + width * 2, x)
    si

    entry() -> int is
        let box = BOX(5)

        return box.doubled(5) + box.widened(10) + box.scaled(4) + box.offset(8)
    si
si
