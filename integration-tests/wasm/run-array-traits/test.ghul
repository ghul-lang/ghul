// Runs arrays used through the traits they implement: a List's count and
// elements, an Iterable walked by a for loop, and a trait test on an array
// held as an object. The exit status is the low byte of the same value the
// .NET build returns.
namespace Test is
    total(xs: Collections.List[int]) -> int is
        let sum mut = 0
        let i mut = 0
        while i < xs.count do
            sum = sum + xs[i]
            i = i + 1
        od
        return sum
    si

    walk(xs: Collections.Iterable[int]) -> int is
        let sum mut = 0
        for x in xs do sum = sum + x od
        return sum
    si

    entry() -> int is
        let o: object = [7]
        let listy = if isa Collections.List[int](o) then 100 else 0 fi
        return total([1, 2, 3]) + walk([4, 5]) * 10 + listy
    si
si
