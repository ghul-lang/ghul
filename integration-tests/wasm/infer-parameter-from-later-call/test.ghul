// A function literal's parameter, inferred from a later call, takes the type
// of the argument rather than a root it derives from: the value the literal
// hands back goes where a char, a string and an array go.
namespace Test is
    entry() -> int is
        let same = letter => letter
        let letter: char = same('b')

        let keep = word => word
        let word: string = keep("x")

        let hold = values => values
        let values: int[] = hold([1, 2])

        return 0
    si
si
