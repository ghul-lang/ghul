// Global functions over scalars: recursion, a loop that breaks and
// continues, and an `if` that produces a value, which leaves its
// region carrying the value and so lowers to a typed block.
namespace Test is
    fib(n: int) -> int is
        if n < 2 then
            return n
        fi

        return fib(n - 1) + fib(n - 2)
    si

    odd_sum(limit: int) -> int is
        let total mut = 0
        let i mut = 0

        while true do
            i = i + 1

            if i > limit then
                break
            fi

            if i * 2 == i + i /\ i == 4 then
                continue
            fi

            total = total + i
        od

        return total
    si

    sign(x: int) -> int =>
        if x < 0 then -1 elif x == 0 then 0 else 1 fi
si
