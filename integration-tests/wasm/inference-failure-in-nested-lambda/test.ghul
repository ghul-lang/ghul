// A failure to infer, inside a function literal that a local holds and
// another literal calls, is reported rather than crashing the compiler.
apply_to[T, U](source: T, f: T -> U) -> U => f(source)

median(seed: int) -> int is
    let window = apply_to(seed, dx => no_such(dx))

    let middle = pick =>
        let picked = apply_to(window, pick) in
        picked

    let r = middle(p => p.red)

    0
