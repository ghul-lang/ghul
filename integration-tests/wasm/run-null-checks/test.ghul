// A null standing for an absent optional, and ! on a reference optional:
// the value where it is present, and the core library's
// NullReferenceException where it is absent.
namespace Test is
    use IO.Std

    lookup(want: bool) -> string? => if want then "found" else null fi

    entry() is
        let present = lookup(true)
        let absent = lookup(false)

        Std.write_line(if absent? then "absent is present" else "absent is absent" fi)
        Std.write_line(present!)

        try
            Std.write_line(absent!)
        catch e: Ghul.NullReferenceException
            Std.write_line(if e.code == 99 then "caught" else "wrong exception" fi)
        yrt
    si
si
