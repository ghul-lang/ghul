// The console writer as the core library declares it: a host operation
// the loader provides, taking the text as a JavaScript string.
namespace IO is
    class Std is
        write_line(text: string) static is
            _write(text, 1)
            _write("\n", 1)
        si

        @intrinsic("host.write")
        _write(text: string, stream: int) static
    si
si

namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
si

// The exception type every thrown value derives from, which the core
// library declares.
namespace Ghul is
    class Exception is
        code: int

        init(code: int) is
            self.code = code
        si
    si
si

namespace Ghul is
    class NullReferenceException: Exception is
        init() is super.init(99) si
    si
si
