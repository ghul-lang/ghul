// Runs type tests and a cast against array types, which share a struct
// type where their elements are held alike: an array of a class is an
// array of its superclass and not of its subclass. The exit status is the
// low byte of the same value the .NET build returns.
namespace Test is
    class ANIMAL is
        init() is si
    si

    class CAT: ANIMAL is
        init() is super.init() si
    si

    bit(b: bool, n: int) -> int => if b then n else 0 fi

    entry() -> int is
        let ints: object = [1, 2, 3]
        let cats: object = [CAT(), CAT()]
        let animals: object = [ANIMAL()]
        let text: object = CAT()

        let as_animals = cast ANIMAL[](cats)

        return
            bit(isa int[](ints), 1) + bit(isa int[](cats), 2) +
            bit(isa ANIMAL[](cats), 4) + bit(isa CAT[](animals), 8) +
            bit(isa CAT[](cats), 16) + bit(isa ANIMAL[](text), 32) +
            as_animals.count * 64
    si
si
