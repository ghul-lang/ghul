// Runs arrays: literals of scalars and of references, their count and
// elements, a for over one, and an array of a class used as an array of
// its superclass. The exit status is the low byte of the same value the
// .NET build returns.
namespace Test is
    class SHAPE is
        init() is si
        area() -> int => 1
    si

    class SQUARE: SHAPE is
        init() is super.init() si
        area() -> int => 4
    si

    sum(xs: int[]) -> int is
        let total mut = 0
        let i mut = 0
        while i < xs.count do
            total = total + xs[i]
            i = i + 1
        od
        return total
    si

    areas(shapes: SHAPE[]) -> int is
        let total mut = 0
        for s in shapes do total = total + s.area() od
        return total
    si

    entry() -> int is
        let xs = [1, 2, 3]
        let squares: SHAPE[] = [SQUARE(), SQUARE()]
        let mixed: SHAPE[] = [SQUARE(), SHAPE()]
        let longs = [10L, 20L]
        let t mut = 0
        for x in xs do t = t + x * 10 od
        return sum(xs) + t + areas(squares) * 100 + areas(mixed) * 1000 + cast int(longs[1]) * 10000
    si
si
