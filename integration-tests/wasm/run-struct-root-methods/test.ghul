// Runs a method the core library gives every object on a boxed struct,
// through the root: one struct keeps it and one overrides it. The exit
// status is 7 + 30 * 2.
namespace Test is
    struct PLAIN is
        _tag: int

        init() is _tag = 0 si
    si

    struct CODED is
        _tag: int

        init() is _tag = 0 si
        code() -> int => 30
    si

    of(o: object) -> int => o.code()

    entry() -> int => of(PLAIN()) + of(CODED()) * 2
si
