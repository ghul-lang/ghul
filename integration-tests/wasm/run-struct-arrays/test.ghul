namespace Test is
    struct POINT is
        x: int field
        _tag: int

        init(x: int) is
            self.x = x
            _tag = 0
        si

        shift(by: int) is
            x = x + by
        si
    si

    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    entry() -> int is
        let result mut = 0
        let points = [POINT(1), POINT(2)]

        // 1: an element read is a copy
        let first mut = points[0]
        first.shift(10)
        result = result + bit(points[0].x == 1 /\ first.x == 11, 1)

        // 2: a method on an element changes the element in place
        points[1].shift(5)
        result = result + bit(points[1].x == 7, 2)

        // 4: a for over the elements sees copies
        let total mut = 0
        for p in points do
            p.shift(100)
            total = total + p.x
        od
        result = result + bit(total == 208 /\ points[0].x == 1, 4)

        return result
    si
si
