// A generic class whose constructor builds a deeper instantiation of
// itself would need a type for every depth, without end. The target
// reports the class rather than adding types forever.
class NODE[T] is
    value: T
    inner: object?

    init(value: T, depth: int) is
        self.value = value

        if depth == 0 then
            self.inner = null
        else
            self.inner = NODE[NODE[T]](self, depth - 1)
        fi
    si
si

entry() -> int is
    let node = NODE(1, 3)

    return node.value
si
