// A relational operator over two ints lowers to the comparison opcode,
// not to a call of the `<>` member int declares for Comparable, so the
// program runs and exits with the status the comparisons give.
namespace Test is
    entry() -> int =>
        if 1 < 2 /\ !(2 < 1) /\ 3 >= 3 then 42 else 1 fi
si
