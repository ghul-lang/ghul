// The ordering operator and a Comparable implementation for int, declared
// as the core library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
si

namespace Ghul is
    trait Comparable[T] is
        <>(other: T) -> int;
    si

    impl Comparable[int] for int is
        <>(other: int) -> int pure => Ghul.Intrinsics.`<>(self, other);
    si
si
