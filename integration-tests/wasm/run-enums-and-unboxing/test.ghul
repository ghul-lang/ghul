// An enum is held as its underlying int; a value held as an object is
// unboxed by a cast to a scalar or to an optional scalar; and a null
// argument is accepted wherever a reference is expected.
namespace Test is
    enum Colour is
        RED,
        GREEN,
        BLUE
    si

    class PAINT is
        colour: Colour

        init(colour: Colour) is
            self.colour = colour
        si
    si

    rank(colour: Colour) -> int =>
        if colour == Colour.RED then 0 elif colour == Colour.GREEN then 1 else 2 fi

    code_of(value: object?) -> int is
        if let unit: char = value then
            return cast int(unit)
        fi

        if let number = cast int?(value) then
            return number
        fi

        return -1
    si

    presence(value: object?) -> int => if value? then 1 else 0 fi

    entry() is
        IO.Std.write_line("{rank(Colour.RED)} {rank(PAINT(Colour.BLUE).colour)}")
        IO.Std.write_line("{code_of('A')} {code_of(42)} {code_of("text")} {code_of(null)}")
        IO.Std.write_line("{presence(null)} {presence(PAINT(Colour.GREEN))}")
    si
si
