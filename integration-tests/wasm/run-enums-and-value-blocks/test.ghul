// An enum held as its int: passed, kept in a local, compared, matched in
// a case, and boxed into an object and back. A parenthesised block whose
// last statement leaves a value, in an expression and as an arm of an if.
// The exit status is the number of the first check that fails.
enum Colour is
    RED,
    GREEN,
    BLUE
si

rank(c: Colour) -> int =>
    case c
    when Colour.RED then 1
    when Colour.GREEN then 2
    when Colour.BLUE then 3
    esac

is_green(o: object) -> bool => isa Colour(o) /\ cast Colour(o) == Colour.GREEN

pick(flag: bool) -> int =>
    if flag then
        (let x = 4; x * 10)
    else
        (let y = 5; y + 1)
    fi

entry() -> int is
    let local = Colour.BLUE
    let boxed: object = Colour.GREEN

    if rank(Colour.RED) != 1 then return 1 fi
    if rank(local) != 3 then return 2 fi
    if !(local == Colour.BLUE) then return 3 fi
    if !is_green(boxed) then return 4 fi
    if is_green(Colour.RED) then return 5 fi
    if (let a = 6; a * 7) != 42 then return 6 fi
    if pick(true) != 40 then return 7 fi
    if pick(false) != 6 then return 8 fi

    return 0
si
