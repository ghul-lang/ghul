// Runs function values that capture a mut local, that hold an overridden
// method, and that capture nothing, so are built once and reused. The exit
// status is the low byte of the same value the .NET build returns.
namespace Test is
    class BASE is
        init() is si
        f(x: int) -> int => x + 1
    si

    class DERIVED: BASE is
        init() is super.init() si
        f(x: int) -> int => x * 3
    si

    apply(g: int -> int, x: int) -> int => g(x)

    twice(x: int) -> int => x * 2

    entry() -> int is
        let count mut = 0
        let bump = (n: int) -> int is count = count + n; return count si
        bump(2)
        bump(3)

        let b: BASE = DERIVED()
        let shared mut = 0
        let i mut = 0

        while i < 3 do
            shared = shared + apply(x => x * 3, i)
            i = i + 1
        od

        return count + apply(b.f, 4) * 10 + apply(BASE().f, 4) * 100 + apply(twice, 5) * 1000 + shared * 10000
    si
si
