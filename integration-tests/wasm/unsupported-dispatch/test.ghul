// A call to a method something overrides needs dispatch through the
// receiver's type, which the wasm backend does not generate yet: it is
// a compile-time error at the function making the call.
namespace Test is
    class ANIMAL is
        init() is si

        legs() -> int => 4
    si

    class BIRD: ANIMAL is
        init() is super.init() si

        legs() -> int => 2
    si

    count(animal: ANIMAL) -> int => animal.legs()
si
