// Conversions between scalar kinds. A narrow kind is held in an i32 and
// brought back into range where CIL would truncate it: on a narrowing
// conversion, and as a narrow result is returned. A floating value
// converts to an integer saturating, as .NET does.
namespace Test is
    to_byte(x: int) -> byte => cast byte(x)
    to_char(x: int) -> char => cast char(x)
    add_bytes(a: byte, b: byte) -> byte => a + b
    to_int(d: double) -> int => cast int(d)
    widen(x: int) -> long => cast long(x)
    widen_unsigned(x: uint) -> long => cast long(x)
    high_word(x: long) -> int => cast int(x >> 32)
    to_single(d: double) -> single => cast single(d)
si
