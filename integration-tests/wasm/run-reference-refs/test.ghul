namespace Test is
    class THING is
        value: int
        init(value: int) is self.value = value si
    si

    trait Source[V] is
        try_get(value: V ref) -> bool
    si

    class HOLDER[V]: Source[V] is
        _item: V
        _present: bool

        init(item: V, present: bool) is
            _item = item
            _present = present
        si

        try_get(value: V ref) -> bool is
            if _present then
                value! = _item
                return true
            fi

            return false
        si
    si

    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    set_to(target: THING ref, value: THING) is
        target! = value
    si

    read(source: THING ref) -> THING => source!

    swap(a: THING ref, b: THING ref) is
        let t = a!
        a! = b!
        b! = t
    si

    entry() -> int is
        let result mut = 0
        let first = THING(1)
        let second = THING(2)

        // 1: a write through a reference reaches the local
        let a mut = first
        set_to(a ref, second)
        result = result + bit(a == second, 1)

        // 2: a read through a reference sees the local
        result = result + bit(read(a ref) == second, 2)

        // 4: two references to two locals
        let b mut = first
        swap(a ref, b ref)
        result = result + bit(a == first /\ b == second, 4)

        // 8: a generic method writes a reference-typed value through V ref
        let found mut = first
        let holder = HOLDER[THING](second, true)
        result = result + bit(holder.try_get(found ref) /\ found == second, 8)

        // 16: a miss leaves the local as it was
        let missing = HOLDER[THING](first, false)
        result = result + bit(!missing.try_get(found ref) /\ found == second, 16)

        // 64: the same method reached through a trait
        let source: Source[THING] = holder
        found = first
        result = result + bit(source.try_get(found ref) /\ found == second, 64)

        // 32: the local still reads and writes directly afterwards
        a = second
        result = result + bit(a.value == 2 /\ read(a ref).value == 2, 32)

        return result
    si
si
