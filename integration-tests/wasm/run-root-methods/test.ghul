// Runs a method the core library gives every object, through the root:
// on a class that keeps it, one that overrides it, a subclass of that,
// a boxed scalar and a function value. The exit status is the low byte
// of 7 + 30 + 30 * 2 + 7 * 10 + 7 * 100.
namespace Test is
    class THING is
        init() is si
    si

    class NAMED is
        init() is si
        code() -> int => 30
    si

    class CHILD: NAMED is
        init() is super.init() si
    si

    of(o: object) -> int => o.code()

    entry() -> int is
        let f = (x: int) -> int => x
        return of(THING()) + of(NAMED()) + of(CHILD()) * 2 + of(cast object(5)) * 10 + of(f) * 100
    si
si
