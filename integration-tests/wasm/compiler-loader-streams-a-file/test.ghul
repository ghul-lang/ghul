// The compiler's own loader reads a file in pieces as they are asked for,
// as the runtime library's loader does: a descriptor, chunks of at most the
// count asked for, empty at the end, and -1 with a reason for a file that
// is not there.
entry() is
    let descriptor = IO.HOST_FILES.open_read("data.txt")

    IO.Std.write_line(if descriptor == -1 then "not opened" else "opened" fi)
    IO.Std.write_line(IO.HOST_FILES.read_chunk(descriptor, 5) ?? "failed")
    IO.Std.write_line(IO.HOST_FILES.read_chunk(descriptor, 3) ?? "failed")
    IO.Std.write_line(IO.HOST_FILES.read_chunk(descriptor, 100) ?? "failed")
    IO.Std.write_line(IO.HOST_FILES.read_chunk(descriptor, 100) ?? "failed")
    IO.Std.write_line(if IO.HOST_FILES.close(descriptor) == 0 then "closed" else "not closed" fi)

    let missing = IO.HOST_FILES.open_read("not-there.txt")

    IO.Std.write_line(if missing == -1 then "missing file not opened" else "missing file opened" fi)
    IO.Std.write_line(if IO.HOST_FILES.last_error() == 1 then "not found" else "some other failure" fi)
si
