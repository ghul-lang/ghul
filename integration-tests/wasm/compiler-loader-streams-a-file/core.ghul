// The console writer and the host operations the core library reads a file
// with as it is asked for, as it declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.value") ==[T](a: T, b: T) -> bool pure
    @intrinsic("compare.reference") ==(a: object?, b: object?) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
si

namespace IO is
    class Std is
        write_line(text: string) static is
            _write(text, 1)
            _write("\n", 1)
        si

        @intrinsic("host.write")
        _write(text: string, stream: int) static
    si

    class HOST_FILES is
        @intrinsic("host.file_open_read")
        open_read(path: string) -> int static

        @intrinsic("host.file_read_chunk")
        read_chunk(descriptor: int, count: int) -> string? static

        @intrinsic("host.file_close")
        close(descriptor: int) -> int static

        @intrinsic("host.file_last_error")
        last_error() -> int static
    si
si
