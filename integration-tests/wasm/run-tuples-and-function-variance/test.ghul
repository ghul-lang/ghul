// A tuple with a null element converts to a tuple type that says what the
// element holds, rebuilt element by element. A function value converts to
// a function type its return type converts to, and is called through it. A
// class method implements every trait that declares it, so a call through
// either trait reaches it. The exit status is the number of the first check
// that fails.
class Animal abstract is
    legs: int

    init(legs: int) is
        self.legs = legs
    si
si

class CAT: Animal is
    init(legs: int) is super.init(legs) si
si

trait Adds is
    add(x: int, y: int) -> int
si

trait AlsoAdds is
    add(x: int, y: int) -> int
si

trait BOTH: Adds, AlsoAdds is
si

class SUM: BOTH is
    init() is si

    add(x: int, y: int) -> int => x + y
si

second(pair: (CAT?, int)) -> int => pair.`1

keep(pairs: (CAT?, int)[]) -> int => 2

make_cat(legs: int) -> CAT => CAT(legs)

entry() -> int is
    let typed: (CAT?, int) = (null, 1)

    if typed.`0? then return 1 fi
    if typed.`1 != 1 then return 2 fi
    if second((null, 2)) != 2 then return 3 fi

    if keep([(null, 4), (CAT(4), 5)]) != 2 then return 4 fi

    let exact = make_cat
    let widened: (int) -> Animal = exact

    if widened(3).legs != 3 then return 5 fi

    let s = SUM()
    let a: Adds = s
    let b: AlsoAdds = s

    if a.add(3, 4) != 7 then return 6 fi
    if b.add(5, 6) != 11 then return 7 fi

    return 0
si
