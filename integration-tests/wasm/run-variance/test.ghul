// Runs calls and a trait test through trait instances a value reaches by
// variance: an array of a class and a generic class through Iterable and
// List of its superclass, and a sink of a class through the contravariant
// Sink of its subclass. The exit status is the low byte of the same value
// the .NET build returns.
namespace Test is
    class ANIMAL is
        init() is si
        legs() -> int => 0
    si

    class CAT: ANIMAL is
        init() is super.init() si
        legs() -> int => 4
    si

    class HOLDER[T]: Collections.Iterable[T] is
        _items: T[]
        init(items: T[]) is _items = items si
        iterator: Collections.Iterator[T] => _items.iterator
    si

    trait Sink[T: in] is
        take(value: T) -> int
    si

    class COUNTING_SINK: Sink[ANIMAL] is
        init() is si
        take(value: ANIMAL) -> int => value.legs()
    si

    walk(animals: Collections.Iterable[ANIMAL]) -> int is
        let total mut = 0
        for a in animals do total = total + a.legs() od
        return total
    si

    size(animals: Collections.List[ANIMAL]) -> int => animals.count

    feed(sink: Sink[CAT], cat: CAT) -> int => sink.take(cat)

    entry() -> int is
        let cats = [CAT(), CAT()]
        let o: object = cats
        let iterable = if isa Collections.Iterable[ANIMAL](o) then 1 else 0 fi
        return walk(cats) + size(cats) * 10 + walk(HOLDER[CAT](cats)) * 100 + feed(COUNTING_SINK(), CAT()) * 1000 + iterable * 10000
    si
si
