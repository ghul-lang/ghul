// A source library's constructor intrinsic that returns a generic class, or
// an array, is offered as a constructor of the generic class, or of the
// array, with the class's type arguments taken from the call. The exit status
// is the low byte of the same value the .NET build returns.
namespace Test is
    use Ghul.HOLDER

    entry() -> int is
        let held = HOLDER([1, 2, 3])
        let copied = ARRAY([10, 20])
        let names = HOLDER(["a", "b"])

        return held.items.count + held.items[2] * 10 + copied[1] * 100 + names.items.count * 10000
    si
si
