// The operators the program uses, the members the core library gives arrays,
// and constructor intrinsics that return a generic class and an array,
// declared as a source library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("arithmetic.sub") -(a: int, b: int) -> int pure
    @intrinsic("arithmetic.neg") -(a: int) -> int pure
    @intrinsic("arithmetic.mul") *(a: int, b: int) -> int pure
    @intrinsic("compare.order") <>(a: int, b: int) -> int pure
    @intrinsic("compare.reference") ==(a: object?, b: object?) -> bool pure
    @intrinsic("bool.not") !(a: bool) -> bool pure
    @intrinsic("bool.and_then") /\ (a: bool, b: bool) -> bool pure
si

namespace Collections is
    trait Iterator[E: out] is
        move_next() -> bool
        current: E
        dispose()
    si

    trait Iterable[E: out] is
        iterator: Iterator[E]
    si

    trait List[E: out]: Iterable[E] is
        count: int;
        [index: int]: E;
    si
si

namespace Ghul is
    partial ARRAY is
        @intrinsic("array.count")
        count: int => count;

        @intrinsic("array.get")
        [index: int]: E => self[index]

        iterator: Collections.Iterator[E] => ARRAY_ITERATOR[E](self)
    si

    @intrinsic("array.new")
    _array_new[E](count: int) -> E[] pure

    @intrinsic("array.set")
    _array_set[E](array: E[], index: int, value: E)

    class HOLDER[T] is
        items: T[] public

        init() is items = Ghul._array_new[T](0) si
    si

    class ARRAY_ITERATOR[E]: Collections.Iterator[E] is
        _array: E[]
        _index: int
        init(array: E[]) is _array = array; _index = -1 si
        move_next() -> bool is _index = _index + 1; return _index < _array.count si
        current: E => _array[_index]
        dispose() is si
    si
si

namespace Ghul.Internal is
    class CONSTRUCTORS is
        @intrinsic("constructor.from_items")
        from_items[T](items: T[]) -> HOLDER[T] static is
            let result = HOLDER[T]()
            result.items = items
            return result
        si

        @intrinsic("constructor.from_iterable")
        from_iterable[E](source: Collections.List[E]) -> E[] static is
            let result = Ghul._array_new[E](source.count)
            let i mut = 0
            while i < source.count do
                Ghul._array_set(result, i, source[i])
                i = i + 1
            od
            return result
        si
    si
si
