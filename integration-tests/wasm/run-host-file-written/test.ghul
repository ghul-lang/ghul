// Under Node the loader writes each file the program reports beside the
// test, where its `.expected` twin is compared byte for byte. Writing a
// file again replaces it. A path reaching outside the working directory
// is reported on standard error and not written.
namespace Test is
    entry() -> int is
        file_written("signature.png", "AAAA")
        file_written("signature.png", "iVBORw0KGgo=")
        file_written("../outside.png", "AAAA")
        file_written("/tmp/outside.png", "AAAA")

        return 100
    si
si
