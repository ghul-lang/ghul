// Runs =~ over tuples, which compare element by element, each element as
// its own type compares: written directly, through a type parameter, nested,
// and with string and class elements. The exit status is the number of the
// first check that fails, or 0, as the .NET build returns.
namespace Test is
    class POINT is
        x: int
        init(x: int) is self.x = x si
        =~(other: POINT) -> bool pure => x == other.x
        get_hash_code() -> int => x
    si

    same[T](a: T, b: T) -> bool => a =~ b

    entry() -> int is
        let a = (x = 1, y = 2)

        let checks = [
            a =~ (x = 1, y = 2), !(a =~ (x = 1, y = 3)), !(a =~ (x = 0, y = 2)),
            same((1, "one"), (1, "one")), !same((1, "one"), (1, "two")),
            same(((1, 2), 3), ((1, 2), 3)), !same(((1, 2), 3), ((1, 9), 3)),
            same((POINT(4), 5), (POINT(4), 5)), !same((POINT(4), 5), (POINT(6), 5))
        ]

        let i mut = 0

        while i < checks.count do
            if !checks[i] then
                return i + 1
            fi

            i = i + 1
        od

        return 0
    si
si
