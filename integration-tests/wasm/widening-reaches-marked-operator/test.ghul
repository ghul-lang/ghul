// An int operand is widened to long, through the core's marked widening,
// to reach the core's long operator marked to accept it, on either side.
// A typeless cast operand still takes its type from the same-kind
// operator, as it does with no widening declared.
namespace Test is
    entry() is
        let big = 3_000_000_000L
        let n = 3

        IO.Std.write_line(big * n)
        IO.Std.write_line(n * big)
        IO.Std.write_line(n + big)
        IO.Std.write_line(big / n)
        IO.Std.write_line(n % 2L)
        IO.Std.write_line(n <> big)
        IO.Std.write_line(big <> n)

        let count = 4
        let total = 10
        IO.Std.write_line(total + cast(count))
    si
si
