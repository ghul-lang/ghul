namespace Test is
    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    set_to(target: int ref, value: int) is
        target! = value
    si

    read(source: int ref) -> int => source!

    split(whole: int, high: int ref, low: int ref) is
        high! = whole / 10
        low! = whole % 10
    si

    entry() -> int is
        let result mut = 0

        // 1: a write through a reference reaches the local
        let a mut = 1
        set_to(a ref, 5)
        result = result + bit(a == 5, 1)

        // 2: a read through a reference sees the local
        result = result + bit(read(a ref) == 5, 2)

        // 4: two references to two locals
        let high mut = 0
        let low mut = 0
        split(42, high ref, low ref)
        result = result + bit(high == 4 /\ low == 2, 4)

        // 8: the local still reads and writes directly afterwards
        a = a + 1
        result = result + bit(a == 6 /\ read(a ref) == 6, 8)

        // 16: a discarded reference argument is written and dropped
        split(97, _, low ref)
        result = result + bit(low == 7, 16)

        return result
    si
si
