// A bigint is a box around the host's integer: a literal, a constructor,
// the operators and the static members all reach the host, and answer as
// .NET's BigInteger does. The exit status sets a bit for each that holds.
namespace Test is
    bit(condition: bool, value: int) -> int => if condition then value else 0 fi

    fact(n: int) -> bigint => if n == 0 then bigint(1) else bigint(n) * fact(n - 1) fi

    entry() -> int is
        let factorial = fact(30)

        let result mut = 0

        result = result + bit(bigint.equals(bigint.pow(bigint(2), 100), 1267650600228229401496703205376n), 1)
        result = result + bit(bigint.to_long(factorial % bigint(1000007)) == 790627L, 2)
        result = result + bit(bigint.to_long(-bigint(17) % bigint(5)) == -2L, 4)
        result = result + bit(bigint.equals((bigint(1) << 70) >> 3, 147573952589676412928n), 8)
        result = result + bit(bigint.compare(3n, 2n) == 1 /\ bigint.compare(-bigint(5), 0n) == -1, 16)
        result = result + bit(bigint.equals(bigint.mod_pow(3n, 200n, 1000000007n), 136318165n), 32)

        return result
    si
si
