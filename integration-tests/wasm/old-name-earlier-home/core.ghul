// The console writer as the core library declares it: a host operation
// the loader provides, taking the text as a JavaScript string.
namespace IO is
    class Std is
        write_line(text: string) static is
            _write(text, 1)
            _write("\n", 1)
        si

        @intrinsic("host.write")
        _write(text: string, stream: int) static
    si
si

// A core library from before the builder moved to Text, as .NET names it.
namespace Ghul is
    class STRING_BUILDER is
        init() is si

        label() -> string => "the builder in its earlier home"
    si
si
