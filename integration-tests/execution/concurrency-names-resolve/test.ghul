use default

double_it(n: int) -> Concurrency.Future[int] is
    await Concurrency.Future.yield()
    return n * 2
si

unit_work() -> Concurrency.Future is
    await Concurrency.Future.delay(1)
si

handed_over(c: Concurrency.Completer[string]) -> Concurrency.Future[string] is
    return await c.task
si

use Concurrency.Future
use Concurrency.Completer

imported() -> Future[int] is
    let c = Completer[int]()
    c.set_result(5)
    return await c.task
si

let c = Concurrency.Completer[string]()
let waiting = handed_over(c)
c.set_result("handed over")

let current: Concurrency.Future[int] = double_it(1)

write_line("{double_it(21).result} {waiting.result} {imported().result} {current.result}")
unit_work().wait()
write_line("done")
