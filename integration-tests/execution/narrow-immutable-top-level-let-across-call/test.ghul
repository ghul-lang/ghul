use default

class Holder(inner: Holder? public, label: string public) is
    describe() -> string => "holder {label}"
si

find() -> Ghul.Exception? => Ghul.Exception("x")

find_holder() -> Holder? => Holder(null, "outer")

// a call to a library member whose effects are unknown cannot change an
// immutable top-level let, so the presence the asserts establish holds
let boom = find()
assert boom?
assert boom.message =~ "x"
write_line("{boom.message}")

let holder = find_holder()

if holder? then
    write_line(holder.describe())
    write_line(holder.label)
fi
