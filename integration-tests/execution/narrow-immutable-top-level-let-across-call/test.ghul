use default

class Holder(inner: Holder? public, label: string public) is
    describe() -> string => "holder {label}"
si

find() -> Ghul.Exception? => Ghul.Exception("x")

find_holder() -> Holder? => Holder(null, "outer")

// an immutable top-level let keeps its narrowing across a call to a
// library member whose effects are unknown
let boom = find()

// declared before the narrowing and called between it and the use: the
// function reads the let but cannot change it
show() is
    if let b = boom then
        write_line("show {b.message}")
    fi
si

assert boom?
assert boom.message =~ "x"
show()
write_line("{boom.message}")

let holder = find_holder()

if holder? then
    write_line(holder.describe())
    write_line(holder.label)
fi
