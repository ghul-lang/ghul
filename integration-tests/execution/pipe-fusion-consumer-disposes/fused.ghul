namespace Fused is
    use IO.Std.write_line
    use Ghul.Pipes

    run(source: Collections.Iterable[int]) is
        write_line("first {source |> first()}")
        write_line("find {source |> find(x => x == 2)}")
        write_line("any {source |> any(x => x > 1)}")
        write_line("all {source |> all(x => x < 3)}")
        write_line("count {source |> count(x => x > 2)}")
        write_line("reduce {source |> reduce(0, (a, x) => a + x)}")
        write_line("take {source |> take(2) |> count(x => x > 0)}")
        write_line("map {source |> map(x => x * 2) |> first()}")
        write_line("sum {source |> filter(x => x % 2 == 1) |> sum()}")
        source |> take_while(x => x < 3) |> each(x => write_line("each {x}"))
    si

    // Sources whose storage llvm walks without an iterator, or whose
    // iterator holds nothing: these still answer, with or without a dispose.
    storage() is
        let list = Collections.LIST[int]([1, 2, 3])
        let set = Collections.SET[int]([4, 5])
        let pairs = Collections.MAP[int, int]()
        pairs[6] = 7
        let array: int[] = [8, 9]

        write_line("list {list |> first()} {list |> sum()}")
        write_line("set {set |> count(x => x > 4)}")
        write_line("pairs {pairs |> map(((k, v)) => k + v) |> first()}")
        write_line("array {array |> any(x => x == 9)}")
        write_line("range {0..10 |> filter(x => x % 3 == 0) |> sum()}")
    si
si
