// A fused consumer disposes the iterator it reads as the runtime terminal
// it stands in for does: the same chains, fused in fused.ghul and not in
// unfused.ghul, open and dispose their sources identically.
use IO.Std.write_line

class LOGGED: Collections.Iterable[int] is
    _name: string

    init(name: string) is
        _name = name
    si

    iterator: Collections.Iterator[int] =>
        LOGGED_ITERATOR(_name)
si

class LOGGED_ITERATOR: Collections.Iterator[int] is
    _name: string
    _next: int

    init(name: string) is
        _name = name
        write_line("open {name}")
    si

    current: int => _next

    move_next() -> bool is
        _next = _next + 1

        return _next <= 5
    si

    reset() is
        _next = 0
    si

    dispose() is
        write_line("dispose {_name}")
    si
si

entry() is
    write_line("fused:")
    Fused.run(LOGGED("a"))

    write_line("unfused:")
    Unfused.run(LOGGED("a"))

    Fused.storage()
si
