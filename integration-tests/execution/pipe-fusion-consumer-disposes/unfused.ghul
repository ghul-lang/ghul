@@suppress("pipe-fusion")

namespace Unfused is
    use IO.Std.write_line
    use Ghul.Pipes

    run(source: Collections.Iterable[int]) is
        write_line("first {source |> first()}")
        write_line("find {source |> find(x => x == 2)}")
        write_line("any {source |> any(x => x > 1)}")
        write_line("all {source |> all(x => x < 3)}")
        write_line("count {source |> count(x => x > 2)}")
        write_line("reduce {source |> reduce(0, (a, x) => a + x)}")
        write_line("take {source |> take(2) |> count(x => x > 0)}")
        write_line("map {source |> map(x => x * 2) |> first()}")
        write_line("sum {source |> filter(x => x % 2 == 1) |> sum()}")
        source |> take_while(x => x < 3) |> each(x => write_line("each {x}"))
    si
si
