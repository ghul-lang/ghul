use IO.Std.write_line

enum Colour is
    RED,
    GREEN
si

struct POINT(x: int public, y: int public)

class RANGE(path: string public, start_line: int? public, end_line: int? public, at: POINT? public) is
    colour: Colour? public
si

entry() is
    let json = Json.parse("{{\"path\":\"a\",\"start_line\":3,\"end_line\":null,\"at\":{{\"x\":1,\"y\":2}}}}")
    let r = cast RANGE?(Json.from_json(json, typeof RANGE))!

    write_line("{r.path} {r.start_line} {r.end_line} {r.at?.x} {r.at?.y}")
    write_line(Json.write(Json.to_json(r)))

    let type = typeof RANGE
    let made = cast RANGE?(System.Activator.create_instance(type, ["b", 7, null, POINT(4, 5)]))!

    write_line("{made.start_line} {made.end_line} {made.at?.y}")

    let colour = type.get_property("colour")!

    colour.set_value(made, Colour.GREEN)
    write_line("{made.colour} {colour.get_value(made)}")

    colour.set_value(made, null)
    write_line("{made.colour} {colour.get_value(made)}")
si
