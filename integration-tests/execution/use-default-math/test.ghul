// `use default` imports `Ghul.Math` and `Ghul.NumberTheory` along with the
// rest of the set. Both namespaces are declared here, so the test doesn't
// depend on which runtime defines them.
namespace Ghul.Math is
    halve(value: double) -> double => value / 2.0
si

namespace Ghul.NumberTheory is
    is_lucky(n: int) -> bool => n == 7
si

namespace Test is
    use default

    entry() is
        write_line("{halve(9.0)} {is_lucky(7)} {is_lucky(8)}")
    si
si
