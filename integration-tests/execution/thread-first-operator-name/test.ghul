namespace Test is
    use Ghul;
    use IO.Std;

    // A function can be named with an operator, and `|>` accepts one on
    // its right. Written without an argument list the threaded value is
    // the only argument, so a formatting function reads as `xs |> $`.
    //
    // The name and the `|>` must be separated: a run of operator
    // characters scans as a single token, so `xs |>$` is one operator
    // named `|>$` rather than two.

    $(o: object?) -> string => if o? then "<{o.to_string()}>" else "null" fi;

    $(a: int, b: int) -> string => "<{a}+{b}>";

    ~(s: string) -> string => "~{s}~";

    entry() is
        Std.write_line(42 |> $);
        Std.write_line(42 |> $());
        Std.write_line(1 |> $(2));
        Std.write_line("b" |> ~ |> ~);

        // `Ghul.$` is in scope alongside the one declared here and
        // merges into the same group, so a `string` reaches its
        // `$(value: string)` and a `null` reaches the `$(o: object?)`
        // above.
        Std.write_line("a" |> $);
        Std.write_line(null |> $);
    si
si
