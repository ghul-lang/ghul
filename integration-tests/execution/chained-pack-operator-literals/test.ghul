namespace Test is
    use IO.Std.write_line;
    use Ghul.Functional.`>>;

    // Tests: a chain of the composition operator written as one
    // expression. The inner operator adapts its own operands first, and
    // the outer one then adapts the whole inner expression away - so the
    // literals the inner one left in the tree have to travel to the
    // adapter that replaces it, or generate-il never reaches their
    // bodies and emits methods with nothing in them.

    add(a: int, b: int) -> int => a + b;

    builds: int;

    make() -> (int, int) -> int is
        builds = builds + 1;
        return add;
    si

    entry() is
        let annotated = make() >> ((x: int) -> int => x * 2) >> ((y: int) -> string => "[{y}]");

        write_line(annotated(2, 3));

        let inferred = make() >> (x => x * 2) >> (y => "<{y}>");

        write_line(inferred(2, 3));
        write_line("builds={builds}");
    si
si
