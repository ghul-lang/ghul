use IO.Std.write_line

class NOTED(name: string): Ghul.Disposable is
    // Reading the part hands back another resource, so which of the two
    // is disposed shows what `use` applied to.
    part: NOTED => NOTED("{name}.part")

    dispose() is
        write_line("  dispose {name}")
    si
si

describe(n: NOTED) -> string => "described {n.name}"

applies_to_the_whole_postfix_expression() is
    write_line("use x.part disposes the part:")
    let p = use NOTED("whole").part
    write_line("  got {p.name}")
si

applies_before_a_chain() is
    write_line("use f() |> g() hands g the resource:")
    let text = use NOTED("chained") |> describe()
    write_line("  {text}")
si

applies_to_the_whole_postfix_expression()
applies_before_a_chain()
