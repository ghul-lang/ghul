use Ghul.Pipes
use IO.Std.write_line

// Tests: a type named as a value where a function is expected is its
// constructor as a function, picked by the expected function type's
// parameters: a class, a struct, a union variant, a generic type with
// its arguments written or inferred, a scalar conversion, and a .NET
// type, built once per type in a function body.

class PERSON(name: string public, age: int public) is
    init(name: string) is
        self.name = name
        age = -1
    si

    to_string() -> string => "{name}/{age}"
si

struct POINT(x: int public, y: int public) is
    to_string() -> string => "({x},{y})"
si

union SHAPE is
    CIRCLE(radius: double)
    SQUARE(side: double)
si

class BOX[T](item: T public) is
    to_string() -> string => "box[{item}]"
si

class WIDE(a: int, b: int, c: int, d: int) is
    to_string() -> string => "{a}{b}{c}{d}"
si

class ANIMAL abstract is
    init() is si
si

make_wide() -> (int, int, int, int) -> WIDE => WIDE

wrap[T](xs: T{}) -> BOX[T]{} => xs |> map(BOX)

entry() is
    // a class, through each of its constructors by arity
    write_line("{[("ann", 30), ("bob", 40)] |> map(PERSON) |> string(",")}")
    write_line("{["cy", "di"] |> map(PERSON) |> string(",")}")

    let two: (string, int) -> PERSON = PERSON
    let one: (string) -> PERSON = PERSON

    write_line("{two("ed", 50)} {one("fay")}")

    // a struct
    write_line("{[(1, 2), (3, 4)] |> map(POINT) |> string(",")}")

    // a union variant with a field
    let circles = [1.0, 2.5] |> map(SHAPE.CIRCLE) |> collect()
    let square: (double) -> SHAPE = SHAPE.SQUARE

    write_line("{circles.count} {circles[1]} {square(3.0)}")

    // a generic type: arguments written, inferred from the slot, and
    // over a type parameter of the enclosing function
    write_line("{[1, 2] |> map(BOX[int]) |> string(",")}")
    let boxed: (string) -> BOX[string] = BOX
    write_line("{boxed("s")} {["a", "b"] |> map(BOX) |> string(",")} {wrap([true]) |> string(",")}")

    // a scalar conversion
    write_line("{[1, 2, 3] |> map(double) |> map(x => x / 2.0) |> string(",")}")
    write_line("{[1L, 2L] |> map(int) |> sum()}")
    let widen: (int) -> long = long
    write_line("{widen(7)}")

    // a .NET type
    let text: (string) -> Text.STRING_BUILDER = Text.STRING_BUILDER
    write_line("{text("built")}")

    // a value is built once per type in a function body
    let a: (string, int) -> PERSON = PERSON
    let b: (string, int) -> PERSON = PERSON
    write_line("{object.reference_equals(a, b)} {object.reference_equals(a, one)} {make_wide()(1, 2, 3, 4)}")

    // where a named delegate is expected
    let factory: System.Converter[string, PERSON] = PERSON
    write_line("{factory.invoke("gus")}")
si
