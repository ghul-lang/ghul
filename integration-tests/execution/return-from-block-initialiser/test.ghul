use IO.Std.write_line

// A return in a parenthesised block leaves the block, with its value,
// and the function goes on from there.
unconditional() -> int is
    let v = (return 9; 7)
    write_line("after the block, v is {v}")
    v + 1
si

only_a_return() -> int is
    let v = (return 9)
    v
si

typed() -> int is
    let v: int = (return 9)
    v
si

coalesced(x: int?) -> int is
    let v = x ?? (return -1; 0)
    v
si

as_argument(x: int?) -> int is
    let v = Ghul.Math.abs(x ?? (return -1; 0))
    write_line("after the call, v is {v}")
    v
si

returns_its_own_value(c: bool) -> string is
    let v = (return "from the block")

    if c then
        return "from the function"
    fi

    v
si

entry() is
    write_line("unconditional {unconditional()}")
    write_line("only a return {only_a_return()}")
    write_line("typed {typed()}")
    write_line("coalesced {coalesced(5)} {coalesced(null)}")
    write_line("as argument {as_argument(-5)} {as_argument(null)}")
    write_line("returns its own value {returns_its_own_value(true)} / {returns_its_own_value(false)}")
si
