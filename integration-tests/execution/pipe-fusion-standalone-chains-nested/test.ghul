use default

// A standalone chain inside a stage of another standalone chain is lowered
// after the outer one, in the outer stage's new home, and reads the outer
// stage's parameter there.
let rows = [[1, 2, 3], [4, 5, 6]] |> map(row => row |> filter(n => n != 2) |> map(n => n + row.count))

write_line(rows |> map(row => row |> join(",")) |> join(" "))
write_line(Ghul.Pipes.transpose([[1, 2, 3], [4, 5, 6]] |> map(row => row |> filter(n => true))) |> map(c => c |> join("")) |> join(","))
