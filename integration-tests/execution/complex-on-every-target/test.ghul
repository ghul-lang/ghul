use IO.Std.write_line
use Ghul.Pipes

// A complex number built from `r` and `j` literals, through arithmetic that
// takes two complex numbers, compared by value and written out.
entry() is
    let a = 3r + 4j
    let b = 1r - 2j

    write_line("{a} {b} {2.5j} {1.5e2r} {1_000r} {0.5j * 2j}")
    write_line("{a + b} {a - b} {a * b} {a / b} {-a}")
    write_line("{a.real} {a.imaginary} {a.magnitude} {complex.conjugate(a)}")
    write_line("{a == 3r + 4j} {a != b} {a == b} {a =~ complex(3.0, 4.0)}")

    let zs = [1r, 2j, 3r + 4j]

    write_line("{zs |> reduce(0r, (x, y) => x + y)}")
    write_line("{zs |> map(z => z * 2r) |> list()}")
    write_line("{zs |> map(* / 2r) |> list()}")
    write_line("{cast complex(2.5)} {complex.sqrt(-4r)}")
si
