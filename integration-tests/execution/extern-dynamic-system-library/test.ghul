use IO.Std.write_line

// A program linked dynamically against a shared library of the system's,
// zlib, through its runtime file: what it answers is computed by the
// library, not by anything linked into the program.

@extern("z", "zlibVersion", result = "copy")
zlib_version() -> string?

@extern("z", "crc32")
crc32(crc: ulong, buffer: ARRAY[ubyte], length: uint) -> ulong

let version = zlib_version() ?? ""
write_line("zlib 1.x: {version.starts_with("1.")}")

let text = [104ub, 101ub, 108ub, 108ub, 111ub] |> ARRAY()
write_line("crc32 of hello: {crc32(ulong(0), text, uint(5))}")
