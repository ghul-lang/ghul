use IO.Std.write_line
use Ghul.Pipes

class SHELF(items: string[], prefix: string) is
    labelled(suffix: string) -> Pipe[string] is
        let make = () is
            for item in items do
                yield "{prefix}{item}{suffix}"
            od
        si

        return make()
    si
si

evens(limit: int) -> Pipe[int] is
    let from_zero = (step: int) is
        let n mut = 0

        while n < limit do
            yield n
            n = n + step
        od
    si

    return from_zero(2)
si

repeat_each[T](xs: T[], times: int) -> Pipe[T] is
    let each_repeated = () is
        for x in xs do
            for _ in 0..times do
                yield x
            od
        od
    si

    return each_repeated()
si

write_line("method: {SHELF(["a", "b"], "<").labelled(">")}")
write_line("global: {evens(7)}")
write_line("generic: {repeat_each(["p", "q"], 2)}")
