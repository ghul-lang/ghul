use default

// A standalone chain whose stage reads a `*`, alone and inside a chain
// of its own.
row_of(column: int, row: int) -> string => "{column}.{row}"

cells() -> ((int) -> string){} => (0..3) |> map(row => row_of(*, row))

rows(columns: List[int]) -> string{} =>
    (0..3) |> map(row => columns |> map(row_of(*, row)) |> join(" "))

for cell in cells() do write_line(cell(7)) od
for line in rows([1, 2]) do write_line(line) od
