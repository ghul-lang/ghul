use IO.Std.write_line;

// An overloaded function passed by name, ghūl's own or a .NET static,
// where the formal's type picks the member.
over(c: char) -> string => "char";
over(s: string, i: int) -> string => "string";

apply(f: (char) -> string, c: char) -> string => f(c);
test(p: (int) -> int, n: int) -> int => p(n);

entry() is
    write_line(apply(over, 'x'));
    write_line(test(System.Math.abs, -3));
    write_line(test(System.Math.abs, 4));
si
