// A built-in operator written inside a type that declares its own operator
// of the same name runs the built-in, so it is not charged with the member's
// effects: the member here stores, and the operators that only subtract two
// ints are still store-free.
class LOG is
    count: int static public
si

struct B is
    value: int public

    init(value: int) is self.value = value si

    -(other: B) -> B is
        LOG.count = LOG.count + 1
        return B(value - other.value)
    si

    <>(other: B) -> int => value - other.value

    =~(other: B) -> bool => value - other.value == 0

    get_hash_code() -> int => value
si

IO.Std.write_line("{B(3) < B(4)} {B(5) =~ B(5)} {(B(7) - B(2)).value} {LOG.count}")
