namespace Test is
    use Std = IO.Std;

    class Main is
        compute() -> Concurrency.Future[int] static is
            Std.write_line("before-await");

            await Concurrency.Future.delay(5);

            Std.write_line("after-first-await");

            let answer = await Concurrency.Future.from_result(42);

            Std.write_line("got-answer={answer}");

            await Concurrency.Future.from_result(99);

            Std.write_line("after-discard-await");

            return answer + 1;
        si

        entry() static is
            let result = compute();

            Std.write_line("final={result.result}");
        si
    si
si
