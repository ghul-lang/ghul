// Threads that reach a class's static members together run its static
// constructor once, and every one of them sees what it set up.
use default
use Concurrency

class TABLE is
    runs: AtomicInt static
    squares: LIST[int] static

    init() static is
        runs = AtomicInt(0)
        runs.increment()

        // Slow enough that the other threads arrive while it runs.
        Tasks.Thread.sleep(50)

        squares = LIST[int]()

        for i in 0..100 do
            squares.add(i * i)
        od
    si

    square(i: int) -> int static => squares[i]
si

let readers = [start(() => TABLE.square(n + 1)) for n in 0..8]
let results = LIST[int]()

for r in readers do
    results.add(r.join())
od

write_line("{results}")
write_line("static constructor ran {TABLE.runs.load()} time")
