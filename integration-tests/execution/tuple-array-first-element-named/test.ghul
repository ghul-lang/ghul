use default

make(u: int) -> (x: int, y: int) => (x = u, y = u)

in_a_function() is
    let quads =
        (0..2)
            |> map(i => [(i, 0), (i + 1, 0)] |> map(((a, b)) => make(a)) |> collect_mutable())
            |> collect_mutable()

    for quad in quads do
        write_line("{quad |> map(p => p.x) |> join(",")}")
    od
si

let pairs =
    (0..2)
        |> map(i => [(i, 0), (i, 1)] |> map(t => make(t.`1)) |> collect_mutable())
        |> collect_mutable()

for pair in pairs do
    write_line("{pair |> map(p => p.x) |> join(",")}")
od

in_a_function()
