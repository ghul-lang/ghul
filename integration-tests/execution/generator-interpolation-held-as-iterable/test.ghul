use IO.Std.write_line
use Ghul.Pipes
use Collections

counting() -> Pipe[int] is
    yield 1
    yield 2
si

let xs = [1, 2, 3]

let lazy_pipe = {x * 2 for x in xs}
let lazy_iterable: Iterable[int] = {x * 2 for x in xs}
let lazy_object: object = {x * 2 for x in xs}

let literal = () -> Pipe[int] is
    yield 3
    yield 4
si

let literal_iterable: Iterable[int] = literal()
let literal_object: object = literal()

let named_iterable: Iterable[int] = counting()
let named_object: object = counting()

write_line("comprehension as pipe: {lazy_pipe}")
write_line("comprehension as iterable: {lazy_iterable}")
write_line("comprehension as object: {lazy_object}")
write_line("literal as pipe: {literal()}")
write_line("literal as iterable: {literal_iterable}")
write_line("literal as object: {literal_object}")
write_line("named as pipe: {counting()}")
write_line("named as iterable: {named_iterable}")
write_line("named as object: {named_object}")
