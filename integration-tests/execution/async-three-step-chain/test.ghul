namespace Test is
    use Std = IO.Std;

    // 10 → *2 → +1 → *100 = 2100
    class Main is
        entry() static is
            let result =
                Tasks.TaskExtensions.unwrap(
                    Concurrency.Future.from_result(10).continue_with(
                        (t1: Concurrency.Future[int]) -> Concurrency.Future[int] =>
                            Tasks.TaskExtensions.unwrap(
                                Concurrency.Future.from_result(t1.result * 2).continue_with(
                                    (t2: Concurrency.Future[int]) -> Concurrency.Future[int] =>
                                        Tasks.TaskExtensions.unwrap(
                                            Concurrency.Future.from_result(t2.result + 1).continue_with(
                                                (t3: Concurrency.Future[int]) -> Concurrency.Future[int] =>
                                                    Concurrency.Future.from_result(t3.result * 100)
                                            )
                                        )
                                )
                            )
                    )
                );

            Std.write_line("three_step.result={result.result}");
        si
    si
si
