use default

union Found is
    YES(value: int)
    NO(reason: string)
si

step(value, x) => if x > 0 then Found.YES(value + x) else Found.NO("stop") fi

walk(start, xs) => xs |> reduce(Found.YES(start), (running, x) => if let yes: Found.YES = running then step(yes.value, x) else running fi)

write_line("{walk(1, [2, 3])}")
write_line("{walk(1, [2, -1, 3])}")
