// Arrays of scalars narrower than 32 bits keep each element's value and
// sign: a signed element reads back negative, an unsigned one does not,
// and a stored value wraps to the element's width.
use IO.Std.write_line
use Ghul.Pipes

entry() is
    let bytes: byte[] = [cast byte(-128), -1b, 0b, 127b]
    let ubytes: ubyte[] = [0ub, 128ub, 255ub]
    let shorts: short[] = [cast short(-32768), -1s, 32767s]
    let ushorts: ushort[] = [0us, 32768us, 65535us]
    let flags = [true, false, true]
    let chars = ['a', '€', '￿']

    write_line("bytes {bytes[0]} {bytes[1]} {bytes[2]} {bytes[3]}")
    write_line("ubytes {ubytes[0]} {ubytes[1]} {ubytes[2]}")
    write_line("shorts {shorts[0]} {shorts[1]} {shorts[2]}")
    write_line("ushorts {ushorts[0]} {ushorts[1]} {ushorts[2]}")
    write_line("flags {flags[0]} {flags[1]} {flags[2]}")
    write_line("chars {int(chars[0])} {int(chars[1])} {int(chars[2])}")

    let total mut = 0

    for b in bytes do
        total = total + int(b)
    od

    write_line("byte total {total}")

    let wrapped_bytes = [cast byte(200)]
    let wrapped_ubytes = [cast ubyte(-1)]
    let wrapped_shorts = [cast short(40000)]
    let wrapped_ushorts = [cast ushort(-2)]

    write_line("wrapped {wrapped_bytes[0]} {wrapped_ubytes[0]} {wrapped_shorts[0]} {wrapped_ushorts[0]}")

    let filled = repeat(cast byte(-3), 4) |> Collections.LIST()

    filled[2] = 5b

    write_line("filled {filled |> map(b => int(b)) |> sum()}")

    let text = "h€llo"
    let units = text.to_char_array()

    write_line("units {units.count} {int(units[1])}")
    write_line("round trip {string(units)} {string(units) =~ text}")
si
