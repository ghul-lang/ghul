use IO.Std.write_line

trait Failure is
    message: string => "no message for {self}"
si

union Lookup: Failure is
    NOT_FOUND(program: string)
    OTHER(message: string)
si

through_trait(f: Failure) -> string => f.message

through_union(l: Lookup) -> string => l.message

write_line("trait, variant with field: {through_trait(Lookup.OTHER("disk full"))}")
write_line("trait, variant without field: {through_trait(Lookup.NOT_FOUND("ghul"))}")
write_line("union, variant with field: {through_union(Lookup.OTHER("permission denied"))}")
write_line("union, variant without field: {through_union(Lookup.NOT_FOUND("dotnet"))}")

let other = Lookup.OTHER("timed out")
write_line("variant: {other.message}")
