use default

// Overloads that differ only in what their selector returns, as the
// core library declares sum_by where it is compiled from source.
total_by[T..](source: T{}, selector: T.. -> int pure) -> string => "int {source |> map(selector) |> sum()}"
total_by[T..](source: T{}, selector: T.. -> long pure) -> string => "long {source |> map(selector) |> sum()}"

twice(n: int) -> int pure => n * 2
twice(n: long) -> long pure => n * 2L

write_line("ab" |> index() |> total_by((position, letter) => position * int(letter)))
write_line([(1, 2L), (3, 4L)] |> total_by((a, b) => long(a) * b))
write_line([1, 2] |> total_by(twice))
write_line("12" |> total_by(int))

write_line("{"89" |> index() |> sum_by((position, digit) => position * int(digit))}")
write_line("{[(1, 2), (3, 4)] |> sum_by((a, b) => a * b)}")
write_line("{[12, 34] |> sum_by(digit_sum)}")
write_line("{"12" |> sum_by(int)}")
write_line("{[2n, 3n] |> sum_by(n => n * 1_000_000_000_000n)}")
