namespace Library is
    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v);
si

namespace Test is
    use IO.Std.write_line;
    use Library.apply;

    // Tests: a pack-taking function declared alike in the calling
    // namespace and in one it imports. Both stay in the group the call
    // resolves over; the argument-pack adaptation applies to either, and
    // the local declaration shadows the imported one. Each call form
    // the pack accepts - a tuple, a named tuple, the elements spread out -
    // resolves.

    apply[T.., U](f: T.. -> U, arguments: T..) -> U => f(arguments);

    join_words(first: string, second: string) -> string => "{first} {second}";

    cuboid(width: int, height: int, depth: int) -> int => width * height * depth;

    entry() is
        let words = ("hello", "world");
        let box = (width = 2, height = 3, depth = 4);

        write_line(apply(join_words, words));
        write_line("{apply(cuboid, box)}");
        write_line("{apply(cuboid, 5, 6, 7)}");
    si
si
