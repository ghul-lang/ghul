use default

// min, max, min_by and max_by run in the fused consumer loop, reading
// the whole chain and answering with the best element or an absent
// value. The comparison is the key type's own ordering: the compare
// instruction for the scalars, `<>` read against zero for every other
// orderable type.
struct AGE(years: int public): Ghul.Comparable[AGE], Ghul.Equatable[AGE] is
    <>(other: AGE) -> int => years <> other.years;
    =~(other: AGE) -> bool => years == other.years;
    get_hash_code() -> int => years;
si

word_length(w: string) -> int => w.length

let xs = [5, 3, 8, 1, 9, 2]
let words = ["pear", "fig", "banana", "date"]
let ages = [AGE(42), AGE(7), AGE(99)]
let ubytes = [200ub, 5ub, 150ub]

write_line("{xs |> filter(n => n > 2) |> min()!} {xs |> max()!}")
write_line("{xs |> filter(n => n > 100) |> min()?} {words |> min()!} {words |> max()!}")
write_line("{ages |> min()!.years} {ages |> max()!.years}")
write_line("{ubytes |> min()!} {ubytes |> max()!}")
write_line("{words |> min_by(word_length)!} {words |> max_by(w => w.length)!}")
write_line("{[10, 3, 7] |> map(n => n * 2 - 1) |> min()!}")
write_line("{[(3, "c"), (1, "a"), (2, "b")] |> min_by(p => p.`1)!.`0}")
