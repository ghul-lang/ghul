namespace Test is
    use IO.Std.write_line;

    // Tests: on wasm an extern is a function the host supplies. A test's
    // externs.mjs is the host's side: numbers cross as numbers, a long and a
    // word as BigInts, and a string as a string, as an argument and as a
    // result.

    @extern("", "add_one")
    add_one(value: int) -> int;

    @extern("", "twice_long")
    twice_long(value: long) -> long;

    @extern("", "shout")
    shout(text: string) -> string;

    @extern("", "next_handle")
    next_handle() -> word;

    entry() is
        write_line("{add_one(41)} {twice_long(4_000_000_000L)} {shout("héllo")} {next_handle()}");
    si
si
