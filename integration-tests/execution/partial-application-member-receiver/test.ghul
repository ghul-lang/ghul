// `* .name` makes a partial application's `*` the receiver of the chain
// that follows: a member read, a call, or several of them, and the one
// operator the chain is an operand of. Written-out arguments along the
// chain are evaluated once, where the partial application is written.
use IO.Std.write_line
use Ghul.Pipes

class Person(name: string public, age: int public) is
    greeting(salutation: string) -> string => "{salutation}, {name}"
si

class Tally(count: int field)

struct Point(x: int public, y: int public) is
    sum: int => x + y
si

let words = ["alpha", "beta", "gamma"]

write_line("{"alpha" |> all(* .is_letter)} {"al1ha" |> all(* .is_letter)}")

write_line(words |> map(* .length) |> join(", "))
write_line(words |> map(* .to_upper()) |> join(", "))
write_line(words |> filter(* .length > 4) |> join(", "))
write_line(words |> map(* .trim().to_upper().length) |> join(", "))

let people = [Person("ann", 30), Person("bob", 25)]

write_line(people |> map(* .name) |> join(", "))
write_line(people |> map(* .name.length) |> join(", "))
write_line(people |> filter(* .age < 28) |> map(* .name) |> join(", "))

let calls mut = 0
let salutation = () => (calls = calls + 1; "hi")
let greetings = people |> map(* .greeting(salutation()))

write_line(greetings |> join(", "))
write_line(greetings |> join(", "))
write_line("{calls}")

let tallies = [Tally(3), Tally(4)]
write_line(tallies |> map(* .count) |> join(", "))

let points = [Point(1, 2), Point(3, 4)]
write_line(points |> map(* .sum) |> join(", "))
write_line(points |> map(* .x * 10) |> join(", "))

let starts: (string, string) -> bool = * .starts_with(*)
write_line("{starts("alpha", "al")} {starts("beta", "al")}")
