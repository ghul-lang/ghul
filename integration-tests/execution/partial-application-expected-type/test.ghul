use default

// Tests: the function type expected of a partial application types its
// `*` arguments, so the call can choose an overload nothing written
// pins - through a declared slot, a combinator's formal settled from a
// sibling argument, or a .NET delegate type - and the resolved formal
// still types a `*` the context says nothing about.

struct W(x: int public) is
    *(a: int, b: W) -> W static pure => W(a * b.x)
si

scale(a: int, b: int) -> int => a * b
scale(a: double, b: double) -> double => a * b

let triple: (W) -> W = `*(3, *)
write_line("{triple(W(4)).x}")

let halve: (double) -> double = scale(*, 0.5)
write_line("{halve(3.0)}")

let times: (int, int) -> int = `*(*, *)
write_line("{times(6, 7)}")

let scaled = [W(1), W(2)] |> map(`*(10, *)) |> map(w => w.x) |> string(",")
write_line("{scaled}")

let halves = [1.0, 3.0] |> map(scale(*, 0.5)) |> string(",")
write_line("{halves}")

let from_ten = `-(10, *)
write_line("{from_ten(3)}")

// A slot returning void types a `*` the same way - a declared slot, a
// void-returning combinator formal, or a generic void formal - and where
// the chosen overload returns a value, that value is discarded.

announce(s: string) is write_line("s:{s}") si
announce(n: int) is write_line("n:{n}") si

mirror(s: string) -> string => "{s}{s}"

apply_to[T](v: T, f: T -> void) is f(v) si

let shout: (string) -> void = announce(*)
shout("hey")

["x", "y"] |> each(announce(*))
["x", "y"] |> each(mirror(*))
apply_to(3, announce(*))
