use default

// Tests: a generator's local can be passed by reference before a yield,
// and an asynchronous function's around an await, whatever its type, and
// keeps the value written through the reference across later yields,
// awaits and writes.

bump(x: int ref) is
    x! = x! + 1
si

rename(s: string ref) is
    s! = "{s!}!"
si

counts() -> int{} is
    let seen_counts = MAP[int, int]()
    seen_counts[1] = 5

    let seen mut = 0
    seen_counts.try_get_value(1, seen ref)

    yield seen

    bump(seen ref)
    yield seen

    seen = seen * 10
    bump(seen ref)
    yield seen
si

names() -> string{} is
    let name mut = "a"

    for i in 0..3 do
        rename(name ref)
        yield name
    od
si

twice(n: int) -> Tasks.TASK[int] => Tasks.TASK.from_result(n * 2)

compute() -> Tasks.TASK[int] is
    let total mut = await twice(5)
    bump(total ref)

    let more = await twice(total)
    bump(total ref)

    return total + more
si

write_line("{counts() |> list()}")
write_line("{names() |> list()}")
write_line("{compute().result}")
