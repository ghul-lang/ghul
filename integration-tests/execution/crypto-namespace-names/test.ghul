use default

// The hashes and the secure generator live in Crypto: Crypto.MD5,
// Crypto.SHA1, Crypto.SHA256 and Crypto.RandomNumberGenerator. Their
// System.Security.Cryptography names are second spellings of the same
// types.

hex(bytes: ARRAY[ubyte]) -> string => bytes |> map(b => "{b:x2}") |> string()

let input = Text.Encoding.ascii.get_bytes("abc")

write_line(hex(Crypto.MD5.hash_data(input)))
write_line(hex(System.Security.Cryptography.MD5.hash_data(input)))
write_line(hex(Crypto.SHA1.hash_data(input)))
write_line(hex(System.Security.Cryptography.SHA1.hash_data(input)))
write_line(hex(Crypto.SHA256.hash_data(input)))
write_line(hex(System.Security.Cryptography.SHA256.hash_data(input)))

let draw = Crypto.RandomNumberGenerator.get_int32(10)
let old_draw = System.Security.Cryptography.RandomNumberGenerator.get_int32(5, 6)
let random: Crypto.RandomNumberGenerator = System.Security.Cryptography.RandomNumberGenerator.create()
let same_random: System.Security.Cryptography.RandomNumberGenerator = random
write_line("{draw >= 0 /\ draw < 10} {old_draw} {Crypto.RandomNumberGenerator.get_bytes(4).count}")
