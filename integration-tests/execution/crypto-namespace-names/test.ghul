use default

// The hashes live in Crypto: Crypto.MD5, Crypto.SHA1 and Crypto.SHA256.
// Their System.Security.Cryptography names are second spellings of the
// same types.

hex(bytes: ARRAY[ubyte]) -> string => bytes |> map(b => "{b:x2}") |> string()

let input = Text.Encoding.ascii.get_bytes("abc")

write_line(hex(Crypto.MD5.hash_data(input)))
write_line(hex(System.Security.Cryptography.MD5.hash_data(input)))
write_line(hex(Crypto.SHA1.hash_data(input)))
write_line(hex(System.Security.Cryptography.SHA1.hash_data(input)))
write_line(hex(Crypto.SHA256.hash_data(input)))
write_line(hex(System.Security.Cryptography.SHA256.hash_data(input)))
