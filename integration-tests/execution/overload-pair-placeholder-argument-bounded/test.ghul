use default

// As overload-pair-placeholder-argument-unbounded, with the generic overload
// bounded by a trait.

trait Addable[T: Addable[T]] is
    plus(other: T) -> T;
si

struct Money(cents: int public): Addable[Money] is
    plus(other: Money) -> Money => Money(cents + other.cents);
    to_string() -> string => "{cents}";
si

total(source: string{}) -> string => source |> join("")
total[T: Addable[T]](source: T{}) -> T? pure is
    let result: T? mut = null

    for value in source do
        result = if let r = result then r.plus(value) else value fi
    od

    return result
si

totals(rows) => rows |> map(row => row |> total()) |> list()

write_line(totals([[Money(1), Money(2)], [Money(3)]]) |> map(t => "{t}") |> join(" "))
