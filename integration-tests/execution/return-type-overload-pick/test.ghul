namespace Test is
    use Std = IO.Std;

    class Main is
        // Without `[int]`, from_exception's two overloads
        // (`Concurrency.Future.from_exception(ex)` returning the non-generic
        // `Concurrency.Future`, vs `Concurrency.Future.from_exception[T](ex)` returning
        // `Concurrency.Future[T]`) require the return-type constraint
        // `Concurrency.Future[int]` to disambiguate. The resolver picks
        // wrongly today.
        divide(a: int, b: int) -> Concurrency.Future[int] static is
            if b == 0 then
                return Concurrency.Future.from_exception(
                    Ghul.InvalidOperationException("division by zero")
                );
            fi
            return a / b;
        si

        entry() static is
            try
                let r = divide(10, 0).result;
                Std.write_line("unexpected: {r}");
            catch ex: Ghul.AggregateException
                Std.write_line("caught: {ex.get_base_exception().message}");
            yrt
        si
    si
si
