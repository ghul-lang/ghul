use default

first_of(box) => box |> first()
total(box) => box |> sum()
largest(box) => box |> max()
count_total(box) => box |> map(w => w.count) |> sum()

let boxes = [[1, 2], [3, 4, 5]]

write_line("{boxes |> map(first_of) |> list()}")
write_line("{boxes |> map(total) |> list()}")
write_line("{boxes |> map(largest) |> list()}")
write_line("{[[(tag = 1, count = 1), (tag = 2, count = 2)]] |> map(count_total) |> list()}")

write_line("{boxes |> map(b => total(b)) |> list()}")
write_line("{total([6, 7])}")
