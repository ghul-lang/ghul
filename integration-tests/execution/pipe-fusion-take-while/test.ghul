use default

// take_while and skip_while fuse as stages do: take_while ends the loop
// at the first element its predicate rejects, skip_while drops elements
// while the predicate accepts them and passes the rest through untested.
odd(n: int) -> bool => n % 2 == 1

let xs = [1, 3, 5, 4, 7, 9, 2, 11]

write_line(xs |> take_while(odd) |> join(","))
write_line(xs |> skip_while(odd) |> join(","))
write_line(xs |> filter(n => n < 9) |> take_while(odd) |> map(n => n * 10) |> join(","))
write_line([2, 4, 1, 3] |> skip_while(n => n % 2 == 0) |> take(2) |> join(","))

// a chain no site reads, run in its own generator
prefix(xs: int{}) -> int{} => xs |> take_while(odd) |> map(n => n * 10)
rest(xs: int{}) -> int{} => xs |> skip_while(odd)

write_line(prefix(xs) |> join(","))
write_line(rest(xs) |> join(","))

// a fused for inside a generator body
halved_evens(xs: int{}) -> int{} is
    for x in xs |> take_while(n => n % 2 == 0) do
        yield x / 2
    od
si

total_after(xs: int{}) -> int is
    let total mut = 0
    for x in xs |> skip_while(n => n < 5) |> take(3) do
        total = total + x
    od
    total
si

write_line(halved_evens([4, 8, 3, 6]) |> join(","))
write_line("{total_after([2, 4, 7, 10, 13, 1, 5])}")

// every element rejected, and none
write_line([2, 4] |> take_while(odd) |> join(",") |> string())
write_line([] |> skip_while(odd) |> join(",") |> string())
