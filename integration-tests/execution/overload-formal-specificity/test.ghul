namespace Test is
    use IO.Std.write_line

    // Tests: candidates the actuals score alike are ranked by their
    // formals. One is chosen when it is at least as specific at every
    // position and more specific at one.

    class Base is
        init() is si
    si

    class Derived: Base is
        init() is si
    si

    shape[T](rows: T[][]) -> string => "rows"
    shape[T](planes: T[][][]) -> string => "planes"

    apply[T](value: T) -> string => "value"
    apply[T](f: (int, int) -> T) -> string => "function"

    ⊕(a: int, b: int) -> string => "concrete"
    ⊕[T](a: T, b: T) -> string => "generic"

    describe(value: object) -> string => "object"
    describe(value: Base) -> string => "base"

    entry() is
        let planes: int[][][] = [[[1, 2]], [[3, 4]]]
        let rows: int[][] = [[1, 2], [3, 4]]

        write_line(shape(planes))
        write_line(shape(rows))
        write_line(apply((a: int, b: int) => a + b))
        write_line(apply(5))
        write_line(1 ⊕ 2)
        write_line("a" ⊕ "b")
        write_line(describe(Derived()))
        write_line(describe("text"))
    si
si
