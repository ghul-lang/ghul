namespace Test is
    use Std = IO.Std;
    use Collections.List;
    use Ghul.Pipes;

    // The mapper's return-type argument must be inferred from an
    // `if`-expression lambda body the same way it is from a bare
    // expression body: a value-type element resolves without
    // widening, and a reference-type element stays non-optional
    // when neither arm is null.

    class Main is
        entry() static is
            let a: List[int] = [1, 2] |> map((v) => if true then v else v fi) |> collect_mutable();
            let b: List[string] = ["x", "y"] |> map((v) => if false then v else "a" fi) |> collect_mutable();

            for v in a do
                Std.write_line("{v}");
            od

            for v in b do
                Std.write_line("{v}");
            od

            return;
        si
    si
si
