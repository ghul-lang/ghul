use IO.Std.write_line

// A function literal whose slot returns a value-type optional tuple, with
// type arguments the call is still inferring, infers them from the tuple
// its body produces, as it does when the slot's tuple is not optional.

first[T, S](seed: S, step: S -> (T, S)?) -> T? is
    if let (value, _) = step(seed) then
        return value
    fi

    return null
si

take_three[T, S](seed: S, step: S -> (T, S)?) -> T[] is
    let result = Collections.LIST[T]()
    let state mut = seed

    while result.count < 3 do
        if let (value, next) = step(state) then
            result.add(value)
            state = next
        else
            break
        fi
    od

    return result
si

unfold[T, S..](seed: S, step: S.. -> (T, S)?) -> T[] is
    let result = Collections.LIST[T]()
    let state mut = seed

    while result.count < 6 do
        if let (value, next) = step(state) then
            result.add(value)
            state = next
        else
            break
        fi
    od

    return result
si

entry() is
    write_line("{first(1, n => (n * n, n + 1))}")
    write_line("{take_three(1, n => (n * n, n + 1))}")
    write_line("{take_three(3, i => if i == 0 then null else (i, i - 1) fi)}")
    write_line("{take_three("ab", s => (s.length, "{s}!"))}")
    write_line("{take_three((a = 1, b = 2), p => (p.a + p.b, (a = p.b, b = p.a + p.b)))}")
    write_line("{unfold((0, 1), (a, b) => (a, (b, a + b)))}")
    write_line("{unfold((prev = 0, current = 1), (prev, current) => (current, (prev = current, current = prev + current)))}")
si
