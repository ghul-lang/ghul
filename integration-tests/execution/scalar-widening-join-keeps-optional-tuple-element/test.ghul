use IO.Std.write_line

// Joining tuples where one arm's element is null keeps that element
// optional: the tuples are not plain scalars, so the scalar widening join
// beside them leaves them alone.
entry(args: string[]) is
    let c = args.count == 0

    let joined = if c then (1, "present") else (2, null) fi
    write_line("{joined.`0} {joined.`1 ?? "absent"}")

    let scalar = if c then 1 else 2.5 fi
    write_line("{scalar / 2.0}")
si
