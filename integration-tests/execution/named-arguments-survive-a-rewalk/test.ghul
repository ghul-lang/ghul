namespace Test is
    use IO.Std.write_line

    shorter(left: string, right: string) -> int => left.length - right.length

    pick(ordering: (string, string) -> int, flip: bool) -> int =>
        if flip then ordering("bb", "a") else ordering("a", "bb") fi

    pair(x: int, y: bool) -> int => if y then x else 0 fi

    entry() is
        let held = shorter

        write_line("{pair(y = true, x = 3)} {held("a", "bb")}")
        write_line("{pick(flip = true, ordering = shorter)}")
    si
si
