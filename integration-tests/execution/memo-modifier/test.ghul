use IO.Std.write_line

let runs mut = 0

// recursion goes through the cache
fib(n: int) -> long memo =>
    if n < 2 then long(n) else fib(n - 1) + fib(n - 2) fi

// several arguments make a tuple key; each pair is computed once
cost(i: int, j: int) -> int memo is
    runs = runs + 1

    if i >= j then
        return 0
    fi

    let best mut = 1_000_000

    for k in i..j do
        let c = cost(i, k) + cost(k + 1, j) + 1

        if c < best then
            best = c
        fi
    od

    best
si

// no arguments: the first result is kept
first_runs() -> string memo => "{runs}"

// a return from inside a try still stores its result
guarded(n: int) -> int memo is
    runs = runs + 1

    try
        if n > 2 then
            return n * 10
        fi
    finally
        runs = runs + 100
    yrt

    -1
si

// strings are keyed by content
joined(a: string, b: string) -> string memo is
    runs = runs + 1
    "{a}-{b}"
si

class COUNTER is
    hits: int public

    init() is
    si

    // each instance has its own cache
    square(x: int) -> int memo is
        hits = hits + 1
        x * x
    si
si

class BOX[T](item: T) is
    // one cache per instantiation
    describe(n: int) -> string memo is
        runs = runs + 1
        "{item}x{n}"
    si
si

class UTIL is
    twice(s: string) -> string static memo is
        runs = runs + 1
        "{s}{s}"
    si
si

write_line("{fib(80)}")

runs = 0
write_line("{cost(0, 30)} {runs}")

runs = 0
write_line("{first_runs()}")
runs = 99
write_line("{first_runs()}")

runs = 0
write_line("{guarded(5)} {guarded(5)} {guarded(1)} {guarded(1)} {runs}")

runs = 0
let built = "{"x"}{"y"}"
write_line("{joined("xy", "z")} {joined(built, "z")} {runs}")

let c = COUNTER()
let d = COUNTER()
write_line("{c.square(4)} {c.square(4)} {c.square(5)} {c.hits} {d.square(4)} {d.hits}")

runs = 0
let b = BOX[int](7)
let s = BOX[string]("q")
write_line("{b.describe(1)} {b.describe(1)} {s.describe(1)} {runs}")

runs = 0
write_line("{UTIL.twice("ab")} {UTIL.twice("ab")} {runs}")

// a function value shares the cache
let f = fib
write_line("{f(80)} {f(81)}")
