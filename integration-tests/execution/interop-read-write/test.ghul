// Ghul.Interop.read and write load and store a scalar or a word at an address and
// a byte offset, unaligned, as a C struct lays its fields out. The intrinsics are
// declared here as the runtime declares them.
use default

@intrinsic("interop.read")
read[T](address: word, offset: int) -> T

@intrinsic("interop.write")
write[T](address: word, offset: int, value: T)

@extern("c", "malloc")
malloc(size: word) -> word

@extern("c", "free")
free(address: word)

let p = malloc(64w)
write[int](p, 0, 42)
write[double](p, 4, 2.5)
write[ubyte](p, 12, 200`ub)
write[bool](p, 13, true)
write[char](p, 14, 'x')
write[long](p, 17, -7L)
write[word](p, 25, p)
write[short](p, 33, -3s)
write[single](p, 35, 1.5s)
write_line("{read[int](p, 0)} {read[double](p, 4)} {read[ubyte](p, 12)} {read[bool](p, 13)} {read[char](p, 14)} {read[long](p, 17)} {read[word](p, 25) == p} {read[short](p, 33)} {read[single](p, 35)} {read[byte](p, 12)}")
free(p)
