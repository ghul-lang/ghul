use default

// A static member a trait requires can have type parameters of its own:
// each implementation is instantiated at the call's type arguments, and
// can reach the trait's other static members through them.
trait Measure[T: Measure[T]] is
    to_millimetres(value: T) -> int static
    convert[U: Measure[U]](value: U) -> T static
si

struct Metres(count: int public): Measure[Metres] is
    to_millimetres(value: Metres) -> int static => value.count * 1000
    convert[U: Measure[U]](value: U) -> Metres static => Metres(U.to_millimetres(value) / 1000)
si

struct Millimetres(count: int public): Measure[Millimetres] is
    to_millimetres(value: Millimetres) -> int static => value.count
    convert[U: Measure[U]](value: U) -> Millimetres static => Millimetres(U.to_millimetres(value))
si

convert_to[A: Measure[A], B: Measure[B]](a: A) -> B => B.convert(a)

write_line("{convert_to[Metres, Millimetres](Metres(3)).count}")
write_line("{convert_to[Millimetres, Metres](Millimetres(5000)).count}")
