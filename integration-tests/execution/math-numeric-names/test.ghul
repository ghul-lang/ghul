use IO.Std.write_line

// BitOperations and BitConverter live in Ghul.Math.

write_line("{Ghul.Math.BitOperations.pop_count(255u)} {Ghul.Math.BitOperations.is_pow2(64)}")
write_line("{Ghul.Math.BitConverter.get_bytes(258) |> Ghul.Pipes.join(",")} {Ghul.Math.BitConverter.to_int32(Ghul.Math.BitConverter.get_bytes(258), 0)}")
