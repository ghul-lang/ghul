use IO.Std.write_line

// Complex, BitOperations and BitConverter live in Ghul.Math. Their System
// names are second spellings of the same types.

let z: Ghul.Math.Complex = System.Numerics.Complex(3.0, 4.0)
let same: System.Numerics.Complex = z

write_line("{same.real} {same.imaginary} {Ghul.Math.Complex.abs(z)}")
write_line("{Ghul.Math.BitOperations.pop_count(255u)} {System.Numerics.BitOperations.is_pow2(64)}")
write_line("{System.BitConverter.get_bytes(258) |> Ghul.Pipes.join(",")} {Ghul.Math.BitConverter.to_int32(System.BitConverter.get_bytes(258), 0)}")
