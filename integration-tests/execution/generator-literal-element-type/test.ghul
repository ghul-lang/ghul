use IO.Std.write_line
use Ghul.Pipes

take_three[T](make: () -> Pipe[T]) -> T{} => make() |> take(3)

// from the first yield
let words = () is
    yield "one"
    yield "two"
si

// from a typed variable's slot
let objects: () -> Pipe[object] = () is
    yield "text"
    yield 42
si

// from the declared return type
let doubles = () -> Pipe[double] is
    yield 1.5
si

// from a parameter's slot, where the element type is inferred
let naturals = take_three(() is
    let n mut = 1

    do
        yield n
        n = n + 1
    od
si)

write_line("words: {words()}")
write_line("objects: {objects()}")
write_line("doubles: {doubles()}")
write_line("naturals: {naturals}")
