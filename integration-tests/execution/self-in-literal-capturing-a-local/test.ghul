use IO.Std.write_line

class BOX(value: int) is
    show(owner: HOLDER) is
        write_line("{value}: owner is the holder: {isa HOLDER(owner)}")
    si
si

class HOLDER is
    init() is si

    run(action: () -> void) is
        action()
    si

    expression_body(box: BOX) is
        run(() => box.show(self))
    si

    block_body(box: BOX) is
        run(() is
            box.show(self)
        si)
    si

    nested(box: BOX) is
        run(() =>
            run(() => box.show(self)))
    si

    captures_only_self() is
        run(() => write_line("self alone: owner is the holder: {isa HOLDER(self)}"))
    si

    implicit(box: BOX) is
        run(() => box.show(identity()))
    si

    identity() -> HOLDER => self
si

// A generic enclosing class types its frame's self field in the frame's
// own copies of the class's type arguments, so an explicit self read in a
// literal that captures a local has to be presented at the type the method
// sees - passing it where the enclosing generic type is expected is what
// catches the difference, since the two render alike.
class KEEPER[T](label: T) is
    run(action: () -> void) is
        action()
    si

    describe(keeper: KEEPER[T]) -> string => "keeper of {keeper.label}"

    with_local(box: BOX) is
        run(() => write_line("{box.value}: {describe(self)}"))
    si

    with_local_block(box: BOX) is
        run(
            () is
                write_line("{box.value}: {describe(self)}")
            si)
    si

    self_alone() -> KEEPER[T] => (() => self)()
si

let holder = HOLDER()

holder.expression_body(BOX(1))
holder.block_body(BOX(2))
holder.nested(BOX(3))
holder.captures_only_self()
holder.implicit(BOX(4))

let keeper = KEEPER[string]("k")

keeper.with_local(BOX(5))
keeper.with_local_block(BOX(6))
write_line("self alone: {keeper.self_alone().label}")
