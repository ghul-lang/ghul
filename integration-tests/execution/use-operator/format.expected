use IO.Std.write_line
use Ghul.Pipes
use Collections

class RESOURCE(name: string): Ghul.Disposable is
    count: int => name.length

    dispose() is
        write_line("  dispose {name}")
    si
si

open(name: string) -> RESOURCE is
    write_line("  open {name}")
    return RESOURCE(name)
si

add(a: int, b: int) -> int => a + b

fail() -> RESOURCE => throw System.Exception("no resource")

in_an_argument() is
    write_line("in an argument:")
    write_line("  sum {add(1, (use open("abc")).count)}")
    write_line("  after the call")
si

after_an_operand() is
    write_line("after an operand:")
    let x = 10
    write_line("  total {x + (use open("abcd")).count}")
si

in_a_loop() is
    write_line("in a for loop:")
    for c in use LIST(["x", "y"]).iterator do
        write_line("  element {c}")
    od
    write_line("  after the loop")
si

nested() is
    write_line("nested:")
    let outer = use open("outer")
    let inner = use open("inner")
    write_line("  using {outer.name} and {inner.name}")
si

in_a_paren_block() is
    write_line("in a paren block:")
    let n = (
        let r = use open("paren")
        r.count
    )
    write_line("  got {n}")
si

expression_bodied() -> int => (use open("body")).count

in_an_if_arm(flag: bool) is
    write_line("in an if arm used as an argument:")
    let sum = add(1, if flag then (use open("arm")).count else 0 fi)
    write_line("  sum {sum}")
    write_line("  in a string {add(2, if flag then (use open("hole")).count else 0 fi)}")
si

reassigned() is
    write_line("mut initialised from use:")
    let r mut = use open("first")
    r = RESOURCE("second")
    write_line("  now {r.name}")
si

let_use_sugar() is
    write_line("let use:")
    let use r = open("sugar")
    write_line("  using {r.name}")
si

statement_form() is
    write_line("statement forms:")
    (use open("guard"))
    use open("bare")
    write_line("  guarded")
si

throwing() is
    write_line("operand throws:")
    try
        let r = use fail()
        write_line("  unreachable {r.name}")
    catch e: System.Exception
        write_line("  caught {e.message}")
    yrt
si

generator() -> Pipe[int] is
    let r = use open("generator")
    yield r.count
    yield r.count + 1
si

async_body() -> Tasks.TASK[int] is
    let r = use open("async")
    await Tasks.TASK.`yield()
    return r.count
si

in_an_argument()
after_an_operand()
in_a_loop()
nested()
in_a_paren_block()
write_line("expression body: {expression_bodied()}")
in_an_if_arm(true)
reassigned()
let_use_sugar()
statement_form()
throwing()
write_line("generator:")
for g in generator() do
    write_line("  yielded {g}")
od
write_line("async: {async_body().result}")
