// A value narrowed by a type test to a type parameter, returned where that
// parameter's optional is expected: from a catch arm, and from a plain test
// on a parameter.

use IO.Std.write_line

caught[E: Ghul.Exception](action: () -> void) -> E? is
    try
        action()
    catch e: Ghul.Exception
        if isa E(e) then
            return e
        fi
        throw e
    yrt
    return null
si

as_kind[E: Ghul.Exception](e: Ghul.Exception) -> E? is
    if isa E(e) then
        return e
    fi
    return null
si

let c = caught[Ghul.InvalidOperationException](() => throw Ghul.InvalidOperationException("boom"))
write_line("caught {c?.message ?? "nothing"}")

let none = caught[Ghul.InvalidOperationException](() => write_line("no throw"))
write_line("caught {none?.message ?? "nothing"}")

write_line("as kind {as_kind[Ghul.InvalidOperationException](Ghul.InvalidOperationException("kept"))?.message ?? "absent"}")
write_line("as kind {as_kind[Ghul.InvalidOperationException](Ghul.Exception("other"))?.message ?? "absent"}")
