namespace Test is
    use IO.Std.write_line;

    // Tests: a reference to a scalar crosses to a foreign function as the
    // slot's address, so the function's write lands in the slot. strtol
    // writes where parsing stopped through its char ** argument. Covers a
    // local and a field.

    @extern("libc", "strtol")
    parse(text: string, end: word ref, base: int) -> long;

    class HOLDER is
        end: word field;
        init() is si
    si

    entry() is
        let end mut = 0w;
        let value = parse("123abc", end ref, 10);
        write_line("local: {value}, written: {end != 0w}");

        let holder = HOLDER();
        let octal = parse("17", holder.end ref, 8);
        write_line("field: {octal}, written: {holder.end != 0w}");
    si
si
