// A literal null passed to a `T?` parameter from inside a generic over `T`:
// to a method of a class constructed at that `T`, to a function given that
// `T` explicitly, to the library's list, and to a class's own method from
// inside the class.

use IO.Std.write_line
use Collections.LIST

class Hold[T] is
    _seen: string;

    init() is _seen = "nothing" si

    put(item: T?) is
        _seen = if item? then "{item}" else "absent" fi
    si

    clear() is put(null) si

    seen: string => _seen
si

shown[T](item: T?) -> string => if item? then "{item}" else "absent" fi

with_absent[T](a: T) -> string is
    let hold = Hold[T]()
    hold.put(null)
    let first = hold.seen
    hold.put(a)
    let second = hold.seen
    hold.clear()

    let list = LIST[T?]()
    list.add(a)
    list.add(null)

    "{first} {second} {hold.seen} {shown[T](null)} {shown(list[0])} {shown(list[1])}"
si

write_line(with_absent(1))
write_line(with_absent("s"))
