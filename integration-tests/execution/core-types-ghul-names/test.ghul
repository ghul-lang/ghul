use default
use Concurrency

// The core types every target provides are written by their ghūl names, and
// their .NET names still find the same types.

enum Color is
    RED,
    GREEN
si

class MARK: Ghul.Attribute is
    init() is si
si

// An awaiter that completes at once, through the asynchronous-function
// protocol's ghūl names.
struct READY: CriticalNotifyCompletion is
    _value: int

    init(value: int) is _value = value si

    get_awaiter() -> READY => self
    is_completed: bool => true
    get_result() -> int => _value
    on_completed(continuation: () -> void) is continuation() si
    unsafe_on_completed(continuation: () -> void) is continuation() si
si

@MARK()
doubled(n: int) -> Future[int] is
    let v = await READY(n)
    return v * 2
si

let xs = [10, 20, 30, 40, 50]

let middle: Ghul.IndexRange = 1..<1
let last_three: System.Range = 3..<<0
let same_type: System.Range = middle

write_line("{xs[middle] |> join(", ")} / {xs[last_three] |> join(", ")} / {xs[same_type] |> join(", ")}")

let start: Ghul.Index = middle.start
let end: System.Index = middle.end
write_line("{start.value} {start.is_from_end} {end.value} {end.is_from_end}")

write_line("{Ghul.Enum.parse[Color]("GREEN")} {System.Enum.parse[Color]("RED")}")

let marked: Ghul.Attribute = MARK()
let as_dotnet: System.Attribute = marked
write_line("{as_dotnet == marked}")

let machine: AsyncStateMachine? = null
let as_dotnet_machine: System.Runtime.CompilerServices.IAsyncStateMachine? = machine
write_line("{as_dotnet_machine?}")

write_line("{await doubled(21)}")
