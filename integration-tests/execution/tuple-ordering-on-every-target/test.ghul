use default

// Tests: tuples order with <, <=, > and >= on every target, element by
// element: an absent element orders first, and an element that isn't
// comparable throws.

class Thing is
    init() is si
si

later(name: string?) -> string? => name

write_line("{(1, 2) < (1, 3)} {(2, 0) > (1, 9)} {(1, 2) <= (1, 2)} {(1, 2) >= (1, 3)}")
write_line("{("a", 2) < ("b", 1)} {("b", 1) < ("a", 2)}")
write_line("{(1, (2, 3)) < (1, (2, 4))} {(1, 2, 3) > (1, 2, 2)}")

let absent: string? = later(null)
let present: string? = later("x")
write_line("{(1, absent) < (1, present)} {(1, present) > (1, absent)} {(1, absent) <= (1, absent)}")

write_line("{[(2, 1), (1, 5), (2, 0)] |> max_by(t => t)} {[(2, 1), (1, 5), (2, 0)] |> min_by(t => t)}")

let first = (1, Thing())
let second = (1, Thing())

try
    write_line("{first < second}")
catch e: Ghul.Exception
    write_line("an element that isn't comparable throws")
yrt
