// A function literal with no written return type, stored in a local and
// used later, is typed as it would be written at that use: the return
// takes the optional carrier the slot needs, or the value-type optional
// a plain value converts to. Absent values stay absent.
namespace Test is
    use Std = IO.Std;

    first[U](next: () -> U?) -> U? => next();

    apply[T, U](value: T, f: (T) -> U?) -> U? => f(value);

    seven() -> int? => 7;

    nothing() -> int? => null;

    word() -> string? => "word";

    no_word() -> string? => null;

    halve(x: int) -> int? => if x % 2 == 0 then x / 2 else null fi;

    entry() is
        let s = () => seven();
        Std.write_line("value present: {first(s) ?? -1}");

        let n = () => nothing();
        Std.write_line("value absent: {first(n) ?? -1}");

        let w = () => word();
        Std.write_line("reference present: {first(w) ?? "absent"}");

        let nw = () => no_word();
        Std.write_line("reference absent: {first(nw) ?? "absent"}");

        let typed = (x: int) => halve(x);
        Std.write_line("typed parameter present: {apply(8, typed) ?? -1}");
        Std.write_line("typed parameter absent: {apply(7, typed) ?? -1}");

        let untyped = x => halve(x);
        Std.write_line("untyped parameter: {apply(8, untyped) ?? -1}");

        let k = () => 7;
        let g: () -> int? = k;
        Std.write_line("plain into optional, stored: {g() ?? -1}");

        let h: () -> int? = () => 8;
        Std.write_line("plain into optional, in place: {h() ?? -1}");

        let direct = () => seven();
        Std.write_line("called directly: {direct() ?? -1}");

        let wrap = () => (let inner = () => seven(); first(inner));
        Std.write_line("within a literal: {wrap() ?? -1}");
    si
si
