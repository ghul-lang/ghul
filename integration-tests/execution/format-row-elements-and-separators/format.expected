use default

// Each pair stays whole on its row, and the separators stay where they
// were written even though the pipe chain's head is reached out of order.
let points = [
    (171.0D, 171.0D), (185.0D, 111.0D), (202.0D, 109.0D), (202.0D, 189.0D), (328.0D, 160.0D), (208.0D, 254.0D)
]

[1_000_000, 2_000_000] |> each(n => write_line("{n}"))

write_line("{points.count}")
