use IO.Std.write_line

// A .NET flags enum that the core library gives a ghūl name still combines
// its members with | and tests them with &.

let options = Text.RegexOptions.IGNORE_CASE | Text.RegexOptions.MULTILINE
let bindings = Ghul.Reflection.BindingFlags.PUBLIC | System.Reflection.BindingFlags.INSTANCE

write_line("{options} {bindings}")
write_line("{(options & Text.RegexOptions.IGNORE_CASE) == Text.RegexOptions.IGNORE_CASE}")
