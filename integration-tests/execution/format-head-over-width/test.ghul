namespace Formatting is
    use IO.Std;

    class GEOMETRY is
        init() is si

        make_a_point_from_coordinates(first: int, second: int) -> int => first * 100 + second;
    si

    class WORKSPACE is
        the_current_drawing_surface: GEOMETRY public;

        init() is the_current_drawing_surface = GEOMETRY(); si
    si

    entry() is
        let workspace = WORKSPACE();

        let the_first_point_in_the_drawing = workspace.the_current_drawing_surface.make_a_point_from_coordinates(12, 34);

        Std.write_line("{the_first_point_in_the_drawing}");
    si
si
