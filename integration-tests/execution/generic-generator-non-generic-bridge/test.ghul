use IO.Std.write_line;
use Collections.LIST;

twice[T](source: Collections.Iterable[T]) -> Collections.Iterable[T] is
    for item in source do
        yield item;
        yield item;
    od
si

entry() is
    // OfType reads a sequence that is not already an IEnumerable[object]
    // through the non-generic IEnumerable a generator frame bridges to.
    for value in System.Linq.Enumerable.of_type[object](twice(LIST([1, 2]))) do
        write_line("{cast int(value)}");
    od
si
