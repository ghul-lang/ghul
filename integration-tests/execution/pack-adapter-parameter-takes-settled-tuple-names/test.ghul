use IO.Std.write_line
use Ghul.Pipes

use BindingFlags = System.Reflection.BindingFlags
use TupleElementNamesAttribute = System.Runtime.CompilerServices.TupleElementNamesAttribute

// Each generated adapter takes the tuple its argument pack binds to.
// The element names that tuple settles with - here from a literal's
// result, or from the slot a nested literal goes into - are recorded
// on the adapter's parameter, whether the type arguments were inferred
// or written out.

marked_stream[T, S..](initial: S, advance: S.. -> (T, S)?) -> Pipe[T] =>
    STREAM_PIPE[T, S](initial, advance)

inferred_stream() -> Pipe[int] =>
    marked_stream((0, 1), (previous, current) => (previous, (current, previous + current)))

written_stream() -> Pipe[int] =>
    marked_stream[int, (current: int, int)]((0, 1), (previous, current) => (previous, (current, previous + current)))

nested[A.., B](f: (int) -> A.. -> B) -> A -> B => f(1)

written_nested() -> ((b: int, int)) -> int =>
    nested[(b: int, int), int]((n: int) => (a: int, b: int) => a + b + n)

describe(names: Collections.Iterable[string?]) -> string =>
    names |> map(name => name ?? "_") |> join(", ")

entry() is
    write_line("{inferred_stream() |> take(5) |> join(", ")}")
    write_line("{written_stream() |> take(5) |> join(", ")}")
    write_line("{written_nested()((2, 3))}")

    let flags = BindingFlags.PUBLIC | BindingFlags.NON_PUBLIC | BindingFlags.STATIC | BindingFlags.INSTANCE | BindingFlags.DECLARED_ONLY

    let found = Collections.LIST[string]()

    for type in System.Reflection.Assembly.get_entry_assembly()!.get_types() do
        for method in type.get_methods(flags) do
            if method.get_parameters().count == 1 /\ method.get_parameters()[0].name =~ "$pack" then
                let attributes = method.get_parameters()[0].get_custom_attributes(typeof TupleElementNamesAttribute, false)

                let names = Collections.LIST[string]()

                for attribute in attributes do
                    if let names_attribute: TupleElementNamesAttribute = attribute then
                        names.add(describe(names_attribute.transform_names))
                    fi
                od

                found.add(if names.count == 1 then names[0] else "no names" fi)
            fi
        od
    od

    found.sort()

    for line in found do
        write_line(line)
    od
si
