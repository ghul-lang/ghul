use IO.Std.write_line

// The right operand of ?? runs only where the left is absent. One that
// leaves by a throw, break or continue gives no value, and the result is
// the left operand's present type.
thrown(x: int?) -> int is
    let v = x ?? (throw Ghul.Exception("absent int"))
    write_line("after the throw, v is {v}")
    v
si

thrown_reference(x: string?) -> string => x ?? (throw Ghul.Exception("absent string"))

thrown_from_if(x: int?, c: bool) -> int =>
    x ?? if c then throw Ghul.Exception("from then") else throw Ghul.Exception("from else") fi

thrown_from_case(x: int?, c: int) -> int =>
    x ?? case c when 1 then throw Ghul.Exception("from one") else throw Ghul.Exception("from else") esac

typed(c: bool) -> int is
    let v: int = (throw Ghul.Exception("typed"))
    v
si

loops(xs: int?[]) -> int is
    let total mut = 0

    for x in xs do
        total = total + (x ?? (continue))

        let y = x ?? (break)
        total = total + y * 10
    od

    total
si

attempt(name: string, action: () -> int) is
    try
        write_line("{name} {action()}")
    catch e: Ghul.Exception
        write_line("{name} threw {e.message}")
    yrt
si

entry() is
    attempt("thrown present", () => thrown(3))
    attempt("thrown absent", () => thrown(null))
    write_line("thrown reference {thrown_reference("present")}")

    try
        thrown_reference(null)
    catch e: Ghul.Exception
        write_line("thrown reference threw {e.message}")
    yrt

    attempt("from if present", () => thrown_from_if(4, true))
    attempt("from if absent", () => thrown_from_if(null, false))
    attempt("from case present", () => thrown_from_case(5, 1))
    attempt("from case absent", () => thrown_from_case(null, 1))
    attempt("typed", () => typed(true))
    write_line("loops {loops([1, null, 2])}")
si
