use default

// Tests: typeof T builds on every target where T is a trait type, such as
// a list, a sequence or a map interface, as well as a class or a scalar,
// and gives one type object for one type. .NET names a type as the CLR
// does; wasm and llvm name it as it is emitted.

name_of[T](value: T) -> string => "{typeof T}"

same[T, U](a: T, b: U) -> bool => typeof T == typeof U

write_line(name_of(1))
write_line(name_of(LIST[int]()))

let list: string[] = ["a"]
write_line(name_of(list))

let map: Collections.MutableMap[string, int] = MAP[string, int]()
write_line(name_of(map))

let items: int{} = [1]
write_line(name_of(items))

let other: string[] = ["b"]
write_line("{same(list, other)} {same(list, items)}")
