namespace Test is
    use IO.Std.write_line;
    use Ghul.Functional.`>>;

    // Tests: a function *value* filling a pack formal beside an
    // untyped lambda. The value is not in the tree to re-walk, so it
    // is hoisted into a local the adapter's body calls through; the
    // lambda's own type is only settled once the operator resolves,
    // which restarts resolution and rebuilds its argument list. The
    // store into the hoisted local has to survive that restart, and
    // still run once.

    builds: int;

    make() -> (int, int) -> int is
        builds = builds + 1;
        return (a: int, b: int) -> int => a + b;
    si

    entry() is
        let both = make() >> (x => "<{x}>");

        write_line(both(1, 2));
        write_line(both(30, 4));
        write_line("builds={builds}");

        let stored = make();
        let tagged = stored >> (x => "[{x}]");

        write_line(tagged(5, 6));
        write_line("builds={builds}");
    si
si
