use default

// Tests: an operator expression with `*` for an operand is a partial
// application of the operator, `a + *` being `+(a, *)`: the `*` is the
// parameter, the other operand is evaluated once where the expression is
// written, and the operator is whichever `a + b` would resolve to - built
// in, a static or an instance member, a relational rewrite - with the
// `*` typed from the context or from the other operand.

class W(x: int public) is
<>(other: W) -> int => x - other.x
si

struct V(x: int public) is
+(a: V, b: V) -> V static pure => V(a.x + b.x)
<>(other: V) -> int => x - other.x
si

let n mut = 0
next() -> int is
n = n + 1
n
si

write_line("{[1, 2, 3] |> map(* + 1) |> string(",")}")
write_line("{[1, 2, 3] |> map(2 * *) |> string(",")}")
write_line("{[1, 2] |> map(10 - *) |> string(",")}")
write_line("{[1, 2, 3] |> map(* % 2) |> string(",")}")
write_line("{[1.0, 3.0] |> map(* / 2.0) |> string(",")}")
write_line("{[1, 2, 3, 4] |> filter(* < 3) |> string(",")}")
write_line("{[1, 2, 3] |> filter(* != 2) |> string(",")}")
write_line("{[1, 2] |> map(- *) |> string(",")}")

let plus_one = * + 1
let both: (int, int) -> int = * - *
write_line("{plus_one(41)} {both(9, 4)}")

write_line("{[V(1), V(2)] |> map(* + V(10)) |> map(v => v.x) |> string(",")}")
write_line("{[V(1), V(5)] |> filter(* < V(3)) |> map(v => v.x) |> string(",")}")
write_line("{[W(1), W(5)] |> filter(* < W(3)) |> map(w => w.x) |> string(",")}")

let counted = [10, 20] |> map(* + next()) |> string(",")
write_line("{counted} {n}")
