namespace Test is
    use Std = IO.Std;

    class Main is
        compute() -> Concurrency.Future[int] static is
            let answer = await Concurrency.Future.from_result(42);

            return answer + 1;
        si

        entry() static is
            let result = compute();

            Std.write_line("let_await.result={result.result}");
        si
    si
si
