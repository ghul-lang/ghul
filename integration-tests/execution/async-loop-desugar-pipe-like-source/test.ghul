namespace Test is
    use Std = IO.Std;

    // A type that implements both Iterable[int] and Iterator[int].
    // A `for` loop over a value of such a type reads it through the
    // iterator it hands out, as every read of a pipe does. To show
    // which face is used, this type's `iterator` returns a separate
    // iterator yielding a single marker value.
    class PIPE_LIKE: Collections.Iterable[int], Collections.Iterator[int] is
        _values: Collections.List[int];
        _index: int;

        init(values: Collections.List[int]) is
            _values = values;
            _index = -1;
        si

        // Iterator[int] members.
        current: int => _values[_index];
        move_next() -> bool is
            _index = _index + 1;
            return _index < _values.count;
        si
        reset() is _index = -1; si
        dispose() is si

        // Iterable[int] member: an iterator of its own, which the
        // loop reads.
        iterator: Collections.Iterator[int] => MARKER_ITERATOR();
    si

    class MARKER_ITERATOR: Collections.Iterator[int] is
        _delivered: bool;
        init() is _delivered = false; si
        current: int => 99;
        move_next() -> bool is
            if _delivered then return false; fi
            _delivered = true;
            return true;
        si
        reset() is _delivered = false; si
        dispose() is si
    si

    class Main is
        double_async(x: int) -> Tasks.TASK[int] static =>
            Tasks.TASK.delay(2).continue_with(
                (t: Tasks.TASK) -> int => x * 2
            );

        // `pipe` is statically typed as PIPE_LIKE - both Iterable[int]
        // and Iterator[int]. The for-loop asks it for `.iterator` and
        // reads the single 99 that yields.
        sum_pipe(pipe: PIPE_LIKE) -> Tasks.TASK[int] static is
            let total mut = 0;
            for x in pipe do
                let y = await double_async(x);
                total = total + y;
            od
            return total;
        si

        entry() static is
            let values: Collections.List[int] = [10, 20, 30];
            let pipe = PIPE_LIKE(values);
            let result = sum_pipe(pipe).result;
            // Read through `.iterator`: 99 * 2 = 198. Driven through its
            // own Iterator face it would be 10*2 + 20*2 + 30*2 = 120.
            Std.write_line("result={result}");
        si
    si
si
