use default

halve(x: int) => x / 2

add(a: int, b) => a + b

scale(factor, x: double) -> double => factor * x

sign(x: int) is
    if x > 0 then return "positive" fi
    if x < 0 then return "negative" fi
    return "zero"
si

evens(limit: int) is
    let n mut = 0
    while n < limit do
        yield n
        n = n + 2
    od
si

label(name: string, value) -> string => "{name}={value}"

counter(n) -> Pipe[int] is
    yield 1
    yield n
si

announce(x: int) is
    write_line("announce {x}")
si

write_line("{halve(9)} {add(1, 2)} {scale(2.0, 1.5)}")
write_line("{sign(3)} {sign(-3)} {sign(0)}")
write_line(evens(7) |> join(","))
write_line(label("n", 5))
write_line(counter(5) |> join(","))
announce(4)
