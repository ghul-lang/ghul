use IO.Std.write_line

// The types that have no abstract alternative are named in PascalCase.
// The UPPER_SNAKE_CASE spellings are second names for the same types.

let lazy: Ghul.Lazy[int] = Ghul.Lazy[int](() => 42)
let old_lazy: Ghul.LAZY[int] = lazy
write_line("{old_lazy.value}")

let box: Ghul.Box[int] = Ghul.Box[int](7)
let old_box: Ghul.BOX[int] = box
write_line("{old_box.value}")

let pair: Collections.KeyValuePair[string, int] = Collections.KeyValuePair[string, int]("a", 1)
let old_pair: Collections.KEY_VALUE_PAIR[string, int] = pair
write_line("{old_pair.key}{old_pair.value}")

let queue: Collections.PriorityQueue[string, int] = Collections.PriorityQueue[string, int]()
queue.enqueue("late", 2)
queue.enqueue("early", 1)
let old_queue: Collections.PRIORITY_QUEUE[string, int] = queue
write_line("{old_queue.dequeue()}")

let random: Ghul.Random = Ghul.Random(1)
let old_random: Ghul.RANDOM = random
write_line("{old_random.next(1)}")
