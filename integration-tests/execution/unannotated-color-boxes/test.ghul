use default
use Color = (red: int, green: int, blue: int)
use Weighted = (color: Color, count: int)

channel(c, axis) =>
    case axis
    when 0 then c.red
    when 1 then c.green
    else c.blue
    esac

spread(box, axis) =>
    let values = box |> map(w => channel(w.color, axis)) in
    (values |> max()!) - (values |> min()!)

widest(box) => 0..3 |> max_by(spread(box, *))!

score(box) => spread(box, widest(box))

worst_box(colors) => (
    let boxes = LIST([colors])
    boxes |> max_by(score)!
)

let colors = [(color = (red = 1, green = 2, blue = 3), count = 4), (color = (red = 9, green = 2, blue = 1), count = 2)]

write_line("{worst_box(colors)}")
