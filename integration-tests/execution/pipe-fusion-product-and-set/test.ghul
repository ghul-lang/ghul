use IO.Std.write_line
use Ghul.Pipes

// A fused product multiplies each element with the one instruction that
// element type's `*` is, from that type's one, so an empty chain is one
// and an int product wraps as the runtime's does. A type whose `*` is an
// operator method keeps the runtime's product. A fused
// collect_set adds each surviving element to a new set.
entry() is
    let k = 2
    let ns = [1, 2, 3, 4]

    write_line("product-int {ns |> map(x => x + k) |> product()}")
    write_line("product-long {[1L, 2L, 3L] |> filter(x => x > 1L) |> product()}")
    write_line("product-uint {[3u, 5u] |> map(x => x) |> product()}")
    write_line("product-double {[1.5, 2.0] |> map(x => x * 2.0) |> product()}")
    write_line("product-empty {ns |> filter(x => x > 10) |> product()}")
    write_line("product-wraps {[100000, 100000, 100000] |> map(x => x) |> product()}")

    let residues = ns |> map(x => x % k) |> collect_set()
    write_line("set-count {residues.count} {residues.contains(0)} {residues.contains(1)}")

    let none = ns |> filter(x => x > 10) |> collect_set()
    write_line("set-empty {none.count}")

    let bare = [3, 1, 3, 2] |> collect_set()
    write_line("set-bare {bare.count}")
si
