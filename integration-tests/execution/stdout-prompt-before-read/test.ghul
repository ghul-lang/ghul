use IO.Std.write
use IO.Std.write_line
use IO.Std.read_line

// A prompt written without a line break is seen before the program waits
// for the answer, as it is at a terminal.
write("name? ")

let name = read_line() ?? "nobody"

write_line("hello {name}")

write("again? ")

let answer = read_line() ?? "no"

write_line("answered {answer}")
