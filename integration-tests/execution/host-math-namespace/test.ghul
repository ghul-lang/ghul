use Ghul.Math.root
use Ghul.Math.power
use Ghul.Math.half_of
use IO.Std.write_line

entry() is
    // The intrinsics answer as System.Math's members do, reached by
    // import, by qualification, and through the System.Math alias.
    write_line("{root(2.0)}");
    write_line("{Ghul.Math.round_up(2.5)}");
    write_line("{Ghul.Math.round_down(2.7)}");
    write_line("{power(2.0, 10.0)}");
    write_line("{Ghul.Math.angle(1.0, 1.0)}");
    write_line("{Ghul.Math.log_base_two(1024.0)}");
    write_line("{System.Math.sqrt(3.0)}");
    write_line("{half_of(7.0)}");
si
