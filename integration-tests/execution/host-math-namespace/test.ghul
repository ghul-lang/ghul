use Ghul.Math.sqrt
use Ghul.Math.pow
use Ghul.Math.half_of
use IO.Std.write_line

entry() is
    // The intrinsics answer as System.Math's members do, reached by
    // import, by qualification, and through the System.Math alias.
    write_line("{sqrt(2.0)}");
    write_line("{Ghul.Math.ceiling(2.5)}");
    write_line("{Ghul.Math.floor(2.7)}");
    write_line("{pow(2.0, 10.0)}");
    write_line("{Ghul.Math.atan2(1.0, 1.0)}");
    write_line("{Ghul.Math.log2(1024.0)}");
    write_line("{System.Math.sqrt(3.0)}");
    write_line("{half_of(7.0)}");
si
