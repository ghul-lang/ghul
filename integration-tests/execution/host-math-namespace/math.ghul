// The core library's shape for maths: a namespace of free functions,
// declared here beside the runtime's own under names it does not use.
namespace Ghul.Math is
    @intrinsic("host.math_sqrt")
    root(value: double) -> double pure

    @intrinsic("host.math_ceiling")
    round_up(value: double) -> double pure

    @intrinsic("host.math_floor")
    round_down(value: double) -> double pure

    @intrinsic("host.math_pow")
    power(x: double, y: double) -> double pure

    @intrinsic("host.math_atan2")
    angle(y: double, x: double) -> double pure

    @intrinsic("host.math_log2")
    log_base_two(value: double) -> double pure

    // A plain function beside the intrinsics: the namespace is ordinary.
    half_of(value: double) -> double pure => value / 2.0
si
