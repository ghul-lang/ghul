use IO.Std.write_line

struct Below(limit: double public);

~(value: double, b: Below) -> bool => value < b.limit

struct Within(low: double public, high: double public);

~(value: double, w: Within) -> bool => value >= w.low /\ value < w.high

~[T](value: T, test: (T) -> bool) -> bool => test(value)

is_even(n: int) -> bool => n % 2 == 0

greater(n: int, than: int) -> bool => n > than

let reads mut = 0

counted(limit: double) -> Below is
    reads = reads + 1
    Below(limit)
si

// whole-arm values: a ~ arm, an equality arm, and a list mixing both
classify(x: double) -> string =>
    case x
    when Below(0.0) then "negative"
    when ~Within(0.0, 1.0) then "unit"
    when 1.0, Within(2.0, 3.0) then "one, or two to three"
    else "other"
    esac

// a named function, function literals and partial applications, with
// and without the marker
describe(n: int) -> string =>
    case n
    when x => x > 100 then "big"
    when ~-3 then "minus three"
    when ~x => x < 0 then "negative"
    when is_even then "even"
    when greater(*, 10) then "odd, over ten"
    when ~* > 4 then "odd, over four"
    else "odd"
    esac

// arms are tried in order: the first that matches wins
first_of(x: double) -> string =>
    case x
    when Below(10.0) then "below ten"
    when Below(5.0) then "below five"
    else "other"
    esac

// an absent subject matches no ~ arm, and null stays a presence test
optional(x: double?) -> string =>
    case x
    when Below(1.0) then "below one"
    when null then "absent"
    else "other"
    esac

for x in [-1.0, 0.5, 1.0, 2.5, 7.0] do
    write_line("{x}: {classify(x)}")
od

for n in [500, -3, -5, 4, 13, 7, 1] do
    write_line("{n}: {describe(n)}")
od

write_line(first_of(3.0))

write_line(optional(0.5))
write_line(optional(null))
write_line(optional(5.0))

// the arm value is evaluated once for each test
let r = case 2.0 when counted(1.0) then "no" when counted(3.0) then "yes" else "else" esac
write_line("{r} {reads}")
