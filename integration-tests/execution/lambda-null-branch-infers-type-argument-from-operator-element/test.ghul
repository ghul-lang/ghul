use IO.Std.write_line

// A function literal that ends its sequence by returning null infers the
// call's type argument from the tuple it returns otherwise, whatever the
// element in that position is: an operator over the parameter as much as
// the parameter itself.

take_three[T, S](seed: S, step: S -> (T, S)?) -> T[] is
    let result = Collections.LIST[T]()
    let state mut = seed

    while result.count < 3 do
        if let (value, next) = step(state) then
            result.add(value)
            state = next
        else
            break
        fi
    od

    return result
si

entry() is
    write_line("{take_three(3, i => if i == 0 then null else (i, i - 1) fi)}")
    write_line("{take_three(3, i => if i == 0 then null else (i * i, i - 1) fi)}")
    write_line("{take_three(1, n => if n > 2 then null else (n * 10, n + 1) fi)}")
    write_line("{take_three("a", s => if s.length > 2 then null else ("<{s}>", "{s}a") fi)}")
si
