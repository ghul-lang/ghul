use IO.Std.write_line
use Ghul.Pipes
use Collections

gen(n: int) -> Pipe[int[]] is
    for i in 0..n do
        yield [i * j for j in 0..3]
    od
si

compute(xs: int[]) -> Tasks.TASK[int] is
    await Tasks.TASK.yield()
    let evens = [x + 1 for x in xs if x % 2 == 0]
    return evens |> sum()
si

entry() is
    let xs = [1, 2, 3, 4]
    let m = [("one", 1), ("two", 2), ("three", 3)] |> MAP()

    write_line("{[x * x for x in xs]}")
    write_line("{[(a, b) for a in 1::3 for b in a::3 if a != b]}")
    write_line("{[[y for y in 0..x] for x in xs]}")
    write_line("{[f() for f in [() => x * 10 for x in xs]]}")
    write_line("{xs |> map(x => [y * x for y in xs]) |> ARRAY()}")
    write_line("{[x for x in xs |> filter(v => v > 1)] |> sum()}")
    write_line("{[k for (k, v) in m if v > 1] |> sort()}")
    write_line("{[x for x in xs if x > 10]}")
    write_line("{[c for c in "abc"]}")
    write_line("{[1, [x for x in xs] |> count()]}")
    let objects: object[] = [x for x in xs]
    write_line("{objects}")

    let pairs = [(n = x, sq = x * x) for x in xs]
    write_line("{[p.sq for p in pairs if p.n % 2 == 1]}")

    let long =
        [
            w.to_upper()
            for w in ["apple", "fig", "banana"]
            if w.length > 3
        ]
    write_line("{long}")

    for row in gen(3) do
        write_line("{row}")
    od

    write_line("{compute(xs).result}")
si
