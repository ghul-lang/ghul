use IO.Std.write_line

// Tuple element names never make two tuples with the same element types
// different types. A formal written with or without names takes either,
// a function literal's tuple result binds the formal's type parameters
// from its elements, and a join takes names where any side has them.
step[S, T](initial: S, f: (S) -> (S, T)) -> T =>
    let (_, t) = f(initial) in t

first[A, B](pair: (A, B)) -> A => pair.`0

second_named[A, B](pair: (left: A, right: B)) -> B => pair.right

entry() is
    // one side unnamed: the result of the literal binds T
    write_line("{step((0, 1), state => ((state.`1, state.`0 + state.`1), current = state.`1))}")
    write_line("{step(2, n => (n + 1, label = "n={n}"))}")

    // named actual, unnamed formal; unnamed actual, named formal
    write_line("{first((x = 3, y = "three"))}")
    write_line("{second_named((4, "four"))}")

    // same names
    write_line("{second_named((left = 5, right = "five"))}")

    // differing names: element types decide
    write_line("{second_named((x = 6, y = "six"))}")

    let p: (left: int, right: string) = (x = 7, y = "seven")
    write_line("{p.right}")

    // joins: same names kept, an unnamed side takes the named side's
    // names, and differing names take the later element's
    let same = [(x = 1, y = 2), (x = 3, y = 4)]
    let half = [(x = 1, y = 2), (3, 4)]
    let differ = [(x = 1, y = 2), (a = 3, b = 4)]

    write_line("{same[1].y} {half[1].y} {differ[0].b}")
si
