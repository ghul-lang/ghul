use IO.Std.write_line

go() is write_line("go ran") si
go_with(o: object?) is write_line("go_with ran with {o}") si

class RUNNER is
    init() is si
    run() is write_line("run ran") si
si

// A ghūl constructor overloaded on two delegate types, as Thread's is.
class HOLDER is
    init(start: System.Threading.ThreadStart) is
        write_line("thread start")
        start.invoke()
    si

    init(start: System.Threading.ParameterizedThreadStart) is
        write_line("parameterized thread start")
        start.invoke("argument")
    si
si

let first = Tasks.Thread(go)
first.start()
first.join()

let with_stack = Tasks.Thread(go, 1024 * 1024)
with_stack.start()
with_stack.join()

let with_argument = Tasks.Thread(go_with)
with_argument.start(42)
with_argument.join()

let runner = RUNNER()
let method = Tasks.Thread(runner.run, 1024 * 1024)
method.start()
method.join()

HOLDER(go)
HOLDER(go_with)
HOLDER(runner.run)
