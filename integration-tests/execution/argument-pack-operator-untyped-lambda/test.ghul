namespace Test is
    use IO.Std.write_line;
    use Ghul.Functional.`>>;

    // Tests: an untyped lambda as the right operand of variadic >>
    // over an N-ary left stage. The left operand goes through the
    // pack-adaptation retry and the right one through the partial
    // retry; both values have to survive into the emitted call.

    add(a: int, b: int) -> int => a + b;

    class Main is
        entry() static is
            let f = add >> (n => "{n}!");
            write_line(f(2, 3));
            return;
        si
    si
si
