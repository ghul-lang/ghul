use default

// The seed's second element is a call to a function whose return is still
// being inferred through mutual recursion when reduce is first resolved, so
// the seed alone binds the accumulator type.
halve(n) => if n < 2n then n else step(n, n) fi
step(n, r) => if r < 2n then r else step(n, r / 2n) fi

let (total, last) = 1::3 |> reduce((100n, halve(8n)), ((a, g), _) => (a + g, g + 0n))
write_line("{total} {last}")
