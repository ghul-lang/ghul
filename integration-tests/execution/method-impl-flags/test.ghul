use System.Runtime.CompilerServices.MethodImpl
use System.Runtime.CompilerServices.MethodImplOptions

class HOT is
    @MethodImpl(MethodImplOptions.NO_INLINING)
    kept(x: int) -> int => x + 1

    @MethodImpl(MethodImplOptions.AGGRESSIVE_INLINING)
    inlined(x: int) -> int => x + 2

    plain(x: int) -> int => x + 3

    init() is si
si

entry() is
    show("kept")
    show("inlined")
    show("plain")
si

show(name: string) is
    let method = (typeof HOT).get_method(name)!

    IO.Std.write_line(
        "{name}: {method.get_method_implementation_flags()}, "
        "{method.get_custom_attributes(true).count} attributes")
si
