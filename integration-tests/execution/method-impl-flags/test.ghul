use System.Runtime.CompilerServices.MethodImpl
use System.Runtime.CompilerServices.MethodImplOptions

class HOT is
    _cells: Collections.LIST[int] field

    @MethodImpl(MethodImplOptions.NO_INLINING)
    kept(x: int) -> int => x + 1

    @MethodImpl(MethodImplOptions.AGGRESSIVE_INLINING)
    inlined(x: int) -> int => x + 2

    plain(x: int) -> int => x + 3

    // Options combined with `|` make one constant.
    @MethodImpl(MethodImplOptions.NO_INLINING | MethodImplOptions.NO_OPTIMIZATION)
    slow(x: int) -> int => x + 4

    // On a property or an indexer the attribute goes to each accessor.
    @MethodImpl(MethodImplOptions.AGGRESSIVE_INLINING)
    size: int => _cells.count

    @MethodImpl(MethodImplOptions.AGGRESSIVE_INLINING)
    [i: int]: int => _cells[i], = value is _cells[i] = value si

    init() is _cells = Collections.LIST[int]() si
si

entry() is
    show("kept")
    show("inlined")
    show("plain")
    show("slow")
    show("$get_size")
    show("get_Item")
    show("set_Item")
si

// A property getter also carries CompilerGeneratedAttribute, hence its
// one attribute.
show(name: string) is
    let method = (typeof HOT).get_method(name)!

    IO.Std.write_line(
        "{name}: {method.get_method_implementation_flags()}, "
        "{method.get_custom_attributes(true).count} attributes")
si
