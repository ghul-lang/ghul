namespace Test is
    use IO.Std;

    class Holder is
        value: int public;

        init(v: int) is
            value = v;
        si
    si

    class Upper_Lower is
        init() is si
    si

    class HOLDER_TOO is
        init() is si
    si

    class Main is
        entry() static is
            let h = Holder(42);
            let _ = Upper_Lower();
            let _ = HOLDER_TOO();
            Std.write_line("{h.value}");
        si
    si
si
