use IO.Std.write_line
use Concurrency

// an asynchronous function awaits threads with and without a result, and
// one whose body throws; the task's result waits for all of them
total() -> Concurrency.Future[int] is
    let first = start(() => 20)
    let second = start(() => 22)
    let ran = AtomicBool(false)

    await start(() is ran.store(true) si)

    if !ran.load() then
        return -1
    fi

    return await first + await second
si

failure() -> Concurrency.Future[string] is
    try
        await start(() -> int is throw Ghul.InvalidOperationException("worker failed") si)
        return "no exception"
    catch e: Ghul.InvalidOperationException
        return "caught {e.message}"
    yrt
si

write_line("total {total().result}")
write_line(failure().result)
