namespace Grid is
    use IO.Std.write_line;

    weigh(a: int, b: int) -> int => a + b * 10;

    apply_n[T.., U](f: T.. -> U, v: T..) -> U => f(v);

    cell() -> int is
        return apply_n(weigh, 1, 2);
    si

    entry() is
