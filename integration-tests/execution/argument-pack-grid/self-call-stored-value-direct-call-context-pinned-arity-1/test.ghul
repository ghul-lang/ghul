    cell() -> int is
        let combinators = COMBINATORS();
        return combinators.run();
    si

    entry() is
        try
            let result = cell();

            if result == 1 then
                write_line("ok {result}");
            else
                write_line("wrong result, expected 1");
            fi
        catch e: Ghul.Exception
