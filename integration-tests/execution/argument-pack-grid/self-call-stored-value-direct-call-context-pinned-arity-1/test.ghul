namespace Grid is
    use IO.Std.write_line;

    class COMBINATORS is
        init() is si

        once[T.., U](f: T.. -> U) -> T.. -> U => v => f(v);

        run() -> int is
            let stored = (a: int) -> int => a;
            let g: (int) -> int = self.once(stored);
            return g(1);
        si
