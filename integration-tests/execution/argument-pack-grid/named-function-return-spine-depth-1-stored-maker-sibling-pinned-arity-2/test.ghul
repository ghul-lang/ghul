namespace Grid is
    use IO.Std.write_line;

    weigh(a: int, b: int) -> int => a + b * 10;

    run_1[T.., U](make: (int) -> T.. -> U, v: T..) -> U => make(10)(v);

    cell() -> int is
        let make = (k: int) => weigh;
        return run_1(make, 1, 2);
    si

    entry() is
