namespace Grid is
    use IO.Std.write_line;

    once[T.., U](f: T.. -> U) -> T.. -> U => v => f(v);

    cell() -> int is
        let stored = (a: int) -> int => a;
        let g = once(stored);
        return g(1);
    si

    entry() is
        try
            let result = cell();

            if result == 1 then
                write_line("ok {result}");
            else
                write_line("wrong result, expected 1");
            fi
        catch e: Ghul.Exception
            write_line("exception {e.get_type()}");
        yrt
    si
