namespace Test is
    use Std = IO.Std;

    class Main is
        produce(value: int) -> Concurrency.Future[int] static =>
            Concurrency.Future.run(
                () -> int is
                    return value;
                si
            );

        entry() static is
            let tasks: Collections.List[Concurrency.Future[int]] = [
                produce(10),
                produce(20),
                produce(30),
                produce(40)
            ];

            let combined =
                Concurrency.Future.when_all(tasks).continue_with(
                    (t: Concurrency.Future[ARRAY[int]]) -> int is
                        let total mut = 0;
                        for v in t.result do
                            total = total + v;
                        od

                        return total;
                    si
                );

            Std.write_line("when_all.sum={combined.result}");
        si
    si
