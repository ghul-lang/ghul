use IO.Std.write_line

// The text types that have no abstract alternative are named in PascalCase.

let builder: Text.StringBuilder = Text.StringBuilder()
builder.append("ab")
builder.append("c")
write_line("{builder}")

let regex: Text.Regex = Text.Regex("([a-z]+)([0-9]+)")
let match: Text.Match = regex.match("ab12")
let group: Text.Group = match.groups[2]
write_line("{match.success} {group.value} {regex.is_match("!")}")

let rune: Text.Rune = Text.Rune('é')
write_line("{rune.value}")
