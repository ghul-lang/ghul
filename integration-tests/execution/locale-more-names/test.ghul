use IO.Std.write_line

// The rest of the names that carried "culture": locale members, the
// comparison enums and the comparers.

let neutral: Text.Locale = Text.Locale.get("")
let types = Text.Locale.get_locales(Text.LocaleTypes.NEUTRAL_LOCALES)

write_line("{neutral.name.length} {neutral.is_neutral == false} {types.count >= 0}")
write_line("{string.compare("a", "A", Text.StringComparison.INVARIANT_LOCALE_IGNORE_CASE)}")
write_line("{System.StringComparer.invariant_ignore_case.equals("a", "A")}")
