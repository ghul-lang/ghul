use default

let total = box => box |> sum()

run() is
    first_of(box) => box |> first()

    write_line("{[[1, 2], [3]] |> map(first_of) |> list()}")
si

first_of_each(boxes) => boxes |> map(first_of_box) |> list()
first_of_box(box) => box |> first()

total_plus_one(box) => total(box) + 1
totals(boxes) => boxes |> map(total_plus_one) |> list()

write_line("{[[1, 2], [3]] |> map(total) |> list()}")
run()
write_line("{first_of_each([[4, 5], [6]])}")
write_line("{totals([[1, 2], [3]])}")
