use default

leaves(dimensions: Collections.List[int]) -> int is
    count(level: int) -> int =>
        if level == dimensions.count then
            1
        else
            let f = (i: int) => count(level + 1)
            0..dimensions[level] |> map(f) |> sum()
        fi

    count(0)
si

write_line("{leaves(LIST([2, 3]))}")
