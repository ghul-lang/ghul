// A list of the optional of a type parameter at `T = int` in the same
// program as a list of `int?`.

use IO.Std.write_line
use Collections.LIST
use Collections.MAP

text(v: int?) -> string => if v? then "{v}" else "null" fi

count_present(values: int?{}) -> string is
    let present mut = 0
    let total mut = 0
    for v in values do
        total = total + 1
        if v? then present = present + 1 fi
    od
    return "{present} present of {total}"
si

with_absent[T](a: T, b: T) -> LIST[T?] is
    let result = LIST[T?]()
    let none: T? = null
    result.add(a)
    result.add(none)
    result.add(b)
    return result
si

let numbers = LIST[int?]()
numbers.add(1)
numbers.add(null)
numbers.add(3)
write_line("numbers {numbers.count} first {text(numbers[0])} second {text(numbers[1])}")
write_line(count_present(numbers))

let scores = MAP[string, int?]()
scores["alice"] = 10
scores["bob"] = null
write_line("alice {text(scores["alice"])} bob {text(scores["bob"])}")

let generic = with_absent(6, 7)
write_line("generic {generic.count} first {if generic[0]? then "{generic[0]}" else "null" fi} second {if generic[1]? then "{generic[1]}" else "null" fi}")
