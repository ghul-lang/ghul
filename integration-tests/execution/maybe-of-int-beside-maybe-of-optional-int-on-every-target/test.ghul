// A generic building an array of `T?` at `T = int` in the same program as a
// `find` over a list of `int?`: the two optionals of a type parameter, one
// over `int` and one over `int?`, are held differently and must not meet.

use IO.Std.write_line
use Ghul.Pipes
use Collections.LIST

with_absent_first[T](a: T, b: T) -> ARRAY[T?] =>
    [null, a, b]

let numbers = with_absent_first(2, 3)
write_line("{numbers.count}")

let optional_numbers = LIST[int?]()
optional_numbers.add(null)
let hit = optional_numbers |> find(x => !x?)
write_line("{hit?}")
