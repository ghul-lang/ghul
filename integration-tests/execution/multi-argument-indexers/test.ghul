use default

// An indexer can take several arguments, read as `g[i, j]` and assigned
// as `g[i, j] = v`, and overloads are chosen over all of them.
class GRID[T] is
    _cells: LIST[T]
    columns: int public

    init(rows: int, columns: int, fill: T) is
        self.columns = columns
        _cells = LIST[T]()

        for i in 0..rows * columns do
            _cells.add(fill)
        od
    si

    [row: int, column: int]: T => _cells[row * columns + column], = value is _cells[row * columns + column] = value; si

    [position: (int, int)]: T => self[position.`0, position.`1]

    [row: int, name: string]: string => "{name} {row}"
si

let g = GRID[int](3, 4, 0)

g[1, 2] = 7
g[2, 3] = g[1, 2] * 2

let i = 1
let j = 2

write_line("{g[i, j]} {g[2, 3]} {g[0, 0]} {g[(2, 3)]} {g[1, "row"]}")

g[i, j] = g[i, j] + 1

write_line("{g[1, 2]}")
