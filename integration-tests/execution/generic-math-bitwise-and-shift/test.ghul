use IO.Std.write_line;

use Ghul.Math.BinaryInteger;
use Ghul.Math.BitwiseOperators.`&;
use Ghul.Math.BitwiseOperators.`|;
use Ghul.Math.BitwiseOperators.`^;
use Ghul.Math.BitwiseOperators.`\;
use Ghul.Math.ShiftOperators.`<<;
use Ghul.Math.ShiftOperators.`>>;
use Ghul.Math.ShiftOperators.`>>>;
use Ghul.Math.UnaryNegationOperators.`-;
use Ghul.Math.SubtractionOperators.`-;

both[T: BinaryInteger[T]](a: T, b: T) -> T => a & b;

either[T: BinaryInteger[T]](a: T, b: T) -> T => a | b;

difference[T: BinaryInteger[T]](a: T, b: T) -> T => a ^ b;

up[T: BinaryInteger[T]](a: T, by: int) -> T => a << by;

down[T: BinaryInteger[T]](a: T, by: int) -> T => a >> by;

down_unsigned[T: BinaryInteger[T]](a: T, by: int) -> T => a >>> by;

// One parameter rather than two, so a different resolution path from
// every other operator here.
complement[T: BinaryInteger[T]](a: T) -> T => \a;

negate[T: BinaryInteger[T]](a: T) -> T => -a;

// `-` is the one name two interfaces supply, at different
// arities, so both have to survive being imported together.
subtract[T: BinaryInteger[T]](a: T, b: T) -> T => a - b;

entry() is
    write_line("{both(12, 10)}");
    write_line("{either(12, 10)}");
    write_line("{difference(12, 10)}");
    write_line("{up(3, 4)}");
    write_line("{down(48, 4)}");
    write_line("{down_unsigned(-16, 2)}");
    write_line("{down(-16, 2)}");
    write_line("{complement(5)}");
    write_line("{negate(7)}");
    write_line("{subtract(10, 3)}");
    write_line("{negate(subtract(10, 3))}");
    write_line("{6 & 3} {6 | 3} {6 ^ 3} {6 << 2} {48 >> 2} {\5} {-7}");
si
