@@suppress("deprecated")

namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A fused `collect` produces the same array the unfused one does:
    // over a list and a value-type range source, under map, filter,
    // take and index stages, over an empty source, and through the
    // collect_array alias. Each is printed element by element so the
    // array's contents and count are both checked.
    class Main is
        show(name: string, xs: int[]) static is
            let parts = xs |> map(x => "{x}") |> join(",");

            Std.write_line("{name}: [{parts}] count={xs.count}");
        si

        entry() static is
            let ns = LIST[int]([1, 2, 3, 4, 5, 6]);

            show("map", ns |> map(n => n * 10) |> collect());
            show("filter", ns |> filter(n => n % 2 == 0) |> collect());
            show("map-filter", ns |> map(n => n + 1) |> filter(n => n > 3) |> collect());
            show("take", ns |> take(2) |> collect());
            show("skip", ns |> skip(4) |> collect());
            show("range", (10..14) |> map(n => n * 2) |> collect());
            show("empty", LIST[int]() |> map(n => n) |> collect());
            show("alias", ns |> map(n => -n) |> collect_array());

            let indexed = ns |> index() |> map(iv => iv.index * 100 + iv.value) |> collect();
            show("index", indexed);

            // the result is an array: it has a fixed count and reads by index
            let squares = ns |> map(n => n * n) |> collect();
            Std.write_line("first={squares[0]} last={squares[squares.count - 1]}");
        si
    si
si
