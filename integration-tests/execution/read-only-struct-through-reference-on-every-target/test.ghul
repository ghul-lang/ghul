use default

// Tests: a tuple read through a reference is a copy of the value, so a
// later write through the same reference doesn't change what was read,
// whether the swap goes through a temporary or a tuple assignment.

swap_through_temporary[T](left: T ref, right: T ref) is
    let t = left!
    left! = right!
    right! = t
si

swap_by_assignment[T](left: T ref, right: T ref) is
    (left!, right!) = (right!, left!)
si

swap_pairs(left: (int, string) ref, right: (int, string) ref) is
    let t = left!
    left! = right!
    right! = t
si

entry() is
    let a mut = (1, "one")
    let b mut = (2, "two")
    swap_through_temporary(a ref, b ref)
    write_line("{a} {b}")

    let c mut = (1, "one")
    let d mut = (2, "two")
    swap_by_assignment(c ref, d ref)
    write_line("{c} {d}")

    let e mut = (1, "one")
    let f mut = (2, "two")
    swap_pairs(e ref, f ref)
    write_line("{e} {f}")
si
