use default
use Collections.Iterable
use Ghul.Pipes.Pipe

// A value whose parameters are the enclosing generic's own type
// parameters names its tuple as definitely as a concrete one does, so
// it is adapted to a pack slot the same way.
zip_with[A, B, C](xs: Iterable[A], ys: Iterable[B], f: (A, B) -> C) -> C{} =>
    xs |> zip(ys) |> map(f)

// The same value carried through a second generic layer.
outer[A, B, C](xs: Iterable[A], ys: Iterable[B], f: (A, B) -> C) -> C{} =>
    zip_with(xs, ys, f)

apply_pack[T.., U](f: T.. -> U, v: T..) -> U => f(v)

via_pack[A, B, C](a: A, b: B, f: (A, B) -> C) -> C => apply_pack(f, a, b)

concrete(xs: Iterable[int], ys: Iterable[int], f: (int, int) -> int) -> int{} =>
    xs |> zip(ys) |> map(f)

entry() is
    write_line("generic: {zip_with([1, 2], [10, 20], (a, b) => a + b)}")
    write_line("layered: {outer([1, 2], [10, 20], (a, b) => a + b)}")
    write_line("concrete: {concrete([1, 2], [10, 20], (a, b) => a + b)}")
    write_line("through pack: {via_pack(3, 4, (a, b) => a * b)}")
    write_line("mixed: {via_pack("x", 2, (s, n) => "{s}{n}")}")
si
