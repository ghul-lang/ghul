namespace Test is
    use IO.Std.write_line;

    // Tests: a struct with layout "c" crosses to a foreign function by
    // reference as the address of the caller's struct, so the function's
    // writes land in its fields at the offsets C gives them. gmtime_r fills
    // a struct tm, nine ints then a long after four bytes of padding, then a
    // pointer; a field read from the wrong offset prints a wrong date.

    @layout("c")
    struct TM is
        second: int field public;
        minute: int field public;
        hour: int field public;
        day: int field public;
        month: int field public;
        year: int field public;
        weekday: int field public;
        yearday: int field public;
        is_dst: int field public;
        gmt_offset: long field public;
        zone: word field public;

        init() is si
    si

    @extern("libc", "gmtime_r")
    gmtime(time: long ref, result: TM ref) -> word;

    entry() is
        // 2001-09-09 01:46:40 UTC
        let time mut = 1_000_000_000L;
        let tm mut = TM();
        tm.gmt_offset = -1L;

        let returned = gmtime(time ref, tm ref);

        write_line("{tm.year + 1900}-{tm.month + 1}-{tm.day} {tm.hour}:{tm.minute}:{tm.second}");
        write_line("weekday {tm.weekday}, yearday {tm.yearday}, dst {tm.is_dst}");
        write_line("offset {tm.gmt_offset}, zone set {tm.zone != 0w}, returned {returned != 0w}");
    si
si
