// System.Enum.parse and try_parse, with and without ignore_case: names,
// comma lists, numbers whether or not a member has them, white space, and
// each failure, alike on every target.
use IO.Std.write_line

enum Op is
    PUSH = 1,
    HALT = 2,
    JUMP = 4
si

show(text: string) is
    try
        write_line("[{text}] {System.Enum.parse[Op](text)} {cast int(System.Enum.parse[Op](text))}")
    catch e: Ghul.Exception
        write_line("[{text}] {e.get_type().name}: {e.message}")
    yrt
si

entry() is
    for t in ["HALT", " HALT ", "halt", "PUSH, JUMP", "PUSH,JUMP", " 4 ", "7", "-3", "+2", "99999999999", "NOPE", "", "  ", "PUSH, NOPE", "1, 2", "PUSH,", "HALT, 4", "4x"] do
        show(t)
    od

    let r mut = Op.PUSH
    write_line("{System.Enum.try_parse[Op]("halt", r ref)} {r}")
    write_line("{System.Enum.try_parse[Op]("halt", true, r ref)} {r}")
    write_line("{System.Enum.try_parse[Op]("NOPE", r ref)} {cast int(r)}")
    write_line("{System.Enum.parse[Op]("jump", true)}")
si
