use IO.Std.write_line

let step = 10
let offset mut = 100

// step is captured by value, offset by reference
let counting = (count: int) is
    let i mut = 0

    while i < count do
        yield i * step + offset
        i = i + 1
    od
si

let numbers = counting(3)

write_line("first read: {numbers}")

offset = 200

// the stored pipe rewinds, re-runs the body and sees the new offset
write_line("second read: {numbers}")
