use default

union Tree is
    EMPTY
    NODE(left: Tree, key: int, right: Tree)
si

leaf(key) => Tree.NODE(Tree.EMPTY, key, Tree.EMPTY)

// One branch produces a node and the other any tree: the return is a tree.
grow(tree, key) =>
    if let n: Tree.NODE = tree then
        Tree.NODE(n.left, n.key, leaf(key))
    else
        tree
    fi

// A word, or null when there isn't one: the return is optional.
first_long(words) is
    for word in words do
        if word.length > 3 then
            return word
        fi
    od

    return null
si

size(tree) =>
    case tree
    when n: Tree.NODE then 1 + size(n.left) + size(n.right)
    else 0
    esac

write_line("{size(grow(leaf(1), 2))} {size(grow(Tree.EMPTY, 2))}")
write_line("{first_long(["a", "long"]) ?? "none"} {first_long(["a"]) ?? "none"}")

// Its tail waits on a top-level let typed after this function is walked.
let primes = [2, 3, 5, 7] |> map(bigint) |> list()

primorial(count) => primes[0..count] |> product()

write_line("{primorial(3).to_string().length}")
