use IO.Std.write_line

@IF.dotnet()
entry() is
    write_line("the dotnet declaration was kept")
    write_line(what_this_target_runs())
si

@IF.dotnet()
what_this_target_runs() -> string => "and it is the dotnet one"

@IF.wasm()
// Names something that exists nowhere, so a build that kept this
// declaration would not compile. A dotnet build drops it and never
// sees the name.
what_this_target_runs() -> string => no_such_function_exists_anywhere()
