use default

evens(limit) is
    let result = LIST()

    for n in 0..limit do
        if n % 2 == 0 then
            result.add(n)
        fi
    od

    return result
si

counts(words) is
    let seen = MAP()

    for word in words do
        seen[word] = (if seen.contains_key(word) then seen[word] else 0 fi) + 1
    od

    seen
si

write_line("{evens(7)} {counts(["a", "b", "a"])["a"]}")
