// `u!` on a union holding a variant other than its default throws
// `Ghul.UnwrapFailedException[T]` where it is written, whether the default
// variant has one field, which `!` reads, or several, where `!` answers the
// variant itself. The exception holds the other variant's one field, or the
// value itself where that variant has none. Neither unwrapped value is read
// afterwards, so the throw cannot come from using a null.
use IO.Std.write_line

union Result is
    OK(value: int) default;
    ERROR(message: string);
si

union Boxed is
    PAIR(a: int, b: int) default;
    EMPTY;
si

entry() is
    let bad: Result = Result.ERROR("oops")

    try
        let value = bad!
        write_line("one field: no exception")
    catch e: Ghul.UnwrapFailedException[string]
        write_line("one field: threw at the unwrap, holding {e.payload}")
    yrt

    let empty: Boxed = Boxed.EMPTY

    try
        let pair = empty!
        write_line("several fields: no exception")
    catch e: Ghul.UnwrapFailedException[Boxed]
        write_line("several fields: threw at the unwrap, holding {isa Boxed.EMPTY(e.payload)}")
    yrt

    let good: Result = Result.OK(42)
    let full: Boxed = Boxed.PAIR(3, 4)

    write_line(good!.to_string())
    write_line(full!.b.to_string())
si
