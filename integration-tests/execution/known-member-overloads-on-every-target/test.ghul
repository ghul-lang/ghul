use IO.Std.write_line

// A constrained call on a struct reaches the struct's own implementation
// of the trait member, found by its exact parameter types: an overload of
// the same arity declared first is not it.

trait Describes is
    describe(n: int) -> string
si

struct CELL(tag: string public): Describes is
    describe(label: string) -> string => "label {label}"
    describe(n: int) -> string => "{tag} {n}"
si

describe_through[T: Describes](value: T) -> string => value.describe(7)

write_line(describe_through(CELL("cell")))
