use default
use Ghul.Math.AdditionOperators.`+

// An overload whose selector's result is one of its own type parameters
// beside one whose selector returns a concrete type: the selector is typed
// by the parameters they agree on, and what it returns chooses between them.
total_by[T.., N: Number[N]](source: T{}, selector: T.. -> N pure) -> string is
    let total mut = N.zero

    for value in source do
        total = total + selector(value)
    od

    return "number {total}"
si

total_by[T..](source: T{}, selector: T.. -> bool pure) -> string =>
    "count {source |> count(v => selector(v))}"

twice(n: int) -> int pure => n * 2

write_line([(1, 2), (3, 4)] |> total_by((a, b) => a * b))
write_line([(1, 2), (3, 4)] |> total_by((a, b) => a < b))
write_line("ab" |> index() |> total_by((position, letter) => position * int(letter)))
write_line([1, 2] |> total_by(twice))
write_line("12" |> total_by(int))
write_line([1.5, 2.5] |> total_by(x => x * 2.0))
write_line(["a", "bb"] |> total_by(s => s.length > 1))
