use IO.Std.write_line;
use Ghul.Pipes;

reverse(s: string) -> string => s |> reduce("", (acc, c) => "{c}{acc}");
is_palindrome(s: string) -> bool => s =~ reverse(s);

// The pipe combinators' generic formals pin the member: map's
// (T) -> S takes .NET's char.to_lower_invariant by name, with T bound by
// the source and S left for the delegate's own shape to bind.
is_inexact_palindrome(s: string) -> bool =>
    s
        |> filter(c => c.is_letter)
        |> map(char.to_lower_invariant)
        |> reduce("", (acc, c) => "{acc}{c}")
        |> is_palindrome();

entry() is
    write_line(is_inexact_palindrome("A man, a plan, a canal: Panama"));
    write_line(is_inexact_palindrome("not one"));
si
