use IO.Std.write_line
use Ghul.Pipes

let pairs = [(1, 2), (3, 4)]

// the element uses the destructured parameter, so flat_map's U is still
// being inferred when the comprehension is typed
let from_parameter =
    pairs |> flat_map(((a, b)) => [a * k + b for k in [1, -1]]) |> collect()
write_line("{from_parameter |> join()}")

let parameter_only = pairs |> flat_map(((a, b)) => [a for k in [1, 2]]) |> collect()
write_line("{parameter_only |> join()}")

let named = pairs
    |> flat_map(((a, b)) => [(x = a * k, y = b) for k in [1, -1]])
    |> collect()
write_line("{named |> map(p => "{p.x}/{p.y}") |> join()}")
