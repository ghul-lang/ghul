use default

// Each function is only ever passed as a value, never called directly: its
// parameter types come from the slot it is passed into.
letters(text) => text |> count()

check(s: string, f: string -> int) -> int => f(s)

apply(f: int -> int, v: int) -> int => f(v)

write_line("{check("ab", letters)} {apply(twice, 21)}")

twice(n) => n * 2
