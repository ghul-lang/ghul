use IO.Std.write_line

// The time types live in Time: Time.DateTime, Time.TimeSpan and the rest.

days_between(from: Time.DateTime, to: Time.DateTime) -> int => int((to - from).total_days)

let start: Time.DateTime = Time.DateTime(2024, 2, 28)
let later: Time.DateTime = start.add_days(2.0)
let span: Time.TimeSpan = Time.TimeSpan.from_hours(36.0)
let day: Time.DayOfWeek = later.day_of_week
let kind: Time.DateTimeKind = Time.DateTimeKind.UTC
let offset: Time.DateTimeOffset = Time.DateTimeOffset(start, Time.TimeSpan.zero)

write_line("{later.month} {later.day} {days_between(start, later)} {span.total_minutes}")
write_line("{day == Time.DayOfWeek.FRIDAY} {kind == Time.DateTimeKind.UTC}")
write_line("{offset.year} {Time.IsoWeek.get_week_of_year(start)} {Time.IsoWeek.get_year(start)}")

let watch: Time.Stopwatch = Time.Stopwatch.start_new()
write_line("{watch.elapsed_milliseconds >= 0L}")
