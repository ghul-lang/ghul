use IO.Std.write_line

// The time types live in Time: Time.DATE_TIME, Time.TIME_SPAN and the rest.
// Their System names are second spellings of the same types.

days_between(from: Time.DATE_TIME, to: System.DateTime) -> int => int((to - from).total_days)

let start: System.DateTime = Time.DATE_TIME(2024, 2, 28)
let later: Time.DATE_TIME = start.add_days(2.0)
let span: Time.TIME_SPAN = System.TimeSpan.from_hours(36.0)
let same_span: System.TimeSpan = span
let day: Time.DayOfWeek = later.day_of_week
let old_day: System.DayOfWeek = day
let kind: Time.DateTimeKind = System.DateTimeKind.UTC
let offset: Time.DATE_TIME_OFFSET = System.DateTimeOffset(start, System.TimeSpan.zero)

write_line("{later.month} {later.day} {days_between(start, later)} {same_span.total_minutes}")
write_line("{old_day == System.DayOfWeek.FRIDAY} {day == Time.DayOfWeek.FRIDAY} {kind == Time.DateTimeKind.UTC}")
write_line("{offset.year} {Time.ISO_WEEK.get_week_of_year(start)} {System.Globalization.ISOWeek.get_year(start)}")

let watch: Time.STOPWATCH = System.Diagnostics.Stopwatch.start_new()
let also: System.Diagnostics.Stopwatch = watch
write_line("{also.elapsed_milliseconds >= 0L}")
