// A `_` written for a `T ref` parameter discards what the callee writes
// through it, whatever T is: a class, an optional, a scalar or a struct.
use IO.Std.write_line

class BOX(value: int public);

struct PAIR(left: int public, right: int public);

make_box(text: string, result: BOX ref) -> bool is
    result! = BOX(text.length)
    return text.length > 0
si

make_text(text: string, result: string? ref) -> bool is
    result! = text
    return text.length > 1
si

make_count(text: string, result: int ref) -> bool is
    result! = text.length
    return text.length > 2
si

make_pair(text: string, result: PAIR ref) -> bool is
    result! = PAIR(text.length, 0)
    return text.length > 3
si

write_line("{make_box("ab", _)} {make_text("ab", _)} {make_count("ab", _)} {make_pair("ab", _)}")
