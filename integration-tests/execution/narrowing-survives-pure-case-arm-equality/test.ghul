// A `case` value arm and a leaf whose `=~` stores nothing leave a
// narrowing made before the call standing.
use IO.Std.write_line

class HOLDER is
    name: string? public;
    init() is name = "x"; si
si

class LABEL(n: int public);
class TAG(n: int public);

=~(tag: TAG, label: LABEL) -> bool => tag.n == label.n

classify(tag: TAG, label: LABEL) -> int =>
    case tag when label then 1 else 2 esac

leaf(tag: TAG, n: int) -> int =>
    case (tag.n, 0)
    when (~n, _) then 1
    else 2
    esac

entry() is
    let holder = HOLDER();

    if holder.name? then
        let a = classify(TAG(1), LABEL(1));
        let b = leaf(TAG(2), 3);

        write_line("{a} {b} {holder.name.length}");
    fi
si
