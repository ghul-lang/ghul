namespace Test is
    use IO.Std.write_line;
    use Ghul.Functional.`>>;
    use Ghul.Functional.`<<;
    use Ghul.Functional.retry;
    use Ghul.Functional.memo;

    // Tests: the runtime's variadic >> and <<. A stage of any arity
    // composes, a one-argument call binds the pack to the value itself,
    // and a composition operand that is itself a call returning a
    // pack-shaped function is presented once, where the operand stands.

    builds: int;

    tag(a: int, b: int) -> int => a * 10 + b;
    inc(n: int) -> int => n + 1;
    show(n: int) -> string => "{n}";

    mk() -> (int) -> int is
        builds = builds + 1;
        return n => n * 2;
    si

    calls: int;

    counted(a: int, b: int) -> int is
        calls = calls + 1;
        return a + b;
    si

    entry() is
        // an N-ary stage on the left, and on the right of <<
        let both = tag >> show;
        write_line(both(3, 4));

        let back = show << tag;
        write_line(back(3, 4));

        // unary chains read as they always did
        let chain = inc >> inc >> inc >> show;
        write_line(chain(0));

        // a retry call as an operand: hoisted once, presented N-ary
        let guarded = retry(mk(), 2) >> show;
        write_line("{guarded(5)} {guarded(6)} builds={builds}");

        // a two-argument function value fills a pack formal where a
        // named reference would: a retry or memoize call on the left,
        // a stored one included, and a << with the pack call on the right
        let safe = retry(counted, 3) >> show;
        write_line(safe(1, 2));

        calls = 0;
        let fast = memo(counted) >> show;
        write_line("{fast(2, 3)} {fast(2, 3)} calls={calls}");

        let sum mut = counted;
        let composed = sum >> show;
        write_line(composed(3, 4));

        let backed = show << retry(tag, 1);
        write_line(backed(4, 5));
    si
si
