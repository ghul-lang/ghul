use default

// A fused consumer's own function argument - an any, all or find
// predicate, a sum_by selector, an each action - runs inline in the loop
// as a map stage does, reading what its literal would have, in a generic
// function as in any other.
class LIMIT is
    _n: int

    init(n: int) is
        _n = n
    si

    exceeded(xs: List[int]) -> bool => xs |> any(x => x > _n)
si

summary(xs: List[int], k: int) -> string is
    let seen = LIST[int]()

    xs |> map(x => x + k) |> each(x => seen.add(x * 2))

    let some = xs |> any(x => x > k)
    let every = xs |> filter(x => x > 0) |> all(x => x < k * 10)
    let first = xs |> map(x => x * k) |> find(x => x % 3 == 0)
    let total = xs |> sum_by(x => x * k)
    let nested = [xs, xs] |> any(row => row |> any(x => x == k + row.count))

    "{seen |> join(",")} {some} {every} {first} {total} {nested} {LIMIT(2).exceeded(xs)}"
si

already_sorted[T: Ghul.Comparable[T]](values: T[]) -> bool is
    let sorted = LIST(values)

    sorted.sort()

    0..values.count |> all(index => sorted[index] =~ values[index])
si

write_line(summary([1, 2, 3], 2))
write_line("{already_sorted([1, 2, 3])} {already_sorted(["b", "a"])}")
