use IO.Std.write_line

class HOLDER is
    text: string public field

    init() is
    si
si

get(present: bool) -> int? => if present then 7 else null fi

let name = "alice"
let long_name = "a name a good deal longer than sixteen code units"
let n = 42
let big = 9_000_000_000L
let ratio = 2.5
let letter = 'x'
let flag = true

write_line("{"joined"}{" "}{"literals"}")
write_line("{name}")
write_line("{long_name}")
write_line("{name}: {n}")
write_line("{long_name} {long_name} {n}")
write_line("{n} {big} {ratio} {letter} {flag}")
write_line("[{n,6}] [{name,-8}] [{n,1}]")
write_line("{get(true)} {get(false)}")
write_line("{ratio:F2} and {"x"} and {n}")

let found: string? = null
let holder = HOLDER()

// A single hole and nothing else, with and without an alignment or a
// format, and an interpolation of string literals alone.
let only = "{name}"
let absent = "{found}"
let unset = "{holder.text}"
let aligned = "{name,8}"
let formatted = "{n:X}"
let folded = "{"a"}{"b"}"

write_line("[{only}] [{absent}] [{unset}] [{aligned}] [{formatted}] [{folded}]")
