// An operand is widened through a marked widening to reach an operator
// marked to accept it, and only where nothing resolves for the operands as
// written: an operator declared for the exact operand types is chosen
// over any widening.
namespace Test is
    use IO.Std.write_line

    struct AMOUNT(cents: long public) is
        @widen_operands()
        +(other: AMOUNT) -> AMOUNT => AMOUNT(cents + other.cents)

        to_string() -> string => "{cents}c"
    si

    +(a: AMOUNT, b: int) -> string => "exact {a} + {b}"

    entry() is
        let a = AMOUNT(250L)

        write_line(a + 50L)
        write_line(50L + a)
        write_line(a + 7)

        let added = (x: long) => a + x
        write_line(added(5L))
    si
si

namespace Ghul.Internal is
    class WIDENINGS is
        @widening() long_to_amount(value: long) -> Test.AMOUNT static => Test.AMOUNT(value)
    si
si
