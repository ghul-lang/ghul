// A typeof argument in an attribute is carried in the blob as a type
// name string the runtime resolves when the attribute is read back.
// Each case here round-trips one shape of type through that name: the
// oracle is the runtime's own resolution, so a name the reader cannot
// parse fails the test rather than passing unread.

class TYPED: System.Attribute is
    the_type: System.Type public;

    init(the_type: System.Type) is
        self.the_type = the_type;
    si
si

class PLAIN is
    init() is si
si

enum Suit is
    HEARTS,
    DIAMONDS,
si

class BOX[T] is
    init() is si
si

@TYPED(typeof PLAIN)
class CASE_DECLARED_CLASS is
    init() is si
si

@TYPED(typeof Suit)
class CASE_DECLARED_ENUM is
    init() is si
si

@TYPED(typeof int)
class CASE_PRIMITIVE is
    init() is si
si

@TYPED(typeof string)
class CASE_STRING is
    init() is si
si

@TYPED(typeof System.Environment_SpecialFolder)
class CASE_IMPORTED_NESTED is
    init() is si
si

@TYPED(typeof Collections.LIST[int])
class CASE_IMPORTED_GENERIC is
    init() is si
si

@TYPED(typeof BOX[PLAIN])
class CASE_DECLARED_GENERIC is
    init() is si
si

@TYPED(typeof Collections.LIST[Collections.LIST[int]])
class CASE_NESTED_GENERIC is
    init() is si
si

@TYPED(typeof ARRAY[PLAIN])
class CASE_CLASS_ARRAY is
    init() is si
si

@TYPED(typeof ARRAY[int])
class CASE_PRIMITIVE_ARRAY is
    init() is si
si

@TYPED(typeof Collections.MAP[string,Collections.LIST[int]])
class CASE_TWO_ARGUMENT_GENERIC is
    init() is si
si

show(name: string, instance: object) is
    for a in instance.get_type().get_custom_attributes(false) do
        if let typed: TYPED = a then
            IO.Std.write_line("{name}: {typed.the_type}");
        fi
    od
si

show("declared class", CASE_DECLARED_CLASS());
show("declared enum", CASE_DECLARED_ENUM());
show("primitive", CASE_PRIMITIVE());
show("string", CASE_STRING());
show("imported nested", CASE_IMPORTED_NESTED());
show("imported generic", CASE_IMPORTED_GENERIC());
show("declared generic", CASE_DECLARED_GENERIC());
show("nested generic", CASE_NESTED_GENERIC());
show("class array", CASE_CLASS_ARRAY());
show("primitive array", CASE_PRIMITIVE_ARRAY());
show("two argument generic", CASE_TWO_ARGUMENT_GENERIC());
