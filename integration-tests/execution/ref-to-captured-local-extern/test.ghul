// An extern's `ref` argument naming a mutable local that a closure
// captures: the foreign function's write reaches the closure.
namespace Test is
    use IO.Std.write_line;

    @extern("libc", "strtol")
    parse(text: string, end: word ref, base: int) -> long;

    entry() is
        let captured mut = 0w;
        let read = () => captured;
        let hex = parse("ff", captured ref, 16);
        write_line("captured: {hex}, written: {read() != 0w}");
    si
si
