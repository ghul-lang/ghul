use IO.Std.write_line
use Ghul.Pipes
use Collections

class ENTRY(key: string, weight: int);

let entries = [ENTRY("a", 1), ENTRY("b", 2), ENTRY("c", 3)]

let from_pipe = MAP(entries |> map(e => (e.key, e.weight)))
write_line("from pipe: {from_pipe["b"]} of {from_pipe.count}")

let from_array = MAP([(1, "one"), (2, "two")])
write_line("from array: {from_array[2]}")

let from_list = MAP(LIST([("x", true), ("y", false)]))
write_line("from list: {from_list["x"]} {from_list["y"]}")

let keyed_by_value = MAP(entries |> map(e => (e.weight, e)))
write_line("value is the element: {keyed_by_value[3].key}")

let list = LIST(entries |> map(e => e.weight))
list.add(4)
write_line("list: {list}")

let set = SET([1, 2, 2, 3] |> map(n => n * 10))
write_line("set: {set.count}")

let array = ARRAY(entries |> map(e => e.weight))
write_line("array: {array} length {array.count}")

let threaded = entries |> map(e => e.key) |> ARRAY()
write_line("threaded: {threaded}")

let from_count = ARRAY([7, 8, 9])
write_line("sized: {from_count}")

let expected: int[] = _(entries |> map(e => e.weight * 2))
write_line("from expected type: {expected}")

try
    let _ = MAP([("k", 1), ("k", 2)])
    write_line("no throw")
catch e: System.ArgumentException
    write_line("repeated key throws")
yrt

let seen: SET[string] = _(threaded)
write_line("set from expected type: {seen.contains("b")}")
