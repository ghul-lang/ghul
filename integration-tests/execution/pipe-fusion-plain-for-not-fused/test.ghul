// A `for` needs a stage to fuse. Its expression is whatever the loop
// iterates, so a chain of no stages there would take every `for` in
// every program through the fused loop rather than the ordinary one.
// Consumer fusion accepts a stage-free chain; a `for` does not.
use default
use Ghul.Pipes

counting(limit: int) -> int{} is
    let i mut = 0

    while i < limit do
        yield i

        i = i + 1
    od
si

entry() is
    let xs = [3, 1, 2]

    // None of these is a chain: no pipe call anywhere in the expression.
    for x in xs do
        write_line("array {x}")
    od

    for i in 0..3 do
        write_line("range {i}")
    od

    for n in counting(2) do
        write_line("generator {n}")
    od

    let list = xs |> collect_mutable()

    for x in list do
        write_line("list {x}")
    od

    // One stage is enough, and this one does fuse.
    for x in xs |> map(x => x * 2) do
        write_line("mapped {x}")
    od
si
