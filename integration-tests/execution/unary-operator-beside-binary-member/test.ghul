use IO.Std.write_line

// A prefix - inside a type that also declares a binary - member is the
// unary operator, whether that is a static member of the type or a
// global, and never the binary member with self as its left operand.

struct STATIC_UNARY(v: int public) is
    -(other: STATIC_UNARY) -> STATIC_UNARY => STATIC_UNARY(v - other.v)
    +(other: STATIC_UNARY) -> STATIC_UNARY => STATIC_UNARY(v + other.v)
    -(a: STATIC_UNARY) -> STATIC_UNARY static => STATIC_UNARY(-a.v)

    negated(other: STATIC_UNARY) -> STATIC_UNARY => -other
    subtracted(other: STATIC_UNARY) -> STATIC_UNARY => self + -other
si

struct GLOBAL_UNARY(v: int public) is
    -(other: GLOBAL_UNARY) -> GLOBAL_UNARY => GLOBAL_UNARY(v - other.v)
    +(other: GLOBAL_UNARY) -> GLOBAL_UNARY => GLOBAL_UNARY(v + other.v)

    negated(other: GLOBAL_UNARY) -> GLOBAL_UNARY => -other
    subtracted(other: GLOBAL_UNARY) -> GLOBAL_UNARY => self + -other
si

-(a: GLOBAL_UNARY) -> GLOBAL_UNARY => GLOBAL_UNARY(-a.v)

let s = STATIC_UNARY(1)

write_line("static: {(-STATIC_UNARY(5)).v} {s.negated(STATIC_UNARY(5)).v} {s.subtracted(STATIC_UNARY(5)).v} {(STATIC_UNARY(9) - STATIC_UNARY(4)).v}")

let g = GLOBAL_UNARY(1)

write_line("global: {(-GLOBAL_UNARY(5)).v} {g.negated(GLOBAL_UNARY(5)).v} {g.subtracted(GLOBAL_UNARY(5)).v} {(GLOBAL_UNARY(9) - GLOBAL_UNARY(4)).v}")
