use IO.Std.write_line
use Ghul.Pipes

squares_of(xs: int[]) -> Pipe[int] => {x * x for x in xs}

squares_eager(xs: int[]) -> int[] => [x * x for x in xs]

total(xs: Collections.Iterable[int]) -> int => xs |> sum()

class SHELF(items: string[]) is
    labelled(prefix: string) -> Pipe[string] => {"{prefix}{item}" for item in items}
si

pick_evens[T](xs: T[], index_of: T -> int) -> Pipe[T] => {x for x in xs if index_of(x) % 2 == 0}

// a variable
let lazy = {x + 1 for x in [1, 2, 3]}
let eager = [x + 1 for x in [1, 2, 3]]
write_line("let: {lazy} {eager}")

// an argument
write_line("argument: {total({x for x in 1::4})} {total([x for x in 1::4])}")

// a return
write_line("return: {squares_of([2, 3])} {squares_eager([2, 3])}")

// the subject of |>
write_line("subject: { {x for x in 1::10 if x % 3 == 0} |> map(x => x * 10) } { [x for x in 1::10 if x % 3 == 0] |> map(x => x * 10) }")

// nested clauses
write_line("nested: { {(a, b) for a in 1::3 for b in a::3 if a != b} }")

// in a method, and in a generic function
write_line("method: {SHELF(["a", "b"]).labelled("> ")}")
write_line("generic: {pick_evens([10, 11, 12, 13], x => x)}")
