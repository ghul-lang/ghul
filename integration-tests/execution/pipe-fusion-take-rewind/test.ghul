namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A spent `take` rewinds the cursor it drove exactly as the stage
    // pipe it replaces does, and the question is asked of the cursor at
    // run time rather than of its declared type: a `Pipe` is reset in
    // place wherever it reached the loop from, and a source that is its
    // own iterator without being a pipe is left where it stopped for
    // whoever reads it next.

    class COUNTING: Iterable[int], Iterator[int] is
        _n: int;
        _limit: int;
        iterator: Iterator[int] => self;
        current: int => _n;
        init(limit: int) is _n = -1; _limit = limit; si
        move_next() -> bool is _n = _n + 1; return _n < _limit; si
        reset() is _n = -1; si
        dispose() is si
    si

    class Main is
        counting(limit: int) -> Pipe[int] static is
            let i mut = 0;
            while i < limit do
                yield i;
                i = i + 1;
            od
        si

        remaining(source: Iterator[int], want: int) -> string static is
            let rest = LIST[int]();
            let n mut = 0;
            while n < want /\ source.move_next() do
                rest.add(source.current);
                n = n + 1;
            od
            return rest |> join(",");
        si

        entry() static is
            // Its own iterator, but not a pipe: left where the take
            // stopped.
            let a = COUNTING(10);
            for x in a |> take(3) do od
            Std.write_line("plain source: {remaining(a, 3)}");

            let b = COUNTING(10);
            let _ = b |> take(3) |> collect_mutable();
            Std.write_line("plain consumer: {remaining(b, 3)}");

            // A pipe: reset in place, so the next read starts over.
            let c = counting(10);
            for x in c |> take(3) do od
            Std.write_line("pipe source: {remaining(c, 3)}");

            // A pipe reaching the loop as an Iterable - the declared
            // type says nothing, so the cursor is asked directly.
            let d: Iterable[int] = counting(10);
            let _ = d |> take(3) |> collect_mutable();
            Std.write_line("pipe as iterable: {remaining(d.iterator, 3)}");
        si
    si
si
