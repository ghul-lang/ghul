use default

_second(xs) => xs[1]
_last(xs) => xs[xs.count - 1]

let arrays = [[1, 4], [2, 3]]
let lists = LIST([LIST([5, 6]), LIST([7, 8])])

write_line(arrays |> filter(xs => _second(xs) > 3) |> map(xs => xs |> join()) |> join(" "))
write_line(lists |> filter(xs => _last(xs) > 6) |> map(xs => xs |> join()) |> join(" "))
