namespace Formatting is
    use IO.Std

    decide(first: bool, second: bool, third: bool, fourth: bool) -> bool =>
        first /\ second /\ third /\ fourth

    entry() is
        Std.write_line("all: {decide(true, true, true, true)}")
        Std.write_line("some: {decide(true, false, true, true)}")
    si
si
