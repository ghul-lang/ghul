// A string made from a range of an array of code units, in one copy.
use IO.Std.write_line

@intrinsic("string.from_chars")
from_chars(chars: char[], start: int, count: int) -> string => "not lowered"

entry() is
    let chars = ['g', 'h', 'u', 'l', '!']

    write_line(from_chars(chars, 0, 5))
    write_line(from_chars(chars, 1, 3))
    write_line("[{from_chars(chars, 2, 0)}]")

    let long = 0..100_000 |> Ghul.Pipes.map(i => cast char(65 + i % 26)) |> ARRAY()

    let text = from_chars(long, 26, 99_000)

    write_line("{text.length} {text[0]} {text[98_999]}")
si
