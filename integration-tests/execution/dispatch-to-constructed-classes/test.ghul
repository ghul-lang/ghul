// A class's dispatched methods are compiled for a whole program only where
// something constructs it, or a class that extends it. Each value below is
// constructed in a different way, and each call reaches its method through a
// trait or a vtable: inherited from a class never constructed itself, from
// inside a function literal, from a generator, as a thrown exception, and as
// a field's value. SILENT implements the trait too but is never constructed.
use IO.Std.write_line

trait Speaks is
    speak() -> string
si

class BASE: Speaks is
    init() is si
    speak() -> string => "inherited"
    name() -> string => "base"
si

class DERIVED: BASE is
    init() is super.init() si
    name() -> string => "derived"
si

class IN_LITERAL: Speaks is
    init() is si
    speak() -> string => "from a literal"
si

class IN_GENERATOR: Speaks is
    init() is si
    speak() -> string => "from a generator"
si

class Raised: Ghul.Exception is
    init() is super.init("raised") si
si

class HELD: Speaks is
    init() is si
    speak() -> string => "held in a field"
si

class HOLDER is
    held: Speaks public
    init() is held = HELD() si
si

class SILENT: Speaks is
    init() is si
    speak() -> string => "never constructed"
si

say(s: Speaks) => write_line(s.speak())

make() -> Speaks{} is
    yield IN_GENERATOR()
si

entry() is
    let d: BASE = DERIVED()
    say(d)
    write_line(d.name())

    let build = () -> Speaks => IN_LITERAL()
    say(build())

    for s in make() do
        say(s)
    od

    try
        throw Raised()
    catch e: Ghul.Exception
        write_line(e.message)
    yrt

    say(HOLDER().held)
si
