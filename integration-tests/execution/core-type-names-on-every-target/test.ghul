use IO.Std.write_line

// Ghul.Type and the exceptions the core library declares in Ghul resolve
// under their ghūl names and their old .NET names on every target, and the
// two names are one type.

describe(e: Ghul.Exception) -> string =>
    if isa Ghul.ObjectDisposedException(e) then "object disposed"
    elif isa Ghul.UnauthorizedAccessException(e) then "unauthorized access: {e.message}"
    elif isa Ghul.AggregateException(e) then "aggregate"
    else "other: {e.message}"
    fi

attempt(operation: () -> void) is
    try
        operation()
    catch e: Ghul.Exception
        write_line(describe(e))
    yrt
si

attempt(() is throw Ghul.ObjectDisposedException("new name") si)
attempt(() is throw System.ObjectDisposedException("old name") si)
attempt(() is throw Ghul.UnauthorizedAccessException("new name") si)
attempt(() is throw System.UnauthorizedAccessException("old name") si)
attempt(() is throw Ghul.Exception("plain") si)

let disposed: System.ObjectDisposedException = Ghul.ObjectDisposedException("x")
let refused: Ghul.UnauthorizedAccessException = System.UnauthorizedAccessException("y")
let no_aggregate: Ghul.AggregateException? = null
let no_old_aggregate: System.AggregateException? = no_aggregate

write_line("{isa Ghul.InvalidOperationException(disposed)} {refused.message} {no_old_aggregate?}")
write_line("aggregate is an exception: {isa Ghul.Exception(no_old_aggregate)}")

let new_name: Ghul.Type = typeof int
let old_name: System.Type = new_name

write_line("one type object: {new_name == old_name}")
