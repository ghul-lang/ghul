use IO.Std.write_line;

entry() is
    write_line("{early(1)}");

    early(x: int) -> int => x;

    // A nested function referred to before its statement exists from the
    // start of the body, so a call above it and mutual recursion both work.
    is_even(n: int) -> bool => if n == 0 then true else is_odd(n - 1) fi;

    is_odd(n: int) -> bool => if n == 0 then false else is_even(n - 1) fi;

    write_line("{is_even(4)}");
si
