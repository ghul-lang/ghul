use default

// Each of these has a type the body settles as it is walked: a function
// literal's return, a comprehension's element, and the result of a call
// through a parameter whose type is inferred only from being called.
let double = (x: int) => x * 2
let describe = (x: int) is
    if x > 1 then
        return "big"
    fi

    "small"
si

let squares = [n * n for n in 1::4]
let lazy_squares = {n * n for n in 1::4}

let call_with_three = h => h(3)

write_line("literals {double(4)} {describe(1)} {describe(5)}")
write_line("comprehensions {squares} {lazy_squares |> join(",")}")
write_line("unresolved callee {call_with_three((n: int) => n + 1)}")
