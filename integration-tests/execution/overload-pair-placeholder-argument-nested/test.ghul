use default

// The argument to `total` is a call that itself waits: `parts` cannot be chosen
// until `value` is typed, and `total` waits for it rather than choosing.

struct Money(cents: int public) is
    to_string() -> string => "{cents}";
si

parts(value: int) -> int{} => [value, value]
parts(value: long) -> long{} => [value, value]

total(source: Money{}) -> Money => Money(0)
total[T](source: T{}) -> T => source |> first()!

part_total(value) => value |> parts() |> total()

root(value: long) -> long =>
    if value > 100L then value else root(part_total(value) * 3L) fi

write_line("{root(12L)}")
