use IO.Std.write_line
use Collections

// A trait whose default walks the implementor, reached only through a call
// on the trait, from a class that does not declare its own.
trait Holding[T] is
    items: Iterable[T];

    holds(item: T) -> bool is
        for element in items do
            if element =~ item then
                return true
            fi
        od

        return false
    si
si

class Shelf: Holding[int] is
    _items: LIST[int]

    init() is
        _items = LIST[int]()
    si

    put(item: int) => _items.add(item)

    items: Iterable[int] => _items
si

entry() is
    let shelf = Shelf()
    shelf.put(7)

    let holding: Holding[int] = shelf

    write_line("holds 7 {holding.holds(7)}, holds 9 {holding.holds(9)}")
si
