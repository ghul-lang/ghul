use IO.Std.write_line

// `==` and `!=` on two bigints compare their values, as `=~` and `!~` do,
// even where the two are separate values computed apart.
factorial(n: int) -> bigint is
    let result mut = 1n

    for i in 2::n do
        result = result * bigint(i)
    od

    return result
si

let a = factorial(25)
let b = factorial(25)
let c = factorial(24) * 25n
let d = factorial(26)

write_line("{a == b} {a == c} {a == d}")
write_line("{a != b} {a != c} {a != d}")
write_line("{1n == 1n} {0n == -0n} {-1n == 1n}")
write_line("{(a == c) == (a =~ c)} {(a != d) == (a !~ d)}")

let pick = (x: bigint, y: bigint) => if x == y then "same" else "different" fi
write_line("{pick(a, c)} {pick(a, d)}")

let twos = [1n, 2n, 3n, 2n] |> Ghul.Pipes.filter(* == 2n) |> Ghul.Pipes.count()
write_line("{twos}")
