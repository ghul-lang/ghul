use IO.Std.write_line

run() -> int is
    let start = [1, 2]

    extend(parts: int[], i: int) -> int[] =>
        let doubled = i * 2 in
        [p + doubled for p in parts]

    let parts = [1, 2, 3] |> Ghul.Pipes.reduce(start, extend)

    count(xs: int[]) => xs.count
    let xs = count(parts)

    xs
si

write_line("{run()}")
