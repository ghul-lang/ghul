// A pipe chain no consumption site reads - bound to a local, returned, passed
// to a function fusion has no lowering for - runs fused in a generated
// generator, read as often as the chain would be.
use default

doubled_evens(xs: List[int]) -> int{} => xs |> map(x => x * 2) |> filter(x => x % 4 == 0)

let xs = [1, 2, 3, 4, 5, 6]
let squares = xs |> map(x => x * x) |> filter(x => x > 4)

write_line(squares |> join(","))
write_line(squares |> join(","))
write_line(doubled_evens(xs) |> join(","))
write_line(xs |> map(x => x + 1) |> chunk(2) |> map(c => c |> join("+")) |> join(" "))

let words = ["a", "bb", "ccc"] |> map(w => w.length)
for n in words do write_line("{n}") od
