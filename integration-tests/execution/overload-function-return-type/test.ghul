// Overloads that differ only in what a function parameter returns: the
// function literal's result picks the overload, however many there are.
use IO.Std.write_line

total[T](source: Collections.Iterable[T], selector: T -> int pure) -> int is
    let r mut = 0
    for x in source do r = r + selector(x) od
    return r
si

total[T](source: Collections.Iterable[T], selector: T -> double pure) -> double is
    let r mut = 0.0
    for x in source do r = r + selector(x) od
    return r
si

total[T](source: Collections.Iterable[T], selector: T -> long pure) -> long is
    let r mut = 0L
    for x in source do r = r + selector(x) od
    return r
si

describe(value: int) -> string => "int {value}"
describe(value: double) -> string => "double {value}"
describe(value: long) -> string => "long {value}"

entry() is
    let xs = [1, 2, 3]

    write_line(describe(total(xs, i => i * 2)))
    write_line(describe(total(xs, i => cast double(i) / 2.0)))
    write_line(describe(total(xs, i => cast long(i) * 1_000_000_000L)))
si
