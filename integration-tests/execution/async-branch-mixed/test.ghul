namespace Test is
    use Std = IO.Std;

    class Main is
        get_value(use_async: bool) -> Concurrency.Future[int] static =>
            if use_async then
                Tasks.TaskExtensions.unwrap(
                    Concurrency.Future.from_result(42).continue_with(
                        (t: Concurrency.Future[int]) -> Concurrency.Future[int] =>
                            Concurrency.Future.from_result(t.result + 1000)
                    )
                )
            else
                Concurrency.Future.from_result(-1)
            fi;

        entry() static is
            let async_path = get_value(true);
            let sync_path = get_value(false);

            Std.write_line("async_path.result={async_path.result}");
            Std.write_line("sync_path.result={sync_path.result}");
        si
    si
si
