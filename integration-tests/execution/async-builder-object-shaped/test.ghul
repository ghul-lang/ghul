use IO.Std.write_line
use System.Runtime.CompilerServices.IAsyncStateMachine

@System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(LOOSE_BUILDER))
class LOOSE is
    completed: bool public
    init() is si
si

// A builder that takes its state machine and awaiter as object rather than
// as type parameters of their own still drives an async function.
class LOOSE_BUILDER is
    _task: LOOSE
    init() is _task = LOOSE(); si
    create() -> LOOSE_BUILDER static => LOOSE_BUILDER()
    task: LOOSE => _task
    start(state_machine: object ref) is
        if let machine: IAsyncStateMachine = state_machine then
            machine.move_next()
        fi
    si
    set_state_machine(state_machine: IAsyncStateMachine) is si
    set_result() is _task.completed = true; si
    set_exception(e: System.Exception) is write_line("exception {e.message}"); si
    await_on_completed(awaiter: object ref, state_machine: object) is si
    await_unsafe_on_completed(awaiter: object ref, state_machine: object) is si
si

run() -> LOOSE is
    write_line("inside")
si

let t = run()
write_line("completed {t.completed}")
