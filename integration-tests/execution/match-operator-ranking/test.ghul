use IO.Std.write_line

class Animal(name: string public);

class Dog(name: string): Animal is
    super(name)
si

struct Tag(n: int public);

// an exact =~ beats a ~ that applies only by widening
=~(a: Animal, b: Dog) -> bool => a.name =~ b.name
~(a: Animal, b: Animal) -> bool => throw Ghul.Exception("~ chosen over an exact =~")

// a ~ that ties exactly with =~ wins
=~(a: Tag, b: Tag) -> bool => throw Ghul.Exception("=~ chosen over a ~ in a tie")
~(a: Tag, b: Tag) -> bool => a.n == b.n

// a ~ applies where no equality exists
class Opaque(n: int public);

~(a: Opaque, b: int) -> bool => a.n == b

// a loose ~ beats the structural tuple equality
~(a: object, b: (int, int)) -> bool => true

exact_equality_wins(a: Animal) -> string =>
    case a
    when Dog("rex") then "rex"
    else "other"
    esac

match_wins_a_tie(t: Tag) -> string =>
    case t
    when Tag(1) then "one"
    else "other"
    esac

match_without_equality(o: Opaque) -> string =>
    case o
    when 7 then "seven"
    else "other"
    esac

match_beats_structural(p: (int, int), nine: (int, int)) -> string =>
    case p
    when nine then "matched by ~"
    else "other"
    esac

entry() is
    write_line(exact_equality_wins(Animal("rex")))
    write_line(exact_equality_wins(Animal("fido")))
    write_line(match_wins_a_tie(Tag(1)))
    write_line(match_wins_a_tie(Tag(2)))
    write_line(match_without_equality(Opaque(7)))
    write_line(match_without_equality(Opaque(8)))
    write_line(match_beats_structural((1, 2), (9, 9)))
si
