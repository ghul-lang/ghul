// Ghul.Interop.pin's intrinsic: the address of an array's first element as a
// word, which C can read and write through. The intrinsics are declared here as
// the runtime declares them.

use default

@intrinsic("interop.elements")
elements[T](array: ARRAY[T]) -> word

@intrinsic("interop.read")
read[T](address: word, offset: int) -> T

@intrinsic("interop.write")
write[T](address: word, offset: int, value: T)

@extern("c", "memset")
memset(address: word, value: int, count: word) -> word

let ints = [10, 20, 30] |> ARRAY()
let p = elements(ints)
write[int](p, 4, 25)
write_line("{ints |> join(",")} {read[int](p, 8)}")

let bytes = repeat(0`ub, 4) |> ARRAY()
memset(elements(bytes), 7, 4w)
write_line("{bytes |> join(",")}")

let doubles = [1.5, 2.5] |> ARRAY()
write_line("{read[double](elements(doubles), 8)}")

// An empty array still has somewhere its elements would start.
let empty = repeat(0, 0) |> ARRAY()
write_line("{elements(empty) != 0w}")

// Called from a generic body, with the type settled by the caller.
first_address[T](array: ARRAY[T]) -> word => elements(array)

write_line("{read[int](first_address(ints), 0)}")
