use IO.Std.write_line
use Ghul.Pipes
use Collections

countdown(n: int) -> Pipe[int] is
    let i mut = n

    while i > 0 do
        yield i
        i = i - 1
    od
si

// A body that writes its own argument: a fresh read still starts from
// the argument the generator was called with.
halving(n: int mut) -> int{} is
    while n > 0 do
        yield n
        n = n / 2
    od
si

upto(n: int) -> Iterator[int] is
    for i in 0..n do
        yield i
    od
si

class BOX[T](value: T) is
    repeated(times: int) -> Iterable[T] is
        for i in 0..times do
            yield value
        od
    si
si

let c = countdown(3)

for n in c do
    write_line("partial: {n}")
    break
od

for n in c do
    write_line("full: {n}")
od

write_line("again: {c |> join(" ")}")

let left = c.iterator
let right = c.iterator
left.move_next()
left.move_next()
right.move_next()
write_line("two reads at once: {left.current} {right.current}")

let h = halving(20)
write_line("halving: {h |> join(" ")}")
write_line("halving again: {h |> join(" ")}")

let fused = countdown(5)

for n in fused |> filter(x => x % 2 == 1) |> map(x => x * 10) do
    write_line("fused: {n}")
od

for n in fused |> take(2) do
    write_line("fused take: {n}")
od

for n in fused |> take(2) do
    write_line("fused take again: {n}")
od

write_line("count: {fused |> filter(x => x > 1) |> count()}")

let box = BOX("x")
let xs = box.repeated(2)
write_line("generic: {xs |> join(" ")} {xs |> join(" ")}")

let u = upto(3)

while u.move_next() do
    write_line("upto: {u.current}")
od

write_line("iterator after its end: {u.move_next()}")

let lazy = {x * x for x in [1, 2, 3]}
write_line("comprehension: {lazy |> join(" ")} {lazy |> join(" ")}")
