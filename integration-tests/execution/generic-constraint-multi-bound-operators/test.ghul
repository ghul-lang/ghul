// Two operator interfaces joined with `/\`: the function adds and
// subtracts through separate bounds instead of demanding the whole
// numeric tower.

namespace Test is
    use IO.Std;

    use Ghul.Math.AdditionOperators;
    use Ghul.Math.AdditionOperators.`+;
    use Ghul.Math.SubtractionOperators;
    use Ghul.Math.SubtractionOperators.`-;

    around[T: AdditionOperators[T, T, T] /\ SubtractionOperators[T, T, T]](a: T, b: T) -> T => (a + b) - b;

    class Main is
        entry() static is
            Std.write_line("{around(3, 4)}");
        si
    si
si
