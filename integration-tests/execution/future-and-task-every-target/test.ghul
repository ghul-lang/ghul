use default

double_it(n: int) -> Concurrency.Future[int] is
    await Concurrency.Future.yield()
    return n * 2
si

old_style(n: int) -> Concurrency.Future[int] => double_it(n)

unit_work() -> Concurrency.Future is
    await Concurrency.Future.delay(1)
si

old_unit() -> Concurrency.Future => unit_work()

use Concurrency.Future

imported() -> Future[int] is
    await unit_work()
    return 5
si

let mixed: Concurrency.Future[int] = double_it(1)
let back: Concurrency.Future[int] = old_style(2)

write_line("{double_it(21).result} {old_style(4).result} {back.result} {mixed.result} {imported().result}")
old_unit().wait()
write_line("done")
