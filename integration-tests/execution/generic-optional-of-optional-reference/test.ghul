use IO.Std.write_line
use Collections.Iterator

// A generic's T? instantiated at a T that is itself optional carries two
// layers: the presence of the value, and the value, which can be null.

next[T](iter: Iterator[T]) -> T? =>
    if iter.move_next() then iter.current else null fi

entry() is
    let words: string?[] = ["a", null, "c"]

    let it = words.iterator

    while let w = it |> next() do
        write_line("while let: {w ?? "<null element>"}")
    od

    let it2 = words.iterator
    let first = it2 |> next()
    let second = it2 |> next()
    let _ = it2 |> next()
    let past_end = it2 |> next()

    if let w = second then
        write_line("if let: {w ?? "<null element>"} {w?.length ?? -1}")
    fi

    if let w = past_end then
        write_line("if let past the end: {w}")
    else
        write_line("if let past the end: absent")
    fi

    write_line("coalesce: {first ?? "<absent>"} {second ?? "<absent>"} {past_end ?? "<absent>"}")

    case second
    when null then write_line("case: absent")
    else write_line("case: present")
    esac

    write_line("chain: {(first!)?.length} {(second!)?.length}")

    // second! has shown second present, so second now reads as the string? it holds.
    write_line("after unwrap: {second ?? "<null element>"}")

    let no_name: string? = null
    let pair: (string?, int)? = (no_name, 1)

    if let (name, count) = pair then
        write_line("destructure: {name ?? "<null name>"} {count}")
    fi
si
