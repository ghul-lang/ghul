namespace Test is
    use IO.Std;
    use Ghul.Pipes;

    class Main is
        id[T](x: T) -> T static => x;

        apply_it[A](f: () -> A) -> A static => f();

        // A generic call in a closure that also holds a nested lambda:
        // the type arguments must reach the frame class's own type
        // parameters, not the enclosing function's method-level ones.
        through_nested[A](x: A, xs: A[]) -> A static =>
            apply_it[A](
                () => (
                    let first = id(x);
                    let mapped = xs |> map(y => id(y)) |> collect();

                    id(mapped[0])
                ));

        entry() static is
            Std.write_line(through_nested[int](1, [7, 8]));
            Std.write_line(through_nested[string]("a", ["b", "c"]));
        si
    si
si
