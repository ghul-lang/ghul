use IO.Std.write_line

// Reading an array outside its bounds throws IndexOutOfRangeException, which a
// program can catch, rather than ending it.

read(values: ARRAY[int], index: int) -> int => values[index]

attempt(name: string, operation: () -> void) is
    try
        operation()
        write_line("{name}: no exception")
    catch e: Ghul.IndexOutOfRangeException
        write_line("{name}: caught")
    yrt
si

let values = [10, 20, 30]

attempt("read past the end", () is read(values, 3) si)
attempt("read before the start", () is read(values, -1) si)
attempt("read in range", () is write_line("{read(values, 2)}") si)
