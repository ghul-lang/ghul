use IO.Std.write_line

// Top-level statements that await run as an asynchronous entry, which the
// program runs to completion: each await resumes in order, in a loop and
// on a task started before it.
doubled(n: int) -> Concurrency.Future[int] is
    await Concurrency.Future.yield()

    return n * 2
si

noted(text: string) -> Concurrency.Future is
    await Concurrency.Future.yield()

    write_line(text)
si

write_line("start")

let first = await doubled(21)

write_line("first {first}")

for i in 1::3 do
    write_line("loop {await doubled(i)}")
od

let started = doubled(50)

await noted("between")

write_line("started earlier {await started}")
write_line("end")
