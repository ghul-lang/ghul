use IO.Std.write_line
use Ghul.Pipes

trait Addable[T: Addable[T]] is
    plus(other: T) -> T;
si

struct Money(cents: int public): Addable[Money] is
    plus(other: Money) -> Money => Money(cents + other.cents);
si

class Length(metres: int public): Addable[Length] is
    plus(other: Length) -> Length => Length(metres + other.metres);
si

// a literal that captures nothing is a method of its own; it must carry
// T's bound, or the runtime rejects Addable[T] inside it
total[T: Addable[T]](source: T{}) -> T => source |> reduce((a, b) => a.plus(b))!

// a capturing literal lives in a frame class, which must carry it too
total_from[T: Addable[T]](source: T{}, seed: T) -> T => source |> reduce(seed, (a, b) => a.plus(b))

write_line("{total([Money(1), Money(2), Money(3)]).cents}");
write_line("{total([Length(4), Length(5)]).metres}");
write_line("{total_from([Money(1), Money(2)], Money(10)).cents}");
