use IO.Std.write_line
use Ghul.Pipes

union Tree is
    NODE(left: Tree, value: int, right: Tree)
    LEAF
si

use Tree.NODE
use Tree.LEAF

in_order(tree: Tree) -> Pipe[int] is
    walk(t: Tree) -> Pipe[int] is
        if let (left, value, right): NODE = t then
            yield in walk(left)
            yield value
            yield in walk(right)
        fi
    si

    return walk(tree)
si

pre_order(tree: Tree) -> Pipe[int] is
    let walk = (t: Tree) -> Pipe[int] rec is
        if let (left, value, right): NODE = t then
            yield value
            yield in rec(left)
            yield in rec(right)
        fi
    si

    return walk(tree)
si

let tree = NODE(NODE(LEAF, 1, LEAF), 2, NODE(LEAF, 3, NODE(LEAF, 4, LEAF)))

write_line("in order: {in_order(tree)}")
write_line("pre order: {pre_order(tree)}")
