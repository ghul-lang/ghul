use default

// A generator, and a pipe the compiler fuses into one, passed straight to
// write_line is written by its to_string, which renders its elements as any
// other pipe's does.
counting() -> int{} is
    yield 1
    yield 2
si

entry() is
    let evens = [1, 2, 3, 4] |> filter(x => x % 2 == 0)

    write_line(evens)
    write_line([1, 2] |> map(x => x * 10))
    write_line(from(1) |> take(3))
    write_line(counting())

    let held: object = [3, 4] |> map(x => x + 1)

    write_line(held.to_string())
    write_line("{evens}")
si
