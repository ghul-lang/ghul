// `use default` imports `Ghul.Numerics` along with the rest of the set.
// The namespace is declared here, so the test doesn't depend on which
// runtime defines it.
namespace Ghul.Numerics is
    is_lucky(n: int) -> bool => n == 7
si

namespace Test is
    use default

    entry() is
        write_line("{is_lucky(7)} {is_lucky(8)}")
    si
si
