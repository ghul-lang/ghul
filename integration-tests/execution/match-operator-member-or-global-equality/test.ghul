use IO.Std.write_line

// A pattern value is compared with the =~ that `subject =~ value` would
// call. Here that is the global, which fits a Dog label exactly, not
// the member, which takes any Animal.
class Animal(name: string public) is
    =~(other: Animal) -> bool pure => throw Ghul.Exception("member =~ chosen")
    get_hash_code() -> int => name.get_hash_code()
si

class Dog(name: string): Animal is
    super(name)
si

=~(a: Animal, b: Dog) -> bool pure => a.name =~ b.name

describe(a: Animal) -> string =>
    case a
    when Dog("rex") then "rex"
    else "other"
    esac

leaf(p: (Animal, int)) -> string =>
    case p
    when (~Dog("rex"), n) then "rex {n}"
    else "other"
    esac

entry() is
    let written = Animal("rex") =~ Dog("rex")

    write_line("{written}")
    write_line(describe(Animal("rex")))
    write_line(describe(Animal("fido")))
    write_line(leaf((Animal("rex"), 1)))
si
