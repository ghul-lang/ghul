use default

// A loop over a sequence started again in the same function, inside another
// loop: after a pass over a list, a pass over a sequence of another kind
// iterates that sequence, not the list walked last time.

let sources = LIST[int{}]()
sources.add(LIST[int]([1, 2]))
sources.add([3] ++ [4])
sources.add(LIST[int]([5]))
sources.add(from(6) |> take(2))
sources.add([8, 9] |> ARRAY())
sources.add({n * 10 for n in 1::2})

for source in sources do
    let seen = LIST[int]()

    for x in source do
        seen.add(x)
    od

    write_line(seen |> join(" "))
od
