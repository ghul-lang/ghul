use IO.Std.write_line
use System.Reflection.BindingFlags

union Shape is
    CIRCLE(radius: int)
    SQUARE(side: int, label: string)
    EMPTY
si

class POINT(x: int public, y: int public)

// The markers wasm carries are the union and variant ones; .NET carries
// more, so a type with none of those has its attributes left out.
describe(t: System.Type, show_markers: bool) is
    write_line("{t.name} extends {t.base_type!.name}")

    for c in t.get_constructors(BindingFlags.PUBLIC | BindingFlags.INSTANCE | BindingFlags.DECLARED_ONLY) do
        write_line("  constructor taking {c.get_parameters().count}")

        for p in c.get_parameters() do
            write_line("    {p.name}: {p.parameter_type.name}")
        od
    od

    if !show_markers then
        return
    fi

    for a in t.get_custom_attributes(false) do
        let marker = a.get_type()

        if let variants = marker.get_property("variants") then
            if let types: ARRAY[System.Type] = variants.get_value(a) then
                let names = Collections.LIST[string]()

                for v in types do
                    names.add(v.name)
                od

                write_line("  {marker.name}: {names |> Ghul.Pipes.join(", ")}")
            fi
        else
            write_line("  {marker.name}")
        fi
    od
si

entry() is
    describe(typeof Shape, true)
    describe(typeof Shape.SQUARE, true)
    describe(typeof POINT, false)

    let square_arguments: ARRAY[object?] = [3, "three"]
    let point_arguments: ARRAY[object?] = [cast object(1), cast object(2)]

    let square = System.Activator.create_instance(typeof Shape.SQUARE, square_arguments)!
    let point = System.Activator.create_instance(typeof POINT, point_arguments)!

    write_line("{square} {square.get_type().name}")
    write_line("{point}")
si
