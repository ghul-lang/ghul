use default

// value is still being inferred when the lambda body is first walked, so
// << and | have to wait for reduce to settle it at long rather than choose
// int from their other operands, and the cast takes long from |.
from_octets(octets: LIST[ubyte]) -> long =>
    octets |> reduce(0L, (value, octet: ubyte) => (value << 7) | cast(cast(octet) & 0x7F))

shifted(xs: LIST[long]) -> long[] =>
    xs |> map(value => (value << 2) | cast(3)) |> collect()

let octets = LIST[ubyte]()
octets.add(1ub)
octets.add(0x81`ub)

write_line("{from_octets(octets)}")

let longs = LIST[long]()
longs.add(1L)
longs.add(0x1_0000_0000L)

for s in shifted(longs) do
    write_line("{s}")
od
