namespace Test is
    use IO.Std.write_line;

    // Tests: a symbol an extern names that no linked library defines is
    // reported at the declaration that names it, for the function called and
    // for a deallocator the declaration names.

    @extern("", "no_such_function")
    missing() -> int;

    @extern("libc", "strdup", result = "take", free = "no_such_release")
    duplicate(text: string) -> string?;

    entry() is
        write_line("{missing()} {duplicate("x") ?? ""}");
    si
si
