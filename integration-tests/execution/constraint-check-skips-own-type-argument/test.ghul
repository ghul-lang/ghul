use default

// A call whose type argument is bound by inference is checked against its
// declared bounds once the argument has been substituted. Checked while
// the argument is still the callee's own type parameter, it reports the
// generic's own declaration as a violation - and that error keeps the
// call's result from settling, so a function literal capturing the
// result cannot be typed either.

entry() is
    let m = MAP();
    m["a"] = LIST[int]();
    m["a"].add(3);
    let total = m.values |> map(bases => bases.count) |> sum();
    let report = () => "{total}";
    write_line(report());
si
