namespace Test is
    use IO.Std

    // an all-caps word is not PascalCase: each of these warns
    trait LOGGED is
        log() -> string => "logged"
    si

    class ANIMAL abstract is
        speak() -> string
    si

    union TREE is
        LEAF
    si

    enum SUIT is
        HEARTS
    si

    class OOPS: Ghul.Exception is
        init() is super.init("oops") si
    si

    // these do not warn: a single capital, a PascalCase name with an
    // acronym in it, and a name in a script without case
    trait T is
        t() -> string => "t"
    si

    class HTTPError: Ghul.Exception is
        init() is super.init("http") si
    si

    enum 色 is
        RED
    si

    class CAT: ANIMAL, LOGGED, T is
        init() is si
        speak() -> string => "meow"
    si

    class Main is
        entry() static is
            let c = CAT()
            Std.write_line("{c.speak()} {c.log()} {c.t()} {TREE.LEAF} {SUIT.HEARTS} {色.RED}")
        si
    si
si
