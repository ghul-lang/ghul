use default

// The inner selector captures both enclosing stages' parameters.
mul(a: bigint[][], b: bigint[][]) -> bigint[][] =>
    0..a.count
        |> map(i => 0..b[0].count |> map(j => 0..b.count |> sum_by(k => a[i][k] * b[k][j])) |> ARRAY())
        |> ARRAY()

write_line("{$(mul([[1n, 2n], [3n, 4n]], [[5n, 6n], [7n, 8n]]))}")
