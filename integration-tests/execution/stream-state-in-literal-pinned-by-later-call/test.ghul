use default

// The stream's state tuple carries the enclosing literal's parameter, which
// only the later call pins. Binding the stream's state parameter joins that
// tuple with the candidate's own still-unbound parameter; the join takes the
// tuple rather than waiting on a binding that is not an operand.
let f = x => stream((x, x), ((a, b)) => (a, (b, a + b))) |> take(4) |> reduce(0, (p, q) => p + q)

write_line("{f(3)}")
