use default

// `--default-use` entries may be `alias=name`, importing the name under a
// different name. Here `dbl` and `sgl` stand for `double` and `single` in
// both conversion and type position.
entry() is
    let a = dbl(3)
    let b = sgl(2.5)
    let c: dbl = dbl(a + 1.0)
    let d: sgl = sgl(b)

    write_line("{a} {b} {c} {d}")
si
