// A function literal with no written return type, stored in a top-level
// variable and used later in the top-level statements, is typed as it
// would be written at that use.
use IO.Std.write_line

first[U](next: () -> U?) -> U? => next()

seven() -> int? => 7

no_word() -> string? => null

let s = () => seven()
write_line("value present: {first(s) ?? -1}")

let nw = () => no_word()
write_line("reference absent: {first(nw) ?? "absent"}")

let k = () => 7
let g: () -> int? = k
write_line("plain into optional: {g() ?? -1}")
