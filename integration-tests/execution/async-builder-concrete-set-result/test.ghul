use IO.Std.write_line
use System.Runtime.CompilerServices.IAsyncStateMachine

@System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(INT_BUILDER))
class COUNTED[T] is
    value: int public
    init() is si
si

// A builder that is not generic, for a task-like that is: its set_result
// takes the task's result type itself, and is found both by the check of
// the builder and by the code generated for the async function.
class INT_BUILDER is
    _task: COUNTED[int]
    init() is _task = COUNTED[int](); si
    create() -> INT_BUILDER static => INT_BUILDER()
    task: COUNTED[int] => _task
    start[S: IAsyncStateMachine](state_machine: S ref) is
        state_machine.move_next()
    si
    set_state_machine(state_machine: IAsyncStateMachine) is si
    set_result(value: int) is _task.value = value; si
    set_exception(e: System.Exception) is write_line("exception {e.message}"); si
    await_on_completed[A, S](awaiter: A ref, state_machine: S ref) is si
    await_unsafe_on_completed[A, S](awaiter: A ref, state_machine: S ref) is si
si

forty_two() -> COUNTED[int] is
    let half = await Tasks.TASK.from_result(21)
    return half * 2
si

write_line("value {forty_two().value}")
