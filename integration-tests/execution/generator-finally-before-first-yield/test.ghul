use IO.Std.write_line
use Ghul.Pipes

class RESOURCE(name: string): Ghul.Disposable is
    dispose() is
        write_line("disposed {name}")
    si
si

numbers() -> Pipe[int] is
    if true then
        let use r = RESOURCE("before the first yield")
    fi

    try
        write_line("in the try")
    finally
        write_line("finally before the first yield")
    yrt

    yield 1

    if true then
        let use r = RESOURCE("after it")
    fi

    yield 2
si

write_line("{numbers() |> join(", ")}")
