namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;

    // Tests: the subject of `|>` goes into the last call written on the
    // right-hand side, and trailers after that call apply to its result:
    // member access, indexing, `!` and `?`. A call reached through a
    // receiver that is itself a call keeps that receiver. After a `~>`
    // call the result is optional, so a member is read with `?.`.

    lookup(s: string) -> int? => if s =~ "a" then 1 else null fi;
    name(n: int) -> string => "n{n}";
    maybe(present: bool) -> int? => if present then 42 else null fi;

    class BOX is
        _v: int;
        init(v: int) is _v = v; si
        combine(a: int, b: int) -> int => _v + a + b;
    si

    entry() is
        let xs = [4, 5, 6];

        write_line("{xs |> collect_mutable().count}");         // 3
        write_line("{xs |> collect_mutable()[1]}");            // 5
        write_line("{xs |> map(x => x * 2) |> collect_mutable()[2]}"); // 12
        write_line("{"a" |> lookup()!}");                   // 1
        write_line("{"b" |> lookup()?}");                   // False
        write_line("{2 |> BOX(10).combine(3)}");            // 15
        write_line("{xs |> collect_mutable().count + 1}");     // 4
        write_line("{maybe(true) ~> name()?.length ?? -1}");  // 3
        write_line("{maybe(false) ~> name()?.length ?? -1}"); // -1
    si
si
