use IO.Std.write_line
use Concurrency.Future

// An entry returning a Future, named through a use, runs to completion
// with the command line and the environment passed in.
entry(args: string[], env: Ghul.Environment) -> Future is
    env["GHUL_ENTRY_TEST_VAR"] = "hello"

    await Future.yield()

    write_line("arguments: {args.count}")
    write_line("environment: {env["GHUL_ENTRY_TEST_VAR"]}")
si
