// The .NET queue, priority queue and linked list are QUEUE, PRIORITY_QUEUE
// and LINKED_LIST, like LIST, MAP, SET and STACK. Their .NET names still
// compile, as other spellings of the same types.
use IO.Std.write_line

let queue = Collections.QUEUE[int]()
queue.enqueue(1)
queue.enqueue(2)
write_line("queue: {queue.dequeue()} then {queue.peek()}")

let by_priority = Collections.PRIORITY_QUEUE[string, int]()
by_priority.enqueue("later", 2)
by_priority.enqueue("first", 1)
write_line("priority: {by_priority.dequeue()}")

let linked = Collections.LINKED_LIST[string]()
linked.add_last("b")
linked.add_first("a")
write_line("linked: {linked |> Ghul.Pipes.join(", ")}")

let old: Collections.Queue[int] = queue
write_line("same type: {old.count}")
