// A `ref` to a field of a struct held in a mutable local that a closure
// captures: the callee's write reaches the local and the closure. (wasm
// rejects a `ref` to a field.)
use IO.Std.write_line

struct POINT is
    x: int field
    y: int field

    init(x: int, y: int) is
        self.x = x
        self.y = y
    si
si

bump(value: int ref) is
    value! = value! + 1
si

written_only_by_ref() is
    let p mut = POINT(1, 10)
    let read = () => p.x
    bump(p.x ref)
    write_line("only by ref: {p.x} {read()} {p.y}")
si

also_assigned() is
    let p mut = POINT(0, 10)
    let read = () => p.x
    p = POINT(1, 20)
    bump(p.x ref)
    write_line("also assigned: {p.x} {read()} {p.y}")
si

written_only_by_ref()
also_assigned()
