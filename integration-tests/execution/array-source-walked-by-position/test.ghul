use default

// A loop or fused chain over an array or a list walks it by position, and
// must behave as the iterator would: the same elements in the same order,
// the source evaluated once and before any stage's arguments, `break` and
// `continue` as usual. Each scenario runs over the collection, over the same
// collection seen as a sequence (which takes the iterator), and with fusion
// suppressed. A list's count is read before each element, so a list that
// shrinks while a loop reads it ends the loop.

class LOG is
    entries: LIST[string]
    init() is entries = LIST[string](); si

    note(tag: string, value: int) -> int is
        entries.add("{tag}:{value}")
        return value
    si

    source(tag: string, values: ARRAY[int]) -> ARRAY[int] is
        entries.add("source:{tag}")
        return values
    si

    text: string => entries |> join(" ")
si

plain_loop(xs: ARRAY[int]) -> string is
    let seen = LIST[int]()

    for x in xs do
        if x == 3 then continue fi
        if x == 6 then break fi
        seen.add(x)
    od

    return seen |> join(",")
si

sequence_loop(xs: Iterable[int]) -> string is
    let seen = LIST[int]()

    for x in xs do
        if x == 3 then continue fi
        if x == 6 then break fi
        seen.add(x)
    od

    return seen |> join(",")
si

list_loop(xs: LIST[int]) -> string is
    let seen = LIST[int]()

    for x in xs do
        if x == 3 then continue fi
        if x == 6 then break fi
        seen.add(x)
    od

    return seen |> join(",")
si

list_consumers(xs: LIST[int]) -> string =>
    "{xs |> map(x => x * 2) |> sum()} {xs |> filter(x => x > 2) |> reduce(0, (a, x) => a + x)} {xs |> skip(1) |> take(3) |> join(",")}"

list_consumers_unfused(xs: LIST[int]) -> string is
    @suppress("pipe-fusion")
    let text = "{xs |> map(x => x * 2) |> sum()} {xs |> filter(x => x > 2) |> reduce(0, (a, x) => a + x)} {xs |> skip(1) |> take(3) |> join(",")}"

    return text
si

list_fused_for(xs: LIST[int]) -> string is
    let seen = LIST[int]()

    for x in xs |> filter(x => x % 2 == 1) |> map(x => x * 10) do
        seen.add(x)
    od

    return seen |> join(",")
si

// A list that shrinks while a loop reads it throws from the element read,
// which stays bounds-checked against the list's own count.
shrinking(xs: LIST[int]) -> string is
    let seen = LIST[int]()

    try
        for x in xs do
            seen.add(x)
            xs.remove_at(xs.count - 1)
        od
    catch e: Ghul.Exception
        return "{seen |> join(",")} threw"
    yrt

    return "{seen |> join(",")} finished"
si

shrinking_fused(xs: LIST[int]) -> string is
    try
        return "{xs |> map(x => (xs.remove_at(xs.count - 1); x)) |> sum()} finished"
    catch e: Ghul.Exception
        return "threw"
    yrt
si

pairs_loop(pairs: ARRAY[(string, int)]) -> string is
    let seen = LIST[string]()

    for (name, n) in pairs do
        seen.add("{name}{n}")
    od

    return seen |> join(",")
si

fused_for(xs: ARRAY[int]) -> string is
    let seen = LIST[int]()

    for x in xs |> filter(x => x % 2 == 1) |> map(x => x * 10) do
        if x == 30 then continue fi
        seen.add(x)
    od

    return seen |> join(",")
si

fused_for_unfused(xs: ARRAY[int]) -> string is
    let seen = LIST[int]()

    @suppress("pipe-fusion")
    let chain = xs |> filter(x => x % 2 == 1) |> map(x => x * 10)

    for x in chain do
        if x == 30 then continue fi
        seen.add(x)
    od

    return seen |> join(",")
si

consumers(xs: ARRAY[int]) -> string =>
    "{xs |> map(x => x * 2) |> sum()} {xs |> filter(x => x > 2) |> reduce(0, (a, x) => a + x)} {xs |> skip(1) |> take(3) |> join(",")} {xs |> map(x => x + 1) |> find(x => x > 4)} {xs |> filter(x => x > 1) |> ARRAY() |> join(",")}"

consumers_unfused(xs: ARRAY[int]) -> string is
    @suppress("pipe-fusion")
    let text = "{xs |> map(x => x * 2) |> sum()} {xs |> filter(x => x > 2) |> reduce(0, (a, x) => a + x)} {xs |> skip(1) |> take(3) |> join(",")} {xs |> map(x => x + 1) |> find(x => x > 4)} {xs |> filter(x => x > 1) |> ARRAY() |> join(",")}"

    return text
si

order(log: LOG) -> int =>
    log.source("a", [1, 2, 3] |> ARRAY()) |> map(x => x * log.note("factor", 2)) |> take(log.note("count", 2)) |> sum()

order_unfused(log: LOG) -> int is
    @suppress("pipe-fusion")
    let total = log.source("a", [1, 2, 3] |> ARRAY()) |> map(x => x * log.note("factor", 2)) |> take(log.note("count", 2)) |> sum()

    return total
si

let xs = [1, 2, 3, 4, 5, 6, 7] |> ARRAY()
let empty = LIST[int]() |> ARRAY()

write_line("plain {plain_loop(xs)} | {sequence_loop(xs)}")
write_line("empty {plain_loop(empty)} | {sequence_loop(empty)} | {empty |> map(x => x * 2) |> sum()}")
let ys = LIST[int]([1, 2, 3, 4, 5, 6, 7])

write_line("list {list_loop(ys)} | {sequence_loop(ys)} | {list_loop(LIST[int]())}")
write_line("list consumers {list_consumers(ys)} | {list_consumers_unfused(ys)}")
write_line("list fused for {list_fused_for(ys)}")
write_line("shrinking {shrinking(LIST[int]([1, 2, 3, 4, 5, 6]))} | fused {shrinking_fused(LIST[int]([1, 2, 3, 4, 5, 6]))}")
write_line("pairs {pairs_loop([("a", 1), ("b", 2)])}")
write_line("literal {[4, 5, 6] |> map(x => x - 1) |> sum()} comprehension {[x * x for x in 1::3] |> map(x => x + 1) |> sum()}")
write_line("fused for {fused_for(xs)} | {fused_for_unfused(xs)}")
write_line("consumers {consumers(xs)}")
write_line("unfused   {consumers_unfused(xs)}")

let fused_log = LOG()
let fused_total = order(fused_log)
let unfused_log = LOG()
let unfused_total = order_unfused(unfused_log)

write_line("order {fused_total} {fused_log.text}")
write_line("order {unfused_total} {unfused_log.text}")
