use IO.Std.write_line

// GC, the attributes and the formatting trait live under their ghūl names.

class TEMPERATURE: Ghul.Formattable is
    _celsius: int

    init(celsius: int) is
        _celsius = celsius
    si

    to_string() -> string => "{_celsius}C"

    to_string(format: string?, format_provider: Ghul.FormatProvider?) -> string =>
        if format =~ "F" then "{_celsius * 9 / 5 + 32}F" else to_string() fi
si

class HOT is
    init() is si

    @Ghul.MethodImplAttribute(Ghul.MethodImplOptions.NO_INLINING)
    kept(x: int) -> int => x + 1

    @Ghul.ObsoleteAttribute("old")
    old(x: int) -> int => x
si

let same: Ghul.Formattable = TEMPERATURE(100)
write_line("{same} {TEMPERATURE(100):F}")
write_line("{HOT().kept(1)}")

write_line("{Ghul.GC.get_total_memory(false) > 0L}")
