use IO.Std.write_line

trait Holder[T] is
    held: Collections.LIST[T] => Collections.LIST[T]()
si

trait Described is
    description: string => "undescribed"
si

trait Detailed: Described is
    detail: int => 0
si

union Shape[T]: Holder[T], Detailed is
    GROUP(held: Collections.LIST[T])
    SQUARE(side: double)
    LINE(description: string, detail: int)
si

count_held[T](h: Holder[T]) -> int => h.held.count

describe(d: Detailed) -> string => "{d.description} {d.detail}"

let names = Collections.LIST[string]()
names.add("ada")
names.add("grace")

write_line("generic trait, variant with field: {count_held(Shape.GROUP[string](names))}")
write_line("generic trait, variant without field: {count_held(Shape.SQUARE[string](1.0))}")

let group: Shape[string] = Shape.GROUP[string](names)
write_line("generic trait, through the union: {group.held[1]}")
write_line("super-trait, variant with fields: {describe(Shape.LINE[string]("diagonal", 3))}")
write_line("super-trait, variant without fields: {describe(Shape.SQUARE[string](2.0))}")
