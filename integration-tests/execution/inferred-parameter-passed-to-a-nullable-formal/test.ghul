use default

// `word` is passed to methods taking `string?`, and called with strings
// through `outer`: it takes the strings, so it can be read as one.
same(word) => word.length > 0 /\ !string.is_null_or_empty(word)

outer(word) => same(word)

// Nothing passes a value to `item`, so it takes the type of what it is
// passed to.
blank(item) => string.is_null_or_empty(item)

write_line("{outer("a")} {blank(null)}")

// Called with slices of a string from inside literals in two other inferred
// functions: `text` is the string `int.parse` takes.
prime(text) => int.parse(text) >= 2

left(text) => 0..text.length |> all(start => prime(text[start..<0]))

right(text) => 1::text.length |> all(end => prime(text[0..end]))

write_line("{left("373")} {right("373")}")
