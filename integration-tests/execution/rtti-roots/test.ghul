use IO.Std.write_line
use Ghul.Pipes

class Item[T](value: T public)

class Inner(count: int public)

union Shape is
    CIRCLE(radius: double)
    SQUARE(side: double)
si

class Animal(name: string public)

class Dog(name: string, breed: string public): Animal is
    super(name)
si

@reflected()
class Request(items: Collections.LIST[Item[Inner]] public, shape: Shape public, pet: Animal public)

class Unrelated(text: string public)

show(type: System.Type) is
    try
        let names = type.get_properties() |> map(p => p.name) |> sort() |> join(", ")

        write_line("{type.name}: {names}")
    catch e: Ghul.NotSupportedException
        write_line(e.message)
    yrt
si

entry() is
    let items = Collections.LIST[Item[Inner]]()
    items.add(Item(Inner(3)))

    let request = Request(items, Shape.CIRCLE(1.5), Dog("rex", "lab"))
    let unrelated = Unrelated("x")

    write_line("{request.items.count} {unrelated.text}")

    show(typeof Request)
    show(typeof Item[Inner])
    show(typeof Inner)
    show(typeof Shape.CIRCLE)
    show(typeof Shape.SQUARE)
    show(typeof Animal)
    show(typeof Dog)
    show(typeof Unrelated)
si
