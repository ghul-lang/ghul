use default

// A concrete overload beside a generic one: the argument's element type is
// still being inferred from `rows` when `first_of` is resolved.

struct Money(cents: int public) is
    to_string() -> string => "{cents}";
si

first_of(source: string{}) -> string => source |> join("")
first_of[T](source: T{}) -> T => source |> first()!

firsts(rows) => rows |> map(row => row |> first_of()) |> list()

write_line(firsts([[Money(1), Money(2)], [Money(3)]]) |> join(" "))
