use default

// An if expression written directly as the source of a generic call takes
// the join of its arms as its type, even while the call's formal still
// holds the type argument this expression is meant to pin, so a later
// literal in the chain learns its parameter type.
let c = true
let f = if c then s => s.length else t => t.length fi

let typed: int[] = (if c then [6] else ([4, 3] |> map(x => f("hello")) |> ARRAY()) fi) |> map(y => y + 14) |> ARRAY()
let untyped = (if c then [6] else ([4, 3] |> map(x => f("hello")) |> ARRAY()) fi) |> map(y => y * 2) |> ARRAY()
let from_else = (if !c then [6] else ([4, 3] |> map(x => f("hi")) |> ARRAY()) fi) |> map(y => y + 1) |> ARRAY()

write_line("{f("a")} {typed |> join(",")} {untyped |> join(",")} {from_else |> join(",")}")
