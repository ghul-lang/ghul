use default

trait Named is
    name: string;
si

class Cat(name: string public): Named is si

let pair = (3, 4)

let (wide: long, same: int) = pair
let (ratio: double, _) = pair

scaled((x: long, y): (int, int)) -> long => x * 10000000000L + y

halved((x: double, _): (int, int)) -> double => x / 2.0

let lam = ((a: double, b: long): (int, int)) => a / 2.0 + double(b)

let (named: Named, count: int) = (Cat("tom"), 1)

nested(((p: long, q), r): ((int, int), int)) -> long => p * 10000000000L + q + r

write_line("{wide * 10000000000L} {same} {ratio / 2.0}")
write_line("{scaled(pair)} {halved(pair)} {lam(pair)}")
write_line("{named.name} {count} {nested(((1, 2), 3))}")
