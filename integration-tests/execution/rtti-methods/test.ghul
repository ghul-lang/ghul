namespace Calc is
    use default

    use Ghul.Reflection.BindingFlags
    use Ghul.Reflection.MethodInfo

    class CALCULATOR is
        init() is si

        twice(n: int) -> int => n * 2

        scale(n: int, by: int) -> int => n * by

        scale(x: double) -> double => x * 10.0

        greet(name: string) -> string => "hello {name}"

        shout(text: string) is
            write_line("{text}!")
        si

        zero() -> int static => 0

        _hidden() -> int => 1
    si

    triple(n: int) -> int => n * 3

    announce(text: string) is
        write_line("announce {text}")
    si

    show(method: MethodInfo) -> string is
        let names = method.get_parameters() |> map(p => p.name ?? "?") |> join(", ")

        return "{method.name}({names}) static={method.is_static} public={method.is_public}"
    si

    entry() is
        let calculator = CALCULATOR()
        let type = calculator.get_type()
        let flags = BindingFlags.PUBLIC | BindingFlags.NON_PUBLIC | BindingFlags.INSTANCE | BindingFlags.STATIC | BindingFlags.DECLARED_ONLY

        let lines = LIST[string]()

        for method in type.get_methods(flags) do
            lines.add(show(method))
        od

        lines.sort()

        for line in lines do
            write_line(line)
        od

        write_line("twice: {type.get_method("twice")!.invoke(calculator, [cast object(7)])}")
        write_line("scale int: {type.get_method("scale", [typeof int, typeof int])!.invoke(calculator, [cast object(6), cast object(7)])}")
        write_line("scale double: {type.get_method("scale", [typeof double])!.invoke(calculator, [cast object(1.5)])}")
        write_line("greet: {type.get_method("greet")!.invoke(calculator, ["you"])}")
        write_line("shout returns: {type.get_method("shout")!.invoke(calculator, ["hey"])}")
        write_line("zero: {type.get_method("zero")!.invoke(null, [])}")
        write_line("declared by: {type.get_method("twice")!.declaring_type}")
        write_line("missing: {type.get_method("missing")}")

        try
            type.get_method("scale")
            write_line("scale by name alone: found")
        catch ex: Ghul.Reflection.AmbiguousMatchException
            write_line("scale by name alone: ambiguous")
        yrt

        write_line("by name: {Ghul.Reflection.get_type("Calc.CALCULATOR")}")
        write_line("triple: {Ghul.Reflection.get_function("Calc.triple")!.invoke(null, [cast object(5)])}")
        write_line("announce returns: {Ghul.Reflection.get_function("Calc.announce", [typeof string])!.invoke(null, ["it"])}")
        write_line("missing function: {Ghul.Reflection.get_function("Calc.missing")}")
    si
si
