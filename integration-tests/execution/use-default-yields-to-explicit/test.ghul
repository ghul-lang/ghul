// The default set is a fallback. A name an explicit `use` imports means
// what that import says, whether the clause comes before or after
// `use default`, and the default set's own import of the name is neither a
// duplicate nor another overload. Here `Ghul.Math` is declared with a
// `sqrt` that would answer differently from `System.Math`'s, so which one
// each call reached shows in the output.
namespace Ghul.Math is
    sqrt(value: double) -> double => value * 100.0
si

namespace Aliased is
    use default
    use Math = System.Math

    report() is
        write_line("aliased {Math.sqrt(4.0)}")
    si
si

namespace Wildcard is
    use default
    use System.Math.*

    report() is
        write_line("wildcard {sqrt(4.0)}")
    si
si

namespace Member is
    use System.Math.sqrt
    use default

    report() is
        write_line("member {sqrt(4.0)}")
    si
si

namespace Fallback is
    use default

    report() is
        write_line("fallback {sqrt(4.0)}")
    si
si

namespace Test is
    entry() is
        Aliased.report()
        Wildcard.report()
        Member.report()
        Fallback.report()
    si
si
