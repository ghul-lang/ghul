use IO.Std.write_line
use Ghul.Pipes

// A power operator declared on the test's own type, so the precedence and
// grouping of `**` are tested whatever the runtime declares.
struct N(v: int public) is
    to_string() -> string => "{v}"
si

*(a: N, b: N) -> N => N(a.v * b.v)

-(a: N) -> N => N(-a.v)

**(a: N, b: N) -> N is
    let result mut = 1

    for i in 0..b.v do
        result = result * a.v
    od

    N(result)
si

let two = N(2)
let three = N(3)

// binds tighter than `*`
write_line("{two * three ** two}")

// groups to the right
write_line("{two ** three ** two}")

// a prefix operator applies first
write_line("{-two ** two}")

// partial application of either operand, and the operator as a value
write_line("{[N(1), two, three] |> map(* ** two) |> string(" ")}")
write_line("{[N(1), two, three] |> map(two ** *) |> string(" ")}")
write_line("{[two, two, two] |> reduce(N(1), `*) ** two}")
