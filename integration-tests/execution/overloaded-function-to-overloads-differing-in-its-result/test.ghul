use default

// Tests: an overloaded function passed to overloads that differ only in
// what that function formal returns is given the parameters they agree
// on, picks its member by them, and its result picks the overload. An
// overload of the same name taking something else there, such as the
// library's apply, isn't in question.

apply(xs: int[], f: int -> int) -> int => f(xs[0])
apply(xs: int[], f: int -> long) -> long => f(xs[0])

next(n: int) -> int => n + 1
next(s: string) -> string => s

widen(n: int) -> long => long(n) * 10L
widen(s: string) -> string => s

write_line("{apply([1], next)}")
write_line("{apply([2], widen)}")
