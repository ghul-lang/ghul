@@rtti("Ghul.Math")

use IO.Std.write_line

let abs = Ghul.Reflection.get_function("Ghul.Math.abs", [typeof int])!

write_line("{abs.name} static={abs.is_static} declared by {abs.declaring_type}")
write_line("abs(-5) = {abs.invoke(null, [cast object(-5)])}")

let max = Ghul.Reflection.get_function("Ghul.Math.max", [typeof long, typeof long])!

write_line("max(3, 9) = {max.invoke(null, [cast object(3L), cast object(9L)])}")

try
    Ghul.Reflection.get_function("Ghul.Math.abs")
    write_line("abs by name alone: found")
catch ex: Ghul.Reflection.AmbiguousMatchException
    write_line("abs by name alone: ambiguous")
yrt

write_line("missing: {Ghul.Reflection.get_function("Ghul.Math.missing")}")
