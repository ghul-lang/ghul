use IO.Std.write_line

// A function the program calls only from a failing assert's message is
// compiled with everything it reaches, here a list of a type nothing
// else uses.
describe() -> string is
    let values = Collections.LIST[uint]()
    values.add(7u)
    return "described {values.count}"
si

try
    assert 1 == 2 else describe()
catch e: Ghul.AssertFailedException
    let text = e.message
    write_line(text.substring(text.index_of(": ") + 2))
yrt
