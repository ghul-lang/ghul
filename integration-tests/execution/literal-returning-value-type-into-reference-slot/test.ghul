use default

// A literal whose inferred return is a value type settles at the slot's
// reference type, so the conversion is made inside the literal. Reaching
// the slot's type by assigning the delegate instead would need the return
// covariance a value-type instantiation does not have, and nothing checks
// that at run time.
write_line("{[0, 3] |> flat_map(s => s..s + 2) |> collect_mutable()}")

// The same literal with its return type written out, which is the shape
// the inferred one now settles at.
let ranges = (s: int) -> Iterable[int] => s..s + 2

write_line("{[0, 3] |> flat_map(ranges) |> collect_mutable()}")

// A block body settles its return on a different path from an expression
// body, and both have to make the conversion.
write_line("{[0, 3] |> flat_map(s is return s..s + 2 si) |> collect_mutable()}")

// A reference-typed body keeps the more precise type it produced.
write_line("{[0, 3] |> flat_map(s => [s, s + 1]) |> collect_mutable()}")
