use IO.Std.write_line

struct Below(limit: double public);

~(value: double, b: Below) -> bool => value < b.limit

~(value: int, r: Ghul.Range[int]) -> bool => value >= r.from /\ value < r.to

~[T](value: T, test: (T) -> bool) -> bool => test(value)

// marked expression leaves: a call, a range, an index, a parenthesised
// expression and a function literal
leaf(p: (int, double), xs: int[], limit: int) -> string =>
    case p
    when (~xs[0], _) then "first of xs"
    when (~(limit + 1), _) then "just over the limit"
    when (~0..10, ~Below(0.0)) then "small and negative"
    when (_, ~(d => d > 100.0)) then "huge"
    else "other"
    esac

// a marked tuple value
pair(p: ((int, int), string), a: int, b: int) -> string =>
    case p
    when (~(a, b), s) then "same pair {s}"
    else "other"
    esac

entry() is
    let xs = [3, 4]

    write_line(leaf((3, 0.0), xs, 50))
    write_line(leaf((51, 0.0), xs, 50))
    write_line(leaf((5, -1.0), xs, 50))
    write_line(leaf((20, 200.0), xs, 50))
    write_line(leaf((20, 2.0), xs, 50))

    write_line(pair(((1, 2), "x"), 1, 2))
    write_line(pair(((1, 2), "y"), 2, 1))

    // if let, with a guard after the ~ leaf
    if let (~Below(1.0), label) = (0.5, "cold") /\ label.length > 2 then
        write_line("if let {label}")
    fi

    if let (~Below(1.0), label) = (5.0, "warm") then
        write_line("unexpected {label}")
    else
        write_line("if let did not match")
    fi

    // while let
    let readings = [0.1, 0.4, 2.0, 0.2]
    let i mut = 0

    while let (~Below(1.0), at) = (readings[i], i) do
        write_line("reading {at} is low")
        i = i + 1
    od
si
