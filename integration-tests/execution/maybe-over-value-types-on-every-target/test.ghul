// The optional of a type parameter at a value type: its members, equality,
// hashing in a set, and text, construction both ways, a struct copied out of it and
// changed, and a conversion to object, alike on every target.

use IO.Std.write_line
use Collections.LIST

struct Point(x: int field public, y: int field public) is
    to_string() -> string => "({x}, {y})";
si

hold[T](value: T) -> T? => value

nothing[T]() -> T? => null

describe[T](m: T?) -> string =>
    if m? then "present {m}" else "absent" fi

// A set of `T?` hashes and compares the optionals themselves.
distinct[T](values: T[], absent: int) -> int is
    let seen = Collections.SET[T?]()
    for v in values do seen.add(hold(v)) od
    for i in 0..absent do seen.add(nothing[T]()) od
    return seen.count
si

eq[T](a: T, b: T) -> bool => a =~ b
hash[T](a: T) -> int => a.get_hash_code()

// `=~`, hashing and a set over `T?` at `T` given, where `T` is itself
// optional too, so a MAYBE over an optional is compared as well.
compared[T](x: T, y: T) -> string is
    let a = hold(x)
    let b = hold(y)
    let n = nothing[T]()
    let present = Collections.SET[T?]()
    present.add(a)
    present.add(b)
    let absent = Collections.SET[T?]()
    absent.add(n)
    absent.add(nothing[T]())
    "{eq(a, b)} {eq(n, nothing[T]())} {eq(a, n)} {hash(a) == hash(b)} {hash(n)} {present.count} {absent.count}"
si

// `equals` taking an object, which tests what it is given against the
// optional's own type.
equals_object[T](a: T, o: object?) -> bool => a.equals(o)

as_object[T](a: T) -> object? => a

point_of(m: Point?) -> Point => m ?? Point(0, 0)

let a = hold(3)
let b = hold(3)
let none = nothing[int]()

write_line("{describe(a)} {describe(none)}")
write_line("equal {a =~ b} {a =~ none} {none =~ nothing[int]()}")
write_line("distinct {distinct([3, 3, 4], 2)}")
write_line("text {a} {none}")
write_line("compared {compared(3, 3)}")
write_line("compared optional {compared[int?](3, 3)}")
write_line("equals object {equals_object(a, as_object(b))} {equals_object(a, as_object(hold(4)))} {equals_object(a, "text")}")

let maybe_point = hold(Point(1, 2))
let copied mut = point_of(maybe_point)
copied.x = 10
write_line("copy {copied} original {describe(maybe_point)}")

let list = LIST[int?]()
list.add(a)
list.add(none)
write_line("list {list.count} {describe(list[0])} {describe(list[1])}")

let boxed: object? = hold(5)
write_line("object {boxed}")
let absent_boxed: object? = nothing[int]()
write_line("object absent {!absent_boxed?}")

let value_of = hold(7)
write_line("value {value_of!}")

try
    let missing = nothing[int]()
    write_line("{missing!}")
catch e: Ghul.Exception
    write_line("threw {e.message}")
yrt
