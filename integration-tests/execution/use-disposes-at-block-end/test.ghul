// `use E` disposes its value when the innermost enclosing block ends,
// wherever in an expression it is written: a loop's source, a pipe's
// source, an argument. A parenthesised block is a block, so a `use` in one
// is disposed as soon as that block ends.
use default

class SRC: Ghul.Disposable, Iterable[int] is
    _name: string

    init(name: string) is
        _name = name
        write_line("  open {name}")
    si

    iterator: Iterator[int] => [1, 2, 3].iterator

    dispose() is
        write_line("  dispose {_name}")
    si
si

count_of(s: SRC) -> int => s |> count()

loop_source() is
    write_line("a loop's source:")

    for x in use SRC("loop") do
        if x == 2 then break fi
    od

    write_line("  after the loop")
si

pipe_source() is
    write_line("a pipe's source:")

    let total = use SRC("pipe") |> sum()

    write_line("  after the statement, total {total}")
si

argument() is
    write_line("an argument:")

    let n = count_of(use SRC("argument"))

    write_line("  after the statement, count {n}")
si

inner_block() is
    write_line("an inner block:")

    if true then
        let total = use SRC("inner") |> sum()
        write_line("  in the inner block, total {total}")
    fi

    write_line("  after the inner block")
si

parenthesised_block() is
    write_line("a parenthesised block:")

    let total = (let use source = SRC("parenthesised"); source |> sum())

    write_line("  after the block, total {total}")
si

entry() is
    loop_source()
    pipe_source()
    argument()
    inner_block()
    parenthesised_block()
si
