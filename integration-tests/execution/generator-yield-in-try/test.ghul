// Runs generators whose resume points lie inside a try: under a finally,
// under a catch, in a loop inside the try, in a try inside a loop, and in
// nested trys. A finally runs once the generator is read to its end or
// returns, and not each time it suspends. It prints 100 plus a
// bit for each check that failed.
namespace Test is
    use IO.Std.write_line
    use Collections.Iterable

    class CodedException: Ghul.Exception is
        code: int

        init(code: int) is
            super.init("coded")
            self.code = code
        si
    si

    finallies: int

    count(n: int) -> Iterable[int] is
        let i mut = 0

        while i < n do
            yield i
            i = i + 1
        od
    si

    under_finally() -> Iterable[int] is
        try
            yield 1
            yield 2
        finally
            finallies = finallies + 1
        yrt
    si

    returns_after_resume() -> Iterable[int] is
        try
            yield 1
            return
        finally
            finallies = finallies + 1
        yrt

        yield 9
    si

    under_catch() -> Iterable[int] is
        let caught mut = 0

        try
            yield 1
            throw CodedException(5)
        catch e: CodedException
            caught = e.code
        yrt

        yield caught
    si

    loop_in_try() -> Iterable[int] is
        try
            for i in count(3) do
                yield i + 1
            od
        finally
            finallies = finallies + 1
        yrt
    si

    try_in_loop() -> Iterable[int] is
        for i in count(3) do
            try
                yield i + 1
            finally
                finallies = finallies + 1
            yrt
        od
    si

    nested() -> Iterable[int] is
        try
            try
                yield 1
            finally
                finallies = finallies + 1
            yrt

            yield 2
        finally
            finallies = finallies + 1
        yrt
    si

    digits(values: Iterable[int]) -> int is
        let result mut = 0

        for value in values do
            result = result * 10 + value
        od

        return result
    si

    check(passed: bool, bit: int) -> int => if passed then 0 else bit fi

    entry() -> int is
        let failed mut = 0

        finallies = 0
        failed = failed + check(digits(under_finally()) == 12 /\ finallies == 1, 1)

        finallies = 0
        failed = failed + check(digits(returns_after_resume()) == 1 /\ finallies == 1, 2)

        failed = failed + check(digits(under_catch()) == 15, 4)

        finallies = 0
        failed = failed + check(digits(loop_in_try()) == 123 /\ finallies == 1, 8)

        finallies = 0
        failed = failed + check(digits(try_in_loop()) == 123 /\ finallies == 3, 16)

        finallies = 0
        failed = failed + check(digits(nested()) == 12 /\ finallies == 2, 32)

        write_line("{100 + failed}")

        return 0
    si
si
