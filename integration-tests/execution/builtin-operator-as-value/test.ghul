namespace Test is
    use Ghul.Pipes
    use IO.Std.write_line

    class TABLE is
        init() is si

        show() is
            let times: (int, int) -> int = int.`*
            let again: (int, int) -> int = int.`*

            write_line("{times(6, 7)} {again(2, 3)}")

            let remainder = (x: int) -> int is
                let rem: (int, int) -> int = int.`%

                return rem(x, 3)
            si

            write_line("{remainder(10)}")
        si
    si

    entry() is
        write_line("{[1, 2, 3, 4] |> reduce(0, int.`+)}")
        write_line("{[1.5, 2.0] |> reduce(1.0, double.`*)}")
        write_line("{[1L, 2L] |> reduce(0L, long.`+)}")

        let minus: (int, int) -> int = int.`-
        let negate: int -> int = int.`-

        write_line("{minus(3, 1)} {negate(5)}")

        let order: (int, int) -> int = `<>

        write_line("{order(1, 2)} {order(2, 2)} {order(3, 2)}")

        let add: (decimal, decimal) -> decimal = decimal.`+

        write_line("{add(1.5m, 2.25m)}")

        let same_text: (string?, string?) -> bool = `=~

        write_line("{same_text("a", "a")} {same_text("a", null)}")

        let both: (bool, bool) -> bool = `/\
        let either: (bool, bool) -> bool = `\/

        write_line("{both(true, false)} {either(false, true)}")

        let range: (int, int) -> Ghul.INT_RANGE = `..

        write_line("{range(1, 4) |> sum()}")

        TABLE().show()
    si
si
