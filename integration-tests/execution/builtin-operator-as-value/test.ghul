use Ghul.Pipes
use IO.Std.write_line

// Tests: a built-in operator named as a value, through its type or by
// its bare spelling resolved from the expected function type, is a
// function of its operands, built once and reused.

struct V(x: int public) is
    +(a: V, b: V) -> V static pure => V(a.x + b.x)
si

add(a: int, b: int) -> int => a + b

// the operator is a static member of the right operand's type
struct W(x: int public) is
    *(a: int, b: W) -> W static pure => W(a * b.x)
si

// a global operator under the same spelling is one candidate among the
// innates, and the operands pick between them
+(a: W, b: W) -> W pure => W(a.x + b.x)

same[T](x: T, y: T) -> bool is
    let equal: (T, T) -> bool = `==

    return equal(x, y)
si

plus() -> (int, int) -> int => int.`+

entry() is
    // through the type
    write_line("{[1, 2, 3, 4] |> reduce(0, int.`+)}")
    write_line("{[1.5, 2.0] |> reduce(1.0, double.`*)}")
    write_line("{[1L, 2L] |> reduce(0L, long.`+)}")
    write_line("{[1.5m, 2.25m] |> reduce(0m, decimal.`+)}")

    // bare spelling, resolved as the operator over the slot's operand
    // types would be
    write_line("{[1, 2, 3] |> reduce(0, `+)}")
    write_line("{([W(1), W(2)] |> reduce(W(0), `+)).x}")

    let scale: (int, W) -> W = `*
    write_line("{scale(3, W(4)).x}")

    // in callee position, the written operands pick the operator and a
    // `*` takes the formal it stands in
    let from_ten = `-(10, *)
    let quadruple = `*(*, W(4))

    write_line("{from_ten(3)} {quadruple(3).x} {`+(2, 3)} {[1, 2, 3] |> map(`+(*, 1)) |> string(",")}")

    write_line("{zip([1, 2], [10, 20], `*) |> string(",")}")
    write_line("{[1, 2, 3] |> map(`-) |> string(",")}")
    write_line("{[true, false] |> map(`!) |> string(",")}")
    write_line("{([V(1), V(2)] |> reduce(V(0), `+)).x}")

    // a pack of operands presented as one tuple
    write_line("{[(1, 2), (3, 4)] |> map(`+) |> string(",")}")
    write_line("{[(1, 2), (3, 4)] |> map(int.`+) |> string(",")}")
    write_line("{[(1, 2), (3, 4)] |> map(add) |> string(",")}")

    // unary and binary overloads, picked by the slot
    let minus: (int, int) -> int = int.`-
    let negate: int -> int = int.`-
    let again: (int, int) -> int = `-

    write_line("{minus(3, 1)} {negate(5)} {object.reference_equals(minus, again)} {object.reference_equals(plus(), plus())}")

    // the global innates
    let order: System.Comparison[int] = `<>
    let equal: (int, int) -> bool = `==
    let same_text: (string?, string?) -> bool = `=~
    let both: (bool, bool) -> bool = `/\
    let either: (bool, bool) -> bool = `\/
    let range: (int, int) -> Ghul.INT_RANGE = `..

    write_line("{order.invoke(2, 1)} {equal(1, 1)} {equal(1, 2)} {same_text("a", "a")} {same_text("a", null)} {both(true, false)} {either(false, true)} {range(1, 4) |> sum()}")

    // over a type parameter of the enclosing function
    write_line("{same(1, 1)} {same("a", "b")}")
si
