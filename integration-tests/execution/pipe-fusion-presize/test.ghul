namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A fused collect over a source whose count is known - an array, a
    // list, a range, repeat(value, count) - through stages that keep it,
    // produces the same result sized up front as it does grown: contents
    // and count agree in every case, including an empty range whose end
    // precedes its start. A stage that can drop or add elements leaves the
    // result grown, and is right too.
    class Main is
        show(name: string, xs: int[]) static is
            let parts = xs |> map(x => "{x}") |> join(",");

            Std.write_line("{name}: [{parts}] count={xs.count}");
        si

        show_list(name: string, xs: LIST[int]) static is
            let parts = xs |> map(x => "{x}") |> join(",");

            Std.write_line("{name}: [{parts}] count={xs.count}");
        si

        entry() static is
            let array = [1, 2, 3, 4];
            let list = LIST[int]([5, 6, 7]);
            let n = 3;

            show("array", array |> map(x => x * 10) |> ARRAY());
            show_list("array-list", array |> map(x => x * 10) |> LIST());
            show("list", list |> map(x => x + 1) |> ARRAY());
            show_list("list-list", list |> map(x => x + 1) |> LIST());
            show("range", (0..5) |> map(x => x * x) |> ARRAY());
            show("inclusive", (1::5) |> map(x => x) |> ARRAY());
            show("empty-range", (5..3) |> map(x => x) |> ARRAY());
            show_list("empty-range-list", (5..3) |> map(x => x) |> LIST());
            show("repeat-literal", repeat(9, 3) |> map(x => x) |> ARRAY());
            show("repeat-variable", repeat(4, n) |> map(x => x + 1) |> ARRAY());
            show("index", array |> index() |> map(iv => iv.index * 10 + iv.value) |> ARRAY());

            // stages that change the count keep the grown result
            show("filter", array |> filter(x => x % 2 == 0) |> ARRAY());
            show("take", (0..10) |> take(3) |> ARRAY());
            show("skip", (0..10) |> skip(8) |> ARRAY());
        si
    si
si
