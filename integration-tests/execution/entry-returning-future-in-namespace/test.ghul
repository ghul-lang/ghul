namespace App is
    use IO.Std.write_line
    use Concurrency

    // An entry in a namespace returning a Future, named through the
    // namespace's use, runs to completion with its ARRAY[string] of
    // arguments, and the int its task carries is the exit status.
    entry(args: ARRAY[string]) -> Future[int] is
        await Future.yield()

        write_line("arguments: {args.count}")

        return 3
    si
si
