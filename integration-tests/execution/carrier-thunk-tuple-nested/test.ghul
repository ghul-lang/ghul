use IO.Std.write_line

get(present: bool) -> int? => if present then 5 else null fi

combine(pair: (int?, int)) -> int => (pair.`0 ?? 0) + pair.`1

apply_pair[T, U](f: ((T?, T)) -> U, a: T?, b: T) -> U => f((a, b))

write_line("{apply_pair(combine, get(true), 2)}")
write_line("{apply_pair(combine, get(false), 2)}")
