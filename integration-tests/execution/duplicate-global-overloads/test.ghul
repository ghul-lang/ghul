namespace Left is
    pick[T](x: T) -> int => 1
    plain(x: int) -> int => 1
    shown(x: int) -> int => 1
    named(x: int) -> int => 1
si

namespace Right is
    pick[V](y: V) -> int => 2
    plain(y: int) -> int => 2
    shown(y: int) -> int => 2
    other(s: string) -> int => 2
    named(y: int) -> int => 2
si

namespace Test is
    use IO.Std.write_line
    use Right
    use Right.pick
    use Left.pick
    use Left.plain
    use Right.plain
    use Left.named

    // Tests: global functions taking the same arguments, brought together
    // by `use` from different namespaces, are one overload group. A call
    // either could take calls the one found first in scope order, with a
    // warning: a function declared in the calling namespace, then one
    // imported by name, then one from a namespace imported whole, and
    // among imports of one kind the earlier `use` line.

    shown(z: int) -> int => 3

    other(n: int) -> int => 3

    entry() is
        write_line("{pick(5)}")
        write_line("{plain(5)}")
        write_line("{shown(5)}")
        write_line("{named(5)}")
        write_line("{other(5)} {other("five")}")
    si
si
