use IO.Std.write_line

class NOTED(name: string): Ghul.Disposable is
    count: int => name.length

    dispose() is
        write_line("  dispose {name}")
    si
si

add(a: int, b: int) -> int => a + b

// A protected region can only be entered with nothing on the evaluation
// stack, and each of these opens one while an earlier argument is
// already there.
try_in_an_argument() -> int =>
    add(1, (try return 5 catch e: System.Exception return 0 yrt))

let_use_in_an_arm(flag: bool) -> int =>
    add(1, if flag then let use n = NOTED("arm"); n.count else 0 fi)

try_in_a_string_hole() -> string =>
    "{1} and {(try return 2 catch e: System.Exception return 0 yrt)}"

write_line("try in an argument: {try_in_an_argument()}")
write_line("let use in an arm: {let_use_in_an_arm(true)}")
write_line("try in a string hole: {try_in_a_string_hole()}")
