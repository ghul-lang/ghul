namespace Test is
    use IO.Std.write_line;

    // Tests: a string a foreign function hands over is released with the
    // function the declaration names, not the C library's free. fixture.ll
    // counts the calls to its own deallocator.

    @extern("", "fx_make", result = "take", free = "fx_release")
    make() -> string?;

    @extern("", "fx_released")
    released() -> int;

    entry() is
        write_line("{make() ?? "absent"}, released {released()}");
        write_line("{make() ?? "absent"}, released {released()}");
    si
si
