namespace Test is
    use Std = IO.Std;

    // ARRAY[E] is the array and E[] the list it implements: an array
    // passes wherever a list is expected, the entry point's arguments
    // can be declared either way, and an ARRAY[string] is a .NET string[].
    class MAIN is
        as_list(items: ARRAY[int]) -> int[] static => items;
        counted(items: int[]) -> int static => items.count;

        joined(parts: ARRAY[string]) -> string static => string.join(",", parts);

        entry(arguments: ARRAY[string]) static is
            let items: ARRAY[int] = [1, 2, 3];

            Std.write_line("{as_list(items).count} {counted(items)}");
            Std.write_line(joined(["a", "b", "c"]));
            Std.write_line("{arguments.count}");
        si
    si
si
