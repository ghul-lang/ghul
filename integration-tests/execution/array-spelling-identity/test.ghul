namespace Test is
    use Std = IO.Std;

    // ARRAY[E] is a spelling of E[]: the same type for checking, and the
    // same type when emitted, so the entry point's arguments can be
    // written either way and an ARRAY[string] is a .NET string[].
    class MAIN is
        as_written(items: ARRAY[int]) -> int[] static => items;
        as_named(items: int[]) -> ARRAY[int] static => items;

        joined(parts: ARRAY[string]) -> string static => string.join(",", parts);

        entry(arguments: ARRAY[string]) static is
            let items: ARRAY[int] = [1, 2, 3];

            Std.write_line("{as_written(items).count} {as_named(items).count}");
            Std.write_line(joined(["a", "b", "c"]));
            Std.write_line("{arguments.count}");
        si
    si
si
