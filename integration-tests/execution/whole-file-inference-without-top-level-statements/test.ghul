use default

// No top-level statements: the functions written with no types have their
// signatures inferred from the file, and call each other in any order.

entry() is
    write_line("{twice(21)} {is_even(10)} {Counter().value} {fact(5)}")
    write_line(squares(4) |> join())
    write_line("{check("abc", score)}")
    write_line("{total([1, 2])} {total(ARRAY([3, 4]))}")
si

twice(x) => x * 2

is_even(n) => if n == 0 then true else is_odd(n - 1) fi

is_odd(n) => if n == 0 then false else is_even(n - 1) fi

fact(n) => if n <= 1 then 1 else n * fact(n - 1) fi

score(word) => word.length * 2

check(text: string, f: string -> int) -> int => f(text)

squares(n) is
    for i in 1::n do
        yield i * i
    od
si

total(xs) => xs |> sum()

class Counter is
    value: int public

    init() is
        value = twice(5)
    si
si
