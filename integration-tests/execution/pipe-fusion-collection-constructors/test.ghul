@@suppress("deprecated")

use IO.Std.write_line
use Collections
use Ghul.Pipes

// A chain that ends in a collection constructor fuses as the matching
// collect does, and builds the same collection: an array, a list or a set,
// written with `|>` or as a call, over a list and a range, under map,
// filter, take and index stages, and over an empty source.

show(name: string, xs: Iterable[int]) =>
    write_line("{name}: [{xs |> map(x => "{x}") |> join(",")}]")

let ns = LIST[int]([1, 2, 3, 4, 5, 6])

let array: ARRAY[int] = ns |> map(n => n * 10) |> ARRAY()
show("array", array)
write_line("array count={array.count} first={array[0]}")

show("array-call", ARRAY(ns |> filter(n => n % 2 == 0)))
show("array-range", (10..14) |> map(n => n * 2) |> ARRAY())
show("array-empty", LIST[int]() |> map(n => n) |> ARRAY())

let list: LIST[int] = ns |> map(n => n + 1) |> filter(n => n > 3) |> LIST()
list.add(100)
show("list", list)

show("list-call", LIST(ns |> take(2)))
show("list-index", ns |> index() |> map(iv => iv.index * 100 + iv.value) |> LIST())

let set: SET[int] = ns |> map(n => n % 3) |> SET()
write_line("set count={set.count} has0={set.contains(0)} has2={set.contains(2)} has3={set.contains(3)}")

let set_call = SET(ns |> skip(4))
write_line("set-call count={set_call.count} has5={set_call.contains(5)}")

write_line("same as collect: {(ns |> map(n => n * 10) |> collect()) |> join(",")} {(ns |> map(n => n + 1) |> filter(n => n > 3) |> collect_mutable()) |> join(",")}")
