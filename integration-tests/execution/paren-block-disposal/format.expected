use IO.Std.write_line
use Ghul.Pipes

class NOTED(name: string): Ghul.Disposable is
    count: int => name.length

    dispose() is
        write_line("  dispose {name}")
    si
si

open(name: string) -> NOTED is
    write_line("  open {name}")
    return NOTED(name)
si

add(a: int, b: int) -> int => a + b

class HOLDER is
    value: int public

    init() is si
si

as_a_field_store() is
    write_line("let use in a block stored to a field:")
    let holder = HOLDER()
    holder.value = (
        let use f = open("field")
        f.count
    )
    write_line("  got {holder.value}")
    let slots = Collections.LIST[int]([0])
    slots[0] = (
        let use g = open("index")
        g.count
    )
    write_line("  got {slots[0]}")
si

as_an_initializer() is
    write_line("let use in a block as an initializer:")
    let n = (
        let use f = open("init")
        f.count
    )
    write_line("  got {n}")
si

as_an_argument() is
    write_line("let use in a block as an argument:")
    let n = add(
        1,
        (
            let use f = open("arg")
            f.count
        )
    )
    write_line("  got {n}")
si

use_inside_a_block() is
    write_line("use inside a block:")
    let n = ((use open("inner")).count + 1)
    write_line("  got {n}")
si

block_value_is_a_use() is
    write_line("a block whose value is a use:")
    let r = (
        write_line("  before")
        use open("tail")
    )
    write_line("  got {r.name}, already disposed")
si

early_return(flag: bool) -> int => (
    let use f = open("early")
    if flag then
        return 100
    fi
    f.count
)

generator() -> Pipe[int] is
    let n = (
        let use f = open("generator")
        f.count
    )
    yield n
    let m = if n > 0 then
        (
            let use g = open("arm")
            g.count
        )
    else
        0
    fi
    yield m
si

async_body() -> Tasks.TASK[int] is
    await Tasks.TASK.`yield()
    let n = (
        let use f = open("async")
        f.count
    )
    return n
si

as_an_initializer()
as_an_argument()
as_a_field_store()
use_inside_a_block()
block_value_is_a_use()
write_line("early return: {early_return(true)} then {early_return(false)}")
write_line("generator:")
for g in generator() do
    write_line("  yielded {g}")
od
write_line("async: {async_body().result}")
