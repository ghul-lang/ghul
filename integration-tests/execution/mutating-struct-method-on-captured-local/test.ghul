// A method that changes a struct, called on a mutable local that a closure
// captures, changes the value the closure reads.
use IO.Std.write_line

struct COUNTER is
    count: int field

    init(count: int) is
        self.count = count
    si

    step() is
        count = count + 1
    si
si

called_in_the_defining_function() is
    let c mut = COUNTER(1)
    let read = () => c.count
    c.step()
    write_line("in the defining function: {c.count} {read()}")
si

called_in_the_closure() is
    let c mut = COUNTER(1)
    let step = () => c.step()
    step()
    step()
    write_line("in the closure: {c.count}")
si

called_in_the_defining_function()
called_in_the_closure()
