use IO.Std.write_line

let scale = 10
let offset mut = 1

// scale is read as it was when the comprehension was evaluated, offset as
// it is when the pipe is read
let scaled = {x * scale + offset for x in 1::3}

write_line("first read: {scaled}")

offset = 2

write_line("second read: {scaled}")

// each evaluation makes a new pipe
let counts mut = 0

let fresh = () => {x for x in 1::2 if (counts = counts + 1; true)}

write_line("fresh: {fresh()} {fresh()}")
write_line("conditions evaluated: {counts}")
