use IO.Std.write_line

// An int argument widens to a long, single or double parameter, through
// a function, a constructor and a method.
half(x: double) -> double => x / 2.0

scaled(x: long, factor: double) -> double => double(x) * factor

class Box(value: double public);

let i = 3
let values = Collections.LIST[double]()
values.add(i)

write_line("{half(i)} {scaled(i, 1.5)} {Box(i).value} {values[0] / 2.0}")
