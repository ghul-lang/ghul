use IO.Std.write_line

f(a: int, b: int) -> int => a + b
g(a: int, b: int, c: int) -> int => a * 100 + b * 10 + c

class Box(value: int public) is
    add(n: int) -> int => value + n
si

returns(c: bool) -> int is
    return f(1, if c then return 99 else 2 fi)
si

returns_nothing(c: bool) is
    write_line("returns nothing {f(1, if c then return else 2 fi)}")
si

nested(c: bool) -> int =>
    g(1, f(2, if c then return -7 else 3 fi), 4)

through_receiver(c: bool) -> int is
    let box = Box(10)
    box.add(if c then return 55 else 1 fi)
si

interpolated(c: bool) -> string is
    "a {1} b {if c then return "early" else 2 fi} c"
si

breaks(c: bool) -> int is
    let total mut = 0

    for i in 0..3 do
        total = total + f(1, (if c /\ i == 1 then break fi; 2))
    od

    total
si

continues(c: bool) -> int is
    let total mut = 0

    for i in 0..3 do
        total = total + f(1, (if c /\ i == 1 then continue fi; 2))
    od

    total
si

breaks_with_value(c: bool) -> int? is
    let found = for i in 0..3 do
        let _ = f(i, (if c /\ i == 1 then break i * 10 fi; 2))
    od

    found
si

loop_value_as_argument(c: bool) -> int =>
    f(9, (for i in 0..5 do
        let _ = g(1, i, (if c /\ i == 2 then break i * 1000 fi; 3))
    od) ?? -1)

returns_from_block(c: bool) -> int =>
    g(1, 2, (f(1, if c then return 40 else 2 fi)))

returns_from_paren_block(c: bool) -> int =>
    g(1, 2, (let one = 1; f(one, if c then return 40 else 2 fi)))

generator(c: bool) -> int{} is
    yield 1
    yield f(2, if c then return else 3 fi)
    yield 9
si

async_returns(c: bool) -> Concurrency.Future[int] is
    let a = await Concurrency.Future.from_result(1)

    return f(a, if c then return 70 else 2 fi)
si

returns_from_catch(c: bool) -> int is
    try
        throw Ghul.Exception("thrown")
    catch e: Ghul.Exception
        return f(1, if c then return 31 else 2 fi)
    yrt
si

entry() is
    write_line("returns {returns(true)} {returns(false)}")
    returns_nothing(true)
    returns_nothing(false)
    write_line("nested {nested(true)} {nested(false)}")
    write_line("through receiver {through_receiver(true)} {through_receiver(false)}")
    write_line("interpolated {interpolated(true)} / {interpolated(false)}")
    write_line("breaks {breaks(true)} {breaks(false)}")
    write_line("continues {continues(true)} {continues(false)}")
    write_line("breaks with value {breaks_with_value(true)} {breaks_with_value(false)}")
    write_line("loop value as argument {loop_value_as_argument(true)} {loop_value_as_argument(false)}")
    write_line("returns from block {returns_from_block(true)} {returns_from_block(false)}")
    write_line("returns from paren block {returns_from_paren_block(true)} {returns_from_paren_block(false)}")
    write_line("generator {generator(true) |> Ghul.Pipes.list()} {generator(false) |> Ghul.Pipes.list()}")
    write_line("async {async_returns(true).result} {async_returns(false).result}")
    write_line("returns from catch {returns_from_catch(true)} {returns_from_catch(false)}")
si
