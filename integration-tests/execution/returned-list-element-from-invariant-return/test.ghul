use default

// The element of a returned `LIST()` is the return type's element when the
// list is returned through a slot that cannot vary: a list of `int` is not
// a list of `int?`, so this list is built as `LIST[int?]`.
maybe_ones(n: int) -> int?[] is
    let result = LIST()

    for i in 0..n do
        result.add(1)
    od

    result
si

// A reference-typed element converts by covariance, so the element keeps
// the type of what is added.
labels() -> string?[] is
    let result = LIST()
    result.add("x")
    result
si

// Where nothing else constrains the element, the return type alone does.
nothing() -> int?[] is
    let result = LIST()
    return result
si

let ones = maybe_ones(3)
write_line("{ones.count} {ones[0]}")
write_line("{labels().count} {labels()[0]}")
write_line("{nothing().count}")
