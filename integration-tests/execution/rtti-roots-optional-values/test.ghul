use IO.Std.write_line

struct Point(x: int public, y: int public)

// Value-type optionals held by a reflected type: each is decoded through the
// carrier its optional is, which nothing marks @reflected().
@reflected()
class Request(path: string public, line: int? public, point: Point? public, columns: Collections.LIST[int?] public)

// Written to JSON and read back, as the analysis protocol's requests are.
round_trip(request: Request) is
    let text = Json.write(Json.to_json(request))

    if let decoded: Request = Json.from_json(Json.parse(text), typeof Request) then
        write_line("{decoded.path} {decoded.line} {decoded.point?.x} {decoded.columns.count} {decoded.columns[0]}")
    fi
si

let present = Collections.LIST[int?]()
present.add(4)
present.add(null)

let absent = Collections.LIST[int?]()
absent.add(null)

round_trip(Request("a", 3, Point(1, 2), present))
round_trip(Request("b", null, null, absent))
