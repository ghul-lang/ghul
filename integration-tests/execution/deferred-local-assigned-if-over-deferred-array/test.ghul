use default

// A deferred-init local assigned an if expression whose arms are another
// deferred-init array local, directly or through a generic pipe over it,
// takes that local's element type rather than the pipe's unbound `T[]`.
through_if_arms(c: bool) is
    let a mut
    a = ["x", "y"]
    let v mut
    v = if c then a else (if c then (a |> map(s => s) |> collect()) else a fi) fi
    write_line("through if arms {a |> join(",")} {v |> join(",")}")
si

through_pipe_arm(c: bool) is
    let a mut
    a = [1, 2, 3]
    let v mut
    v = if c then (a |> map(n => n * 10) |> collect()) else a fi
    write_line("through pipe arm {v |> join(",")}")
si

through_if_arms(true)
through_if_arms(false)
through_pipe_arm(true)
through_pipe_arm(false)
