use IO.Std.write_line

use System.IFormattable

class TEMPERATURE: IFormattable is
    _celsius: int

    init(celsius: int) is
        _celsius = celsius
    si

    to_string() -> string => "{_celsius}C"

    to_string(format: string?, format_provider: Ghul.FormatProvider?) -> string =>
        if format =~ "F" then "{_celsius * 9 / 5 + 32}F" else to_string() fi
si

class LABEL is
    _text: string

    init(text: string) is
        _text = text
    si

    to_string() -> string => _text

    to_string(format: string) -> string => "{format}:{_text}"
si

entry() is
    let date = System.DateTime(2026, 9, 25, 13, 4, 5)

    write_line("{date:yyyy-MM-dd} {date:HH:mm} {date:yyyy-MM-dd HH:mm:ss.fff}")
    write_line("{TEMPERATURE(100):F} {TEMPERATURE(100):C} {TEMPERATURE(100)}")
    write_line("{LABEL("plain"):X}")
si
