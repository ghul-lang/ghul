namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;

    class BOX[T] is
        value: T;

        init(value: T) is
            self.value = value;
        si

        // A generic instance generator: its frame carries the class's
        // type parameter and the outer self, both of which a fresh
        // read has to carry over.
        repeated(times: int mut) -> Pipe[T] is
            while times > 0 do
                yield value;
                times = times - 1;
            od
        si
    si

    class Main is
        countdown(n: int mut) -> Pipe[int] static is
            while n > 0 do
                yield n;
                n = n - 1;
            od
        si

        // Ends its stream with a bare return rather than by falling off
        // the end, so a fresh read has to start over after that path too.
        until_zero(n: int mut) -> Pipe[int] static is
            while true do
                yield n;
                n = n - 1;

                if n == 0 then
                    return;
                fi
            od
        si

        // Ends by a bare return from inside a try: the finally on the
        // way out still sees the read's locals, and the next read starts
        // over.
        guarded(limit: int) -> Pipe[int] static is
            let i mut = 0;

            try
                while true do
                    i = i + 1;
                    yield i;

                    if i == limit then
                        return;
                    fi
                od
            finally
                Std.write_line("finally saw {i}");
            yrt
        si

        entry() static is
            let pipe = countdown(3);

            // Every read starts from the beginning: a loop that stops
            // part way leaves nothing behind for the next loop, and a
            // loop after one that ran to the end sees everything again.
            for n in pipe do
                Std.write_line("first: {n}");
                break;
            od

            for n in pipe do
                Std.write_line("rest: {n}");
            od

            for n in pipe do
                Std.write_line("again: {n}");
            od

            // reset() has no effect: a read that wants to start over
            // takes a fresh iterator.
            for n in pipe do
                Std.write_line("before reset: {n}");
                break;
            od

            pipe.reset();

            Std.write_line("after reset: {pipe |> join(" ")}");

            let returned = until_zero(2);

            Std.write_line("returned: {returned |> join(" ")}");
            Std.write_line("returned again: {returned |> join(" ")}");

            let guarded_pipe = guarded(2);

            Std.write_line("guarded: {guarded_pipe |> join(" ")}");
            Std.write_line("guarded again: {guarded_pipe |> join(" ")}");

            let box = BOX[string]("x");
            let xs = box.repeated(2);

            Std.write_line("generic: {xs |> join(" ")}");
            Std.write_line("generic again: {xs |> join(" ")}");
        si
    si
si
