use default

// A ref to an array element is the element's own address, so a write
// through it lands in the array, as a write through a ref to a field or
// a local does.

bump(slot: int ref) is
    slot! = slot! + 1
si

struct POINT(x: int)

shift(p: POINT ref) is
    p! = POINT(p!.x + 10)
si

entry() is
    let raw = [10, 20]
    bump(raw[1] ref)
    write_line("int element {raw[1]}")

    let names = ["a", "b"]
    let name = names[0] ref
    name! = "z"
    write_line("string element {names[0]}")

    System.Threading.Volatile.write(raw[0] ref, 5)
    write_line("volatile {System.Threading.Volatile.read(raw[0] ref)} {raw[0]}")

    let points = [POINT(1), POINT(2)]
    shift(points[1] ref)
    write_line("struct element {points[1].x}")

    let grid = [[1, 2], [3, 4]]
    bump(grid[1][0] ref)
    write_line("nested element {grid[1][0]}")
si
