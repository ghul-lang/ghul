namespace Probe is
    use IO.Std.write_line
    class Helper is
        value: int public

        init(value: int) is
            self.value = value
        si
    si

    class Arithmetic is
        _base: int
        _helper: Helper

        init() is
            _base = 40
            _helper = Helper(2)
        si

        @test()
        adds() is
            write_line("adds: {_base + _helper.value}")
        si

        @test()
        _privately() is
            write_line("privately")
        si

        @test()
        counts() static is
            write_line("counts statically")
        si

        not_a_test() is
            write_line("never")
        si
    si

    @test()
    global_check() is
        write_line("global check")
    si

    helper() -> int => 3
si

namespace Runner is
    use IO.Std.write_line

    use Ghul.Reflection.Assembly
    use Ghul.Reflection.BindingFlags

    entry() is
        let empty: ARRAY[object?] = []
        let flags = BindingFlags.PUBLIC | BindingFlags.NON_PUBLIC | BindingFlags.INSTANCE | BindingFlags.STATIC | BindingFlags.DECLARED_ONLY

        for type in Assembly.get_entry_assembly().get_types() do
            write_line("type {type.full_name}")

            for method in type.get_methods(flags) do
                if method.is_defined(typeof Ghul.TEST_ATTRIBUTE, false) then
                    let instance =
                        if method.is_static then null else Ghul.Reflection.Activator.create_instance(type, empty) fi

                    write_line("  {method.name} static={method.is_static} public={method.is_public}")
                    method.invoke(instance, empty)
                fi
            od
        od

        // A class described only for its tests reaches no other type.
        try
            let fields = (typeof Probe.Helper).get_fields()
            write_line("Helper described: {fields.count}")
        catch ex: Ghul.NotSupportedException
            write_line("Helper not described")
        yrt
    si
si
