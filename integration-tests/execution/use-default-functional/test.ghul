// `use default` imports `Ghul.Functional` along with the rest of the set.
// The namespace is declared here, so the test doesn't depend on which
// runtime defines it.
namespace Ghul.Functional is
    twice[T](f: T -> T) -> T -> T => x => f(f(x))
si

namespace Test is
    use default

    entry() is
        let add_three = (x: int) => x + 3
        write_line("{twice(add_three)(1)}")
    si
si
