// A host maths intrinsic declared as a namespace-scope free function, the
// shape the core library declares them in, called on every target both
// qualified and as a bare name the namespace's import brings in.
namespace Probe.Math is
    @intrinsic("host.math_sqrt")
    root(value: double) -> double pure

    @intrinsic("host.math_floor")
    round_down(value: double) -> double pure

    @intrinsic("host.math_pow")
    power(x: double, y: double) -> double pure
si

namespace Test is
    use IO.Std.write_line
    use Probe.Math

    entry() is
        write_line("{root(16.0)} {round_down(2.7)} {power(2.0, 10.0)}")
        write_line("{Probe.Math.root(9.0)} {Probe.Math.round_down(-1.5)} {Probe.Math.power(3.0, 2.0)}")
    si
si
