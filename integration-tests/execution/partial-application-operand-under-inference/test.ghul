// `* =~ w` where the other operand's type is still being inferred: `w`
// is a parameter of an enclosing function literal typed from its use.
// The `*` is settled by the context's parameter type; the formal a
// candidate pushes onto it while `w` is unsettled bounds it from above
// and does not widen it.

use default

entry() is
    let colours = ["red", "yellow", "green", "blue"]
    let words = "play red now".split([' '])

    let chosen = words |> filter(w => colours |> any(* =~ w)) |> first()
    write_line(chosen)

    let targets = ["b", "c"]
    let moves = [(from = "a", to = "b"), (from = "b", to = "x"), (from = "c", to = "c")]
    let blocking = moves |> filter(m => targets |> any(* =~ m.to)) |> collect()
    write_line(blocking.count)

    let numbers = [1, 2, 3]
    let wanted = [2, 3, 4]
    write_line(wanted |> filter(w => numbers |> any(* == w)) |> count())
si
