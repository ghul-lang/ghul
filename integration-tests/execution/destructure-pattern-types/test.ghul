use default

trait Named is
    name: string;
si

class Cat(name: string public): Named is si

// the pattern left of the colon, the parameter's type on the right
canonical((a, b): (int, int)) -> int => a * b

// element types alone: the parameter's type is their tuple
shorthand((a: int, b: string)) -> string => "{b}{a}"

nested(((a: int, b: int), c: long)) -> long => a + b + c

let lam_canonical = ((a, b): (int, int)) => a - b
let lam_shorthand = ((a: int, b: string)) => "{b}{a}"
let lam_partial = ((a: int, b)) => a + b

// a let leaf's type is checked as a typed local's is: a number widens
let (wide: long, same: int) = (3, 4)
let (ratio: double, _) = (3, 4)
let (named: Named, count: int) = (Cat("tom"), 1)
let (p, q): (int, int) = (5, 6)

write_line("{canonical((3, 4))} {shorthand((1, "n"))} {nested(((1, 2), 3L))}")
write_line("{lam_canonical((5, 1))} {lam_shorthand((2, "m"))} {lam_partial((1, 2))}")
write_line("{wide * 10000000000L} {same} {ratio / 2.0} {named.name} {count} {p + q}")
