use default
use Ghul.apply

// A call through a local whose type is still being inferred records the
// argument types as a constraint on the local. An argument typed over
// another call's unbound type parameter - the T[] a collect[T] still
// resolving reports - is no shape the local could be asked to accept, and
// recorded as one it never discharges once the local settles.
let add = (a, b) => a + b

let count mut
count = xs => xs.count

write_line("{count([1, 2] |> map(y => apply(add, y, 6)) |> collect())}")

let sum mut
sum = xs => xs |> reduce(0, (acc, x) => acc + x)

write_line("{sum([1, 2, 3] |> map(y => apply(add, y, 10)) |> collect())}")
