use IO.Std.write_line

struct POINT is
    x: int public
    y: int public

    init() is si
si

class LINE is
    from: POINT public
    to: POINT public

    init() is si
si

entry() is
    let point = typeof POINT
    let flags = System.Reflection.BindingFlags.PUBLIC | System.Reflection.BindingFlags.NON_PUBLIC | System.Reflection.BindingFlags.INSTANCE

    // A property set through reflection changes the boxed struct it is
    // called on, as a field set does.
    let boxed = System.Activator.create_instance(point)!

    point.get_property("x")!.set_value(boxed, 3)
    for f in point.get_fields(flags) do
        if f.name.ends_with("y") then
            f.set_value(boxed, 4)
        fi
    od

    write_line("set on the box: {point.get_property("x")!.get_value(boxed)} {point.get_property("y")!.get_value(boxed)}")

    let unboxed = cast POINT(boxed)

    write_line("read back unboxed: {unboxed.x} {unboxed.y}")

    // Json fills a struct it makes the same way, held as an object...
    let made = Json.from_json(Json.parse("{{\"x\": 5, \"y\": 6}}"), point)!

    write_line("a struct from json: {cast POINT(made).x} {cast POINT(made).y}")

    // ...and as the struct-typed member of a class.
    let line = cast LINE?(Json.from_json(Json.parse("{{\"from\": {{\"x\": 1, \"y\": 2}}, \"to\": {{\"x\": 7, \"y\": 8}}}}"), typeof LINE))!

    write_line("struct members from json: {line.from.x} {line.from.y} {line.to.x} {line.to.y}")
si
