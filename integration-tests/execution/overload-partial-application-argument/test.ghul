use default

// A partial application passed to a call whose overloads tie: on wasm and
// llvm, sum_by has a generic overload beside a decimal one, and pow is
// overloaded too. Which pow the application calls follows from what its `*`
// is given, which is sum_by's to give, so sum_by does not wait on it.

power_sum(xs: double[], k: int) -> double => xs |> sum_by(pow(*, cast(k)))

write_line("{power_sum([1.0, 2.0, 3.0], 2)}")
