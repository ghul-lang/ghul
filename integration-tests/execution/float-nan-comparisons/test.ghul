namespace Test is
    use IO.Std.write_line

    double_zero() -> double => 0.0

    single_zero() -> single => 0.0s

    truth(condition: bool) -> string => if condition then "T" else "F" fi

    doubles(label: string, a: double, b: double) is
        // each comparison as a value
        let values = "{truth(a < b)}{truth(a <= b)}{truth(a > b)}{truth(a >= b)}{truth(a == b)}{truth(a != b)}"

        // and as a condition
        let lt = if a < b then "T" else "F" fi
        let le = if a <= b then "T" else "F" fi
        let gt = if a > b then "T" else "F" fi
        let ge = if a >= b then "T" else "F" fi
        let eq = if a == b then "T" else "F" fi
        let ne = if a != b then "T" else "F" fi

        // and negated, which must not turn into the opposite comparison
        let negated = "{truth(!(a < b))}{truth(!(a <= b))}{truth(!(a > b))}{truth(!(a >= b))}"

        write_line("double {label}: < <= > >= == != values {values} conditions {lt}{le}{gt}{ge}{eq}{ne} negated {negated}")
    si

    singles(label: string, a: single, b: single) is
        let values = "{truth(a < b)}{truth(a <= b)}{truth(a > b)}{truth(a >= b)}{truth(a == b)}{truth(a != b)}"

        let lt = if a < b then "T" else "F" fi
        let le = if a <= b then "T" else "F" fi
        let gt = if a > b then "T" else "F" fi
        let ge = if a >= b then "T" else "F" fi
        let eq = if a == b then "T" else "F" fi
        let ne = if a != b then "T" else "F" fi

        let negated = "{truth(!(a < b))}{truth(!(a <= b))}{truth(!(a > b))}{truth(!(a >= b))}"

        write_line("single {label}: < <= > >= == != values {values} conditions {lt}{le}{gt}{ge}{eq}{ne} negated {negated}")
    si

    entry() is
        let nan = double_zero() / double_zero()

        doubles("1 ? 2", 1.0, 2.0)
        doubles("2 ? 2", 2.0, 2.0)
        doubles("nan ? 1", nan, 1.0)
        doubles("1 ? nan", 1.0, nan)
        doubles("nan ? nan", nan, nan)

        let single_nan = single_zero() / single_zero()

        singles("1 ? 2", 1.0s, 2.0s)
        singles("2 ? 2", 2.0s, 2.0s)
        singles("nan ? 1", single_nan, 1.0s)
        singles("1 ? nan", 1.0s, single_nan)
        singles("nan ? nan", single_nan, single_nan)

        // a while condition and a loop bound
        let count mut = 0

        while count < 3 /\ !(nan >= 0.0) do
            count = count + 1
        od

        write_line("loop ran {count} times")
    si
si
