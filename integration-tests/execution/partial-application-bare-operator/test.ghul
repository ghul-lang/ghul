use default

apply(f: (int) -> int, x: int) -> int => f(x)

// a bare operator applied to `*` takes its type from the function type
// the partial application is expected to be
let product = [2, 3, 4] |> reduce(1, `*(*, *))
write_line("product: {product}")

let times: (int, int) -> int = `*(*, *)
write_line("times: {times(6, 7)}")

let from_ten: (int) -> int = `-(10, *)
write_line("from ten: {from_ten(3)}")

let incremented = [1, 2, 3] |> map(`+(*, 1)) |> collect()
write_line("incremented: {$(incremented)}")

let halves = [1.0, 3.0] |> map(`/(*, 2.0)) |> collect()
write_line("halves: {$(halves)}")

write_line("applied: {apply(`*(*, 3), 5)}")

// called directly, a bare operator is the operator of its first
// argument's type, with or without a return type from the context
write_line("called: {`*(2, 3)} {`=~("x", "x")} {`<>(1, 2)} {`+(1.5, 2.0)}")
