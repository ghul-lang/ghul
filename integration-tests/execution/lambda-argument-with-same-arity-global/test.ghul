namespace Test is
    use IO.Std.write_line
    use Parts.walk
    use Parts.tag

    class WALKER is
        walk(bytes: int[], seen: (string, int, int) -> void) static is
            seen("member", 0, bytes.count)
        si

        tag(item: string, label: string, done: (string, int) -> void) static is
            done("{item} {label}", item.length)
        si

        run(bytes: int[]) static is
            walk(bytes, (kind, from, to) is
                write_line("{kind} {from} {to}")
            si)

            walk("text", 2)

            tag("abc", "x", (text, length) is
                write_line("member tag {text} {length}")
            si)

            tag("abc", 3, (item) is
                write_line("global tag {item}")
            si)
        si
    si

    entry() is
        WALKER.run([1, 2, 3])
    si
si

namespace Parts is
    use IO.Std.write_line

    walk(text: string, size: int) is
        write_line("global {text} {size}")
    si

    tag[T](item: T, size: int, done: (T) -> void) is
        done(item)
    si
si
