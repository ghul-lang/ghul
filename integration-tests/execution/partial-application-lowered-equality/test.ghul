// `* =~ x` where the equality is not an operator call but a lowering:
// tuples and bare type parameters through the runtime's comparer,
// sequences element by element. The written-out operand is fixed into
// the thunk and the lowering is built over it.

use default

use Move = (from: int, to: int)
use Die = List[int]

struct POINT(x: int public, y: int public);

both(f: ((int, int), (int, int)) -> bool, a: (int, int), b: (int, int)) -> bool => f(a, b)

legal_move(legal: List[Move], move: Move) -> bool =>
    legal |> any(* =~ move)

fresh(chain: List[Die], die: Die) -> bool =>
    !(chain |> any(* =~ die))

entry() is
    let pairs = [(1, 2), (3, 4)]
    let one = (3, 4)

    write_line(pairs |> any(* =~ one))
    write_line(pairs |> any(one =~ *))
    write_line(pairs |> filter(* !~ one) |> count())
    write_line(both(* =~ *, (1, 2), (1, 2)))
    write_line(both(* =~ *, (1, 2), (2, 1)))

    let moves = [(from = 1, to = 2), (from = 3, to = 4)]
    write_line(legal_move(moves, (from = 3, to = 4)))
    write_line(legal_move(moves, (from = 4, to = 3)))

    let nested = [((1, 2), "a"), ((3, 4), "b")]
    write_line(nested |> any(* =~ ((3, 4), "b")))

    let lists = [LIST[int]([1, 2]), LIST[int]([3])]
    write_line(lists |> filter(* =~ LIST[int]([3])) |> count())
    write_line(fresh([LIST[int]([1]), LIST[int]([2])], LIST[int]([2])))
    write_line(fresh([LIST[int]([1]), LIST[int]([2])], LIST[int]([3])))

    // a struct with a synthesised `=~` resolves an operator and is taken
    // apart as a call, as before
    write_line([POINT(1, 2), POINT(3, 4)] |> any(* =~ POINT(3, 4)))

    // the fixed operand is evaluated once, where the application is written
    let evaluations mut = 0
    let probe = () => (evaluations = evaluations + 1; (1, 2))
    let hits = pairs |> filter(* =~ probe()) |> count()
    write_line("{hits} {evaluations}")
si
