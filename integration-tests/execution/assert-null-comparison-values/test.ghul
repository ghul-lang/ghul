use IO.Std.write_line

// A comparison with a `null` literal reports the other side only: the
// literal has no value worth writing.
class Holder(n: int public)

find() -> Holder? => Holder(5)

let present = find()

try
    assert present == null
catch e: Ghul.AssertFailedException
    let text = e.message
    write_line(text.substring(text.index_of(": ") + 2))
yrt
