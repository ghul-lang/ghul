use default

// Tests: an index with several arguments, written inside the brackets of
// another index, inside a call's arguments or inside a generic
// application's value arguments, is an index. Type arguments written the
// same way inside a generic application stay type arguments.

class TABLE[K, V] is
    init() is si

    describe() -> string => "a table"
si

identity[T](value: T) -> T => value

none_of[T]() -> T[] => []

let names = ["zero", "one", "two"]
let m = from(0) |> MATRIX(2, 2)
let n = repeat(1) |> MATRIX(2, 2)
let y = 1
let x = 0

write_line(names[m[y, x]])
write_line(names[m[n[y, x], x]])
write_line(identity(m[y, x]))
write_line(identity[int](m[y, x]))
write_line("{names[m[y, x]]} {[m[0, 1], m[y, x]]}")

let boxes = LIST[MAP[string, int]]()
let table = TABLE[(int, int), string]()
let built = none_of[MAP[string, int]]()

write_line("{boxes.count} {table.describe()} {built.count}")
