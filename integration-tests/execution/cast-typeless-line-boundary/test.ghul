use IO.Std.write_line

// A line opening with `(` starts something new, so the cast ends at the
// line break and the group below is the block's own tail.
split_over_lines(n: int) -> (double, int) =>
    (let x = 1.0D + cast(n)
     (x, 1))

same_line(n: int) -> double => cast (double)(n)

called(handler: object, n: int) -> int => cast (handler)(n)

entry() is
    write_line("{split_over_lines(3)}")
    write_line("{same_line(7)}")
    write_line("{called(cast object((x: int) -> int => x * 2), 4)}")
si
