// A `use` in a `while` condition belongs to one iteration: each value is
// disposed at the end of its iteration, before the condition is evaluated
// again, and the last one when the loop is left, by a false condition, a
// `continue`, a `break`, a `return` or an exception.
use default

class SRC: Ghul.Disposable is
    _name: string
    _value: int

    init(name: string, value: int) is
        _name = name
        _value = value
        write_line("  open {name}")
    si

    value: int => _value

    dispose() is
        write_line("  dispose {_name}")
    si
si

to_the_end() is
    write_line("to the end:")

    let i mut = 0

    while (use SRC("c{i}", i)).value < 2 do
        write_line("  body {i}")
        i = i + 1
    od

    write_line("  after the loop")
si

with_continue() is
    write_line("with continue:")

    let i mut = 0

    while (use SRC("c{i}", i)).value < 3 do
        i = i + 1

        if i == 2 then
            continue
        fi

        write_line("  body {i}")
    od
si

with_break() is
    write_line("with break:")

    while (use SRC("b", 0)).value < 5 do
        write_line("  body")
        break
    od

    write_line("  after the loop")
si

with_return() -> int is
    write_line("with return:")

    while (use SRC("r", 7)).value > 0 do
        return 7
    od

    0
si

with_exception() is
    write_line("with an exception:")

    try
        while (use SRC("x", 1)).value > 0 do
            throw Ghul.Exception("stop")
        od
    catch e: Ghul.Exception
        write_line("  caught {e.message}")
    yrt
si

class END: Ghul.Disposable is
    init() is
        write_line("  open end")
    si

    dispose() is
        write_line("  dispose end")
    si
si

source(i: int) -> Ghul.Disposable => if i < 2 then SRC("l{i}", i) else END() fi

with_while_let() is
    write_line("while let:")

    let i mut = 0

    while let s: SRC = use source(i) do
        write_line("  body {s.value}")
        i = i + 1
    od

    write_line("  after the loop")
si

entry() is
    to_the_end()
    with_continue()
    with_break()
    write_line("  returned {with_return()}")
    with_exception()
    with_while_let()
si
