to the end:
  open c0
  body 0
  dispose c0
  open c1
  body 1
  dispose c1
  open c2
  dispose c2
  after the loop
with continue:
  open c0
  body 1
  dispose c0
  open c1
  dispose c1
  open c2
  body 3
  dispose c2
  open c3
  dispose c3
with break:
  open b
  body
  dispose b
  after the loop
with return:
  open r
  dispose r
  returned 7
with an exception:
  open x
  dispose x
  caught stop
while let:
  open l0
  body 0
  dispose l0
  open l1
  body 1
  dispose l1
  open end
  dispose end
  after the loop
