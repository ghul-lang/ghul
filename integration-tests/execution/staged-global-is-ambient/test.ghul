// A function with a body declared at namespace scope in
// `Ghul.Intrinsics.Staging` is reached with no `use`, as the runtime's
// intrinsic operators are, on every target.
namespace Ghul.Intrinsics.Staging is
    ⊛(a: int, b: int) -> int => Test.combine(a, b)

    staged_label(n: int) -> string => "staged {n}"
si

namespace Test is
    use IO.Std.write_line
    use Ghul.Pipes

    combine(a: int, b: int) -> int => a * 10 + b

    entry() is
        write_line("{4 ⊛ 2}")
        write_line(staged_label(7))
        write_line("{[1, 2, 3] |> map(* ⊛ 5) |> string(" ")}")
    si
si
