use IO.Std.write_line

// The locale members are invariant, current and current_ui.

let invariant: Text.Locale = Text.Locale.invariant
let current: Text.Locale = Text.Locale.current
let current_ui: Text.Locale = Text.Locale.current_ui

write_line("[{invariant.name}] {current_ui.name.length >= 0} {current.name.length >= 0}")
