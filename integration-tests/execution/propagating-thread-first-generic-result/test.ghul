namespace Test is
    use IO.Std.write_line

    twice(n: int) -> int => n * 2
    name(n: int) -> string => "n{n}"
    half(n: int) -> int? => if n % 2 == 0 then n / 2 else null fi

    class CELL[T](value: T) is si

    apply[T, U](x: T?, f: (T) -> U) -> U? => x ~> f()

    apply_class[T, U: class](x: T?, f: (T) -> U) -> U? => x ~> f()

    apply_struct[T, U: struct](x: T?, f: (T) -> U) -> U? => x ~> f()

    apply_optional[T, U: optional](x: T?, f: (T) -> U) -> U? => x ~> f()

    contents[T](cell: CELL[T]?) -> T? => cell?.value

    entry() is
        let present: int? = 8
        let absent: int? = null

        write_line("{apply(present, twice)}")
        write_line("{apply(absent, twice)}")
        write_line("{apply(present, name)}")
        write_line("{apply(absent, name)}")
        write_line("{apply(present, half)}")

        let result = apply("seven", (s: string) => s.length)
        write_line("{result ?? -1}")

        write_line("{apply_class(present, name)}")
        write_line("{apply_class(absent, name)}")
        write_line("{apply_struct(present, twice)}")
        write_line("{apply_struct(absent, twice)}")
        write_line("{apply_optional(present, half)}")
        write_line("{apply_optional(absent, half)}")

        write_line("{contents(CELL(5))}")
        let no_cell: CELL[int]? = null
        write_line("{contents(no_cell)}")
        write_line("{contents(CELL("text"))}")
    si
si
