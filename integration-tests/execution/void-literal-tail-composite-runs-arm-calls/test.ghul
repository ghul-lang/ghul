// A literal passed where `() -> void` is expected is walked first with its
// return inferred, which asks its tail for a value, and again once the slot
// settles the return as void. The call ending an arm of a tail if or case
// still runs.

use IO.Std.write_line

class Counter is
    count: int field public
    init() is si
si

bump(c: Counter) -> int is
    c.count = c.count + 1
    return c.count
si

run(action: () -> void) is
    action()
si

let a = Counter()
run(() is
    if a.count == 0 then
        bump(a)
    fi
si)
write_line("if: {a.count}")

let b = Counter()
run(() is
    if b.count == 1 then
        bump(b)
    else
        bump(b)
    fi
si)
write_line("if else: {b.count}")

let c = Counter()
run(() => if c.count == 0 then bump(c) fi)
write_line("expression body: {c.count}")

let d = Counter()
run(() is
    case d.count
    when 0 then bump(d)
    else bump(d)
    esac
si)
write_line("case: {d.count}")

let e = Counter()
let get: () -> int = () is if e.count == 0 then bump(e) else 7 fi si
write_line("value literal: {get()} {e.count}")
