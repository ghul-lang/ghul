namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A fused `index()` stage keeps a running counter and builds
    // INDEXED_VALUE(counter, element) per element, so the INDEX_PIPE object
    // is never allocated. It composes with map/filter in any position, over
    // both a value-type range source and a collection source, and under a
    // terminal consumer as well as a `for` loop. The counter starts at the
    // caller's start where one is given, and advances only for elements
    // that reach the stage, so `index()` after a `filter` numbers the
    // surviving elements 0, 1, 2, ...

    class Main is
        entry() static is
            let xs = LIST[string](["a", "b", "c"]);

            // collection source, destructured
            for (i, x) in xs |> index() do
                Std.write_line("idx {i}={x}");
            od

            // non-destructured: read the INDEXED_VALUE members
            for iv in xs |> index() do
                Std.write_line("iv {iv.index}:{iv.value}");
            od

            let ns = LIST[int]([1, 2, 3, 4, 5, 6]);

            // index() after filter numbers the surviving elements
            for (i, x) in ns |> filter(n => n % 2 == 0) |> index() do
                Std.write_line("even {i}->{x}");
            od

            // index() in the middle, then filter on the index
            for (i, x) in ns |> map(n => n * 10) |> index() |> filter(v => v.index % 2 == 0) do
                Std.write_line("mid {i}->{x}");
            od

            // value-type range source
            for (i, x) in (100..103) |> index() do
                Std.write_line("range {i}={x}");
            od

            // an explicit start, evaluated once into the counter
            let start = 10;

            for (i, x) in xs |> index(start) do
                Std.write_line("from {i}={x}");
            od

            // a terminal consumer fuses the index stage too
            Std.write_line("count {ns |> index() |> count()}");

            let labelled = xs |> index() |> map(v => "{v.index}:{v.value}") |> collect_mutable();

            Std.write_line("collect {labelled |> join(",")}");
        si
    si
si
