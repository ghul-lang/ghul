use default

// Each row is one line of the table however wide it is: the rows are what
// make a written-out table readable.
let permutation = [
    151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225,
    140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148
]

swap[T](x: T ref, y: T ref) is
    let t = x!
    x! = y!
    y! = t
si

let a mut = permutation[0]
let b mut = permutation[16]

swap(a ref, b ref)

write_line("{permutation.count} {a} {b}")
