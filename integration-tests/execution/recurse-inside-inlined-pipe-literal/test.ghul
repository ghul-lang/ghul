use default

// A literal that pipe fusion compiles inline calls the recursive literal
// it is written in, memoised or not.

let catalan = (n: int) -> long memo rec => (
    if n == 0 then return 1L fi;
    (0..n) |> sum_by(i => rec(i) * rec(n - 1 - i))
)

let plain = (n: int) -> long rec => (
    if n == 0 then return 1L fi;
    (0..n) |> sum_by(i => rec(i) * rec(n - 1 - i))
)

let total = (n: int) -> int memo rec => (
    if n == 0 then return 0 fi;
    (0..n) |> map(i => rec(i) + 1) |> sum()
)

_conv(n) memo is
    if n == 0 then
        return 1L
    fi

    return (0..n) |> sum_by(i => _conv(i) * _conv(n - 1 - i))
si

write_line("{catalan(10)} {plain(6)} {total(4)} {_conv(5)}")
