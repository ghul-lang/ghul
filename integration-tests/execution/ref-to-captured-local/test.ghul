// A `ref` argument naming a mutable local that a closure captures: the
// callee's write reaches the local and every closure that reads it, as it
// does for a local nothing captures.
use IO.Std.write_line
use Collections.MAP

bump(value: int ref) is
    value! = value! + 1
si

bump_and_get(value: int ref) -> int is
    value! = value! * 10
    return value! + 1
si

set_then_read(value: int ref, read: () -> int) -> int is
    value! = 5
    return read()
si

add_one_then_ten(first: int ref, second: int ref) is
    first! = first! + 1
    second! = second! + 10
si

onward(value: int ref) is
    bump(value)
si

bump_by(value: int ref, extra: int) is
    value! = value! + extra
si

bump_then_throw(value: int ref) is
    value! = value! + 1
    throw Ghul.Exception("after the write")
si

swap(left: int ref, right: int ref) is
    let held = left!
    left! = right!
    right! = held
si

// Written only through the `ref`.
written_only_by_ref() is
    let n mut = 1
    let read = () => n
    bump(n ref)
    write_line("only by ref: {n} {read()}")
si

// Also assigned directly, so the local lives in a box.
also_assigned() is
    let n mut = 0
    let read = () => n
    n = 1
    bump(n ref)
    write_line("also assigned: {n} {read()}")
si

// The call is made inside the closure that captures the local.
call_in_closure() is
    let n mut = 1
    let step = () => bump(n ref)
    step()
    step()
    write_line("in closure: {n}")
si

// The closure is made elsewhere and only reads the local.
closure_elsewhere() is
    let n mut = 5
    let read = make_reader(() => n)
    bump(n ref)
    write_line("closure elsewhere: {read()}")
si

make_reader(read: () -> int) -> () -> int => read

// try_get_value writes its out parameter through a `ref`.
try_get_value() is
    let found mut = 0
    let read = () => found
    let map = MAP[string, int]()
    map["a"] = 42
    let hit = map.try_get_value("a", found ref)
    write_line("try_get_value: {hit} {found} {read()}")
si

// Two `ref` arguments are written back in argument order, and a call's
// result is used after its write-back.
several_and_result() is
    let a mut = 1
    let b mut = 2
    let read = () => (a, b)
    swap(a ref, b ref)
    let r = bump_and_get(a ref)
    write_line("several: {read()} result {r} a {a}")
si

// The callee calls the closure during the call, after writing through
// the ref: the closure sees the write.
callee_reads_closure() is
    let n mut = 1
    let read = () => n
    let seen = set_then_read(n ref, read)
    write_line("callee reads closure: {seen} {n}")
si

// The same captured local passed twice: both refs name one variable.
same_local_twice() is
    let n mut = 1
    let read = () => n
    add_one_then_ten(n ref, n ref)
    write_line("same local twice: {n} {read()}")
si

// In a loop, with the closure read between calls.
in_loop() is
    let n mut = 0
    let read = () => n
    let seen = Collections.LIST[int]()

    for i in 0..3 do
        bump(n ref)
        seen.add(read())
    od

    write_line("in loop: {seen}")
si

// The callee passes its ref on to another.
ref_onward() is
    let n mut = 1
    let read = () => n
    onward(n ref)
    write_line("ref onward: {read()}")
si

// A later argument of the same call writes the local before the callee
// runs: the callee sees that write.
later_argument_writes() is
    let n mut = 1
    let read = () => n
    bump_by(n ref, (n = 10; 5))
    write_line("later argument writes: {n} {read()}")
si

// The callee writes and then throws: the write stays.
callee_throws() is
    let n mut = 1
    let read = () => n

    try
        bump_then_throw(n ref)
    catch e: Ghul.Exception
    yrt

    write_line("callee throws: {n} {read()}")
si

// A generator's locals live on its frame.
generated() -> int{} is
    let n mut = 1
    let read = () => n
    bump(n ref)
    yield read()
    bump(n ref)
    yield n
si

// An async function's locals live on its state machine across an await.
counted_async() -> Tasks.TASK[int] is
    let n mut = 1
    let read = () => n
    let step = await Tasks.TASK.from_result(1)
    bump(n ref)
    n = n + step
    bump(n ref)
    return read()
si

written_only_by_ref()
also_assigned()
call_in_closure()
closure_elsewhere()
try_get_value()
several_and_result()
callee_reads_closure()
same_local_twice()
in_loop()
ref_onward()
later_argument_writes()
callee_throws()
write_line("generator: {generated() |> Ghul.Pipes.join()}")
write_line("async: {counted_async().result}")
