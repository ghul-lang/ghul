use default

// Tests: a variable a top-level statement declares can be passed by
// reference, whatever its type, and a write through the reference is the
// variable's new value wherever it is read.

bump(x: int ref) is
    x! = x! + 1
si

rename(s: string ref) is
    s! = "{s!}!"
si

swap(a: int ref, b: int ref) is
    let t = a!
    a! = b!
    b! = t
si

let n mut = 1

read_n() -> int => n

bump(n ref)
bump(n ref)
write_line("{n} {read_n()}")

n = 10
bump(n ref)
write_line("{n}")

let name mut = "ghul"
rename(name ref)
write_line(name)

let x mut = 1
let y mut = 2
swap(x ref, y ref)
write_line("{x} {y}")

let counts = MAP[string, int]()
counts["a"] = 7
let found mut = 0
counts.try_get_value("a", found ref)
write_line("{found}")
