use IO.Std.write_line

// A reflected member the compiler renames is reached under its new name,
// and under its old one where the rename keeps it; a reflected member the
// compiler deprecates warns at each use, naming what to write instead.

entry() is
    let nan = 0.0 / 0.0
    write_line("{double.is_nan(nan)} {double.is_na_n(nan)} {single.is_nan(cast single(nan))}")

    let s = "hello"
    write_line("{s.count} {s.length}")

    let xs = Collections.LIST[int]([1, 2, 3])
    write_line("{xs.find(x => x > 1)} {xs.exists(x => x > 2)} {xs.true_for_all(x => x > 0)}")
    xs.for_each(x => write_line("{x}"))
    write_line("{xs.convert_all(x => x * 2)}")
si
