use default

class Component is
    name: string => "component"
    init() is si
si

class Pin: Component is
    name: string => "pin"
    init() is si
si

names(parts) => parts |> map(p => p.name) |> join(" ")

write_line(names(ARRAY[Pin]([Pin(), Pin()])));
write_line(names(LIST[Component]([Component()])));

let pins = LIST[Pin]([Pin()]);
let components = LIST[Component]([Component(), Component()]);

let flag = pins.count > 0;

let either = if flag then pins else components fi;
write_line("{either.count}");

let parts mut = ARRAY[Pin]([Pin()]);
if !flag then
    parts = components;
fi
write_line("{parts.count}");

let all = [pins, components];
write_line("{all |> map(p => p.count) |> sum()}");
