namespace Lists is
    memo[T](xs: T[]) -> T[] => xs
si

namespace Packs is
    memo[T.., U](f: T.. -> U) -> T.. -> U => f
si

namespace Test is
    use IO.Std.write_line
    use Lists.memo
    use Packs.memo

    // Tests: a function argument is adapted to a `T.. -> U` formal when
    // the callee has another overload taking the same number of
    // arguments, whether declared together or brought together by `use`.

    two(x: int) -> int => x
    two[T.., U](f: T.. -> U) -> T.. -> U => f

    multiply(a: int, b: int) -> int => a * b

    entry() is
        let unary = two((a: int) => a * 2)
        write_line("{unary(3)}")

        let binary = two((a: int, b: int) => a * b)
        write_line("{binary(3, 4)}")

        let named = two(multiply)
        write_line("{named(5, 6)}")

        write_line("{two(7)}")

        let ternary = memo((a: int, b: int, c: int) => a + b + c)
        write_line("{ternary(1, 2, 3)}")

        let memo_named = memo(multiply)
        write_line("{memo_named(2, 8)}")

        write_line("{memo([1, 2, 3]).count}")
    si
si
