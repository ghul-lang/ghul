use default
use Ghul.Functional.`>>

// The composition's result is never called; the stored literal is pinned
// by a direct call after it. Once the hoisted operand settles, its
// parameters are the tuple the composition's pack binds to, so the
// composition types without a call of its own.
let g = (p, q) => p + q
let h = `>>(g, x => x + 1)

write_line("{g(4, 9)}")
