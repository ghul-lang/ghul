// A `use` nested inside a loop's source, through a call or a pipe, holds
// the value before the loop reads it, and disposes it when the loop ends,
// after an early break or an exception too.
use default

class SRC: Ghul.Disposable, Iterable[int] is
    _name: string

    init(name: string) is
        _name = name
        write_line("  open {name}")
    si

    iterator: Iterator[int] => [1, 2, 3].iterator

    dispose() is
        write_line("  dispose {_name}")
    si
si

twice(s: Iterable[int]) -> Iterable[int] => s |> map(x => x * 2)

through_a_call() is
    write_line("through a call:")

    for x in twice(use SRC("call")) do
        write_line("  {x}")
    od
si

through_a_pipe_with_a_break() is
    write_line("through a pipe, with a break:")

    for x in use SRC("pipe") |> map(x => x + 10) do
        if x == 12 then
            break
        fi

        write_line("  {x}")
    od

    write_line("  after the loop")
si

through_a_pipe_with_an_exception() is
    write_line("through a pipe, with an exception:")

    try
        for x in use SRC("throws") |> filter(x => x > 1) do
            throw Ghul.Exception("stop at {x}")
        od
    catch e: Ghul.Exception
        write_line("  caught {e.message}")
    yrt
si

in_a_comprehension_source() is
    write_line("in a comprehension source:")

    let doubled = [x * 2 for x in twice(use SRC("comprehension"))]

    write_line("  {doubled}")
si

entry() is
    through_a_call()
    through_a_pipe_with_a_break()
    through_a_pipe_with_an_exception()
    in_a_comprehension_source()
si
