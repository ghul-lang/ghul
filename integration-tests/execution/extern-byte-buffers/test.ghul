namespace Test is
    use IO.Std.write_line;

    // Tests: an ARRAY[ubyte] crosses to a foreign function as the address of
    // its first element, so the function reads and writes the array's own
    // bytes. Covers writing into an array, copying between two arrays, and
    // copying out of memory the C library allocated into an array.

    @extern("libc", "memset")
    fill(buffer: ARRAY[ubyte], value: int, count: word) -> word;

    @extern("libc", "memcpy")
    copy(destination: ARRAY[ubyte], source: ARRAY[ubyte], count: word) -> word;

    @extern("libc", "memcpy")
    copy_from(destination: ARRAY[ubyte], source: word, count: word) -> word;

    @extern("libc", "strdup")
    duplicate(text: string) -> word;

    @extern("libc", "free")
    release(pointer: word);

    show(bytes: ARRAY[ubyte]) -> string => "[{bytes |> Ghul.Pipes.join(", ")}]";

    entry() is
        let buffer = Ghul.Pipes.repeat(0ub, 5) |> ARRAY();
        fill(buffer, 7, 3w);
        write_line("filled: {show(buffer)}");

        let source = ARRAY[ubyte]([1ub, 2ub, 3ub, 4ub, 5ub]);
        let target = Ghul.Pipes.repeat(0ub, 5) |> ARRAY();
        copy(target, source, 4w);
        write_line("copied: {show(target)}");

        let pointer = duplicate("hi!");
        let text = Ghul.Pipes.repeat(0ub, 3) |> ARRAY();
        copy_from(text, pointer, 3w);
        release(pointer);
        write_line("from C: {show(text)}");
    si
si
