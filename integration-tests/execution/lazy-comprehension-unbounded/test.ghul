use IO.Std.write_line
use Ghul.Pipes

is_prime(n: int) -> bool =>
    n > 1 /\ !(2::n - 1 |> any(d => d * d <= n /\ n % d == 0))

// a lazy comprehension over a sequence that never ends only computes
// the elements that are read
let primes = {n for n in from(1) if is_prime(n)}

write_line("primes: {primes |> take(8)}")
write_line("first square over 50: { {n * n for n in from(1)} |> filter(s => s > 50) |> first() }")
