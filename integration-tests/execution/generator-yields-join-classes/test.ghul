use default

class Animal(name: string public) is si

class Cat(name: string): Animal is
    super(name)
si

class Dog(name: string): Animal is
    super(name)
si

pets() is
    yield Cat("tom")
    yield Dog("rex")
si

let more = () is
    yield Dog("fido")
    yield Cat("kit")
    yield Dog("max")
si

write_line(pets() |> map(p => p.name) |> join())
write_line(more() |> map(p => p.name) |> join())
