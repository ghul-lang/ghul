namespace Test is
    use IO.Std.write_line;
    use Ghul.Pipes;

    identity[T](x: T) -> T => x;

    zero_of[T](ignored: int) -> T => _[T];

    wrap[T](x: T) -> (T, T) => (first = x, second = x);
    wrap(x: string) -> string => "s:{x}";

    is_present[T](x: T) -> bool => true;

    convert[T, U](x: T) -> U => _[U];

    takes_fn(f: (int) -> int, v: int) -> int => f(v);

    apply_slot[T](f: (T) -> T, v: T) -> T => f(v);

    first_mapped[T, U](xs: Collections.Iterable[T], f: (T) -> U) -> U is
        for x in xs do
            return f(x);
        od

        throw System.Exception("empty");
    si

    class Main is
        entry() static is
            let xs = [1, 2, 3];

            // The pipe combinator's formal pins the instantiation:
            // map's (T) -> S with T bound by the source.
            let mapped = xs |> map(identity) |> collect();
            write_line("{mapped[0]} {mapped[1]} {mapped[2]}");

            // An ordinary call argument of function type.
            write_line("{takes_fn(identity, 4)}");

            // An annotated local.
            let as_value: (int) -> int = identity;
            write_line("{as_value(5)}");

            // The type argument appears only in the return type, so
            // only the slot's return slot can pin it.
            let maker: (int) -> string = zero_of;
            write_line("[{maker(6)}]");

            // An overloaded group where the slot's shape selects the
            // generic member.
            let pairer: (int) -> (int, int) = wrap;
            let (first, second) = pairer(7);
            write_line("{first} {second}");

            let as_string: (string) -> string = wrap;
            write_line("{as_string("eight")}");

            // The slot itself sits under the caller's type parameter.
            write_line("{apply_slot(identity, 9)}");

            // The slot is the callee's own type variable and nothing
            // else in the signature pins it, so only the sibling
            // actual can - and the type argument it settles on has to
            // be `int`. Instantiating at `object` instead still runs
            // for a slot the value boxes into, so this shape passes
            // the array through a formal that `object` makes
            // ill-typed: `int[]` is not an `Iterable[object]`, and the
            // runtime rejects the assembly.
            write_line("{first_mapped(xs, identity)}");

            // Type variables split between the parameters and the
            // return slot bind from both positions.
            let converter: (int) -> string = convert;
            write_line("[{converter(10)}]");

            // A named .NET delegate slot.
            let predicate: System.Predicate[int] = is_present;
            write_line("{predicate.invoke(10)}");
        si
    si
si
