// Built with debug information, a T? at a reference type is described as
// the reference it holds, in a field, a local and a parameter.
use IO.Std.write_line

class Node(name: string public)

class Holder[T] is
    item: T?

    init(item: T?) is
        self.item = item
    si
si

first_named[T](items: T[], wanted: (T) -> bool) -> T? is
    let found: T? mut = null

    for item in items do
        if wanted(item) then
            found = item
            break
        fi
    od

    return found
si

describe[T](item: T?) -> string => if let i = item then "{i}" else "none" fi

let nodes = [Node("a"), Node("b")]
let holder = Holder[Node](nodes[1])
let found = first_named(nodes, n => n.name =~ "b")

write_line(holder.item?.name ?? "none")
write_line(found?.name ?? "none")
write_line(describe[string](null))
