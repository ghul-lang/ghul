use default

// use default imports Concurrency.run, beside a program's own run.

run(text: string) -> string => "own {text}"

compute() -> Concurrency.Future[int] is
    await Concurrency.sleep(1)
    return 6 * 7
si

write_line(run("call"))
write_line("{run(compute())}")
write_line("{run(() => compute())}")
