use IO.Std.write_line
use Ghul.Pipes
use Collections.LIST

// The library's generic `find` over elements that are themselves optional:
// `find` instantiates at `T = int?` and `T = string?`, so a found element
// that is absent and nothing found must stay different.
describe_number_find(xs: LIST[int?], predicate: (int?) -> bool pure) -> string =>
    if let hit = xs |> find(predicate) then
        if hit? then "found {hit}" else "found an absent element" fi
    else
        "not found"
    fi

describe_name_find(xs: LIST[string?], predicate: (string?) -> bool pure) -> string =>
    if let hit = xs |> find(predicate) then
        if hit? then "found {hit}" else "found an absent element" fi
    else
        "not found"
    fi

let optional_numbers = LIST[int?]()
optional_numbers.add(1)
optional_numbers.add(null)
optional_numbers.add(3)

let optional_names = LIST[string?]()
optional_names.add("a")
optional_names.add(null)
write_line(describe_number_find(optional_numbers, x => !x?))
write_line(describe_number_find(optional_numbers, x => x =~ 3))
write_line(describe_number_find(optional_numbers, x => x =~ 9))
write_line(describe_name_find(optional_names, x => !x?))
write_line(describe_name_find(optional_names, x => x =~ "z"))
