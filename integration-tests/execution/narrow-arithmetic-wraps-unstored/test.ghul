// A narrow integer kind's arithmetic result is wrapped to the kind's
// width where it is produced, so comparing it or using it again before
// it is stored sees the wrapped value.
use IO.Std.write_line

entry() is
    let ub: ubyte = 255ub
    let ub_zero: ubyte = 0ub
    let ub_sixteen: ubyte = 16ub
    let b: byte = 127b
    let us: ushort = 65535us
    let us_zero: ushort = 0us
    let s: short = 32767s

    write_line("ubyte {ub + 1ub == 0ub} {ub_zero - 1ub == 255ub} {ub * ub == 1ub} {ub_sixteen << 4 == 0ub} {\ub_zero == 255ub} {(ub + 1ub) / 2ub}")
    write_line("byte {b + 1b == \127b} {-b - 2b == 127b} {b * b == 1b} {b << 1 == -2b} {(b + 1b) / 2b}")
    write_line("ushort {us + 1us == 0us} {us_zero - 1us == 65535us} {us * us == 1us} {us << 1 == 65534us} {\us_zero == 65535us} {(us + 1us) / 2us}")
    write_line("short {s + 1s == \32767s} {-s - 2s == 32767s} {s * s == 1s} {s << 1 == -2s} {(s + 1s) / 2s}")
si
