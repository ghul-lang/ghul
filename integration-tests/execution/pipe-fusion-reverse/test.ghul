namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // An innermost `reverse` reads its source backwards through
    // `reverse_iterator` rather than collecting it: a range, a list, an
    // array and a bare reverse all agree with the unfused result,
    // including empty and single-element sources. A `reverse` behind a
    // stage, and one over a source typed only as an iterable, do not
    // fuse and still agree.
    class Main is
        show(name: string, xs: int[]) static is
            let parts = xs |> map(x => "{x}") |> join(",");

            Std.write_line("{name}: [{parts}] count={xs.count}");
        si

        backwards(limit: int) -> int{} static is
            for x in (0..limit) |> reverse() do
                yield x;
            od
        si

        entry() static is
            let array = [1, 2, 3, 4];
            let list = LIST[int]([5, 6, 7]);
            let lazy: int{} = [9, 8, 7];

            for x in (0..4) |> reverse() do
                Std.write_line("for-range {x}");
            od

            for x in array |> reverse() |> map(v => v * 10) do
                Std.write_line("for-array {x}");
            od

            Std.write_line("join-range: {(0..4) |> reverse() |> join(",")}");
            Std.write_line("reduce-list: {list |> reverse() |> reduce(0, (a, x) => a * 10 + x)}");
            Std.write_line("count-range: {(0..10) |> reverse() |> count()}");

            show("array", array |> reverse() |> collect());
            show("list", list |> reverse() |> collect());
            show("inclusive", (1::4) |> reverse() |> collect());
            show("filter-above", (0..10) |> reverse() |> filter(x => x % 2 == 0) |> collect());
            show("empty", (3..3) |> reverse() |> collect());
            show("empty-backwards", (5..3) |> reverse() |> collect());
            show("single", (7::7) |> reverse() |> collect());
            show("double", array |> reverse() |> reverse() |> collect());

            // not innermost, and not statically indexable: unfused, still right
            show("mid-chain", array |> map(x => x * 2) |> reverse() |> collect());
            show("iterable", lazy |> reverse() |> collect());

            let bare = (0..3) |> reverse();
            Std.write_line("bare: {bare |> join(",")}");

            Std.write_line("generator: {backwards(3) |> join(",")}");
        si
    si
si
