namespace Test is
    use IO.Std.write_line;
    use Collections;

    // Each name is an overload group holding one generic function and one
    // non-generic function. A non-generic formal that is at least as
    // specific as the generic's, once the generic's type argument is
    // bound, wins the call; a catch-all formal loses it to the generic.

    iterable_string[T](source: Iterable[T]) -> string => "generic";
    iterable_string(source: Iterable[string]) -> string => "non-generic";

    list_string[T](source: Iterable[T]) -> string => "generic";
    list_string(source: List[string]) -> string => "non-generic";

    exact_array[T](source: Iterable[T]) -> string => "generic";
    exact_array(source: string[]) -> string => "non-generic";

    iterable_int[T](source: Iterable[T]) -> string => "generic";
    iterable_int(source: Iterable[int]) -> string => "non-generic";

    iterable_object[T](source: Iterable[T]) -> string => "generic";
    iterable_object(source: Iterable[object]) -> string => "non-generic";

    list_object[T](source: Iterable[T]) -> string => "generic";
    list_object(source: List[object]) -> string => "non-generic";

    object_value[T](value: T) -> string => "generic";
    object_value(value: object) -> string => "non-generic";

    class Main is
        entry() static is
            let strings = ["a", "b"];
            let ints = [1, 2];
            let thing: object = "c";

            write_line("iterable_string: {iterable_string(strings)}");
            write_line("list_string: {list_string(strings)}");
            write_line("exact_array: {exact_array(strings)}");
            write_line("iterable_int: {iterable_int(ints)}");
            write_line("iterable_object: {iterable_object(strings)}");
            write_line("list_object: {list_object(strings)}");
            write_line("object_value on a string: {object_value("c")}");
            write_line("object_value on an object: {object_value(thing)}");
        si
    si
si
