use default

// Tests: a class or struct deconstructs by position with its synthesised
// deconstruct, in a let and in an if let, in a function and at top level,
// for scalar and reference-typed members.

class Point(x: int public, y: int public);

struct Size(width: double public, height: double public);

class Named(name: string public, count: int public);

describe() is
    let (x, y) = Point(3, 4)
    write_line("{x} {y}")

    let (w, h) = Size(1.5, 2.5)
    write_line("{w} {h}")

    let (name, count) = Named("apples", 3)
    write_line("{name} {count}")

    if let (a, b) = Point(5, 6) then
        write_line("{a + b}")
    fi

    for i in 0..2 do
        let (p, q) = Point(i, i * 10)
        write_line("{p} {q}")
    od
si

describe()

let (top_x, top_y) = Point(7, 8)
write_line("{top_x} {top_y}")
