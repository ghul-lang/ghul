use IO.Std.write_line

let n = 7
let x = 2.75
let big = 5_000_000_000L

write_line("double(n): {double(n)} matches cast: {double(n) == cast double(n)}")
write_line("int(x): {int(x)} matches cast: {int(x) == cast int(x)}")
write_line("int(-x): {int(-x)}")
write_line("long(n): {long(n)}")
write_line("int(big) wraps as cast does: {int(big)} {cast int(big)}")
write_line("ubyte(300): {ubyte(300)} {cast ubyte(300)}")
write_line("byte(200): {byte(200)} {cast byte(200)}")
write_line("char(65): {char(65)}")
write_line("int('A'): {int('A')}")
write_line("single(x): {single(x)}")
write_line("decimal(n): {decimal(n)} decimal(x): {decimal(x)}")
write_line("bigint(big): {bigint(big)} bigint(n): {bigint(n)}")
write_line("uint(-1): {uint(-1)} {cast uint(-1)}")
write_line("word(n): {word(n)}")
write_line("double(decimal): {double(1.5m)}")
write_line("int(bigint): {int(12345n)}")

let from_expected: double = _(n)
write_line("from the expected type: {from_expected}")

let widths = [1, 2, 3]
let total: long = _(widths[2])
write_line("indexed element: {total}")
