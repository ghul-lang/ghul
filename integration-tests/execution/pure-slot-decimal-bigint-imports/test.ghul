// decimal and bigint values are scalars to the store-free analysis:
// constructing one, its operators and statics, and its reads and
// formatting all satisfy a pure function-typed slot. A literal that
// writes is still refused.

use default

_total: int

hickerson(n: int) -> decimal =>
    let
        ln2 = 0.6931471805599453094172321215m,
        factorial = 1::n |> reduce(1m, (f, k) => f * decimal(k)),
        power = 1::n + 1 |> reduce(1m, (p, _) => p * ln2)
    in
        factorial / (2m * power)

factorial(n: int) -> bigint => 1::n |> reduce(1n, (f, k) => f * bigint(k))

decimal_members(n: int) -> int =>
    1::n |> reduce(0, (a, k) => a + "{decimal(k) / 3m}".length + int(decimal.floor(decimal(k) / 2m)))

bigint_members(n: int) -> int =>
    1::n |> reduce(0, (a, k) =>
        let b = bigint.pow(bigint(k), 3) in
        a + "{b}".length + b.sign + (if b.is_even then 1 else 0 fi) + int(b.get_bit_length()))

write_line("{hickerson(5):F3}")
write_line("{factorial(25)}")
write_line("{decimal_members(4)}")
write_line("{bigint_members(5)}")

let counted = 1::3 |> reduce(0, (a, k) => (_total = _total + k; a + k))
write_line("{counted} {_total}")
