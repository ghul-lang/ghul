use default

class Tally is
    hits: int public
    init() is si
si

leaves(dimensions: Collections.List[int], tally: Tally) -> int is
    count(level: int) -> int =>
        if level == dimensions.count then
            tally.hits = tally.hits + 1
            1
        else
            let f = (i: int) => count(level + 1)
            0..dimensions[level] |> map(f) |> sum()
        fi

    count(0)
si

write_line("{leaves(LIST([2, 3]), Tally())}")
