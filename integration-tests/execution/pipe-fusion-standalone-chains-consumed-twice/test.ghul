use default

// A chain a consumer fuses, in an operand compiled more than once, beside
// a standalone chain in the same body.
factors(n: int) -> List[(prime: int, exponent: int)] =>
    if n % 2 == 0 then [(2, 2), (3, 3)] else [(5, 2)] fi

gcd(a: int, b: int) -> int => if b == 0 then a else gcd(b, a % b) fi

check(n: int) -> bool =>
    let found = factors(n) in
    found.count > 0 /\
    (found |> all(factor => factor.exponent >= 2)) /\
    (
        found
            |> map(factor => factor.exponent)
            |> reduce(0, gcd)
    ) == 1

exponents(n: int) -> int{} => factors(n) |> map(factor => factor.exponent * 10)

write_line("{check(4)} {check(5)}")
write_line(exponents(4) |> join(","))
