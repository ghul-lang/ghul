namespace Test is
    class BOX(value: int public)

    // `new` is not a keyword: it names a variable, a parameter and a
    // function like any other identifier.
    new(value: int) -> BOX => BOX(value)

    double(new: int) -> int => new * 2

    entry() is
        let new = 21
        let box = Test.new(double(new))

        IO.Std.write_line("{box.value}")
    si
si
