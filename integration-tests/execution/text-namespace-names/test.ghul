use IO.Std.write_line

// The text family lives in Text beside StringBuilder: Text.Encoding,
// Text.Rune, Text.Locale, Text.NumberStyles, Text.StringComparison and
// Text.StringSplitOptions.

count_bytes(encoding: Text.Encoding, text: string) -> int => encoding.get_bytes(text).count

let utf8: Text.Encoding = Text.Encoding.utf8
write_line("{count_bytes(utf8, "héllo")} {Text.Encoding.ascii.get_string(utf8.get_bytes("abc"))}")

let rune: Text.Rune = Text.Rune(0x1F600)
write_line("{rune.value} {rune.utf16_sequence_length}")

let culture: Text.Locale = invariant_locale()
write_line("'{culture.name}' {culture == invariant_locale()}")

let styles: Text.NumberStyles = Text.NumberStyles.HEX_NUMBER
write_line("{int.parse("ff", styles)}")

let comparison: Text.StringComparison = Text.StringComparison.ORDINAL_IGNORE_CASE
write_line("{comparison == Text.StringComparison.ORDINAL_IGNORE_CASE} {comparison == Text.StringComparison.ORDINAL}")

let options: Text.StringSplitOptions = Text.StringSplitOptions.REMOVE_EMPTY_ENTRIES
write_line("{"a,,b".split([','], options).count}")

// The invariant locale under the name each target declares it: the core
// library on wasm and llvm still says invariant_culture.
@IF.dotnet()
invariant_locale() -> Text.Locale => Text.Locale.invariant

@IF.not.dotnet()
invariant_locale() -> Text.Locale => Text.Locale.invariant_culture
