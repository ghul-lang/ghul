use IO.Std.write_line

// The text family lives in Text beside STRING_BUILDER: Text.Encoding,
// Text.RUNE, Text.CULTURE, Text.NumberStyles, Text.StringComparison and
// Text.StringSplitOptions. Their old names are second spellings of the
// same types.

count_bytes(encoding: Text.Encoding, text: string) -> int => encoding.get_bytes(text).count

let utf8: Text.Encoding = System.Text.Encoding.utf8
let also_utf8: System.Text.Encoding = utf8
write_line("{count_bytes(also_utf8, "héllo")} {Text.Encoding.ascii.get_string(utf8.get_bytes("abc"))}")

let rune: Text.RUNE = System.Text.Rune(0x1F600)
let same_rune: System.Text.Rune = rune
write_line("{same_rune.value} {rune.utf16_sequence_length}")

let culture: Text.CULTURE = System.Globalization.CultureInfo.invariant_culture
let same_culture: System.Globalization.CultureInfo = culture
write_line("'{same_culture.name}' {same_culture == Text.CULTURE.invariant_culture}")

let styles: Text.NumberStyles = System.Globalization.NumberStyles.HEX_NUMBER
let same_styles: System.Globalization.NumberStyles = styles
write_line("{int.parse("ff", same_styles)}")

let comparison: Text.StringComparison = System.StringComparison.ORDINAL_IGNORE_CASE
let old_comparison: Ghul.StringComparison = comparison
write_line("{old_comparison == Text.StringComparison.ORDINAL_IGNORE_CASE} {comparison == System.StringComparison.ORDINAL}")

let options: Text.StringSplitOptions = Ghul.StringSplitOptions.REMOVE_EMPTY_ENTRIES
let old_options: System.StringSplitOptions = options
write_line("{"a,,b".split([','], old_options).count}")
