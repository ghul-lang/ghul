use default

_two() is
    write_line("{even(10)} {odd(7)}")

    even(n) => if n == 0 then true else odd(n - 1) fi
    odd(n) => if n == 0 then false else even(n - 1) fi
si

_three(limit: int) is
    a(n) => if n >= limit then "a{n}" else b(n + 1) fi
    b(n) => if n >= limit then "b{n}" else c(n + 1) fi
    c(n) => if n >= limit then "c{n}" else a(n + 1) fi

    write_line("{a(0)} {b(0)}")
si

_two()
_three(7)
