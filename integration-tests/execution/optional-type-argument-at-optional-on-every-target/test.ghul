// A `T?` parameter instantiated at an optional holds two levels of absence:
// an argument of the inner optional's type, or one widened to it, is present
// at the outer level and keeps its own presence and value, for a value type
// and a reference type alike.

use IO.Std.write_line

show[T](x: T?) -> string => if x? then "x={x}" else "absent" fi

let v: int? = 4
write_line(show[int?](4))
write_line(show[int?](v))
write_line(show[int?](null))

inner_state[T](x: T?) -> string is
    if let present = x then
        return if present != null then "inner present" else "inner absent" fi
    fi
    return "outer absent"
si

let absent_text: string? = null
write_line(inner_state[string?](absent_text))
write_line(inner_state[string?]("t"))
write_line(inner_state[string?](null))
write_line(inner_state[int?](v))
write_line(inner_state[int?](5))
