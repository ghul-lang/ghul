// A `T?` parameter instantiated at `T = int?` holds two levels of absence:
// a present `int?` argument is present at the outer level and keeps its value.

use IO.Std.write_line

show[T](x: T?) -> string => if x? then "x={x}" else "absent" fi

let v: int? = 4
write_line(show[int?](4))
write_line(show[int?](v))
write_line(show[int?](null))
