use default

// new names
double_it(n: int) -> Tasks.Future[int] is
    await Tasks.Future.yield()
    return n * 2
si

// old name, still accepted
old_style(n: int) -> Tasks.TASK[int] => double_it(n)

unit_work() -> Tasks.Future is
    await Tasks.Future.delay(1)
si

handed_over(c: Tasks.Completer[string]) -> Tasks.Future[string] is
    return await c.task
si

old_unit() -> Tasks.TASK => unit_work()

use Tasks.Future
use Tasks.Completer

imported() -> Future[int] is
    let c = Completer[int]()
    c.set_result(5)
    return await c.task
si

let mixed: Tasks.TASK[int] = double_it(1)
let back: Tasks.Future[int] = old_style(2)

let c = Tasks.Completer[string]()
let waiting = handed_over(c)
c.set_result("handed over")

write_line("{double_it(21).result} {old_style(4).result} {back.result} {mixed.result} {waiting.result} {imported().result}")
old_unit().wait()
