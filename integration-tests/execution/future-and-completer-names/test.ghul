use default

// new names
double_it(n: int) -> Concurrency.Future[int] is
    await Concurrency.Future.yield()
    return n * 2
si

// old name, still accepted
old_style(n: int) -> Concurrency.Future[int] => double_it(n)

unit_work() -> Concurrency.Future is
    await Concurrency.Future.delay(1)
si

handed_over(c: Concurrency.Completer[string]) -> Concurrency.Future[string] is
    return await c.task
si

old_unit() -> Concurrency.Future => unit_work()

use Concurrency.Future
use Concurrency.Completer

imported() -> Future[int] is
    let c = Completer[int]()
    c.set_result(5)
    return await c.task
si

let mixed: Concurrency.Future[int] = double_it(1)
let back: Concurrency.Future[int] = old_style(2)

let c = Concurrency.Completer[string]()
let waiting = handed_over(c)
c.set_result("handed over")

write_line("{double_it(21).result} {old_style(4).result} {back.result} {mixed.result} {waiting.result} {imported().result}")
old_unit().wait()
