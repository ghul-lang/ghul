// `**` on the built-in types, through `use default`: its precedence, its
// grouping, including an unparenthesised chain in a top-level call, checked
// overflow, a negative exponent, and its use as a value
// and in a partial application.

use default

overflows(f: () -> long) -> string is
    try
        f()
        return "no throw"
    catch e: System.OverflowException
        return "overflow"
    yrt
si

out_of_range(f: () -> long) -> string is
    try
        f()
        return "no throw"
    catch e: System.ArgumentOutOfRangeException
        return "out of range"
    yrt
si

write_line("{2 ** 10} {2L ** 40} {3u ** 20} {2n ** 100} {9.0 ** 0.5}")
write_line("{2 * 3 ** 2} {2 ** 3 * 2} {1 + 2 ** 3} {-2 ** 2}")
write_line("{(2 ** 3) ** 2} {2 ** (3 ** 2)} {2 ** 3 ** 2}")
write_line("{overflows(() => long(2 ** 31))} {overflows(() => 3L ** 40)} {overflows(() => long(2 ** 30))}")
write_line(out_of_range(() => long(2 ** -1)))

let squares = [1, 2, 3, 4] |> map(* ** 2) |> list()
let powers_of_two = [0, 1, 2, 3] |> map(2 ** *) |> list()
let power: (int, int) -> int = `**
write_line("{squares} {powers_of_two} {power(5, 3)}")
