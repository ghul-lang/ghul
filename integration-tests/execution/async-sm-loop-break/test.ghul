namespace Test is
    use Std = IO.Std;

    class Main is
        compute() -> Concurrency.Future[int] static is
            let total mut = 0;
            for n in [1, 2, 3, 4, 5] do
                if n == 4 then
                    break;
                fi
                let x = await Concurrency.Future.from_result(n * 10);
                total = total + x;
            od
            return total;
        si

        entry() static is
            let r = compute();
            Std.write_line("total={r.result}");
        si
    si
si
