use default

// An expression on its own is a statement, and it is evaluated: the
// getter runs, and the division still throws. Nothing needs `let _ =`
// in front of it to make that happen.
class NOISY is
    init() is si

    value: int public => (write_line("getter ran"); 42)
si

divides_by_zero(a: int, b: int) -> bool is
    try
        a / b

        return false
    catch e: Ghul.DivideByZeroException
        return true
    yrt
si

let n = NOISY()

n.value

write_line("division threw: {divides_by_zero(1, 0)}")
