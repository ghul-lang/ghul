use default

// A function literal in a struct's instance member is emitted as a static
// method with no receiver: a struct instance member holds self as a managed
// pointer, which cannot be a delegate's target. The member around the literal
// still reads self as it always did.
struct SCALER(factor: int) is
    of(xs: List[int]) -> int => (xs |> map(x => x * 2) |> sum()) * factor

    total: int => [1, 2, 3] |> map(x => x * 2) |> sum()

    evens(xs: List[int]) -> int{} => xs |> filter(x => x % 2 == 0)
si

class CLASS_SCALER(factor: int) is
    of(xs: List[int]) -> int => (xs |> map(x => x * 2) |> sum()) * factor
si

let s = SCALER(3)

write_line("{s.of([1, 2])}")
write_line("{s.total}")
write_line("{s.evens([1, 2, 3, 4]) |> collect_mutable()}")
write_line("{CLASS_SCALER(3).of([1, 2])}")
