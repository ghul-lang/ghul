use default

digits(text) => text |> map(char.get_unicode_category) |> filter(c => cast int(c) == 8) |> count()

magnitudes(xs) => xs |> map(abs) |> list()

parsed(parts) => parts |> map(int.parse) |> list()

least(xs) => xs |> reduce(xs[0], min)

write_line("{digits("a1b2")} {magnitudes([-1, 2])} {parsed(["3", "4"])} {least([5, 2, 7])}")
