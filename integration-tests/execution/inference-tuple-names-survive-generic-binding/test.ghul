use IO.Std.write_line
use Ghul.Pipes

use Pair = (low: int, high: int)

pick[R](a: R, b: R) -> R => b

let start: Pair = (0, 1)

// the seed fixes reduce's accumulator as a Pair; the step returns an
// unnamed tuple of the same shape
let total = [3, 1, 4] |> reduce(start, (p, x) => (p.low + x, p.high * x))
write_line("reduce: {total.low} {total.high}")

// a named tuple and an unnamed one bind R alike in either order
let named_first = pick(start, (5, 6))
let named_second = pick((7, 8), start)
write_line("pick: {named_first.low} {named_second.high}")

// one side names the first element, the other the second
let mixed = pick((low = 9, 10), (11, high = 12))
write_line("mixed: {mixed.low} {mixed.high}")
