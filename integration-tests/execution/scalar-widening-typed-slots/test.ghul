use IO.Std.write_line

// A value widens into a typed let, an assignment, an indexer store, an
// optional slot and a return.
class Holder is
    total: double public
    init() is total = 0.0; si
si

as_double(n: int) -> double is
    return n
si

as_long(n: int) -> long => n

or_zero(x: double?) -> double => x ?? 0.0

let i = 3
let d: double = i
let l: long mut = 0L
l = i
let h = Holder()
h.total = i
let typed: double = if i > 2 then i else 0.5 fi
let elements: double[] = [i, 2]
let list = Collections.LIST[double]([0.5])
list[0] = i
let optional: double? = i

write_line("{d / 2.0} {l * 1_000_000_000L} {h.total / 2.0} {as_double(i) / 2.0} {as_long(i) * 1_000_000_000L} {typed / 2.0} {elements[1] / 4.0}")
write_line("{list[0] / 2.0} {(optional ?? 0.0) / 2.0} {or_zero(i) / 2.0}")
