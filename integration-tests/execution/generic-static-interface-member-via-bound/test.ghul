namespace Test is
    use IO.Std.write_line;
    use Ghul.Parsable;
    use System.Numerics.IBinaryInteger;

    // A static abstract interface member, reached through a bound
    // type parameter.
    parse_via_bound[T: Parsable[T]](s: string) -> T =>
        T.parse(s, null);

    // A static virtual interface member with a default body, reached
    // the same way - the CLR distinguishes the two at the reflection
    // level, so both need to route through the constrained call shape.
    rotate_left_via_bound[T: IBinaryInteger[T]](value: T, amount: int) -> T =>
        T.rotate_left(value, amount);

    entry() is
        write_line("{parse_via_bound[int]("42")}");
        write_line("{parse_via_bound[double]("1.5")}");
        write_line("{rotate_left_via_bound[int](1, 4)}");
    si
si
