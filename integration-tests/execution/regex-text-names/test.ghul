use IO.Std.write_line

// The regular expression types are Text.REGEX and friends, and the Unicode
// categories Text.UnicodeCategory; their .NET names are second spellings of
// the same types.

count_words(pattern: Text.REGEX, text: string) -> int => pattern.matches(text).count

let words: System.Text.RegularExpressions.Regex = Text.REGEX("\\w+")
let found: Text.MATCH = words.match("hello there")
let first: Text.GROUP = found.groups[0]
let all: Text.MATCH_COLLECTION = System.Text.RegularExpressions.Regex.matches("a b c", "\\w")
let groups: System.Text.RegularExpressions.GroupCollection = found.groups
let options: Text.RegexOptions = System.Text.RegularExpressions.RegexOptions.IGNORE_CASE

write_line("{count_words(words, "one two three")} {first.value} {all.count} {groups.count}")
write_line("{Text.REGEX("HELLO", options).is_match("hello")}")
write_line("{Text.REGEX.replace("a-b-c", "-", "+")}")

let category: Text.UnicodeCategory = char.get_unicode_category('a')
let same: System.Globalization.UnicodeCategory = category
write_line("{same == Text.UnicodeCategory.LOWERCASE_LETTER}")
