use default

class OPTION(name: string public) is
    to_string() -> string => "option {name}"
si

// Writing a value out says nothing about its type: write_line takes a
// string or any object, so the map's value type is what is assigned to it.
let options = MAP()

options["a"] = OPTION("a")

for key in ["a"] do
    write_line(options[key])
od
