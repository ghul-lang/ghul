namespace Test is
    use Std = IO.Std;
    class BOX is
        v: int public;
        init(v: int) is self.v = v; si
    si

    class Main is
        get_value() -> Concurrency.Future[int] static => Concurrency.Future.from_result(42);

        compute() -> Concurrency.Future[int] static is
            let b = BOX(await get_value());
            return b.v;
        si

        entry() static is
            Std.write_line("got={compute().result}");
        si
    si
si
