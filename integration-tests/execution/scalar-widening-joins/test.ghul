use IO.Std.write_line

// The arms of an if or case and the elements of an array literal join
// to the widest scalar among them.
let i = 1
let flag = i > 0

let a = if flag then i else 2.5 fi
let b = case i when 1 then 7L else i esac
let xs = [i, 2.5, 3L]

write_line("{a / 2.0} {b * 1_000_000_000L} {xs[0] / 2.0} {xs[2]}")
