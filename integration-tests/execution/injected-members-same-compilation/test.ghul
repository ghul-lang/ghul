// Members a runtime-library build adds to imported types, used in the
// compilation that declares them: string and char gain instance methods and
// properties, emitted as statics that take the receiver first.
namespace Ghul.Internal is
    use Ghul.Pipes

    partial string is
        shout() -> string => "{self}!"

        doubled: string => "{self}{self}"

        // Implicit self: a call to another added member and one the type
        // declares, and a closure in the body.
        loud() -> string => shout().to_upper()

        has(c: char) -> bool => self |> any(x => x == c)
    si

    partial char is
        twice: string => "{self}{self}"

        // These replace char's own static is_digit and to_upper, which are
        // hidden wherever they are present.
        is_digit: bool => self >= '0' /\ self <= '9'

        to_upper() -> char => if self >= 'a' /\ self <= 'z' then char(int(self) - 32) else self fi
    si
si

namespace Main is
    use IO.Std.write_line

    entry() is
        write_line("hi".shout())
        write_line("ab".doubled)
        write_line("hi".loud())
        write_line("{"banana".has('n')} {"banana".has('z')}")
        write_line('x'.twice)
        write_line("{'5'.is_digit} {'x'.is_digit} {'q'.to_upper()}")
    si
si
