use default

let seen = SET()
let typed_seen = SET[int]()

// a parameter left untyped: the last statement is the value
_visit(n) is
    seen.add(n)
si

// every parameter typed: the last statement is not the value
visit(n: int) is
    typed_seen.add(n)
si

mixed(a: int, b) is
    let c = a + b
    c * 2
si

pick(a: int, b) is
    if a > b then "first" else "second" fi
si

early(a: int, b) is
    if a < 0 then return 0 fi
    a + b
si

answer() is
    42
si

typed_return(x: int) is
    if x < 0 then return "negative" fi
    return "non-negative"
si

let added = _visit(1)
let again = _visit(1)
visit(2)

write_line("{added} {again} {seen.count} {typed_seen.count}")
write_line("{mixed(1, 2)} {pick(1, 2)} {early(-1, 5)} {early(1, 5)}")
write_line("{answer()} {typed_return(-1)} {typed_return(1)}")
