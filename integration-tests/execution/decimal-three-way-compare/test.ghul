use IO.Std.write_line

// The ordering value of two decimals, written as the operator and as a
// member call, agrees with the relational operators built on it.
entry() is
    let a = 1.5m
    let b = 2.5m

    write_line("{a <> b} {b <> a} {a <> a}")
    write_line("{a.`<>(b)} {b.`<>(a)}")
    write_line("{a < b} {a > b} {a <= a} {b >= a}")
si
