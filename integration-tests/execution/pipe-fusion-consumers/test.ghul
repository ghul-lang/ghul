namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A terminal Pipe consumer over a fusible map/filter chain lowers to an
    // inline driving loop that produces the consumer's result directly,
    // instead of building the pipe objects and iterating them. Covers each
    // consumer over a collection source and a range source;
    // results must match the ordinary pipe lowering.

    class Main is
        entry() static is
            let xs = LIST[int]([1, 2, 3, 4, 5, 6]);

            Std.write_line("count: {xs |> map(n => n * 2) |> filter(n => n > 4) |> count()}");
            Std.write_line("any: {xs |> map(n => n * 2) |> any(n => n > 10)}");
            Std.write_line("all: {xs |> map(n => n * 3) |> all(n => n < 10)}");
            Std.write_line("reduce: {xs |> map(n => n * 10) |> reduce(0, (a: int, n: int) => a + n)}");

            let found = xs |> map(n => n * 10) |> find(n => n > 25);
            Std.write_line("find: {if found? then found! else -1 fi}");

            let earliest = xs |> filter(n => n % 2 == 0) |> first();
            Std.write_line("first: {if earliest? then earliest! else -1 fi}");

            let collected = xs |> map(n => n * 10) |> filter(n => n > 25) |> collect_mutable();
            let sum mut = 0;
            for c in collected do sum = sum + c; od
            Std.write_line("collect: count={collected.count} sum={sum}");

            let seen mut = 0;
            xs |> filter(n => n % 2 == 0) |> each((n: int) is seen = seen + n; si);
            Std.write_line("each: {seen}");

            // range source
            Std.write_line("range count: {(0..10) |> filter(n => n % 3 == 0) |> count()}");
            Std.write_line("range any: {(0..10) |> map(n => n * n) |> any(n => n > 50)}");
        si
    si
si
