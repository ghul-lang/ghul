namespace Test is
    use Ghul.Pipes;
    use IO.Std.write_line;

    // Tests: a function literal whose parameter type comes from the call
    // it is passed to, returning a tuple with an element computed by an
    // operator applied only to that parameter. The operator cannot
    // resolve until the parameter has settled, and the walk that settles
    // it comes later, so the site waits rather than committing.

    class C is
        init() is si

        squares() -> int => ([1, 2, 3] |> map(n => (n, n * n)) |> collect_mutable()).count;

        labelled() -> string =>
            [1, 2] |> map(n => ("k{n}", n * n)) |> map(p => "{p.`0}={p.`1}") |> join(",");

        negated() -> int =>
            [1, 2, 3] |> map(n => (n, -n)) |> map(p => p.`1) |> reduce(0, (a, b) => a + b);

        // A placeholder that settles in place rather than by a rule
        // running again: the element type of this empty constructor comes
        // from a later use of the tuple, and pinning the literal's return
        // to a type holding it is right once it has settled.
        accumulators() -> int is
            let start =
                [1, 2] |> map(n => (value = n, steps = Collections.LIST())) |> collect_mutable();

            start[0].steps.add("one");

            return start[0].steps.count;
        si

        lengths() -> string =>
            ["alpha", "be"] |> map(s => (s, s.length)) |> map(p => "{p.`0}:{p.`1}") |> join(" ");
    si

    entry() is
        let c = C();

        write_line("{c.squares()}");
        write_line(c.labelled());
        write_line("{c.negated()}");
        write_line("{c.accumulators()}");
        write_line(c.lengths());
    si
si
