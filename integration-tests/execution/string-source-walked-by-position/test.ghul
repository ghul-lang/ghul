use default

// A loop or fused chain over a string reads it by position: its length is
// fixed, so it is read once. A reversed string, which no reverse iterator
// takes, is read by position from the end. Each scenario runs fused and with
// fusion suppressed, and the two must agree.

reversed(s: string) -> string => s |> reverse() |> join()

reversed_unfused(s: string) -> string is
    @suppress("pipe-fusion")
    let text = s |> reverse() |> join()
    return text
si

luhn(s: string) -> int => s |> reverse() |> index() |> map(p => if p.index % 2 == 0 then int(p.value) - 48 else (int(p.value) - 48) * 2 fi) |> sum()

luhn_unfused(s: string) -> int is
    @suppress("pipe-fusion")
    let total = s |> reverse() |> index() |> map(p => if p.index % 2 == 0 then int(p.value) - 48 else (int(p.value) - 48) * 2 fi) |> sum()
    return total
si

skip_then(s: string) -> string => s |> reverse() |> skip(1) |> join()

for_reversed(s: string) -> string is
    let seen = LIST[char]()
    for c in s |> reverse() do seen.add(c) od
    seen |> join()
si

forward(s: string) -> int => s |> map(c => int(c)) |> sum()

write_line("{reversed("hello")} {reversed_unfused("hello")} {luhn("79927398713")} {luhn_unfused("79927398713")} {skip_then("abc")} {for_reversed("abc")} {forward("ab")} [{reversed("")}]")

plain(s: string) -> string is
    let seen = LIST[char]()

    for c in s do
        if c == 'l' then continue fi
        seen.add(c)
    od

    seen |> join()
si

write_line("{plain("hello")} {"hello" |> index() |> all(p => p.value != 'z' /\ p.index >= 0)}")
