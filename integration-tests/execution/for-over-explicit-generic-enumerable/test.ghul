// A .NET collection whose public GetEnumerator is the non-generic one, and
// which implements IEnumerable<T> explicitly, as MatchCollection and
// GroupCollection do, is iterated by a for loop as an Iterable[T].
use IO.Std.write_line

let matches = System.Text.RegularExpressions.Regex("(a)(.)").matches("abacad")

for m in matches do
    write_line(m.value)
od

for g in matches[0].groups do
    write_line("group {g.value}")
od
