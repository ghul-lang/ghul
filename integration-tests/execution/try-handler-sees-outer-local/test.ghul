use default

class THING(label: string public) is
    close() is write_line("closed {label}") si
si

in_a_finally() is
    let outer = THING("outer")

    try
        let outer = THING("inner")

        write_line("body sees {outer.label}")
    finally
        write_line("finally sees {outer.label}")

        outer.close()
    yrt
si

in_a_catch() is
    let outer = THING("outer")

    try
        let outer = THING("inner")

        write_line("body sees {outer.label}")

        throw System.Exception("thrown")
    catch e: System.Exception
        write_line("catch sees {outer.label}")
    yrt
si

in_a_catch_and_finally() is
    let outer = THING("outer")

    try
        let outer = THING("inner")

        throw System.Exception("thrown {outer.label}")
    catch e: System.Exception
        write_line("catch sees {outer.label}")
    finally
        write_line("finally sees {outer.label}")
    yrt
si

in_a_finally()
in_a_catch()
in_a_catch_and_finally()
