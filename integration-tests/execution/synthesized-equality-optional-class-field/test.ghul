use IO.Std.write_line;

class NODE is
    init() is si
si

union Holder is
    LINKED(next: NODE?);
si

entry() is
    let shared = NODE();
    let a: Holder = Holder.LINKED(shared);
    let b: Holder = Holder.LINKED(shared);
    let c: Holder = Holder.LINKED(NODE());
    let none1: Holder = Holder.LINKED(null);
    let none2: Holder = Holder.LINKED(null);

    write_line("same object: {a =~ b}");
    write_line("distinct objects: {a =~ c}");
    write_line("both absent: {none1 =~ none2}");
    write_line("one absent: {a =~ none1}");
    write_line("other absent: {none1 =~ a}");
si
