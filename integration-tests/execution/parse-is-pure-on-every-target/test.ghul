use default

// Tests: a scalar type's parse is pure on every target, so passing it, or
// a literal calling it, where a pure function is expected doesn't warn.

let total = ["1", "2"] |> count(s => int.parse(s) > 1)
let parsed = ["1", "2"] |> map(int.parse) |> list()
let doubles = ["1.5", "2.5"] |> map(double.parse) |> list()
let longs = ["3", "4"] |> map(s => long.parse(s)) |> list()

write_line("{total} {parsed} {doubles} {longs}")
