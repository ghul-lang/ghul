// A named function whose return's optional carrier differs from the
// formal's is eta-expanded, and the type argument the formal leaves
// open is inferred from the function's own return. Here no other
// argument binds it: the reference is the only argument, or the only
// one the type argument appears in.
namespace Test is
    use Std = IO.Std;

    first[U](next: () -> U?) -> U? => next();

    after[U](n: int, next: (int) -> U?) -> U? => next(n);

    seven() -> int? => 7;

    nothing() -> int? => null;

    word() -> string? => "word";

    halve(n: int) -> int? => if n % 2 == 0 then n / 2 else null fi;

    spell(n: int) -> string? => if n < 10 then "small" else null fi;

    class TOOLS is
        third(n: int) -> int? static => if n % 3 == 0 then n / 3 else null fi;
    si

    class Main is
        show_int(label: string, value: int?) static =>
            Std.write_line("{label}: {if value? then "{value}" else "nothing" fi}");

        show(label: string, value: string?) static =>
            Std.write_line("{label}: {value ?? "nothing"}");

        entry() static is
            show_int("no arguments present", first(seven));
            show_int("no arguments absent", first(nothing));
            show("no arguments reference", first(word));

            show_int("unrelated argument present", after(8, halve));
            show_int("unrelated argument absent", after(7, halve));
            show("unrelated argument reference", after(3, spell));
            show_int("static member", after(9, TOOLS.third));

            let inferred = first(seven);
            let doubled: int = (inferred ?? 0) * 2;
            Std.write_line("inferred as int: {doubled}");
        si
    si
si
