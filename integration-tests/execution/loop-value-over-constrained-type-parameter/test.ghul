use IO.Std.write_line

count_of[T: struct](xs: ARRAY[T?]) -> int => xs.count

names_of[T: class](xs: ARRAY[T?]) -> int => xs.count

first_value[T: struct](xs: ARRAY[T]) -> int is
    let found = for x in xs do break x od

    return count_of([found])
si

first_reference[T: class](xs: ARRAY[T]) -> int is
    let found = for x in xs do break x od

    return names_of([found])
si

entry() is
    write_line("{first_value([1, 2] |> ARRAY())}")
    write_line("{first_reference(["a", "b"] |> ARRAY())}")
si
