namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;
    use System.Threading.Tasks;

    // An inlined stage body is emitted by walking it where the fused loop
    // wants it, so every node whose emission generate-il completes - a
    // string interpolation, a cast, an if or case expression's block -
    // emits correctly, under a `for` loop and under a terminal consumer
    // alike. A nested literal that reads the stage parameter is the one
    // shape that still keeps its delegate, and answers the same either
    // way, so every case here is checked by its result.
    class Main is
        entry() static is
            let ns = LIST[int]([1, 2, 3]);
            let ys = LIST[string](["a", "b"]);
            let offset = 10;

            // interpolation
            for s in ns |> map(n => "<{n}>") do
                Std.write_line("for-interp {s}");
            od

            Std.write_line("consumer-interp {ns |> map(n => "<{n}>") |> collect_mutable() |> join(",")}");

            // cast
            for d in ns |> map(n => cast double(n)) do
                Std.write_line("for-cast {d}");
            od

            Std.write_line("consumer-cast {ns |> map(n => cast double(n)) |> collect_mutable() |> join(",")}");

            // if expression
            for s in ns |> map(n => if n > 2 then "big" else "small" fi) do
                Std.write_line("for-if {s}");
            od

            Std.write_line("consumer-if {ns |> map(n => if n > 2 then "big" else "small" fi) |> collect_mutable() |> join(",")}");

            // case expression
            for s in ns |> map(n => case n when 1 then "one" when 2 then "two" else "many" esac) do
                Std.write_line("for-case {s}");
            od

            // captured outer local
            for n in ns |> map(n => n + offset) do
                Std.write_line("for-outer {n}");
            od

            Std.write_line("consumer-outer {ns |> map(n => n + offset) |> collect_mutable() |> join(",")}");

            // struct member access after index()
            for v in ns |> index() |> map(iv => iv.index * 100 + iv.value) do
                Std.write_line("for-index {v}");
            od

            Std.write_line("consumer-index {ns |> index() |> map(iv => "{iv.index}:{iv.value}") |> collect_mutable() |> join(",")}");

            // a nested literal two deep, reading the stage parameter
            // after the inner one closes
            for f in ns |> map(n => (m: int) => ((k: int) => k)(m) + n) do
                Std.write_line("for-deep {f(100)}");
            od

            // a named function among a block body's statements reading
            // the stage parameter
            for f in ns |> map(n is
                add(m: int) -> int => m + n;

                return add;
            si) do
                Std.write_line("for-named {f(100)}");
            od

            // two stages, each with a nested literal
            for f in ns |> map(n => (m: int) => m + n) |> map(g => (m: int) => g(m) * 2) do
                Std.write_line("for-two {f(100)}");
            od

            // a fused chain inside a lambda, reading a local, a boxed
            // mut and a parameter of the enclosing method
            outer_locals(7, ns);

            // a chain in a generator and in an asynchronous function: the
            // statements become a state machine, which keeps the pipe
            // objects, so the stage is not inlined and still answers
            for w in generated(ys) do
                Std.write_line("for-generated {w}");
            od

            Std.write_line("consumer-async {awaited(ns).result}");

            // a nested literal reading the stage parameter: declined,
            // still correct through its delegate
            for f in ns |> map(n => (m: int) => m + n) do
                Std.write_line("for-nested {f(100)}");
            od

            Std.write_line("consumer-nested {ys |> filter(t => ys |> any(u => t =~ u)) |> collect_mutable() |> join(",")}");
        si

        // A generator keeps its loop as pipe objects, so a stage in one is
        // not inlined.
        generated(ys: LIST[string]) -> Ghul.Pipes.Pipe[string] static is
            for y in ys |> filter(t => t.length > 0) do
                yield "<{y}>";
            od
        si

        // As a generator does, for the same reason.
        awaited(ns: LIST[int]) -> Tasks.TASK[int] static is
            await Tasks.TASK.yield();

            let running mut = 0;

            for n in ns |> map(x => x * 2) do
                running = running + n;
            od

            return running;
        si

        // A fused chain written inside a lambda reads what the enclosing
        // method owns through that lambda's own frame chain, since the
        // inlined stage literal has no frame of its own.
        outer_locals(arg: int, ns: LIST[int]) static is
            let base mut = 100;

            let outer = () -> void is
                let inner = () -> void is
                    for n in ns |> map(x => x + arg + base) do
                        Std.write_line("outer-deep {n}");
                    od
                si;

                inner();

                for n in ns |> map(x => x + arg) do
                    Std.write_line("outer-arg {n}");
                od
            si;

            outer();

            base = 200;

            outer();
        si
    si
si
