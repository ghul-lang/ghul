// A `continue` from a `try` that begins a loop's body runs the `finally`
// before the next iteration, as a `break` and a fall-through do. Only .NET
// lost the finally here: the loop's start was the try's first instruction.
use default

entry() is
    let i mut = 0

    do
        try
            i = i + 1

            if i > 3 then
                break
            fi

            if i % 2 == 1 then
                continue
            fi

            write_line("body {i}")
        finally
            write_line("finally {i}")
        yrt
    od

    write_line("after the loop {i}")
si
