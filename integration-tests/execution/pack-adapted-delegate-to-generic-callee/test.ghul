use IO.Std.write_line;
use Ghul.Pipes;

// The step function is generic, so the pack adapter's wrapper closure
// takes its type from the callee's not-yet-bound return: an open
// generic. Memoizing that wrapper would bake the open instantiation
// into the wrapper's cache-field signature, and an open generic in a
// static field signature fails to load at run time.
marked_stream[T, S..](initial: S, advance: S.. -> STREAM[T, S]) -> T{} is
    return STREAM_PIPE[T, S](initial, advance);
si

fibonacci(limit: int) -> int{} is
    marked_stream(
        (0, 1),
        (previous, current) => previous || (current, previous + current)
    ) |> take(limit)
si

entry(env: Ghul.Environment) is
    let fib = fibonacci(10);

    let total = fib |> reduce(0, (a: int, b: int) => a + b);

    write_line("fib sum = {total}");
si
