// A fused loop in a generator or asynchronous body keeps its iterator, its
// counters and its stage delegates in frame fields, so they survive the
// suspensions in the loop body, and inlines its stages as anywhere else.
use default

double(x: int) -> int => x * 2

evens(xs: List[int], k: int) -> int{} is
    let bump mut = 0

    for x in xs |> map(x => x + k) |> filter(x => x % 2 == 0) do
        bump = bump + 1
        yield x * 100 + bump
    od
si

windowed(xs: List[int]) -> string{} is
    for (i, x) in xs |> skip(1) |> take(3) |> index() do
        yield "{i}:{x}"
    od
si

delegated(xs: List[int]) -> int{} is
    let f = double

    for x in xs |> map(f) |> map(double) do
        yield x
    od
si

nested(rows: List[List[int]]) -> int{} is
    for row in rows |> filter(r => r.count > 1) do
        for x in row |> map(x => x + row.count) do
            yield x
        od
    od
si

class SCALER is
    _n: int
    init(n: int) is _n = n si

    scaled(xs: List[int]) -> int{} is
        for x in xs |> map(x => x * _n) do
            yield x
        od
    si
si

total_async(xs: List[int]) -> Tasks.TASK[int] is
    let total mut = 0

    for x in xs |> map(x => x * 3) |> take(3) do
        total = total + await Tasks.TASK.from_result(x)
    od

    return total
si

let xs = [1, 2, 3, 4, 5]
write_line(evens(xs, 1) |> join(","))
write_line(evens(xs, 1) |> join(","))
write_line(windowed(xs) |> join(","))
write_line(delegated(xs) |> join(","))
write_line(nested([[1, 2], [3], [4, 5, 6]]) |> join(","))
write_line(SCALER(3).scaled(xs) |> join(","))
write_line("{total_async(xs).result}")
