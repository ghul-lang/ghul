// Reading a later tuple element through a pipe when an earlier element is
// typed by a method type parameter must not corrupt memory: the lifted
// lambda's signature is written in capture order, so every member of the
// chain has to agree on which type parameter each index names.
use IO.Std.write_line;
use Collections.Iterable;
use Ghul.Pipes;

tag[T, K](items: Iterable[T], key: K) -> T{} =>
    items |> map(item => (k = key, v = item)) |> map(pair => pair.v);

// capture order reversed: the lambda body reads item before key
tag_reversed[T, K](items: Iterable[T], key: K) -> T{} =>
    items |> map(item => (v = item, k = key)) |> map(pair => pair.v);

// the decorated values must survive intact, not just the unwrapped ones
read_all[T, K](items: Iterable[T], key: K) -> K{} =>
    items |> map(item => (k = key, v = item)) |> map(pair => pair.k);

decorate_sort_undecorate[T, K: Ghul.Comparable[K]]
    (items: Iterable[T], key: (T) -> K pure) -> T{}
=>
    items
        |> map(item => (key = key(item), item))
        |> sort_by(pair => pair.key)
        |> map(pair => pair.item);

entry() is
    write_line(["bb", "a"] |> tag(7) |> join(", "));
    write_line(["bb", "a"] |> tag_reversed(7) |> join(", "));
    write_line(["bb", "a"] |> read_all(7) |> join(", "));
    write_line(["pear", "apple", "fig"]
        |> decorate_sort_undecorate((s: string) => s.length)
        |> join(", "));
si
