// A generic `T?` formal nested inside a function type is taken
// literally by the CLR: `(int) -> U?` is `Func<int, MAYBE<U>>`, and a
// `Func<int, string?>` is not that delegate for any U. A function value
// whose type is already fixed - here a literal with its return written
// out - is presented through a thunk that converts its return to the
// formal's carrier.
namespace Test is
    use Std = IO.Std;

    bind[T, U](value: T?, f: (T) -> U?) -> U? =>
        if value? then f(value) else null fi;

    class Main is
        entry() static is
            let absent = bind(30, (n: int) -> string? => null);
            let present = bind(30, (n: int) -> string? => "n={n}");

            Std.write_line("{absent ?? "none"} {present ?? "none"}");
        si
    si
si
