// A control construct owns a `use` in its header. A `for` source is
// disposed when the loop ends, however it ends. An `if` or `elif`
// condition is disposed after the whole `if`, and a `case` subject or guard
// after the whole `case`. A loop used as a value has its source disposed
// when the statement holding the loop ends. A `use` anywhere else still
// belongs to the enclosing block.
use default

class SRC: Ghul.Disposable, Iterable[int] is
    _name: string

    init(name: string) is
        _name = name
        write_line("  open {name}")
    si

    iterator: Iterator[int] => [1, 2, 3].iterator

    dispose() is
        write_line("  dispose {_name}")
    si
si

loop_to_the_end() is
    write_line("for, to the end:")

    for x in use SRC("for") do
        write_line("  {x}")
    od

    write_line("  after the loop")
si

loop_with_a_return() -> int is
    write_line("for, with a return:")

    for x in use SRC("returning") do
        if x == 2 then
            return x
        fi
    od

    write_line("  not reached")
    0
si

loop_with_an_exception() is
    write_line("for, with an exception:")

    try
        for x in use SRC("throwing") do
            throw Ghul.Exception("stop at {x}")
        od
    catch e: Ghul.Exception
        write_line("  caught {e.message}")
    yrt

    write_line("  after the try")
si

if_condition() is
    write_line("if:")

    if use SRC("if") |> any(x => x > 2) then
        write_line("  in the then arm")
    else
        write_line("  in the else arm")
    fi

    write_line("  after the if")
si

elif_chain() is
    write_line("elif:")

    if use SRC("first") |> any(x => x > 5) then
        write_line("  first arm")
    elif use SRC("second") |> any(x => x > 2) then
        write_line("  second arm")
    fi

    write_line("  after the if")
si

if_let() is
    write_line("if let:")

    if let source = use SRC("if let") then
        write_line("  in the arm, count {source |> count()}")
    fi

    write_line("  after the if")
si

case_subject() is
    write_line("case:")

    case use SRC("case") |> count()
    when 3 then write_line("  three")
    else write_line("  other")
    esac

    write_line("  after the case")
si

loop_as_a_value() is
    write_line("a loop as a value:")

    let found = for x in use SRC("value") do
        if x == 2 then
            break x
        fi
    od

    write_line("  found {found}")
si

generated() -> int{} is
    for x in use SRC("generator") do
        yield x
    od
si

yield_inside_the_loop() is
    write_line("yield inside a for:")
    let it = generated().iterator
    it.move_next()
    write_line("  first {it.current}")
    it.dispose()
    write_line("  all {generated() |> count()}")
si

case_guard() is
    write_line("case guard:")

    let subject: object = 3

    case subject
    when n: int /\ use SRC("guard") |> count() == n then write_line("  matched")
    else write_line("  no match")
    esac

    write_line("  after the case")
si

block_still_owns_the_rest() is
    write_line("an argument still belongs to the block:")

    write_line("  count {use SRC("argument") |> count()}")
    write_line("  after the statement")
si

entry() is
    loop_to_the_end()
    write_line("  returned {loop_with_a_return()}")
    loop_with_an_exception()
    if_condition()
    elif_chain()
    if_let()
    case_subject()
    loop_as_a_value()
    yield_inside_the_loop()
    case_guard()
    block_still_owns_the_rest()
si
