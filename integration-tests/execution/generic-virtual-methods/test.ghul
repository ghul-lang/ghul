// Virtual class methods generic in their own right, called through a
// reference typed as the base class: an abstract one each subclass
// overrides, one a subclass inherits and one it overrides, each called at
// two instantiations, a generic method of a generic class, a call through
// a trait the class also implements, and the visitor shape.
use IO.Std.write_line

trait Visitor[T] is
    visit_number(value: int) -> T;
    visit_add(left: Expression, right: Expression) -> T;
si

trait Described is
    describe[T](make: string -> T) -> T;
si

class Expression: Described abstract is
    accept[T](visitor: Visitor[T]) -> T

    tag[T](value: T) -> string => "expression {value}"

    describe[T](make: string -> T) -> T => make("expression")
si

class NUMBER: Expression is
    _value: int

    init(value: int) is
        _value = value
    si

    accept[T](visitor: Visitor[T]) -> T => visitor.visit_number(_value)
si

class ADD: Expression is
    _left: Expression
    _right: Expression

    init(left: Expression, right: Expression) is
        _left = left
        _right = right
    si

    accept[T](visitor: Visitor[T]) -> T => visitor.visit_add(_left, _right)

    tag[T](value: T) -> string => "add {value}"

    describe[T](make: string -> T) -> T => make("add")
si

class EVALUATE: Visitor[int] is
    init() is si

    visit_number(value: int) -> int => value
    visit_add(left: Expression, right: Expression) -> int => left.accept(self) + right.accept(self)
si

class SHOW: Visitor[string] is
    init() is si

    visit_number(value: int) -> string => "{value}"
    visit_add(left: Expression, right: Expression) -> string => "({left.accept(self)} + {right.accept(self)})"
si

class BOX[U] is
    _item: U

    init(item: U) is
        _item = item
    si

    item: U => _item

    convert[V](make: U -> V) -> V => make(_item)
si

class LOUD_BOX[U]: BOX[U] is
    init(item: U) is
        super.init(item)
    si

    convert[V](make: U -> V) -> V is
        write_line("loud {item}")

        return make(item)
    si
si

entry() is
    let expressions: Expression[] = [NUMBER(3), ADD(NUMBER(1), ADD(NUMBER(2), NUMBER(4)))]

    for expression in expressions do
        write_line("{expression.accept(SHOW())} = {expression.accept(EVALUATE())}")
        write_line("{expression.tag(7)}, {expression.tag("seven")}")
        write_line(expression.describe(text => text.length))
    od

    let described: Described[] = [NUMBER(1), ADD(NUMBER(1), NUMBER(2))]

    for d in described do
        write_line(d.describe(text => "<{text}>"))
    od

    let quiet: BOX[int] = BOX(5)
    let loud: BOX[int] = LOUD_BOX(6)

    for box in [quiet, loud] do
        write_line(box.convert(n => n * 10))
        write_line(box.convert(n => "#{n}"))
    od
si
