// Code units of a string copied into an array of char, in one move.
use IO.Std.write_line

@intrinsic("string.copy_to")
copy_to(text: string, start: int, chars: char[], at: int, count: int) is
si

@intrinsic("string.from_chars")
from_chars(chars: char[], start: int, count: int) -> string => "not lowered"

entry() is
    let chars = ['.', '.', '.', '.', '.', '.', '.', '.']

    copy_to("ghul", 0, chars, 2, 4)
    write_line(from_chars(chars, 0, 8))

    copy_to("abcdef", 3, chars, 0, 2)
    write_line(from_chars(chars, 0, 8))

    copy_to("xyz", 0, chars, 7, 0)
    write_line(from_chars(chars, 0, 8))

    let long = 0..100_000 |> Ghul.Pipes.map(i => cast char(65 + i % 26)) |> ARRAY()
    let text = from_chars(long, 0, 100_000)
    let into = 0..100_002 |> Ghul.Pipes.map(_ => '-') |> ARRAY()

    copy_to(text, 1, into, 1, 99_999)

    write_line("{into[0]} {into[1]} {into[99_999]} {into[100_000]} {into[100_001]}")
si
