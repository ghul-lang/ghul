use default

// An untyped literal parameter takes the type of the slot the literal goes
// into, even where the body's own use of it would settle a narrower one.
class THING is
    init() is si
si

drop_where(condition: (string, THING?) -> bool) -> bool => condition("x", null)

run(target: THING) -> bool => drop_where((_, walked) => walked == target)

entry() is
    write_line("{run(THING())}")
si
