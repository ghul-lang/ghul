namespace Test is
    use Collections;
    use Std = IO.Std;

    // Two generic overloads whose formals are related by subtyping.
    // Both bind T, so both score alike, and the choice falls to the
    // tie-breaks: `LIST[int]` is the type the value has, `List[int]`
    // a contract it satisfies, so the former widened it less.
    describe[T](x: List[T]) -> string => "List";
    describe[T](x: LIST[T]) -> string => "LIST";

    // The same relationship where the more specific formal is an
    // array. Nothing here is special-cased for arrays: `ARRAY[T]` sits
    // below `T[]` in the same graph the other pair is ranked in.
    element[T](x: T[]) -> string => "List";
    element[T](x: ARRAY[T]) -> string => "array";

    // A bare type variable accepts anything at all, so an overload
    // set carrying one is nothing but ties. Bound to the actual's own
    // type it is an exact match, which beats reaching the actual
    // through a trait it implements.
    accept[T](x: T) -> string => "T";
    accept[T](x: List[T]) -> string => "List";

    class Main is
        entry() static is
            Std.write_line(describe(LIST[int]()));
            Std.write_line(element([1, 2, 3]));
            Std.write_line(accept(LIST[int]()));

            return;
        si
    si
si
