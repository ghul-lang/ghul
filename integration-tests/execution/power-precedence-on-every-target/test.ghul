// An operator opening with `**` binds tighter than multiplication, groups
// to the left, and gives way to a prefix operator, whatever type declares it.

use IO.Std.write_line

// `a ** b` is `a` followed by `b`'s digits, so the result shows the grouping.
struct D(v: int public) is
    **(other: D) -> D => D(v * 10 + other.v)
    *(other: D) -> D => D(v * other.v)
    +(other: D) -> D => D(v + other.v)
    to_string() -> string => "{v}"
si

-(d: D) -> D => D(-d.v)

let one = D(1)
let two = D(2)
let three = D(3)

write_line("{two * three ** one}")          // 2 * 31 = 62
write_line("{two ** three * one}")          // 23 * 1 = 23
write_line("{one + two ** three}")          // 1 + 23 = 24
write_line("{(one ** two) ** three}")       // 123
write_line("{one ** (two ** three)}")       // 1 ** 23 = 33
write_line("{-two ** three}")               // (-2) ** 3 = -17
