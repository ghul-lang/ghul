use default

// a generator whose => body is a parenthesized block yields from the function
pair() => (
    yield 1
    yield 2
)

counted(n: int) -> int{} => (
    let i mut = 0
    while i < n do
        yield i * 10
        i = i + 1
    od
)

// a yield inside a block that sits in an is-bodied generator
in_generator() -> int{} is
    let x = (yield 7; 8)
    yield x
si

// a valued last statement in a generator's body is discarded
with_tail() -> int{} => (
    yield 9
    10
)

let letters = () => (
    yield "a"
    yield "b"
)

class Resource: Ghul.Disposable is
    name: string
    init(name: string) is self.name = name si
    dispose() is write_line("disposed {name}") si
si

disposing() -> int{} => (
    let use r = Resource("r")
    yield 1
    yield 2
)

let_in_disposing() -> int{} => let use r = Resource("s") in (
    yield 3
    yield 4
)

write_line(pair() |> join(","))
write_line(counted(3) |> join(","))
write_line(in_generator() |> join(","))
write_line(with_tail() |> join(","))
write_line(letters() |> join(","))
write_line(disposing() |> join(","))
write_line(let_in_disposing() |> join(","))
