use default

// A recursive literal calls itself before its body has said what it
// returns. The void one ends on an if with no else whose only value is
// the self-call; the value one uses the self-call in arithmetic ahead
// of any return.
let countdown = (n: int) rec is
    write_line("{n}")
    if n > 0 then
        rec(n - 1)
    fi
si

let factorial = (n: int) rec => if n <= 1 then 1 else n * rec(n - 1) fi

let depth = (xs: int[], i: int) rec is
    if i >= xs.count then
        return 0
    fi

    return 1 + rec(xs, i + 1)
si

countdown(2)
write_line("factorial {factorial(5)}")
write_line("depth {depth([7, 8, 9], 0)}")
