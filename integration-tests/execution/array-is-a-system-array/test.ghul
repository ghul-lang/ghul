use IO.Std.write_line

describe(a: System.Array) -> string => "{a.length} of rank {a.rank}"

let from = [1ub, 2ub, 3ub]
let to = [0ub, 0ub, 0ub]
let words = ["a", "b", "c"]
let maybe: ARRAY[int]? = [1, 2]
let nothing: ARRAY[int]? = null

System.Buffer.block_copy(from, 0, to, 0, 3)
System.Array.reverse(words)

let held: System.Array = words
let present: System.Array? = maybe
let absent: System.Array? = nothing

write_line("{to[0]} {to[1]} {to[2]}")
write_line("{words[0]} {words[2]}")
write_line(describe(from))
write_line(describe([[1, 2], [3]]))
write_line("{held.length} {present?} {absent?}")
