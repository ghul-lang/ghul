use default

trait Animal is
    name: string;
si

class Cat(name: string public): Animal is si
class Dog(name: string public): Animal is si

let tom = Cat("tom")
let rex = Dog("rex")

// Each value is tried against five spellings of one pattern: a tuple type
// on the whole, on each inner group, or spread to the leaves, as well as
// both inner orders. A wide scrutinee is tested element by element; an
// object holding a tuple is tested against the tuple type exactly.
let values: ((Animal, Animal), (Animal, Animal))[] = [
    ((tom, rex), (rex, tom)),
    ((rex, rex), (rex, tom)),
    ((tom, tom), (rex, tom)),
    ((tom, rex), (tom, tom)),
    ((tom, rex), (rex, rex)),
    ((rex, tom), (tom, rex))
]

show(a: Animal, b: Animal, c: Animal, d: Animal) -> string => "{a.name} {b.name} {c.name} {d.name}"

wide(s: ((Animal, Animal), (Animal, Animal))) -> string is
    let results = LIST[string]()

    if let ((a, b), (c, d)): ((Cat, Dog), (Dog, Cat)) = s then results.add("outer {show(a, b, c, d)}") else results.add("outer -") fi
    if let ((a, b): (Cat, Dog), (c, d): (Dog, Cat)) = s then results.add("inner {show(a, b, c, d)}") else results.add("inner -") fi
    if let ((a: Cat, b: Dog), (c: Dog, d: Cat)) = s then results.add("leaves {show(a, b, c, d)}") else results.add("leaves -") fi

    let arm =
        case s
        when ((a, b), (c, d)): ((Cat, Dog), (Dog, Cat)) then "case {show(a, b, c, d)}"
        else "case -"
        esac

    results.add(arm)

    let swapped =
        case s
        when ((a, b): (Dog, Cat), (c, d): (Cat, Dog)) then "swapped {show(a, b, c, d)}"
        when ((a, b), (c, d)): ((Cat, Dog), (Dog, Cat)) then "unswapped"
        else "neither"
        esac

    results.add(swapped)

    return results |> join(", ")
si

boxed(s: object) -> string is
    let results = LIST[string]()

    if let ((a, b), (c, d)): ((Cat, Dog), (Dog, Cat)) = s then results.add("outer {show(a, b, c, d)}") else results.add("outer -") fi
    if let ((a, b): (Cat, Dog), (c, d): (Dog, Cat)) = s then results.add("inner {show(a, b, c, d)}") else results.add("inner -") fi
    if let ((a: Cat, b: Dog), (c: Dog, d: Cat)) = s then results.add("leaves {show(a, b, c, d)}") else results.add("leaves -") fi

    let arm =
        case s
        when ((a: Cat, b: Dog), (c: Dog, d: Cat)) then "case {show(a, b, c, d)}"
        else "case -"
        esac

    results.add(arm)

    return results |> join(", ")
si

for v in values do
    write_line(wide(v))
od

write_line(boxed(((tom, rex), (rex, tom))))
write_line(boxed(((rex, rex), (rex, tom))))
write_line(boxed("not a tuple"))

// An object pair: each half is tested against its group's tuple type.
let pair: (object, object) = ((tom, rex), (rex, tom))

if let ((a: Cat, b: Dog), (c: Dog, d: Cat)) = pair then write_line("pair {show(a, b, c, d)}") fi

// Untyped nested patterns take their types from the value.
let inferred = ((tom, rex), (rex, tom))
let ((p, q), (r, t)) = inferred
write_line("untyped {p.name} {q.name} {r.name} {t.name}")

// A leaf test against a value type, through an optional.
let maybes: (int?, string)[] = [(1, "one"), (null, "none")]

for m in maybes do
    if let (x: int, y) = m then write_line("int {x} {y}") else write_line("absent") fi
od

// let and for: a tuple type spreads, and each element converts to its type.
let (total, count): (double, long) = (3, 4)
write_line("{total / 2.0} {count}")

for (l, n): (double, long) in [(1, 2), (5, 6)] do
    write_line("for {l / 2.0} {n}")
od

for (l: double, n) in [(1, 2)] do
    write_line("leaf {l / 2.0} {n}")
od

let comprehended = [l / 2.0 for (l, n): (double, int) in [(1, 2), (3, 4)]]
write_line("{comprehended}")
