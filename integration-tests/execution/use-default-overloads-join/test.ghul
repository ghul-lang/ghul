// A function the default set imports is another overload of the same
// name from anywhere else: a declaration of the program's own, or an
// explicit `use`. Only one taking the same parameters as an explicit
// overload gives way to it.
namespace Own is
    use default

    reverse(text: string) -> string =>
        text |> map(c => c) |> reverse() |> string()

    report() is
        write_line("own {reverse("abc")}")
    si
si

namespace Wildcard is
    use default
    use System.Math.*

    report() is
        let xs = [3, 1, 2]
        write_line("wildcard {min(4, 5)} {xs |> min()!} {xs |> max()!}")
    si
si

namespace Test is
    entry() is
        Own.report()
        Wildcard.report()
    si
si
