use default

// A join that names no separator fuses like the two-argument one, its
// separator read from the Ghul.Pipes.JOIN_SEPARATOR the runtime
// declares, so the fused text and the runtime's own join agree.
let words = ["alpha", "beta", "gamma"]
let xs = [1, 2, 3]

write_line(words |> join())
write_line(words |> filter(w => w.length > 4) |> join())
write_line(xs |> map(n => n * 2) |> join())
write_line([] |> join() |> string())
write_line(words |> join("-"))
