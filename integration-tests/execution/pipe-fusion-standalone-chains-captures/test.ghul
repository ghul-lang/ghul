// A standalone chain reads what its stages capture through the generator's
// parameters: a local, a parameter, the receiver, and a mutable local as the
// box it is shared through, so a write in a stage or a later assignment is
// seen exactly as it would be by the pipe objects.
use default

class SCALE is
    _n: int
    init(n: int) is _n = n si

    scaled(xs: List[int]) -> int{} => xs |> map(x => x * _n) |> filter(x => x > _n)
si

offset(xs: List[int], k: int) -> int{} => xs |> map(x => x + k)

counting(xs: List[int]) -> string is
    let seen mut = 0
    let marked = xs |> map(x => (seen = seen + 1; x * 10 + seen))
    let first = marked |> join(",")
    let second = marked |> join(",")
    "{first} {second} {seen}"
si

late(xs: List[int]) -> string is
    let limit mut = 1
    let over = xs |> filter(x => x > limit)
    limit = 3
    over |> join(",")
si

let xs = [1, 2, 3, 4, 5]
let base = 100
let shifted = xs |> map(x => x + base)

write_line(shifted |> join(","))
write_line(offset(xs, 7) |> join(","))
write_line(SCALE(2).scaled(xs) |> join(","))
write_line(counting(xs))
write_line(late(xs))
write_line([[1, 2], [3]] |> map(row => (row |> map(x => x + row.count)) |> sum()) |> join(","))
