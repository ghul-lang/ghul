// Enum members combined with |, & and ^ are a compile-time constant in an
// attribute argument, for an enum the program declares and for a .NET one.
@System.Flags()
enum Shade is
    NONE = 0,
    RED = 1,
    GREEN = 2,
    BLUE = 4
si

class TagAttribute: System.Attribute is
    shade: Shade
    init(shade: Shade) is self.shade = shade si
si

@System.AttributeUsage(System.AttributeTargets.CLASS | System.AttributeTargets.METHOD)
class MarkAttribute: System.Attribute is
    init() is si
si

@TagAttribute(Shade.RED | Shade.BLUE)
class Either is
    init() is si
si

@TagAttribute((Shade.RED | Shade.GREEN) & Shade.GREEN)
class Both is
    init() is si
si

@TagAttribute(Shade.RED ^ Shade.BLUE ^ Shade.RED)
class Flipped is
    init() is si
si

entry() is
    show(typeof Either)
    show(typeof Both)
    show(typeof Flipped)

    let usage = cast System.AttributeUsageAttribute((typeof MarkAttribute).get_custom_attributes(typeof System.AttributeUsageAttribute, false)[0])

    IO.Std.write_line("MarkAttribute is valid on {usage.valid_on}")
si

show(type: System.Type) is
    let tag = cast TagAttribute(type.get_custom_attributes(typeof TagAttribute, false)[0])

    IO.Std.write_line("{type.name}: {tag.shade}")
si
