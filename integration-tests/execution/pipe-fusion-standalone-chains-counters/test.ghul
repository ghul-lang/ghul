// A standalone chain with take, skip and index stages keeps their counters in
// its generator's frame, starting them afresh on every read from the count or
// start evaluated where the chain is written.
use default

let xs = [10, 20, 30, 40, 50]
let n mut = 2
let firsts = xs |> take(n)
n = 4
write_line(firsts |> join(","))
write_line(firsts |> join(","))

let middle = xs |> skip(1) |> take(3) |> map(x => x + 1)
write_line(middle |> join(","))

let numbered = xs |> index() |> map(iv => "{iv.index}:{iv.value}")
write_line(numbered |> join(" "))
write_line(numbered |> join(" "))

let from_five = xs |> index(5) |> filter(iv => iv.index % 2 == 1) |> map(iv => iv.value)
write_line(from_five |> join(","))

let squares = from(1) |> map(i => i * i) |> take(5)
write_line(squares |> join(","))
write_line(squares |> chunk(2) |> map(c => c |> join("+")) |> join(" "))
