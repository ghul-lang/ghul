use default

shout(s: string) is write_line("shout {s}") si
shout(n: int) is write_line("shout {n}") si

show[T](x: T) is write_line("show {x}") si

apply(v: string, f: string -> void) is f(v) si

entry() is
    apply("one", shout)
    apply("two", show)

    ["three"] |> each(shout)
    ["four"] |> each(show)
si
