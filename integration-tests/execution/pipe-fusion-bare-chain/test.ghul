// A consumer whose chain has no stage between it and its source fuses
// like any other: the loop reads the source and applies the consumer.
// A source that is itself read once, a generator or a call, reads the
// same fused as unfused, so each shape below prints what the pipe
// objects would have produced.
use default
use Ghul.Pipes

counting(limit: int) -> int{} is
    let i mut = 0

    while i < limit do
        yield i

        i = i + 1
    od
si

three() -> Collections.List[int] => [3, 1, 2]

entry() is
    let xs = [3, 1, 2]

    write_line("{xs |> reduce(0, (running, x) => running + x)}")
    write_line("{xs |> sum()}")
    write_line("{xs |> sum_by(x => x * 10)}")
    write_line("{xs |> join(",")}")
    write_line("{xs |> join()}")
    write_line("{(xs |> collect()).count}")
    write_line("{(xs |> collect_mutable()).count}")
    write_line("{xs |> any(x => x > 2)}")
    write_line("{xs |> all(x => x > 2)}")
    write_line("{xs |> first()}")
    write_line("{xs |> find(x => x < 2)}")

    // `count` is the one consumer left on the ordinary lowering, since
    // the runtime reads `source.count` for a sized source, so this line
    // pins the answer where the ones around it pin the fused lowering.
    write_line("{xs |> count()}")

    xs |> each(x => write_line("each {x}"))

    // A generator and a call as the bare source: one fresh read each,
    // which is what the unfused consumer does too.
    write_line("{counting(4) |> sum()}")
    write_line("{three() |> reduce(0, (running, x) => running + x)}")

    // Reading the same generator twice starts it afresh both times.
    let twice = counting(3)

    write_line("{twice |> sum()} {twice |> sum()}")

    // An empty source: the seed and the identity, not an absent value.
    let none: int[] = []

    write_line("{none |> sum()} {none |> reduce(7, (running, x) => running + x)}")
    write_line("{none |> any(x => true)} {none |> all(x => false)}")
si
