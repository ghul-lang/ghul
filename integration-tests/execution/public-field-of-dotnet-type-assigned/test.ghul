// A public field of a type from a .NET assembly not built by ghūl follows
// .NET's rule: it can be assigned unless it is read-only.
use IO.Std.write_line

class HOLDER is
    v: System.Numerics.Vector2 field

    init() is
        v = System.Numerics.Vector2(1.0s, 2.0s)
    si
si

let p mut = System.Numerics.Vector2(1.0s, 2.0s)
p.x = 5.0s
write_line("struct local: {p.x}")

let h = HOLDER()
h.v.x = 9.0s
write_line("struct in a ghul field: {h.v.x}")

let box = System.Runtime.CompilerServices.StrongBox[int](1)
box.value = 3
write_line("class instance: {box.value}")
