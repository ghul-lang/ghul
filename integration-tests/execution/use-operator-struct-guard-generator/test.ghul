use IO.Std.write_line

struct GUARD: Ghul.Disposable is
    _active: bool

    init() is
        _active = true
    si

    commit() is
        _active = false
    si

    dispose() is
        if _active then
            write_line("  roll back")
        else
            write_line("  nothing to roll back")
        fi
    si
si

committed_across_a_yield() -> int{} is
    let guard = use GUARD()
    yield 1
    guard.commit()
    yield 2
si

not_committed_across_a_yield() -> int{} is
    let guard = use GUARD()
    yield 1
    yield 2
si

write_line("committed across a yield:")
for n in committed_across_a_yield() do
    write_line("  yielded {n}")
od

write_line("not committed across a yield:")
for n in not_committed_across_a_yield() do
    write_line("  yielded {n}")
od
