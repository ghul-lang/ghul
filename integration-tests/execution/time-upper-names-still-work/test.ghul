use IO.Std.write_line

// The UPPER_SNAKE_CASE spellings of the time types are second names for the
// PascalCase ones.

let start: Time.DateTime = Time.DATE_TIME(2024, 2, 28)
let same: Time.DATE_TIME = start
let span: Time.TIME_SPAN = Time.TimeSpan.from_hours(36.0)
let offset: Time.DATE_TIME_OFFSET = Time.DateTimeOffset(start, Time.TimeSpan.zero)
let watch: Time.STOPWATCH = Time.Stopwatch.start_new()

write_line("{same.add_days(2.0).day} {span.total_hours} {offset.year} {watch.is_running}")
