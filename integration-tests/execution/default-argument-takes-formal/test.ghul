use default

// Tests: a bare `_` argument takes its type from the formal it stands in,
// chosen by the written arguments; for a .NET optional parameter it takes
// the declared default value, not the type's zero.

scale(a: int, by: int) -> int => a * by

describe(a: int, b: int) -> string => "int {b}"
describe(a: string, b: string?) -> string => if b? then "string {b}" else "string none" fi

write_line("{scale(3, _)}")
write_line("{describe(1, _)}")
write_line("{describe("x", _)}")
write_line("{"a,b,c".split(",", _).count}")
