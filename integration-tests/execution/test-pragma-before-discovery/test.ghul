namespace Test is
    use IO.Std.write_line

    class Checks is
        init() is si

        @test()
        adds() is
            write_line("adds: {1 + 1}")
        si
    si

    @test()
    global_check() is
        write_line("global check")
    si

    entry() is
        Checks().adds()
        global_check()
    si
si
