namespace Library is
    sum(source: Collections.Iterable[int]) -> int is
        let total mut = 0;
        for i in source do
            total = total + i;
        od
        return total;
    si
si

namespace Test is
    use IO.Std.write_line;
    use Library.sum;

    // Tests: an overloaded function name passed where a pack's function
    // is expected. The group holds a one-parameter overload imported from
    // another namespace and a local overload of the pack's elements. The
    // tuple the pack binds to fits neither as one argument, so the member
    // of its elements is chosen and presented in the slot's shape, as a
    // lone function of the elements would be.

    apply[T.., U](f: T.. -> U, arguments: T..) -> U => f(arguments);

    sum(a: int, b: int) -> int => a + b;

    entry() is
        write_line("{apply(sum, 1, 2)}");
        write_line("{apply(sum, (3, 4))}");
        write_line("{sum([5, 6, 7])}");
    si
si
