use default
use Ghul.Functional.`>>

// A literal stored in a local with untyped parameters, composed through
// a pack operator whose pack only the later call of the result pins, is
// typed from that call.
double(x: int) -> int => x * 2

let plus = (a, b) => a + b
let composed = plus >> double

write_line("{composed(1, 2)}")
