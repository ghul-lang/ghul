use default

// Each inner function literal captures the parameter of the one around
// it, so its closure frame is created inside a closure body of a generic
// function.
multiply(left, right) =>
    left |> map(row => (0..right[0].count) |> map(column => (0..right.count) |> map(i => row[i] * right[i][column]) |> sum()) |> list()) |> list()

pick[T](rows: T[][], columns: int[]) -> T[][] =>
    rows |> map(row => columns |> map(i => row[i]) |> list()) |> list()

write_line("{multiply([[1, 2], [3, 4]], [[5, 6], [7, 8]])}")
write_line("{pick([["a", "b"], ["c", "d"]], [1, 0])}")
