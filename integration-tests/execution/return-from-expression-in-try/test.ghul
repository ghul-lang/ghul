use IO.Std.write_line

f(a: int, b: int) -> int => a + b

// The return inside the argument stores its value and leaves through the
// finally only when it is taken.
returns_in_try(c: bool) -> int is
    try
        let x = f(1, if c then return 77 else 2 fi)
        write_line("x {x}")
    finally
        write_line("finally")
    yrt

    return 5
si

breaks_with_value_in_try(c: bool) -> int? =>
    for i in 0..3 do
        try
            let _ = f(i, (if c /\ i == 1 then break i * 10 fi; 2))
        finally
            write_line("finally {i}")
        yrt
    od

entry() is
    write_line("{returns_in_try(true)}")
    write_line("{returns_in_try(false)}")
    write_line("{breaks_with_value_in_try(true)}")
    write_line("{breaks_with_value_in_try(false)}")
si
