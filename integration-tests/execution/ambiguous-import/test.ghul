namespace Left is
    class Box is
        init() is si
        to_string() -> string => "Left.Box"
    si

    class Shared is
        init() is si
        to_string() -> string => "Left.Shared"
    si

    class Maker is
        init() is si
        to_string() -> string => "Left.Maker"
    si

    pick(x: int) -> string => "Left.pick"
si

namespace Right is
    class Box is
        init() is si
        to_string() -> string => "Right.Box"
    si

    class Shared is
        init() is si
        to_string() -> string => "Right.Shared"
    si

    pick(x: string) -> string => "Right.pick"

    Maker() -> string => "Right.Maker"
si

namespace Unambiguous is
    class Only is
        init() is si
        to_string() -> string => "Unambiguous.Only"
    si
si

namespace LeftFirst is
    use IO.Std.write_line

    use Left
    use Right
    use Unambiguous

    run() is
        // a type both namespaces declare, as a value and as a type
        let box = Box()
        let typed: Box = box
        write_line("{box} {typed}")

        // functions of one name stay one overload group
        write_line("{pick(1)} {pick("s")}")

        // a type in one namespace and a function in the other
        write_line("{Maker()}")

        // a name one namespace declares
        write_line("{Only()}")
    si
si

namespace RightFirst is
    use IO.Std.write_line

    use Right
    use Left

    run() is
        write_line("{Box()}")
    si
si

namespace ByName is
    use IO.Std.write_line

    use Left
    use Right
    use Right.Shared

    run() is
        // a by-name import is not ambiguous with a whole-namespace one
        write_line("{Shared()}")
    si

    shadowed() is
        // nor is a local of the same name
        let Box = "local"
        write_line("{Box}")
    si
si

namespace Program is
    entry() is
        LeftFirst.run()
        RightFirst.run()
        ByName.run()
        ByName.shadowed()
    si
si
