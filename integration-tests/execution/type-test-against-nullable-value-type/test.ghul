use IO.Std.write_line;

narrow(o: object) -> string is
    if let flag: bool = o then
        return "bool {flag}";
    fi

    return "not a bool";
si

optional_cast(o: object) -> string is
    let i = cast int?(o);

    if i? then
        return "int {i}";
    fi

    return "no int";
si

entry() is
    let yes: object = true;
    let no: object = false;
    let number: object = 42;
    let text: object = "text";

    write_line(narrow(yes));
    write_line(narrow(no));
    write_line(narrow(number));

    write_line(optional_cast(number));
    write_line(optional_cast(text));

    write_line("isa int? of 42: {isa int?(number)}");
    write_line("isa int? of true: {isa int?(yes)}");
si
