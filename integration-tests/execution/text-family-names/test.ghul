use IO.Std.write_line

// The encodings and the text-element types live in Text.

let utf8: Text.Encoding = Text.UTF8_ENCODING()
let ascii: Text.ASCII_ENCODING = Text.ASCII_ENCODING()
let bytes = utf8.get_bytes("hé")

write_line("{bytes.count} {utf8.get_string(bytes)} {ascii.web_name}")

let info: Text.StringInfo = Text.StringInfo("abc")
write_line("{info.length_in_text_elements}")

let text_info: Text.TextInfo = invariant_locale().text_info
write_line(text_info.to_upper("abc"))

// The invariant locale under the name each target declares it: the core
// library on wasm and llvm still says invariant_culture.
@IF.dotnet()
invariant_locale() -> Text.Locale => Text.Locale.invariant

@IF.not.dotnet()
invariant_locale() -> Text.Locale => Text.Locale.invariant_culture
