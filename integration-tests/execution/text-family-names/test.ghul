use IO.Std.write_line

// The encodings and the text-element types live in Text. Their System names
// are second spellings of the same types.

let utf8: Text.Encoding = Text.UTF8_ENCODING()
let old_utf8: System.Text.UTF8Encoding = Text.UTF8_ENCODING()
let ascii: Text.ASCII_ENCODING = System.Text.ASCIIEncoding()
let bytes = utf8.get_bytes("hé")

write_line("{bytes.count} {old_utf8.get_string(bytes)} {ascii.web_name}")

let info: Text.StringInfo = System.Globalization.StringInfo("abc")
let old_info: System.Globalization.StringInfo = info
write_line("{old_info.length_in_text_elements}")

let text_info: Text.TextInfo = System.Globalization.CultureInfo.invariant_culture.text_info
write_line(text_info.to_upper("abc"))
