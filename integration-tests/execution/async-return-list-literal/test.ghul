use default

other() -> Tasks.TASK[int[]] is
    await Tasks.TASK.yield()
    return [7, 8]
si

compute(xs: int[]) -> Tasks.TASK[int[]] is
    await Tasks.TASK.yield()
    if xs.count > 5 then
        return other()
    fi
    return [x * 2 for x in xs]
si

maybe() -> Tasks.TASK[string?] is
    await Tasks.TASK.yield()
    return null
si

write_line("{compute([1, 2]).result} {compute([1,2,3,4,5,6]).result} {maybe().result ?? "none"}")
