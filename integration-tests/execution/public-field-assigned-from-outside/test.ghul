// A field declared `field public` can be assigned from outside its type,
// passed by reference, and changed in place when it holds a struct.
use IO.Std.write_line

struct POINT is
    x: int field public

    init(x: int) is
        self.x = x
    si

    step() is
        x = x + 1
    si
si

class HOLDER is
    count: int field public
    point: POINT field public

    init() is
        count = 1
        point = POINT(10)
    si
si

bump(value: int ref) is
    value! = value! + 1
si

let h = HOLDER()

h.count = 5
write_line("assigned: {h.count}")

bump(h.count ref)
write_line("by reference: {h.count}")

h.point.x = 20
h.point.step()
write_line("struct in place: {h.point.x}")
