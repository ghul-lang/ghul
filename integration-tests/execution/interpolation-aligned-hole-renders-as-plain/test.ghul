use default

// An aligned or formatted hole renders the value as a plain hole does, then
// pads it; a format still reaches a value .NET formats.
let xs = [1, 2, 3]
let flag = true
let point = (x = 10, y = 20)
let opt: int? = null
let some: double? = 2.5

write_line("[{xs}] [{flag}] [{point}] [{opt}]")
write_line("[{xs,-16}] [{flag,-6}] [{point,-12}] [{opt,-6}]")
write_line("[{xs,16}] [{flag,6}]")
write_line("[{some:F2}] [{some,8:F2}] [{opt:F2}] [{3.14159:F2}] [{42,5}]")
