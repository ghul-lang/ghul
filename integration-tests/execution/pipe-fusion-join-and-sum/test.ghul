namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    struct POINT(x: int public, z: int public) is
        to_string() -> string => "P{x}"
    si

    // A fused sum adds each element with the one instruction that element
    // type's `+` is, so a type whose addition is an operator method -
    // decimal here - keeps the runtime's sum and still answers. join
    // writes each element through the interpolation the runtime's
    // append_to uses, which is what a char and a struct with its own
    // to_string distinguish from appending the value itself.
    class Main is
        entry() static is
            let ns = LIST[int]([1, 2, 3, 4]);
            let ls = LIST[long]([10L, 20L]);
            let bs = LIST[byte]([1b, 2b, 3b]);
            let ds = LIST[double]([1.5, 2.5]);
            let ms = LIST[decimal]([1.5m, 2.5m]);
            let ss = LIST[string](["a", "b"]);
            let cs = LIST[char](['x', 'y']);
            let ps = LIST[POINT]([POINT(1, 10), POINT(2, 20)]);

            Std.write_line("sum-int {ns |> map(x => x) |> sum()}");
            Std.write_line("sum-mapped {ns |> map(x => x * 2) |> sum()}");
            Std.write_line("sum-filtered {ns |> filter(x => x % 2 == 0) |> sum()}");
            Std.write_line("sum-long {ls |> map(x => x) |> sum()}");
            Std.write_line("sum-byte {bs |> map(x => x) |> sum()}");
            Std.write_line("sum-double {ds |> map(x => x) |> sum()}");
            Std.write_line("sum-decimal {ms |> map(x => x) |> sum()}");
            Std.write_line("sum-empty {LIST[int]() |> map(x => x) |> sum()}");

            Std.write_line("sum-by {ps |> map(p => p) |> sum_by(p => p.z)}");
            Std.write_line("sum-by-square {ns |> map(x => x) |> sum_by(x => x * x)}");

            Std.write_line("join-int {ns |> map(x => x) |> join(", ")}");
            Std.write_line("join-default {ns |> filter(x => x > 1) |> join()}");
            Std.write_line("join-string {ss |> map(s => s) |> join("-")}");
            Std.write_line("join-char {cs |> map(c => c) |> join("")}");
            Std.write_line("join-struct {ps |> map(p => p) |> join("|")}");
            Std.write_line("join-empty [{LIST[int]() |> map(x => x) |> join(",")}]");
            Std.write_line("join-take {ns |> map(x => x) |> take(2) |> join(",")}");
        si
    si
si
