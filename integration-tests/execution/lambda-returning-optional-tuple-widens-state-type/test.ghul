use IO.Std.write_line

// A function literal whose slot returns an optional tuple holding the
// state type, where another argument of the call gives that type and the
// literal's body produces a wider one: the state type widens to what the
// body produces, as it does when the slot's tuple is not optional.

class Shape is
    init() is si

    name() -> string => "shape"
si

class Circle: Shape is
    init() is si

    name() -> string => "circle"
si

step_once[S](seed: S, step: S -> (int, S)?) -> S is
    if let (_, next) = step(seed) then
        return next
    fi

    return seed
si

unfold[T, S](seed: S, step: S -> (T, S)?) -> T[] is
    let result = Collections.LIST[T]()
    let state mut = seed

    while result.count < 3 do
        if let (value, next) = step(state) then
            result.add(value)
            state = next
        else
            break
        fi
    od

    return result
si

unfold_spread[T, S..](seed: S, step: S.. -> (T, S)?) -> T[] is
    let result = Collections.LIST[T]()
    let state mut = seed

    while result.count < 3 do
        if let (value, next) = step(state) then
            result.add(value)
            state = next
        else
            break
        fi
    od

    return result
si

entry() is
    let letters = ['a', 'b', 'c']
    let digits = [1, 2, 3]

    // a class state widened to its superclass
    write_line(step_once(Circle(), s => (1, Shape())).name())

    // an array state widened to the list its slices are
    write_line("{step_once(letters, l => (1, l[1..<0]))}")
    write_line("{unfold(letters, l => (l[0], l[1..<0]))}")
    write_line("{unfold(letters, l => if l.count == 0 then null else (l[0], l[1..<0]) fi)}")

    // a tuple state spread over the literal's parameters
    write_line("{unfold_spread((letters, digits), (l, d) => ("{l[0]}{d[0]}", (l[1..<0], d[1..<0])))}")
si
