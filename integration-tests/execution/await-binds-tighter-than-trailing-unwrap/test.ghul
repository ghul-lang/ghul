use IO.Std.write_line

class Box(value: int public);

union Outcome is
    DONE(value: int) default
    FAILED(reason: string)
si

done_later(n: int) -> Concurrency.Future[Outcome] => Concurrency.Future.from_result[Outcome](Outcome.DONE(n))

box_later(n: int) -> Concurrency.Future[Box?] => Concurrency.Future.from_result[Box?](Box(n))

optional_future(n: int) -> Concurrency.Future[int]? => Concurrency.Future.from_result(n)

// a trailing ! applies to the awaited value
let a = await done_later(1)!
write_line("trailing !: {a}")

// so does a trailing ?
let b = await done_later(2)?
write_line("trailing ?: {b}")

// a ! that a member access follows stays inside the operand, and
// parentheses keep a ! on the future
let c = (await box_later(3))!.value
let d = await (optional_future(4)!)
write_line("parenthesised: {c} {d}")

// await of a chain takes the whole chain; the ! applies to what it awaits
let e = await Concurrency.Future.from_result[Outcome](Outcome.DONE(5))!
write_line("chain: {e}")

// a ! inside an argument belongs to the argument
let f = await done_later((await box_later(6))!.value)!
write_line("argument: {f}")
