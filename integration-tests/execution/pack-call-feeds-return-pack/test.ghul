use Ghul.Functional.retry

// The combinator's pack is pinned by nothing at its own call: the
// lambda's parameters are untyped and the attempt count says nothing
// about them. The call of the result is what says what the pack is.
let safe = retry((a, b) => a + b, 1)

IO.Std.write_line("{safe(2, 3)}")

let describe = retry((name, count, unit) => "{count} {unit} of {name}", 2)

IO.Std.write_line(describe("tea", 3, "cups"))
