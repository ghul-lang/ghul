use default
use Ghul.apply
use Ghul.`>>

// The stored literal is typed through a pack use inside another literal
// first, so the composition's pack binds to a named tuple; the result is
// still presented as the two-parameter function the call expects.
let g = (p, q) => p + q

[1, 2] |> map(y => apply(g, y, y)) |> collect()

write_line("{(g >> (x => x * 2))(1, 2)}")
write_line("{g(4, 9)}")
