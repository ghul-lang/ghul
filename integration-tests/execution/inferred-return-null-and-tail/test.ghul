use default

// A `return null` in a statement body with an inferred return type makes the
// return optional of what the tail gives, whatever the function's form.

_half(n) is
    if n % 2 != 0 then
        return null
    fi

    n / 2
si

_initial(word) is
    if word.length == 0 then
        return null
    fi

    word.substring(0, 1)
si

// An expression body: a `return` in a parenthesized block leaves the block
_quarter(n) => (
    if n % 4 != 0 then
        return null
    fi;

    n / 4
)

let third = (n: int) is
    if n % 3 != 0 then
        return null
    fi

    n / 3
si

_nested_check() is
    sixth(n) is
        if n % 6 != 0 then
            return null
        fi

        n / 6
    si

    write_line("{sixth(12) ?? -1} {sixth(7) ?? -1}")
si

write_line("{_half(8) ?? -1} {_half(3) ?? -1}")
write_line("{_initial("ghul") ?? "none"} {_initial("") ?? "none"}")
write_line("{_quarter(8) ?? -1} {_quarter(6) ?? -1}")
write_line("{third(9) ?? -1} {third(4) ?? -1}")
_nested_check()
