use default
use System.Random

// A take count that is a state-changing call, after a source that reads
// eagerly when called, as sort does: unfused, the sort draws every number
// before the count is drawn. A fused chain keeps that order, so every ending
// gives the same answer.

pick(random: Random) -> int{} =>
    0..24
        |> map(cell => (cell, random.next()))
        |> sort((a, b) => a.`1 <> b.`1)
        |> map(pair => pair.`0)
        |> take(random.next(3, 5))

write_line("pipe: {pick(Random(4)) |> list() |> count()}")
write_line("set: {pick(Random(4)) |> SET() |> count()}")
write_line("list: {LIST(pick(Random(4))).count}")
write_line("array: {(pick(Random(4)) |> ARRAY()).count}")
write_line("collect_set: {pick(Random(4)) |> SET() |> count()}")
