use IO.Std.write_line

// A type argument another argument of the call gives, that a function
// literal's return also holds, widens to what the literal's arms produce
// whether the arms belong to an if or to a case.

step_once[S](seed: S, step: S -> (int, S)?) -> S is
    if let (_, next) = step(seed) then
        return next
    fi

    return seed
si

unfold[T, S](seed: S, step: S -> (T, S)?) -> T[] is
    let result = Collections.LIST[T]()
    let state mut = seed

    while result.count < 5 do
        if let (value, next) = step(state) then
            result.add(value)
            state = next
        else
            break
        fi
    od

    return result
si

entry() is
    let letters = ['a', 'b', 'c']

    // every type argument given by the seed: the arm widens the state
    write_line("{step_once(letters, l => if l.count == 0 then null else (1, l[1..<0]) fi)}")
    write_line("{step_once(letters, l => case l.count when 0 then null else (1, l[1..<0]) esac)}")

    // the element type left to the arms of a case
    write_line("{unfold(letters, l => case l when [] then null else (l[0], l[1..<0]) esac)}")
    write_line("{unfold(letters, l => case l when [] then null when [x, ..rest] then (x, rest) esac)}")

    let slices: char[] = letters
    write_line("{unfold(slices, l => case l when [] then null when [x, ..rest] then (x, rest) esac)}")
si
