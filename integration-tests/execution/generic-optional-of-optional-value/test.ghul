use IO.Std.write_line
use Collections.Iterator

// A generic's T? instantiated at a value type that is itself optional
// carries two layers: the presence of the value, and a Nullable that can
// hold nothing.

next[T](iter: Iterator[T]) -> T? =>
    if iter.move_next() then iter.current else null fi

entry() is
    let ints: int?[] = [1, null, 3]

    let it = ints.iterator

    while let i = it |> next() do
        write_line("while let: {i ?? -1}")
    od

    let it2 = ints.iterator
    let first = it2 |> next()
    let second = it2 |> next()
    let _ = it2 |> next()
    let past_end = it2 |> next()

    if let i = second then
        write_line("if let: {i ?? -1} {i?}")
    fi

    if let i = past_end then
        write_line("if let past the end: {i}")
    else
        write_line("if let past the end: absent")
    fi

    write_line("coalesce: {first ?? -2} {second ?? -2} {past_end ?? -2}")

    case second
    when null then write_line("case: absent")
    else write_line("case: present")
    esac

    write_line("unwrap: {second! ?? -1}")
si
