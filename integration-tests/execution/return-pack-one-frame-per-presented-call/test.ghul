use IO.Std.write_line

use Ghul.Functional.`>>

// Tests: presenting a call whose declared return is pack-marked allocates
// no closure frame, however many times the body was compiled: the value
// is a delegate closed over the presented function itself, so the assembly
// holds no frame capturing the operand going into the operator or the
// function the operator returns. A literal that captures nothing is built
// once over a frame with no fields, which is not one of these.

make() -> (int, int) -> int => (a: int, b: int) -> int => a + b

both() -> (int, int) -> string => make() >> (x => "<{x}>")

entry() is
    write_line(both()(3, 4))

    let frames mut = 0

    for type in System.Reflection.Assembly.get_entry_assembly()!.get_types() do
        if type.name.starts_with("$frame") /\ type.get_fields().count > 0 then
            frames = frames + 1
        fi
    od

    write_line("frames: {frames}")
si
