use default

// A floating-point min, max, min_by or max_by answers as the runtime's
// own loop does, which orders through `Comparable`: NaN sorts below
// every number, whichever position it is in. Each line prints the
// chain as written beside the same chain inside a generic over
// `Comparable`, which is never fused, so the two must agree.
gmin[T: Ghul.Comparable[T]](xs: T{}) -> T? => xs |> min()
gmax[T: Ghul.Comparable[T]](xs: T{}) -> T? => xs |> max()
gmin_by[T, K: Ghul.Comparable[K]](xs: T{}, key: T -> K pure) -> T? => xs |> min_by(key)
gmax_by[T, K: Ghul.Comparable[K]](xs: T{}, key: T -> K pure) -> T? => xs |> max_by(key)

let nan = 0.0 / 0.0
let fnan = 0.0s / 0.0s

let after = [1.0, nan, 2.0]
let before = [nan, 1.0, 2.0]

write_line("min {after |> min()} {gmin(after)} {before |> min()} {gmin(before)}")
write_line("max {after |> max()} {gmax(after)} {before |> max()} {gmax(before)}")

let tagged_after = [("one", 1.0), ("nan", nan), ("two", 2.0)]
let tagged_before = [("nan", nan), ("one", 1.0), ("two", 2.0)]

write_line("min_by {(tagged_after |> min_by(p => p.`1))!.`0} {gmin_by(tagged_after, p => p.`1)!.`0} {(tagged_before |> min_by(p => p.`1))!.`0} {gmin_by(tagged_before, p => p.`1)!.`0}")
write_line("max_by {(tagged_after |> max_by(p => p.`1))!.`0} {gmax_by(tagged_after, p => p.`1)!.`0} {(tagged_before |> max_by(p => p.`1))!.`0} {gmax_by(tagged_before, p => p.`1)!.`0}")

let singles = [1.0s, fnan]
write_line("single {singles |> map(x => x) |> min()} {gmin(singles)} {singles |> max()} {gmax(singles)}")
