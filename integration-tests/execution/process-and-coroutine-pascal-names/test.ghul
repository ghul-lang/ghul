use IO.Std.write_line

// The process and coroutine types are named in PascalCase. Their UPPER names
// are second spellings of the same types.

let channel: Ghul.Coroutines.Channel[int] = Ghul.Coroutines.CHANNEL[int]()
let old_channel: Ghul.Coroutines.CHANNEL[int] = channel
channel.send(7)

let semaphore: Ghul.Coroutines.Semaphore = Ghul.Coroutines.SEMAPHORE(2)
let old_semaphore: Ghul.Coroutines.SEMAPHORE = semaphore

let result: IO.ProcessResult? = null
let old_result: IO.PROCESS_RESULT? = result

let pending: Ghul.Coroutines.Coroutine? = null
let old_pending: Ghul.Coroutines.COROUTINE? = pending

let counted: Ghul.Coroutines.Coroutine[int]? = null
let old_counted: Ghul.Coroutines.COROUTINE[int]? = counted

write_line("{old_channel == channel} {old_semaphore.available} {old_result?} {old_pending?} {old_counted?}")
