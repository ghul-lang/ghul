use default

// A stage inlined into the loop a fused chain runs reads and writes what
// its literal would have: a member of self, the parameter of a stage it
// is itself inlined inside, an enclosing literal's parameter, a captured
// mutable local, and the nested function it is written in.
class HOLDER is
    _n: int

    init(n: int) is
        _n = n
    si

    matching_count(xs: List[int], k: int) -> int => xs |> filter(x => x + k == _n) |> count()

    matching_for(xs: List[int], k: int) -> int is
        let found mut = 0

        for x in xs |> filter(x => x + k == _n) do
            found = found + 1
        od

        found
    si
si

shifted(rows: List[List[int]]) -> string =>
    rows |> map(row => row |> map(x => x + row.count) |> join(",")) |> join(";")

totals(rows: List[List[int]]) -> int[] =>
    rows |> map(row => row |> map(x => x + row.count) |> sum()) |> collect()

marked(rows: List[int]) -> List[string] is
    let lines = LIST[string]()

    rows |> each(row => lines.add((0..4) |> map(c => if c == row then "Q" else "." fi) |> join(" ")))

    lines
si

spread(bits: string, n: int) -> string is
    let remaining mut = 0

    bits
        |> map(bit =>
            if bit == '1' then
                remaining = n
                '1'
            elif remaining > 0 then
                remaining = remaining - 1
                '1'
            else
                '0'
            fi)
        |> map(c => "{c}")
        |> join("")
si

leaves(dimensions: List[int]) -> int is
    count(level: int) -> int =>
        if level == dimensions.count then
            1
        else
            0..dimensions[level] |> map(i => count(level + 1)) |> sum()
        fi

    count(0)
si

let holder = HOLDER(21)

write_line("{holder.matching_count([19, 20, 21], 1)} {holder.matching_for([19, 20, 21], 1)}")
write_line(shifted([[1, 2, 3], [4, 5, 6]]))
write_line(totals([[1, 2, 3], [4, 5, 6]]) |> join(","))
write_line(marked([3, 1]) |> join("|"))
write_line("{spread("1000100", 2)} {leaves([2, 3])}")
