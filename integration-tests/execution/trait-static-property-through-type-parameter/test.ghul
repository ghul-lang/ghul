use default

// A static property a trait requires, with no body, is implemented by each
// type with a static property of the same name and type; a generic reads
// the implementation through a type parameter the trait bounds.
trait Identity[T] is
    zero: T static
si

struct Celsius(degrees: int public): Identity[Celsius] is
    zero: Celsius static => Celsius(0)
si

struct Kelvin(degrees: int public): Identity[Kelvin] is
    zero: Kelvin static => Kelvin(273)
si

zero_of[T: Identity[T]]() -> T => T.zero

write_line("{zero_of[Celsius]().degrees}")
write_line("{zero_of[Kelvin]().degrees}")
