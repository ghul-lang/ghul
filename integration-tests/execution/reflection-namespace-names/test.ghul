use IO.Std.write_line

// The reflection types live in Ghul.Reflection. Their System names are
// second spellings of the same types.

enum Colour is
    RED = 1,
    GREEN = 2,
si

class Thing(label: string public);

entry() is
    let colour = typeof Colour

    let green: object = System.Enum.parse(colour, "GREEN")
    write_line("{green} {System.Enum.get_name(colour, green)}")

    let made = cast Thing?(Ghul.Reflection.Activator.create_instance(typeof Thing, ["made"]))!
    let same = cast Thing?(System.Activator.create_instance(typeof Thing, ["same"]))!
    write_line("{made.label} {same.label}")

    let flags: Ghul.Reflection.BindingFlags = System.Reflection.BindingFlags.PUBLIC
    write_line("{flags == Ghul.Reflection.BindingFlags.PUBLIC}")
si
