use default

// A static member a trait requires, with no body, is implemented by each
// type with a static member of the matching signature; a generic reaches
// the implementation through a type parameter the trait bounds.
trait Named[T] is
    try_named(text: string, result: T ref) -> bool static
si

struct Celsius(degrees: int public): Named[Celsius] is
    try_named(text: string, result: Celsius ref) -> bool static is
        if text =~ "freezing" then
            result! = Celsius(0)
            return true
        fi

        return false
    si
si

struct Kelvin(degrees: int public): Named[Kelvin] is
    try_named(text: string, result: Kelvin ref) -> bool static is
        if text =~ "freezing" then
            result! = Kelvin(273)
            return true
        fi

        return false
    si
si

lookup[T: Named[T]](text: string) -> (found: bool, value: T) is
    let value: T mut = _
    let found = T.try_named(text, value ref)

    return (found, value)
si

let celsius = lookup[Celsius]("freezing")
let kelvin = lookup[Kelvin]("freezing")
let missing = lookup[Kelvin]("boiling")

write_line("{celsius.found} {celsius.value.degrees}")
write_line("{kelvin.found} {kelvin.value.degrees}")
write_line("{missing.found}")
