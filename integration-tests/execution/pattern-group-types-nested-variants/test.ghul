use default

enum Color is
    RED,
    BLACK
si

use Color.RED
use Color.BLACK

union Tree is
    NODE(color: Color, left: Tree, value: int, right: Tree);
    EMPTY;
si

use Tree.NODE
use Tree.EMPTY

balance(color: Color, left: Tree, value: int, right: Tree) -> Tree =>
    case (color, left, value, right)
    when (~BLACK, (~RED, (~RED, a, x, b): NODE, y, m): NODE, z, d) then
        NODE(RED, NODE(BLACK, a, x, b), y, NODE(BLACK, m, z, d))
    else
        NODE(color, left, value, right)
    esac

show(t: Tree) -> string =>
    case t
    when (c, l, v, r): NODE then "({if c == RED then "R" else "B" fi} {show(l)} {v} {show(r)})"
    else "."
    esac

let leaf = EMPTY
write_line(show(balance(BLACK, NODE(RED, NODE(RED, leaf, 1, leaf), 2, leaf), 3, leaf)))
write_line(show(balance(BLACK, NODE(RED, leaf, 1, leaf), 2, leaf)))

union Node is
    BRANCH(tag: string, left: Node, right: Node);
    LEAF(kind: string, text: string);
si

describe(n: Node) -> string =>
    case n
    when ("Assign", (_, name): Node.LEAF, value): Node.BRANCH then "assign {name} = {describe(value)}"
    when ("If", condition, (_, yes, no): Node.BRANCH): Node.BRANCH then "if {describe(condition)} then {describe(yes)} else {describe(no)}"
    when (_, text): Node.LEAF then text
    else "?"
    esac

write_line(describe(Node.BRANCH("Assign", Node.LEAF("id", "x"), Node.LEAF("num", "1"))))
write_line(describe(Node.BRANCH("If", Node.LEAF("id", "c"), Node.BRANCH("Else", Node.LEAF("num", "1"), Node.LEAF("num", "2")))))
write_line(describe(Node.BRANCH("Assign", Node.BRANCH("x", Node.LEAF("a", "b"), Node.LEAF("a", "b")), Node.LEAF("num", "1"))))
