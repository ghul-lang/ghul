use default

_even(n) => if n == 0 then true else _odd(n - 1) fi
_odd(n) => if n == 0 then false else _even(n - 1) fi

_a(n) => if n >= 7 then "a{n}" else _b(n + 1) fi
_b(n) => if n >= 7 then "b{n}" else _c(n + 1) fi
_c(n) => if n >= 7 then "c{n}" else _a(n + 1) fi

write_line("{_even(10)} {_odd(7)}")
write_line("{_a(0)} {_b(0)}")
