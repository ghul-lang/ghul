use default

// A standalone chain whose map or filter is a named function, or a
// literal _try_inline_stage cannot inline, runs in the generated
// generator as a call of the function value the chain passes for it,
// evaluated once where the chain is written.
is_odd(n: int) -> bool => n % 2 == 1

label(n: int) -> string => "<{n}>"

odds_squared(xs: List[int]) -> int{} =>
    xs |> filter(is_odd) |> map(n => n * n)

labelled_evens(xs: List[int]) -> string{} =>
    xs |> map(n => n * 2) |> filter(n => n % 4 == 0) |> map(label)

windowed(xs: List[int]) -> int{} =>
    xs |> skip(1) |> filter(is_odd) |> take(2)

// a block-bodied literal keeps its delegate too
bounded(xs: List[int]) -> int{} =>
    xs |> map(n is
        if n < 0 then
            0
        else
            n
        fi
    si)

let xs = [1, 2, 3, 4, 5, 6, 7, 8]

write_line(odds_squared(xs) |> join(","))
write_line(labelled_evens(xs) |> join(","))
write_line(windowed(xs) |> join(","))
write_line(bounded([-2, 3, -1, 5]) |> join(","))
