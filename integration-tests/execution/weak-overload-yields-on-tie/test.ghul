use IO.Std.write_line

// A weak overload yields to the others it ties with. In `y => scale * y`
// nothing but the operator decides `y`, and both of VECTOR's `*` overloads
// tie on an unsettled `y`; the weak one drops out, so `y` settles as
// VECTOR. With a settled double, the weak overload is the only one that
// fits and is called.
struct VECTOR(x: double public, y: double public) is
    *(other: VECTOR) -> VECTOR => VECTOR(x * other.x, y * other.y)

    @weak_overload()
    *(factor: double) -> VECTOR => VECTOR(x * factor, y * factor)

    to_string() -> string => "({x}, {y})"
si

let scale = VECTOR(2.0, 3.0)

// Nothing but the operator decides `y` here: no call, no expected type.
let apply = y => scale * y

write_line(scale * VECTOR(10.0, 100.0))
write_line(scale * 0.5)
