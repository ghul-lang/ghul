use default

// A lambda parameter paired with a generic call's type argument while
// that call's source is still resolving takes the type the source
// settles to, not the call's unbound type parameter.
let c = true
let g = p => (let (a, b) = p; a + b)

// A deferred local given a pipe whose map calls a destructure-inferred
// function.
let v mut
v = [17] |> map(x => g((3, 3))) |> collect() |> filter(y => true) |> collect()

// A reduce over mapped calls of that function, inside an if arm.
let xs = [0, 19, 14] |> map(x => g((x, x))) |> collect() |> map(y => ((15, y) |> g())) |> collect()
let (p, q) = if c then (13, "") else ((xs |> reduce(0, (a, b) => a + b)), "hello") fi

// A filter over a block local holding a filtered array of a deferred local.
let w mut
w = if c then 5 else 8 fi
let ys = ((let t = ([w] |> filter(x => c) |> collect()); t) |> filter(y => c) |> collect())

write_line("{g((1, 2))} {v |> join(",")}")
write_line("{xs |> join(",")} {p} {q}")
write_line("{w} {ys |> join(",")}")
