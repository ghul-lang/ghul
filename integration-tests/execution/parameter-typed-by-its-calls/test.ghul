use default

// A parameter of a local function or a literal is typed by the calls it
// takes part in: `pick` is called with an RGB, and the literal passed for
// it returns an int, so `pick` is `(RGB) -> int`.

class RGB(red: int, green: int)

run(a: RGB) -> int is
    mix(pick) -> int => pick(a)

    return mix(p => p.red) + mix(p => p.green)
si

run_literal(a: RGB) -> string is
    let describe = pick => "{pick(a)}"

    return describe(p => p.red)
si

let colour = RGB(3, 4)

write_line("{run(colour)} {run_literal(colour)}")
