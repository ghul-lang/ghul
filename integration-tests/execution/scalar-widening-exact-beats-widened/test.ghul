use IO.Std.write_line

// An overload taking the argument as it is wins over one it would only
// reach by widening, and a narrower widening wins over a wider one.
f(x: int) -> string => "int"
f(x: double) -> string => "double"

g(x: long) -> string => "long"
g(x: double) -> string => "double"

h(x: object) -> string => "object"
h(x: double) -> string => "double"

let i = 1
write_line("{f(i)} {g(i)} {h(i)}")
