use IO.Std.write_line

class BOX(value: int) is
    get[T](fallback: T) -> T => fallback
    doubled() -> BOX => BOX(value * 2)
si

let word = "wrapped"

let length = word.
    length

let chained = BOX(3).
    doubled().
    doubled().
    value

let generic = BOX(1).
    get[string]("generic")

write_line("{length} {chained} {generic}")
