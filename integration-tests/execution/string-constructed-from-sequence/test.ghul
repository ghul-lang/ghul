use IO.Std.write_line
use Ghul.Pipes

let word = "hello"

let reversed = word |> reverse() |> string()
write_line("from a pipe of chars: {reversed}")

let from_chars = string(['a', 'b', 'c'])
write_line("from a char array: {from_chars}")

let digits = [1, 2, 3] |> string()
write_line("from ints: {digits}")

let words = ["red", "green", "blue"]
write_line("joined with a separator: {words |> string(", ")}")
write_line("joined without one: {string(words)}")

let nothing: string[] = []
write_line("from an empty sequence: [{string(nothing)}] [{string(nothing, "-")}]")

let expected: string = _(word |> map(c => char.to_upper(c)))
write_line("from the expected type: {expected}")
