use IO.Std.write_line
use Ghul.Pipes

class ARRAY(items: int[]) is
    describe() -> string => "user ARRAY of {items.count}"
si

union Json is
    NUMBER(value: int);
    ARRAY(values: Json[]);
si

let mine = ARRAY([1, 2, 3])
write_line(mine.describe())

let json: Json = Json.ARRAY([Json.NUMBER(1), Json.NUMBER(2)])

if let (values): Json.ARRAY = json then
    write_line("json array of {values.count}")
fi
