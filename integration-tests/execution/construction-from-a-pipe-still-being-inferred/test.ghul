// A generic class with two one-argument constructors, constructed from a
// pipe whose element type depends on a parameter with no written type.
// On the first walk the element type is not known yet, so the
// construction waits rather than taking the class with its own type
// parameter unbound, and the function's result is the int it settles at.
use default

class BAG[T] is
    _items: LIST[T]

    init(capacity: int) is
        _items = LIST[T]()
    si

    init(source: Iterable[T]) is
        _items = LIST[T](source)
    si

    first_item() -> T => _items[0]
si

class KEYED[T] is
    _items: LIST[T]

    init(comparer: Collections.EqualityComparer[T]) is
        _items = LIST[T]()
    si

    init(source: Iterable[T]) is
        _items = LIST[T](source)
    si

    first_item() -> T => _items[0]
si

most_repeated(word) => (word |> group_by(c => c) |> map((_, occurrences) => occurrences.count) |> BAG()).first_item()

first_count(word) => (word |> group_by(c => c) |> map((_, occurrences) => occurrences.count) |> KEYED()).first_item()

write_line(most_repeated("aab") > 1)
write_line(first_count("abb") + 1)
