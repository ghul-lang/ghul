use default

// Chains written in a generic class: one whose element type names the
// class's type parameter, one that does not, and one that reads a value
// of the type parameter's type.
class BAG[T] is
    _items: LIST[T]

    init(items: T{}) is
        _items = LIST[T](items)
    si

    kept() -> T{} => _items |> filter(item => true)

    wrapped() -> (T, int){} => _items |> map(item => (item, 1))

    lengths() -> int{} => [1, 2, 3] |> map(n => n * 10)

    matching(wanted: T) -> bool{} => _items |> map(item => item =~ wanted)
si

let bag = BAG([3, 4, 5])

write_line(bag.kept() |> join(","))
write_line(bag.wrapped() |> map(p => p.`0) |> join(","))
write_line(bag.lengths() |> join(","))
write_line(bag.matching(4) |> join(","))
