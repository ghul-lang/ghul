use default

// A deferred-init local assigned an array literal that names another
// deferred-init local takes the join of every element, once that local's
// type has settled.
class Animal abstract is
    init() is si
    describe() -> string => "animal"
si

class CAT: Animal is
    init() is super.init() si
    describe() -> string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    describe() -> string => "dog"
si

let d mut
d = DOG()

let xs mut
xs = [CAT(), d]

write_line("{xs |> map(x => x.describe()) |> join(",")}")

let ys mut
ys = [CAT(), d] |> collect_mutable()

write_line("{ys.count}")
