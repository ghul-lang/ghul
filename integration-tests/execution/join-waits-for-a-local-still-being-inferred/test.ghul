use default

// A local whose type its later assignment decides is still being inferred
// where these joins first meet it. Each join waits for it rather than
// settling on the arm or assignment it can already see.
class Animal abstract is
    init() is si
    describe() -> string
si

class CAT: Animal is
    init() is super.init() si
    describe() -> string => "cat"
si

class DOG: Animal is
    init() is super.init() si
    describe() -> string => "dog"
si

entry() is
    let dog mut
    dog = DOG()

    for c in [true, false] do
        let from_if mut
        from_if = if c then CAT() else dog fi

        let from_case mut
        from_case = case c when true then CAT() else dog esac

        let assigned mut
        assigned = CAT()

        if !c then
            assigned = dog
        fi

        write_line("{from_if.describe()} {from_case.describe()} {assigned.describe()}")
    od
si
