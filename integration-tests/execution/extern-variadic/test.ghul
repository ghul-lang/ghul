namespace Test is
    use IO.Std.write_line;

    // Tests: a C variadic function called through ordinary fixed-shape
    // declarations marked variadic after their fixed parameters. The
    // arguments from there on are passed as C promotes them: a single as a
    // double and a byte as an int. Two declarations of open differ only in
    // their variadic part.

    @extern("libc", "snprintf", variadic = 3)
    format(buffer: ARRAY[ubyte], size: word, format: string, i: int, s: single, b: byte, l: long, text: string) -> int;

    @extern("libc", "open", variadic = 2)
    open_creating(path: string, flags: int, mode: uint) -> int;

    @extern("libc", "open", variadic = 2)
    open(path: string, flags: int) -> int;

    @extern("libc", "fcntl", variadic = 2)
    descriptor_flags(fd: int, command: int) -> int;

    @extern("libc", "close")
    close(fd: int) -> int;

    @extern("libc", "unlink")
    unlink(path: string) -> int;

    text_of(bytes: ARRAY[ubyte], length: int) -> string =>
        Text.Encoding.ascii.get_string(bytes, 0, length);

    entry() is
        let buffer = Ghul.Pipes.repeat(0ub, 64) |> ARRAY();
        let length = format(buffer, 64w, "%d %.2f %d %ld %s", 42, 2.5s, -3b, 9_000_000_000L, "end");
        write_line(text_of(buffer, length));

        let path = "extern-variadic.tmp";
        let created = open_creating(path, 0x41, 0x180u);
        write_line("created: {created >= 0}, flags read: {descriptor_flags(created, 1) >= 0}");
        close(created);

        let reopened = open(path, 0);
        write_line("reopened: {reopened >= 0}");
        close(reopened);
        unlink(path);
    si
si
