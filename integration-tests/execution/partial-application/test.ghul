use default

scale(x: int, by: int) -> int => x * by

between(low: int, x: int, high: int) -> bool => x >= low /\ x <= high

greet(greeting: string, name: string) -> string => "{greeting}, {name}"

class COUNTER is
    _step: int
    init(step: int) is _step = step; si
    bump(x: int) -> int => x + _step
    bump2(x: int, y: int) -> int => x + y + _step
si

struct POINT(x: int public, y: int public) is
    shifted(dx: int) -> POINT => POINT(x + dx, y)
si

expensive() -> int is
    write_line("expensive called")
    return 10
si

// global function, fixed last
let doubled = [1, 2, 3] |> map(scale(*, 2)) |> collect()
write_line("{$(doubled)}")

// global function, fixed first and last, one placeholder in the middle
let mids = [0, 5, 10, 15] |> filter(between(1, *, 12)) |> collect()
write_line("{$(mids)}")

// strings, fixed first
let greetings = ["alice", "bob"] |> map(greet("hello", *)) |> collect()
write_line("{$(greetings)}")

// two placeholders
let add2 = scale(*, *)
write_line("{add2(6, 7)}")

// instance method with receiver fixed
let c = COUNTER(100)
let bumped = [1, 2] |> map(c.bump(*)) |> collect()
write_line("{$(bumped)}")

// instance method, receiver + one fixed + one placeholder
let bumped2 = [1, 2] |> map(c.bump2(*, 1000)) |> collect()
write_line("{$(bumped2)}")

// fixed argument evaluated once
let scaled = [1, 2, 3] |> map(scale(*, expensive())) |> collect()
write_line("{$(scaled)}")

// stored and called directly
let f = greet(*, "world")
write_line(f("hi"))

// struct receiver
let p = POINT(1, 2)
let shift = p.shifted(*)
write_line("{shift(5).x}")

// local function value
let mul = (a: int, b: int) -> int => a * b
let triple = mul(*, 3)
write_line("{triple(4)}")

// zero fixed, nothing closed over, void return
shout(s: string) is write_line("{s}!"); si
let say = shout(*)
say("said")

// a constructor
let points = [1, 2] |> map(POINT(*, 9)) |> collect()
write_line("{points[0].x} {points[0].y} {points[1].x}")

// passed where a function of two parameters is wanted
apply2(f: (int, int) -> int, a: int, b: int) -> int => f(a, b)
write_line("{apply2(scale(*, *), 3, 5)}")

// a generic function
first_of[T](xs: T[], fallback: T) -> T => if xs.count > 0 then xs[0] else fallback fi
let heads = [[1, 2], [3], Collections.LIST[int]() |> collect()] |> map(first_of(*, -1)) |> collect()
write_line("{$(heads)}")

// the placeholder's type shows through to a stored value's parameter
let describe = greet("dear", *)
let described: (string) -> string = describe
write_line(described("carol"))

// standing for an argument-pack formal: one parameter, the pack's tuple
apply_all[T..](f: T.. -> int, v: T..) -> int => f(v)
sum3(a: int, b: int, c: int) -> int => a + b + c
let summed = apply_all(sum3, *)
write_line("{summed((1, 2, 3))}")

// a pure callee gives a pure function value
pure_scale(x: int, by: int) -> int pure => x * by
let pure_doubled: (int) -> int pure = pure_scale(*, 2)
write_line("{pure_doubled(21)}")

// a built-in operator named as a value
let incremented = [0, 1, 2] |> map(int.`+(*, 1)) |> collect()
write_line("{$(incremented)}")
let from_ten = int.`-(10, *)
write_line("{from_ten(3)}")
let total = [1, 2, 3] |> reduce(0, int.`+(*, *))
write_line("{total}")
