namespace Test is
    use IO.Std.write_line;
    use Ghul.Functional.apply;
    use Ghul.Functional.retry;
    use Ghul.Functional.memo;

    // Tests: the runtime's variadic combinators, imported across the
    // assembly boundary. A pack formal and a pack-marked return read the
    // same way from a consumed assembly as from a local declaration: the
    // arity of the function carried through is the arity of the call that
    // presents it.

    calls: int;

    concat(a: string, b: string) -> string => "{a}{b}";

    counted(a: int, b: int) -> int is
        calls = calls + 1;
        return a + b;
    si

    flaky(n: int) -> int is
        calls = calls + 1;
        if calls < 3 then
            throw System.Exception("boom");
        fi

        return n * 100;
    si

    entry() is
        // apply spreads any arity, including the one-argument reading
        write_line(apply(concat, "x", "y"));
        write_line("{apply((n: int) -> int => n * 2, 21)}");

        // retry preserves arity and retries until the attempts run out
        let safe = retry(flaky, 5);
        write_line("{safe(2)} calls={calls}");

        // memoize keys the cache on the whole argument tuple
        calls = 0;
        let fast = memo(counted);
        write_line("{fast(1, 2)} {fast(1, 2)} {fast(2, 3)} calls={calls}");
    si
si
