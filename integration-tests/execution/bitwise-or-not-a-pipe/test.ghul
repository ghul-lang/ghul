namespace Test is
    use Std = IO.Std;
    use Ghul.Pipes;

    // `|` is bitwise or, on one line or wrapped across two.

    class Main is
        entry() static is
            let xs = [1, 2, 3, 4, 5];

            let evens = xs |> filter(x => (x & 1) == 0) |> ARRAY();
            for v in evens do
                Std.out.write_line(v);
            od

            let a: int = 12;
            let b: int = 10;
            Std.out.write_line((a | b).to_string());

            Std.out.write_line(
                (a |
                    b).to_string());

            return;
        si
    si
si
