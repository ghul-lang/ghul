use default

doubled(xs: int[]) -> int => xs |> map(seen => seen * 2) |> sum()

first_even(xs: int[]) -> int is
    let index mut = 0

    while let seen = (if index < xs.count then xs[index] else null fi) do
        if seen % 2 == 0 then
            return seen
        fi

        index = index + 1
    od

    -1
si

let seen = doubled([1, 2, 3])
let even = first_even([1, 3, 4])

write_line("{seen} {even}")
