use IO.Std.write_line

pick(present: bool) -> (name: string, extra: string?)? is
    if present then
        return ("a", null)
    fi

    return null
si

show(held: (name: string, extra: string?)?) =>
    write_line("{held?.name} {held?.extra ?? "absent"}")

// A tuple literal with a null element takes its element types from an
// optional tuple type as it does from a tuple type, whether that type comes
// from a return or a variable.
entry() is
    if let (name, extra) = pick(true) then
        write_line("{name} {extra ?? "absent"}")
    fi

    write_line("{pick(false)?}")

    let held: (name: string, extra: string?)? = ("b", null)
    show(held)
si
