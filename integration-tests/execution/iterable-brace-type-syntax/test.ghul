use default

use Words = string{}

// `T{}` is `Collections.Iterable[T]` spelled as `T[]` spells an array,
// so each position accepts either spelling and hands the other on.
class HOLDER(items: int{} public) is
    doubled: int{} => items |> map(x => x * 2)
si

first_word(words: Words) -> string? => words |> first()
written_out(words: Collections.Iterable[string]) -> string{} => words
braced(words: string{}) -> Collections.Iterable[string] => words
lengths(rows: int[]{}) -> int{} => rows |> map(r => r.count)
nested(rows: int{}{}) -> int => rows |> map(r => r |> count()) |> sum()
maybe(items: int{}?) -> int => items ~> count() ?? -1

generic[T](items: T{}) -> T{} => items

let words: string{} = ["alpha", "beta"]

write_line("first {first_word(words)} {first_word(written_out(words))} {braced(words) |> count()}")
write_line("lengths {lengths([[1, 2], [3]])} nested {nested([[1], [2, 3]])}")
write_line("optional {maybe(null)} {maybe([4, 5])}")
write_line("holder {HOLDER([1, 2, 3]).doubled}")
write_line("generic {generic[int]([7, 8])} {generic(words) |> count()}")

let boxed: object = words

if let back: string{} = boxed then
    write_line("if let {back |> count()}")
fi

write_line("isa {isa string{}(boxed)} cast {cast string{}?(boxed) ~> count() ?? -1}")

let listed = LIST[int{}]()
listed.add([1, 2])
write_line("type argument {listed.count}")

// A braced type beside a brace comprehension and an interpolation.
let lazy: int{} = {x * 2 for x in 1::3}
write_line("lazy {lazy |> join(",")} literal {{}} {lazy |> count()}")
