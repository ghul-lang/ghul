namespace Test is
    use Std = IO.Std;

    class Main is
        run() -> Concurrency.Future static is
            let seen = Collections.LIST[string]();

            let body = () is
                seen.add("outer");

                await Concurrency.Future.yield();

                let inner = () => seen.add("inner");

                inner();
            si;

            await body();

            Std.write_line("{seen.count} {seen[0]} {seen[1]}");
        si

        entry() static is
            run().wait();
        si
    si
si
