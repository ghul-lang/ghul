use IO.Std.write_line
use Ghul.Pipes

struct Point(x: int public, y: int public);

class HOLDER[T] is
    slot: T? public field

    init() is
    si
si

first_present[T](xs: ARRAY[T?]) -> T? is
    for x in xs do
        if x? then
            return x
        fi
    od

    return null
si

present_count[T](xs: ARRAY[T?]) -> int is
    let count mut = 0

    for x in xs do
        if x? then
            count = count + 1
        fi
    od

    return count
si

or_else[T](value: T?, fallback: T) -> T => value ?? fallback

same[T](a: T?, b: T?) -> bool => a =~ b

boxed[T](value: T?) -> object? => value

// An array of `T?` built where `T` is a type parameter: its elements are
// the optional of whatever `T` is bound to.
with_absent_first[T](a: T, b: T) -> ARRAY[T?] =>
    [null, a, b]

all_absent[T]() -> ARRAY[T?] =>
    [null, null]

let names = with_absent_first("b", "c")
let numbers = with_absent_first(2, 3)
let points = with_absent_first(Point(1, 2), Point(3, 4))

write_line("{first_present(names)} {first_present(numbers)} {first_present(points)?.x}")
write_line("{present_count(names)} {present_count(numbers)} {present_count(points)}")

let empty_names = all_absent[string]()
write_line("{first_present(empty_names)} {or_else(first_present(empty_names), "fallback")}")

let holder = HOLDER[string]()
write_line("{holder.slot} {holder.slot ?? "none set"}")
holder.slot = "set"
write_line("{holder.slot}")

write_line("{same[string]("a", "a")} {same[string]("a", null)} {same[string](null, null)} {same[int](1, 1)}")

let absent: string? = null
write_line("{boxed[string](absent) == null} {boxed[string]("x") == null} {isa string(boxed[string]("x"))} {boxed[int](3)}")
