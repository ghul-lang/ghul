namespace Test is
    use IO.Std;
    use Collections;
    use Ghul.Pipes;

    // A terminal Pipe consumer reached via thread-first (`chain |>
    // collect_mutable()`, `chain |> count()`) desugars to a plain global-function
    // call over the chain, with no MEMBER receiver for the consumer-fusion
    // recognizer to key off - it must recognise the free-function shape too.

    class Main is
        entry() static is
            let xs = [1, 2, 3, 4, 5, 6];

            let collected = xs |> map(n => n * 2) |> collect_mutable();
            let sum mut = 0;

            for c in collected do
                sum = sum + c;
            od

            Std.write_line("collect: count={collected.count} sum={sum}");

            Std.write_line("count: {xs |> filter(n => n > 2) |> count()}");
        si
    si
si
