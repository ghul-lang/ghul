use IO.Std.write_line

some(n: int) -> int? => n

name_of(n: int) -> string? => "n{n}"

entry() is
    let f = (n: int) is
        write_line("f runs for {n}")

        if n > 0 then
            return some(n)
        fi

        null
    si

    write_line("f(3): {f(3)}")
    write_line("f(0): {f(0)}")

    let g = (n: int) is
        write_line("g runs for {n}")

        if n > 0 then
            return name_of(n)
        fi

        null
    si

    write_line("g(4): {g(4)}")
    write_line("g(0): {g(0)}")

    let seen: int? = for x in [1, 2, 3] do
        write_line("loop sees {x}")

        if x == 2 then
            break null
        fi
    od

    write_line("seen: {seen}")
si
