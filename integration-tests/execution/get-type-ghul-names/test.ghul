use default

// on wasm and llvm, a type reports its name as ghūl source writes it;
// on .NET get_type() is .NET's own Type, which reports .NET's names

class Box[T](item: T public)

struct Pair(a: int public)

union Shape is
    CIRCLE(r: double);
    SQUARE(s: double);
si

enum Suit is
    HEARTS,
si

show(o: object) => write_line("{o.get_type().full_name} | {o.get_type().name} | {o.get_type().namespace}")

show(1)
show(1.5)
show(2L)
show(3b)
show(4ub)
show('c')
show(true)
show("s")
show(3n)
show(3r + 4j)
show([1, 2] |> ARRAY())
show(["a"] |> ARRAY())
show([1, 2] |> LIST())
show(Box(1))
show(Box((1, "a")))
show(Geometry.Point(1))
show(Pair(1))
show(Shape.CIRCLE(1.0))
show(Suit.HEARTS)
show((1, "a"))
show(object())
