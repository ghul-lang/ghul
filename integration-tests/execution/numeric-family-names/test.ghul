use default

// The generic-math interfaces are named in Ghul.Math: a bound, a static
// member and an operator import work under those names.
use Ghul.Math.AdditionOperators.`+
use Ghul.Math.MultiplyOperators.`*

total[T: Ghul.Math.Number[T]](a: T, b: T) -> T => a + b

scaled[T: Ghul.Math.Number[T]](a: T, b: T) -> T => a * b

zero_of[T: Ghul.Math.NumberBase[T]]() -> T => T.zero

rotated[T: Ghul.Math.BinaryInteger[T]](value: T) -> T => T.rotate_left(value, 4)

mixed[T: Ghul.Math.Number[T]](a: T, b: T) -> T => scaled(total(a, b), b)

write_line("{total(3, 4)} {scaled(3, 4)} {zero_of[double]()} {rotated(1)} {mixed(2L, 5L)}")
