use default

// The generic-math interfaces are named in Ghul.Math, and their .NET names
// are a second spelling of the same types: a bound, a static member and an
// operator import work under either.
use Ghul.Math.AdditionOperators.`+
use System.Numerics.IMultiplyOperators.`*

total[T: Ghul.Math.Number[T]](a: T, b: T) -> T => a + b

scaled[T: System.Numerics.INumber[T]](a: T, b: T) -> T => a * b

zero_of[T: Ghul.Math.NumberBase[T]]() -> T => T.zero

rotated[T: System.Numerics.IBinaryInteger[T]](value: T) -> T => T.rotate_left(value, 4)

mixed[T: Ghul.Math.Number[T]](a: T, b: T) -> T => scaled(total(a, b), b)

write_line("{total(3, 4)} {scaled(3, 4)} {zero_of[double]()} {rotated(1)} {mixed(2L, 5L)}")
