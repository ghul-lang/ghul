use IO.Std.write_line

// A failing assert over a comparison or a call writes the values it
// compared, each evaluated once; strings and characters are quoted.

struct Pt(x: int public, y: int public)

check(a: int, b: string) -> bool => false

let count mut = 0

next() -> int is
    count = count + 1
    return count
si

run(label: string, action: () -> void) is
    try
        action()
        write_line("{label}: passed")
    catch e: Ghul.AssertFailedException
        let text = e.message
        write_line("{label}: {text.substring(text.index_of(": ") + 2)}")
    yrt
si

let xs = [1, 2, 3]
let s = "ab"
let c = 'q'
let missing: string? = null

run("int", () => (assert 41 == 42))
run("string", () => (assert s =~ "abc"))
run("char", () => (assert c == 'r'))
run("optional", () => (assert missing =~ "x"))
run("struct", () => (assert Pt(1, 2) =~ Pt(1, 3)))
run("property", () => (assert xs.count < 2))
run("not equal", () => (assert s !~ "ab"))
run("call", () => (assert check(7, "x")))
run("message", () => (assert s =~ "x" else "the name"))
run("once", () => (assert next() == 5))
write_line("count {count}")
run("passes", () => (assert next() == 2))
run("other condition", () => (assert xs.count < 2 /\ s =~ "ab"))
