use IO.Std.write_line
use Ghul.Pipes

// A local declared in a parenthesised block belongs to that block, so
// blocks side by side, and one inside another, can each declare their own.

side_by_side() -> int is
    let a = (let x = 1; x)
    let b = (let x = 2; x)

    return a + b
si

nested() -> int =>
    (let x = (let x = 10; x + 1); x * 2)

generator() -> int{} is
    yield (let y = 3; y)
    yield (let y = 4; y)
si

delay(n: int) -> Tasks.TASK[int] is
    await Tasks.TASK.yield()

    return n
si

asynchronous() -> Tasks.TASK[int] is
    let p = (let z = 5; await delay(z))
    let q = (let z = 6; await delay(z))

    return p + q
si

let t = (let u = 7; u)
let v = (let u = 8; u)

write_line("side by side: {side_by_side()}")
write_line("nested: {nested()}")
write_line("generator: {generator() |> join(", ")}")
write_line("async: {asynchronous().result}")
write_line("top level: {t + v}")
