use default

// The sibling an empty literal takes its element type from is itself
// typed only once the local it holds settles, on a later walk.
entry() is
    let k mut = null
    let flag = System.Environment.get_environment_variable("GHUL_TEST_NEVER_SET")?
    let arm = if flag then [] else [k] fi
    let nested = [[], [k]]

    k = 5

    write_line("arm {arm.get_type().name} {arm.count}")
    write_line("nested {nested.get_type().name} {nested[0].count} {nested[1].count}")
si
