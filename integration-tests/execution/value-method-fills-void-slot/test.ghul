// A method that answers a value can fill a trait slot that answers nothing:
// a set's `add -> bool` hides the `add` it inherits from a bag, and a call
// through the bag discards the answer.
use default

trait Bag[E] is
    add(value: E);
    count: int;
si

trait Unique[E]: Bag[E] is
    add(value: E) -> bool;
si

class SEEN: Unique[int] is
    _items: LIST[int]

    init() is
        _items = LIST[int]()
    si

    count: int => _items.count

    add(value: int) -> bool is
        if _items.contains(value) then
            return false
        fi

        _items.add(value)

        return true
    si
si

through_bag(bag: Bag[int]) is
    bag.add(1)
    bag.add(1)
    bag.add(2)

    write_line("through the bag: count {bag.count}")
si

through_unique(unique: Unique[int]) is
    write_line("through the set: add 3 {unique.add(3)}, add 3 again {unique.add(3)}, count {unique.count}")
si

entry() is
    let seen = SEEN()

    through_bag(seen)
    through_unique(seen)
si
