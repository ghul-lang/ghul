use IO.Std.write_line

// An array read outside its bounds throws IndexOutOfRangeException, as an
// array index does on every target, and an array's count is its length.

read(values: ARRAY[int], index: int) -> int => values[index]

attempt(name: string, operation: () -> void) is
    try
        operation()
        write_line("{name}: no exception")
    catch e: Ghul.IndexOutOfRangeException
        write_line("{name}: {e.message}")
    yrt
si

let values = [10, 20, 30]
let names: ARRAY[object] = ["a", "b"]
let points = [(x = 1, y = 2), (x = 3, y = 4)]

attempt("read past the end", () is read(values, 3) si)
attempt("read before the start", () is read(values, -1) si)

write_line("in range: {read(values, 2)}, {names[1]}, {points[1].y}")
write_line("counts: {values.count} {names.count} {points.count}")
