use default

let groups = [[1, 2, 3], [4, 5], [6]]

let firsts = {for x in xs do break x od for xs in groups}
let evens = [for x in xs do if x % 2 == 0 then break x fi od for xs in groups]

write_line("{firsts |> map(f => f ?? -1) |> join(", ")}")
write_line("{evens |> map(e => e ?? -1) |> join(", ")}")
