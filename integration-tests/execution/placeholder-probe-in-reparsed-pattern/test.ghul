use IO.Std.write_line

// A `case` arm's pattern and guard are parsed twice, once to classify the
// arm and once for real. A placeholder probed there is a one-token probe,
// not a loop, however many times it is read.
apply(n: int, test: (int) -> bool) -> bool => test(n)

f(p: (int, int)) -> string =>
    case p
    when (a, _) /\ apply(a, (* < 2)) then "small"
    else "other"
    esac

write_line(f((1, 2)))
write_line(f((5, 2)))
