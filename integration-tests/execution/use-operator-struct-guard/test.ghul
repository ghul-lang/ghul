use IO.Std.write_line

// A guard that is committed or cancelled through the local holding it,
// the way a speculation guard is: dispose acts only if neither happened.
struct GUARD: Ghul.Disposable is
    _name: string
    _active: bool

    init(name: string) is
        _name = name
        _active = true
        write_line("  open {name}")
    si

    commit() is
        _active = false
    si

    dispose() is
        if _active then
            write_line("  roll back {_name}")
        else
            write_line("  nothing to roll back for {_name}")
        fi
    si
si

committed() is
    write_line("committed:")
    let guard = use GUARD("a")
    guard.commit()
    write_line("  end of block")
si

not_committed() is
    write_line("not committed:")
    let guard = use GUARD("b")
    write_line("  end of block")
si

committed_in_a_loop() is
    write_line("committed in a loop:")
    for i in 0..2 do
        let guard = use GUARD("loop {i}")
        if i == 1 then
            guard.commit()
        fi
    od
si

old_spelling() is
    write_line("old spelling:")
    let use guard = GUARD("c")
    guard.commit()
si

mut_local_keeps_its_copy() is
    write_line("mut local:")
    let guard mut = use GUARD("d")
    guard.commit()
si

committed()
not_committed()
committed_in_a_loop()
old_spelling()
mut_local_keeps_its_copy()
