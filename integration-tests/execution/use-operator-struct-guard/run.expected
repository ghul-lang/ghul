committed:
  open a
  end of block
  nothing to roll back for a
not committed:
  open b
  end of block
  roll back b
committed in a loop:
  open loop 0
  roll back loop 0
  open loop 1
  nothing to roll back for loop 1
old spelling:
  open c
  nothing to roll back for c
mut local:
  open d
  roll back d
