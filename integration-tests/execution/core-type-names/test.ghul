namespace Test is
    use IO.Std.write_line

    // A value of a renamed type made under one name and used under the
    // other, in each direction.

    describe_old(e: System.Exception) -> string => "old param: {e.message}"
    describe_new(e: Ghul.Exception) -> string => "new param: {e.message}"

    append_old(builder: System.Text.StringBuilder, text: string) is builder.append(text) si
    append_new(builder: Text.STRING_BUILDER, text: string) is builder.append(text) si

    key_old(pair: Collections.KeyValuePair[string, int]) -> string => pair.key
    key_new(pair: Collections.KEY_VALUE_PAIR[string, int]) -> string => pair.key

    entry() is
        let made_new: Ghul.Exception = Ghul.Exception("made new")
        let made_old: System.Exception = System.Exception("made old")
        let assigned_old: System.Exception = made_new
        let assigned_new: Ghul.Exception = made_old

        write_line(describe_old(assigned_new))
        write_line(describe_new(assigned_old))

        try
            throw Ghul.InvalidOperationException("thrown new")
        catch e: System.InvalidOperationException
            write_line("caught old: {e.message}")
        yrt

        try
            throw System.InvalidOperationException("thrown old")
        catch e: Ghul.InvalidOperationException
            write_line("caught new: {e.message}")
        yrt

        let builder_new = Text.STRING_BUILDER()
        let builder_old = System.Text.StringBuilder()

        append_old(builder_new, "new built, ")
        append_new(builder_new, "old appended")
        append_new(builder_old, "old built, ")
        append_old(builder_old, "old appended")

        write_line("{builder_new}")
        write_line("{builder_old}")

        write_line("math: {System.Math.max(2, 3)} {Ghul.Math.min(2, 3)} {Ghul.Math.abs(System.Math.min(-4, 1))}")

        let pair_new = Collections.KEY_VALUE_PAIR[string, int]("new pair", 1)
        let pair_old = Collections.KeyValuePair[string, int]("old pair", 2)

        write_line("{key_old(pair_new)} {key_new(pair_old)} {Collections.KeyValuePair.create("created", 3).value}")

        // Every renamed type is the same type under either name.
        write_line("{typeof System.Exception == typeof Ghul.Exception}")
        write_line("{typeof System.NotImplementedException == typeof Ghul.NotImplementedException}")
        write_line("{typeof System.InvalidOperationException == typeof Ghul.InvalidOperationException}")
        write_line("{typeof System.NotSupportedException == typeof Ghul.NotSupportedException}")
        write_line("{typeof System.ArgumentException == typeof Ghul.ArgumentException}")
        write_line("{typeof System.ArgumentOutOfRangeException == typeof Ghul.ArgumentOutOfRangeException}")
        write_line("{typeof System.ArithmeticException == typeof Ghul.ArithmeticException}")
        write_line("{typeof System.DivideByZeroException == typeof Ghul.DivideByZeroException}")
        write_line("{typeof System.OverflowException == typeof Ghul.OverflowException}")
        write_line("{typeof System.IndexOutOfRangeException == typeof Ghul.IndexOutOfRangeException}")
        write_line("{typeof System.InvalidCastException == typeof Ghul.InvalidCastException}")
        write_line("{typeof System.NullReferenceException == typeof Ghul.NullReferenceException}")
        write_line("{typeof System.FormatException == typeof Ghul.FormatException}")
        write_line("{typeof System.Text.StringBuilder == typeof Text.STRING_BUILDER}")
        write_line("{typeof System.Math == typeof Ghul.Math}")
        write_line("{typeof System.Random == typeof Ghul.RANDOM}")
        write_line("{typeof System.StringSplitOptions == typeof Ghul.StringSplitOptions}")
        write_line("{typeof System.StringComparison == typeof Ghul.StringComparison}")
        write_line("{typeof Collections.KeyValuePair[_, _] == typeof Collections.KEY_VALUE_PAIR[_, _]}")
        write_line("{typeof Collections.KeyValuePair == typeof Collections.KEY_VALUE_PAIR}")
    si
si
