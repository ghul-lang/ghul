use default

// A pipe stage that isn't fused is walked again as a closure. A literal
// inside it that captures a parameter from further out still reaches it.

let n = (m: int) => [0, 1] |> map(j => [0] |> map(i => m + j))

write_line("{n(7) |> map(x => x |> list()) |> list()}")

let three = (m: int) => [0] |> map(a => [0] |> map(b => [0] |> map(c => m)))

write_line("{three(5) |> map(x => x |> map(y => y |> list()) |> list()) |> list()}")

let outer = (k: int) => (
    let inner = (m: int) => [0] |> map(j => [0] |> map(i => m + k))
    inner(7) |> map(x => x |> list()) |> list()
)

write_line("{outer(100)}")

