// A `T?` over an unconstrained type parameter and an `int?` in one
// signature, instantiated at a value type, a reference type, a struct and
// an optional, must agree on every target about which values are absent.

use IO.Std.write_line

struct Point(x: int public, y: int public) is
    to_string() -> string => "({x}, {y})";
si

show[T](x: T?, y: int?) -> string =>
    "{if x? then "x={x}" else "x absent" fi} {if y? then "y={y}" else "y absent" fi}"

pair[T](x: T?, y: int?) -> (T?, int?) => (x, y)

apply[T](f: (T?, int?) -> string, x: T?, y: int?) -> string => f(x, y)

class Holder[T](item: T? public, count: int? public) is
    describe() -> string => show(item, count);
si

show_pair[T](p: (T?, int?)) -> string =>
    let (x, y) = p in show(x, y)

write_line("int: {show[int](1, 2)} / {show[int](null, null)}")
write_line("string: {show[string]("s", 2)} / {show[string](null, null)}")
write_line("struct: {show[Point](Point(1, 2), 3)} / {show[Point](null, null)}")

write_line("tuple int: {show_pair(pair[int](6, null))} / {show_pair(pair[int](null, 7))}")
write_line("tuple string: {show_pair(pair[string]("t", null))} / {show_pair(pair[string](null, 8))}")

write_line("function int: {apply[int](show[int], 9, null)} / {apply[int]((x, y) => show(x, y), null, 10)}")
write_line("function struct: {apply[Point](show[Point], Point(3, 4), null)}")

write_line("holder int: {Holder[int](11, null).describe()} / {Holder[int](null, 12).describe()}")
write_line("holder string: {Holder[string]("h", 13).describe()} / {Holder[string](null, null).describe()}")
write_line("holder struct: {Holder[Point](Point(5, 6), null).describe()}")
