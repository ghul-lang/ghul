use IO.Std.write_line

// The old spellings of the renamed locale members still compile for one
// release.

let invariant = Text.Locale.invariant_culture
let current = Text.Locale.current_culture
let current_ui = Text.Locale.current_u_i_culture
let neutral = Text.Locale.get_culture_info("")

write_line("[{invariant.name}] {current.name.length >= 0} {current_ui.name.length >= 0} [{neutral.name}]")
