use default

// Tests: T[,] and T[,,] name the two- and three-dimensional array traits.
// An array literal of rows or planes builds one where one is expected,
// from an annotation or a parameter, and MATRIX builds a mutable one,
// choosing its rank from what it is given.

grid_total(m: int[,]) -> int is
    let (rows, columns) = m.lengths
    let total mut = 0

    for i in 0..rows do
        for j in 0..columns do
            total = total + m[i, j]
        od
    od

    total
si

corners(c: string[,,]) -> string is
    let (planes, rows, columns) = c.lengths
    "{c[0, 0, 0]}{c[planes - 1, rows - 1, columns - 1]}"
si

identity() -> int[,] => [[1, 0], [0, 1]]

entry() is
    let m: int[,] = [[1, 2, 3], [4, 5, 6]]
    write_line("{m} {m.lengths} {m.count} {m[1]} {m[1][2]} {m.elements |> list()}")
    write_line("{grid_total(m)} {grid_total([[10, 20], [30, 40]])}")

    for row in m do
        write_line("row {row}")
    od

    let c: string[,,] = [[["a", "b"], ["c", "d"]], [["e", "f"], ["g", "h"]]]
    write_line("{corners(c)} {c.lengths} {c[1]}")

    let rows = MATRIX([[1, 2], [3, 4]])
    rows[0, 1] = 20
    write_line("{rows} {grid_total(rows)}")

    let planes = MATRIX([[[1, 2]], [[3, 4]], [[5, 6]]])
    planes[2, 0, 1] = 60
    write_line("{planes.lengths} {planes[2, 0, 1]}")

    let dots = repeat('.') |> MATRIX(2, 3)
    dots[1, 1] = '#'
    write_line("{dots}")

    let numbered = from(1) |> MATRIX(2, 2, 2)
    write_line("{numbered.lengths} {numbered[1, 1, 1]}")

    let same: int[,] = [[1, 2, 3], [4, 5, 6]]
    write_line("{m =~ same} {m =~ rows}")
    write_line("{identity()} {identity()[1, 1]}")
si
