use default

score(box) => box |> map(w => w.color.red) |> max()!

worst_of(colors) => (
    let boxes = LIST([colors])
    boxes |> max_by(score)!
)

let colors = [(color = (red = 1, green = 2, blue = 3), count = 4), (color = (red = 9, green = 2, blue = 1), count = 2)]

write_line("{worst_of(colors)}")
write_line("{[[3, 1], [2]] |> map(box => box |> max()!) |> list()}")
