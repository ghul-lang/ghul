namespace Formatting is
    use IO.Std;

    bare(n: int) -> int -> int => m => n + m;

    parenthesised(n: int) -> (int) -> int => m => n + m;

    grouped(f: (int) -> int) -> (int) -> int => n => f(n + 1);

    nested(n: int) -> ((int) -> int) -> int => f => f(n);

    redundant(f: (((((int -> int))))) -> int) -> int => f((g: int) => g);

    optional(t: ((int) -> int)?) -> int is
        if let g = t then
            return g(1)
        fi

        return 0
    si

    entry() is
        Std.write_line("{bare(1)(2)} {parenthesised(1)(2)}");
        Std.write_line("{grouped(n => n * 2)(3)} {nested(4)(m => m * 10)}");
        Std.write_line("{redundant((g: int -> int) => g(0))} {optional(n => n + 1)}");
    si
si
