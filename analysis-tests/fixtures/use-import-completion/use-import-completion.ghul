use Ghul.Pipes
use Collections
use IO.Std.*

// Every name a `use` makes reachable unqualified should be offered.
// The `run` body is, by line:
//
//   11  a namespace import's global function, by prefix
//   12  a wildcard class import's static, by prefix
//   13  a namespace import's type, by prefix
//   14  a namespace import's global function, after a `|>`
run(xs: int[]) is
    let a = cou
    let b = write_l
    let c = LIS
    let d = xs |> cou
si
