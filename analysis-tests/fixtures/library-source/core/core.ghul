// The members of the built-in types the test reads, declared as the core
// library declares them.
namespace Ghul.Intrinsics.Staging is
    @intrinsic("arithmetic.add") +(a: int, b: int) -> int pure
    @intrinsic("string.length") _string_length(text: string) -> int pure
si

namespace Ghul is
    partial string is
        /// The number of code units.
        length: int => _string_length(self)
    si
si

namespace Ghul.Internal is
    // A constructor the core library offers string, as it declares the ones
    // .NET's string has.
    class STRING_CHAR_CONSTRUCTORS is
        @intrinsic("constructor.from_chars")
        from_chars(chars: char[]) -> string static pure => ""
    si
si
