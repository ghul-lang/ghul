// The optional carrier, declared as the core library declares it, and a
// library function that returns one.
namespace Ghul is
    trait Maybe[T] open is
        has_value: bool
        value: T
    si

    struct MAYBE[T]: Maybe[T] is
        _has_value: bool
        _value: T

        has_value: bool pure => _has_value
        value: T pure => _value

        init() pure is
        si

        init(value: T) pure is
            _has_value = true
            _value = value
        si
    si
si

namespace Lib is
    use Ghul.MAYBE

    first() -> MAYBE[int] pure => MAYBE(1)
si
