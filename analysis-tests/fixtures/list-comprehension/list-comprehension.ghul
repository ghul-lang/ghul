namespace Test is
    use IO.Std.write_line

    squares(xs: ARRAY[int]) -> ARRAY[int] =>
        [value * value for value in xs if value > 0]

    names(items: ARRAY[string?]) -> ARRAY[int] =>
        [item.length for item in items if item?]

    entry() is
        write_line("{squares([1, 2])}")
    si
si
