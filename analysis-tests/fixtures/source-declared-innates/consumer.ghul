namespace Consumer is
    use Collections;
    use ARRAY = Ghul.Intrinsics.Staging.ARRAY;

    // `to_array` is reflected and returns an array, so its signature is
    // built over the innate array type. The declared return type is built
    // over the same innate, and the two have to be the same type.
    to_array[T](source: Iterable[T]) -> ARRAY[T] =>
        LIST[T](source).to_array();

    // An array reached through its base type, so the innate array's own
    // ancestry has to still line up with what `Collections.List` and
    // `Iterable` resolve to.
    count_of[T](values: List[T]) -> int => values.count;

    count_of_array[T](values: ARRAY[T]) -> int => count_of(values);

    copy_of[T](values: ARRAY[T]) -> LIST[T] is
        let result = LIST[T]();

        for value in values do
            result.add(value);
        od

        return result;
    si

    // `try_get_value` takes an `out` parameter, built over the innate
    // reference type.
    group_of[K,V](groups: MAP[K, LIST[V]], key: K) -> LIST[V]? is
        let group: LIST[V] mut;

        if groups.try_get_value(key, group ref) then
            return group;
        fi

        return null;
    si
si
