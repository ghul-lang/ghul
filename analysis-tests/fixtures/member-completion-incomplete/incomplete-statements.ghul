namespace MemberCompletionVariety is
    class Greeter is
        init() is si

        greet() -> string => "hello";
    si

    in_while() is
        let g = Greeter();
        while g.
    si

    in_return() -> string is
        let g = Greeter();
        return g.
    si

    in_let() is
        let g = Greeter();
        let y = g.
    si
si
