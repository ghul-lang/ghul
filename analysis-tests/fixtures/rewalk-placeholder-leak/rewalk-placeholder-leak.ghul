// Repro fixture for the EDIT-after-EDIT phantom-placeholder leak. The
// incremental body re-walk drives COMPILE_EXPRESSIONS directly rather
// than through its apply(), so the phantom type-arg placeholders minted
// by the previous walk stayed in TYPE_ARG_PLACEHOLDER_REGISTRY. The
// first function whose body-retry loop fails to converge sweeps the
// whole registry via report_unresolved, so it reports the previous
// walk's leftovers — including the phantom sets minted for overload
// candidates that lost their resolution and were rolled back, which are
// unresolved without being errors.
//
// Two halves are needed. `stringify_list` is the poisoner: its retry
// loop consumes an unresolved type and does not converge clean, which
// is what arms the sweep. `counter` is the victim: `stream` is a
// generic whose type-args come from context, so resolving the call
// mints placeholder sets that are rolled back as candidates are
// discarded. The visible symptom is "cannot infer type here" on the
// victim from the second EDIT onwards, reported against the previous
// walk's locations.

namespace RewalkPlaceholderLeak is
    use IO.Std;

    use Ghul.Pipes.stream;

    union List[T] is
        NIL;
        CONS(head: T, tail: List[T]);
    si

    use List.NIL;
    use List.CONS;

    poisoner[T](elements: Collections.List[T]) -> string =>
        let
            list = CONS(elements[0], NIL),
            stringify_list = l rec =>
                if let (head, tail): CONS = l then
                    "{head}, {rec(tail)}"
                else
                    "nil"
                fi
        in
            stringify_list(list);

    victim() is
        let counter = stream(
            (previous = 1, current = 1),
            ((previous, current)) => (current, (previous = current, current = previous + current))
        );

        Std.write_line("{counter}");
    si
si
