namespace Analysis.Tests is
    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // One test per guard that hands an edit back to the whole-project
    // rebuild, asserting that the guard which fired is the one the edit
    // shape should have tripped.
    //
    // The aggregate "this edit fell back" tally cannot distinguish a guard
    // firing for its own reason from a guard one step earlier firing for
    // an unrelated one, and the two are indistinguishable in the answers -
    // both produce a correct rebuild. Naming the reason is what turns a
    // guard into something testable.
    //
    // Each guard here is one the incremental paths could in principle grow
    // to handle; the counters are also the evidence for which of them is
    // worth lifting first.
    @TestClass()
    class EDIT_DECLINE_TESTS is
        init() is si

        // Two top-level definitions. The guards that reject on the *shape
        // of the file* compare top-level definitions, and a file's
        // definitions all sit inside one namespace - explicit here, or
        // compiler-generated when the file declares none - so reaching
        // those guards takes two namespaces rather than two members.
        baseline() -> string =>
            "namespace DeclineA is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "si\n"
            "\n"
            "namespace DeclineB is\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // A signature changed in each namespace: two top-level
        // definitions differ, and only one changed window can be replaced.
        two_namespaces_changed() -> string =>
            "namespace DeclineA is\n"
            "    alpha(a: int) -> int is\n"
            "        return a;\n"
            "    si\n"
            "si\n"
            "\n"
            "namespace DeclineB is\n"
            "    beta(b: int) -> int is\n"
            "        return b;\n"
            "    si\n"
            "si\n";

        // A whole top-level definition removed: the donor has fewer than
        // the retained tree, which is neither the append nor the
        // replace-one shape.
        namespace_deleted() -> string =>
            "namespace DeclineA is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "si\n";

        // A namespace added *before* the retained ones: the donor has
        // more top-level definitions, but the retained prefix no longer
        // pairs index for index, so this is not an append.
        namespace_inserted_first() -> string =>
            "namespace DeclineZ is\n"
            "    gamma() -> int is\n"
            "        return 3;\n"
            "    si\n"
            "si\n"
            "\n"
            "namespace DeclineA is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "si\n"
            "\n"
            "namespace DeclineB is\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        // `open` added to the class header. The narrowing search cannot
        // descend into a class whose header changed, and the wider route -
        // replacing the class in the namespace's member list - does not
        // apply either, since a class is not a function.
        class_header_changed() -> string =>
            "namespace Decline is\n"
            "    class HOLDER open is\n"
            "        init() is si\n"
            "\n"
            "        alpha() -> int is\n"
            "            return 1;\n"
            "        si\n"
            "    si\n"
            "si\n";

        single_namespace_baseline() -> string =>
            "namespace Decline is\n"
            "    class HOLDER is\n"
            "        init() is si\n"
            "\n"
            "        alpha() -> int is\n"
            "            return 1;\n"
            "        si\n"
            "    si\n"
            "si\n";

        namespace_renamed() -> string =>
            "namespace Declined is\n"
            "    class HOLDER is\n"
            "        init() is si\n"
            "\n"
            "        alpha() -> int is\n"
            "            return 1;\n"
            "        si\n"
            "    si\n"
            "si\n";

        // Two namespace-level functions, the second of which the edit
        // turns into a class: the outgoing window member is a function,
        // the incoming one is not.
        functions_baseline() -> string =>
            "namespace DeclineKind is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    beta() -> int is\n"
            "        return 2;\n"
            "    si\n"
            "si\n";

        function_replaced_with_a_class() -> string =>
            "namespace DeclineKind is\n"
            "    alpha() -> int is\n"
            "        return 1;\n"
            "    si\n"
            "\n"
            "    class BETA is\n"
            "        init() is si\n"
            "    si\n"
            "si\n";

        // A property whose type changes: the outgoing window member is a
        // property, not a function.
        property_baseline() -> string =>
            "namespace DeclineProp is\n"
            "    class BOX is\n"
            "        init() is si\n"
            "\n"
            "        value: int;\n"
            "    si\n"
            "si\n";

        property_type_changed() -> string =>
            "namespace DeclineProp is\n"
            "    class BOX is\n"
            "        init() is si\n"
            "\n"
            "        value: string;\n"
            "    si\n"
            "si\n";

        // A base class with a ghūl-declared overrider. Changing the base
        // method's signature would leave the subclass's own declaration
        // diagnostics computed against the old one.
        overridden_baseline() -> string =>
            "namespace DeclineOverride is\n"
            "    class BASE open is\n"
            "        init() is si\n"
            "\n"
            "        describe() -> int is\n"
            "            return 1;\n"
            "        si\n"
            "    si\n"
            "\n"
            "    class DERIVED: BASE is\n"
            "        init() is super.init(); si\n"
            "\n"
            "        describe() -> int is\n"
            "            return 2;\n"
            "        si\n"
            "    si\n"
            "si\n";

        // The base method's *signature* changed. The subclass's own
        // declaration diagnostics were derived against the old one and the
        // in-place swap would not re-derive them.
        overridden_signature_changed() -> string =>
            "namespace DeclineOverride is\n"
            "    class BASE open is\n"
            "        init() is si\n"
            "\n"
            "        describe(n: int) -> int is\n"
            "            return n;\n"
            "        si\n"
            "    si\n"
            "\n"
            "    class DERIVED: BASE is\n"
            "        init() is super.init(); si\n"
            "\n"
            "        describe() -> int is\n"
            "            return 2;\n"
            "        si\n"
            "    si\n"
            "si\n";

        @Test()
        two_changed_declarations_decline_as_multiple_changed_definitions() is
            assert_declines(
                "changing a signature in each of two namespaces",
                baseline(),
                two_namespaces_changed(),
                "multiple-changed-definitions"
            );
        si

        @Test()
        deleting_a_declaration_declines_as_fewer_definitions() is
            assert_declines(
                "deleting a whole namespace",
                baseline(),
                namespace_deleted(),
                "fewer-definitions"
            );
        si

        @Test()
        inserting_a_declaration_before_the_others_declines_as_prefix_mismatch() is
            assert_declines(
                "inserting a namespace ahead of the retained ones",
                baseline(),
                namespace_inserted_first(),
                "retained-prefix-mismatch"
            );
        si

        @Test()
        renaming_the_namespace_declines_as_namespace_name_mismatch() is
            assert_declines(
                "renaming the namespace",
                single_namespace_baseline(),
                namespace_renamed(),
                "namespace-name-mismatch"
            );
        si

        @Test()
        changing_a_class_header_declines_as_class_header_mismatch() is
            assert_declines(
                "adding open to the class header",
                single_namespace_baseline(),
                class_header_changed(),
                "class-header-mismatch"
            );
        si

        @Test()
        replacing_a_function_with_a_class_declines_as_incoming_not_a_function() is
            assert_declines(
                "replacing a namespace function with a class",
                functions_baseline(),
                function_replaced_with_a_class(),
                "incoming-not-a-function"
            );
        si

        @Test()
        changing_a_property_declines_as_outgoing_not_a_function() is
            assert_declines(
                "changing a property's type",
                property_baseline(),
                property_type_changed(),
                "outgoing-not-a-function"
            );
        si

        @Test()
        editing_an_overridden_method_declines_as_outgoing_has_overriders() is
            assert_declines(
                "editing a class whose method a subclass overrides",
                overridden_baseline(),
                overridden_signature_changed(),
                "outgoing-has-overriders"
            );
        si

        // A file carrying top-level statements, in a build where files
        // with no namespace share one: a `let` among the statements is
        // then visible to every other such file, and an edit that adds,
        // removes or retypes one changes what they resolve against with
        // no definition's signature changing. Without --global-namespace
        // the variables are private to the file and the edit re-walks.
        top_level_statements_baseline() -> string =>
            "let count = 1;\n"
            "\n"
            "show() -> int is\n"
            "    return count;\n"
            "si\n"
            "\n"
            "show();\n";

        top_level_statements_body_edited() -> string =>
            "let count = 1;\n"
            "\n"
            "show() -> int is\n"
            "    return count + 1;\n"
            "si\n"
            "\n"
            "show();\n";

        @Test()
        editing_a_file_with_top_level_statements_declines_under_a_global_namespace() is
            let use analyser = ANALYSER_PROCESS(["--global-namespace"]);

            edit_and_drain(analyser, "decline.ghul", top_level_statements_baseline());

            assert_work(
                analyser,
                "editing a function body in a file with top-level statements, under --global-namespace",
                [
                    exactly(declined("top-level-statements"), 1),
                    exactly(edit_path_full_rebuild, 1),
                    exactly(edit_path_interface_incremental, 0),
                    exactly(edit_path_body_rewalk, 0)
                ],
                () is
                    edit_and_drain(analyser, "decline.ghul", top_level_statements_body_edited());
                si
            );
        si

        // A function written with no types has its signature inferred from
        // every body in its file, and the bounds those bodies record stay on
        // its symbols, so an edit to any of them rebuilds instead of
        // re-walking.
        @Test()
        editing_a_file_with_an_inferred_signature_declines() is
            assert_declines(
                "editing a function body in a file with a function whose signature is inferred",
                "twice(x) => x * 2\n"
                "\n"
                "show() -> int => twice(21)\n",
                "twice(x) => x * 2\n"
                "\n"
                "show() -> int => twice(20) + 2\n",
                "inferred-signatures"
            );
        si

        // Prime with `baseline`, apply `edited`, and assert the named
        // guard fired exactly once and the edit fell back. Asserting the
        // fallback too keeps a test honest that would otherwise pass on a
        // guard that fired and was then overtaken by a later path.
        assert_declines(
            description: string,
            baseline_source: string,
            edited_source: string,
            reason: string
        ) is
            let use analyser = ANALYSER_PROCESS();

            edit_and_drain(analyser, "decline.ghul", baseline_source);

            assert_work(
                analyser,
                description,
                [
                    exactly(declined(reason), 1),
                    exactly(edit_path_full_rebuild, 1),
                    exactly(edit_path_interface_incremental, 0),
                    exactly(edit_path_body_rewalk, 0)
                ],
                () is
                    edit_and_drain(analyser, "decline.ghul", edited_source);
                si
            );
        si

        edit_and_drain(analyser: ANALYSER_PROCESS, path: string, source: string) is
            analyser.send_edit(path, source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response after EDIT";
        si
    si
si
