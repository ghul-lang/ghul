namespace Analysis.Tests is
    use Ghul.Pipes
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // The right-hand side of a `|>` offers the names the threaded subject
    // can be passed to, rather than every name in scope. The fixture's
    // `run` body is, by line:
    //
    //   11  let a = n |>              (nothing typed yet)
    //   12  let b = n |> dou          (a name, no argument list yet)
    //   13  let c = "s" |>            (a string subject)
    //   14  let d = n |> double();    (a finished call)
    //   15  let e = n |> Math.        (a member position inside the call)
    @TestClass()
    class THREAD_FIRST_COMPLETION_TESTS is
        init() is si

        load() -> string is
            let path = fixture_path("thread-first-completion/thread-first-completion.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        complete(analyser: ANALYSER_PROCESS, line: int, column: int) -> Collections.SET[string] is
            analyser.send_completion("thread-first-completion.ghul", line, column);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            let names = Collections.SET[string]();

            for item in response.items do
                names.add(item.name);
            od

            return names;
        si

        opened() -> ANALYSER_PROCESS is
            let analyser = ANALYSER_PROCESS();

            analyser.send_edit("thread-first-completion.ghul", load());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            return analyser;
        si

        @Test()
        an_unfinished_thread_first_offers_only_what_the_subject_can_be_threaded_into() is
            let use analyser = opened();

            let names = complete(analyser, 11, 22)

            is_true(names.contains("double"), "expected `double`, which takes an int first")
            is_true(names.contains("describe"), "expected `describe`, which takes an int first")
            is_true(names.contains("doubler"), "expected `doubler`, a local holding an int -> int")

            is_false(names.contains("shout"), "`shout` takes a string, not an int")
            is_false(names.contains("n"), "a local of ordinary type cannot lead a call")
            is_false(names.contains("int"), "`int` has no static taking an int first")
            is_false(names.contains("if"), "a statement keyword cannot lead a call");
        si

        @Test()
        a_partly_typed_name_after_the_operator_is_filtered_the_same_way() is
            let use analyser = opened();

            let names = complete(analyser, 12, 25)

            is_true(names.contains("double"), "expected `double`")
            is_false(names.contains("shout"), "`shout` takes a string, not an int");
        si

        @Test()
        the_subject_type_decides_which_functions_are_offered() is
            let use analyser = opened();

            let names = complete(analyser, 13, 24)

            is_true(names.contains("shout"), "expected `shout`, which takes a string first")
            is_false(names.contains("double"), "`double` takes an int, not a string");
        si

        // A namespace carries no shape to judge, and a type stays only when
        // one of its own constructors or static functions could take the
        // subject. `System.Math` has `abs(int)`; `int` has nothing that
        // takes an int first.
        @Test()
        namespaces_are_offered_and_types_are_offered_on_their_static_members() is
            known_source_library_gap("ghul-lang/ghul#3989")
            let use analyser = opened();

            let names = complete(analyser, 11, 22)

            is_true(names.contains("System"), "a namespace leads a qualified call")
            is_true(names.contains("Math"), "expected `Math`, whose `abs` takes an int first")
            is_false(names.contains("string"), "`string` has no static taking an int first");
        si

        @Test()
        the_name_of_a_finished_thread_first_call_is_filtered_too() is
            let use analyser = opened();

            let names = complete(analyser, 14, 23)

            is_true(names.contains("double"), "expected `double`")
            is_false(names.contains("shout"), "`shout` takes a string, not an int");
        si

        // Only the operator and the called name are the thread-first
        // position. Inside the argument list the user is writing an
        // ordinary expression, and every name in scope belongs there.
        @Test()
        the_argument_list_of_a_thread_first_call_is_an_ordinary_position() is
            let use analyser = opened();

            let names = complete(analyser, 14, 31)

            is_true(names.contains("n"), "expected the local `n`")
            is_true(names.contains("shout"), "expected every function, filtered by nothing");
        si

        // A `|>` call written against a receiver or a namespace puts the
        // cursor in a member position inside the same completion target.
        // Those results are the receiver's members and are already the
        // right ones, so nothing filters them.
        @Test()
        a_member_position_inside_a_thread_first_call_is_not_filtered() is
            known_source_library_gap("ghul-lang/ghul#3989")
            let use analyser = opened();

            let names = complete(analyser, 15, 27)

            is_true(names.contains("abs"), "expected `abs`, a member of Math")
            is_true(names.contains("sqrt"), "expected `sqrt`, whose parameter is not an int");
        si

        @Test()
        an_ordinary_position_is_unaffected() is
            let use analyser = opened();

            let names = complete(analyser, 9, 20)

            is_true(names.contains("n"), "expected the local `n`")
            is_true(names.contains("shout"), "expected every function, filtered by nothing");
        si
    si
si
