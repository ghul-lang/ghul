namespace Analysis.Tests is
    use System.Diagnostics.Process
    use System.Diagnostics.ProcessStartInfo

    use IO.Directory
    use IO.File
    use IO.Path

    use Analysis.Protocol.ANALYSER_PROCESS
    use Analysis.Protocol.Response

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A doc comment is carried into the compiled assembly, so hovering a
    // symbol imported from another ghūl assembly shows it too.
    @TestClass()
    class IMPORTED_DOC_COMMENT_TESTS is
        _directory: string

        init() is
            _directory = Path.combine(Path.get_temp_path(), "ghul-imported-docs-{System.Guid.new_guid()}")

            Directory.create_directory(_directory)
        si

        library_source: string =>
            "namespace Documented is\n"
            "    /// A thing with a size.\n"
            "    class WIDGET is\n"
            "        /// How big it is.\n"
            "        size: int\n"
            "\n"
            "        init() is si\n"
            "\n"
            "        /// Doubles the size.\n"
            "        grow() is size = size * 2; si\n"
            "    si\n"
            "\n"
            "    /// Shades.\n"
            "    enum Shade is\n"
            "        /// Quite dark.\n"
            "        DARK,\n"
            "        LIGHT\n"
            "    si\n"
            "\n"
            "    /// Makes a widget.\n"
            "    make() -> WIDGET => WIDGET()\n"
            "si\n"

        consumer_source: string =>
            "use Documented\n"
            "\n"
            "try_it() is\n"
            "    let w = make()\n"
            "    w.grow()\n"
            "    let s = w.size\n"
            "    let d = Shade.DARK\n"
            "    let x: WIDGET = w\n"
            "si\n"

        compile_library() -> string is
            let source = Path.combine(_directory, "documented.ghul")
            let output = Path.combine(_directory, "documented.dll")

            File.write_all_text(source, library_source)

            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.argument_list.add(ANALYSER_PROCESS.resolve_compiler_dll())
            start_info.argument_list.add("--library")
            start_info.argument_list.add("-o")
            start_info.argument_list.add(output)
            start_info.argument_list.add(source)

            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            let use process = Process.start(start_info)!

            let out = process.standard_output.read_to_end()
            let err = process.standard_error.read_to_end()
            process.wait_for_exit()

            are_equal(0, process.exit_code, "library compile failed:\n{out}\n{err}")

            return output
        si

        hover_doc(analyser: ANALYSER_PROCESS, line: int, column: int) -> string? is
            analyser.send_hover("consumer.ghul", line, column)

            let response = analyser.read_query_response()
            assert isa Response.HOVER(response) else "expected HOVER response"

            return (cast Response.HOVER(response)).doc
        si

        @Test()
        imported_symbols_carry_their_doc_comments() is
            requires_assembly_fixtures()
            let library = compile_library()

            let use analyser = ANALYSER_PROCESS(["--reference", library])

            analyser.send_edit("consumer.ghul", consumer_source)

            let diagnostics = analyser.read_response()
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response"

            are_equal("Makes a widget.", hover_doc(analyser, 4, 13))
            are_equal("Doubles the size.", hover_doc(analyser, 5, 7))
            are_equal("How big it is.", hover_doc(analyser, 6, 15))
            are_equal("Quite dark.", hover_doc(analyser, 7, 19))
            are_equal("A thing with a size.", hover_doc(analyser, 8, 12))
        si
    si
si
