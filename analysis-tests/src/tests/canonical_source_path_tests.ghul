namespace Analysis.Tests is
    use IO.File;

    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Ghul;
    use Ghul.Pipes;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // One file, one registration: a client may name the same source file
    // by different spellings across a session - a relative path on the
    // command line and an absolute one in an edit frame, which is what an
    // editor session produces - and two registrations of the same file
    // declare everything in it twice, each copy under its own synthesised
    // namespace. The driver canonicalizes the command-line paths, so both
    // spellings land on one SOURCE_FILE.
    @TestClass()
    class CANONICAL_SOURCE_PATH_TESTS is
        init() is si

        //  1 entry() is
        //  2     let x: int = 1
        //  3 si
        source() -> string =>
            "entry() is\n"
            "    let x: int = 1\n"
            "si\n";

        @Test()
        edit_under_a_second_spelling_declares_once() is
            known_source_library_gap("ghul-lang/ghul#3987")
            let project = ANALYSER_PROCESS.find_project_directory()

            let absolute = IO.Path.combine(project, "analysis-tests/fixtures/canonical_paths/fixture.ghul")

            // The same file, named with a redundant step in the middle: a
            // different spelling of the same path, which is what a
            // relative command-line argument becomes once resolved.
            let awkward = IO.Path.combine(project, "analysis-tests/fixtures/../fixtures/canonical_paths/fixture.ghul")

            let use analyser = ANALYSER_PROCESS([awkward])

            analyser.send_open_files([absolute]);

            analyser.send_edit(absolute, source());
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";

            let duplicates = LIST[string]()

            for diagnostic in compile.diagnostics do
                if diagnostic.message.contains("duplicate") then
                    duplicates.add(diagnostic.message)
                fi
            od

            is_true(
                duplicates.count == 0,
                "expected the file to be declared once, got: {duplicates |> string(",; ")}"
            );

            is_true(
                compile.checked_paths.count == 1,
                "expected one registration of the edited file, got {compile.checked_paths.count}: {compile.checked_paths |> string(",; ")}"
            );
        si
    si
si
