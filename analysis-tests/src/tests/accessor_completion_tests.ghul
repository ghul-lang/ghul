namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A source-declared property's accessors are synthesised as methods
    // named $get_x / $set_x, wrapped in a function group the symbol store
    // holds under that name. The group is what completion enumerates, so
    // it must hide when everything in it is internal - and the same must
    // hold for an imported assembly's accessors and operators, whose $
    // spellings the importer picks rather than the metadata carries.
    @TestClass()
    class ACCESSOR_COMPLETION_TESTS is
        init() is si

        load() -> string is
            let path = fixture_path("accessor-completion/accessor-completion.ghul");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        has_completion(response: Response.COMPLETION, name: string) -> bool is
            for item in response.items do
                if item.name.starts_with(name) then
                    return true;
                fi
            od

            return false;
        si

        prime() -> ANALYSER_PROCESS is
            let analyser = ANALYSER_PROCESS();

            analyser.send_edit("accessor-completion.ghul", load());

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            return analyser;
        si

        // Line 10 is "return label." inside WIDGET.go; column 24 sits on
        // the identifier itself, completing against the enclosing scopes -
        // WIDGET's own member store among them.
        @Test()
        property_accessors_are_not_offered_as_completions() is
            known_wasm_gap("ghul-lang/ghul#3660")
            let use analyser = prime();

            analyser.send_completion("accessor-completion.ghul", 10, 24);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            is_false(
                has_completion(response, "$get_"),
                "a synthesised getter should not be offered as a completion.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            is_false(
                has_completion(response, "$set_"),
                "a synthesised setter should not be offered as a completion.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            is_true(
                has_completion(response, "label"),
                "expected the property `label` among completions.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // Column 25 is just past the dot on "return label.", where member
        // completion lists string's imported members - including its
        // operators under their compiler-chosen $op_ spellings.
        @Test()
        imported_operators_are_not_offered_as_member_completions() is
            let use analyser = prime();

            analyser.send_completion("accessor-completion.ghul", 10, 25);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            is_false(
                has_completion(response, "$op_"),
                "an imported operator should not be offered under its $ spelling.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            is_true(
                has_completion(response, "length"),
                "expected string's `length` among member completions.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // Line 25 is a statement inside run(), where scope completion lists
        // locals, namespace members and root namespaces - the path that
        // surfaces a referenced assembly's globals carrier class.
        @Test()
        globals_carrier_is_not_offered_as_a_scope_completion() is
            let use analyser = prime();

            analyser.send_completion("accessor-completion.ghul", 25, 13);

            let response = analyser.read_query_response();

            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            is_false(
                has_completion(response, "$globals"),
                "a globals carrier class should not be offered as a scope completion.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            is_true(
                has_completion(response, "t"),
                "expected the local `t` among scope completions.\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si
    si
si
