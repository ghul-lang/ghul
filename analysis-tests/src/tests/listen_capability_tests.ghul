namespace Analysis.Tests is
    use Analysis.Protocol.ANALYSER_PROCESS;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Which capabilities each analyser advertises. The tests of each
    // capability skip themselves where it is not advertised, so these are
    // what notice an analyser that stops advertising one it still has, or
    // starts advertising one it cannot honour.
    @TestClass()
    class LISTEN_CAPABILITY_TESTS is
        init() is si

        // What needs a thread reading requests while the analyser is busy,
        // or assemblies to add: the .NET-built analyser has both, and the
        // wasm-built one, reading one request at a time from library
        // sources, has neither.
        _threaded_capabilities: string[] static =>
            ["mid-compile-queries", "compile-abort", "idle-exit", "add-references"]

        @Test()
        listen__advertises_what_the_analyser_can_do() is
            let use analyser = ANALYSER_PROCESS()
            let is_wasm = ANALYSER_PROCESS.wasm_compiler?

            for capability in _threaded_capabilities do
                are_equal(
                    !is_wasm,
                    analyser.supports(capability),
                    "{capability}: advertised {analyser.capabilities}")
            od

            is_true(analyser.supports("incremental-analysis"), "advertised {analyser.capabilities}")
        si
    si
si
