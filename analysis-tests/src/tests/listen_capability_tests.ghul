namespace Analysis.Tests is
    use Analysis.Protocol.ANALYSER_PROCESS;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Which capabilities each analyser advertises. The tests of each
    // capability skip themselves where it is not advertised, so these are
    // what notice an analyser that stops advertising one it still has, or
    // starts advertising one it cannot honour.
    @TestClass()
    class LISTEN_CAPABILITY_TESTS is
        init() is si

        // Every analyser reads requests while it compiles. Only one that
        // reads assemblies has assemblies to add references to.
        _shared_capabilities: string[] static =>
            ["mid-compile-queries", "compile-abort", "idle-exit"]

        @Test()
        listen__advertises_what_the_analyser_can_do() is
            let use analyser = ANALYSER_PROCESS()
            let reads_sources = ANALYSER_PROCESS.reads_library_sources

            for capability in _shared_capabilities do
                is_true(analyser.supports(capability), "{capability}: advertised {analyser.capabilities}")
            od

            are_equal(
                !reads_sources,
                analyser.supports("add-references"),
                "add-references: advertised {analyser.capabilities}")

            is_true(analyser.supports("incremental-analysis"), "advertised {analyser.capabilities}")
        si
    si
si
