namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // `cast(v)` and a bare `_` take their type from the context they
    // sit in and never write it down, so hover is the only place a
    // reader can see what that came out as. Hovering the `cast`
    // keyword, or the `_`, reports the resolved type — the same thing
    // hovering the type would have said had it been written out.
    @TestClass()
    class INFERRED_TYPE_HOVER_TESTS is
        init() is si

        load_fixture() -> string is
            let path = fixture_path("inferred-type-hover/inferred-type-hover.ghul");

            assert File.exists(path) else "fixture missing: {path}";

            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, source: string) is
            analyser.send_edit("inferred-type-hover.ghul", source);

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            let user_diagnostics = LIST(user_diagnostics_of(diagnostics));
            are_equal(
                0,
                user_diagnostics.count,
                diagnostics_summary("EDIT had unexpected diagnostics", user_diagnostics)
            );
        si

        hover_description(analyser: ANALYSER_PROCESS, line: int, column: int) -> string is
            analyser.send_hover("inferred-type-hover.ghul", line, column);

            let response = analyser.read_query_response();
            assert isa Response.HOVER(response) else "expected HOVER response";

            if !response.signature? then
                return "";
            fi

            return response.signature;
        si

        assert_hover_contains(
            actual: string,
            expected_substring: string,
            where: string,
            analyser: ANALYSER_PROCESS
        ) is
            is_true(
                actual? /\ actual.contains(expected_substring),
                "{where}: expected HOVER to contain '{expected_substring}', got '{actual}'.\n--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // `let from_let: double = cast(count);` — the target comes from
        // the declared type.
        @Test()
        hover_on_cast_keyword__shows_the_type_from_the_declaration() is
            known_wasm_gap("ghul-lang/ghul#3659")
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_fixture());

            assert_hover_contains(
                hover_description(analyser, 8, 32),
                "double",
                "cast keyword in a typed let initializer",
                analyser
            );
        si

        // `cast(count) + average` — the target comes from the formal of
        // the operator resolution settled on, which is the case that
        // could not be answered until the callee was known.
        @Test()
        hover_on_cast_keyword__shows_the_type_from_the_resolved_operator() is
            known_wasm_gap("ghul-lang/ghul#3659")
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_fixture());

            assert_hover_contains(
                hover_description(analyser, 9, 29),
                "double",
                "cast keyword as an operator operand",
                analyser
            );
        si

        // Hovering the value being converted still describes the value,
        // not the type it is being converted to — the keyword's own
        // span is narrower than the whole expression's.
        @Test()
        hover_on_the_converted_value__still_shows_the_value() is
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_fixture());

            assert_hover_contains(
                hover_description(analyser, 8, 37),
                "count",
                "the value inside an untyped cast",
                analyser
            );
        si

        // A bare `_` reports the type its context supplied.
        @Test()
        hover_on_bare_default__shows_the_type_from_the_declaration() is
            known_wasm_gap("ghul-lang/ghul#3659")
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, load_fixture());

            assert_hover_contains(
                hover_description(analyser, 14, 26),
                "bool",
                "bare default-value expression",
                analyser
            );
        si
    si
si
