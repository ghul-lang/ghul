namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // The attributes in `Ghul.Internal` state what the compiler
    // established about a type, so source cannot name one. Completion
    // offers neither those attributes nor the namespace holding them.
    @TestClass()
    class HIDDEN_INTERNAL_COMPLETION_TESTS is
        init() is si

        load(name: string) -> string is
            let path = fixture_path("hidden-internal-completion/{name}");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return File.read_all_text(path);
        si

        prime(analyser: ANALYSER_PROCESS, name: string) is
            analyser.send_edit(name, load(name));

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";
        si

        has_completion(response: Response.COMPLETION, name: string) -> bool is
            for item in response.items do
                if item.name =~ name then
                    return true;
                fi
            od

            return false;
        si

        summarize(response: Response.COMPLETION) -> string is
            let names = Collections.LIST[string]();

            for item in response.items do
                names.add(item.name);
            od

            return string.join("\n  ", names);
        si

        // Cursor sits right after `let x: Ghul.` on line 7 of
        // internal-positions.ghul.
        @Test()
        completion_under_Ghul_omits_the_internal_namespace() is
            known_wasm_gap("ghul-lang/ghul#3661")
            let use analyser = ANALYSER_PROCESS();
            prime(analyser, "internal-positions.ghul");

            // `.` at col 20, cursor at col 21.
            analyser.send_completion("internal-positions.ghul", 7, 21);
            let response = analyser.read_query_response();
            assert isa Response.COMPLETION(response) else "expected COMPLETION";

            let summary = summarize(response);

            // A sibling namespace, so a run that offered nothing at all
            // would fail here rather than passing the assertion below.
            is_true(
                has_completion(response, "Pipes"),
                "expected sibling namespace `Pipes` among completions under "
                "`Ghul.`.\nall returned items:\n  {summary}"
            );

            is_false(
                has_completion(response, "Internal"),
                "completion under `Ghul.` should not offer the `Internal` "
                "namespace.\nall returned items:\n  {summary}"
            );
        si
    si
si
