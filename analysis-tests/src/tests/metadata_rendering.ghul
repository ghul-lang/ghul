namespace Analysis.Tests is
    use System.Convert
    use System.Text.StringBuilder

    use System.Reflection.Metadata.BlobHandle
    use System.Reflection.Metadata.EntityHandle
    use System.Reflection.Metadata.MetadataReader
    use System.Reflection.Metadata.StringHandle
    use System.Reflection.Metadata.Ecma335.MetadataReaderExtensions
    use System.Reflection.Metadata.Ecma335.MetadataTokens
    use System.Reflection.Metadata.Ecma335.TableIndex
    use System.Reflection.PortableExecutable.PEReader

    // An assembly's metadata written out by name rather than by heap
    // offset, so two assemblies that declare the same things compare equal
    // even when their string heaps are laid out differently.
    //
    // Assembly references can be left out: a compile server records a
    // reference when a reflected symbol is created, and keeps symbols
    // between compiles, so a later cell it builds carries every earlier
    // cell's references as well as its own. That changes the reference
    // rows, the string heap offsets behind them, and the module id, which
    // is a hash of the content; with references left out none of those is
    // rendered, and everything else must match exactly.
    class METADATA_RENDERING is
        render(bytes: ARRAY[ubyte], include_assembly_references: bool) -> string static is
            let use pe = PEReader(System.Collections.Immutable.ImmutableArray.create[ubyte](bytes))

            let reader = System.Reflection.Metadata.PEReaderExtensions.get_metadata_reader(pe)

            let result = StringBuilder()

            for table in System.Enum.get_values[TableIndex]() do
                if include_assembly_references \/ table != TableIndex.ASSEMBLY_REF then
                    result.append_line("rows {table} {MetadataReaderExtensions.get_table_row_count(reader, table)}")
                fi
            od

            result.append_line("module {reader.get_string(reader.get_module_definition().name)}")

            let assembly = reader.get_assembly_definition()

            result.append_line("assembly {reader.get_string(assembly.name)} {assembly.version}")

            if include_assembly_references then
                for h in reader.assembly_references do
                    let r = reader.get_assembly_reference(h)

                    result.append_line("assembly-ref {reader.get_string(r.name)} {r.version}")
                od
            fi

            for h in reader.type_references do
                let r = reader.get_type_reference(h)

                result.append_line("type-ref {_scope(reader, r.resolution_scope)} {reader.get_string(r.namespace)}.{reader.get_string(r.name)}")
            od

            for h in reader.type_definitions do
                let t = reader.get_type_definition(h)

                result.append_line("type {reader.get_string(t.namespace)}.{reader.get_string(t.name)} {t.attributes} extends {_token(t.base_type)}")

                for f in t.get_fields() do
                    let definition = reader.get_field_definition(f)

                    result.append_line("  field {reader.get_string(definition.name)} {definition.attributes} {_blob(reader, definition.signature)}")
                od

                for m in t.get_methods() do
                    let method = reader.get_method_definition(m)

                    result.append_line("  method {reader.get_string(method.name)} {method.attributes} {method.impl_attributes} {_blob(reader, method.signature)}")

                    for p in method.get_parameters() do
                        let parameter = reader.get_parameter(p)

                        result.append_line("    parameter {parameter.sequence_number} {reader.get_string(parameter.name)} {parameter.attributes}")
                    od

                    if method.relative_virtual_address != 0 then
                        let body = System.Reflection.Metadata.PEReaderExtensions.get_method_body(pe, method.relative_virtual_address)

                        result.append_line("    body {body.max_stack} {_token(cast EntityHandle(body.local_signature))} {Convert.to_base64_string(body.get_i_l_bytes() ?? System.Array.empty[ubyte]())}")
                    fi
                od

                for i in t.get_interface_implementations() do
                    result.append_line("  implements {_token(reader.get_interface_implementation(i).`interface)}")
                od

                for p in t.get_properties() do
                    let property = reader.get_property_definition(p)

                    result.append_line("  property {reader.get_string(property.name)} {_blob(reader, property.signature)}")
                od
            od

            for h in reader.member_references do
                let r = reader.get_member_reference(h)

                result.append_line("member-ref {_token(r.parent)} {reader.get_string(r.name)} {_blob(reader, r.signature)}")
            od

            for h in reader.custom_attributes do
                let a = reader.get_custom_attribute(h)

                result.append_line("attribute {_token(a.parent)} {_token(a.constructor)} {_blob(reader, a.value)}")
            od

            for i in 1::MetadataReaderExtensions.get_table_row_count(reader, TableIndex.TYPE_SPEC) do
                let spec = reader.get_type_specification(MetadataTokens.type_specification_handle(i))

                result.append_line("type-spec {i} {_blob(reader, spec.signature)}")
            od

            for i in 1::MetadataReaderExtensions.get_table_row_count(reader, TableIndex.METHOD_SPEC) do
                let spec = reader.get_method_specification(MetadataTokens.method_specification_handle(i))

                result.append_line("method-spec {i} {_token(spec.method)} {_blob(reader, spec.signature)}")
            od

            for i in 1::MetadataReaderExtensions.get_table_row_count(reader, TableIndex.STAND_ALONE_SIG) do
                let signature = reader.get_standalone_signature(MetadataTokens.standalone_signature_handle(i))

                result.append_line("signature {i} {_blob(reader, signature.signature)}")
            od

            return result.to_string()
        si

        // A reference's scope by name, since the assembly reference rows it
        // points into may be numbered differently.
        _scope(reader: MetadataReader, scope: EntityHandle) -> string static is
            if scope.kind == System.Reflection.Metadata.HandleKind.ASSEMBLY_REFERENCE then
                let reference = reader.get_assembly_reference(cast System.Reflection.Metadata.AssemblyReferenceHandle(scope))

                return "[{reader.get_string(reference.name)}]"
            fi

            return _token(scope)
        si

        _token(handle: EntityHandle) -> string static =>
            if handle.is_nil then "nil" else "{MetadataTokens.get_token(handle):x8}" fi

        _blob(reader: MetadataReader, handle: BlobHandle) -> string static =>
            if handle.is_nil then "nil" else Convert.to_base64_string(reader.get_blob_bytes(handle)) fi

        // The assembly names an assembly's metadata references.
        assembly_reference_names(bytes: ARRAY[ubyte]) -> Collections.SET[string] static is
            let use pe = PEReader(System.Collections.Immutable.ImmutableArray.create[ubyte](bytes))

            let reader = System.Reflection.Metadata.PEReaderExtensions.get_metadata_reader(pe)

            let result = Collections.SET[string]()

            for h in reader.assembly_references do
                result.add(reader.get_string(reader.get_assembly_reference(h).name))
            od

            return result
        si
    si
si
