namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.DIAGNOSTIC;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // An analyser whose environment declares none of the built-in types
    // cannot analyse anything. Each file it is sent says so, once, as an
    // error an editor shows, rather than coming back clean - and the
    // analyser keeps answering rather than restarting into the same
    // failure.
    @TestClass()
    class MISSING_BUILT_IN_TESTS is
        init() is si

        // A core library that declares the namespace the built-in types
        // live in, and none of them.
        core_source() -> string =>
            "namespace Ghul.Intrinsics is\n"
            "    class PLACEHOLDER is\n"
            "        init() is si\n"
            "    si\n"
            "si\n";

        source() -> string =>
            "entry() is\n"
            "    let x: int = \"not an int\"\n"
            "si\n";

        @Test()
        A_missing_built_in_type_is_reported_once_as_an_error() is
            let use analyser = ANALYSER_PROCESS(["--target", "wasm"]);

            analyser.send_edit_files([EDIT_FILE("core.ghul", core_source()), EDIT_FILE("main.ghul", source())]);

            let response = analyser.read_response();

            assert isa Response.DIAGNOSTICS(response)
                else "expected DIAGNOSTICS response after EDIT";


            let missing = LIST[DIAGNOSTIC]();

            for d in response.diagnostics do
                if let code = d.code /\ code =~ "missing-built-in" /\ d.path.ends_with("main.ghul") then
                    missing.add(d);
                fi
            od

            assert missing.count == 1
                else "expected one missing-built-in error, got: {describe(response.diagnostics)}\nanalyser stderr:\n{analyser.stderr_capture}";

            are_equal(1, missing[0].severity);
            are_equal(1, missing[0].start_line);
            are_equal(1, missing[0].start_column);
        si

        describe(diagnostics: Collections.Iterable[DIAGNOSTIC]) -> string is
            let text = System.Text.StringBuilder();

            for d in diagnostics do
                text.append("\n  {d.severity} {d.start_line}:{d.start_column} {d.code} {d.message}");
            od

            return text.to_string();
        si

        missing_of(response: Response) -> LIST[DIAGNOSTIC] is
            let missing = LIST[DIAGNOSTIC]();

            if let frame: Response.DIAGNOSTICS = response then
                for d in frame.diagnostics do
                    if let code = d.code /\ code =~ "missing-built-in" /\ d.path.ends_with("main.ghul") then
                        missing.add(d);
                    fi
                od
            fi

            return missing;
        si

        @Test()
        A_COMPILE_after_the_edit_reports_it_too() is
            let use analyser = ANALYSER_PROCESS(["--target", "wasm"]);

            analyser.send_edit_files([EDIT_FILE("core.ghul", core_source()), EDIT_FILE("main.ghul", source())]);

            let _ = analyser.read_response();

            analyser.send_compile();

            let response = analyser.read_response();

            assert isa Response.DIAGNOSTICS(response)
                else "expected DIAGNOSTICS response after COMPILE";

            assert missing_of(response).count == 1
                else "expected one missing-built-in error, got: {describe(response.diagnostics)}\nanalyser stderr:\n{analyser.stderr_capture}";
        si
    si
si
