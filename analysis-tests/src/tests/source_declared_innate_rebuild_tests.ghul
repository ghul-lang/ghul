namespace Analysis.Tests is
    use Collections.LIST;

    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;

    use Ghul.Pipes;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // The compiler resolves its magic types - the array, pointer and
    // reference shapes - by name out of `Ghul`, falling back to
    // `Ghul.Internal`. Almost every project reaches the reflected copies in
    // the runtime assembly, which are cached for the life of the analyser.
    // The runtime itself has no such assembly to reach: it declares them,
    // so they resolve to its own source symbols, which a rebuild discards
    // and re-declares.
    //
    // Reflected member signatures are cached whenever they first
    // materialize and are never rebuilt, so they keep whichever innate
    // types were current then. Let the innates change underneath and the
    // two disagree while rendering identically - a reflected call returning
    // an array stops matching the declared array return type, and a
    // reflected `out` parameter stops matching an argument passed by `ref`.
    //
    // The analyser spawns without the runtime assembly, so what the innate
    // lookup finds is the project's own declarations - the situation the
    // runtime compiles itself in.
    @TestClass()
    class SOURCE_DECLARED_INNATE_REBUILD_TESTS is
        init() is si

        load(name: string) -> EDIT_FILE is
            let path = fixture_path("source-declared-innates/{name}");
            assert File.exists(path) else "fixture not copied to test output: {path}";
            return EDIT_FILE(path, File.read_all_text(path));
        si

        // `--no-incremental-analysis` so the edit below is served by a
        // rebuild rather than by one of the incremental paths, which retain
        // the symbols a rebuild replaces and so never reach the mismatch.
        // Which path an edit takes is a decision the analyser makes per
        // edit; the rebuild is the one under test.
        analyser() -> ANALYSER_PROCESS =>
            ANALYSER_PROCESS(
                LIST[string](["--no-incremental-analysis"]),
                LIST[string](["ghul-runtime.dll"])
            );

        read_diagnostics(a: ANALYSER_PROCESS, label: string) -> Response.DIAGNOSTICS is
            let response = a.read_response();

            if let diagnostics: Response.DIAGNOSTICS = response then
                return diagnostics;
            fi

            throw System.Exception("expected a DIAGNOSTICS response {label}, got '{response.get_type().name}'");
        si

        // The consumer file is edited rather than the one declaring the
        // innates: what matters is that a rebuild happened at all, not
        // where, and not what the edit was.
        @Test()
        a_second_compile_should_not_invent_type_mismatches() is
            requires_assembly_fixtures()
            let innates = load("innates.ghul");
            let consumer = load("consumer.ghul");

            let use a = analyser();

            a.send_edit_files([innates, consumer]);

            let primed = read_diagnostics(a, "for the first compile");

            are_equal(
                0,
                user_diagnostics_of(primed) |> count(),
                diagnostics_summary("first compile of a project declaring its own innates", user_diagnostics_of(primed))
            );

            a.send_edit_files([EDIT_FILE(consumer.path, "{consumer.source}\n")]);

            let rebuilt = read_diagnostics(a, "for the compile after an edit");

            are_equal(
                0,
                user_diagnostics_of(rebuilt) |> count(),
                diagnostics_summary("compile after an edit re-declared the innates", user_diagnostics_of(rebuilt))
            );
        si
    si
si
