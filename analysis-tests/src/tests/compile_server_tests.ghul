namespace Analysis.Tests is
    use System.Diagnostics.Process
    use System.Diagnostics.ProcessStartInfo

    use Collections.Iterable
    use Collections.LIST

    use IO.Directory
    use IO.File
    use IO.Path

    use Analysis.Protocol.ANALYSER_PROCESS
    use Analysis.Protocol.COMPILE_REPLY
    use Analysis.Protocol.COMPILE_REQUEST
    use Analysis.Protocol.COMPILE_SERVER_PROCESS

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A compile server must build exactly what a batch compile of the same
    // cell builds: emission is deterministic, so the two are compared, and
    // a server that let anything from one compile leak into the next would
    // show up as a difference. It must also carry on after any request it
    // cannot carry out.
    @TestClass()
    class COMPILE_SERVER_TESTS is
        _directory: string

        init() is
            _directory = Path.combine(Path.get_temp_path(), "ghul-compile-server-{System.Guid.new_guid()}")

            Directory.create_directory(_directory)
        si

        path(name: string) -> string => Path.combine(_directory, name)

        // `<name>.dll` in a directory of its own.
        output_path(kind: string, name: string) -> string is
            let directory = Path.combine(_directory, kind, System.Guid.new_guid().to_string())

            Directory.create_directory(directory)

            return Path.combine(directory, "{name}.dll")
        si

        write(name: string, text: string) -> string is
            let result = path(name)

            File.write_all_text(result, text)

            return result
        si

        start_server() -> COMPILE_SERVER_PROCESS =>
            COMPILE_SERVER_PROCESS(ANALYSER_PROCESS.resolve_compiler_dll(), LIST[string]())

        served(server: COMPILE_SERVER_PROCESS, name: string, source: string, output: string, references: Iterable[string]) -> COMPILE_REPLY =>
            server.compile(COMPILE_REQUEST(name, source, null, output, references))

        // The same cell compiled by a separate batch run of the compiler.
        batch(name: string, source: string, output: string, references: Iterable[string]) -> int is
            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.argument_list.add(ANALYSER_PROCESS.resolve_compiler_dll())
            start_info.argument_list.add("--submission")
            start_info.argument_list.add(name)
            start_info.argument_list.add("--library")

            for reference in references do
                start_info.argument_list.add("--reference")
                start_info.argument_list.add(reference)
            od

            start_info.argument_list.add("-o")
            start_info.argument_list.add(output)
            start_info.argument_list.add(source)

            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            let use process = Process.start(start_info)!

            process.standard_output.read_to_end()
            process.standard_error.read_to_end()
            process.wait_for_exit()

            return process.exit_code
        si

        // A cell the server built must be the same file, byte for byte, as
        // the same cell built on its own: nothing an earlier cell brought into
        // the server may reach a later cell's output.
        assert_equivalent(batch_output: string, served_output: string) is
            let from_batch = File.read_all_bytes(batch_output)
            let from_server = File.read_all_bytes(served_output)

            let identical mut = from_batch.count == from_server.count

            let at mut = 0

            while identical /\ at < from_batch.count do
                identical = from_batch[at] == from_server[at]
                at = at + 1
            od

            // A mismatch leaves both assemblies' metadata rendered beside them
            // to compare.
            if !identical then
                File.write_all_text("{batch_output}.txt", METADATA_RENDERING.render(from_batch, false))
                File.write_all_text("{served_output}.txt", METADATA_RENDERING.render(from_server, false))
            fi

            is_true(identical, "{served_output} differs from {batch_output}: compare {batch_output}.txt with {served_output}.txt")
        si

        // Compiles one cell through the server and again as a batch run,
        // expects both to succeed, and compares them.
        compile_both(server: COMPILE_SERVER_PROCESS, name: string, source: string, references: LIST[string]) -> string is
            // The assembly is named after its file, so the two outputs share a
            // file name and are kept apart by directory.
            let served_output = output_path("served", name)
            let batch_output = output_path("batch", name)

            let reply = served(server, name, source, served_output, references)

            are_equal(0, reply.status, "{name}: {reply.message} {reply.diagnostics}")

            are_equal(0, batch(name, source, batch_output, references), "batch compile of {name} failed")

            assert_equivalent(batch_output, served_output)

            return served_output
        si

        @Test()
        three_chained_cells_with_redefinition__match_batch_compiles() is
            let use server = start_server()

            let one = compile_both(
                server,
                "cell1",
                write("cell1.ghul", "use IO.Std.write_line\nlet x = 41\ninc(n: int) -> int => n + 1\nwrite_line(\"one {{x}}\")\n"),
                LIST[string]())

            let two = compile_both(
                server,
                "cell2",
                write("cell2.ghul", "use IO.Std.write_line\nlet x = \"now a string\"\ninc(n: int) -> int => n + 100\nwrite_line(\"{{x}} {{inc(1)}}\")\n"),
                LIST[string]([one]))

            compile_both(
                server,
                "cell3",
                write("cell3.ghul", "use IO.Std.write_line\nuse cell2.x\nuse cell2.inc\nwrite_line(\"{{x}} {{inc(1)}}\")\n"),
                LIST[string]([one, two]))
        si

        // A type in one cell whose base is in an earlier one is imported
        // through both: the reference from the later assembly to the earlier
        // resolves to the assembly the server already loaded.
        @Test()
        a_subclass_of_a_class_from_an_earlier_cell__can_be_used_in_a_later_one() is
            let use server = start_server()

            let one = compile_both(
                server,
                "cell1",
                write("cell1.ghul", "class Shape is\n    init() is si\n    name() -> string => \"shape\"\nsi\n"),
                LIST[string]())

            let two = compile_both(
                server,
                "cell2",
                write("cell2.ghul", "use cell1.Shape\nclass CIRCLE: Shape is\n    init() is super.init() si\n    name() -> string => \"circle\"\nsi\n"),
                LIST[string]([one]))

            compile_both(
                server,
                "cell3",
                write("cell3.ghul", "use cell1.Shape\nuse cell2.CIRCLE\nlet shape: Shape = CIRCLE()\nshape.name()\n"),
                LIST[string]([one, two]))
        si

        @Test()
        a_check_request__answers_complete_incomplete_or_invalid() is
            let use server = start_server()

            are_equal("incomplete", server.check("if true then\n    let x = 1\n").completeness)
            are_equal("complete", server.check("if true then\n    let x = 1\nfi\n").completeness)
            are_equal("invalid", server.check("let = 3\n").completeness)
        si

        // A complete check also says what the source ends on, so a front
        // end can tell a value to show from a statement setting something
        // up for the next line.
        @Test()
        a_check_request__says_what_complete_source_ends_on() is
            let use server = start_server()

            are_equal("expression", server.check("let x = 1\nx * 2\n").last_statement)
            are_equal("let", server.check("let x = 123\n").last_statement)
            are_equal("definition", server.check("f(n: int) -> int => n\n").last_statement)
            is_null(server.check("if true then\n").last_statement)
        si

        // A check parses with state of its own, so a compile after it is
        // built exactly as it would have been without it.
        @Test()
        a_check_between_compiles__leaves_the_next_compile_unchanged() is
            let use server = start_server()

            let one = compile_both(server, "cell1", write("cell1.ghul", "let x = 41\n"), LIST[string]())

            are_equal("incomplete", server.check("use cell1.x\nif x > 1 then\n").completeness)
            are_equal("invalid", server.check("let = 3\n").completeness)

            compile_both(server, "cell2", write("cell2.ghul", "use cell1.x\nlet y = x + 1\n"), LIST[string]([one]))
        si

        // A cell is known by the name in its metadata, so a reference to a
        // copy under another file name still reaches it.
        @Test()
        a_cell_referenced_under_another_file_name__is_found_by_its_own_name() is
            let use server = start_server()

            let one = compile_both(server, "cell1", write("cell1.ghul", "let base = 7\n"), LIST[string]())

            let renamed = path("renamed-copy.dll")

            File.copy(one, renamed)

            let two = served(server, "cell2", write("cell2.ghul", "use cell1.base\nlet x = base + 1\n"), output_path("served", "cell2"), LIST[string]([renamed]))

            are_equal(0, two.status, "{two.message} {two.diagnostics}")
        si

        @Test()
        a_failing_cell__does_not_affect_the_next() is
            let use server = start_server()

            let one = compile_both(server, "cell1", write("cell1.ghul", "let x = 41\n"), LIST[string]())

            let failed_output = output_path("served", "cell2")

            let failed = served(server, "cell2", write("cell2.ghul", "let y = missing\n"), failed_output, LIST[string]([one]))

            are_equal(1, failed.status)
            is_true(failed.diagnostics.count > 0)
            is_false(File.exists(failed_output))

            let three = served(server, "cell3", write("cell3.ghul", "use cell1.x\nlet z = x + 1\n"), output_path("served", "cell3"), LIST[string]([one]))

            are_equal(0, three.status, "{three.message} {three.diagnostics}")
            are_equal(0, three.diagnostics.count, "{three.diagnostics}")

            compile_both(server, "cell4", write("cell4.ghul", "use cell1.x\nlet w = x * 2\n"), LIST[string]([one]))
        si

        @Test()
        a_cell_compiled_before_the_server_started__can_be_referenced() is
            let earlier = output_path("batch", "cell0")

            are_equal(0, batch("cell0", write("cell0.ghul", "let base = 100\n"), earlier, LIST[string]()))

            let use server = start_server()

            compile_both(server, "cell1", write("cell1.ghul", "use cell0.base\nlet x = base + 1\n"), LIST[string]([earlier]))
        si

        // An assembly the server was started with, named again in a request,
        // is the one already loaded and is used as it is.
        @Test()
        a_startup_reference_named_again__is_used() is
            let earlier = output_path("batch", "cell0")

            are_equal(0, batch("cell0", write("cell0.ghul", "let base = 100\n"), earlier, LIST[string]()))

            let use server = COMPILE_SERVER_PROCESS(ANALYSER_PROCESS.resolve_compiler_dll(), LIST[string](["--reference", earlier]))

            compile_both(server, "cell1", write("cell1.ghul", "use cell0.base\nlet x = base + 1\n"), LIST[string]([earlier]))
        si

        @Test()
        the_same_cell_name_twice__builds_the_second_source() is
            let use server = start_server()

            compile_both(server, "cell1", write("first.ghul", "let x = 1\n"), LIST[string]())
            compile_both(server, "cell1", write("second.ghul", "let x = \"two\"\nlet y = x\n"), LIST[string]())
        si

        // The reference set cannot hold two assemblies of one name, so a
        // rebuilt cell passed as a reference is refused rather than
        // compiled against the first build, which is still loaded.
        @Test()
        a_rebuilt_cell_as_a_reference__is_refused() is
            let use server = start_server()

            let first = compile_both(server, "cell1", write("first.ghul", "let x = 1\n"), LIST[string]())
            let rebuilt = compile_both(server, "cell1", write("rebuilt.ghul", "let x = \"two\"\n"), LIST[string]())

            let with_first = served(server, "cell2", write("uses-first.ghul", "use cell1.x\nlet y = x + 1\n"), output_path("served", "cell2"), LIST[string]([first]))

            are_equal(0, with_first.status, "{with_first.message} {with_first.diagnostics}")

            let with_rebuilt = served(server, "cell3", write("uses-rebuilt.ghul", "use cell1.x\nlet y = x\n"), output_path("served", "cell3"), LIST[string]([rebuilt]))

            are_equal(2, with_rebuilt.status)
            is_true((with_rebuilt.message ?? "").contains("cell1"), "{with_rebuilt.message}")

            let again = served(server, "cell4", write("uses-first-again.ghul", "use cell1.x\nlet z = x * 2\n"), output_path("served", "cell4"), LIST[string]([first]))

            are_equal(0, again.status, "{again.message} {again.diagnostics}")
        si

        @Test()
        source_as_text__is_named_after_the_cell() is
            let use server = start_server()

            let reply = server.compile(COMPILE_REQUEST("cell1", null, "let y = missing\n", output_path("served", "cell1"), LIST[string]()))

            are_equal(1, reply.status)
            are_equal("cell1.ghul", reply.diagnostics[0].path)
        si

        // A cell handed in through a file named something else is still
        // referred to by the name its own metadata gives it, which is what
        // the runtime will look for.
        @Test()
        a_cell_referenced_through_a_renamed_file__is_referred_to_by_its_own_name() is
            let use server = start_server()

            let one = compile_both(server, "cell1", write("cell1.ghul", "let x = 41\n"), LIST[string]())

            let renamed = path("renamed-copy.dll")

            File.copy(one, renamed)

            let output = output_path("served", "cell2")

            let reply = served(server, "cell2", write("cell2.ghul", "use cell1.x\nlet y = x + 1\n"), output, LIST[string]([renamed]))

            are_equal(0, reply.status, "{reply.message} {reply.diagnostics}")

            let references = METADATA_RENDERING.assembly_reference_names(File.read_all_bytes(output))

            is_true(references.contains("cell1"), "cell2 does not refer to cell1")
            is_false(references.contains("renamed-copy"), "cell2 refers to the file cell1 was found in")
        si

        // Every one of these gets a reply saying the request could not be
        // carried out, and the server goes on to compile the next.
        @Test()
        a_request_that_cannot_be_carried_out__gets_status_2_and_the_server_carries_on() is
            let use server = start_server()

            let good = write("good.ghul", "let x = 1\n")
            let not_an_assembly = write("not-an-assembly.dll", "this is not an assembly")

            let replies = LIST[COMPILE_REPLY]([
                server.send_raw("not json"),
                server.send_raw("{{}}"),
                served(server, "cell1", path("missing.ghul"), output_path("served", "cell1"), LIST[string]()),
                served(server, "cell1", good, output_path("served", "cell1"), LIST[string]([path("missing.dll")])),
                served(server, "cell1", good, output_path("served", "cell1"), LIST[string]([not_an_assembly]))
            ])

            for reply in replies do
                are_equal(2, reply.status, "{reply.message}")
                is_true(reply.message?, "a failed request says why")
            od

            let after = served(server, "cell2", good, output_path("served", "cell2"), LIST[string]())

            are_equal(0, after.status, "{after.message} {after.diagnostics}")
        si
    si
si
