namespace Analysis.Tests is
    use IO.File;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.Response;

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // After a dot, completion offers what a program can write there: not an
    // indexer's accessors, a constructor or an imported protected member,
    // except that `self` and `super` reach constructors and protected
    // members.
    @TestClass()
    class MEMBER_COMPLETION_FILTER_TESTS is
        init() is si

        _names(file: string, line: int, column: int) -> Collections.LIST[string] is
            let path = fixture_path("member-completion-filter/{file}");
            assert File.exists(path) else "fixture not copied to test output: {path}";

            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit(file, File.read_all_text(path));

            let diagnostics = analyser.read_response();
            assert isa Response.DIAGNOSTICS(diagnostics) else "expected DIAGNOSTICS response";

            analyser.send_completion(file, line, column);

            let response = analyser.read_query_response();
            assert isa Response.COMPLETION(response) else "expected COMPLETION response";

            let names = Collections.LIST[string]();

            for item in response.items do
                names.add(item.name);
            od

            return names;
        si

        @Test()
        an_imported_type_offers_its_members_but_not_its_accessors_constructors_or_protected_members() is
            requires_assembly_fixtures()
            let names = _names("imported.ghul", 6, 15);
            let summary = string.join(", ", names);

            is_true(names.contains("add"), "expected add; got: {summary}");
            is_true(names.contains("count"), "expected count; got: {summary}");
            is_false(names.contains("get_Item"), "the indexer's getter was offered; got: {summary}");
            is_false(names.contains("set_Item"), "the indexer's setter was offered; got: {summary}");
            is_false(names.contains("init"), "a constructor was offered; got: {summary}");
            is_false(names.contains("finalize"), "a protected member was offered; got: {summary}");
            is_false(names.contains("memberwise_clone"), "a protected member was offered; got: {summary}");
        si

        @Test()
        a_source_type_offers_its_methods_but_not_its_constructor() is
            let names = _names("source.ghul", 9, 11);
            let summary = string.join(", ", names);

            is_true(names.contains("greet"), "expected greet; got: {summary}");
            is_false(names.contains("init"), "a constructor was offered; got: {summary}");
        si

        @Test()
        super_offers_the_constructor_it_chains_to() is
            let names = _names("super.ghul", 9, 19);
            let summary = string.join(", ", names);

            is_true(names.contains("init"), "expected init after super; got: {summary}");
            is_true(names.contains("greet"), "expected greet after super; got: {summary}");
        si
    si
si
