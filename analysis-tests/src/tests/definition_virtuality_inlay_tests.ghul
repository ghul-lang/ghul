namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.INLAY_HINT;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // Editor-only inlays announcing what the compiler knows about a
    // declaration's place in the dispatch hierarchy. One fixture carries
    // every shape the pass distinguishes so the analyser walks them in a
    // single COMPILE; each assertion looks the hint up by the line it
    // sits on.
    //
    // The glyphs are ◆ abstract, ▲ overrides, ▼ overridden, ○ overridable
    // beyond the assembly. A declaration earning none of them gets no
    // hint at all, which several of these assertions check for.
    @TestClass()
    class DEFINITION_VIRTUALITY_INLAY_TESTS is
        init() is si

        //  1 namespace Virtuality is
        //  2     trait Speaker is
        //  3         speak() -> string;
        //  4         describe() -> string => "a speaker";
        //  5     si
        //  6     class ANIMAL: Speaker is
        //  7         init() is si
        //  8         speak() -> string => "...";
        //  9         legs() -> int => 4;
        // 10     si
        // 11     class CAT: ANIMAL is
        // 12         init() is super.init(); si
        // 13         speak() -> string => "meow";
        // 14     si
        // 15     class SHAPE open is
        // 16         init() is si
        // 17         area() -> int => 0;
        // 18     si
        // 19     class COUNTED: Counter is
        // 20         init() is count = 0; si
        // 21         count: int public;
        // 22     si
        // 23     trait Counter is
        // 24         count: int, = v;
        // 25     si
        // 26 si
        source() -> string =>
            "namespace Virtuality is\n"
            "    trait Speaker is\n"
            "        speak() -> string;\n"
            "        describe() -> string => \"a speaker\";\n"
            "    si\n"
            "    class ANIMAL: Speaker is\n"
            "        init() is si\n"
            "        speak() -> string => \"...\";\n"
            "        legs() -> int => 4;\n"
            "    si\n"
            "    class CAT: ANIMAL is\n"
            "        init() is super.init(); si\n"
            "        speak() -> string => \"meow\";\n"
            "    si\n"
            "    class SHAPE open is\n"
            "        init() is si\n"
            "        area() -> int => 0;\n"
            "    si\n"
            "    class COUNTED: Counter is\n"
            "        init() is count = 0; si\n"
            "        count: int public;\n"
            "    si\n"
            "    trait Counter is\n"
            "        count: int, = v;\n"
            "    si\n"
            "si\n";

        // Drive EDIT, COMPILE, INLAY_HINTS. `open_paths` is declared
        // before the edit, per the open-files contract.
        compile_inlays(path: string, text: string) -> LIST[INLAY_HINT] is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_open_files([path]);

            analyser.send_edit(path, text);
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";

            analyser.send_inlay_hints(path);
            let inlays = analyser.read_response();
            assert isa Response.INLAY_HINTS(inlays) else "expected INLAY_HINTS response";

            return LIST[INLAY_HINT](inlays.hints);
        si

        virtuality_on(hints: Collections.Iterable[INLAY_HINT], line: int) -> INLAY_HINT? is
            for h in hints do
                if h.line == line /\ h.code? /\ h.code.starts_with("definition-virtuality") then
                    return h;
                fi
            od

            return null;
        si

        label_on(hints: Collections.Iterable[INLAY_HINT], line: int) -> string? is
            let hint = virtuality_on(hints, line);

            return if hint? then hint.label else null fi;
        si

        detail_on(hints: Collections.Iterable[INLAY_HINT], line: int) -> string? is
            let hint = virtuality_on(hints, line);

            return if hint? then hint.detail else null fi;
        si

        // A body-less trait member is abstract, and every implementation
        // of it is an overrider, so it earns both glyphs.
        @Test()
        abstract_trait_member_is_marked_abstract_and_overridden() is
            let inlays = compile_inlays("virtuality.ghul", source());

            are_equal("◆▼", label_on(inlays, 3), "trait Speaker.speak");

            let detail = detail_on(inlays, 3);

            is_true(
                detail? /\ detail.contains("◆ abstract"),
                "expected an abstract note, got: {detail}"
            );

            is_true(
                detail? /\ detail.contains("ANIMAL.speak"),
                "expected the implementation named, got: {detail}"
            );
        si

        // A method that both implements a trait member and is overridden
        // by a subclass carries the two direction glyphs and nothing else.
        @Test()
        method_that_overrides_and_is_overridden_carries_both_directions() is
            let inlays = compile_inlays("virtuality.ghul", source());

            are_equal("▲▼", label_on(inlays, 8), "ANIMAL.speak");

            let detail = detail_on(inlays, 8);

            is_true(
                detail? /\ detail.contains("▲ overrides Speaker.speak() -> string"),
                "expected the overridden member named, got: {detail}"
            );

            is_true(
                detail? /\ detail.contains("▼ overridden by CAT.speak() -> string"),
                "expected the overrider named, got: {detail}"
            );
        si

        // The most derived override overrides but is not itself
        // overridden, and its class is closed, so it earns `▲` alone.
        @Test()
        most_derived_override_is_marked_overriding_only() is
            let inlays = compile_inlays("virtuality.ghul", source());

            are_equal("▲", label_on(inlays, 13), "CAT.speak");
        si

        // The common case: a method that neither overrides nor is
        // overridden, on a class nothing outside the assembly can extend.
        // Absence of a hint is what says it is effectively non-virtual.
        @Test()
        effectively_non_virtual_method_gets_no_hint() is
            let inlays = compile_inlays("virtuality.ghul", source());

            is_null(virtuality_on(inlays, 9), "ANIMAL.legs should carry no hint");
        si

        // A method of an `open` class can be overridden by an assembly
        // that is not being compiled, which nothing else in the source
        // says.
        @Test()
        method_of_an_open_class_is_marked_openly_overridable() is
            let inlays = compile_inlays("virtuality.ghul", source());

            are_equal("○", label_on(inlays, 17), "SHAPE.area");

            let detail = detail_on(inlays, 17);

            is_true(
                detail? /\ detail.contains("outside this assembly"),
                "expected the open-dispatch note, got: {detail}"
            );
        si

        // A trait with an implementation is marked as implemented, and
        // the note says "implemented by" rather than "extended by".
        @Test()
        trait_is_marked_implemented_by_its_implementors() is
            let inlays = compile_inlays("virtuality.ghul", source());

            are_equal("▼", label_on(inlays, 2), "trait Speaker");

            let detail = detail_on(inlays, 2);

            is_true(
                detail? /\ detail.contains("implemented by") /\ detail.contains("ANIMAL"),
                "expected the implementor named, got: {detail}"
            );
        si

        // A class with a subclass is marked as extended.
        @Test()
        class_is_marked_extended_by_its_subclasses() is
            let inlays = compile_inlays("virtuality.ghul", source());

            are_equal("▼", label_on(inlays, 6), "class ANIMAL");

            let detail = detail_on(inlays, 6);

            is_true(
                detail? /\ detail.contains("extended by") /\ detail.contains("CAT"),
                "expected the subclass named, got: {detail}"
            );
        si

        // Both accessors of an auto-property are declared at the property
        // name, so the two carriers merge into one hint whose hover
        // answers for each half.
        @Test()
        property_accessors_merge_into_one_hint() is
            let inlays = compile_inlays("virtuality.ghul", source());

            let detail = detail_on(inlays, 21);

            is_true(
                detail? /\ detail.contains("get ▲"),
                "expected a getter note, got: {detail}"
            );

            is_true(
                detail? /\ detail.contains("set ▲"),
                "expected an assign note, got: {detail}"
            );

            are_equal(1, count_on(inlays, 21), "one merged hint at the property");
        si

        // The open set at build time decides what the pass records, so a
        // file the client opens afterwards has no carriers: the first
        // query against it drives an on-demand expression walk, and that
        // walk has to re-run the pass or the file shows narrowing inlays
        // and none of these, however much it is queried or edited.
        @Test()
        file_opened_after_the_build_still_gets_inlays() is
            let use analyser = ANALYSER_PROCESS();

            let other = "namespace Other is\n    class OTHER is\n        init() is si\n    si\nsi\n";

            analyser.send_open_files(["other.ghul"]);

            analyser.send_edit("other.ghul", other);
            analyser.read_response();
            analyser.send_edit("virtuality.ghul", source());
            analyser.read_response();
            analyser.send_compile();
            analyser.read_response();

            analyser.send_open_files(["other.ghul", "virtuality.ghul"]);

            analyser.send_compile();
            analyser.read_response();

            analyser.send_inlay_hints("virtuality.ghul");
            let response = analyser.read_query_response();
            assert isa Response.INLAY_HINTS(response) else "expected INLAY_HINTS response";

            let inlays = LIST[INLAY_HINT](response.hints);

            are_equal("▲", label_on(inlays, 13), "CAT.speak in a file opened after the build");
        si

        // The carriers are recorded before compile-expressions runs, so
        // they are declaration-level and survive the expression-only
        // re-walk an interface-preserving body edit takes. Virtuality
        // cannot change under such an edit, so losing them would be a
        // silent regression a full-rebuild test would never catch.
        @Test()
        hints_survive_a_body_only_edit() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_open_files(["virtuality.ghul"]);

            analyser.send_edit("virtuality.ghul", source());
            analyser.read_response();
            analyser.send_compile();
            analyser.read_response();

            // Same interface, different body.
            let edited = source().replace("=> \"meow\"", "=> \"mew\"");

            analyser.send_edit("virtuality.ghul", edited);
            analyser.read_response();
            analyser.send_compile();
            analyser.read_response();

            analyser.send_inlay_hints("virtuality.ghul");
            let response = analyser.read_response();
            assert isa Response.INLAY_HINTS(response) else "expected INLAY_HINTS response";

            let inlays = LIST[INLAY_HINT](response.hints);

            are_equal("▲▼", label_on(inlays, 8), "ANIMAL.speak after a body edit");
            are_equal("◆▼", label_on(inlays, 3), "Speaker.speak after a body edit");
        si

        // Two declarations that share a short name are two entries, and
        // both have to survive: a list built by collapsing entries that
        // rendered alike would report one implementor where there are
        // two, and a reader takes the list as the compiler's answer to
        // who implements this. Both assertions are on the whole hover
        // rather than on it containing a name, so a list one entry short
        // fails rather than passing on the entry that remains.
        @Test()
        same_named_implementors_are_both_listed() is
            let same_names =
                "namespace A is\n"
                "    trait Speaker is\n"
                "        speak() -> string;\n"
                "    si\n"
                "si\n"
                "namespace B is\n"
                "    class THING: A.Speaker is\n"
                "        init() is si\n"
                "        speak() -> string => \"b\";\n"
                "    si\n"
                "si\n"
                "namespace C is\n"
                "    class THING: A.Speaker is\n"
                "        init() is si\n"
                "        speak() -> string => \"c\";\n"
                "    si\n"
                "si\n";

            let inlays = compile_inlays("samenames.ghul", same_names);

            are_equal(
                "```ghul\nSpeaker\n▼ implemented by B.THING, C.THING\n```",
                detail_on(inlays, 2),
                "both implementors of the trait"
            );

            are_equal(
                "```ghul\nspeak\n◆ abstract\n▼ overridden by B.THING.speak() -> string, C.THING.speak() -> string\n```",
                detail_on(inlays, 3),
                "both overriders of the trait member"
            );
        si

        count_on(hints: Collections.Iterable[INLAY_HINT], line: int) -> int is
            let n mut = 0;

            for h in hints do
                if h.line == line /\ h.code? /\ h.code.starts_with("definition-virtuality") then
                    n = n + 1;
                fi
            od

            return n;
        si
    si
si
