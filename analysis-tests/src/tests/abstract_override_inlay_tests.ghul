namespace Analysis.Tests is
    use Collections.LIST;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.INLAY_HINT;
    use Analysis.Protocol.Response;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // A class redeclaring a trait member without a body. The
    // declaration is abstract and it is an override, so both directions
    // have to reach it: the trait member is overridden by it, and it
    // overrides the trait member and is overridden by the subclass that
    // implements it. A fixture of its own rather than lines added to
    // the shared one, whose assertions index by line.
    @TestClass()
    class ABSTRACT_OVERRIDE_INLAY_TESTS is
        init() is si

        //  1 namespace Redeclared is
        //  2     trait Renderable is
        //  3         render() -> string;
        //  4     si
        //  5     class Expr: Renderable abstract is
        //  6         init() is si
        //  7         render() -> string;
        //  8     si
        //  9     class NUM: Expr is
        // 10         init() is super.init(); si
        // 11         render() -> string => "num";
        // 12     si
        // 13 si
        source() -> string =>
            "namespace Redeclared is\n"
            "    trait Renderable is\n"
            "        render() -> string;\n"
            "    si\n"
            "    class Expr: Renderable abstract is\n"
            "        init() is si\n"
            "        render() -> string;\n"
            "    si\n"
            "    class NUM: Expr is\n"
            "        init() is super.init(); si\n"
            "        render() -> string => \"num\";\n"
            "    si\n"
            "si\n";

        compile_inlays(path: string, text: string) -> LIST[INLAY_HINT] is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_open_files([path]);

            analyser.send_edit(path, text);
            let edit = analyser.read_response();
            assert isa Response.DIAGNOSTICS(edit) else "expected DIAGNOSTICS after EDIT";

            analyser.send_compile();
            let compile = analyser.read_response();
            assert isa Response.DIAGNOSTICS(compile) else "expected DIAGNOSTICS after COMPILE";

            analyser.send_inlay_hints(path);
            let inlays = analyser.read_response();
            assert isa Response.INLAY_HINTS(inlays) else "expected INLAY_HINTS response";

            return LIST[INLAY_HINT](inlays.hints);
        si

        virtuality_on(hints: Collections.Iterable[INLAY_HINT], line: int) -> INLAY_HINT? is
            for h in hints do
                if h.line == line /\ h.code? /\ h.code.starts_with("definition-virtuality") then
                    return h;
                fi
            od

            return null;
        si

        label_on(hints: Collections.Iterable[INLAY_HINT], line: int) -> string? is
            let hint = virtuality_on(hints, line);

            return if hint? then hint.label else null fi;
        si

        detail_on(hints: Collections.Iterable[INLAY_HINT], line: int) -> string? is
            let hint = virtuality_on(hints, line);

            return if hint? then hint.detail else null fi;
        si

        @Test()
        redeclared_trait_member_overrides_and_is_overridden() is
            let inlays = compile_inlays("redeclared.ghul", source());

            are_equal("◆▲▼", label_on(inlays, 7), "Expr.render");

            let detail = detail_on(inlays, 7);

            is_true(
                detail? /\ detail.contains("◆ abstract"),
                "expected an abstract note, got: {detail}"
            );

            is_true(
                detail? /\ detail.contains("▲ overrides Renderable.render() -> string"),
                "expected the trait member named, got: {detail}"
            );

            is_true(
                detail? /\ detail.contains("▼ overridden by NUM.render() -> string"),
                "expected the implementation named, got: {detail}"
            );
        si

        @Test()
        trait_member_is_overridden_by_the_redeclaration() is
            let inlays = compile_inlays("redeclared.ghul", source());

            let detail = detail_on(inlays, 3);

            is_true(
                detail? /\ detail.contains("Expr.render"),
                "expected the redeclaration named, got: {detail}"
            );
        si
    si
si
