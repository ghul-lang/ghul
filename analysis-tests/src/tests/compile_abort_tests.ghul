namespace Analysis.Tests is
    use Collections.Iterable;
    use Collections.LIST;
    use Collections.MutableMap;

    use System.Text.StringBuilder;

    use Analysis.Protocol.ANALYSER_PROCESS;
    use Analysis.Protocol.EDIT_FILE;
    use Analysis.Protocol.Response;

    use Ghul.Pipes;

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;
    use Assertions;

    // An edit that arrives while a compile is running cuts that compile
    // short: the rest of its walk would compute diagnostics the edit has
    // already made stale.
    //
    // Only the expressions-only walk can be abandoned. Stopping part-way
    // through it leaves the remaining files at up-to-expressions with no
    // use-map entries, which is the state a single-file edit's rebuild
    // leaves anyway; the whole-project rebuild has no such halfway state
    // and runs to completion.
    //
    // Whether the walk notices the edit depends on the analyser's reader
    // thread having parsed the edit off the pipe before the walk's final
    // superseded check - scheduling on both sides, not behaviour - so the
    // test below proves the walk is still running before writing the edit
    // (an interleaved stats query is answered at the walk's per-file
    // boundaries), gives the walk several files' worth of work, and
    // retries the whole scenario a bounded number of times when the edit
    // loses that race anyway. Losing it is not a failure of the mechanism:
    // nothing was waiting when each file boundary looked.
    @TestClass()
    class COMPILE_ABORT_TESTS is
        init() is si

        // Enough files, each with enough methods, that the walk spans
        // several file boundaries - the points where a queued edit is
        // noticed and the walk abandoned.
        file_count: int static => 6;
        method_count: int static => 150;

        path_of(index: int) -> string static => "compile_abort_{index}.ghul";

        source_of(index: int) -> string static =>
            source_of(index, 0);

        // `extras` appends that many methods past the fixed method_count,
        // which changes the file's interface. Each larger count than the
        // file currently holds is an append against the retained tree,
        // taking the incremental interface path.
        source_of(index: int, extras: int) -> string static is
            let source = StringBuilder();

            source.append("namespace CompileAbort is\n");
            source.append("    class HOLDER_{index} is\n");
            source.append("        init() is si\n");

            for i in 0..method_count do
                source.append("\n");
                source.append("        method_{i}(a: int, b: int) -> int is\n");
                source.append("            let total = a + b + {i};\n");
                source.append("            return total * 2;\n");
                source.append("        si\n");
            od

            for e in 0..extras do
                source.append("\n");
                source.append("        extra_{e}() -> int => {index};\n");
            od

            source.append("    si\n");
            source.append("si\n");

            return source.to_string();
        si

        erroring_path: string static => "compile_abort_erroring.ghul";

        // A file the walk will reach carrying an expression-level error -
        // the kind a compile clears before recomputing, and so the kind
        // an abandoned one can lose.
        erroring_source() -> string static =>
            "namespace CompileAbort is\n"
            "    class ERRORING is\n"
            "        init() is si\n"
            "\n"
            "        broken() -> int => no_such_name;\n"
            "    si\n"
            "si\n";

        edit_files() -> Iterable[EDIT_FILE] static is
            let files = LIST[EDIT_FILE]();

            for i in 0..file_count do
                files.add(EDIT_FILE(path_of(i), source_of(i)));
            od

            files.add(EDIT_FILE(erroring_path, erroring_source()));

            return files;
        si

        read_diagnostics(analyser: ANALYSER_PROCESS, what: string) -> Response.DIAGNOSTICS static is
            let response = analyser.read_response();

            assert isa Response.DIAGNOSTICS(response) else
                "expected a diagnostics response {what}, got {response.get_type().name}\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}";

            return cast Response.DIAGNOSTICS(response);
        si

        // How many times the test will set up, prove the walk running,
        // write the superseding edit and read the outcome before giving
        // up. An attempt misses when the analyser finishes its walk
        // before its reader thread has queued the edit - scheduling,
        // not behaviour - and each miss re-stales and goes again.
        max_attempts: int static => 5;

        @Test()
        an_edit_written_during_a_compile_cuts_that_compile_short() is
            let use analyser = ANALYSER_PROCESS();
            requires_capability(analyser, "compile-abort")

            assert analyser.supports("compile-abort") else
                "analyser should advertise the compile-abort capability\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}";

            analyser.send_edit_files(edit_files());

            read_diagnostics(analyser, "for the initial edit");

            let extras mut = 1;

            let after_stale = _stale_holder_files(analyser, extras);

            is_true(
                after_stale.compile_needed,
                "an interface-affecting edit should leave a compile needed\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            extras = extras + 1;

            let attempts mut = 0;
            let observed mut = false;

            do
                if attempts >= max_attempts then
                    break;
                fi

                attempts = attempts + 1;

                let before = analyser.stat_counts();

                analyser.send_compile();

                // Interleavable queries are answered at the walk's
                // per-file boundaries, so this response arriving before
                // the compile's proves the walk was still running with
                // most of its files ahead of it - the moment to write
                // the superseding edit.
                analyser.send_stats();

                let first = analyser.read_response();

                if !isa Response.STATS(first) then
                    // The walk ended before the stats frame could be
                    // serviced at a boundary - nothing was waiting when
                    // each file boundary looked, so there was nothing to
                    // abort. Timing rather than behaviour. The compile's
                    // own diagnostics are the response just read; drain
                    // the trailing stats response and go again.
                    let trailing = analyser.read_response();

                    assert isa Response.STATS(trailing) else
                        "expected the trailing stats response, got {trailing.get_type().name}\n"
                        "--- analyser stderr ---\n{analyser.stderr_capture}";

                    _stale_holder_files(analyser, extras);

                    extras = extras + 1;

                    continue;
                fi

                analyser.send_edit(path_of(1), source_of(1, extras));

                extras = extras + 1;

                let candidate = read_diagnostics(analyser, "for the compile");

                if !candidate.compile_needed then
                    // Even with the walk proven mid-flight the edit lost
                    // the race to be queued before the walk ended. The
                    // superseding edit's own response follows.
                    read_diagnostics(analyser, "for the late superseding edit");

                    _stale_holder_files(analyser, extras);

                    extras = extras + 1;

                    continue;
                fi

                observed = true;

                are_equal(
                    "full",
                    candidate.phase,
                    "expected the compile's own response first\n"
                    "--- analyser stderr ---\n{analyser.stderr_capture}"
                );

                are_equal(
                    0,
                    candidate.checked_paths.count,
                    "an abandoned compile should report no checked paths\n"
                    "--- analyser stderr ---\n{analyser.stderr_capture}"
                );

                let superseding = read_diagnostics(analyser, "for the superseding edit");

                are_equal(
                    "partial",
                    superseding.phase,
                    "expected the superseding edit's response second\n"
                    "--- analyser stderr ---\n{analyser.stderr_capture}"
                );

                is_false(
                    _claims_clean(superseding, erroring_path),
                    "the superseding edit reported an unwalked file as clean\n"
                    "--- analyser stderr ---\n{analyser.stderr_capture}"
                );

                let after = analyser.stat_counts();

                are_equal(
                    1,
                    _delta(before, after, "compile-superseded"),
                    "the analyser did not record abandoning the compile\n"
                    "--- analyser stderr ---\n{analyser.stderr_capture}"
                );
            od

            assert observed else
                "could not observe an abandoned compile in {max_attempts} attempts\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}";
        si

        // One interface-affecting edit per HOLDER file, each awaited. Each
        // invalidates just the file it edited - the incremental interface
        // path splices the changed members without touching any other
        // file - and each also keeps the erroring file stale, since a
        // file holding errors is invalidated whenever any interface
        // changes. The compile that follows therefore walks several
        // files' expressions, giving an edit written mid-walk something
        // to interrupt. Returns the last edit's response.
        _stale_holder_files(analyser: ANALYSER_PROCESS, extras: int) -> Response.DIAGNOSTICS is
            let last: Response.DIAGNOSTICS? mut = null;

            for i in 0..file_count do
                analyser.send_edit(path_of(i), source_of(i, extras));

                last = read_diagnostics(analyser, "for the staling edit to {path_of(i)}");
            od

            return last!;
        si

        // Nothing waiting means nothing to defer to: the compile runs to
        // completion, reports every path it checked and clears the flag.
        @Test()
        a_compile_with_nothing_waiting_runs_to_completion() is
            let use analyser = ANALYSER_PROCESS();

            analyser.send_edit_files(edit_files());

            read_diagnostics(analyser, "for the initial edit");

            let extras mut = 1;

            analyser.send_edit(path_of(0), source_of(0, extras));

            read_diagnostics(analyser, "for the interface-affecting edit");

            let before = analyser.stat_counts();

            analyser.send_compile();

            let compile = read_diagnostics(analyser, "for the compile");

            is_false(
                compile.compile_needed,
                "a compile that ran to completion should not ask for another\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            is_true(
                compile.checked_paths.count >= file_count,
                "a compile that ran to completion should report every path it checked\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );

            let after = analyser.stat_counts();

            are_equal(
                0,
                _delta(before, after, "compile-superseded"),
                "nothing was waiting, so nothing should have been abandoned\n"
                "--- analyser stderr ---\n{analyser.stderr_capture}"
            );
        si

        // Whether the frame tells the client this path was checked and
        // came back with nothing against it.
        _claims_clean(response: Response.DIAGNOSTICS, path: string) -> bool static is
            let is_checked = response.checked_paths |> any(p => p.ends_with(path));

            let has_diagnostic = response.diagnostics |> any(d => d.path.ends_with(path));

            return is_checked /\ !has_diagnostic;
        si

        _delta(
            before: MutableMap[string,int],
            after: MutableMap[string,int],
            name: string
        ) -> int static =>
            _count(after, name) - _count(before, name);

        _count(counts: MutableMap[string,int], name: string) -> int static is
            if counts.contains_key(name) then
                return counts[name];
            fi

            return 0;
        si
    si
si
