namespace AmountLib is
    // An amount widens from a long through the holder's marked widening,
    // and its `+` is marked to take a widened operand. Its `*` is not
    // marked, and the holder's conversion from int is not a widening.
    struct AMOUNT(cents: long public) is
        @widen_operands()
        +(other: AMOUNT) -> AMOUNT => AMOUNT(cents + other.cents)

        *(other: AMOUNT) -> AMOUNT => AMOUNT(cents * other.cents)

        to_string() -> string => "{cents}c"
    si
si

namespace Ghul.Internal is
    class WIDENINGS is
        @widening() long_to_amount(value: long) -> AmountLib.AMOUNT static => AmountLib.AMOUNT(value)

        int_to_amount(value: int) -> AmountLib.AMOUNT static => AmountLib.AMOUNT(long(value))
    si
si
