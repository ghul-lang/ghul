// Nothing widens unless both marks are present: an operator not marked to
// accept a widened operand is not reached through a marked widening, and
// the holder's unmarked conversion is not a widening. A program's own
// file can't write either mark, though the build declares a library.
namespace App is
    use AmountLib.AMOUNT

    struct POINTS(n: long public) is
        @widen_operands()
        +(other: POINTS) -> POINTS => POINTS(n + other.n)
    si

    entry() is
        let a = AMOUNT(250L)

        let product = a * 2L
        let sum = a + 2
    si
si
