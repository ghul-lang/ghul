<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AssemblyName>binary</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="*.ghul" />
    <GhulSources Include="lib/**/*.ghul" />
    <!-- The second root sits inside the first, so a file under it cannot
         be attributed to one library rather than the other. -->
    <GhulOptions Include="--library-source outer@1.0.0=$(MSBuildProjectDirectory)/lib" />
    <GhulOptions Include="--library-source inner@1.0.0=$(MSBuildProjectDirectory)/lib/inner" />
  </ItemGroup>
</Project>
