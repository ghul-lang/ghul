<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AssemblyName>binary</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="*.ghul" />
    <GhulSources Include="lib1/**/*.ghul" />
    <GhulSources Include="lib2/**/*.ghul" />
    <GhulOptions Include="--library-source testlib@1.0.0=$(MSBuildProjectDirectory)/lib1" />
    <GhulOptions Include="--library-source testlib@2.0.0=$(MSBuildProjectDirectory)/lib2" />
  </ItemGroup>
</Project>
