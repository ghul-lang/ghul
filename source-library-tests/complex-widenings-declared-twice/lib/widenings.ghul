namespace Ghul.Internal is
    // The same widenings and widened forms the runtime declares.
    class WIDENINGS is
        @widening() int_to_complex(value: int) -> complex static pure => complex(value)
        @widening() long_to_complex(value: long) -> complex static pure => complex(value)
        @widening() single_to_complex(value: single) -> complex static pure => complex(value)
        @widening() double_to_complex(value: double) -> complex static pure => complex(value)

        // a real operand widened to reach complex's * reaches these instead
        @widened_form() *(left: complex, right: double) -> complex static pure => complex(left.real * right, left.imaginary * right)
        @widened_form() *(left: double, right: complex) -> complex static pure => complex(left * right.real, left * right.imaginary)
    si
si
