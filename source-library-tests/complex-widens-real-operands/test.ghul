// A real operand of any of int, long, single and double widens to a
// library's own complex type, through the library's marked widenings, to
// reach that type's arithmetic, on either side. A parameter that only the
// type's operator decides is inferred as that type.
namespace App is
    use IO.Std.write_line
    use Planar.Cx

    entry() is
        let c = Cx(3.0, 4.0)

        write_line("{c * 2} {2 * c} {c + 1.5} {c * 2L} {c * 0.5s} {1.5 - c} {c / 2}")

        // the widened form multiplies part by part: an infinite part stays
        // infinite and a zero part stays zero
        let infinite = Cx(1.0 / 0.0, 0.0)
        write_line("{infinite * 2.0} {2 * infinite} {infinite * Cx(2.0, 0.0)}")

        let times_c = y => c * y
        write_line("{times_c(Cx(1.0, 1.0))}")
    si
si
