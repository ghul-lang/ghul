// A real operand of any of int, long, single and double widens to complex,
// through the library's marked widenings, to reach .NET Complex's own
// arithmetic, on either side. A parameter that only a complex operator
// decides is inferred as complex.
namespace App is
    use IO.Std.write_line

    entry() is
        let c = 3r + 4j

        write_line("{c * 2} {2 * c} {c + 1.5} {c * 2L} {c * 0.5s} {1.5 - c} {c / 2}")

        // the widened form multiplies part by part: an infinite part stays
        // infinite and a zero part stays zero
        let infinite = complex(1.0 / 0.0, 0.0)
        write_line("{infinite * 2.0} {2 * infinite} {infinite * complex(2.0)}")

        let times_c = y => c * y
        write_line("{times_c(1r + 1j)}")
    si
si
