namespace Planar is
    // A complex number the library declares itself, so its widenings and
    // widened forms are the only ones in the program that reach it.
    struct Cx is
        re: double public
        im: double public

        init(re: double, im: double) is
            self.re = re
            self.im = im
        si

        @widen_operands() +(left: Cx, right: Cx) -> Cx static pure => Cx(left.re + right.re, left.im + right.im)
        @widen_operands() -(left: Cx, right: Cx) -> Cx static pure => Cx(left.re - right.re, left.im - right.im)
        @widen_operands() *(left: Cx, right: Cx) -> Cx static pure => Cx(left.re * right.re - left.im * right.im, left.re * right.im + left.im * right.re)

        @widen_operands() /(left: Cx, right: Cx) -> Cx static pure is
            let d = right.re * right.re + right.im * right.im
            Cx((left.re * right.re + left.im * right.im) / d, (left.im * right.re - left.re * right.im) / d)
        si

        to_string() -> string => "<{re}; {im}>"
    si
si

namespace Ghul.Internal is
    use Planar.Cx

    // The real scalars widen to Cx, to reach Cx's arithmetic.
    class WIDENINGS is
        @widening() int_to_cx(value: int) -> Cx static pure => Cx(double(value), 0.0)
        @widening() long_to_cx(value: long) -> Cx static pure => Cx(double(value), 0.0)
        @widening() single_to_cx(value: single) -> Cx static pure => Cx(double(value), 0.0)
        @widening() double_to_cx(value: double) -> Cx static pure => Cx(value, 0.0)

        // a real operand widened to reach Cx's * reaches these instead
        @widened_form() *(left: Cx, right: double) -> Cx static pure => Cx(left.re * right, left.im * right)
        @widened_form() *(left: double, right: Cx) -> Cx static pure => Cx(left * right.re, left * right.im)
    si
si
