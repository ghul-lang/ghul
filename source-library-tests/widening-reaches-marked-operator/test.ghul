// An operand widens through the library's marked widening to reach its
// marked operator, and only where nothing resolves for the operands as
// written: an operator declared for the exact operand types is chosen
// over any widening.
namespace App is
    use IO.Std.write_line
    use AmountLib.AMOUNT

    +(a: AMOUNT, b: int) -> string => "exact {a} + {b}"

    entry() is
        let a = AMOUNT(250L)

        write_line(a + 50L)
        write_line(50L + a)
        write_line(a + 7)

        let added = (x: long) => a + x
        write_line(added(5L))
    si
si
