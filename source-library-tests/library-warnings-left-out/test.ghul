// A warning located in a source library's file belongs to the library and
// is not reported to the program that compiles it in. The program's own
// warning, on the badly named function below, is reported as usual.
namespace App is
    use IO.Std.write_line
    use WarnLib

    BadlyNamed() -> int => boxed(6)

    entry() is
        write_line("{BadlyNamed()}")
    si
si
