namespace Syntax.Process is
    use Symbol = Semantic.Symbols.Symbol
    use LOCATION = Source.LOCATION

    // One heap fact crossed by one call during a body walk, and what
    // the walk did about it: killed it, because the relations solved by
    // the previous effects round could not show the callee left it
    // alone, or kept it - because they could, or because no relations
    // had been solved yet. `function` is the definition whose walk
    // made the record, so that walk alone can be redone.
    class KILL(
        file_name: string,
        crossing: CROSSING,
        target: Symbol?,
        path: ACCESS_PATH?,
        is_presence: bool,
        killed: bool
    ) is
        function: Trees.Definitions.FUNCTION? public

        // Whether this records a fact that was never formed, because a
        // getter the value is read through cannot back one, rather than
        // a call that ended a fact that was. The crossing then names the
        // getter's own declaration, which is no call site, and a use
        // short of the fact is short of it from the start.
        declined: bool public

        // What the dropped fact said the value was, for a type fact of a
        // formed narrowing. Null for a presence fact, and for a record
        // made where no fact was formed. A use that fails for want of
        // this fact is reported with the call attached, and what the
        // fact said is how that is judged.
        narrowed_type: Semantic.Types.Type? public
    si

    // The combined type + effect solve, in-walk form. When a
    // solved set of effect relations exists, the call transfer asks of
    // every heap fact live across a call whether the callee provably
    // left it alone, and drops the fact at the call when it cannot -
    // the fact's validity region ends there, the widened view flows
    // on, and a use only the fact satisfied is an ordinary type error.
    //
    // Every crossing a fact takes is recorded here with the walk's
    // decision. After each solve the decisions are re-asked against the
    // new relations: a fact kept across a call that cannot now be
    // discharged - every crossing of a walk made before any solve, and
    // some after an edit - or dropped at one that now can, makes its
    // body inexact, and the driver re-walks inexact bodies until a
    // solve finds none. The ledger keys nothing on rendered text: it
    // holds the crossing, fact and definition objects the walk
    // recorded.
    class KILL_LEDGER is
        _kills: Collections.LIST[KILL] static

        // Each read of a function's store-free proof made by a walk
        // before the solve that settles it: the pure shape of a named
        // function's type is read that way, and a literal returning the
        // function infers its own type from the answer.
        _purity_reads: Collections.LIST[PURITY_READ] static

        init() static is
            _kills = Collections.LIST[KILL]()
            _purity_reads = Collections.LIST[PURITY_READ]()
            _restart_bodies = Collections.SET[Trees.Definitions.FUNCTION]()
        si

        // The file whose bodies are being walked, for records made
        // where no location is at hand.
        current_file: string? public static

        // The definition whose body is being walked. Set for the
        // duration of each definition's walk by compile-expressions;
        // a record made outside one is keyed on its file alone.
        current_function: Trees.Definitions.FUNCTION? public static

        // Set while a walk must keep every fact whatever the relations
        // say: the start of a descent from the top.
        kills_suspended: bool public static

        // Set while the driver re-walks inexact bodies against the
        // relations, as opposed to an edit path walking a body against
        // the last complete solve.
        in_descent: bool public static

        // Whether some body was walked with kills outside a descent since
        // the last descent from the top - so the next COMPILE must restart
        // from the top to be sure of reaching the same answer batch would.
        needs_restart: bool public static

        // The definitions whose walk killed outside a descent since the
        // last descent from the top: the only bodies that started the
        // descent below the top, so the only ones a restart re-walks.
        _restart_bodies: Collections.SET[Trees.Definitions.FUNCTION] static

        // Whether the walk can consult relations at all.
        can_kill_in_walk: bool static => EFFECTS.is_complete /\ !kills_suspended

        record(kill: KILL) static is
            kill.function = current_function

            if kill.killed /\ !in_descent then
                needs_restart = true

                if let function = current_function then
                    _restart_bodies.add(function)
                fi
            fi

            _kills.add(kill)
        si

        // A definition's walk read whether `function` is proven store-free,
        // and was told `answer`. Reads made anywhere else record nothing:
        // no inferred type depends on them.
        record_purity_read(function: Semantic.Symbols.Function, answer: bool) static is
            if let walked = current_function then
                _purity_reads.add(PURITY_READ(walked.location.file_name, walked, function, answer))
            fi
        si

        // Hand over the bodies a restart has to re-walk and start
        // afresh: those whose walk killed outside a descent.
        take_restart_bodies() -> Collections.SET[Trees.Definitions.FUNCTION] static is
            let result = _restart_bodies

            _restart_bodies = Collections.SET[Trees.Definitions.FUNCTION]()
            needs_restart = false

            return result
        si

        // Every definition whose last walk killed something.
        bodies_with_kills() -> Collections.SET[Trees.Definitions.FUNCTION] static is
            let result = Collections.SET[Trees.Definitions.FUNCTION]()

            for kill in _kills do
                if kill.killed then
                    if let function = kill.function then
                        result.add(function)
                    fi
                fi
            od

            return result
        si

        // The file's walk is being redone from its source: whatever it
        // recorded is superseded by the walk to come.
        clear_for(file_name: string) static is
            _drop_where((file, _) => file =~ file_name)
        si

        // One definition's body walk is being redone.
        clear_for(function: Trees.Definitions.FUNCTION) static is
            _drop_where((_, walked: Trees.Definitions.FUNCTION?) => walked == function)
        si

        _drop_where(condition: (string, Trees.Definitions.FUNCTION?) -> bool) static is
            let kept = Collections.LIST[KILL]()

            for kill in _kills do
                if !condition(kill.file_name, kill.function) then
                    kept.add(kill)
                fi
            od

            _kills = kept

            let kept_reads = Collections.LIST[PURITY_READ]()

            for read in _purity_reads do
                if !condition(read.file_name, read.walked) then
                    kept_reads.add(read)
                fi
            od

            _purity_reads = kept_reads
        si

        // One line per record, for comparing what walks recorded.
        dump(writer: IO.TextWriter) static is
            for kill in _kills do
                let what = if let target = kill.target then target.name elif let path = kill.path then path.to_string() else "?" fi

                writer.write_line("{kill.file_name} {if let function = kill.function then function.location.start_line else 0 fi} {kill.crossing.location} {if kill.is_presence then "presence" else "type" fi} {what} {if kill.killed then "killed" else "kept" fi}")
            od
        si

        clear_all() static is
            _kills.clear()
            _purity_reads.clear()
        si

        // The call that dropped a fact about this target nearest above
        // `at`, if one did. Asked at a use that failed for want of the
        // fact, so that the error can name the call that ended it;
        // `is_presence` picks the domain. A value narrowed more than
        // once in a body has a record per drop, each of a fact
        // re-established since the last, so the one the use is short of
        // is the last drop written before it - an earlier one belongs
        // to a narrowing this use never had.
        last_dropped_before(target: Symbol?, path: ACCESS_PATH?, is_presence: bool, at: LOCATION) -> KILL? static is
            let result: KILL? mut = null

            for kill in _kills do
                if
                    kill.killed /\
                    !kill.declined /\
                    kill.is_presence == is_presence /\
                    kill.function == current_function /\
                    _describes(kill, target, path) /\
                    _precedes(kill.crossing.location, at)
                then
                    if !result? \/ kill.crossing.location.start > result.crossing.location.start then
                        result = kill
                    fi
                fi
            od

            return result
        si

        // Whether a call written here could have ended a fact a use at
        // `use` needed: the same file, and not below it.
        _precedes(call: LOCATION, at: LOCATION) -> bool static =>
            call.file_name =~ at.file_name /\ call.start <= at.start

        _describes(kill: KILL, target: Symbol?, path: ACCESS_PATH?) -> bool static is
            if let killed_target = kill.target then
                return target? /\ killed_target == target
            fi

            if let killed_path = kill.path then
                return path? /\ killed_path.equals(path)
            fi

            return false
        si

        // After a solve: every body whose walk decided some crossing
        // differently from the way the new relations would, and the
        // files of the records made outside any definition's walk.
        // Both empty means the last walk of every body agrees with the
        // relations, which is the fixpoint.
        take_inexact() -> INEXACT static is
            let result = INEXACT()

            let stopwatch = System.Diagnostics.Stopwatch.start_new()
            let asked mut = 0
            let killed mut = 0

            for kill in _kills do
                if kill.killed then
                    killed = killed + 1
                fi

                if let function = kill.function then
                    if result.bodies.contains(function) then
                        continue
                    fi
                elif result.files.contains(kill.file_name) then
                    continue
                fi

                asked = asked + 1

                let discharged = RELIANCES.crossing_discharged(kill.crossing, kill.target, kill.path, kill.is_presence)

                if discharged == kill.killed then
                    if let function = kill.function then
                        result.bodies.add(function)
                    else
                        result.files.add(kill.file_name)
                    fi
                fi
            od

            // A body that read a proof the solve has since settled the
            // other way inferred its types from the wrong answer.
            for read in _purity_reads do
                if read.function.is_proven_store_free != read.answer then
                    if let walked = read.walked then
                        result.bodies.add(walked)
                    else
                        result.files.add(read.file_name)
                    fi
                fi
            od

            if System.Environment.get_environment_variable("GHUL_EFFECTS_TIMING")? then
                IO.Std.error.write_line("ledger: {_kills.count} records ({killed} killed), {asked} re-asked in {stopwatch.elapsed_milliseconds} ms, {result.bodies.count} body(ies) and {result.files.count} file(s) inexact")
            fi

            return result
        si
    si

    // One read of a function's store-free proof by the walk of
    // `walked`, or of the file where no definition was being walked.
    class PURITY_READ(
        file_name: string,
        walked: Trees.Definitions.FUNCTION?,
        function: Semantic.Symbols.Function,
        answer: bool
    )

    // What a solve found inexact: the definitions whose body walks
    // disagree with the relations, and the files of records that were
    // made outside a definition's walk.
    class INEXACT is
        bodies: Collections.SET[Trees.Definitions.FUNCTION]
        files: Collections.SET[string]

        init() is
            bodies = Collections.SET[Trees.Definitions.FUNCTION]()
            files = Collections.SET[string]()
        si

        is_empty: bool => bodies.count == 0 /\ files.count == 0
    si
si
