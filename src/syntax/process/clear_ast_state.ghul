namespace Syntax.Process is
    use Trees

    // Walk an AST resetting per-build mutable state on each node.
    //
    // Each visit override calls `node.clear()` (non-recursive — Node.clear
    // resets only its own state). Traversal is handled by the existing walk
    // methods on each tree class, which already know how to recurse.
    //
    // Run between compile-expressions invocations on the same AST (analyser
    // COMPILE-after-EDIT, multi-file rebuilds). See project_analysis_mode_workflow
    // memory for why this is needed: ad-hoc resets in individual visit
    // methods cover most state, but the constraint mechanism's narrowing-only
    // upgrade can leave stale entries across `apply` calls. This visitor
    // makes clearing structural rather than ad-hoc.
    // Inherits from StrictVisitor (rather than Visitor) so that any AST
    // node type added to the codebase later will throw NotImplementedException
    // here until someone adds an override — forces us to consider whether
    // the new node has clearable state. The default override per node type
    // calls node.clear() which is itself a no-op unless the subclass adds
    // state to clear, so the cost of adding a new node type is one trivial
    // override here.
    class CLEAR_STATE_VISITOR: StrictVisitor is
        // When true, TypeExpression.type (resolve-type-expressions output)
        // is left intact and only compile-expressions output is cleared.
        // The recompile-dependents path uses this: a referencing file's
        // bodies must re-compile to rebind to a reconciled symbol, but its
        // interface type expressions are unchanged and re-resolving them
        // against the retained interface symbols would set their types
        // twice. Compile-expressions output lives in Expression/Statement
        // compile state and the VariableLeft store, separate from
        // TypeExpression.type, so clearing it without touching the resolved
        // types is a clean split.
        _preserve_resolved_types: bool

        // When true, each node keeps what its context pushed down and
        // drops only what the walk produced (see Node.clear_outputs):
        // the reset the compile-expressions retry loop makes between
        // walks of one body. Implies preserving resolved types.
        _outputs_only: bool

        init() is
            super.init()
            _preserve_resolved_types = false
            _outputs_only = false
        si

        init(preserve_resolved_types: bool) is
            super.init()
            _preserve_resolved_types = preserve_resolved_types
            _outputs_only = false
        si

        init(preserve_resolved_types: bool, outputs_only: bool) is
            super.init()
            _preserve_resolved_types = preserve_resolved_types \/ outputs_only
            _outputs_only = outputs_only
        si

        _clear(node: Trees.Node) is
            if _outputs_only then
                node.clear_outputs()
            else
                node.clear()
            fi
        si

        apply(root: Trees.Node) is
            root.walk(self)
        si

        _clear_type(type_expression: TypeExpressions.TypeExpression) is
            if !_preserve_resolved_types then
                type_expression.clear()
            fi
        si

        // StrictVisitor.pre(STATEMENT) and pre(VAL_BLOCK) throw. Override
        // here to allow normal recursion into the child body.
        pre(statement: Trees.Expressions.STATEMENT) -> bool => false
        pre(block: Trees.Expressions.VAL_BLOCK) -> bool => false
        // Identifiers
        visit(identifier: Identifiers.Identifier) is _clear(identifier); si
        visit(identifier: Identifiers.QUALIFIED) is _clear(identifier); si

        // Modifiers / pragmas
        visit(modifier: Modifiers.Modifier) is _clear(modifier); si
        visit(modifiers: Modifiers.LIST) is _clear(modifiers); si
        visit(pragma: Pragmas.PRAGMA) is _clear(pragma); si

        // Definitions
        visit(definition: Definitions.Definition) is _clear(definition); si
        // LIST has no per-build state of its own; the walk has already
        // visited each child in `definitions` and called clear() on it.
        visit(definitions: Definitions.LIST) is si
        visit(pragma: Definitions.PRAGMA) is _clear(pragma); si
        visit(`namespace: Definitions.NAMESPACE) is _clear(`namespace); si
        visit(`use: Definitions.USE) is _clear(`use); si
        visit(`class: Definitions.CLASS) is _clear(`class); si
        visit(`partial: Definitions.PARTIAL) is _clear(`partial); si
        visit(`impl: Definitions.IMPL) is _clear(`impl); si
        visit(`trait: Definitions.TRAIT) is _clear(`trait); si
        visit(`struct: Definitions.STRUCT) is _clear(`struct); si
        visit(`union: Definitions.UNION) is _clear(`union); si
        visit(variant: Definitions.VARIANT) is _clear(variant); si
        visit(`enum: Definitions.ENUM) is _clear(`enum); si
        visit(enum_member: Definitions.ENUM_MEMBER) is _clear(enum_member); si
        visit(function: Definitions.FUNCTION) is _clear(function); si
        visit(functions: Definitions.FUNCTION_GROUP) is _clear(functions); si
        visit(property: Definitions.PROPERTY) is _clear(property); si
        visit(indexer: Definitions.INDEXER) is _clear(indexer); si

        // Variables (definition-side)
        visit(variable: Variables.VARIABLE) is _clear(variable); si
        visit(variables: Variables.LIST) is _clear(variables); si
        visit(left: Trees.Variables.SIMPLE_VARIABLE_LEFT) is _clear(left); si
        visit(destructure_left: Trees.Variables.DESTRUCTURING_VARIABLE_LEFT) is _clear(destructure_left); si
        visit(literal_leaf: Trees.Variables.LITERAL_VARIABLE_LEFT) is _clear(literal_leaf); si

        // Type expressions — clearing `type` here is skipped when
        // preserving resolved types (see `_clear_type`).
        visit(type_expression: TypeExpressions.TypeExpression) is _clear_type(type_expression); si
        visit(type_expression: TypeExpressions.INFER) is _clear_type(type_expression); si
        visit(structured: TypeExpressions.Structured) is _clear_type(structured); si
        visit(array: TypeExpressions.ARRAY_) is _clear_type(array); si
        visit(iterable: TypeExpressions.ITERABLE) is _clear_type(iterable); si
        visit(pointer: TypeExpressions.POINTER) is _clear_type(pointer); si
        visit(optional: TypeExpressions.OPTIONAL) is _clear_type(optional); si
        visit(reference: TypeExpressions.REFERENCE) is _clear_type(reference); si
        visit(member: TypeExpressions.MEMBER) is _clear_type(member); si
        visit(named: TypeExpressions.NAMED) is _clear_type(named); si
        visit(types: TypeExpressions.LIST) is _clear(types); si
        visit(generic: TypeExpressions.GENERIC) is _clear_type(generic); si
        visit(function: TypeExpressions.FUNCTION) is _clear_type(function); si
        visit(functions: TypeExpressions.FUNCTION_GROUP) is _clear_type(functions); si
        visit(tuple: TypeExpressions.TUPLE) is _clear_type(tuple); si
        visit(element: TypeExpressions.NAMED_TUPLE_ELEMENT) is _clear_type(element); si
        visit(constraint: TypeExpressions.TYPE_PARAMETER_CONSTRAINT) is _clear_type(constraint); si
        visit(element: TypeExpressions.UNDEFINED) is _clear_type(element); si

        // Expressions
        visit(expression: Expressions.Expression) is _clear(expression); si
        visit(identifier: Expressions.IDENTIFIER) is _clear(identifier); si
        visit(literal: Expressions.Literals.Literal) is _clear(literal); si
        visit(`string: Expressions.Literals.STRING) is _clear(`string); si
        visit(interpolation: Expressions.STRING_INTERPOLATION) is _clear(interpolation); si
        visit(integer: Expressions.Literals.INTEGER) is _clear(integer); si
        visit(float: Expressions.Literals.FLOAT) is _clear(float); si
        visit(character: Expressions.Literals.CHARACTER) is _clear(character); si
        visit(boolean: Expressions.Literals.BOOLEAN) is _clear(boolean); si
        visit(variable: Expressions.VARIABLE) is _clear(variable); si
        visit(variable: Expressions.TUPLE_ELEMENT) is _clear(variable); si
        visit(none: Expressions.Literals.NONE) is _clear(none); si
        visit(`null: Expressions.NULL) is _clear(`null); si
        visit(`self: Expressions.SELF) is _clear(`self); si
        visit(`super: Expressions.SUPER) is _clear(`super); si
        visit(construct: Expressions.CONSTRUCT) is _clear(construct); si
        // The reading of an ambiguous cast is a resolve-type-expressions
        // result like any other, so it is cleared with them: a later
        // walk decides again against whatever the scope says then.
        visit(`cast: Expressions.CAST) is
            `cast.set_reading(Expressions.CastReading.UNDECIDED)
            _clear(`cast)
        si
        visit(`await: Expressions.AWAIT) is _clear(`await); si
        visit(spill: Expressions.SPILL) is _clear(spill); si
        visit(`isa: Expressions.ISA) is _clear(`isa); si

        visit(field_equals: Expressions.FIELD_EQUALS) is _clear(field_equals); si
        visit(hash_operand: Expressions.HASH_OPERAND) is _clear(hash_operand); si
        visit(memberwise_equals: Expressions.MEMBERWISE_EQUALS) is _clear(memberwise_equals); si
        visit(memberwise_hash: Expressions.MEMBERWISE_HASH) is _clear(memberwise_hash); si
        visit(`isa: Expressions.TYPEOF) is _clear(`isa); si
        visit(`default: Expressions.DEFAULT) is _clear(`default); si
        visit(function: Expressions.FUNCTION) is _clear(function); si
        visit(recurse: Expressions.RECURSE) is _clear(recurse); si
        visit(tuple: Expressions.TUPLE) is _clear(tuple); si
        visit(sequence: Expressions.SEQUENCE) is _clear(sequence); si
        visit(list: Expressions.LIST) is _clear(list); si
        visit(call: Expressions.CALL) is _clear(call); si
        visit(member: Expressions.MEMBER) is _clear(member); si
        visit(ambiguous_expression: Expressions.AMBIGUOUS_EXPRESSION) is _clear(ambiguous_expression); si
        visit(ambiguous_expression: Expressions.GENERIC_APPLICATION) is _clear(ambiguous_expression); si
        visit(index: Expressions.INDEX) is _clear(index); si
        visit(has_value: Expressions.HAS_VALUE) is _clear(has_value); si
        visit(unwrap: Expressions.UNWRAP) is _clear(unwrap); si
        visit(reference: Expressions.REFERENCE) is _clear(reference); si
        visit(unary: Expressions.UNARY) is _clear(unary); si
        visit(binary: Expressions.BINARY) is _clear(binary); si
        visit(statement: Expressions.STATEMENT) is _clear(statement); si
        visit(statement: Expressions.LET_IN) is _clear(statement); si
        visit(comprehension: Expressions.COMPREHENSION) is _clear(comprehension); si
        visit(clause: Expressions.COMPREHENSION_FOR) is _clear(clause); si
        visit(clause: Expressions.COMPREHENSION_IF) is _clear(clause); si
        visit(block: Expressions.VAL_BLOCK) is _clear(block); si
        visit(assert_in: Expressions.ASSERT_IN) is _clear(assert_in); si

        // Left-side expressions
        visit(left: Trees.Expressions.SIMPLE_LEFT_EXPRESSION) is _clear(left); si
        visit(destructure_left: Trees.Expressions.DESTRUCTURING_LEFT_EXPRESSION) is _clear(destructure_left); si

        // Statements
        visit(statement: Statements.Statement) is _clear(statement); si
        visit(statements: Statements.LIST) is _clear(statements); si
        visit(f: Statements.FUNCTION) is _clear(f); si
        visit(l: Statements.LET) is _clear(l); si
        visit(assign: Statements.ASSIGNMENT) is _clear(assign); si
        visit(expression: Statements.EXPRESSION) is _clear(expression); si
        visit(`return: Statements.RETURN) is _clear(`return); si
        visit(`throw: Statements.THROW) is _clear(`throw); si
        visit(`yield: Statements.YIELD) is _clear(`yield); si
        visit(`yield: Statements.YIELD_ALL) is _clear(`yield); si
        visit(assert__: Statements.ASSERT) is _clear(assert__); si
        visit(`if: Statements.IF) is _clear(`if); si
        visit(if_branch: Statements.IF_BRANCH) is _clear(if_branch); si
        visit(rb: Statements.REFUTABLE_BINDING) is _clear(rb); si
        visit(`case: Statements.CASE) is _clear(`case); si
        visit(case_match: Statements.CASE_MATCH) is _clear(case_match); si
        visit(`try: Statements.TRY) is _clear(`try); si
        visit(`catch: Statements.CATCH) is _clear(`catch); si
        visit(`do: Statements.DO) is _clear(`do); si
        visit(`for: Statements.FOR) is _clear(`for); si
        visit(labelled: Statements.LABELLED) is _clear(labelled); si
        visit(`break: Statements.BREAK) is _clear(`break); si
        visit(`continue: Statements.CONTINUE) is _clear(`continue); si
        visit(pragma: Statements.PRAGMA) is _clear(pragma); si

        // Bodies
        visit(expression: Bodies.EXPRESSION) is _clear(expression); si
        visit(block: Bodies.BLOCK) is _clear(block); si
        visit(block: Bodies.NULL) is _clear(block); si
        visit(block: Bodies.INNATE) is _clear(block); si
    si
si
