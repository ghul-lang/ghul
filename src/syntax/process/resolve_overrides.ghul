namespace Syntax.Process is

    use Logging
    use Trees
    use Source

    class RESOLVE_OVERRIDES: ScopedVisitor is
        _logger: Logger
        _symbol_table: Semantic.SYMBOL_TABLE

        _done_object: bool

        _duplicate_method_checker: Semantic.DUPLICATE_METHOD_CHECKER

        // The `impl` blocks for built-in types, checked once the built-in
        // operators a source core library declares are registered, since
        // a scalar fills an operator slot with one of those.
        _impl_checks: Collections.LIST[(target: Semantic.Symbols.Classy, ancestor: Semantic.Types.Type, location: Source.LOCATION)]

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES
        )
        is
            super.init(logger, symbol_table, namespaces)

            _logger = logger
            _symbol_table = symbol_table

            _duplicate_method_checker = Semantic.DUPLICATE_METHOD_CHECKER(logger)
            _impl_checks = Collections.LIST[(target: Semantic.Symbols.Classy, ancestor: Semantic.Types.Type, location: Source.LOCATION)]()
        si

        apply(root: Trees.Node) is
            Semantic.INJECTED_MEMBER_CHECK.check(_logger)

            // FIXME: this isn't needed
            if !_done_object then
                let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

                lookup.get_object_type().symbol.pull_down_super_symbols()
                lookup.get_value_type().symbol.pull_down_super_symbols()

                // An array family the compiler constructs has no declaration
                // of its own to visit; the members a library gives it in a
                // `partial` block override what its ancestors declare.
                if
                    let array_generic = cast Semantic.Symbols.GENERIC?(lookup.get_array_type(lookup.get_int_type()).symbol),
                    array = cast Semantic.Symbols.Classy?(array_generic.unspecialized_symbol) /\
                    !array.is_reflected
                then
                    array.pull_down_super_symbols()
                fi

                // So has the string type, where a library declares it.
                if let string = cast Semantic.Symbols.Classy?(lookup.get_string_type().symbol) /\ !string.is_reflected then
                    string.pull_down_super_symbols()
                fi

                // So have the scalar types, where a library declares them,
                // which inherit what the root declares as any struct does.
                let scalars = [
                    lookup.get_bool_type(), lookup.get_char_type(),
                    lookup.get_byte_type(), lookup.get_ubyte_type(),
                    lookup.get_short_type(), lookup.get_ushort_type(),
                    lookup.get_int_type(), lookup.get_uint_type(),
                    lookup.get_long_type(), lookup.get_ulong_type(),
                    lookup.get_word_type(), lookup.get_uword_type(),
                    lookup.get_single_type(), lookup.get_double_type()
                ]

                for scalar in scalars do
                    if let declared = cast Semantic.Symbols.Classy?(scalar.symbol) /\ !declared.is_reflected then
                        declared.pull_down_super_symbols()
                    fi
                od

                // And bigint, complex, and the tuple families, whose members a library
                // gives them in `partial` blocks override what `object`
                // declares, as a scalar's do.
                if let declared = cast Semantic.Symbols.Classy?(lookup.get_bigint_type().symbol) /\ !declared.is_reflected then
                    declared.pull_down_super_symbols()
                fi

                if let declared = cast Semantic.Symbols.Classy?(lookup.get_complex_type().symbol) /\ !declared.is_reflected then
                    declared.pull_down_super_symbols()
                fi

                for arity in 1::7 do
                    let elements = Collections.LIST[Semantic.Types.Type]()

                    for _ in 1::arity do
                        elements.add(lookup.get_int_type())
                    od

                    if
                        let generic = cast Semantic.Symbols.GENERIC?(lookup.get_tuple_type(elements, null).symbol),
                        family = cast Semantic.Symbols.Classy?(generic.unspecialized_symbol) /\
                        !family.is_reflected
                    then
                        family.pull_down_super_symbols()
                    fi
                od

                _done_object = true
            fi

            root.walk(self)
        si

        check_duplicate_global_functions() is
            for ns in _namespaces do
                try
                    _duplicate_method_checker.check(ns, "duplicate-function", "duplicate function")
                catch e: Ghul.Exception
                    _logger.exception(ns.location, e, "exception checking for duplicate global functions")
                yrt
            od
        si

        pre(`class: Trees.Definitions.CLASS) -> bool => true

        visit(`class: Definitions.CLASS) is
            let symbol = symbol_for(`class)

            if symbol? /\ isa Semantic.Symbols.Classy(symbol) then
                _duplicate_method_checker.check(symbol, "duplicate-function", "duplicate method")

                symbol.pull_down_super_symbols()

                Semantic.Symbols.STATIC_INTERFACE_IMPLEMENTATION_CHECKER(_logger).check(symbol)
            fi
        si

        // A built-in type has no definition of its own to visit, so each
        // `impl` for one is recorded, to be checked for the static members
        // it leaves unfilled. A type declared in source is checked at its
        // definition.
        visit(`impl: Trees.Definitions.IMPL) is
            if let target = class_or_trait_for(`impl) /\ target.is_built_in_type /\ `impl.ancestors? then
                for a in `impl.ancestors do
                    if let ancestor = a.type /\ !ancestor.is_error then
                        _impl_checks.add((target, ancestor, a.location))
                    fi
                od
            fi

            super.visit(`impl)
        si

        /// Forgets the `impl` blocks recorded by an earlier run of the pass.
        forget_impl_checks() is
            _impl_checks.clear()
        si

        /// Checks each `impl` for a built-in type recorded so far for the
        /// static members it leaves unfilled, then forgets them.
        check_impl_static_members() is
            let checker = Semantic.Symbols.STATIC_INTERFACE_IMPLEMENTATION_CHECKER(_logger)

            for check in _impl_checks do
                checker.check_implemented(check.target, check.ancestor, check.location)
            od

            _impl_checks.clear()
        si

        pre(`trait: Trees.Definitions.TRAIT) -> bool => true

        visit(`trait: Definitions.TRAIT) is
            let symbol = symbol_for(`trait)

            if symbol? /\ isa Semantic.Symbols.Classy(symbol) then
                _duplicate_method_checker.check(symbol, "duplicate-function", "duplicate method")

                symbol.pull_down_super_symbols()

                Semantic.Symbols.VARIANCE_POSITION_CHECKER(symbol, _logger).check()
            fi
        si

        pre(`struct: Trees.Definitions.STRUCT) -> bool => true

        visit(`struct: Definitions.STRUCT) is
            let symbol = symbol_for(`struct)

            if symbol? /\ isa Semantic.Symbols.Classy(symbol) then
                symbol.pull_down_super_symbols()

                Semantic.Symbols.STATIC_INTERFACE_IMPLEMENTATION_CHECKER(_logger).check(symbol)
            fi
        si

        // Walk into the union body so variants get visited (their
        // `pull_down_super_symbols()` runs in `visit(variant)` below).
        // Without this, variants never have inherited members like
        // `to_string` pulled into their scope, so member lookup on a
        // variant type misses anything inherited via the union from
        // `object`.
        pre(`union: Trees.Definitions.UNION) -> bool => false

        visit(`union: Definitions.UNION) is
            let symbol = symbol_for(`union)

            if symbol? /\ isa Semantic.Symbols.Classy(symbol) then
                symbol.pull_down_super_symbols()
            fi
        si

        pre(variant: Trees.Definitions.VARIANT) -> bool => true

        visit(variant: Definitions.VARIANT) is
            let symbol = symbol_for(variant)

            if symbol? /\ isa Semantic.Symbols.Classy(symbol) then
                symbol.pull_down_super_symbols()
            fi
        si

        pre(`enum: Trees.Definitions.ENUM) -> bool => true

        visit(`enum: Definitions.ENUM) is
            let symbol = symbol_for(`enum)

            if symbol? /\ isa Semantic.Symbols.Classy(symbol) then
                symbol.pull_down_super_symbols()
            fi
        si
    si
si
