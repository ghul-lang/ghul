namespace Syntax.Process is
    // Whether the generic compare.value innate can meaningfully
    // compare operands of a given type. It lowers to a single ceq
    // instruction, which is a scalar comparison: correct for
    // primitive scalars, enums, and references. For any other value
    // type the runtime accepts the instruction but degrades it to a
    // shallow bitwise comparison - reference fields compare by
    // identity and bit patterns stand in for values - so == and !=
    // over one are rejected at resolution with a pointer to =~.
    class VALUE_EQUALITY_OPERANDS is
        can_compare(type: Semantic.Types.Type) -> bool static is
            // a type parameter keeps == for now: the emitted
            // comparison is correct for primitive and reference
            // instantiations, and generic code has no alternative
            // operator to reach for. This arm must stay ahead of the
            // value-type test - every GenericArgument reports
            // is_value_type, so falling through would misclassify a
            // bare T as a non-primitive struct.
            if type.is_type_variable then
                return true
            fi

            if !type.is_value_type then
                return true
            fi

            // a value-type T? is a Nullable[T] struct
            if type.is_optional then
                return false
            fi

            let symbol = type.symbol

            return symbol.is_built_in_type \/ isa Semantic.Symbols.ENUM_STRUCT(symbol)
        si
    si
si
