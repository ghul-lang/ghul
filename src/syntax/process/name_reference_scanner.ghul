namespace Syntax.Process is

    // Scans a nested named function's body for a reference to the
    // function's own name, so declare-members can tell whether the
    // literal recurses before it builds the closure - the closure's
    // recursion is fixed at construction, and a delegate is only
    // available to one that does not recurse.
    //
    // Nested literals are walked rather than skipped: a lambda written
    // inside the function can call it, and that reference is served the
    // same way.
    //
    // The test is the written name, so a reference the name is shadowed
    // at reports a recursion that is not one. The cost of that is a
    // frame the closure did not need, never a wrong answer, and scoping
    // is not resolved yet at the point the question is asked.
    class NAME_REFERENCE_SCANNER: Visitor is
        _name: string
        _found: bool

        init() is
            super.init()

            _name = ""
        si

        body_references(body: Trees.Bodies.Body?, name: string) -> bool is
            _name = name
            _found = false

            if body? then
                body.walk(self)
            fi

            return _found
        si

        // Whether any part of a definition refers to the name: a method body,
        // a field initializer, an argument default.
        node_references(node: Trees.Node, name: string) -> bool is
            _name = name
            _found = false

            node.walk(self)

            return _found
        si

        pre(identifier: Trees.Expressions.IDENTIFIER) -> bool is
            if identifier.identifier.name =~ _name then
                _found = true
            fi

            return false
        si
    si
si
