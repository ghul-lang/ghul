namespace Syntax.Process is
    use Logging
    use Trees
    use Source

    // Registers an innate for each intrinsic the compilation declares in
    // source, so the assembly that provides the intrinsics can be built by
    // a compiler that otherwise reflects them.
    //
    // The declaration itself stays where it is written and is emitted
    // normally — that emitted method, carrying its INTRINSIC_ATTRIBUTE, is
    // what every other compilation reflects. What it cannot do is serve
    // this compilation: a call has to lower to an opcode, and that is a
    // property of the symbol's class, not a flag. So a matching innate is
    // registered in `Ghul`, where the language looks for it.
    //
    // Runs once signatures are resolved, because the innate takes its own
    // from the declaration.
    class REGISTER_SOURCE_INTRINSICS: ScopedVisitor is
        _namespaces: Semantic.NAMESPACES

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES
        )
        is
            super.init(logger, symbol_table, namespaces)

            _namespaces = namespaces
        si

        apply(root: Trees.Node) is
            root.walk(self)
        si

        visit(function: Definitions.FUNCTION) is
            super.visit(function)

            let symbol = symbol_for(function)

            if !symbol? \/ !isa Semantic.Symbols.Function(symbol) then
                return
            fi

            let declaration = cast Semantic.Symbols.Function(symbol)

            if !declaration.intrinsic_operation? \/ declaration.is_innate then
                return
            fi

            // A constructor intrinsic stays an ordinary method, offered as a
            // constructor only to the assemblies that reflect it.
            if declaration.intrinsic_operation.starts_with("constructor.") then
                return
            fi

            let operation = declaration.intrinsic_operation

            let intrinsic: Semantic.Symbols.Function mut

            // An operator a type declares for itself goes onto the type of
            // its first operand, as its reflected counterpart does.
            if let home = _operator_home(declaration) then
                intrinsic = Semantic.Symbols.INNATE_FUNCTION(
                    declaration.location,
                    home,
                    declaration.name,
                    home,
                    operation
                )

                home.declare_function_group(declaration.location, intrinsic, null)
            else
                let target = _namespaces.try_find_namespace(".Ghul.Intrinsics")

                if !target? then
                    return
                fi

                intrinsic =
                    cast Semantic.Symbols.Function?(
                        target.declare_innate(
                            declaration.location,
                            declaration.name,
                            operation,
                            target,
                            null
                        )
                    )!
            fi

            intrinsic.arguments = declaration.arguments
            intrinsic.argument_names = declaration.argument_names
            intrinsic.return_type = declaration.return_type

            // An operator's other operand types reach it too.
            if let home = _operator_home(declaration) then
                for other in Semantic.Symbols.TYPE_HOMED_OPERATORS.homes(declaration) do
                    if other != home then
                        other.declare_function_group(declaration.location, intrinsic, null)
                    fi
                od
            fi

            if declaration.is_generic then
                intrinsic.is_generic = true
                intrinsic.generic_arguments = declaration.generic_arguments
                intrinsic.generic_argument_names = declaration.generic_argument_names
                intrinsic.generic_argument_constraint_kinds = declaration.generic_argument_constraint_kinds
                intrinsic.generic_argument_has_constructor_constraint = declaration.generic_argument_has_constructor_constraint
            fi
        si

        _operator_home(declaration: Semantic.Symbols.Function) -> Semantic.Symbols.Classy? is
            if !Semantic.Symbols.TYPE_HOMED_OPERATORS.contains(declaration.name) \/ declaration.arguments.count == 0 then
                return null
            fi

            if let first: Semantic.Types.NAMED = declaration.arguments[0] then
                return cast Semantic.Symbols.Classy?(first.symbol)
            fi

            return null
        si
    si
si
