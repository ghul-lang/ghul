namespace Syntax.Process is
    use Logging
    use Trees
    use Source

    // Registers an innate for each intrinsic the compilation declares in
    // source, so the assembly that provides the intrinsics can be built by
    // a compiler that otherwise reflects them.
    //
    // The declaration itself stays where it is written and is emitted
    // normally — that emitted method, carrying its INTRINSIC_ATTRIBUTE, is
    // what every other compilation reflects. What it cannot do is serve
    // this compilation: a call has to lower to an opcode, and that is a
    // property of the symbol's class, not a flag. So a matching innate is
    // registered in `Ghul`, where the language looks for it.
    //
    // Runs once signatures are resolved, because the innate takes its own
    // from the declaration.
    class REGISTER_SOURCE_INTRINSICS: ScopedVisitor is
        _namespaces: Semantic.NAMESPACES
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        )
        is
            super.init(logger, symbol_table, namespaces)

            _namespaces = namespaces
            _innate_symbol_lookup = innate_symbol_lookup
        si

        _offers_constructors: bool

        // Registers the intrinsics `root` declares. Where `offers_constructors`
        // is set, each constructor intrinsic is also offered as a constructor
        // of the type it returns.
        apply(root: Trees.Node, offers_constructors: bool) is
            _offers_constructors = offers_constructors

            root.walk(self)
        si

        visit(function: Definitions.FUNCTION) is
            super.visit(function)

            let symbol = symbol_for(function)

            if !symbol? \/ !isa Semantic.Symbols.Function(symbol) then
                return
            fi

            let declaration = cast Semantic.Symbols.Function(symbol)

            // A scalar type orders by an opcode, so an operator expression
            // reaches the intrinsic rather than a `<>` member the type
            // declares for its `Comparable` implementation, as it does for the
            // member reflected from a .NET scalar.
            if declaration.name =~ "<>" /\ _orders_by_opcode(declaration.owner) then
                declaration.is_hidden_from_operator_resolution = true
            fi

            if !declaration.intrinsic_operation? \/ declaration.is_innate then
                return
            fi

            // A constructor intrinsic stays an ordinary method. It is offered
            // as a constructor to the assemblies that reflect it, and, from a
            // source library, to the program compiled with it.
            if declaration.intrinsic_operation.starts_with("constructor.") then
                if _offers_constructors then
                    _offer_as_constructor(declaration)
                fi

                return
            fi

            let operation = declaration.intrinsic_operation

            let intrinsic: Semantic.Symbols.Function mut

            // An operator a type declares for itself goes onto the type of
            // its first operand, as its reflected counterpart does. One
            // declared as a member of that type is already there, and a copy
            // beside it would make every use ambiguous between the two.
            if let home = _operator_home(declaration) /\ declaration.owner == home then
                intrinsic = declaration
            elif let home = _operator_home(declaration) then
                intrinsic = Semantic.Symbols.INNATE_FUNCTION(
                    declaration.location,
                    home,
                    declaration.name,
                    home,
                    operation
                )

                home.declare_function_group(declaration.location, intrinsic, null)
            else
                let target = _namespaces.try_find_namespace(".Ghul.Intrinsics")

                if !target? then
                    return
                fi

                intrinsic =
                    cast Semantic.Symbols.Function?(
                        target.declare_innate(
                            declaration.location,
                            declaration.name,
                            operation,
                            target,
                            null
                        )
                    )!
            fi

            intrinsic.arguments = declaration.arguments
            intrinsic.argument_names = declaration.argument_names
            intrinsic.return_type = declaration.return_type

            if declaration.is_declared_pure then
                intrinsic.mark_declared_pure()
            fi

            // An operator's other operand types reach it too.
            if let home = _operator_home(declaration) then
                for other in Semantic.Symbols.TYPE_HOMED_OPERATORS.homes(declaration) do
                    if other != home then
                        other.declare_function_group(declaration.location, intrinsic, null)
                    fi
                od
            fi

            if declaration.is_generic then
                intrinsic.is_generic = true
                intrinsic.generic_arguments = declaration.generic_arguments
                intrinsic.generic_argument_names = declaration.generic_argument_names
                intrinsic.generic_argument_constraint_kinds = declaration.generic_argument_constraint_kinds
                intrinsic.generic_argument_has_constructor_constraint = declaration.generic_argument_has_constructor_constraint
            fi
        si

        // Adds an `init` to the class `target` returns that calls `target`, as
        // the reflected path does for a constructor intrinsic. Where `target`
        // returns a generic instance, the class is the generic definition and
        // the `init` belongs to it, so the target's type parameters must be
        // the class's own, in order, as in `from_pairs[K, V]() -> MAP[K, V]`;
        // a target that returns its parameters in any other shape is left as
        // a method.
        _offer_as_constructor(target: Semantic.Symbols.Function) is
            if let generic: Semantic.Types.GENERIC = target.return_type then
                _offer_as_generic_constructor(target, generic)
                return
            fi

            let owner = cast Semantic.Symbols.Classy?(cast Semantic.Types.NAMED?(target.return_type)?.symbol)

            if !owner? \/ owner.is_generic then
                return
            fi

            _add_constructor(target, owner, target.arguments)
        si

        // The `init` is phrased in the class's own type parameters, so the
        // arguments are the target's with its type parameters replaced by
        // the class's. A call constructing the class specialises the target
        // by the constructed type's arguments.
        _offer_as_generic_constructor(target: Semantic.Symbols.Function, returned: Semantic.Types.GENERIC) is
            let owner = cast Semantic.Symbols.GENERIC?(returned.symbol)?.symbol

            if !owner? \/ !target.is_generic \/ target.generic_arguments.count != returned.arguments.count then
                return
            fi

            let parameters = Collections.LIST[Semantic.Types.Type]()

            for i in 0..returned.arguments.count do
                let returned_parameter = cast Semantic.Symbols.GenericArgument?(cast Semantic.Types.NAMED?(returned.arguments[i])?.symbol)
                let target_parameter = cast Semantic.Symbols.GenericArgument?(cast Semantic.Types.NAMED?(target.generic_arguments[i])?.symbol)
                let owner_parameter = owner.type_parameter_at(i)?.type

                if !returned_parameter? \/ returned_parameter != target_parameter \/ !owner_parameter? then
                    return
                fi

                parameters.add(owner_parameter)
            od

            let phrased = cast Semantic.Symbols.Function(target.specialize(parameters))

            _add_constructor(target, owner, phrased.arguments)
        si

        _add_constructor(target: Semantic.Symbols.Function, owner: Semantic.Symbols.Classy, arguments: Collections.List[Semantic.Types.Type]) is
            let result = Semantic.Symbols.INSTANCE_METHOD(target.location, target.location, owner, "init", owner)

            result.arguments = arguments
            result.argument_names = target.argument_names
            result.return_type = _innate_symbol_lookup.get_void_type()
            result.constructor_target = target

            if target.is_declared_pure then
                result.mark_declared_pure()
            fi

            if target.is_generic /\ !owner.is_generic then
                result.is_generic = true
                result.generic_arguments = target.generic_arguments
                result.generic_argument_names = target.generic_argument_names
            fi

            result.mark_synthesized()

            owner.add_member(result)
        si

        _orders_by_opcode(owner: Semantic.Scope?) -> bool is
            if let classy = cast Semantic.Symbols.Classy?(owner) then
                if let built_in = classy.built_in_type then
                    return built_in != Semantic.Symbols.BuiltInType.VOID /\ built_in != Semantic.Symbols.BuiltInType.BOOL
                fi

                return classy == _innate_symbol_lookup.get_decimal_type().symbol
            fi

            return false
        si

        _operator_home(declaration: Semantic.Symbols.Function) -> Semantic.Symbols.Classy? is
            if !Semantic.Symbols.TYPE_HOMED_OPERATORS.contains(declaration.name) \/ declaration.arguments.count == 0 then
                return null
            fi

            if let first: Semantic.Types.NAMED = declaration.arguments[0] then
                return cast Semantic.Symbols.Classy?(first.symbol)
            fi

            return null
        si
    si
si
