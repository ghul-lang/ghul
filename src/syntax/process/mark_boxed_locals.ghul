namespace Syntax.Process is
    use IO.Std

    use Logging

    use Semantic.Symbols.LOCAL_VARIABLE

    // Pre-`compile-expressions` analysis pass: walks the AST,
    // resolves every IDENTIFIER reference and ASSIGNMENT LHS,
    // marks each `LOCAL_VARIABLE` it sees as captured (if
    // referenced from inside an enclosing function — i.e. from
    // a closure body) and/or reassigned (if it appears on the
    // LHS of an assignment). At end of apply, sweeps the set of
    // touched locals and sets `is_boxed = is_captured /\
    // is_reassigned`, so that subsequent `symbol_loader`-driven
    // IR emission switches to `Ghul.BOX[T]`-backed storage.
    //
    // The capture and reassignment marking runs on every build:
    // flow narrowing forms no facts on a local a closure body can
    // rewrite, and that question has to be answered the same way
    // in the editor as in a batch build. Deriving `is_boxed` from
    // those flags is IL-bound, because boxing is a code-generation
    // strategy and assignability of a captured local is keyed on
    // its mut marker alone.
    class MARK_BOXED_LOCALS: ScopedVisitor is
        _logger: Logger
        _touched: Collections.SET[LOCAL_VARIABLE]

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES
        )
        is
            super.init(logger, symbol_table, namespaces)

            _logger = logger
            _touched = Collections.SET[LOCAL_VARIABLE]()
        si

        apply(root: Trees.Node, want_boxing: bool) is
            begin_marking()

            root.walk(self)

            end_marking(want_boxing)
        si

        // The marking split from `apply` so the incremental analysis
        // paths, which drive a pass over an edited subtree rather than
        // calling its `apply`, can bracket their own walk with it.
        begin_marking() is
            _touched.clear()

            _box_holds_field = Semantic.BOX_STORAGE.runtime_box_holds_field()
        si

        // Whether the runtime's box holds its value in a field. Only then
        // can a write in place - through a `ref`, by a mutating method of
        // a struct the local holds, or to a member of it - reach a box
        // the closure shares, so only then do those writes count as
        // reassignments. A box with a property gives such a write a copy
        // either way.
        _box_holds_field: bool

        end_marking(want_boxing: bool) is
            // Sweep: a local is boxed iff (a) it was declared
            // with the `mut` modifier, (b) it's captured from
            // inside an enclosing closure body, and (c) it's
            // assigned anywhere. Plain captured immutable
            // locals stay value-captured (and any rogue
            // assignment hits the captured-assignment diagnostic
            // upstream). Plain mutable-but-not-captured locals
            // stay on the stack.
            if want_boxing then
                for local in _touched do
                    if local.is_in_nested_function_group /\ local.is_captured then
                        local.is_boxed = true
                    fi
                od
            fi

            if want_boxing then
                for local in _touched do
                    if
                        local.is_mutable_marked /\
                        local.is_captured /\
                        local.is_reassigned
                    then
                        local.is_boxed = true
                    fi
                od
            fi

            _touched.clear()
        si

        // A statement list's nested functions that are created ahead of
        // their statements are marked, so a captured one gets a cell.
        pre(list: Trees.Statements.LIST) -> bool is
            let result = super.pre(list)

            for member in NESTED_FUNCTION_GROUP.of(list).members do
                for name in member.variable.names do
                    if let local: LOCAL_VARIABLE = try_find(name) then
                        local.is_in_nested_function_group = true
                        _touched.add(local)
                    fi
                od
            od

            return result
        si

        // Identifier-as-expression reference. If it resolves to
        // a LOCAL_VARIABLE owned by a function outside our
        // current function context, this is a capture.
        visit(identifier: Trees.Expressions.IDENTIFIER) is

            let symbol = try_find(identifier.identifier)

            if !symbol? \/ !isa LOCAL_VARIABLE(symbol) then
                return
            fi

            let local = cast LOCAL_VARIABLE(symbol)
            let function = current_function

            if !function? then
                return
            fi

            _touched.add(local)

            if local.owner != function then
                local.is_captured = true
            fi
        si

        // A `ref` to a local, or to a member reached from one, lets the
        // callee write the local in place, so it is a reassignment for
        // the purposes of capture: a captured local written only through
        // a `ref` must share one cell with its closures as one assigned
        // directly does.
        visit(reference: Trees.Expressions.REFERENCE) is
            if _box_holds_field then
                _note_root_reassigned(reference.left)
            fi
        si

        // A method called on a local, or on a member reached from one, can
        // write it in place when it holds a struct.
        visit(call: Trees.Expressions.CALL) is
            if _box_holds_field then
                if let member: Trees.Expressions.MEMBER = call.function then
                    _note_root_reassigned(member.left)
                fi
            fi
        si

        _note_root_reassigned(path: Trees.Expressions.Expression) is
            let root mut = path

            while let member: Trees.Expressions.MEMBER = root do
                root = member.left
            od

            if let identifier: Trees.Expressions.IDENTIFIER = root then
                _note_written_in_place(identifier)
            fi
        si

        // A write that changes the value a local holds without assigning
        // the local itself: through a `ref`, by a method of a struct it
        // holds, or to a member of it. Only a mutable local can share a box
        // with its closures, so only one counts, and it counts as a write
        // from the closure where one makes it. An immutable local is
        // captured by value and never boxed, so a closure calling a method
        // of it does not end flow narrowing of it.
        _note_written_in_place(target: Trees.Expressions.IDENTIFIER) is
            let symbol = try_find(target.identifier)

            if !symbol? \/ !isa LOCAL_VARIABLE(symbol) then
                return
            fi

            let local = cast LOCAL_VARIABLE(symbol)

            if local.is_mutable_marked then
                _note_reassigned(target)
            fi
        si

        // Reassignment of a local: LHS resolves to a
        // LOCAL_VARIABLE. Field assignments (`obj.field = v`)
        // and the like get filtered by the LOCAL_VARIABLE cast.
        visit(assignment: Trees.Statements.ASSIGNMENT) is
            let targets = Collections.LIST[Trees.Expressions.Expression]()
            assignment.left.get_names_into(targets)

            for target in targets do
                if let identifier: Trees.Expressions.IDENTIFIER = target then
                    _note_reassigned(identifier)
                elif let member: Trees.Expressions.MEMBER = target /\ _box_holds_field then
                    _note_root_reassigned(member.left)
                fi
            od
        si

        _note_reassigned(target: Trees.Expressions.IDENTIFIER) is
            let symbol = try_find(target.identifier)

            if !symbol? \/ !isa LOCAL_VARIABLE(symbol) then
                return
            fi

            _touched.add(symbol)
            symbol.is_reassigned = true

            // The write sits inside a function literal that did not
            // declare the local, so it writes the enclosing scope's
            // variable rather than one of its own. Asking for the
            // enclosing closure rather than the enclosing function keeps
            // a property accessor body - whose scope shape differs from
            // the one the local was declared into - out of the question.
            let closure = current_closure

            if closure? /\ symbol.owner != closure then
                symbol.is_closure_assigned = true
            fi
        si
    si
si
