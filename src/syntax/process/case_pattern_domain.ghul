namespace Syntax.Process is
    use Source
    use Semantic.Types.Type
    use Semantic.Symbols.Classy
    use Semantic.Symbols.ENUM_STRUCT_MEMBER

    enum ConstructorKind is
        // Absence, the extra alternative an optional type carries.
        NULL,
        FALSE,
        TRUE,
        // A union variant, a subclass of a closed root, or the
        // constructible root itself.
        CLASSY,
        ENUM_MEMBER,
        // The single, irrefutable alternative of a type that
        // destructures — a tuple, or anything else with a positional
        // shape.
        PRODUCT,
        // A literal drawn from a domain too large to enumerate. Never
        // completes a domain, and never equal to any other.
        OPAQUE,
        // The empty sequence, `[]`.
        NIL,
        // A sequence with a first element: that element and the sequence
        // that follows it, `[x, ..xs]`.
        CONS,
    si

    // One alternative a value of some domain can take.
    //
    // Identity is the object, never the name — two constructors are
    // the same alternative when they are the same instance. A domain
    // builds its alternatives once and every pattern that selects one
    // refers back to that instance, so `==` answers correctly and
    // nothing is keyed on rendered text. `name` exists only to
    // describe a missing case in a diagnostic.
    class PATTERN_CONSTRUCTOR is
        kind: ConstructorKind public
        name: string public

        // The type a sub-pattern of this alternative is matched
        // against, when the alternative carries fields. Null for a
        // leaf alternative.
        alternative_type: Type? public

        // Set for CLASSY, and compared unspecialized, so an arm
        // ascribing a constructed `Result.OK[int, string]` selects
        // the same alternative the union declared.
        classy: Classy? public

        // Set for ENUM_MEMBER. The member's own symbol is the key; a
        // literal arm is resolved to it once, by value, at the point
        // the pattern is built.
        enum_member: ENUM_STRUCT_MEMBER? public

        _classifier: CASE_DOMAIN_CLASSIFIER?
        _field_domains: PATTERN_DOMAIN?[]?

        // The session view the constructor's alternative was selected
        // under: a nested destructure classifies its fields against the
        // same cell's view rather than the whole session.
        _site: Source.LOCATION?

        // An alternative whose fields are described by a type the
        // classifier will read when, and only when, a pattern
        // descends into them.
        init(
            kind: ConstructorKind,
            name: string,
            alternative_type: Type?,
            classifier: CASE_DOMAIN_CLASSIFIER
        ) is
            super.init()

            self.kind = kind
            self.name = name
            self.alternative_type = alternative_type
            self._classifier = classifier
        si

        set_site(site: Source.LOCATION?) is
            self._site = site
        si

        // An alternative whose field domains are already known.
        init(kind: ConstructorKind, name: string, field_domains: PATTERN_DOMAIN?[]) is
            super.init()

            self.kind = kind
            self.name = name
            self._field_domains = field_domains
        si

        set_classy(classy: Classy) is
            self.classy = classy
        si

        set_enum_member(member: ENUM_STRUCT_MEMBER) is
            self.enum_member = member
        si

        // The domain of each field, read on first use. Deferred
        // because a type reaches itself through its own fields
        // whenever it is recursive, and the walk only ever descends
        // as far as a written pattern goes.
        field_domains: PATTERN_DOMAIN?[] is
            if let known = _field_domains then
                return known
            fi

            let computed =
                if kind == ConstructorKind.CONS then
                    _classifier!.sequence_field_domains(alternative_type!, _site)
                else
                    _classifier!.field_domains_of(alternative_type, _site)
                fi

            _field_domains = computed

            return computed
        si

        arity: int => field_domains.count
    si

    // The finite set of alternatives a value of a type can take. A
    // type whose values cannot be enumerated this way — `int`,
    // `string`, an open class hierarchy — has no domain, and the
    // classifier answers null for it.
    class PATTERN_DOMAIN(constructors: PATTERN_CONSTRUCTOR[]) is
        // Set when the alternatives are enum members, so a literal
        // arm can be checked against the scrutinee's own enum before
        // its value is matched to a member.
        enum_root: Classy? public

        super()

        set_enum_root(root: Classy) is
            self.enum_root = root
        si
    si

    // Classifies a type into the alternatives its values can take.
    //
    // The order alternatives are produced in is the order a
    // diagnostic lists them: absence first, then `false` before
    // `true`, then a constructible root before its subclasses, then
    // variants and enum members in declaration order.
    class CASE_DOMAIN_CLASSIFIER is
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup

        // Set by `_classify_core` for the classification in progress
        // and consumed by `classify` before it returns; an enum
        // domain carries its root so a literal arm can be checked
        // against the scrutinee's own enum.
        _enum_root: Classy?

        init(innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup) is
            super.init()

            _innate_symbol_lookup = innate_symbol_lookup
        si

        classify(type: Type?, site: Source.LOCATION?) -> PATTERN_DOMAIN? is
            if !type? \/ !type.is_settled then
                return null
            fi

            let is_optional = type.is_optional
            let core = if is_optional then type.as_non_optional() else type fi

            _enum_root = null

            let core_constructors = _classify_core(core, site)
            let enum_root = _enum_root

            if !core_constructors? then
                return null
            fi

            if !is_optional then
                return _domain(core_constructors, enum_root)
            fi

            let constructors = Collections.LIST[PATTERN_CONSTRUCTOR]()

            constructors.add(PATTERN_CONSTRUCTOR(ConstructorKind.NULL, "null", null, self))

            for c in core_constructors do
                constructors.add(c)
            od

            return _domain(constructors, enum_root)
        si

        _domain(
            constructors: PATTERN_CONSTRUCTOR[],
            enum_root: Classy?
        ) -> PATTERN_DOMAIN static is
            let domain = PATTERN_DOMAIN(constructors)

            if let root = enum_root then
                domain.set_enum_root(root)
            fi

            return domain
        si

        _classify_core(core: Type, site: Source.LOCATION?) -> PATTERN_CONSTRUCTOR[]? is
            if core.matches(_innate_symbol_lookup.get_bool_type()) then
                let constructors = Collections.LIST[PATTERN_CONSTRUCTOR]()

                constructors.add(PATTERN_CONSTRUCTOR(ConstructorKind.FALSE, "false", null, self))
                constructors.add(PATTERN_CONSTRUCTOR(ConstructorKind.TRUE, "true", null, self))

                return constructors
            fi

            if let one_of = cast Semantic.Types.ONE_OF?(core) then
                // A narrowed receiver lists the exact runtime types it
                // can hold, so the root is an alternative only when it
                // appears among them.
                if !(cast Classy?(one_of.underlying_type.unspecialized_symbol))? then
                    return null
                fi

                let constructors = Collections.LIST[PATTERN_CONSTRUCTOR]()

                for subtype in one_of.subtypes do
                    constructors.add(_classy_constructor(subtype, site))
                od

                return constructors
            fi

            if _sequence_element_type(core)? then
                return _sequence_constructors(core)
            fi

            let root = _try_get_classy(core)

            if !root? then
                return _product_constructors(core)
            fi

            if root.is_closed_root then
                let alternatives = Collections.LIST[Classy]()

                // A session compiles each cell against the cells before
                // it, so an alternative a later cell declares is outside
                // this case's domain: covering what the site's cell saw
                // is exhaustive, and the throw a session emits carries
                // an alternative added later.
                for alternative in root.closed_alternatives do
                    if !site? \/ Semantic.Symbols.SESSION_VIEW.is_visible(alternative, site) then
                        alternatives.add(alternative)
                    fi
                od

                if alternatives.count == 0 then
                    return _product_constructors(core)
                fi

                let constructors = Collections.LIST[PATTERN_CONSTRUCTOR]()

                // A concrete root is constructible in its own right,
                // so covering every subclass leaves bare root
                // instances unaccounted for.
                if root.is_class /\ !root.is_abstract then
                    let root_constructor = PATTERN_CONSTRUCTOR(ConstructorKind.CLASSY, root.name, core, self)

                    root_constructor.set_classy(root)

                    constructors.add(root_constructor)
                fi

                for alternative in alternatives do
                    constructors.add(_classy_constructor(alternative, site))
                od

                return constructors
            fi

            if root.symbol_kind == Semantic.Symbols.SymbolKind.ENUM then
                let constructors = Collections.LIST[PATTERN_CONSTRUCTOR]()

                for symbol in root.symbols do
                    if let member: ENUM_STRUCT_MEMBER = symbol then
                        let constructor = PATTERN_CONSTRUCTOR(ConstructorKind.ENUM_MEMBER, member.name, null, self)

                        constructor.set_enum_member(member)

                        constructors.add(constructor)
                    fi
                od

                if constructors.count > 0 then
                    _enum_root = root

                    return constructors
                fi
            fi

            return _product_constructors(core)
        si

        // The element type of an array, a list, or a lazy sequence (an
        // `Iterable[T]` that is neither - a string is one, matching its
        // chars), and null for anything else.
        _sequence_element_type(type: Type) -> Type? is
            if let array: Semantic.Types.ARRAY = type then
                return array.arguments[0]
            fi

            let list = _innate_symbol_lookup.find_unspecialized_list_type()

            if list? then
                let element = Semantic.Symbols.TYPE_ARGUMENT_EXTRACTOR.extract(type, list)

                if element? then
                    return element
                fi
            fi

            let iterable = _innate_symbol_lookup.find_unspecialized_iterable_type()

            if !iterable? then
                return null
            fi

            return Semantic.Symbols.TYPE_ARGUMENT_EXTRACTOR.extract(type, iterable)
        si

        // A sequence is the empty one or a first element followed by a
        // sequence, which is how a pattern over it is checked: `[a, b]` is
        // a first element, then another, then the empty sequence.
        _sequence_constructors(core: Type) -> PATTERN_CONSTRUCTOR[] is
            let constructors = Collections.LIST[PATTERN_CONSTRUCTOR]()

            constructors.add(PATTERN_CONSTRUCTOR(ConstructorKind.NIL, "[]", Collections.LIST[PATTERN_DOMAIN?]()))
            constructors.add(PATTERN_CONSTRUCTOR(ConstructorKind.CONS, "[_, ..]", core, self))

            return constructors
        si

        // The domains of a sequence's first element and of the sequence
        // after it. Read only as far as a written pattern goes, since the
        // second is the sequence's own domain again.
        sequence_field_domains(type: Type, site: Source.LOCATION?) -> PATTERN_DOMAIN?[] is
            let result = Collections.LIST[PATTERN_DOMAIN?]()
            let element_type = _sequence_element_type(type)

            result.add(if element_type? then classify(element_type, site) else null fi)
            result.add(classify(type, site))

            return result
        si

        // A type that is not a sum of alternatives can still be a
        // product of them, when it destructures. The single
        // constructor is irrefutable, so such a domain is covered
        // exactly when its fields are.
        _product_constructors(core: Type) -> PATTERN_CONSTRUCTOR[]? is
            if !_destructure_element_types(core)? then
                return null
            fi

            let constructors = Collections.LIST[PATTERN_CONSTRUCTOR]()

            constructors.add(PATTERN_CONSTRUCTOR(ConstructorKind.PRODUCT, core.short_description, core, self))

            return constructors
        si

        _classy_constructor(alternative: Classy, site: Source.LOCATION?) -> PATTERN_CONSTRUCTOR is
            let constructor = PATTERN_CONSTRUCTOR(ConstructorKind.CLASSY, alternative.name, alternative.type, self)

            constructor.set_classy(alternative)
            constructor.set_site(site)

            return constructor
        si

        field_domains_of(type: Type?, site: Source.LOCATION?) -> PATTERN_DOMAIN?[] is
            let result = Collections.LIST[PATTERN_DOMAIN?]()

            if !type? then
                return result
            fi

            let element_types = _destructure_element_types(type)

            if !element_types? then
                return result
            fi

            for element_type in element_types do
                result.add(classify(element_type, site))
            od

            return result
        si

        // The types a positional destructure of `type` binds, in
        // order, or null when the type does not destructure. Resolved
        // through DESTRUCTURE_RESOLVER, so the shape the checker
        // reasons about is the shape the language matches.
        _destructure_element_types(type: Type) -> Type[]? is
            let arity = _destructure_arity(type)

            if arity <= 0 then
                return null
            fi

            let strategy = DESTRUCTURE_RESOLVER.resolve_strategy(type, arity)

            let result = Collections.LIST[Type]()

            if let deconstruct = strategy.deconstruct_function then
                // A `deconstruct` writes each element through a `T
                // ref` parameter, so the element's own type is the
                // one the reference points at.
                for argument in deconstruct.arguments do
                    let element_type = _pointee(argument.type)

                    if !element_type? then
                        return null
                    fi

                    result.add(element_type)
                od

                return result
            fi

            for member in strategy.members do
                if !member? \/ !member.type? then
                    return null
                fi

                result.add(member.type!)
            od

            return result
        si

        _pointee(type: Type?) -> Type? static is
            if !type? then
                return null
            fi

            if let reference = cast Semantic.Types.REFERENCE?(type) then
                if reference.arguments.count == 1 then
                    return reference.arguments[0]
                fi

                return null
            fi

            return type
        si

        _destructure_arity(type: Type) -> int is
            if type.is_value_tuple then
                return type.arguments.count
            fi

            let positional = DESTRUCTURE_RESOLVER.positional_member_count(type)

            if positional > 0 then
                return positional
            fi

            return _deconstruct_arity(type)
        si

        // The arity of the type's `deconstruct`, when exactly one
        // viable overload exists. Several viable arities leave the
        // shape ambiguous, and the type is treated as not
        // destructurable rather than one of them being picked.
        _deconstruct_arity(type: Type) -> int is
            let member = type.find_member("deconstruct")

            if !member? then
                return 0
            fi

            let candidates = Collections.LIST[Semantic.Symbols.Function]()

            if let group: Semantic.Symbols.FUNCTION_GROUP = member then
                for f in group.functions do
                    candidates.add(f)
                od
            elif let function: Semantic.Symbols.Function = member then
                candidates.add(function)
            fi

            let arity mut = 0

            for candidate in candidates do
                if !candidate.are_arguments_declared then
                    continue
                fi

                let candidate_arity = candidate.arguments.count

                if !DESTRUCTURE_RESOLVER.is_viable_deconstruct(candidate, candidate_arity) then
                    continue
                fi

                if arity > 0 /\ arity != candidate_arity then
                    return 0
                fi

                arity = candidate_arity
            od

            return arity
        si

        _try_get_classy(type: Type) -> Classy? is
            if let named = cast Semantic.Types.NAMED?(type) then
                return cast Classy?(named.symbol.unspecialized_symbol)
            fi

            return null
        si
    si
si
