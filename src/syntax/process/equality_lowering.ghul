namespace Syntax.Process is
    // How `a =~ b` compares two present operands, decided from their
    // static types alone.
    //
    // One decision serves every place an equality is built - the
    // operator written in source, the null-safe wrapper around it, a
    // `case` label, and each member of a synthesized `=~` - so that a
    // value compares the same way wherever the comparison is spelled.
    //
    // Nothing compares two of these, so what the synthesized `=~`
    // would make of a field whose type declares none does not arise.
    @suppress("synthesized-equality-fallback")
    union EqualityLowering is
        // An operator that answers equality directly: a `=~` the type
        // declares or inherits, the innate one a scalar, string or enum
        // carries, or a global one taking both operands.
        OPERATOR(function: Semantic.Symbols.Function)

        // A `<>` the type declares, read as equality against zero. A
        // type that defines an ordering has defined equality with it.
        ORDER(function: Semantic.Symbols.Function)

        // A type that cannot declare an operator - a tuple, or a bare
        // type parameter - compared through `EqualityComparer[T]`, or,
        // where the comparer type is absent, as each instantiation's type
        // argument compares.
        COMPARER(comparer_type: Semantic.Types.Type?)

        // An array or list, compared by count and then element by
        // element, each element by its own lowering. The element type
        // is settled here at the same time, so nesting recurses as far
        // as the static type does and no further.
        SEQUENCE(element_type: Semantic.Types.Type, element: EqualityLowering)

        // A class declaring neither operator, compared by reference.
        IDENTITY
    si
si
