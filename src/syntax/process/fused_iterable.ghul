namespace Syntax.Process is
    // What a generated generator runs: a fused pipe chain whose value no
    // consumption site reads, read from the generator's own parameters.
    // Its MoveNext drives the chain's source and yields each element that
    // comes through the stages, which are inlined into it.
    class FUSED_ITERABLE is
        // The chain, with its source's iterator surface resolved and its
        // stages inlined into the generator.
        fusion: PIPE_FUSION

        // The parameter the source is passed in.
        source: Semantic.Symbols.Variable

        // The frame field the source's iterator lives in.
        iterator_field: Semantic.Symbols.Field

        // By stage position, the frame fields each stage keeps what it
        // carries in, and the parameter a carried value is passed as.
        stages: Collections.LIST[FUSED_STAGE_FIELDS]

        init(
            fusion: PIPE_FUSION,
            source: Semantic.Symbols.Variable,
            iterator_field: Semantic.Symbols.Field,
            stages: Collections.LIST[FUSED_STAGE_FIELDS]
        ) is
            self.fusion = fusion
            self.source = source
            self.iterator_field = iterator_field
            self.stages = stages
        si
    si
si
