@@IF.not.dotnet()

// The part of System.IO.Abstractions' file system that EXPAND_NAMESPACES
// reads, for a build of the compiler with no .NET library to supply it:
// the real file system, through the core library's IO.
namespace Syntax.Process is
    use IO.Path
    use IO.File
    use IO.Directory

    class SOURCE_CORE_FILE_SYSTEM is
        path: SOURCE_CORE_PATH_ACCESS => SOURCE_CORE_PATH_ACCESS()
        directory: SOURCE_CORE_DIRECTORY_ACCESS => SOURCE_CORE_DIRECTORY_ACCESS()
        directory_info: SOURCE_CORE_DIRECTORY_INFO_FACTORY => SOURCE_CORE_DIRECTORY_INFO_FACTORY()
        file: SOURCE_CORE_FILE_ACCESS => SOURCE_CORE_FILE_ACCESS()

        init() is si
    si

    class SOURCE_CORE_PATH_ACCESS is
        init() is si

        get_path_root(path: string) -> string? =>
            if path.starts_with('/') then "/" else "" fi

        get_file_name_without_extension(path: string) -> string? => Path.get_file_name_without_extension(path)

        get_directory_name(path: string) -> string? => Path.get_directory_name(path)

        combine(first: string, second: string) -> string => Path.combine(first, second)
    si

    class SOURCE_CORE_DIRECTORY_ACCESS is
        init() is si

        get_current_directory() -> string => Directory.get_current_directory()

        get_files(path: string, pattern: string) -> ARRAY[string] => Directory.get_files(path, pattern)
    si

    class SOURCE_CORE_FILE_ACCESS is
        init() is si

        exists(path: string) -> bool => File.exists(path)
    si

    class SOURCE_CORE_DIRECTORY_INFO_FACTORY is
        init() is si

        `new(path: string) -> SOURCE_CORE_DIRECTORY_INFO => SOURCE_CORE_DIRECTORY_INFO(Path.get_full_path(path))
    si

    class SOURCE_CORE_DIRECTORY_INFO is
        full_name: string

        init(full_name: string) is
            self.full_name = full_name
        si

        name: string => Path.get_file_name(full_name) ?? ""

        parent: SOURCE_CORE_DIRECTORY_INFO? is
            if let directory = Path.get_directory_name(full_name) then
                return SOURCE_CORE_DIRECTORY_INFO(directory)
            fi

            return null
        si
    si
si
