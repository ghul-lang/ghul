namespace Syntax.Process is
    use IO.Std

    use Logging

    class RESOLVE_ANCESTORS: ScopedVisitor is
        _logger: Logger
        _symbol_table: Semantic.SYMBOL_TABLE
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        )
        is
            super.init(logger, symbol_table, namespaces)

            _logger = logger
            _symbol_table = symbol_table
            _innate_symbol_lookup = innate_symbol_lookup
        si

        apply(root: Trees.Node) is
            // The constructed built-ins take ancestry from what the
            // compilation declares - the array family from a declared
            // Collections.List - and the declarations exist by the time
            // this pass runs.
            _innate_symbol_lookup.wire_declared_ancestry()

            root.walk(self)
        si

        pre(`class: Trees.Definitions.CLASS) -> bool => true

        visit(`class: Trees.Definitions.CLASS) is
            let class_symbol = cast Semantic.Symbols.CLASS?(scope_for(`class))!

            let seen_class_ancestor mut = false
            let is_first mut = true

            if `class.ancestors? then
                for a in `class.ancestors do
                    let ancestor_type = a.type

                    if !a.is_poisoned /\ ancestor_type? then
                        if ancestor_type.is_inheritable then
                            if ancestor_type.is_class then
                                if seen_class_ancestor then
                                    _logger.error(a.location, "multiple superclasses")
                                elif !is_first then
                                    _logger.error(a.location, "superclass must be first")
                                fi

                                _check_extension_of_closed_imported(a, ancestor_type, "extend")

                                seen_class_ancestor = true
                            else
                                _check_extension_of_closed_imported(a, ancestor_type, "implement")
                            fi

                            a.check_is_not_void(_logger, "cannot use void type here")

                            class_symbol.add_ancestor(ancestor_type)

                            is_first = false
                        else
                            _logger.error(a.location, "cannot inherit from this")
                        fi
                    fi
                od
            fi

            if !seen_class_ancestor then
                let object_type = _innate_symbol_lookup.get_object_type()

                if class_symbol != object_type.symbol then
                    class_symbol.push_ancestor(_innate_symbol_lookup.get_object_type())
                fi
            fi
        si

        // A class or trait carrying the CLOSED_ATTRIBUTE marker is closed
        // to the assembly it was declared in. Extending an imported one
        // from here would break the closure its own assembly relies on -
        // for a class, the enumerability of its subclass set that
        // narrowing rests on; for a trait, the author's decision not to
        // hand out an extension point.
        _check_extension_of_closed_imported(
            ancestor_node: Trees.TypeExpressions.TypeExpression,
            ancestor_type: Semantic.Types.Type?,
            verb: string
        ) is
            if !ancestor_type? then
                return
            fi

            let ancestor_symbol = ancestor_type.symbol

            if !isa Semantic.Symbols.Classy(ancestor_symbol) then
                return
            fi

            let ancestor_classy = cast Semantic.Symbols.Classy(ancestor_symbol)

            if !ancestor_classy.is_reflected then
                return
            fi

            if ancestor_classy.is_open then
                return
            fi

            // An earlier cell of this session is the same program as
            // far as the user is concerned: they wrote it a moment ago
            // and are extending it now. Closure is what makes a
            // session's exhaustive case and else-edge narrowing work at
            // all, so the two are reconciled by letting a later cell
            // through rather than by leaving every hierarchy open. What
            // that costs an earlier cell's compiled code is paid for by
            // the guards a submission build emits.
            if IoC.CONTAINER.instance.assemblies.is_session_cell_named(ancestor_classy.il_assembly_name) then
                return
            fi

            let kind = if ancestor_classy.is_trait then "trait" else "class" fi

            _logger.error(
                ancestor_node.location,
                "cannot {verb} closed {kind} {ancestor_classy.name} from outside its assembly"
            )
        si

        // An `impl <Interface> for <Target>` block attaches the interface to
        // the target's own symbol - this node's scope is an injection scope
        // standing in for the target, which class_or_trait_for unwraps. The
        // target then implements the interface exactly as a header-declared
        // one would; the members filling its slots are declared as the
        // target's own.
        pre(`impl: Trees.Definitions.IMPL) -> bool => true

        visit(`impl: Trees.Definitions.IMPL) is
            let target_symbol = class_or_trait_for(`impl)

            if !target_symbol? then
                return
            fi

            if `impl.ancestors? then
                for a in `impl.ancestors do
                    let ancestor_type = a.type

                    if ancestor_type?.is_error ?? false then
                        continue
                    fi

                    if ancestor_type? then
                        if isa Semantic.Types.NAMED(ancestor_type) then
                            let ancestor_named_type = ancestor_type

                            if ancestor_named_type.symbol.is_trait then
                                _check_extension_of_closed_imported(a, ancestor_named_type, "implement")

                                target_symbol.add_ancestor(ancestor_named_type)

                                a.check_is_not_void(_logger, "cannot use void type here")

                                continue
                            fi
                        fi

                        _logger.error(a.location, "impl can only implement a trait")
                    fi
                od
            fi
        si

        pre(`trait: Trees.Definitions.TRAIT) -> bool => true

        visit(`trait: Trees.Definitions.TRAIT) is
            let trait_symbol = cast Semantic.Symbols.TRAIT?(scope_for(`trait))!

            let seen_valid_ancestor mut = false

            if `trait.ancestors? then
                for a in `trait.ancestors do
                    let ancestor_type = a.type

                    if ancestor_type?.is_error ?? false then
                        continue
                    fi

                    if ancestor_type? then
                        if isa Semantic.Types.NAMED(ancestor_type) then
                            let ancestor_named_type = ancestor_type

                            if ancestor_named_type.symbol.is_trait then
                                _check_extension_of_closed_imported(a, ancestor_named_type, "extend")

                                trait_symbol.add_ancestor(ancestor_named_type)
                                seen_valid_ancestor = true

                                a.check_is_not_void(_logger, "cannot use void type here")
                            else
                                _logger.error(a.location, "trait cannot inherit from class")
                            fi
                        else
                            _logger.error(a.location, "cannot inherit from this")
                        fi
                    else
                        Std.error.write_line("refusing to add ancestor with null type {a} to trait {trait_symbol}")
                    fi
                od
            fi

            let object_type = _innate_symbol_lookup.get_object_type()

            trait_symbol.push_ancestor(object_type)
        si

        pre(`struct: Trees.Definitions.STRUCT) -> bool => true

        visit(`struct: Trees.Definitions.STRUCT) is
            let struct_symbol = cast Semantic.Symbols.STRUCT?(scope_for(`struct))!

            if `struct.ancestors? then
                for a in `struct.ancestors do
                    let ancestor_type = a.type

                    if ancestor_type?.is_error ?? false then
                        continue
                    fi

                    if ancestor_type? then
                        if isa Semantic.Types.NAMED(ancestor_type) then
                            let ancestor_named_type = ancestor_type

                            if ancestor_named_type.symbol.is_trait then
                                _check_extension_of_closed_imported(a, ancestor_named_type, "implement")

                                struct_symbol.add_ancestor(ancestor_named_type)

                                a.check_is_not_void(_logger, "cannot use void type here")

                                continue
                            fi
                        fi

                        _logger.error(a.location, "structs can only inherit from traits")
                    fi
                od
            fi

            struct_symbol.push_ancestor(_innate_symbol_lookup.get_value_type())
        si

        pre(`union: Trees.Definitions.UNION) -> bool => super.pre(`union)

        visit(`union: Trees.Definitions.UNION) is
            let union_symbol = cast Semantic.Symbols.UNION?(scope_for(`union))!

            if `union.ancestors? then
                for a in `union.ancestors do
                    let ancestor_type = a.type

                    if ancestor_type?.is_error ?? false then
                        continue
                    fi

                    if ancestor_type? then
                        if isa Semantic.Types.NAMED(ancestor_type) then
                            let ancestor_named_type = ancestor_type

                            if ancestor_named_type.symbol.is_trait then
                                _check_extension_of_closed_imported(a, ancestor_named_type, "implement")

                                union_symbol.add_ancestor(ancestor_named_type)

                                a.check_is_not_void(_logger, "cannot use void type here")

                                continue
                            fi
                        fi

                        _logger.error(a.location, "unions can only inherit from traits")
                    fi
                od
            fi

            union_symbol.push_ancestor(_innate_symbol_lookup.get_object_type())

            super.visit(`union)
        si

        pre(`variant: Trees.Definitions.VARIANT) -> bool => true

        visit(`variant: Trees.Definitions.VARIANT) is
            let variant_symbol = cast Semantic.Symbols.VARIANT?(scope_for(`variant))!
            // a variant is always resolved inside its union's scope
            let union_symbol = current_union_context!
            let arguments = Collections.LIST[Semantic.Types.Type]()

            let union_type =
                if let union_symbol.argument_names? /\ argument_names.count > 0 then
                    for argument_name in argument_names do
                        let argument_symbol = variant_symbol.find_direct(argument_name)
                        let argument_symbol_type = if argument_symbol? then argument_symbol.type else null fi

                        if argument_symbol_type? then
                            arguments.add(argument_symbol_type)
                        else
                            arguments.add(Semantic.Types.ERROR())
                        fi
                    od

                    Semantic.Types.GENERIC(
                        Source.LOCATION.internal,
                        union_symbol,
                        arguments)
                else
                    Semantic.Types.NAMED(
                        union_symbol)
                fi

            variant_symbol.push_ancestor(union_type)
        si

        pre(`enum: Trees.Definitions.ENUM) -> bool => true

        visit(`enum: Trees.Definitions.ENUM) is
            let enum_symbol = cast Semantic.Symbols.ENUM_STRUCT?(scope_for(`enum))!

            let enum_type = _innate_symbol_lookup.get_enum_type()

            if !enum_type.is_error then
                enum_symbol.push_ancestor(enum_type)
            fi
        si
    si
si
