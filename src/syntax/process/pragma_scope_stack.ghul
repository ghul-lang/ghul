namespace Syntax.Process is
    use Trees

    // Tracks the `INTRINSIC_ATTRIBUTE` pragma scopes a tree walk is
    // currently nested inside: `enter` on the way in, `leave` on the way
    // out. Several passes need to know whether the node being walked sits
    // inside such a scope, so each visitor delegates here rather than
    // reimplementing the enter / leave bookkeeping.
    class PRAGMA_SCOPE_STACK is
        _intrinsic_operations: Collections.LIST[string]

        // The operation named by the innermost enclosing
        // `INTRINSIC_ATTRIBUTE`, or null outside one.
        intrinsic_operation: string? =>
            if _intrinsic_operations.count > 0 then
                _intrinsic_operations[_intrinsic_operations.count - 1]
            else
                null
            fi

        is_balanced: bool => _intrinsic_operations.count == 0

        init() is
            _intrinsic_operations = Collections.LIST[string]()
        si

        enter(pragma: Pragmas.PRAGMA) is
            _adjust(pragma, 1)
        si

        leave(pragma: Pragmas.PRAGMA) is
            _adjust(pragma, -1)
        si

        _adjust(pragma: Pragmas.PRAGMA, delta: int) is
            let name = pragma.name.to_string()

            // Both spellings mark the same operation: `intrinsic` is the
            // compiler's pragma, and `INTRINSIC_ATTRIBUTE` is the runtime's
            // attribute, reached in source through a `use` alias until the
            // runtime moves to the pragma.
            if name =~ "INTRINSIC_ATTRIBUTE" \/ name =~ "intrinsic" then
                if let operation = pragma.try_get_string_literal_at(0) then
                    if delta > 0 then
                        _intrinsic_operations.add(operation)
                    else
                        _intrinsic_operations.remove_at(_intrinsic_operations.count - 1)
                    fi
                fi
            fi
        si
    si
si
