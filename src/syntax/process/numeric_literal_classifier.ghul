namespace Syntax.Process is
    use Logging
    use Source.LOCATION

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.Types.Type

    use IR.Values

    // Classify a parsed integer literal: pick the target type from
    // any trailing type-suffix (`b`/`s`/`i`/`l`/`w`/`c`, optionally
    // prefixed by `u` for unsigned or `s` for sign-without-width),
    // strip the suffix from the value string, and range-check the
    // result against the chosen type. The lexer accepts arbitrarily
    // long digit strings and any suffix combination; this is where
    // suffix → type and value → fits-in-type get decided.
    //
    // Bounds errors and "character literals cannot be unsigned"
    // structural errors are logged via the constructor-supplied
    // logger. Callers receive a non-null `Literal.NUMBER` on success
    // and null on either kind of failure.
    //
    // The `fits` / `parse_hex` / `max_unsigned_for` helpers are
    // exposed for unit testing in isolation from the suffix path.
    class NUMERIC_LITERAL_CLASSIFIER is
        _logger: Logger
        _innate_symbol_lookup: InnateSymbolLookup

        init(logger: Logger, innate_symbol_lookup: InnateSymbolLookup) is
            super.init()

            _logger = logger
            _innate_symbol_lookup = innate_symbol_lookup
        si

        // How many trailing characters of an integer literal are its
        // type suffix.
        //
        // The digits are scanned maximally in the literal's own radix,
        // and the suffix is whatever is left. That is what keeps `b`
        // and `c` - hex digits as well as size selectors - reading as
        // digits in a hex literal, so `0x20AC` is 8364 rather than
        // 0x20A as a char. A backtick attaches a suffix that would
        // otherwise be read as a digit, and is counted as part of the
        // suffix so that stripping it yields the value.
        //
        // Every reader of a given token has to resolve this the same
        // way, so it is the one place the rule lives.
        suffix_length(value_string: string) -> int static is
            if value_string.length == 0 then
                return 0
            fi

            let tick = value_string.index_of('`')

            if tick >= 0 then
                return value_string.length - tick
            fi

            // A sign belongs to the value rather than to either end of
            // it, and a caller may hand the text over with one still
            // attached.
            let signed = value_string[0] == '-' \/ value_string[0] == '+'
            let start = if signed then 1 else 0 fi

            let is_hex =
                value_string.length > start + 1 /\
                value_string[start] == '0' /\
                (value_string[start + 1] == 'x' \/ value_string[start + 1] == 'X')

            let first_digit = if is_hex then start + 2 else start fi
            let index mut = first_digit

            while index < value_string.length /\ is_digit(value_string[index], is_hex) do
                index = index + 1
            od

            return value_string.length - index
        si

        // Whether `c` is a digit of the literal's radix. `_` never
        // reaches here - the lexer drops digit-group separators before
        // the token text is built.
        is_digit(c: char, is_hex: bool) -> bool static =>
            (c >= '0' /\ c <= '9') \/
            (is_hex /\ ((c >= 'a' /\ c <= 'f') \/ (c >= 'A' /\ c <= 'F')))

        // The literal with its type suffix removed, which is the value
        // it denotes and the string every back end should read.
        strip_suffix(value_string: string) -> string static =>
            value_string.substring(0, value_string.length - suffix_length(value_string))

        // The value an integer literal denotes. Every scalar suffix
        // yields a `Literal.NUMBER`; `n` yields a `Literal.BIGINT`,
        // which has no constant to load and is built at run time.
        classify(location: LOCATION, value_string: string) -> Value? =>
            if is_bigint(value_string) then
                classify_bigint(location, value_string)
            else
                classify_integer(location, value_string)
            fi

        // Whether the literal carries the `n` suffix. The size selector
        // is always the last character of the suffix, so this is the
        // whole of the test.
        is_bigint(value_string: string) -> bool static is
            if suffix_length(value_string) == 0 then
                return false
            fi

            let last = value_string[value_string.length - 1]

            return last == 'n' \/ last == 'N'
        si

        // The selectors of a suffixed literal, with any attaching
        // backtick dropped - it marks the boundary and says nothing
        // about the type. Empty when the backtick had nothing after it,
        // which the lexer has already reported.
        selectors(value_string: string) -> string static is
            let cutoff = value_string.length - suffix_length(value_string)

            if value_string[cutoff] == '`' then
                return value_string.substring(cutoff + 1, value_string.length - cutoff - 1)
            fi

            return value_string.substring(cutoff, value_string.length - cutoff)
        si

        classify_bigint(location: LOCATION, value_string: string) -> Literal.BIGINT? is
            let selected = selectors(value_string)

            if selected.length == 0 then
                return null
            fi

            if "uU".contains(selected[0]) then
                _logger.error(location, "bigint literal cannot be unsigned")
                return null
            fi

            let working = strip_suffix(value_string)

            let (ok, digits) = decimal_magnitude(working)

            if !ok then
                _logger.error(location, "invalid bigint literal {working}")
                return null
            fi

            let as_long: long mut = 0l
            let fits_long = fits_in_long(digits) /\ long.try_parse(digits, as_long ref)

            return Literal.BIGINT(digits, _innate_symbol_lookup.get_bigint_type(), as_long, fits_long)
        si

        // Largest magnitude a `long` holds, as the digit string
        // `fits_in_long` compares against.
        LONG_MAX_DIGITS: string static => "9223372036854775807"

        // A bigint literal has no width to overflow, so its magnitude is
        // carried as digits rather than range-checked. `long` is only
        // the shorter of the two ways to build one at run time, so
        // whether the value fits is a question about which instructions
        // to emit rather than about whether the literal is legal.
        fits_in_long(digits: string) -> bool =>
            digits.length < LONG_MAX_DIGITS.length \/
            (digits.length == LONG_MAX_DIGITS.length /\ string.compare_ordinal(digits, LONG_MAX_DIGITS) <= 0)

        // The literal's magnitude in decimal digits, with no leading
        // zeros. A decimal literal already is that, once its zeros are
        // dropped; a hex one is accumulated a digit at a time, because
        // the value has no bound to parse it into.
        decimal_magnitude(value_string: string) -> (ok: bool, digits: string) is
            let is_hex = value_string.starts_with("0x") \/ value_string.starts_with("0X")
            let source = if is_hex then value_string.substring(2, value_string.length - 2) else value_string fi

            if source.length == 0 then
                return (false, "0")
            fi

            // Least significant first, one decimal digit each, so a
            // carry appends rather than shifting the whole number.
            let accumulator = Collections.LIST[int]([0])
            let radix = if is_hex then 16 else 10 fi

            for c in source do
                let digit: int mut

                if c >= '0' /\ c <= '9' then
                    digit = cast int(c) - cast int('0')
                elif is_hex /\ c >= 'a' /\ c <= 'f' then
                    digit = cast int(c) - cast int('a') + 10
                elif is_hex /\ c >= 'A' /\ c <= 'F' then
                    digit = cast int(c) - cast int('A') + 10
                else
                    return (false, "0")
                fi

                let carry mut = digit

                for i in 0..accumulator.count do
                    let product = accumulator[i] * radix + carry
                    accumulator[i] = product % 10
                    carry = product / 10
                od

                while carry > 0 do
                    accumulator.add(carry % 10)
                    carry = carry / 10
                od
            od

            let buffer = System.Text.StringBuilder(accumulator.count)
            let top mut = accumulator.count - 1

            while top > 0 /\ accumulator[top] == 0 do
                top = top - 1
            od

            for i in 0::top do
                buffer.append(cast char(cast int('0') + accumulator[top - i]))
            od

            return (true, buffer.to_string())
        si

        classify_integer(location: LOCATION, value_string: string) -> Literal.NUMBER? is
            let type: Type? mut = null
            let is_wide mut = false
            let narrowing: IR.Scalar? mut = null
            let working mut = value_string

            let suffix = suffix_length(working)

            if suffix > 0 then
                let cutoff = working.length - suffix

                // The selectors themselves, with any attaching backtick
                // dropped - it marks the boundary and says nothing about
                // the type.
                let selectors =
                    if working[cutoff] == '`' then
                        working.substring(cutoff + 1, suffix - 1)
                    else
                        working.substring(cutoff, suffix)
                    fi

                // A backtick with nothing after it. The lexer has already
                // reported it; failing quietly here keeps it to one
                // diagnostic.
                if selectors.length == 0 then
                    return null
                fi

                let last_char = selectors[selectors.length - 1]
                let is_unsigned = "uU".contains(selectors[0])

                case last_char
                when 'b', 'B' then
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_ubyte_type()
                    else
                        type = _innate_symbol_lookup.get_byte_type()
                    fi

                when 'c', 'C' then
                    if is_unsigned then
                        _logger.error(location, "numeric character literal cannot be unsigned")
                    else
                        type = _innate_symbol_lookup.get_char_type()
                    fi

                when 's', 'S' then
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_ushort_type()
                    else
                        type = _innate_symbol_lookup.get_short_type()
                    fi

                when 'i', 'I' then
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_uint_type()
                    else
                        type = _innate_symbol_lookup.get_int_type()
                    fi

                when 'l', 'L' then
                    is_wide = true

                    if is_unsigned then
                        type = _innate_symbol_lookup.get_ulong_type()
                    else
                        type = _innate_symbol_lookup.get_long_type()
                    fi

                when 'w', 'W' then
                    is_wide = true

                    if is_unsigned then
                        type = _innate_symbol_lookup.get_uword_type()
                        narrowing = IR.Scalar.UINT_NATIVE
                    else
                        type = _innate_symbol_lookup.get_word_type()
                        narrowing = IR.Scalar.INT_NATIVE
                    fi

                else
                    if is_unsigned then
                        type = _innate_symbol_lookup.get_uint_type()
                    else
                        type = _innate_symbol_lookup.get_int_type()
                    fi
                esac

                working = working.substring(0, cutoff)
            else
                type = _innate_symbol_lookup.get_int_type()
            fi

            if !type? then
                return null
            fi

            let (ok, parsed) = parse_magnitude(working)

            if !ok \/ !fits(location, working, type) then
                return null
            fi

            let constant =
                if is_wide then
                    Literal.CONSTANT.I8(cast long(parsed))
                else
                    Literal.CONSTANT.I4(cast int(cast uint(parsed)))
                fi

            return Literal.NUMBER(constant, type, narrowing)
        si

        // The magnitude a literal denotes, whatever radix it is written
        // in. Both the range check and the constant the literal loads
        // need it, so it is read once here rather than each reading the
        // spelling for itself.
        parse_magnitude(value_string: string) -> (ok: bool, value: ulong) =>
            if value_string.starts_with("0x") \/ value_string.starts_with("0X") then
                parse_hex(value_string.substring(2, value_string.length - 2))
            else
                (
                    let v: ulong mut = _
                    let parsed_ok = ulong.try_parse(value_string, v ref)
                    (parsed_ok, v)
                )
            fi

        // Range-check a parsed integer literal against its target
        // type. Comparing as a ulong using each type's unsigned max
        // preserves the standard "literal fits in N unsigned bits,
        // unary minus negates separately" convention. Without this,
        // oversize literals reach IL emission, where the constant no
        // longer fits the instruction it is loaded by (issue #580).
        fits(location: LOCATION, value_string: string, type: Type) -> bool is
            let (ok, parsed) = parse_magnitude(value_string)

            if !ok then
                _logger.error(location, "numeric literal {value_string} does not fit in {type}")
                return false
            fi

            let max_value = max_unsigned_for(type)

            if max_value > 0UL /\ parsed > max_value then
                _logger.error(location, "numeric literal {value_string} does not fit in {type}")
                return false
            fi

            return true
        si

        // Parse a hex digit string (no `0x` prefix) into a ulong.
        // Returns (false, 0) for empty, > 16 digits, or any non-hex
        // character.
        parse_hex(s: string) -> (ok: bool, value: ulong) is
            if s.length == 0 \/ s.length > 16 then
                return (false, 0UL)
            fi

            let value: ulong mut = 0UL

            for c in s do
                let digit: int mut

                if c >= '0' /\ c <= '9' then
                    digit = cast int(c) - cast int('0')
                elif c >= 'a' /\ c <= 'f' then
                    digit = cast int(c) - cast int('a') + 10
                elif c >= 'A' /\ c <= 'F' then
                    digit = cast int(c) - cast int('A') + 10
                else
                    return (false, 0UL)
                fi

                value = (value << 4) + cast ulong(digit)
            od

            return (true, value)
        si

        // Largest non-negative literal value the type accepts, or 0
        // to signal "no narrower bound than the ulong-parse range"
        // (used for ulong / uword: ulong.try_parse already enforces
        // the 64-bit ceiling). 0 makes `fits` skip the narrower-
        // bound check.
        max_unsigned_for(type: Type) -> ulong is
            if type.matches(_innate_symbol_lookup.get_byte_type()) then
                return 127UL
            elif type.matches(_innate_symbol_lookup.get_ubyte_type()) then
                return 255UL
            elif type.matches(_innate_symbol_lookup.get_short_type()) then
                return 32767UL
            elif type.matches(_innate_symbol_lookup.get_ushort_type()) then
                return 65535UL
            elif type.matches(_innate_symbol_lookup.get_char_type()) then
                return 65535UL
            elif type.matches(_innate_symbol_lookup.get_int_type()) then
                return 2147483647UL
            elif type.matches(_innate_symbol_lookup.get_uint_type()) then
                return 4294967295UL
            elif type.matches(_innate_symbol_lookup.get_long_type()) then
                return 9223372036854775807UL
            elif type.matches(_innate_symbol_lookup.get_word_type()) then
                return 9223372036854775807UL
            fi

            return 0UL
        si
    si
si
