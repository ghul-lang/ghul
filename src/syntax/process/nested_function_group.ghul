namespace Syntax.Process is
    use Trees

    // The nested functions of one statement list that have to exist before
    // their own statements run, and where in the list they are created.
    //
    // A nested function that nothing in the list refers to before its own
    // definition is left alone: an ordinary local, defined at its statement.
    // One that an earlier statement or an earlier nested function refers to
    // is in the group, and so is one that names a local the list declares
    // after it, and every nested function a group member refers to, since
    // the member can be called before that one's statement runs.
    // Each member is held in a cell, and every cell exists from the first
    // member's creation, so a member reaches the others whenever they are
    // created. A member is created at the start of the list, or just after
    // the last `let` in the list that declares a name it uses, since it
    // captures those locals when it is created.
    //
    // References are matched by name, as the written identifier, before
    // scopes are resolved. A name a function declares itself, as a
    // parameter, a local or a literal's parameter, is not taken as a use of
    // a later local with the same spelling. Any other shadowing name can
    // put a function in the group that did not need to be there, which
    // costs a cell.
    class NESTED_FUNCTION_GROUP is
        members: Collections.MutableList[Statements.FUNCTION]

        // Where each member is created: before the statement with that index,
        // or after the last statement where it is the list's length.
        _positions: Collections.Map[Statements.FUNCTION, int]

        // A statement that calls a nested function before every member it
        // reaches has been created after the locals that member captures.
        too_early: (statement: Statements.Statement, member: Statements.FUNCTION)?

        is_empty: bool => members.count == 0

        init(members: Collections.MutableList[Statements.FUNCTION], positions: Collections.Map[Statements.FUNCTION, int], too_early: (Statements.Statement, Statements.FUNCTION)?) is
            self.members = members
            _positions = positions
            self.too_early = too_early
        si

        // The list's statements in the order they are compiled and emitted,
        // with each member moved to where it is created.
        order(list: Statements.LIST) -> Collections.List[Statements.Statement] is
            let result = Collections.LIST[Statements.Statement]()

            if is_empty then
                result.add_range(list.statements)

                return result
            fi

            let count = list.statements |> Ghul.Pipes.count()

            for (index, statement) in list.statements |> Ghul.Pipes.index() do
                for member in members do
                    if _positions[member] == index then
                        result.add(member)
                    fi
                od

                if !contains(statement) then
                    result.add(statement)
                fi
            od

            for member in members do
                if _positions[member] >= count then
                    result.add(member)
                fi
            od

            return result
        si

        contains(statement: Statements.Statement) -> bool =>
            if let function: Statements.FUNCTION = statement then members.contains(function) else false fi

        of(list: Statements.LIST) -> NESTED_FUNCTION_GROUP static is
            if let cached = list.list_state.nested_function_group then
                return cached
            fi

            let result = _build(list)

            list.list_state.nested_function_group = result

            return result
        si

        _build(list: Statements.LIST) -> NESTED_FUNCTION_GROUP static is
            let statements = Collections.LIST[Statements.Statement](list.statements)
            let functions = Collections.LIST[Statements.FUNCTION]()

            for statement in statements do
                if let function: Statements.FUNCTION = statement then
                    functions.add(function)
                fi
            od

            let members = Collections.LIST[Statements.FUNCTION]()

            if functions.count == 0 then
                return NESTED_FUNCTION_GROUP(members, Collections.MAP[Statements.FUNCTION, int](), null)
            fi

            let scanner = NAME_REFERENCE_SCANNER()
            let declared = DECLARED_NAME_SCANNER()

            uses_outer(function: Statements.FUNCTION, name: string) -> bool =>
                scanner.body_references(function.function.body, name) /\ !declared.declares(function.function, name)

            // Names a local the list declares after the function's own
            // statement, so it can only be created once that local exists. A
            // name the function declares itself is its own, not that local.
            for (index, statement) in statements |> Ghul.Pipes.index() do
                if let `let: Statements.LET = statement then
                    for variable in `let.variables do
                        for name in variable.names do
                            for function in functions do
                                if
                                    statements.index_of(function) < index /\
                                    !members.contains(function) /\
                                    uses_outer(function, name.name)
                                then
                                    members.add(function)
                                fi
                            od
                        od
                    od
                fi
            od

            // Referred to before its own statement.
            for (index, statement) in statements |> Ghul.Pipes.index() do
                for function in functions do
                    let defined_at = statements.index_of(function)

                    if
                        defined_at > index /\
                        !members.contains(function) /\
                        _references(scanner, statement, function.name.name)
                    then
                        members.add(function)
                    fi
                od
            od

            if members.count == 0 then
                return NESTED_FUNCTION_GROUP(members, Collections.MAP[Statements.FUNCTION, int](), null)
            fi

            // And whatever a member refers to, which it can call before that
            // one's own statement has run.
            let changed mut = true

            while changed do
                changed = false

                for member in Collections.LIST[Statements.FUNCTION](members) do
                    for function in functions do
                        if
                            !members.contains(function) /\
                            scanner.body_references(member.function.body, function.name.name)
                        then
                            members.add(function)
                            changed = true
                        fi
                    od
                od
            od

            let ordered = Collections.LIST[Statements.FUNCTION]()

            for function in functions do
                if members.contains(function) then
                    ordered.add(function)
                fi
            od

            let positions = Collections.MAP[Statements.FUNCTION, int]()

            for member in ordered do
                positions[member] = 0
            od

            for (index, statement) in statements |> Ghul.Pipes.index() do
                if let `let: Statements.LET = statement then
                    for variable in `let.variables do
                        for name in variable.names do
                            for member in ordered do
                                if uses_outer(member, name.name) then
                                    positions[member] = index + 1
                                fi
                            od
                        od
                    od
                fi
            od

            // A call to a nested function reaches every member it calls, directly
            // or through other nested functions, so it is safe only once the
            // last of them has been created.
            ready_at(start: Statements.FUNCTION) -> int is
                let seen = Collections.SET[Statements.FUNCTION]()
                let pending = Collections.LIST[Statements.FUNCTION]([start])
                let latest mut = 0

                while pending.count > 0 do
                    let next = pending[pending.count - 1]
                    pending.remove_at(pending.count - 1)

                    if seen.add(next) then
                        if positions.contains_key(next) then
                            latest = Ghul.Math.max(latest, positions[next])
                        fi

                        for other in functions do
                            if scanner.body_references(next.function.body, other.name.name) then
                                pending.add(other)
                            fi
                        od
                    fi
                od

                latest
            si

            let too_early: (Statements.Statement, Statements.FUNCTION)? mut = null

            for (index, statement) in statements |> Ghul.Pipes.index() do
                if too_early? then
                    break
                fi

                // A definition only refers to the functions it names; it calls
                // them when it is itself called.
                if isa Statements.FUNCTION(statement) then
                    continue
                fi

                for candidate in functions do
                    if index < ready_at(candidate) /\ _references(scanner, statement, candidate.name.name) then
                        too_early = (statement, candidate)
                        break
                    fi
                od
            od

            // In the order they are created, so the first member is the first
            // one emitted and the cells exist before any member is created.
            let by_position = Collections.LIST[Statements.FUNCTION]()

            for position in 0::statements.count do
                for member in ordered do
                    if positions[member] == position then
                        by_position.add(member)
                    fi
                od
            od

            return NESTED_FUNCTION_GROUP(by_position, positions, too_early)
        si

        _references(scanner: NAME_REFERENCE_SCANNER, statement: Statements.Statement, name: string) -> bool static =>
            if let function: Statements.FUNCTION = statement then
                scanner.body_references(function.function.body, name)
            else
                scanner.node_references(statement, name)
            fi
    si
si
