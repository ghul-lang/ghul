namespace Syntax.Process is
    use IO.Std

    use Logging

    use Semantic.Symbols.Symbol
    use Semantic.Types.Type
    use Semantic.Types.NAMED

    use Ghul.Pipes

    class RESOLVE_TYPE_EXPRESSIONS: ScopedVisitor is
        _logger: Logger
        _symbol_table: Semantic.SYMBOL_TABLE
        _symbol_use_locations: Semantic.SYMBOL_USE_LOCATIONS
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        _alias_clauses: Collections.MAP[Semantic.Symbols.TYPE_ALIAS, Trees.Definitions.USE]

        // The type expression a `typeof` is applied to, while the walk is
        // inside it. `FOO[_]` names an open generic, which is a thing only
        // reflection can hold, so it is accepted there and nowhere else.
        _typeof_type_expression: Trees.TypeExpressions.TypeExpression?

        // How many names have been reported as a generic short of its
        // type arguments. Read across a speculative walk to tell a name
        // that is not a type from one that is an incomplete type.
        _incomplete_generic_names: int

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            symbol_use_locations: Semantic.SYMBOL_USE_LOCATIONS,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        )
        is
            super.init(logger, symbol_table, namespaces)

            _logger = logger
            _symbol_table = symbol_table
            _symbol_use_locations = symbol_use_locations
            _innate_symbol_lookup = innate_symbol_lookup
            _alias_clauses = Collections.MAP[Semantic.Symbols.TYPE_ALIAS, Trees.Definitions.USE]()
        si

        apply(root: Trees.Node) is
            _alias_clauses.clear()

            root.walk(self)
        si

        // An AsyncMethodBuilder attribute on a source-declared type makes
        // it a task-like: the builder async functions returning it drive.
        // Recorded here, rather than by the attribute resolver, because
        // the builder has to be knowable before any file.s compile-
        // expressions walk starts - a task-like used from a file the
        // walk reaches earlier than its own declaration. The typeof
        // argument.s type expression resolves on the walk into the
        // pragma, before this visit fires. Full attribute resolution
        // still runs later; this records the one fact the async
        // lowering needs.
        visit(pragma: Trees.Definitions.PRAGMA) is
            _maybe_record_async_builder(pragma)
            _maybe_register_enum_bitwise_operators(pragma)
        si

        _maybe_record_async_builder(pragma: Trees.Definitions.PRAGMA) is
            let written = pragma.pragma.name.to_string()
            let leaf = written.substring(written.last_index_of('.') + 1)

            if leaf !~ "AsyncMethodBuilder" then
                return
            fi

            let definition: Trees.Definitions.Definition mut = pragma.definition

            while isa Trees.Definitions.PRAGMA(definition) do
                definition = cast Trees.Definitions.PRAGMA(definition).definition
            od

            if !isa Trees.Definitions.Classy(definition) then
                return
            fi

            let classy = cast Semantic.Symbols.Classy?(symbol_for(definition))

            if !classy? \/ classy.async_builder? then
                return
            fi

            if pragma.pragma.arguments.expressions.count != 1 then
                return
            fi

            if let `typeof: Trees.Expressions.TYPEOF = pragma.pragma.arguments.expressions[0] then
                if let builder = `typeof.type_expression.type then
                    classy.async_builder = builder
                fi
            fi
        si

        // An enum carrying `System.FlagsAttribute` gets the bitwise
        // operators `&`, `|`, `^` and `\`, in addition to the `<>`/`=~`
        // every enum gets unconditionally (registered at declare-symbols,
        // in Semantic.Symbols.NAMESPACE.declare_enum). Gated the same
        // way an enum without it should not compile `DayOfWeek.MONDAY &
        // DayOfWeek.TUESDAY` — a combination its ordinal values were
        // never meant to answer. Matched by pragma leaf name rather than
        // by resolving the attribute type, for the same reason
        // _maybe_record_async_builder is: the operators must exist
        // before any file's compile-expressions walk reaches a use of
        // them, which can be earlier than this pragma's own attribute
        // resolution runs.
        _maybe_register_enum_bitwise_operators(pragma: Trees.Definitions.PRAGMA) is
            let written = pragma.pragma.name.to_string()
            let leaf = written.substring(written.last_index_of('.') + 1)

            if leaf !~ "Flags" /\ leaf !~ "FlagsAttribute" then
                return
            fi

            let definition: Trees.Definitions.Definition mut = pragma.definition

            while isa Trees.Definitions.PRAGMA(definition) do
                definition = cast Trees.Definitions.PRAGMA(definition).definition
            od

            if !isa Trees.Definitions.ENUM(definition) then
                return
            fi

            let classy = cast Semantic.Symbols.Classy?(symbol_for(definition))

            if !classy? then
                return
            fi

            Semantic.Symbols.ENUM_AND_OPERATOR.register(classy)
            Semantic.Symbols.ENUM_OR_OPERATOR.register(classy)
            Semantic.Symbols.ENUM_XOR_OPERATOR.register(classy)
            Semantic.Symbols.ENUM_NOT_OPERATOR.register(classy)
        si

        // The default walk doesn't descend into a function's
        // generic_arguments, so the bound on `[T: SomeType]` would never
        // have its type expression resolved — leaving the type-parameter
        // symbol's ancestor unset and the bound check silently skipped
        // at instantiation. Visit them explicitly here so the bound is
        // resolved before RESOLVE_EXPLICIT_TYPES copies it onto the
        // type-parameter symbol.
        pre(function: Trees.Definitions.FUNCTION) -> bool is
            super.pre(function)
            function.generic_arguments.walk(self)
            return false
        si

        // Registers the block's type alias clauses so that one named
        // before its own clause is reached can be resolved on demand.
        pre(`namespace: Trees.Definitions.NAMESPACE) -> bool is
            let result = super.pre(`namespace)

            for u in `namespace.body.uses do
                if let u.alias_symbol? then
                    _alias_clauses[alias_symbol] = u
                fi
            od

            return result
        si

        // A type alias is resolved when the walk reaches its clause, or
        // earlier if something names it first, so its type parameters are
        // brought into scope here rather than by the ordinary walk.
        pre(u: Trees.Definitions.USE) -> bool is
            if u.is_alias then
                _resolve_alias(u)
            fi

            return true
        si

        _resolve_alias(u: Trees.Definitions.USE) is
            if let alias = u.alias_symbol, target = u.target then
                _resolve_alias_target(alias, target)
            fi
        si

        _resolve_alias_target(
            alias: Semantic.Symbols.TYPE_ALIAS,
            target: Trees.TypeExpressions.TypeExpression
        ) is
            if alias.target_type? then
                return
            fi

            if alias.is_resolving then
                _logger.error(target.location, "type alias {alias.name} is defined in terms of itself")

                alias.set_target_type(Semantic.Types.ERROR())

                return
            fi

            alias.is_resolving = true

            try
                enter_scope(alias)

                try
                    target.walk(self)
                finally
                    leave_scope(alias)
                yrt
            finally
                alias.is_resolving = false
            yrt

            alias.set_target_type(target.type ?? Semantic.Types.ERROR())
        si

        // Expands a name that resolved to a type alias. Returns the type
        // the alias stands for, with a generic alias's own parameters
        // substituted by the supplied arguments.
        _expand_alias(
            location: Source.LOCATION,
            name: Trees.Identifiers.Identifier,
            alias: Semantic.Symbols.TYPE_ALIAS,
            arguments: Collections.List[Type]
        ) -> Type is
            _symbol_use_locations.add_symbol_use(name.right_location, alias)

            let clause: Trees.Definitions.USE mut

            if _alias_clauses.try_get_value(alias, clause ref) then
                _resolve_alias(clause)
            fi

            if alias.argument_count != arguments.count then
                if alias.argument_count == 0 then
                    _logger.error(location, "type alias {alias.name} takes no type arguments")
                else
                    _logger.error(
                        location,
                        "expected {alias.argument_count} type arguments but found {arguments.count}"
                    )
                fi

                return Semantic.Types.ERROR()
            fi

            let target = alias.target_type

            if !target? then
                return Semantic.Types.ERROR()
            fi

            if arguments.count == 0 then
                return target
            fi

            return target.specialize(alias.argument_map(arguments))
        si

        pre(`typeof: Trees.Expressions.TYPEOF) -> bool is
            _typeof_type_expression = `typeof.type_expression

            return false
        si

        visit(`typeof: Trees.Expressions.TYPEOF) is
            _typeof_type_expression = null
        si

        // A `_` type argument is a placeholder standing for an argument
        // the open generic has not been given, so there is no argument
        // to resolve. Skipping the walk keeps `_` from being looked up
        // as an ordinary name and reported as undefined; `visit` below
        // decides whether the placeholder was written somewhere it means
        // anything.
        pre(generic: Trees.TypeExpressions.GENERIC) -> bool =>
            _has_open_generic_placeholder(generic)

        _is_open_generic_placeholder(argument: Trees.TypeExpressions.TypeExpression) -> bool static is
            if let named: Trees.TypeExpressions.NAMED = argument then
                return !isa Trees.TypeExpressions.GENERIC(named) /\
                    !named.name.is_qualified /\
                    named.name.name =~ "_"
            fi

            return false
        si

        _has_open_generic_placeholder(generic: Trees.TypeExpressions.GENERIC) -> bool static is
            for a in generic.arguments do
                if _is_open_generic_placeholder(a) then
                    return true
                fi
            od

            return false
        si

        // `FOO[_]` - one `_` per type argument - names the open generic
        // `FOO` of that arity: the type before any type argument is
        // supplied. It exists so an arity sibling can be named at all,
        // since a bare `FOO` names the sibling taking no type arguments.
        // Only reflection can hold such a type, so the spelling is
        // confined to the whole of a `typeof`'s operand.
        _resolve_open_generic(generic: Trees.TypeExpressions.GENERIC) is
            generic.type = Semantic.Types.ERROR()

            let count = generic.arguments.count

            if generic != _typeof_type_expression then
                _logger.error(
                    generic.location,
                    "an open generic type can only be named as the whole operand of a typeof")

                return
            fi

            for a in generic.arguments do
                if !_is_open_generic_placeholder(a) then
                    _logger.error(
                        a.location,
                        "every type argument must be _ when naming an open generic type")

                    return
                fi
            od

            let symbol = find(generic.name)

            if !symbol? then
                return
            fi

            if isa Semantic.Symbols.TYPE_ALIAS(symbol) then
                _logger.error(
                    generic.location,
                    "a type alias has no open generic form")

                return
            fi

            let resolved: Semantic.Symbols.Symbol? =
                if let group: Semantic.Symbols.TYPE_GROUP = symbol then
                    group.find_by_generic_arguments_count(count)
                else
                    symbol
                fi

            let classy = cast Semantic.Symbols.Classy?(resolved)

            if !classy? \/ classy.argument_names.count != count then
                if let group: Semantic.Symbols.TYPE_GROUP = symbol then
                    let counts = group.generic_arguments_counts |> map(a -> string => "{a}") |> join(" or ")
                    _logger.error(generic.location, "expected {counts} type arguments but found {count}")
                else
                    _logger.error(
                        generic.location,
                        "{generic.name} does not take {count} type arguments")
                fi

                return
            fi

            _symbol_use_locations.add_symbol_use(generic.name.right_location, classy)
            _record_qualifier_use(generic.name, classy)

            generic.type = classy.type
        si

        // `cast (X)(args)` was parsed carrying both of its readings,
        // because the parser cannot tell a target type from a value
        // that is about to be called. The scope can: settle it here,
        // before the children are walked, so only the reading that was
        // meant is resolved. An undefined name settles as the type
        // reading, which is where the target of a cast is named and so
        // where the reader is told the name does not exist.
        pre(`cast: Trees.Expressions.CAST) -> bool is
            if `cast.is_ambiguous /\ `cast.reading == Trees.Expressions.CastReading.UNDECIDED then
                `cast.set_reading(
                    if _names_a_type(`cast.type_expression!) then
                        Trees.Expressions.CastReading.TYPED
                    else
                        Trees.Expressions.CastReading.CALLED
                    fi
                )
            fi

            return false
        si

        // Whether a cast target that is a name resolves, from here, to
        // something that can be used as a type. A type alias counts,
        // and so does a group of same-named generic types.
        _names_a_type(type_expression: Trees.TypeExpressions.TypeExpression) -> bool is
            if let named: Trees.TypeExpressions.NAMED = type_expression then
                // Speculative: the walk that follows reports the name
                // itself, under whichever reading this settles on.
                let symbol = try_find(named.name)

                if !symbol? then
                    return false
                fi

                return
                    symbol.is_type \/
                    isa Semantic.Symbols.TYPE_ALIAS(symbol) \/
                    isa Semantic.Symbols.TYPE_GROUP(symbol)
            fi

            return true
        si

        visit(named: Trees.TypeExpressions.NAMED) is
            named.type = null

            let symbol mut = find(named.name)

            if isa Semantic.Symbols.TYPE_ALIAS(symbol) then
                named.type =
                    _expand_alias(
                        named.name.location,
                        named.name,
                        symbol,
                        Collections.LIST[Type](0)
                    )

                return
            fi

            let group = cast Semantic.Symbols.TYPE_GROUP?(symbol)

            if group? then
                let bare = group.find_by_generic_arguments_count(0)

                if bare? then
                    symbol = bare
                else
                    named.type = Semantic.Types.ERROR()
                    let counts = group.generic_arguments_counts |> map(a -> string => "{a}") |> join(" or ")
                    _logger.error(named.name.location, "type {named.name} requires {counts} type arguments")
                    return
                fi
            fi

            if symbol? then
                // A generic named with none of its type arguments is the
                // open generic, which only reflection can hold: taking
                // its type here puts `IEnumerable`1` in the assembly and
                // the runtime refuses to load it. Reflection is where an
                // open generic belongs, so a typeof operand keeps it -
                // as does `FOO[_]`, which arrives as a GENERIC rather
                // than here.
                // A union's variant takes its arguments from the union,
                // and the value it is tested against or assigned to
                // supplies them: `isa Option.NONE(o)` over an
                // `Option[int]` names one type and needs no second
                // spelling of its argument.
                if let classy = cast Semantic.Symbols.Classy?(symbol) /\
                    classy.is_generic /\
                    !classy.is_variant /\
                    named != _typeof_type_expression
                then
                    named.type = Semantic.Types.ERROR()

                    _incomplete_generic_names = _incomplete_generic_names + 1

                    _logger.error(
                        named.name.location,
                        "type {named.name} requires {_type_argument_count(classy.argument_names.count)}")

                    return
                fi

                if symbol.is_type /\ isa Semantic.Types.Typed(symbol) then
                    _symbol_use_locations.add_symbol_use(named.name.right_location, symbol)
                    _record_qualifier_use(named.name, symbol)

                    named.type = cast Semantic.Types.Typed(symbol).type
                else
                    named.type = Semantic.Types.ERROR()
                    _logger.error(named.name.location, "cannot use this as a type")
                fi
            fi
        si

        _type_argument_count(count: int) -> string static =>
            if count == 1 then "1 type argument" else "{count} type arguments" fi

        // A qualified type reference (`Union.Variant`, `Outer.Nested`)
        // names its qualifier as well as the member. Record the
        // qualifier's use against the owning type so that rename and
        // find-references of that type cover the qualifier occurrence,
        // matching what the construction- and member-access paths
        // already record. Only a type owner qualifies — a namespace
        // qualifier is left alone.
        _record_qualifier_use(name: Trees.Identifiers.Identifier, symbol: Semantic.Symbols.Symbol) is
            if let name.qualifier? /\ isa Semantic.Symbols.Classy(symbol.owner) then
                _symbol_use_locations.add_symbol_use(
                    qualifier.right_location,
                    cast Semantic.Symbols.Symbol(symbol.owner)
                )
            fi
        si

        visit(element: Trees.TypeExpressions.NAMED_TUPLE_ELEMENT) is
            element.type_expression.accept(self)
        si

        _argument_types(generic: Trees.TypeExpressions.GENERIC) -> Collections.LIST[Type] is
            let result = Collections.LIST[Type]()

            for a in generic.arguments do
                if a.type? then
                    result.add(a.type)
                else
                    result.add(Semantic.Types.ERROR())
                fi
            od

            return result
        si

        visit(generic: Trees.TypeExpressions.GENERIC) is
            generic.type = null

            if _has_open_generic_placeholder(generic) then
                _resolve_open_generic(generic)

                return
            fi

            let symbol mut = find(generic.name)

            if isa Semantic.Symbols.TYPE_ALIAS(symbol) then
                generic.type =
                    _expand_alias(
                        generic.location,
                        generic.name,
                        symbol,
                        _argument_types(generic)
                    )

                return
            fi

            let group = cast Semantic.Symbols.TYPE_GROUP?(symbol)

            if group? then
                let match = group.find_by_generic_arguments_count(generic.arguments.count)

                if !match? then
                    let counts = group.generic_arguments_counts |> map(a -> string => "{a}") |> join(" or ")
                    _logger.error(generic.location, "expected {counts} type arguments but found {generic.arguments.count}")
                    generic.type = Semantic.Types.ERROR()
                    return
                fi

                symbol = match
            fi

            if symbol? then
                _symbol_use_locations.add_symbol_use(generic.name.right_location, symbol)
                _record_qualifier_use(generic.name, symbol)

                if !isa Semantic.Symbols.Classy(symbol) then
                    generic.type = Semantic.Types.ERROR()
                    _logger.error(generic.location, "cannot supply type arguments here")
                    return
                fi

                let arguments = Collections.LIST[Type]()

                for a in generic.arguments do
                    if a.type? then
                        arguments.add(a.type)
                    else
                        arguments.add(Semantic.Types.ERROR())
                    fi
                od

                let classy = symbol

                generic.type = Semantic.Types.GENERIC(
                    generic.location,
                    classy,
                    arguments)

                classy.check_argument_kinds(generic.location, _logger, arguments)

                if symbol.is_unsafe_constraints then
                    _logger.warn(generic.location, "unchecked-constraints", "type {generic.type} has unchecked constraints")
                fi
            else
                generic.type = Semantic.Types.ERROR()
            fi
        si

        explicit_specialize_symbol(
            location: Source.LOCATION,
            left_value: IR.Values.Value,
            symbol: Semantic.Symbols.Symbol mut,
            type_arguments: Collections.List[Semantic.Types.Type]
        ) -> IR.Values.Value
        is
            let specialized =
                symbol.try_specialize(
                    location,
                    _logger,
                    type_arguments
                )

            let from: IR.Values.Value? mut = _

            if isa IR.Values.Load.SYMBOL(left_value) then
                let load = left_value

                from = load.from
            fi

            if specialized? then
                return
                    IR.Values.Load.SYMBOL(from, specialized)
            else
                return
                    IR.Values.DUMMY(Semantic.Types.ERROR(), location)
            fi
        si

        visit(structured: Trees.TypeExpressions.Structured) is
            Std.error.write_line("visit TypeExpressions.Structured called")
        si

        get_type_or_any(element: Type?) -> Type is
            if element? then
                return element
            else
                return Semantic.Types.ERROR()
            fi
        si

        visit(array: Trees.TypeExpressions.ARRAY_) is
            array.type =
                _innate_symbol_lookup.get_array_type(
                    get_type_or_any(array.element.type))
        si

        // `T{}` is a spelling of Collections.Iterable[T] rather than a
        // type of its own, so it resolves to the same instantiation the
        // written-out form does and neither is preferred anywhere.
        visit(iterable: Trees.TypeExpressions.ITERABLE) is
            let element = get_type_or_any(iterable.element.type)

            if element.is_error then
                iterable.type = element

                return
            fi

            let unspecialized = _innate_symbol_lookup.get_unspecialized_iterable_type()

            // Specializing the unspecialized type is what the written-out
            // `Collections.Iterable[T]` resolves to as well. Building a
            // GENERIC from its symbol instead gives a type that prints the
            // same and does not unify with it.
            if let classy: Semantic.Symbols.Classy = unspecialized.symbol /\
                    classy.argument_names.count == 1 then
                let parameter = classy.find_direct(classy.argument_names[0])

                if parameter? then
                    let map = Collections.MAP[Semantic.Symbols.Symbol, Semantic.Types.Type]()

                    map[parameter] = element

                    iterable.type = unspecialized.specialize(map)
                else
                    iterable.type = Semantic.Types.ERROR()
                fi
            else
                iterable.type = Semantic.Types.ERROR()
            fi
        si

        visit(pointer: Trees.TypeExpressions.POINTER) is
            pointer.type =
                _innate_symbol_lookup.get_pointer_type(
                    get_type_or_any(pointer.element.type))
        si

        visit(optional: Trees.TypeExpressions.OPTIONAL) is
            let element_type = get_type_or_any(optional.element.type)

            if element_type.is_error then
                optional.type = element_type
            elif element_type.is_value_type /\ element_type.is_optional then
                // `T??` collapses — already a value-type optional
                // (source-side NULLABLE or a reflected Nullable<T>).
                optional.type = element_type
            elif element_type.is_void then
                _logger.error(optional.location, "void cannot be made optional")
                optional.type = Semantic.Types.ERROR()
            elif element_type.is_type_variable then
                // `T?` lowers by the parameter's declared kind: a
                // `struct` parameter to NULLABLE[T], a `class` one to a
                // flagged reference, an `?` one is already optional,
                // and an unconstrained one to `Ghul.MAYBE[T]` — the
                // runtime carrier that picks neither lowering at
                // declaration site and defers the absent/present
                // distinction to a runtime flag.
                let kind = element_type.symbol.constraint_kind

                if kind == Semantic.Symbols.TypeParameterConstraintKind.VALUE then
                    optional.type = _innate_symbol_lookup.get_optional_type(element_type)
                elif kind == Semantic.Symbols.TypeParameterConstraintKind.REFERENCE then
                    optional.type = element_type.as_optional()
                elif kind == Semantic.Symbols.TypeParameterConstraintKind.OPTIONAL then
                    // `T` is already an optional type — `T?` adds nothing.
                    optional.type = element_type
                else
                    let maybe = _innate_symbol_lookup.get_maybe_type(element_type)

                    if maybe? then
                        optional.type = maybe
                    else
                        _logger.error(optional.location, "unconstrained optional type parameter requires Ghul.MAYBE in ghul-runtime")
                        optional.type = Semantic.Types.ERROR()
                    fi
                fi
            elif element_type.is_value_type then
                optional.type = _innate_symbol_lookup.get_optional_type(element_type)
            else
                optional.type = element_type.as_optional()
            fi
        si

        visit(reference: Trees.TypeExpressions.REFERENCE) is
            reference.type =
                _innate_symbol_lookup.get_reference_type(
                    get_type_or_any(reference.element.type))
        si

        pre(member: Trees.TypeExpressions.MEMBER) -> bool => super.pre(member)

        visit(member: Trees.TypeExpressions.MEMBER) is
            // we have something like
            //    Namespace.TYPE[type-arguments].member
            // we need to translate it to
            //    Namespace.TYPE.member[type-arguments]

            // A member of a member that already failed to resolve has been
            // reported once, where it failed.
            if isa Trees.TypeExpressions.MEMBER(member.left) /\ (!member.left.type? \/ member.left.type.is_error) then
                member.type = member.left.type
                return
            fi

            try
                let qualified = member.left.qualify_member(member.name)

                qualified.walk(self)

                member.type = qualified.type
            catch ex: System.Exception
                _logger.exception(member.location, ex, "exception resolving types in type member expression")
                member.type = Semantic.Types.ERROR()
            yrt
        si

        visit(function: Trees.TypeExpressions.FUNCTION) is
            if function.arguments.count > Semantic.Lookups.INNATE_TYPE_LIMITS.MAX_FUNCTION_PARAMETERS then
                _logger.error(
                    function.location,
                    "a function type cannot have more than {Semantic.Lookups.INNATE_TYPE_LIMITS.MAX_FUNCTION_PARAMETERS} parameters")
                function.type = Semantic.Types.ERROR()
                return
            fi

            let types = Collections.LIST[Type]()

            for a in function.arguments do
                types.add(get_type_or_any(a.type))
            od

            types.add(get_type_or_any(function.result.type))

            function.type =
                _innate_symbol_lookup.get_function_type(types, function.is_pure)
        si

        visit(tuple: Trees.TypeExpressions.TUPLE) is
            if tuple.elements.count > Semantic.Lookups.INNATE_TYPE_LIMITS.MAX_TUPLE_ELEMENTS then
                _logger.error(
                    tuple.location,
                    "a tuple type cannot have more than {Semantic.Lookups.INNATE_TYPE_LIMITS.MAX_TUPLE_ELEMENTS} elements")
                tuple.type = Semantic.Types.ERROR()
                return
            fi

            let names: Collections.LIST[string]? mut = Collections.LIST[string]()
            let types = Collections.LIST[Type]()

            let seen_any_named mut = false

            for (index, a) in tuple.elements |> index() do
                if let element: Trees.TypeExpressions.NAMED_TUPLE_ELEMENT = a then
                    names.add(element.name.name)
                    seen_any_named = true

                    types.add(get_type_or_any(element.type_expression.type))
                else
                    names.add("{index}")
                    types.add(get_type_or_any(a.type))
                fi
            od

            if !seen_any_named then
                names = null
            fi

            tuple.type =
                _innate_symbol_lookup.get_tuple_type(types, names)
        si

        pre(ambiguous_expression: Trees.Expressions.AMBIGUOUS_EXPRESSION) -> bool is
            let logger_snapshot = _logger.speculate_then_commit()

            // we know we must have exactly one generic type argument
            // because otherwise we could have elimited the index expression
            // possibility and parsed this as a GENERIC_APPLICATION tree
            let arg = ambiguous_expression.type_arguments.elements[0]

            let incomplete_generic_names_before = _incomplete_generic_names

            let type_argument_walk_succeeded mut = false
            try
                arg.walk(self)
                type_argument_walk_succeeded = true
            catch ex: System.Exception
                debug_always("caught exception speculatively walking type arguments tree {ex.to_string().replace_line_endings()}")
            yrt

            // don't report any errors encountered in the arguments tree walk
            let errors = logger_snapshot.backtrack()

            // A name that turned out to be a generic short of its type
            // arguments is a type either way, so the index reading can
            // only report that the indexer was not found. Take the type
            // application and walk it again for real, so what comes out
            // names the incomplete type.
            if _incomplete_generic_names > incomplete_generic_names_before then
                arg.walk(self)

                if let ambiguous_expression.left? then
                    left.walk(self)
                fi

                return true
            fi

            // but if there were any, then assume this isn't a type application
            type_argument_walk_succeeded =
                type_argument_walk_succeeded /\
                !errors.any_errors /\
                (let arg_type = arg?.type in arg_type? /\ !arg_type.is_error)

            if type_argument_walk_succeeded then
                // need to walk the left expression as it may
                // also contain types that need to be resolved
                if let ambiguous_expression.left? then
                    left.walk(self)
                fi
            else
                // our single actual generic type argument didn't resolve to
                // a type - assume this means we actually have an index expression
                // not a type application. We still don't know what kind of type
                // application so leave result null

                // the index expression could contain type expressions (it could be a
                // lambda for example) so we do need to walk it:
                ambiguous_expression.index.walk(self)

                // don't need to walk the left expression - index includes it

                ambiguous_expression.result = Trees.Expressions.AmbiguousExpressionResult.INDEX
            fi

            return true
        si

        visit(type_expression: Trees.Expressions.AMBIGUOUS_EXPRESSION) is
        si

        pre(generic_application: Trees.Expressions.GENERIC_APPLICATION) -> bool is
            // we can't apply the generic arguments yet because we don't
            // know what kind of symbol we're dealing with (type or function)
            // and they need to be handled differently

            // if we search for the identifier now, we won't get a result if
            // its a symbol due to the same global symbol search and
            // caching works

            // plus we have to be able to resolve this particular ambiguity
            // in a later phase anyway, for AMBIGUOUS_EXPRESSION

            // however, as we know that we're dealing with some kind of
            // type argument application, we don't need to disable logging -
            // we can just walk the type arguments and report any errors
            // normally

            if let generic_application.left? then
                left.walk(self)
            fi

            generic_application.type_arguments.walk(self)

            return true
        si

        visit(type_expression: Trees.Expressions.GENERIC_APPLICATION) is
        si
    si
si
