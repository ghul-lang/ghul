namespace Syntax.Process is
    use Type = Semantic.Types.Type

    // Whether a composite expression (`if` / `case`) sitting in a
    // position that wants a value but tolerates a void one should
    // decline to produce a value at all, and be compiled as the
    // statement it is.
    //
    // Two positions tolerate void: the body of a function literal whose
    // return type is still being inferred, where nothing has yet said
    // whether the body yields a value, and a function body's implicit
    // tail, where a void tail is an effect-only statement that falls
    // through rather than returning. In both, a composite with no arm
    // yielding a non-void value - void arms, diverging arms, or a mix -
    // is the statement it is, so an arm that only calls a void function
    // is not an error the way it is in `let x = if ... fi`, and a guard
    // whose arms all return has no else demanded of it. Arms that do
    // yield a value keep the value form, so a void arm mixed in with
    // them is still reported where it cannot be consumed.
    class VOID_TOLERANT_POSITION is
        declines_value(
            void_tolerated: bool,
            seen_non_void_arm: bool
        ) -> bool static pure =>
            void_tolerated /\
            !seen_non_void_arm

        // An arm in error says nothing about whether the composite
        // yields a value: what it would have produced is unknown, and
        // on a walk made before the types around it are known the error
        // is that walk's alone. So a composite with such an arm, and
        // none that yields a value, neither declines nor joins: it is
        // in error itself, silently, and a later walk decides.
        is_undecided(
            void_tolerated: bool,
            seen_non_void_arm: bool,
            seen_error_arm: bool
        ) -> bool static pure =>
            void_tolerated /\
            !seen_non_void_arm /\
            seen_error_arm

        is_in_error(type: Type?) -> bool static pure =>
            type? /\ type.is_error

        // An arm's contribution to the count above. An error-typed arm
        // does not count: it has already been reported, and letting it
        // force the value form would pile a second diagnostic onto the
        // same arm. Neither does an arm typed at the enclosing
        // function's own unsettled return - a recursive self-call in a
        // composite that is itself helping to settle that return -
        // since nothing has said yet that it yields a value. An
        // unresolved variable type does count: it stands for a slot
        // some later walk will fill with a real type, not for a body
        // that might turn out to be void. A recursive literal's return
        // stands as its own origin, and is the unsettled return above.
        counts_as_non_void(type: Type?) -> bool static pure =>
            type? /\
            !type.is_void /\
            !type.is_error /\
            !isa Semantic.Types.INFERRED_RETURN_TYPE(type) /\
            !_is_unsettled_literal_return(type)

        _is_unsettled_literal_return(type: Type) -> bool static pure =>
            if let placeholder: Semantic.Types.INFERRED_VARIABLE_TYPE = type then
                isa Semantic.Symbols.INFERRED_RESULT_ORIGIN(placeholder.origin)
            else
                false
            fi
    si
si
