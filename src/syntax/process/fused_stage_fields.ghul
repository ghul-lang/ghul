namespace Syntax.Process is
    // Where one stage of a fused loop in a generator or asynchronous body
    // keeps what it carries from one element to the next: frame fields,
    // so that it survives the suspensions in the loop body.
    class FUSED_STAGE_FIELDS is
        // A take, skip or index stage's counter, or the function value of
        // a stage that runs as a delegate call; null for a stage that
        // carries neither.
        carried: Semantic.Symbols.Field?

        // A skip_while stage's dropping flag; null for any other stage.
        flag: Semantic.Symbols.Field?

        // In a generated generator, the parameter the carried value is
        // passed as and starts from; null where it starts from the
        // stage's own argument.
        parameter: Semantic.Symbols.Variable?

        init(carried: Semantic.Symbols.Field?, flag: Semantic.Symbols.Field?, parameter: Semantic.Symbols.Variable?) is
            self.carried = carried
            self.flag = flag
            self.parameter = parameter
        si
    si
si
