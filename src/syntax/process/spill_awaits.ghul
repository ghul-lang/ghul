namespace Syntax.Process is
    use Source
    use Trees
    use Logging

    // SPILL_AWAITS — wraps operand-position subexpressions evaluated
    // to the left of an `await` in `Expressions.SPILL` so their
    // values land in a frame field rather than the CLR stack. AWAIT
    // suspends with an internal `leave`, and the CLR requires the
    // evaluation stack to be empty at the suspend point — anything
    // not yet consumed by an enclosing operation would be lost on
    // re-entry (CLR locals reset; only frame fields persist).
    //
    // A protected region has the same requirement: a `try`, or the
    // region a disposing `let` or a `use` opens, can only be entered
    // with an empty stack. Outside an async body there is no suspend
    // to survive, so a spilled value goes to a local instead.
    //
    // Rule (applied bottom-up at every composite node): if any
    // later-evaluated child contains an `await` or a protected
    // region, wrap every prior child in `SPILL`. The operand-position contract (one stack
    // value per operand) makes the rule uniform — no purity
    // analysis needed.
    class SPILL_AWAITS: Visitor is
        init() is
            super.init()
        si

        apply(node: Node) is
            node.walk(self)
        si

        visit(b: Expressions.BINARY) is
            if _needs_empty_stack(b.right) then
                _wrap_unless_await(b, b.left)

                if _contains_protected_region(b.right) then
                    _wrap_unless_await(b, b.right)
                fi
            fi
        si

        // CALL: receiver first, then args in source order. An await
        // in any arg means wrap every prior arg, plus the
        // MEMBER receiver if this is an instance call.
        visit(call: Expressions.CALL) is
            if call.arguments.count == 0 then
                return
            fi

            let latest = _spill_elements(
                call.arguments.expressions,
                (i: int, e: Expressions.Expression) is call.arguments.replace_element(i, e) si)

            if latest < 0 then
                return
            fi

            if isa Expressions.MEMBER(call.function) then
                let mem = cast Expressions.MEMBER(call.function)
                if !_is_await_node(mem.left) /\ !_is_spill_node(mem.left) then
                    mem.replace_child(
                        mem.left,
                        Expressions.SPILL(mem.left.location, mem.left)
                    )
                fi
            fi
        si

        // A store pushes its target's receiver, and an index its index,
        // before the value it stores, so all of them are evaluated ahead
        // of a value holding a protected region.
        visit(assign: Statements.ASSIGNMENT) is
            if !_contains_protected_region(assign.right) then
                return
            fi

            if let member: Expressions.MEMBER = assign.left then
                _wrap_unless_await(member, member.left)
            elif let idx: Expressions.INDEX = assign.left then
                _wrap_unless_await(idx, idx.left)
                _wrap_unless_await(idx, idx.index)
            fi

            if !_is_spill_node(assign.right) then
                assign.replace_right(Expressions.SPILL(assign.right.location, assign.right))
            fi
        si

        visit(idx: Expressions.INDEX) is
            if _needs_empty_stack(idx.index) then
                if !_is_await_node(idx.left) /\ !_is_spill_node(idx.left) then
                    idx.replace_child(
                        idx.left,
                        Expressions.SPILL(idx.left.location, idx.left)
                    )
                fi

                if _contains_protected_region(idx.index) then
                    _wrap_unless_await(idx, idx.index)
                fi
            fi
        si

        visit(construct: Expressions.CONSTRUCT) is
            if construct.arguments.count == 0 then
                return
            fi

            _spill_elements(
                construct.arguments.expressions,
                (i: int, e: Expressions.Expression) is construct.arguments.replace_element(i, e) si)
        si

        visit(t: Expressions.TUPLE) is
            if t.elements.count == 0 then
                return
            fi

            _spill_elements(
                t.elements.expressions,
                (i: int, e: Expressions.Expression) is t.elements.replace_element(i, e) si)
        si

        // An interpolated string keeps the text it is building on the
        // stack while each hole is evaluated.
        visit(s: Expressions.STRING_INTERPOLATION) is
            let holes = Collections.LIST[Expressions.Expression]()
            let positions = Collections.LIST[int]()

            for index in 0..s.values.count do
                let fragment = s.values[index]

                if fragment.is_expression then
                    holes.add(fragment.expression)
                    positions.add(index)
                fi
            od

            _spill_elements(holes, (i: int, e: Expressions.Expression) is s.replace_expression(positions[i], e) si)
        si

        // Wraps every element evaluated before the last one that needs an
        // empty stack. An await leaves that stack empty itself when it is
        // emitted, but a protected region is emitted where its value is
        // used, so an element holding one is spilled too: it is then
        // evaluated ahead of the operation, in source order, with nothing
        // beneath it. Answers the index of that last element, or -1.
        _spill_elements(
            elements: Collections.List[Expressions.Expression],
            replace: (int, Expressions.Expression) -> void
        ) -> int is
            let latest mut = -1

            for i in 0..elements.count do
                if _needs_empty_stack(elements[i]) then
                    latest = i
                fi
            od

            if latest < 0 then
                return latest
            fi

            let last = if _contains_protected_region(elements[latest]) then latest + 1 else latest fi

            for i in 0..last do
                let e = elements[i]

                if !_is_await_node(e) /\ !_is_spill_node(e) then
                    replace(i, Expressions.SPILL(e.location, e))
                fi
            od

            return latest
        si

        _wrap_unless_await(parent: Expressions.Expression, child: Expressions.Expression) is
            if _is_await_node(child) then
                return
            fi
            parent.replace_child(child, Expressions.SPILL(child.location, child))
        si

        _is_await_node(e: Expressions.Expression) -> bool =>
            isa Expressions.AWAIT(e)

        _is_spill_node(e: Expressions.Expression) -> bool =>
            isa Expressions.SPILL(e)

        _needs_empty_stack(e: Expressions.Expression) -> bool is
            let scanner = CONTAINS_AWAIT_SCANNER()
            e.walk(scanner)

            return scanner.found \/ _contains_protected_region(e)
        si

        _contains_protected_region(e: Expressions.Expression) -> bool is
            let scanner = CONTAINS_PROTECTED_REGION_SCANNER()
            e.walk(scanner)

            return scanner.found
        si
    si

    // Scans for any `Expressions.AWAIT`. Stops at function-literal
    // boundaries — a nested lambda's awaits belong to its own
    // state machine.
    class CONTAINS_AWAIT_SCANNER: Visitor is
        found: bool public

        init() is
            super.init()
        si

        pre(a: Expressions.AWAIT) -> bool is
            found = true
            return true
        si

        pre(f: Expressions.FUNCTION) -> bool => true
    si

    // Scans for anything that opens a protected region: a `try`, a
    // `let use` or `let use ... in`, or a `use`. Stops at function-literal
    // boundaries, since a nested lambda's regions are in its own body.
    class CONTAINS_PROTECTED_REGION_SCANNER: Visitor is
        found: bool public

        init() is
            super.init()
        si

        pre(t: Statements.TRY) -> bool is
            found = true
            return true
        si

        pre(l: Statements.LET) -> bool is
            if l.want_dispose then
                found = true
            fi

            return found
        si

        pre(l: Expressions.LET_IN) -> bool is
            if l.want_dispose then
                found = true
            fi

            return found
        si

        pre(u: Expressions.USE) -> bool is
            found = true
            return true
        si

        pre(f: Expressions.FUNCTION) -> bool => true
    si

    // Scans for any state-machine suspend site (`Expressions.AWAIT`
    // or `Statements.YIELD`) without descending into a nested
    // function literal. Used by generate-il to decide whether a
    // composite value-BLOCK (LIST in expression position, `if`/
    // `case` in expression position) needs to be spilled to a
    // frame field — captured-suspend IL inside the BLOCK has to
    // live in the outer MoveNext stream, not get replayed inside
    // a consumer's stack setup.
    class CONTAINS_SUSPEND_SCANNER: Visitor is
        found: bool public

        init() is
            super.init()
        si

        pre(a: Expressions.AWAIT) -> bool is
            found = true
            return true
        si

        pre(y: Statements.YIELD) -> bool is
            found = true
            return true
        si

        pre(y: Statements.YIELD_ALL) -> bool is
            found = true
            return true
        si

        pre(f: Expressions.FUNCTION) -> bool => true
    si

si
