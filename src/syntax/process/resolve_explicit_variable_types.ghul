namespace Syntax.Process is
    use IO.Std

    use Logging

    use Semantic.Types.Type

    class RESOLVE_EXPLICIT_TYPES: ScopedVisitor is
        _logger: Logger
        _symbol_table: Semantic.SYMBOL_TABLE
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        )
        is
            super.init(logger, symbol_table, namespaces)

            _symbol_table = symbol_table
            _logger = logger
            _innate_symbol_lookup = innate_symbol_lookup
        si

        apply(root: Trees.Node) is
            root.walk(self)
        si

        pre(`class: Trees.Definitions.CLASS) -> bool is
            let result = super.pre(`class)

            set_generic_argument_types(`class.arguments)

            return result
        si

        pre(`trait: Trees.Definitions.TRAIT) -> bool is
            let result = super.pre(`trait)

            set_generic_argument_types(`trait.arguments)

            return result
        si

        pre(`struct: Trees.Definitions.STRUCT) -> bool is
            let result = super.pre(`struct)

            set_generic_argument_types(`struct.arguments)

            return result
        si

        pre(`union: Trees.Definitions.UNION) -> bool is
            let result = super.pre(`union)

            set_generic_argument_types(`union.arguments)

            return result
        si

        // A variant carries a copy of its union's type-parameter list, and
        // declares its own type-parameter symbols from it, so it needs its
        // own bounds attached: the variant extends `Union[E]` with its own
        // `E`, and an unbounded one does not satisfy the union's bound.
        pre(variant: Trees.Definitions.VARIANT) -> bool is
            let result = super.pre(variant)

            set_generic_argument_types(variant.arguments)

            return result
        si

        pre(function: Trees.Definitions.FUNCTION) -> bool is
            super.pre(function)
            set_generic_argument_types(function.generic_arguments)
            return false
        si

        visit(function: Trees.Definitions.FUNCTION) is
            let symbol = _symbol_table.current_function

            if symbol == null then
                super.visit(function)
                return
            fi

            let types = Collections.LIST[Type]()
            let names = Collections.LIST[string]()
            let defaults = Collections.LIST[string?]()
            let packs = Collections.LIST[bool]()
            let pack_depths = Collections.LIST[int]()
            let spreads = Collections.LIST[bool]()
            let spread_locations = Collections.LIST[Source.LOCATION]()
            let pack_sites = ARGUMENT_PACK_SITES(_logger)


            for argument in function.arguments do
                if !argument.name? then
                    if !argument.left.is_simple_name then
                        // Destructured formal argument: one physical
                        // parameter at the aggregate type, under the
                        // synthesised name declare-members gave it.
                        let group_symbol = symbol_for(argument)
                        let type = argument.type_expression.type

                        types.add(if type? then type else Semantic.Types.ERROR() fi)
                        names.add(if group_symbol? then group_symbol.name else "?" fi)
                        defaults.add(null)
                        let group_site = pack_sites.classify(argument.type_expression)

                        packs.add(group_site.site =~ PackSite.CALLABLE)
                        pack_depths.add(group_site.depth)
                        spreads.add(group_site.site =~ PackSite.SPREAD)
                        spread_locations.add(argument.location)

                        if type? then
                            if group_symbol? /\ isa Semantic.Types.SettableTyped(group_symbol) then
                                (cast Semantic.Types.SettableTyped(group_symbol)).set_type(type)
                            fi

                            assign_destructure_argument_types(argument.left, type)
                        else
                            // No aggregate type to destructure - it was
                            // missing, or did not resolve. Type every leaf
                            // as ERROR anyway, so the body reads them as
                            // declared variables rather than reporting each
                            // one undefined on top of the real diagnostic.
                            _assign_destructure_element_type(argument.left, null)
                        fi

                        continue
                    fi

                    // Argument is malformed (parser recovered after an
                    // error). Skip — function.is_poisoned will already be
                    // true and a diagnostic will already have been
                    // reported upstream. Dereferencing the null members
                    // here would crash the pass with an unhelpful trace.
                    types.add(Semantic.Types.ERROR())
                    names.add("?")
                    defaults.add(null)
                    packs.add(false)
                    pack_depths.add(0)
                    spreads.add(false)
                    spread_locations.add(argument.location)
                    continue
                fi

                let type = if argument.type_ran_on then null else argument.type_expression.type fi

                types.add(if type? then type else Semantic.Types.ERROR() fi)

                names.add(argument.name!.name)

                defaults.add(
                    if isa Trees.Expressions.DEFAULT(argument.initializer) then
                        "default"
                    else
                        null
                    fi
                )

                let site = pack_sites.classify(argument.type_expression)

                packs.add(site.site =~ PackSite.CALLABLE)
                pack_depths.add(site.depth)
                spreads.add(site.site =~ PackSite.SPREAD)
                spread_locations.add(argument.location)
            od

            // Where the last argument's type ran on into the rest of the
            // header, any `->` went with it, so the body and callers are not
            // held to void.
            if
                isa Trees.TypeExpressions.INFER(function.type_expression) /\
                function.arguments.count > 0 /\
                function.arguments.variables[function.arguments.count - 1].type_ran_on
            then
                symbol.return_type = Semantic.Types.ERROR()
            elif !isa Trees.TypeExpressions.INFER(function.type_expression) then
                let resolved = function.type_expression.type
                symbol.return_type = if resolved? then resolved else Semantic.Types.ERROR() fi

                let return_site = pack_sites.classify_return(function.type_expression)

                if return_site.site =~ PackSite.CALLABLE then
                    symbol.return_pack_depth = return_site.depth
                fi
            else
                symbol.set_void_return_type()
            fi

            symbol.arguments = types
            symbol.argument_names = names
            symbol.argument_defaults = defaults
            symbol.argument_is_pack = packs
            symbol.argument_pack_depth = pack_depths

            for i in 0..spreads.count do
                if spreads[i] then
                    if i != spreads.count - 1 then
                        _logger.error(
                            spread_locations[i],
                            "a formal that spreads an argument pack has to be the last one"
                        )
                    else
                        symbol.spread_argument_index = i
                    fi
                fi
            od

            super.visit(function)
        si

        pre(property: Trees.Definitions.PROPERTY) -> bool => true
        visit(property: Trees.Definitions.PROPERTY) is
            let name = property.name

            if !name? then
                super.visit(property)
                return
            fi

            let f = find(name)

            if f == null \/ !isa Semantic.Types.SettableTyped(f) then
                super.visit(property)
                return
            fi

            let symbol = cast Semantic.Types.SettableTyped(f)

            let type_expression = property.type_expression

            if property.is_poisoned then
                symbol.set_type(Semantic.Types.ERROR())
            elif !isa Trees.TypeExpressions.INFER(type_expression) then
                if f.is_field then
                    type_expression.check_is_not_reference(_logger, "field cannot be a ref type")
                else
                    type_expression.check_is_not_reference(_logger, "property cannot be a ref type")
                fi

                type_expression.check_is_not_void(_logger, "cannot use void type here")

                let resolved = type_expression.type
                symbol.set_type(if resolved? then resolved else Semantic.Types.ERROR() fi)
            fi

            super.visit(property)
        si

        // Formal-argument analog of compile-expressions' set_symbol_
        // destructure_types: no initializer expression exists to
        // drive the later re-walk that fixes up `let`-style
        // destructuring's leaf types, so this has to be the one place
        // that assigns them, from the parameter's own aggregate type.
        // Shares DESTRUCTURE_RESOLVER with the `let` path so a value-
        // tuple, a `deconstruct(...)` source, or `` `0``/`` `1``-style
        // positional members all resolve the same way; by-name groups
        // are rejected at parse time for a formal argument (see
        // parse_formal_arguments), so only the positional strategy is
        // ever asked for here.
        assign_destructure_argument_types(left: Trees.Variables.VariableLeft, from_type: Type) is
            let elements = left.elements!

            let strategy =
                Syntax.Process.DESTRUCTURE_RESOLVER.resolve_strategy_reporting(
                    _logger, left.location, from_type, elements.count, null
                )

            if strategy.is_deconstruct then
                let deconstruct = strategy.deconstruct_function!

                for i in 0..elements.count do
                    _assign_destructure_element_type(elements[i], deconstruct.arguments[i].get_element_type())
                od

                return
            fi

            let members = strategy.members

            for i in 0..elements.count do
                let member = members[i]

                _assign_destructure_element_type(elements[i], if member? then member.type else null fi)
            od
        si

        // Assigns `element_type` to every leaf under `element` -
        // recursing into a nested destructure group - falling back to
        // ERROR when the source couldn't supply a type, so a bad
        // aggregate type is reported once by resolve_strategy_
        // reporting and downstream passes still see a typed (if
        // wrong) symbol instead of crashing on a null type.
        _assign_destructure_element_type(element: Trees.Variables.VariableLeft, element_type: Type?) is
            if element.is_simple_name then
                let symbol = find(element.name!)

                if symbol? /\ isa Semantic.Types.SettableTyped(symbol) then
                    symbol.define()
                    (cast Semantic.Types.SettableTyped(symbol)).set_type(if element_type? then element_type else Semantic.Types.ERROR() fi)
                else
                    _logger.poison(element.location, "cannot locate typed symbol for destructuring element {element}")
                fi
            elif element_type? then
                assign_destructure_argument_types(element, element_type)
            else
                for e in element.elements! do
                    _assign_destructure_element_type(e, null)
                od
            fi
        si

        visit(variable: Trees.Variables.VARIABLE) is
            // A poisoned variable has already drawn its diagnostic at its
            // declaration; typing it again here only cascades.
            if variable.is_poisoned then
                return
            fi

            if variable.is_argument /\ !variable.left.is_simple_name then
                // Leaf types are assigned by assign_destructure_argument_
                // types from visit(FUNCTION), once the aggregate type is
                // known - not here, and not to the whole group's type as
                // the blanket assignment below would do.
                return
            fi

            for name in variable.names do
                assert name? else "null variable name"

                let symbol = find(name)

                if symbol? /\ isa Semantic.Types.SettableTyped(symbol) then
                    let typed_symbol = cast Semantic.Types.SettableTyped(symbol)

                    if typed_symbol.type? then
                        _logger.poison(variable.location, "set type twice for variable {symbol}")
                        return
                    fi

                    if !isa Trees.TypeExpressions.INFER(variable.type_expression) then
                        let type = variable.type_expression.type

                        if type? then
                            let type_expression = variable.type_expression

                            if !symbol.is_argument /\ !symbol.is_internal then
                                type_expression.check_is_not_reference(_logger, "variable cannot be a ref type")
                            fi

                            if !symbol.is_internal then
                                type_expression.check_is_not_void(_logger, "cannot use void type here")
                            fi

                            // FIXME this shouldn't be needed, but removing it breaks a number of integration tests.
                            // the type being set won't be correct if the variable is a destructure pattern:
                            typed_symbol.set_type(type_expression.type!)
                        fi
                    fi
                else
                    _logger.poison(variable.left.location, "cannot locate typed symbol for variable: {variable}")
                fi
            od
        si

        visit(variable: Trees.Expressions.VARIABLE) is
            let name = variable.name

            let symbol = find(name)

            if let typed_symbol = cast Semantic.Types.SettableTyped?(symbol) then
                // anonymous function arguments are visited twice; only set the type the first time
                if typed_symbol.type == null then
                    let type_expression = variable.type_expression

                    if !isa Trees.TypeExpressions.INFER(type_expression) then
                        typed_symbol.set_type(type_expression.type!)

                        type_expression.check_is_not_void(_logger, "cannot use void type here")
                    fi
                fi
            else
                _logger.poison(name.location, "cannot locate symbol for variable")
            fi
        si

        pre(ambiguous_expression: Trees.Expressions.AMBIGUOUS_EXPRESSION) -> bool is
            if ambiguous_expression.result == Trees.Expressions.AmbiguousExpressionResult.INDEX then
                ambiguous_expression.index.walk(self)

                return true
            fi

            if let ambiguous_expression.left? then
                left.walk(self)
            fi

            let arg = ambiguous_expression.type_arguments.elements[0]

            arg.walk(self)

            return true
        si

        visit(type_expression: Trees.Expressions.AMBIGUOUS_EXPRESSION) is
        si

        pre(generic_application: Trees.Expressions.GENERIC_APPLICATION) -> bool is
            if let generic_application.left? then
                left.walk(self)
            fi

            generic_application.type_arguments.walk(self)

            return true
        si

        visit(type_expression: Trees.Expressions.GENERIC_APPLICATION) is
        si

        set_type_ancestors(a: Trees.TypeExpressions.TypeExpression) is
            let symbol: Semantic.Symbols.Symbol? mut = null
            let type: Type? mut = null

            a.check_is_not_void(_logger, "cannot use void type here")

            if a.is_named then
                let name = a.name
                if name? then
                    symbol = find(name)
                fi

                if let a.type_expression? then
                    type = type_expression.type
                else
                    type = _innate_symbol_lookup.get_object_type()
                fi

                // Only generic arguments have a meaningful ancestor list
                // (their declared bounds). Other is_type symbols — CLASSY,
                // TYPE_GROUP, GENERIC — don't override the base stub.
                // Tightening the predicate from is_type to is_type_variable
                // matches what the setter is actually for and prevents
                // partially-resolved ancestor expressions from reaching the
                // NotImplementedException.
                if symbol? /\ type? /\ symbol.is_type_variable then
                    let bounds = Collections.LIST[Type]()
                    bounds.add(type)

                    if isa Trees.TypeExpressions.NAMED_TUPLE_ELEMENT(a) then
                        for bound in a.additional_bounds do
                            bound.check_is_not_void(_logger, "cannot use void type here")

                            if let bound_type = bound.type then
                                bounds.add(bound_type)
                            fi
                        od
                    fi

                    symbol.set_ancestor_types(bounds)
                fi
            fi
        si

        set_generic_argument_types(arguments: Trees.TypeExpressions.LIST?) is
            if arguments? then
                for a in arguments do
                    set_type_ancestors(a)
                od
            fi
        si

    si
si
