namespace Syntax.Process is
    use IR.Values.Value
    use Semantic.Types.Type

    // What a sequence pattern reads from the value it matches: the number of
    // elements, each leading element and, when the pattern has a rest
    // element, the remainder. Compile-expressions builds them over `source`,
    // a hole standing for the matched value, which only exists once IL
    // generation reaches the pattern; generation fills the hole before it
    // emits any of them.
    class SEQUENCE_PATTERN_VALUES is
        source: IR.Values.WRAPPER public
        element_type: Type public
        count: Value public
        elements: Value[] public
        rest: Value? public

        init(
            source: IR.Values.WRAPPER,
            element_type: Type,
            count: Value,
            elements: Value[],
            rest: Value?
        ) is
            self.source = source
            self.element_type = element_type
            self.count = count
            self.elements = elements
            self.rest = rest
        si
    si
si
