namespace Syntax.Process is
    use Semantic.KNOWN_MEMBERS
    use Semantic.KNOWN_SIGNATURE
    use Semantic.Symbols.Function
    use Semantic.Types.Type

    // A loop source walked by position rather than through its iterator:
    // its count, read once before the loop, and the read of the element
    // at an index. Only an array is: its length cannot change while the
    // loop runs, so reading it once is the same as asking the iterator.
    class INDEXED_SOURCE is
        count: Function
        read: Function

        init(count: Function, read: Function) is
            self.count = count
            self.read = read
        si

        // How to walk a source of `type` by position, or null where it
        // is not an array or its count and element read are not found.
        of(type: Type?, int_type: Type) -> INDEXED_SOURCE? static is
            if !isa Semantic.Types.ARRAY(type) then
                return null
            fi

            let count = KNOWN_MEMBERS.find(type, "$get_count", KNOWN_SIGNATURE(Collections.LIST[Type?](), true))
            let read = KNOWN_MEMBERS.find(type, Semantic.Symbols.INDEXER_NAMES.read, KNOWN_SIGNATURE([int_type], true))

            if count? /\ read? then
                return INDEXED_SOURCE(count, read)
            fi

            return null
        si
    si
si
