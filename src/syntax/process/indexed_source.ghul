namespace Syntax.Process is
    use Semantic.KNOWN_MEMBERS
    use Semantic.KNOWN_SIGNATURE
    use Semantic.Symbols.Function
    use Semantic.Types.Type

    // A loop source walked by position rather than through its iterator:
    // its count, and the read of the element at an index. An array's
    // length cannot change while the loop runs, so it is read once
    // before the loop. A list's count can, so it is read again before
    // each element: a list that shrinks ends the loop rather than having
    // an element read past its end. What a list changed while a loop
    // reads it gives is otherwise unspecified, as it is through the
    // iterator on targets that do not check.
    class INDEXED_SOURCE is
        count: Function
        read: Function
        rereads_count: bool

        init(count: Function, read: Function, rereads_count: bool) is
            self.count = count
            self.read = read
            self.rereads_count = rereads_count
        si

        // How to walk a source of `type` by position, or null where it
        // is neither an array nor the concrete list class, or its count
        // and element read are not found.
        of(type: Type?, lookup: Semantic.Lookups.InnateSymbolLookup) -> INDEXED_SOURCE? static is
            if !type? then
                return null
            fi

            let rereads_count =
                if isa Semantic.Types.ARRAY(type) then
                    false
                elif _is_instance_of(type, lookup.get_unspecialized_mutable_list_type()) then
                    true
                else
                    return null
                fi

            let int_type = lookup.get_int_type()

            let count = KNOWN_MEMBERS.find(type, "$get_count", KNOWN_SIGNATURE(Collections.LIST[Type?](), true))
            let read = KNOWN_MEMBERS.find(type, Semantic.Symbols.INDEXER_NAMES.read, KNOWN_SIGNATURE([int_type], true))

            if count? /\ read? then
                return INDEXED_SOURCE(count, read, rereads_count)
            fi

            return null
        si

        // Whether `type` is an instantiation of the generic class
        // `generic` stands for, by the identity of the class each is over.
        _is_instance_of(type: Type, generic: Type) -> bool static is
            let a = _classy_of(type)
            let b = _classy_of(generic)

            return a? /\ b? /\ a == b
        si

        _classy_of(type: Type) -> Semantic.Symbols.Classy? static is
            if let named: Semantic.Types.NAMED = type then
                let symbol mut = named.symbol

                if let generic: Semantic.Symbols.GENERIC = symbol then
                    symbol = generic.symbol
                fi

                if let classy: Semantic.Symbols.Classy = symbol then
                    return classy
                fi
            fi

            return null
        si
    si
si
