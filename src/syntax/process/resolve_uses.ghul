namespace Syntax.Process is
    use Logging
    use Source
    use Trees

    use Ghul.Pipes

    // Resolves use clauses into their namespace block's scope. Runs
    // twice: a first round after declare-symbols binds every import that
    // refers to a type - classes, structs, unions, variants, enums - and
    // namespaces, which is everything resolve-type-expressions needs. A
    // name that fails to bind is left for the second round (`_final`
    // unset marks the first-round instance), which runs after
    // declare-members, so an import can also name a static method, a
    // global function or an enum member - including one an impl or
    // partial block injects; anything still unresolved then is an error.
    class RESOLVE_USES: ScopeVisitorBase is
        _logger: Logger
        _symbol_table: Semantic.SYMBOL_TABLE
        _symbol_use_locations: Semantic.SYMBOL_USE_LOCATIONS
        _final: bool

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES,
            symbol_use_locations: Semantic.SYMBOL_USE_LOCATIONS,
            final: bool
        ) is
            super.init(symbol_table, namespaces)
            _logger = logger
            _symbol_table = symbol_table
            _symbol_use_locations = symbol_use_locations
            _final = final
        si

        apply(node: Node) is
            node.walk(self)
        si

        pre(`namespace: Definitions.NAMESPACE) -> bool is
            let namespace_scope = enter_namespace(`namespace)

            // FIXME: these searches probably should start at the scope immediately enclosing the namespace
            for u in `namespace.body.uses do
                if u.is_alias then
                    if !_final then
                        _declare_alias(u, namespace_scope)
                        u.is_import_resolved = true
                    fi

                    continue
                fi

                if u.is_default then
                    _resolve_default_uses(u, namespace_scope)

                    continue
                fi

                if u.is_all then
                    if !_final then
                        u.is_import_resolved = _resolve_use_all(u, namespace_scope)
                    elif !u.is_import_resolved then
                        _resolve_use_all(u, namespace_scope)
                    fi

                    continue
                fi

                if !u.`use? then
                    continue
                fi

                if !_final then
                    u.is_import_resolved = _resolve_use(u, namespace_scope)
                elif !u.is_import_resolved then
                    _resolve_use(u, namespace_scope)
                fi
            od
            return false
        si

        visit(`namespace: Definitions.NAMESPACE) is
            leave_namespace(`namespace)
        si


        // Declares the symbol for a type alias clause. The target type
        // expression is left for resolve-type-expressions, which is the
        // pass that can resolve it; all that is needed here is a symbol
        // for the name to bind to, carrying its type parameters.
        _declare_alias(u: Definitions.USE, namespace_scope: Semantic.NAMESPACE_SCOPE) is
            let name = u.name

            if !name? then
                return
            fi

            let existing = namespace_scope.get_used_symbol(name.name)

            if existing? then
                // Re-running the pass over a block whose scope already
                // carries this clause's symbol is a no-op; any other
                // symbol under the name is a genuine collision.
                if let previous = u.alias_symbol /\ existing == cast Semantic.Symbols.Symbol(previous) then
                    return
                fi

                _logger.error(name.location, "duplicate use")

                return
            fi

            let declared = namespace_scope.find_direct(name.name)

            if declared? then
                _logger.error(
                    name.location,
                    "type alias {name.name} has the same name as a symbol declared in this namespace",
                    declared.location,
                    "symbol declared here"
                )

                return
            fi

            let alias =
                Semantic.Symbols.TYPE_ALIAS(
                    name.location,
                    namespace_scope,
                    name.name,
                    namespace_scope
                )

            if let arguments = u.arguments then
                for a in arguments do
                    if isa TypeExpressions.NAMED(a) then
                        let argument = a

                        alias.declare_argument(argument.name.location, argument.name.name, null)
                    elif !a.is_poisoned then
                        _logger.error(a.location, "a type alias type parameter must be a plain identifier")
                    fi
                od
            fi

            u.alias_symbol = alias

            _symbol_use_locations.add_symbol_use(name.right_location, alias)

            namespace_scope.add(name.name, alias)
        si

        // Imports each name `use default` stands for. Every name is
        // attempted in both rounds: a namespace binds in the first, a
        // global function or static method only once members exist, and
        // one already imported by an explicit clause is left alone rather
        // than reported as a duplicate - writing both is how a file adds
        // to the set rather than a mistake to point at.
        // Every synthesised identifier below carries `use default`'s own
        // location, since there is no real per-name token in source to
        // attach a use to. Recording them would leave the `use default`
        // clause itself hovering and colouring as whichever imported
        // symbol resolved uses last, so the whole round is suppressed.
        _resolve_default_uses(u: Definitions.USE, namespace_scope: Semantic.NAMESPACE_SCOPE) is
            _symbol_use_locations.begin_suppress()

            try
                for name in Compiler.DEFAULT_USES.names(IoC.CONTAINER.instance.build_flags) do
                    let identifier = _default_use_identifier(u.location, name)

                    if namespace_scope.contains_used_symbol(identifier.name) then
                        continue
                    fi

                    if !find_enclosing(identifier)? then
                        if _final then
                            _logger.error(u.location, "the default use set names {name}, which is not defined")
                        fi

                        continue
                    fi

                    let clause = Definitions.USE(u.location, null, identifier)

                    _resolve_use(clause, namespace_scope)
                od
            finally
                _symbol_use_locations.end_suppress()
            yrt
        si

        // The qualified identifier a dotted name in the set spells.
        _default_use_identifier(location: LOCATION, name: string) -> Identifiers.Identifier is
            let parts = name.split(['.'])

            let result mut = Identifiers.Identifier(location, parts[0])

            for i in 1..parts.count do
                result = Identifiers.QUALIFIED(location, result, parts[i], location, location)
            od

            return result
        si

        // Returns true when the clause was definitively handled - a
        // successful import or, in the final round, a reported error.
        _resolve_use(u: Definitions.USE, namespace_scope: Semantic.NAMESPACE_SCOPE) -> bool is
            let used_name = u.`use

            if !used_name? then
                return true
            fi

            let found = find_enclosing(used_name)
            let used_symbol = found ?? _find_attribute_type(used_name)

            if !used_symbol? then
                if _final then
                    _logger.error(used_name.location, "used identifier {used_name} is not defined ")
                fi

                return false
            fi

            _import_symbol(used_symbol, used_name, u.name ?? _name_as_written(found, used_name), namespace_scope)

            return true
        si

        // A type reached through an old name of its own is imported under
        // that old name, since the code after the use goes on to write the
        // name the use wrote. Null where the symbol's own name is the one
        // written, which imports it under that name as usual.
        _name_as_written(found: Semantic.Symbols.Symbol?, used_name: Identifiers.Identifier) -> Identifiers.Identifier? is
            if !found? \/ found.name =~ used_name.name then
                return null
            fi

            return Identifiers.Identifier(used_name.right_location, used_name.name)
        si

        // A pragma names an attribute type in the short form, so a use
        // clause written to bring one into scope is written the same way.
        // The suffixed type is imported under its own name, which is what
        // the pragma's own short-form lookup then finds. Ancestors are not
        // resolved yet, so the name is the only evidence available that
        // the type is an attribute.
        _find_attribute_type(used_name: Identifiers.Identifier) -> Semantic.Symbols.Symbol? is
            if used_name.name.ends_with("Attribute") then
                return null
            fi

            let suffixed_name = "{used_name.name}Attribute"

            let suffixed =
                if let qualifier = used_name.qualifier then
                    Identifiers.QUALIFIED(
                        used_name.location,
                        qualifier,
                        suffixed_name,
                        used_name.location,
                        used_name.location)
                else
                    Identifiers.Identifier(used_name.location, suffixed_name)
                fi

            let found = find_enclosing(suffixed)

            if isa Semantic.Symbols.Classy(found) then
                return found
            fi

            return null
        si

        // Resolves `use X.*`. A namespace target is handled exactly like a
        // plain `use X;` - its members are already reachable through the
        // existing per-scope namespace fallback, so there is nothing extra
        // to enumerate. A class, struct, union or enum target has no
        // members to enumerate until declare-members has run, so the first
        // round only resolves and records the container; the second round
        // - the same one that lets an ordinary use clause resolve a static
        // method or enum member - enumerates and imports them.
        _resolve_use_all(u: Definitions.USE, namespace_scope: Semantic.NAMESPACE_SCOPE) -> bool is
            let used_name = u.`use

            if !used_name? then
                return true
            fi

            let container = u.wildcard_target ?? find_enclosing(used_name)

            if !container? then
                if _final then
                    _logger.error(used_name.location, "used identifier {used_name} is not defined ")
                fi

                return false
            fi

            if isa Semantic.Symbols.NAMESPACE(container) then
                return _resolve_use(u, namespace_scope)
            fi

            if !isa Semantic.Symbols.Classy(container) then
                _logger.error(used_name.location, "cannot use all members of {used_name}")

                return true
            fi

            u.wildcard_target = container

            if !_final then
                return false
            fi

            let classy = cast Semantic.Symbols.Classy?(container)!

            // `used_name` names the container, not any one member - the
            // `.*` has no per-member token to attach a use to. Record
            // the container itself once, then suppress the per-member
            // imports below so they don't pile more uses onto the same
            // span and win the hover / colouring tie-break.
            _symbol_use_locations.add_symbol_use(used_name.right_location, container)

            _symbol_use_locations.begin_suppress()

            try
                for member in classy.symbols do
                    if _is_wildcard_importable(member) then
                        _import_symbol(member, used_name, null, namespace_scope)
                    fi
                od
            finally
                _symbol_use_locations.end_suppress()
            yrt

            return true
        si

        // Whether a directly-declared member is something `use X.*` may
        // import: the same shapes a hand-written `use X.member;` succeeds
        // on, minus a constructor and a synthesized member (an
        // auto-property's backing field), neither of which anything
        // sensibly imports by name. Accessibility is left to the ordinary
        // reference-site check, exactly as it is for an explicit `use
        // X.member;` - importing does not itself require the name to be
        // usable from here, only reaching it later does.
        _is_wildcard_importable(symbol: Semantic.Symbols.Symbol) -> bool is
            if symbol.is_internal \/ symbol.is_constructor \/ symbol.is_static_constructor then
                return false
            fi

            if symbol.is_function_group then
                let fg = cast Semantic.Symbols.FUNCTION_GROUP?(symbol)!

                return fg.functions |> any(f => !f.is_instance /\ !f.is_constructor /\ !f.is_static_constructor)
            fi

            return !symbol.is_instance
        si

        // Imports a single resolved symbol into the namespace's scope,
        // under `alias`'s name when given and the symbol's own name
        // otherwise. Shared by an explicit `use X.member;` and, per member,
        // by `use X.*`'s expansion, so a wildcard import reports the same
        // diagnostics for the same shapes of symbol that the explicit
        // imports it stands for would.
        _import_symbol(
            used_symbol: Semantic.Symbols.Symbol,
            used_name: Identifiers.Identifier,
            alias: Identifiers.Identifier?,
            namespace_scope: Semantic.NAMESPACE_SCOPE
        ) is
            let use_name mut = used_symbol.name

            if alias? then
                use_name = alias.name
            fi

            if isa Semantic.Symbols.NAMESPACE(used_symbol) then
                _symbol_use_locations.add_symbol_use(used_name.right_location, used_symbol)

                if namespace_scope.contains_used_symbol(use_name) then
                    if alias? then
                        _logger.error(alias.location, "duplicate use")
                    else
                        _logger.error(used_name.location, "duplicate use")
                    fi
                elif alias? then
                    namespace_scope.add(alias.name, used_symbol)
                else
                    namespace_scope.add(used_symbol)
                fi
            elif used_symbol.is_function_group then
                let fg = cast Semantic.Symbols.FUNCTION_GROUP?(used_symbol)!

                if !(fg.functions |> any(f => !f.is_instance)) then
                    if fg.functions.count == 1 then
                        _logger.error(used_name.location, "cannot use instance function")
                    else
                        _logger.error(used_name.location, "cannot use function group comprising only instance functions")
                    fi
                fi

                _symbol_use_locations.add_symbol_use(used_name.right_location, used_symbol.collapse_group_if_single_member())

                let existing_used_symbol = namespace_scope.get_used_symbol(use_name)

                let use_function_group: Semantic.Symbols.FUNCTION_GROUP mut

                if existing_used_symbol? then
                    use_function_group = cast Semantic.Symbols.FUNCTION_GROUP?(existing_used_symbol)!
                else
                    use_function_group = Semantic.Symbols.FUNCTION_GROUP(LOCATION.unknown, namespace_scope, use_name)
                    namespace_scope.add(use_name, use_function_group)
                fi

                use_function_group.add(fg)
            elif !used_symbol.is_instance then
                if namespace_scope.contains_used_symbol(use_name) then
                    if alias? then
                        _logger.error(alias.location, "duplicate use")
                    else
                        _logger.error(used_name.location, "duplicate use")
                    fi
                else
                    _symbol_use_locations.add_symbol_use(used_name.right_location, used_symbol)
                    namespace_scope.add(use_name, used_symbol)
                fi
            else
                _logger.error(used_name.location, "cannot use instance member")
            fi
        si
    si
si
