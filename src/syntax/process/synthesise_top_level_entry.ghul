namespace Syntax.Process is
    use Source
    use Logging
    use Trees
    use Ghul.Pipes

    // Synthesises a global entry point from a file's top-level statements.
    //
    // A file with no namespace block may carry bare statements at file scope:
    // directly at the file root, or inside a whole-file namespace. The
    // parser collects them, in source order, onto the definition list that
    // carries them; this rewriter wraps them into a global function named
    // after the configured entry point, so every downstream phase sees an
    // ordinary function. At the file root it runs before
    // expand_namespaces, which then wraps the synthesised function into the
    // file's root namespace alongside any other global definitions. Inside
    // a whole-file namespace the entry is already in the namespace it
    // belongs to.
    //
    // Top-level statements and namespace blocks are mutually exclusive at
    // the file root: a file that carries both is a compile error and no
    // entry is synthesised.
    //
    // The entry takes the two shapes the runtime can hand an entry point -
    // `args: string[]` and `env: Ghul.Environment` - so the statements can
    // read the command line and the process environment directly, and a
    // Main-compatible `_entry` wrapper is synthesised beside it to carry
    // both in. Under `--target wasm`, which starts a program with no
    // arguments, each is declared only where the statements name it.
    //
    // It also marks the functions of a file without a namespace block that
    // are written with no types in their signatures, whose signatures are
    // then inferred, and forms the file's inference unit: those functions,
    // the entry, and the file's functions that call them or read a
    // top-level `let`, which compile-expressions walks as one body. No
    // function is moved.
    class SYNTHESISE_TOP_LEVEL_ENTRY(_entry_point: Compiler.ENTRY_POINT, _logger: Logger) is
        apply(node: Node) is
            if !isa Definitions.LIST(node) then
                return
            fi

            let list = cast Definitions.LIST(node)
            let statements = list.top_level_statements

            if !statements? then
                if _has_block_namespace(list) then
                    _report_untyped(list)
                else
                    _form_unit(list, null, Collections.LIST[string]())
                fi

                _descend_into_file_scope_namespaces(list)

                return
            fi

            list.top_level_statements = null

            // Top-level statements cannot share the *file root* with a
            // namespace block - the two scopes would overlap. A file-scope
            // namespace sibling means the declaration came too late to
            // carry them; the parser has already reported that. This list
            // is the file root, so the check runs only here: inside a
            // whole-file namespace a sibling block namespace is fine - it
            // nests below the statements, not beside them at file scope.
            for definition in list do
                if let `namespace = cast Definitions.NAMESPACE?(definition) then
                    if !`namespace.is_file_scope then
                        _logger.error(
                            statements.location,
                            "top-level-statements-in-namespace", "top-level statements cannot appear in a file with a namespace"
                        )

                        _report_untyped(list)

                        return
                    fi
                fi
            od

            _synthesise(list, statements)
        si

        _synthesise(list: Definitions.LIST, statements: Statements.LIST) is
            let let_names = Collections.LIST[string]()

            for statement in statements do
                if isa Statements.LET(statement) then
                    for variable in statement.variables do
                        variable.is_top_level = true

                        if variable.name? then
                            let_names.add(variable.name.name)
                        fi

                        if _reject_entry_parameter_collision(variable) then
                            statement.poison()
                            variable.poison()
                        fi
                    od
                fi
            od

            // Pushed to the front so compile-expressions walks the entry
            // before any other function in the file: the top-level `let`
            // variables it declares settle their inferred types during the
            // entry's own walk, and every sibling function reads them
            // after that.
            let entry = _synthesise_entry(statements, _keeps_both_parameters(list))

            list.push(entry)

            _form_unit(list, entry, let_names)

            _check_used_before_lets(statements, entry)
        si

        // A top-level `let` is initialised when its statement runs, so a
        // statement above it that calls a function of the file reading it,
        // directly or through the functions that one calls, would read it
        // before it holds its value. The functions are those of the file's
        // inference unit; a name a function declares itself is its own.
        _check_used_before_lets(statements: Statements.LIST, entry: Definitions.FUNCTION) is
            if !entry.inference_unit? then
                return
            fi

            let functions = Collections.LIST[Definitions.FUNCTION]()

            for member in entry.inference_unit.members do
                if member != entry /\ member.name? /\ member.body? then
                    functions.add(member)
                fi
            od

            if functions.count == 0 then
                return
            fi

            let scanner = NAME_REFERENCE_SCANNER()
            let declared = DECLARED_NAME_SCANNER()

            let all = Collections.LIST[Statements.Statement](statements)

            // Where each top-level `let` name is declared.
            let declared_at = Collections.MAP[string, int]()

            for (index, statement) in all |> index() do
                if let `let: Statements.LET = statement then
                    for variable in `let.variables do
                        for name in variable.names do
                            if !declared_at.contains_key(name.name) then
                                declared_at[name.name] = index
                            fi
                        od
                    od
                fi
            od

            if declared_at.count == 0 then
                return
            fi

            reads(function: Definitions.FUNCTION, name: string) -> bool =>
                scanner.body_references(function.body, name) /\ !declared.declares(function, name)

            // The latest top-level `let` the function reads, directly or
            // through the file's functions it calls, and its name.
            latest_read(start: Definitions.FUNCTION) -> (int, string)? is
                let seen = Collections.SET[Definitions.FUNCTION]()
                let pending = Collections.LIST[Definitions.FUNCTION]([start])
                let latest: (int, string)? mut = null

                while pending.count > 0 do
                    let next = pending[pending.count - 1]
                    pending.remove_at(pending.count - 1)

                    if seen.add(next) then
                        for pair in declared_at do
                            if (!latest? \/ pair.value > latest.`0) /\ reads(next, pair.key) then
                                latest = (pair.value, pair.key)
                            fi
                        od

                        for other in functions do
                            if scanner.body_references(next.body, other.name!.name) then
                                pending.add(other)
                            fi
                        od
                    fi
                od

                latest
            si

            for (index, statement) in all |> index() do
                for function in functions do
                    if scanner.node_references(statement, function.name!.name) then
                        if let (at, name) = latest_read(function) /\ at >= index then
                            _logger.error(
                                statement.location,
                                "top-level-let-used-before-declared", "{function.name!.name} is used before the top-level let it reads, {name}, is declared")

                            return
                        fi
                    fi
                od
            od
        si

        // The file's functions written with no type anywhere in their
        // signature have their signatures inferred from the file's own uses
        // of them. They, the entry and the file's other functions that call
        // them or read its top-level `let`s are walked together as one
        // inference body, so a call in any of them bounds a parameter of
        // another and the `let`s are typed from every use. Every other
        // argument left without a type is reported.
        _form_unit(list: Definitions.LIST, entry: Definitions.FUNCTION?, let_names: Collections.List[string]) is
            let functions = Collections.LIST[Definitions.FUNCTION]()

            for d in list do
                if let function = cast Definitions.FUNCTION?(d.without_pragmas) then
                    functions.add(function)
                fi
            od

            let inferred = Collections.LIST[Definitions.FUNCTION]()

            if !IoC.CONTAINER.instance.build_flags.no_whole_file_inference then
                for d in list do
                    // A function carrying a pragma is a method the pragma
                    // describes, whose signature is written out.
                    if let function = cast Definitions.FUNCTION?(d) /\ _is_unannotated(function) /\ _count_named(functions, function.name!.name) == 1 then
                        inferred.add(function)
                    fi
                od
            fi

            for function in functions do
                if inferred.contains(function) then
                    function.is_inferred_signature = true
                else
                    report_untyped_arguments(function, _logger)
                fi
            od

            let names = Collections.LIST[string](let_names)
            let file = list.location.file_name

            for function in inferred do
                names.add(function.name!.name)

                if !_inferred_by_file.contains_key(file) then
                    _inferred_by_file[file] = Collections.LIST[string]()
                fi

                _inferred_by_file[file].add(function.name!.name)

                if function.arguments.count == 0 then
                    if !_parameterless_by_file.contains_key(file) then
                        _parameterless_by_file[file] = Collections.LIST[string]()
                    fi

                    _parameterless_by_file[file].add(function.name!.name)
                fi
            od

            if inferred.count == 0 /\ (!entry? \/ let_names.count == 0) then
                return
            fi

            let scanner = NAME_REFERENCE_SCANNER()

            let joining = Collections.LIST[Definitions.FUNCTION](inferred)

            for function in functions do
                if
                    !inferred.contains(function) /\
                    _can_join_unit(function) /\
                    names |> any(name => scanner.body_references(function.body, name))
                then
                    joining.add(function)
                fi
            od

            if let e = entry then
                joining.add(e)
            fi

            let unit = INFERENCE_UNIT()

            for name in names do
                unit.names.add(name)
            od

            for function in _callees_first(joining, let_names, scanner) do
                unit.add(function)
            od

            // A member walked before the entry that reads a top-level `let`
            // reads it before the entry's walk has typed it.
            for member in unit.members do
                if member.is_top_level_entry then
                    break
                fi

                if let_names |> any(name => scanner.body_references(member.body, name)) then
                    unit.reads_lets_before_entry = true
                    break
                fi
            od

            // Whether anything walked before a member, or the member itself,
            // names it, and so reads its return before the walk has settled it.
            for (index, member) in unit.members |> index() do
                if let name = member.name /\ !member.is_top_level_entry then
                    for earlier in 0::index do
                        if scanner.body_references(unit.members[earlier].body, name.name) then
                            unit.read_early.add(member)
                            break
                        fi
                    od
                fi
            od

            // An entry with nothing walked beside it needs no unit.
            if inferred.count == 0 /\ unit.members.count < 2 then
                for function in unit.members do
                    function.inference_unit = null
                od
            fi
        si

        // The functions in an order where each comes after the functions it
        // calls where it can, so a walk reaches a callee's return before
        // its callers read it. Functions that call each other keep the
        // order they are written in.
        _callees_first(functions: Collections.List[Definitions.FUNCTION], let_names: Collections.List[string], scanner: NAME_REFERENCE_SCANNER) -> Collections.List[Definitions.FUNCTION] is
            let result = Collections.LIST[Definitions.FUNCTION]()
            let placed = Collections.SET[Definitions.FUNCTION]()

            // A function written with its types that reads a top-level
            // `let` goes after the entry, whose walk types the `let`: what
            // it returns doesn't depend on where it is walked, so nothing
            // is gained by walking it before the entry, and its reads would
            // see the `let` untyped.
            let after_entry = Collections.SET[Definitions.FUNCTION]()

            for function in functions do
                if
                    !function.is_inferred_signature /\
                    !function.is_top_level_entry /\
                    let_names |> any(name => scanner.body_references(function.body, name))
                then
                    after_entry.add(function)
                fi
            od

            place(function: Definitions.FUNCTION) is
                if !placed.add(function) then
                    return
                fi

                for other in functions do
                    if
                        other != function /\ other.name? /\ !other.is_top_level_entry /\ !after_entry.contains(other) /\
                        scanner.body_references(function.body, other.name.name)
                    then
                        place(other)
                    fi
                od

                result.add(function)
            si

            for function in functions do
                if !after_entry.contains(function) then
                    place(function)
                fi
            od

            for function in functions do
                place(function)
            od

            result
        si

        // The functions each file had its signatures inferred for, by
        // name, so a use of one from another file can be told apart from a
        // name that was never declared.
        _inferred_by_file: Collections.MAP[string, Collections.LIST[string]] static

        // Those of them with no parameters.
        _parameterless_by_file: Collections.MAP[string, Collections.LIST[string]] static

        init() static is
            _inferred_by_file = Collections.MAP[string, Collections.LIST[string]]()
            _parameterless_by_file = Collections.MAP[string, Collections.LIST[string]]()
        si

        // Whether `file` infers the signature of a function of this name
        // that has no parameters.
        is_parameterless_inferred(file: string, name: string) -> bool static =>
            _parameterless_by_file.contains_key(file) /\ _parameterless_by_file[file].contains(name)

        // The file whose functions include one of this name with an inferred
        // signature, if any file's do.
        file_inferring(name: string) -> string? static is
            for pair in _inferred_by_file do
                if pair.value.contains(name) then
                    return pair.key
                fi
            od

            return null
        si

        _report_untyped(list: Definitions.LIST) is
            for d in list do
                if let function = cast Definitions.FUNCTION?(d.without_pragmas) then
                    report_untyped_arguments(function, _logger)
                fi
            od
        si

        _count_named(functions: Collections.List[Definitions.FUNCTION], name: string) -> int is
            let result mut = 0

            for f in functions do
                if f.name? /\ f.name.name =~ name then
                    result = result + 1
                fi
            od

            result
        si

        _is_unannotated(function: Definitions.FUNCTION) -> bool =>
            !function.is_poisoned /\
            function.name? /\
            !function.is_top_level_entry /\
            function.name.name !~ _entry_point.name /\
            function.name.name.length > 0 /\
            (function.name.name[0].is_letter \/ function.name.name[0] == '_') /\
            function.body? /\
            function.generic_arguments.count == 0 /\
            _has_only_literal_markers(function.modifiers) /\
            function.type_expression.is_inferred /\
            function.arguments |> all(a => a.untyped_deferred /\ !a.is_poisoned /\ a.left.is_simple_name /\ a.name? /\ !a.initializer?)

        // Whether a function written with types can be walked with the
        // file's inference unit: one with a body and no type parameters of
        // its own.
        _can_join_unit(function: Definitions.FUNCTION) -> bool =>
            !function.is_poisoned /\
            function.name? /\
            !function.is_top_level_entry /\
            function.body? /\
            function.generic_arguments.count == 0

        // Whether a function's modifiers are only the `memo` and `pure`
        // markers a function literal can carry as well.
        _has_only_literal_markers(modifiers: Trees.Modifiers.LIST) -> bool =>
            !modifiers.access_modifier? /\
            !modifiers.storage_class? /\
            !modifiers.is_abstract /\
            !modifiers.is_stable

        _has_block_namespace(list: Definitions.LIST) -> bool is
            for definition in list do
                if let `namespace = cast Definitions.NAMESPACE?(definition.without_pragmas) /\ !`namespace.is_file_scope then
                    return true
                fi
            od

            return false
        si

        // An argument a file-level function was written without a type
        // where its signature can't be inferred: a file that opens a block
        // namespace, a function whose signature names some types but not
        // others, or a build with whole-file inference turned off.
        report_untyped_arguments(function: Definitions.FUNCTION, logger: Logger) static is
            let reported mut = false

            for a in function.arguments do
                if a.untyped_deferred /\ !a.is_poisoned then
                    a.untyped_deferred = false

                    logger.error(a.location, "explicit-argument-type-required", "explicit argument type required")

                    a.poison(true)
                    function.poison(true)
                    reported = true
                fi
            od

            if reported then
                function.is_missing_types_reported = true
            fi
        si

        // A whole-file namespace carries the file's top-level statements on
        // its own body list, one nesting level down from where this pass
        // reads them. Descend and synthesise the entry there, inside the
        // namespace - directly, not through apply, whose root-only mix
        // check does not apply one level down.
        _descend_into_file_scope_namespaces(list: Definitions.LIST) is
            for definition in list do
                if let `namespace = cast Definitions.NAMESPACE?(definition.without_pragmas) then
                    if `namespace.is_file_scope then
                        let body = `namespace.body
                        let statements = body.top_level_statements

                        if statements? then
                            body.top_level_statements = null
                            _synthesise(body, statements)
                        elif _has_block_namespace(body) then
                            _report_untyped(body)
                        else
                            _form_unit(body, null, Collections.LIST[string]())
                        fi

                        _descend_into_file_scope_namespaces(body)
                    fi
                fi
            od
        si

        // Whether a file's root definition list carries a synthesised
        // top-level entry. Consulted wherever that file needs treating
        // differently: it compiles first, and it takes the full-rebuild
        // path in analysis mode.
        has_top_level_entry(definition: Node?) -> bool static is
            if let list = cast Definitions.LIST?(definition) then
                for d in list do
                    let unwrapped = d.without_pragmas

                    if let function = cast Definitions.FUNCTION?(unwrapped) then
                        if function.is_top_level_entry then
                            return true
                        fi
                    elif let `namespace = cast Definitions.NAMESPACE?(unwrapped) then
                        // Expand-namespaces wraps a namespace-less file's
                        // definitions - the synthesised entry among them -
                        // into a file-private namespace, so the entry sits
                        // one list down once that pass has run.
                        if has_top_level_entry(`namespace.body) then
                            return true
                        fi
                    fi
                od
            fi

            return false
        si

        // Marks every inference unit in a file's definitions as still to be
        // walked, for a re-walk of the file's bodies.
        reset_units(definition: Node?) static is
            if let list = cast Definitions.LIST?(definition) then
                for d in list do
                    let unwrapped = d.without_pragmas

                    if let function = cast Definitions.FUNCTION?(unwrapped) then
                        if let unit = function.inference_unit then
                            unit.is_compiled = false
                        fi
                    elif let `namespace = cast Definitions.NAMESPACE?(unwrapped) then
                        reset_units(`namespace.body)
                    fi
                od
            fi
        si

        // Whether a file's definitions include a function whose signature is
        // inferred, at the root or inside the namespace a whole-file
        // namespace or expand-namespaces wrapped them in.
        has_inferred_signatures(definition: Node?) -> bool static is
            if let list = cast Definitions.LIST?(definition) then
                for d in list do
                    let unwrapped = d.without_pragmas

                    if let function = cast Definitions.FUNCTION?(unwrapped) then
                        if function.is_inferred_signature then
                            return true
                        fi
                    elif let `namespace = cast Definitions.NAMESPACE?(unwrapped) then
                        if has_inferred_signatures(`namespace.body) then
                            return true
                        fi
                    fi
                od
            fi

            return false
        si

        // The entry's implicit `args` and `env` formals are in scope across
        // the whole entry body, so a top-level `let` of either name would
        // shadow - and be shadowed by - them inside the statements. Name
        // resolution from the body finds the formal first, so the let's
        // inferred type lands on the formal and the global's type is never
        // set; reporting the collision here turns that silent mis-compile
        // into a diagnostic.
        _reject_entry_parameter_collision(variable: Variables.VARIABLE) -> bool is
            let name = variable.name

            if name? /\ (name.name =~ "args" \/ name.name =~ "env") then
                _logger.error(
                    name.location,
                    "top-level-name-collides-with-entry-parameter", "a top-level '{name.name}' collides with the entry point's '{name.name}' parameter; use another name")

                return true
            fi

            return false
        si

        // Whether the entry keeps both parameters whatever its statements
        // read. It does on .NET, where a host such as a session calls it
        // with both and a stack trace names it with both; for a cell, which
        // the session's own entry calls with both whatever it reads; and beside a
        // function the file declares under the entry's name, which outranks
        // the statements and could otherwise collide with a narrower
        // overload. Only a target that starts a program with no arguments
        // takes the narrower entry.
        _keeps_both_parameters(list: Definitions.LIST) -> bool is
            if IoC.CONTAINER.instance.target_profile.entry_takes_arguments \/ IoC.CONTAINER.instance.build_flags.want_cells then
                return true
            fi

            for d in list do
                if let function = cast Definitions.FUNCTION?(d.without_pragmas) then
                    if function.name? /\ function.name.name =~ _entry_point.name then
                        return true
                    fi
                fi
            od

            return false
        si

        // A submission's entry returns the value of its final expression
        // to whatever ran it, so it is declared to return any value or
        // none and the ordinary tail rule does the rest: a final
        // expression of any type is assignable to it, and a final
        // statement with no value leaves the entry returning nothing.
        _return_type(location: LOCATION) -> TypeExpressions.TypeExpression =>
            if IoC.CONTAINER.instance.build_flags.is_session_step then
                TypeExpressions.OPTIONAL(
                    location,
                    TypeExpressions.NAMED(location, Identifiers.Identifier(location, "object")))
            else
                TypeExpressions.INFER(location)
            fi

        _synthesise_entry(statements: Statements.LIST, keep_both: bool) -> Definitions.FUNCTION is
            let location = statements.location

            let arguments = Collections.LIST[Variables.VARIABLE]()

            // The two shapes the runtime can hand an entry point (GHUL.md,
            // "functions"), so the statements can read the command line as
            // `args` and the process environment as `env`. The wrapper
            // synthesise-entry-environment-wrapper builds beside this
            // function is what carries the environment in. Under
            // `--target wasm` each is declared only where the statements name
            // it, so an entry that reads neither takes no arguments.
            //
            // Like the entry's name below, the formals and their types
            // carry an internal location: at the statement span they would
            // record uses covering the whole region, and a hover or a
            // completion anywhere in the statements would land on them.
            let internal = LOCATION.internal

            let body = Bodies.BLOCK(location, statements)
            let scanner = NAME_REFERENCE_SCANNER()

            if keep_both \/ scanner.body_references(body, "args") then
                let args_type = TypeExpressions.ARRAY_(internal, TypeExpressions.NAMED(internal, Identifiers.Identifier(internal, "string")), true, 1)
                let args_param = Variables.VARIABLE(internal, Identifiers.Identifier(internal, "args"), args_type, false, true, null)
                args_param.mark_argument()
                arguments.add(args_param)
            fi

            if keep_both \/ scanner.body_references(body, "env") then
                let env_type = TypeExpressions.NAMED(
                    internal,
                    Identifiers.QUALIFIED(
                        internal,
                        Identifiers.Identifier(internal, "Ghul"),
                        "Environment",
                        internal,
                        internal))
                let env_param = Variables.VARIABLE(internal, Identifiers.Identifier(internal, "env"), env_type, false, true, null)
                env_param.mark_argument()
                arguments.add(env_param)
            fi

            let result = Definitions.FUNCTION(
                location,
                // The entry has no declaration the source names, so its
                // identifier carries an internal location: a name at the
                // statement span would record a hover use covering the whole
                // region, and any hover on a non-symbol position there would
                // report the synthesised entry.
                Identifiers.Identifier(LOCATION.internal, _entry_point.name),
                TypeExpressions.LIST(location, Collections.LIST[TypeExpressions.TypeExpression](0)),
                Variables.LIST(location, arguments),
                _return_type(LOCATION.internal),
                Modifiers.LIST(location, null, null),
                body
            )

            result.is_top_level_entry = true

            return result
        si
    si
si
