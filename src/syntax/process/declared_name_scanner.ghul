namespace Syntax.Process is

    // Whether a definition declares a name of its own anywhere inside it: a
    // parameter, a local, or a parameter of a literal written within it.
    // Paired with NAME_REFERENCE_SCANNER to tell a reference to an outer
    // local from a use of an inner name that happens to share its spelling.
    //
    // The test ignores where in the definition the name is declared, so a
    // definition that declares a name and also reads an outer one with the
    // same spelling is taken to read only its own.
    class DECLARED_NAME_SCANNER: Visitor is
        _name: string
        _found: bool

        init() is
            super.init()

            _name = ""
        si

        declares(node: Trees.Node, name: string) -> bool is
            _name = name
            _found = false

            node.walk(self)

            return _found
        si

        pre(variable: Trees.Variables.VARIABLE) -> bool is
            if let names = variable.left.names then
                _check(names)
            fi

            return _found
        si

        pre(variable: Trees.Expressions.VARIABLE) -> bool is
            if variable.name.name =~ _name then
                _found = true
            elif let left = variable.left then
                if let names = left.names then
                    _check(names)
                fi
            fi

            return _found
        si

        _check(names: Collections.Iterator[Trees.Identifiers.Identifier]) is
            for name in names do
                if name.name =~ _name then
                    _found = true
                fi
            od
        si
    si
si
