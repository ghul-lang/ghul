namespace Syntax.Process is
    use Function = Semantic.Symbols.Function
    use Symbol = Semantic.Symbols.Symbol
    use Semantic.Symbols.STORE_FREE_IMPORTS

    // One solve's worth of whole-program effect facts: per function,
    // the members it may write, the members it may assign a
    // possibly-absent value, and the members its getter closure reads,
    // each folded over everything the function can dispatch to or
    // invoke. Keyed by symbol id on both axes - a specialized function
    // or member queries as its root - so facts recorded against one
    // instantiation answer for all of them, and so the relations
    // outlive the symbol objects: a symbol re-created by an
    // incremental edit or a rebuild adopts its predecessor's id and
    // is answered for as before.
    //
    // `complete` says the solve covered every body of the program with
    // the types compile-expressions resolved. An analysis-mode rebuild
    // with files closed solves over declared types for those files and
    // is not complete: its dispatch is coarser, so its relations are
    // more pessimistic than the program warrants.
    class EFFECT_RELATIONS is
        write_sets: Collections.MAP[int, Collections.SET[int]]
        write_unbounded: Collections.SET[int]
        null_sets: Collections.MAP[int, Collections.SET[int]]
        null_unbounded: Collections.SET[int]
        store_free: Collections.SET[int]
        constructs_store_free: Collections.SET[int]
        read_sets: Collections.MAP[int, Collections.SET[int]]
        read_unbounded: Collections.SET[int]
        reads_elements: Collections.SET[int]
        writes_elements: Collections.SET[int]
        complete: bool

        init(
            write_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            write_unbounded: Collections.SET[Function],
            null_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            null_unbounded: Collections.SET[Function],
            store_free: Collections.SET[Function],
            constructs_store_free: Collections.SET[Function],
            read_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            read_unbounded: Collections.SET[Function],
            reads_elements: Collections.SET[Function],
            writes_elements: Collections.SET[Function],
            complete: bool
        ) is
            self.write_sets = _ids_of(write_sets)
            self.write_unbounded = _ids_of(write_unbounded)
            self.null_sets = _ids_of(null_sets)
            self.null_unbounded = _ids_of(null_unbounded)
            self.store_free = _ids_of(store_free)
            self.constructs_store_free = _ids_of(constructs_store_free)
            self.read_sets = _ids_of(read_sets)
            self.read_unbounded = _ids_of(read_unbounded)
            self.reads_elements = _ids_of(reads_elements)
            self.writes_elements = _ids_of(writes_elements)
            self.complete = complete
        si

        _ids_of(map: Collections.MutableMap[Function, Collections.SET[Symbol]]) -> Collections.MAP[int, Collections.SET[int]] static is
            let result = Collections.MAP[int, Collections.SET[int]]()

            for entry in map do
                let members = Collections.SET[int]()

                for member in entry.value do
                    members.add(member.id)
                od

                result[entry.key.id] = members
            od

            return result
        si

        _ids_of(functions: Collections.SET[Function]) -> Collections.SET[int] static is
            let result = Collections.SET[int]()

            for function in functions do
                result.add(function.id)
            od

            return result
        si
    si

    // The solved effect relations the narrowing walk and the kill
    // ledger read. Every query answers conservatively until a solve is
    // installed, and again after clear().
    //
    // Why a walk only ever kills from a complete solve, and why a
    // source function the solve did not see answers as harmless: the
    // walk and the solve feed each other. A fact killed at a call
    // widens the view the rest of the body reads, a wider receiver
    // dispatches more coarsely, a coarser dispatch bounds fewer
    // callees, and the next solve then justifies the kill with the
    // relations the kill itself made worse. Started from every fact
    // kept, the descent only kills what the relations of the program
    // as it is cannot back, and settles at the most precise answer;
    // started from a pessimistic guess, it can settle short of it. So
    // an incomplete solve never displaces a complete one, and a source
    // function unknown to the relations in use - declared since the
    // last complete solve - is taken to leave every fact alone until a
    // complete solve says otherwise. Every such decision is on the
    // ledger and re-asked.
    class EFFECTS is
        _relations: EFFECT_RELATIONS? static

        is_solved: bool static => _relations?

        // Whether the relations in use came from a complete solve.
        is_complete: bool static =>
            if let relations = _relations then relations.complete else false fi

        install(
            write_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            write_unbounded: Collections.SET[Function],
            null_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            null_unbounded: Collections.SET[Function],
            store_free: Collections.SET[Function],
            constructs_store_free: Collections.SET[Function],
            read_sets: Collections.MutableMap[Function, Collections.SET[Symbol]],
            read_unbounded: Collections.SET[Function],
            reads_elements: Collections.SET[Function],
            writes_elements: Collections.SET[Function],
            complete: bool
        ) static is
            if !complete /\ is_complete then
                if Driver.COMPILER_ENVIRONMENT.effects_timing then
                    IO.Std.error.write_line("effects: incomplete solve not installed over the complete one")
                fi

                return
            fi

            _relations = EFFECT_RELATIONS(
                write_sets, write_unbounded,
                null_sets, null_unbounded,
                store_free, constructs_store_free,
                read_sets, read_unbounded, reads_elements, writes_elements,
                complete)
        si

        clear() static is
            _relations = null
        si

        _root_of(callee: Function?) -> Function? static =>
            if let c = callee then cast Function?(c.root_specialized_from) else null fi

        // Whether the relations in use saw this function's body.
        knows(callee: Function?) -> bool static is
            if let relations = _relations, root = _root_of(callee) then
                return relations.write_sets.contains_key(root.id)
            fi

            return false
        si

        // A source function the relations did not see is taken to be
        // harmless; see the class comment. An import was never going
        // to be walked and keeps the conservative default.
        _unknown_source(root: Function) -> bool static =>
            !root.location.is_reflected /\ !root.location.is_internal

        // May calling `callee` - or anything it can reach - store to
        // `member` through any receiver? Conservatively yes when
        // nothing is solved, when the callee's write set could not be
        // bounded, or when the callee is an import that is neither
        // declared pure nor on the curated store-free whitelist.
        may_write(callee: Function?, member: Symbol?) -> bool static =>
            if let m = member then may_write(callee, m.root_specialized_from.id) else true fi

        may_write(callee: Function?, member_id: int) -> bool static =>
            _may_touch(callee, member_id, true)

        // May calling `callee` - or anything it can reach - assign a
        // possibly-absent value to `member`? Same defaults as may_write.
        may_null(callee: Function?, member: Symbol?) -> bool static =>
            if let m = member then _may_touch(callee, m.root_specialized_from.id, false) else true fi

        _may_touch(callee: Function?, member_id: int, writes: bool) -> bool static is
            let relations = _relations
            let root = _root_of(callee)

            if !relations? \/ !root? then
                return true
            fi

            let sets = if writes then relations.write_sets else relations.null_sets fi
            let unbounded = if writes then relations.write_unbounded else relations.null_unbounded fi

            if !sets.contains_key(root.id) then
                if _unknown_source(root) then
                    return false
                fi

                // an import: a store-free or receiver-interior one
                // writes no ghul member; anything else could
                return !_trusted_leaf(root) /\ !root.writes_only_receiver_interior
            fi

            if unbounded.contains(root.id) then
                return true
            fi

            return sets[root.id].contains(member_id)
        si

        // Does `callee` provably store nothing at all - member writes,
        // element writes, and everything reachable included? The
        // strong answer property facts need, since a getter can read
        // any of it.
        is_store_free(callee: Function?) -> bool static is
            let root = _root_of(callee)

            if !root? then
                return false
            fi

            // The declared, whitelisted and already-proven answers
            // are sound however this run's solve went, so take the
            // union with the solved set rather than replacing it.
            if root.is_store_free then
                return true
            fi

            if let relations = _relations then
                if relations.store_free.contains(root.id) then
                    return true
                fi

                return !relations.write_sets.contains_key(root.id) /\ _unknown_source(root)
            fi

            return false
        si

        // Does calling `callee` as a constructor on a fresh receiver
        // provably leave every pre-existing heap slot alone? Weaker
        // than store-free - the body may write its own receiver's
        // state - but just as harmless to any fact established before
        // the construction, since nothing pre-existing can reach the
        // fresh object.
        constructs_store_free(callee: Function?) -> bool static is
            if is_store_free(callee) then
                return true
            fi

            if let relations = _relations, root = _root_of(callee) then
                return relations.constructs_store_free.contains(root.id)
            fi

            return false
        si

        // The solved write set of `function`, or null when it is unbounded
        // or unknown. Measurement only.
        write_set_of(function: Function) -> Collections.SET[int]? static is
            if let relations = _relations, root = _root_of(function) then
                if relations.write_unbounded.contains(root.id) \/ !relations.write_sets.contains_key(root.id) then
                    return null
                fi

                return relations.write_sets[root.id]
            fi

            return null
        si

        _trusted_leaf(root: Function) -> bool static =>
            root.is_store_free \/ STORE_FREE_IMPORTS.is_store_free(root)

        // The ids of the members in `getter`'s read closure, or null
        // when it cannot be bounded (unsolved, an unwalked import, or
        // the closure reaches something unboundable). An unknown
        // source getter reads nothing the relations know of.
        getter_read_closure(getter: Function?) -> Collections.SET[int]? static is
            let relations = _relations
            let root = _root_of(getter)

            if !relations? \/ !root? then
                return null
            fi

            if !relations.read_sets.contains_key(root.id) then
                return if _unknown_source(root) then Collections.SET[int]() else null fi
            fi

            if relations.read_unbounded.contains(root.id) then
                return null
            fi

            return relations.read_sets[root.id]
        si

        // Whether the getter's closure may read collection or array
        // elements. Conservatively yes when nothing is solved.
        getter_reads_elements(getter: Function?) -> bool static is
            let relations = _relations
            let root = _root_of(getter)

            if !relations? \/ !root? then
                return true
            fi

            if !relations.read_sets.contains_key(root.id) /\ _unknown_source(root) then
                return false
            fi

            return relations.reads_elements.contains(root.id)
        si

        // May calling `callee` write a collection or array element?
        // Conservatively yes; the trusted store-free tiers write
        // nothing at all, while a receiver-interior mutator writes
        // exactly this.
        may_write_elements(callee: Function?) -> bool static is
            let relations = _relations
            let root = _root_of(callee)

            if !relations? \/ !root? then
                return true
            fi

            if relations.write_sets.contains_key(root.id) then
                return relations.writes_elements.contains(root.id)
            fi

            if _unknown_source(root) \/ _trusted_leaf(root) then
                return false
            fi

            return true
        si
    si
si
