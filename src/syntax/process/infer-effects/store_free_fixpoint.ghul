namespace Syntax.Process is
    use Function = Semantic.Symbols.Function
    use Semantic.Symbols.STORE_FREE_IMPORTS

    // Solves the per-function facts gathered by INFER_STORE_FREE's
    // body walk into the set of functions that cannot be shown
    // store-free.
    //
    // A function is unsafe if its body disqualified it, if a call
    // bound to it could dispatch to an override outside the
    // compilation, or if any bounded callee or any override of it is
    // unsafe; unsafety propagates to a fixpoint and everything never
    // reached is store-free. Mutual recursion between clean bodies is
    // never seeded, so it correctly ends up store-free.
    class STORE_FREE_FIXPOINT is
        init() is si

        solve(
            facts: Collections.MutableMap[Function, STORE_FREE_FACTS]
        ) -> (unsafe: Collections.SET[Function], construction_unsafe: Collections.SET[Function]) =>
            solve(facts, EFFECT_DEPENDANTS(facts, EFFECT_SOLVERS(facts).param_invokers))

        solve(
            facts: Collections.MutableMap[Function, STORE_FREE_FACTS],
            dependants: EFFECT_DEPENDANTS
        ) -> (unsafe: Collections.SET[Function], construction_unsafe: Collections.SET[Function]) =>
            solve(facts, dependants, null, null)

        // With `previous` and `affected`, only the affected functions
        // are judged; every other function keeps the bits `previous`
        // gave it, its inputs being unchanged.
        solve(
            facts: Collections.MutableMap[Function, STORE_FREE_FACTS],
            dependants: EFFECT_DEPENDANTS,
            previous: EFFECT_SOLUTION?,
            affected: Collections.SET[Function]?
        ) -> (unsafe: Collections.SET[Function], construction_unsafe: Collections.SET[Function]) is
            let unsafe = Collections.SET[Function]()

            // The same relation over the construction bit: a function
            // is construction-unsafe when it writes something other
            // than the state of the object it is called on. The two
            // are solved together because they are mutually recursive
            // - a construction edge makes a strictly store-free caller
            // depend on its callee's construction bit.
            let construction_unsafe = Collections.SET[Function]()

            let judged = Collections.LIST[Function]()

            for function in facts.keys do
                if previous? /\ affected? /\ !affected.contains(function) then
                    if !previous.store_free.contains(function) then
                        unsafe.add(function)
                    fi

                    if !previous.constructs_store_free.contains(function) then
                        construction_unsafe.add(function)
                    fi

                    continue
                fi

                judged.add(function)

                let shadowed = is_openly_dispatchable(function)

                if facts[function].is_disqualified \/ shadowed then
                    unsafe.add(function)
                fi

                if facts[function].is_construction_disqualified \/ shadowed then
                    construction_unsafe.add(function)
                fi
            od

            // Every function is judged once; a function is judged
            // again only when something it depends on became unsafe.
            let dirty mut = Collections.SET[Function]()

            for function in judged do
                if _demote(function, facts, unsafe, construction_unsafe) then
                    dirty.add(function)
                fi
            od

            while dirty.count > 0 do
                let next = Collections.SET[Function]()

                for target in dirty do
                    for functions in [dependants.dependants_of(target), dependants.dependants_through_unwalked(target)] do
                        if !functions? then
                            continue
                        fi

                        for function in functions do
                            if _demote(function, facts, unsafe, construction_unsafe) then
                                next.add(function)
                            fi
                        od
                    od
                od

                dirty = next
            od

            return (unsafe = unsafe, construction_unsafe = construction_unsafe)
        si

        // Judge both bits of one function against the current sets;
        // returns whether either was newly set.
        _demote(
            function: Function,
            facts: Collections.MutableMap[Function, STORE_FREE_FACTS],
            unsafe: Collections.SET[Function],
            construction_unsafe: Collections.SET[Function]
        ) -> bool is
            let demoted mut = false

            if
                !unsafe.contains(function) /\
                !_all_dependencies_safe(function, facts, unsafe, construction_unsafe, false)
            then
                unsafe.add(function)
                demoted = true
            fi

            if
                !construction_unsafe.contains(function) /\
                !_all_dependencies_safe(function, facts, unsafe, construction_unsafe, true)
            then
                construction_unsafe.add(function)
                demoted = true
            fi

            return demoted
        si

        // Whether every dependency of `function` is safe under the bit
        // being solved. Both bits share the dependency set and differ
        // only in which one each dependency is read against: the
        // dispatch shadow is checked against the bit under solution,
        // because an override reached in place of this function has to
        // meet the same promise this function is making.
        _all_dependencies_safe(
            function: Function,
            facts: Collections.MutableMap[Function, STORE_FREE_FACTS],
            unsafe: Collections.SET[Function],
            construction_unsafe: Collections.SET[Function],
            for_construction: bool
        ) -> bool is
            for callee in facts[function].callees do
                if !_target_is_safe(callee, facts, unsafe) then
                    return false
                fi
            od

            for callee in facts[function].construction_callees do
                if !_construction_target_is_safe(callee, facts, unsafe, construction_unsafe) then
                    return false
                fi
            od

            // Effect-polymorphic over invoked function-typed
            // parameters, exactly as the write-set solver's absorption
            // is: a body that invokes one is bounded by the values
            // recorded flowing in at its call sites, and a value
            // nothing could name makes the invocation unboundable.
            // Without this, a wrapper that only invokes its parameter
            // solves store-free however much the value it was handed
            // stores.
            let record = EFFECT_FACTS.record_for(function)

            if record? /\ record.invokes_function_param then
                if EFFECT_FACTS.passed_opaque.contains(function) then
                    return false
                fi

                let passed = EFFECT_FACTS.passed_functions_for(function)

                if passed? then
                    for value in passed do
                        if !_target_is_safe(value, facts, unsafe) then
                            return false
                        fi
                    od
                fi
            fi

            // a call bound to this function may dispatch to any
            // override of it
            let overriders = function.overriders

            if overriders? then
                for overrider in overriders do
                    if !isa Function(overrider) then
                        return false
                    fi

                    let overrider_function = cast Function(overrider)

                    if !facts.contains_key(overrider_function) then
                        return false
                    fi

                    if for_construction then
                        if construction_unsafe.contains(overrider_function) then
                            return false
                        fi
                    elif unsafe.contains(overrider_function) then
                        return false
                    fi
                od
            fi

            return true
        si

        // A target reached on a fresh receiver is safe when it writes
        // nothing beyond that receiver's own state. Only functions this
        // compilation walked carry that classification; anything else
        // has to clear the strict bar instead.
        _construction_target_is_safe(
            target: Function,
            facts: Collections.MutableMap[Function, STORE_FREE_FACTS],
            unsafe: Collections.SET[Function],
            construction_unsafe: Collections.SET[Function]
        ) -> bool is
            if target.is_declared_pure then
                return true
            fi

            if facts.contains_key(target) then
                return !construction_unsafe.contains(target)
            fi

            // an imported constructor whose arguments reach nothing
            // pre-existing writes only its fresh receiver
            if target.constructs_store_free then
                return true
            fi

            return _target_is_safe(target, facts, unsafe)
        si

        // A call target is safe when it was walked and has not been
        // demoted, or when it is a trusted store-free import. A
        // trusted import can still be virtual (object.to_string), so
        // its in-assembly overriders — which have facts entries and
        // their own fixpoint rows — are part of the dispatch shadow
        // and must be safe too.
        _target_is_safe(
            target: Function,
            facts: Collections.MutableMap[Function, STORE_FREE_FACTS],
            unsafe: Collections.SET[Function]
        ) -> bool is
            // Declared `pure` is a trust declaration — it holds even
            // when the body is unprovable, and the pure-override
            // contract separately diagnoses any overrider that
            // breaks it, so the dispatch shadow needs no re-check
            // here.
            if target.is_declared_pure then
                return true
            fi

            // The other structural tiers — a whitelisted import, a
            // synthesized backing read — carry their own dispatch
            // guard, so a true answer needs no overrider re-check.
            if target.is_store_free then
                return true
            fi

            // A body marked @trusted_store_free() is trusted as an import on
            // the curated list is, though this compilation walked it: only
            // its overriders are judged.
            let is_trusted_body = target.is_trusted_store_free_declared

            if facts.contains_key(target) /\ !is_trusted_body then
                return !unsafe.contains(target)
            fi

            if !is_trusted_body /\ !STORE_FREE_IMPORTS.is_store_free(target) then
                return false
            fi

            let target_overriders = target.overriders

            if target_overriders? then
                for overrider in target_overriders do
                    if !isa Function(overrider) then
                        return false
                    fi

                    let overrider_function = cast Function(overrider)

                    // An override in a library source stands where a .NET
                    // library's own override would, which is never this
                    // compilation's to judge.
                    if is_trusted_body /\ is_library_member(overrider_function) then
                        continue
                    fi

                    if !facts.contains_key(overrider_function) \/ unsafe.contains(overrider_function) then
                        return false
                    fi
                od
            fi

            return true
        si

        // Whether `function` is declared in one of the library sources
        // the build compiles in, where a .NET build would see it imported.
        is_library_member(function: Function) -> bool static is
            let library_sources = IoC.CONTAINER.instance.build_flags.library_sources

            return library_sources? /\ library_sources.library_for(IO.Path.get_full_path(function.location.file_name))?
        si

        // A call bound to this function may dispatch to an override
        // this compilation cannot see when the owner hierarchy is
        // open to other assemblies. Struct methods are final, and
        // constructors and static/global functions do not dispatch.
        is_openly_dispatchable(function: Function) -> bool is
            if isa Semantic.Symbols.STRUCT_METHOD(function) then
                return false
            fi

            if !isa Semantic.Symbols.INSTANCE_METHOD(function) then
                return false
            fi

            if function.name =~ "init" then
                return false
            fi

            let owner = function.owner

            if !owner? \/ !isa Semantic.Symbols.Classy(owner) then
                return true
            fi

            let owner_classy = cast Semantic.Symbols.Classy(owner)

            // A closed owner's dispatch is bounded by the recorded
            // override and implementation edges, for traits and
            // unions as much as classes: closed-to-assembly means
            // nothing outside the compilation can add an overrider,
            // and resolve-overrides links every in-assembly one. A
            // session is the exception: a later cell can extend a
            // closed in-compilation type, so its dispatch is open.
            return owner_classy.is_open \/ owner_classy.open_to_a_later_cell
        si
    si
si
