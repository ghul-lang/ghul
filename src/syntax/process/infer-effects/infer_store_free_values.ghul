namespace Syntax.Process is
    use System.Exception

    use Ghul.Pipes

    use Logging
    use Trees

    use Semantic.Types.Type

    use Function = Semantic.Symbols.Function
    use Symbol = Semantic.Symbols.Symbol

    // Value and expression walks: references, calls, operators, identifiers, members, indexing
    // and generic applications.
    partial INFER_STORE_FREE is
        // `x ref` hands the callee the address of a storage location
        // rather than a value, and the callee may write through it.
        // What the callee itself does is bounded by the enclosing
        // call's own edges, with one exception that decides this
        // classification: several of the imports trusted store-free
        // write a by-ref argument by contract — `try_get_value` is the
        // everyday one — so a write through the address is not always
        // covered by a callee edge. The operand therefore has to carry
        // it. The address of a local variable or parameter is
        // callee-private, exactly as assigning one is; the address of a
        // field, a property or an element is a possible heap store.
        //
        // The node's own `writes_target` flag says which direction the
        // matched parameter takes, and is deliberately not consulted:
        // it is set during call resolution, which runs after this pass,
        // so every REFERENCE reaching here still reads false.
        //
        // The operand is walked as a child, so its own reads are
        // classified independently of this.
        visit(reference: Expressions.REFERENCE) is
            if !_current? then
                return
            fi

            if !_is_local_target(reference.left) then
                _disqualify()
            fi
        si

        // Record, for the study, which member symbol a store targets.
        // Mirrors the classification below without affecting it: a
        // local target records nothing, a resolvable member records
        // that symbol, anything else marks the writes unboundable.
        _study_note_store(target: Trees.Expressions.Expression?) is
            if !_current_record? then
                return
            fi

            if !target? then
                _current_record.writes_unbounded = true
                return
            fi

            if isa Trees.Expressions.IDENTIFIER(target) then
                let symbol = try_find((cast Trees.Expressions.IDENTIFIER(target)).identifier)

                if
                    symbol? /\
                    (isa Semantic.Symbols.LOCAL_VARIABLE(symbol) \/ isa Semantic.Symbols.LOCAL_ARGUMENT(symbol))
                then
                    // A store to a local the current body captured
                    // from an enclosing scope is not callee-private:
                    // the two share one heap cell, so the declaring
                    // scope sees the write. It enters the write and
                    // nulling sets under the local's own symbol, so a
                    // caller this body is absorbed into carries it.
                    if _is_captured_local_store(symbol) then
                        _study_note_nulling(false)
                        _study_note_nulling_member(symbol, false)
                        _study_add_write(symbol)
                    fi

                    return
                fi

                _study_note_nulling(symbol? /\ symbol.is_instance)
                _study_note_nulling_member(symbol, symbol? /\ symbol.is_instance)
                _study_add_write(symbol)
                return
            fi

            if isa Trees.Expressions.MEMBER(target) then
                let member = cast Trees.Expressions.MEMBER(target)

                if isa Trees.Expressions.SELF(member.left) then
                    let context = current_instance_context

                    if context? then
                        _study_note_nulling(true)
                        _study_note_nulling_member(context.find_member(member.identifier.name), true)
                        _study_add_write(context.find_member(member.identifier.name))
                        return
                    fi
                fi

                let left_type = _typer.try_type(member.left)

                if !left_type? then
                    _study_note_nulling(false)
                    _study_note_nulling_member(null, false)
                    _study_unbounded_store("store-receiver-untyped")
                    return
                fi

                let member_symbol = left_type.find_member(member.identifier.name)

                if !member_symbol? then
                    _study_note_nulling(false)
                    _study_note_nulling_member(null, false)
                    _study_unbounded_store("store-member-not-found")
                    return
                fi

                _study_note_nulling(false)
                _study_note_nulling_member(member_symbol, false)
                _study_add_write(member_symbol)
                return
            fi

            if isa Trees.Expressions.INDEX(target) then
                // an element store: cannot change what any field holds,
                // so it is recorded apart from member writes - the
                // element-rescue measurement keys on the distinction
                _current_record.writes_elements = true
                return
            fi

            // `xs[i] = v` parses as an ambiguous expression; once
            // compile-expressions has settled which shape it is, an
            // index store is an element store like any other
            if let ambiguous: Trees.Expressions.AMBIGUOUS_EXPRESSION = target then
                if ambiguous.result == Trees.Expressions.AmbiguousExpressionResult.INDEX then
                    _current_record.writes_elements = true
                    return
                fi

                _study_note_nulling(false)
                _study_note_nulling_member(null, false)
                _study_unbounded_store("store-ambiguous-unresolved")
                return
            fi

            // a target shape the walk does not model
            _study_note_nulling(false)
            _study_note_nulling_member(null, false)
            _study_unbounded_store("store-target-shape:{target.get_type().name}")
        si

        // Mark the current record's write set unboundable, naming why,
        // so the blame table can split the catch-all
        // "write-target-unresolved" bucket by cause.
        _study_unbounded_store(reason: string) is
            if !_current_record? then
                return
            fi

            _current_record.writes_unbounded = true

            if _current_record.unbounded_reason =~ "" then
                _current_record.unbounded_reason = reason
            fi
        si

        _study_add_write(symbol: Symbol?) is
            if !_current_record? then
                return
            fi

            if !symbol? then
                _current_record.writes_unbounded = true
                return
            fi

            _current_record.writes.add(symbol.root_specialized_from)
        si

        // ==== calls ====

        visit(call: Expressions.CALL) is
            if !_current? then
                return
            fi

            // Study-only: after compile-expressions the call carries the
            // value it compiled to, which names the callee directly
            // whatever shape the target expression has.
            if _resolved_mode then
                let value = call.value

                if value? /\ _classify_resolved_value(value) then
                    return
                fi
            fi

            _add_call_target_edges(call.function)
        si

        // A value slot whose declared type is a pure function type:
        // invoking the held value is trusted store-free, whatever it
        // turns out to be — the pure-typed slot only admits pure
        // values. Parameters and fields qualify; a property is excluded
        // because reading it runs its getter. A local variable is
        // excluded too: its `type` is filled by compile-expressions,
        // which runs after this pass, so reading it here would make the
        // classification depend on whether that later pass has run — it
        // has in an analysis-mode refresh, it has not in a batch build.
        _is_pure_function_valued(symbol: Semantic.Symbols.Symbol?) -> bool =>
            symbol? /\
            isa Semantic.Symbols.Variable(symbol) /\
            (_resolved_mode \/ !isa Semantic.Symbols.LOCAL_VARIABLE(symbol)) /\
            symbol.type? /\ symbol.type.is_pure_function

        // A synthesized `=~` or `get_hash_code`. The body stores
        // nothing of its own - it reads members and compares them - so
        // what it can do is exactly what the comparisons it reaches
        // do, and the lowering recorded those as it chose them.
        //
        // Before compile-expressions there is nothing to read: the
        // members have no types yet, so which comparison each takes is
        // undecided and the body cannot be classified.
        visit(memberwise: Trees.Expressions.MEMBERWISE_EQUALS) is
            _add_memberwise_edges(memberwise.called_functions, memberwise.value?)
        si

        visit(memberwise: Trees.Expressions.MEMBERWISE_HASH) is
            _add_memberwise_edges(memberwise.called_functions, memberwise.value?)
        si

        _add_memberwise_edges(
            called: Collections.LIST[Semantic.Symbols.Function],
            lowered: bool
        ) is
            // Before compile-expressions the members have no types, so
            // which comparison each takes is undecided and there is
            // nothing to record. The resolved walk that follows is
            // what settles the body; nothing between the two reads a
            // synthesized operator's bit.
            if !lowered then
                return
            fi

            for function in called do
                _add_callee(function)
            od
        si

        _add_call_target_edges(target: Trees.Expressions.Expression?) is
            if !target? then
                _disqualify_because("call-target-null")
                return
            fi

            if isa Trees.Expressions.IDENTIFIER(target) then
                let identifier = (cast Trees.Expressions.IDENTIFIER(target)).identifier

                let symbol = try_find(identifier)

                if _is_pure_function_valued(symbol) then
                    return
                fi

                _add_callee_edges(symbol)
                return
            fi

            if isa Trees.Expressions.MEMBER(target) then
                let member = cast Trees.Expressions.MEMBER(target)

                if _is_constructor_chain(member) then
                    // `super.init(…)` or `self.init(…)` runs on the
                    // object this constructor is itself being run on,
                    // so it is bounded the same way a construction is —
                    // and writes that receiver's own state, so it
                    // disqualifies the strict bit just as writing a
                    // field directly does
                    _disqualify_strict_only()

                    let receiver_type = _typer.try_type(member.left)

                    if !receiver_type? then
                        _disqualify_because("ctor-chain-receiver-untyped")
                        return
                    fi

                    _add_construction_edges(receiver_type.find_member("init"))
                    return
                fi

                let as_identifier = member.try_copy_as_identifer()

                if as_identifier? then
                    let symbol = try_find(as_identifier)

                    if symbol? then
                        if _is_pure_function_valued(symbol) then
                            return
                        fi

                        _add_callee_edges(symbol)
                        return
                    fi
                fi

                let left_type = _typer.try_type(member.left)

                if !left_type? then
                    _disqualify_because("call-receiver-untyped")
                    return
                fi

                let member_symbol = left_type.find_member(member.identifier.name)

                if member_symbol? /\ _is_pure_function_valued(member_symbol) /\ member_symbol.is_field then
                    return
                fi

                _add_callee_edges(member_symbol)
                return
            fi

            if isa Trees.Expressions.RECURSE(target) then
                _add_callee(_current_function)
                return
            fi

            _disqualify_because("call-target-shape")
        si

        // ==== operators ====

        visit(binary: Expressions.BINARY) is
            if !_current? then
                return
            fi

            _add_operator_edges(binary.operation, binary.left, binary.right)
        si

        visit(unary: Expressions.UNARY) is
            if !_current? then
                return
            fi

            _add_operator_edges(unary.operation, unary.right, null)
        si

        _add_operator_edges(
            operation: Identifiers.Identifier?,
            left: Trees.Expressions.Expression?,
            right: Trees.Expressions.Expression?
        ) is
            if !operation? then
                _disqualify_because("operator-unresolved")
                return
            fi

            // the operators in scope that take every operand as an
            // argument, as the operator compiler gathers them; instance
            // operators are bounded through the operand types below
            let group = SCOPE_OPERATOR_CANDIDATES.find(_symbol_table, operation.location, operation.name)

            if group? then
                _add_callee_edges(group)
            fi

            // `==` has a single compiler-generated implementation:
            // `==` and `!=` both carry the operation name `==` (the
            // parser rewrites `!=`), and neither can be overloaded or
            // overridden as a member. There is never a member operator
            // to bound, so the member lookup — which otherwise
            // disqualifies the function whenever an operand's type is
            // not trivially derivable — is skipped.
            //
            // `=~` and `<>` are skipped for a different reason: every
            // declaration is store-free by construction, because
            // CHECK_PURE_OVERRIDES rejects any that is not declared
            // pure or provably store-free. A member lookup could only
            // find implementations already known safe, and would
            // disqualify on operands whose type is not derivable here
            // — a lambda parameter, or a bare type parameter compared
            // through the runtime's comparer, where the comparison can
            // dispatch to any implementation at all. Reflected forms
            // reach Equals/CompareTo, which the runtime contract
            // treats as side-effect-free, so they are trusted the same
            // way.
            if operation.name =~ "==" \/ operation.name =~ "=~" \/ operation.name =~ "<>" then
                return
            fi

            // operator members can only be bounded when the operand
            // types are known
            _add_member_operator_edges(operation.name, left)

            if right? then
                _add_member_operator_edges(operation.name, right)
            fi
        si

        _add_member_operator_edges(name: string, operand: Trees.Expressions.Expression?) is
            let operand_type = _typer.try_type(operand)

            if !operand_type? then
                // The operand's type is not trivially derivable, so a
                // member operator on it cannot be bounded here — the
                // same position a call on an untypable receiver is
                // in, and answered the same way. The free and innate
                // operators are already bounded through the operator
                // group above.
                _disqualify_because("member-operator-unresolved")

                return
            fi

            let member_symbol = operand_type.find_member(name)

            // A member hidden from operator resolution is never what an
            // operator expression calls, so following its call edge would
            // bound the enclosing function by a method it cannot invoke.
            //
            // Soundness rests on this matching `COMPILE_OPERATORS`, which
            // discards the same members when it gathers candidates. Both
            // ask `HIDDEN_OPERATOR_MEMBERS`, so the two cannot drift: the
            // operand ends up bounded by the operator that really runs,
            // which for these types is an innate already classified by
            // `STORE_FREE_INNATES`.
            //
            // A group is skipped only when every function in it is hidden,
            // so a same-named user overload is still bounded as before.
            if member_symbol? /\ !HIDDEN_OPERATOR_MEMBERS.is_hidden(member_symbol) then
                _add_callee_edges(member_symbol)
            fi
        si

        // ==== reads ====

        visit(identifier: Expressions.IDENTIFIER) is
            if !_current? then
                return
            fi

            // an unresolvable bare name is either an error compile-
            // expressions will report or a contextual load (a unit
            // variant); neither can store
            _classify_member_read(try_find(identifier.identifier))
        si

        visit(member: Expressions.MEMBER) is
            if !_current? then
                return
            fi

            let as_identifier = member.try_copy_as_identifer()

            if as_identifier? then
                let symbol = try_find(as_identifier)

                if symbol? then
                    _classify_member_read(symbol)
                    return
                fi
            fi

            let left_type = _typer.try_type(member.left)

            if left_type? then
                let member_symbol = left_type.find_member(member.identifier.name)

                if member_symbol? then
                    _classify_member_read(member_symbol)
                    return
                fi
            fi

            // untyped receiver: if this member turns out to be a
            // property, its getter could run arbitrary code
            _disqualify_because("member-receiver-untyped")
        si

        visit(index: Expressions.INDEX) is
            if !_current? then
                return
            fi

            let left_type = _typer.try_type(index.left)

            if !left_type? then
                _disqualify_because("index-receiver-untyped")
                return
            fi

            if isa Semantic.Types.ARRAY(left_type) then
                // array element read; element stores only occur as
                // assignment targets, which are classified separately
                return
            fi

            // an indexer read runs the receiver type's get_Item —
            // bound it like any other member call
            _add_callee_edges(left_type.find_member(Semantic.Symbols.INDEXER_NAMES.read))
        si

        visit(recurse: Expressions.RECURSE) is
            if !_current? then
                return
            fi

            _add_callee(_current_function)
        si

        // ==== type application ====

        // `a.b[X]` where `X` reads as both a type argument and an index
        // expression. Resolve-type-expressions settles the index
        // reading when the type argument fails to resolve, and then the
        // INDEX node it built is walked and classified in its own
        // right, leaving nothing to do here.
        visit(ambiguous: Expressions.AMBIGUOUS_EXPRESSION) is
            if !_current? then
                return
            fi

            if ambiguous.result == Expressions.AmbiguousExpressionResult.INDEX then
                return
            fi

            _classify_type_application(ambiguous.result, ambiguous.left, ambiguous.identifier)
        si

        // `a.b[X]` where `X` can only be a type argument. Applying type
        // arguments to a generic type or member is a read, so it
        // classifies exactly as the same member read without them
        // would; a call spelt this way is wrapped in a CALL node, which
        // is classified separately and on its own terms.
        visit(generic_application: Expressions.GENERIC_APPLICATION) is
            if !_current? then
                return
            fi

            _classify_type_application(
                generic_application.result,
                generic_application.left,
                generic_application.identifier
            )
        si

        _classify_type_application(
            result: Expressions.AmbiguousExpressionResult,
            left: Trees.Expressions.Expression?,
            identifier: Identifiers.Identifier
        ) is
            // Both node kinds walk their receiver only once a later
            // pass has settled what the application applies to, which
            // for every node reaching this pass means not yet. So the
            // receiver has to be walked from here — otherwise a call or
            // an index sitting in it would never be classified at all.
            if result == Expressions.AmbiguousExpressionResult.UNKNOWN /\ left? then
                left.walk(self)
            fi

            if !left? then
                _classify_member_read(try_find(identifier))
                return
            fi

            // a receiver that is itself a name resolves as one
            // qualified name — the route a namespace-qualified type or
            // a union's variant arrives by. The joined name exists only
            // for this lookup, so its spans are the identifier's own.
            let left_as_identifier = left.try_copy_as_identifer()

            if left_as_identifier? then
                let symbol =
                    try_find(
                        Identifiers.QUALIFIED(
                            identifier.location,
                            left_as_identifier,
                            identifier.name,
                            identifier.location,
                            identifier.right_location
                        )
                    )

                if symbol? then
                    _classify_member_read(symbol)
                    return
                fi
            fi

            let left_type = _typer.try_type(left)

            if !left_type? then
                _disqualify()
                return
            fi

            let member_symbol = left_type.find_member(identifier.name)

            if !member_symbol? then
                // untyped or unresolvable member: if it turns out to be
                // a property, its getter could run arbitrary code
                _disqualify()
                return
            fi

            _classify_member_read(member_symbol)
        si

    si
si
