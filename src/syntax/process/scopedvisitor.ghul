namespace Syntax.Process is
    use IO.Std


    use Logging
    use Trees

    class ScopedVisitor: ScopeVisitorBase abstract is
        _logger: Logger
        _symbol_table: Semantic.SYMBOL_TABLE

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            namespaces: Semantic.NAMESPACES
        )
        is
            super.init(
                symbol_table,
                namespaces
            )

            _logger = logger
            _symbol_table = symbol_table
        si

        find(name: string) -> Semantic.Symbols.Symbol? => _symbol_table.current_scope.find_enclosing(name)
        find_matches(prefix: string, matches: Collections.MutableMap[string,Semantic.Symbols.Symbol]) is
            _symbol_table.current_scope.find_enclosing_matches(prefix, matches)
        si

        find(identifier: Identifiers.Identifier) -> Semantic.Symbols.Symbol? is
            let result: Semantic.Symbols.Symbol? mut = null

            if identifier.qualifier? then
                let qualifier = find(identifier.qualifier)

                if qualifier == null then
                    return null
                fi

                result = qualifier.find_member(identifier.name)
            else
                result =
                    _symbol_table
                        .current_scope
                        .find_enclosing(identifier.name)
            fi

            // A name the compiler synthesised carries an internal
            // location, and a scope broken enough not to hold it - a
            // file mixing globals with a namespace, say - has a real
            // diagnostic of its own. Reporting a name nobody wrote on
            // top of it points at nothing the author can fix.
            if
                result == null /\
                !identifier.is_poisoned /\
                !identifier.location.is_internal
            then
                _logger.error(identifier.location, "symbol not found: {identifier}")

                if let file = SYNTHESISE_TOP_LEVEL_ENTRY.file_inferring(identifier.name) /\ file !~ identifier.location.file_name then
                    _logger.hint(
                        identifier.location,
                        "{identifier} in {IO.Path.get_file_name(file)} has no types in its signature, so it is private to that file; {_export_advice(identifier, file)}")
                fi
            elif
                result? /\
                !identifier.qualifier? /\
                !identifier.is_poisoned /\
                !identifier.location.is_internal
            then
                // Where another file's private function shares the name with
                // something this file can reach, the name reaches that instead,
                // which is reported: the program would run a function its
                // author may not mean.
                if let visible = _without_other_files_private(identifier, result) then
                    let declared_in = _first_private_file(identifier, result)

                    _logger.error(
                        identifier.location,
                        "{identifier} in {IO.Path.get_file_name(declared_in ?? "")} has no types in its signature, so it is private to that file",
                        identifier.location,
                        "help: {_export_advice(identifier, declared_in ?? "")}")

                    return visible
                fi

                if let declared_in = _private_to_another_file(identifier, result) then
                    let file = IO.Path.get_file_name(declared_in)

                    _logger.error(
                        identifier.location,
                        "{identifier} in {file} has no types in its signature, so it is private to that file",
                        identifier.location,
                        "help: {_export_advice(identifier, declared_in)}")

                    return null
                fi
            fi

            return result
        si

        // A function whose signature is inferred is private to the file that
        // declares it, which matters where namespace-less files share one
        // namespace, or files share a whole-file namespace: the namespace
        // holds it, and only its own file may name it.
        // A group some of whose functions are private to another file, and
        // some not, without the private ones: the name reaches only those.
        // Null where the group has no private function to leave out, or
        // has nothing else.
        _without_other_files_private(identifier: Identifiers.Identifier, result: Semantic.Symbols.Symbol) -> Semantic.Symbols.Symbol? is
            let group = cast Semantic.Symbols.FUNCTION_GROUP?(result)

            if !group? then
                return null
            fi

            let file = identifier.location.file_name
            let kept = Collections.LIST[Semantic.Symbols.Function]()
            let left_out mut = false

            for f in group.functions do
                if f.is_inferred_signature /\ f.location.file_name !~ file then
                    left_out = true
                else
                    kept.add(f)
                fi
            od

            if !left_out \/ kept.count == 0 then
                return null
            fi

            let filtered = Semantic.Symbols.FUNCTION_GROUP(group.location, group.owner!, group.name)

            for f in kept do
                filtered.add(f)
            od

            return filtered
        si

        // What to write to call such a function from another file: a return
        // type, for one with no parameters, and otherwise its types.
        _export_advice(identifier: Identifiers.Identifier, file: string) -> string =>
            if SYNTHESISE_TOP_LEVEL_ENTRY.is_parameterless_inferred(file, identifier.name) then
                "give {identifier} a return type, such as `-> void`, to call it from another file"
            else
                "write the types in the signature of {identifier} to call it from another file"
            fi

        _first_private_file(identifier: Identifiers.Identifier, result: Semantic.Symbols.Symbol) -> string? is
            if let group: Semantic.Symbols.FUNCTION_GROUP = result then
                for f in group.functions do
                    if f.is_inferred_signature /\ f.location.file_name !~ identifier.location.file_name then
                        return f.location.file_name
                    fi
                od
            fi

            return null
        si

        // The file declaring it, when every function the name reaches is one.
        _private_to_another_file(identifier: Identifiers.Identifier, result: Semantic.Symbols.Symbol) -> string? is
            let file = identifier.location.file_name

            let is_other = (f: Semantic.Symbols.Function) -> bool =>
                f.is_inferred_signature /\ f.location.file_name !~ file

            if let group: Semantic.Symbols.FUNCTION_GROUP = result then
                let first: string? mut = null

                for f in group.functions do
                    if !is_other(f) then
                        return null
                    fi

                    first = first ?? f.location.file_name
                od

                return first
            elif let function: Semantic.Symbols.Function = result /\ is_other(function) then
                return function.location.file_name
            fi

            return null
        si

        // As find(identifier), but returns null silently instead of
        // logging "symbol not found" — for callers that resolve a name
        // speculatively and report their own diagnostic on failure.
        try_find(identifier: Identifiers.Identifier) -> Semantic.Symbols.Symbol? is
            if identifier.qualifier? then
                let qualifier = try_find(identifier.qualifier)

                if qualifier == null then
                    return null
                fi

                return qualifier.find_member(identifier.name)
            fi

            return
                _symbol_table
                    .current_scope
                    .find_enclosing(identifier.name)
        si
        pre(`namespace: Definitions.NAMESPACE) -> bool is
            enter_namespace(`namespace)
            enter_uses(`namespace)
            return false
        si

        visit(`namespace: Definitions.NAMESPACE) is
            leave_uses(`namespace)
            leave_namespace(`namespace)
        si

        pre(`class: Definitions.CLASS) -> bool is
            enter_scope(`class)
            return false
        si

        visit(`class: Definitions.CLASS) is
            leave_scope(`class)
        si

        pre(`trait: Definitions.TRAIT) -> bool is
            enter_scope(`trait)
            return false
        si

        visit(`trait: Definitions.TRAIT) is
            leave_scope(`trait)
        si

        pre(`struct: Definitions.STRUCT) -> bool is
            enter_scope(`struct)
            return false
        si

        pre(`union: Definitions.UNION) -> bool is
            enter_scope(`union)
            return false
        si

        visit(`union: Definitions.UNION) is
            leave_scope(`union)
        si

        pre(variant: Definitions.VARIANT) -> bool is
            enter_scope(variant)
            return false
        si

        visit(variant: Definitions.VARIANT) is
            leave_scope(variant)
        si

        visit(`struct: Definitions.STRUCT) is
            leave_scope(`struct)
        si

        pre(`partial: Definitions.PARTIAL) -> bool is
            enter_scope(`partial)
            return false
        si

        visit(`partial: Definitions.PARTIAL) is
            leave_scope(`partial)
        si

        pre(`impl: Definitions.IMPL) -> bool is
            enter_scope(`impl)
            return false
        si

        visit(`impl: Definitions.IMPL) is
            leave_scope(`impl)
        si

        pre(`enum: Definitions.ENUM) -> bool is
            enter_scope(`enum)
            return false
        si

        visit(`enum: Definitions.ENUM) is
            leave_scope(`enum)
        si

        pre(function: Definitions.FUNCTION) -> bool is
            enter_scope(function)
            return false
        si

        visit(function: Definitions.FUNCTION) is
            leave_scope(function)
        si

        pre(property: Definitions.PROPERTY) -> bool => false
        visit(property: Definitions.PROPERTY) is
        si

        pre(indexer: Definitions.INDEXER) -> bool is
            // enter_scope(indexer);
            return true
        si

        visit(indexer: Definitions.INDEXER) is
            // leave_scope(indexer);
        si

        pre(block: Expressions.VAL_BLOCK) -> bool is
            enter_scope(block)
            return false
        si

        visit(block: Expressions.VAL_BLOCK) is
            leave_scope(block)
        si

        pre(if_branch: Statements.IF_BRANCH) -> bool is
            enter_scope(if_branch)
            return false
        si

        visit(if_branch: Statements.IF_BRANCH) is
            leave_scope(if_branch)
        si

        pre(`case: Statements.CASE) -> bool is
            enter_scope(`case)
            return false
        si

        visit(`case: Statements.CASE) is
            leave_scope(`case)
        si

        pre(case_match: Statements.CASE_MATCH) -> bool is
            enter_scope(case_match)
            return false
        si

        visit(case_match: Statements.CASE_MATCH) is
            leave_scope(case_match)
        si

        pre(`try: Statements.TRY) -> bool is
            enter_scope(`try)
            return false
        si

        // The try's scope holds the body's locals, so it closes where the
        // body ends; visit only closes it for a walk that never reached
        // the end of the body.
        end_try_body(`try: Statements.TRY) is
            leave_try_scope(`try)
        si

        visit(`try: Statements.TRY) is
            leave_try_scope(`try)
        si

        leave_try_scope(`try: Statements.TRY) is
            if `try.scope? /\ current_scope == `try.scope then
                leave_scope(`try)
            fi
        si

        pre(`catch: Statements.CATCH) -> bool is
            enter_scope(`catch)
            return false
        si

        visit(`catch: Statements.CATCH) is
            leave_scope(`catch)
        si

        pre(`do: Statements.DO) -> bool is
            enter_scope(`do)
            return false
        si

        visit(`do: Statements.DO) is
            leave_scope(`do)
        si

        pre(`for: Statements.FOR) -> bool is
            enter_scope(`for)
            return false
        si

        visit(`for: Statements.FOR) is
            leave_scope(`for)
        si

        pre(function: Expressions.FUNCTION) -> bool is
            enter_scope(function)
            return false
        si

        visit(function: Expressions.FUNCTION) is
            leave_scope(function)
        si

        pre(let_in: Expressions.LET_IN) -> bool is
            enter_scope(let_in)
            return false
        si

        visit(let_in: Expressions.LET_IN) is
            leave_scope(let_in)
        si

        // A lazy comprehension's clauses and element are the body of the
        // generator literal it owns.
        pre(comprehension: Expressions.COMPREHENSION) -> bool is
            if comprehension.is_lazy then
                enter_scope(comprehension)
            fi

            return false
        si

        visit(comprehension: Expressions.COMPREHENSION) is
            if comprehension.is_lazy then
                leave_scope(comprehension)
            fi
        si

        pre(clause: Expressions.COMPREHENSION_FOR) -> bool is
            enter_scope(clause)
            return false
        si

        visit(clause: Expressions.COMPREHENSION_FOR) is
            leave_scope(clause)
        si

        pre(expression: Bodies.EXPRESSION) -> bool is
            enter_scope(expression)
            return false
        si

        visit(expression: Bodies.EXPRESSION) is
            leave_scope(expression)
        si

        pre(block: Bodies.BLOCK) -> bool is
            enter_scope(block)
            return false
        si

        visit(block: Bodies.BLOCK) is
            leave_scope(block)
        si
    si
si
