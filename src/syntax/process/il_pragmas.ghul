namespace Syntax.Process is
    // The pragmas the compiler acts on itself, all named `IL.`: they name
    // a fact about the emitted assembly rather than a .NET attribute, so
    // the compiler reads them where the declaration is walked and passes
    // the answer to emission. What each one does is said where it is read.
    class IL_PRAGMAS is
        // The family every one of them is named in.
        PREFIX: string static => "IL."

        // The .NET name a member is emitted under.
        NAME: string static => "IL.name"
        NAME_READ: string static => "IL.name.read"
        NAME_ASSIGN: string static => "IL.name.assign"

        // Names the file a region of emitted IL is written to, marked on
        // the statements the region runs between.
        OUTPUT: string static => "IL.output"

        // Names the function a program starts at.
        ENTRYPOINT: string static => "IL.entrypoint"

        // Whether a pragma name is in this family at all, known or not.
        is_il_pragma(name: string) -> bool static => name.starts_with(PREFIX)

        // Whether the compiler acts on it.
        is_known(name: string) -> bool static =>
            name =~ NAME \/
            name =~ NAME_READ \/
            name =~ NAME_ASSIGN \/
            name =~ OUTPUT \/
            name =~ ENTRYPOINT

        // Whether it renames a member, which the three `IL.name` forms do
        // between them and the other two do not.
        is_name_pragma(name: string) -> bool static =>
            name =~ NAME \/
            name =~ NAME_READ \/
            name =~ NAME_ASSIGN
    si
si
