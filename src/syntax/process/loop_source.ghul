namespace Syntax.Process is
    use IR.Values.Value
    use Semantic.Types.Type

    // A `Ghul.Pipes` seed call a fused loop produces its elements from
    // itself instead of reading the pipe object the call returns. Its
    // arguments are the values the call was compiled with, so the loop
    // evaluates them once, in the order the call would.
    trait LoopSource is
        /// The sequence the loop runs.
        ///
        /// - int_type: `int`
        /// - element_type: the type of the elements the call's sequence yields
        /// - id: makes the sequence's locals unique
        sequence(int_type: Type, element_type: Type, id: int) -> IR.LoopSequence

        /// How many elements the source yields, where that is known
        /// before the loop and reading it has no effect; null otherwise.
        known_count() -> Value?
    si

    class LOOP_SOURCES is
        /// The seed call `source` is, counted by a loop, or null where it
        /// is not a call to one of the seeds a loop can count through.
        of(source: Value?, owner: Semantic.Symbols.Symbol?, int_type: Type, long_type: Type) -> LoopSource? static is
            if let counted = COUNTED_SOURCE.of(source, owner, int_type, long_type) then
                return counted
            fi

            if let repeated = REPEAT_SOURCE.of(source, owner, int_type) then
                return repeated
            fi

            return null
        si
    si
si
