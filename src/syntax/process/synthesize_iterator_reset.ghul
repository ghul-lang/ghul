namespace Syntax.Process is
    use Source

    // Gives a type implementing `Collections.Iterator[T]` the `reset`
    // it declared none of. The decision needs resolved ancestors - the
    // trait can be reached through another one - so it is taken here
    // rather than at rewrite time, and before overrides are resolved,
    // which is what would otherwise report the missing member.
    class SYNTHESIZE_ITERATOR_RESET: Visitor is
        _symbol_table: Semantic.SYMBOL_TABLE
        _synthesis: Semantic.Symbols.ITERATOR_RESET_SYNTHESIS

        init(
            symbol_table: Semantic.SYMBOL_TABLE,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        ) is
            super.init()

            _symbol_table = symbol_table
            _synthesis =
                Semantic.Symbols.ITERATOR_RESET_SYNTHESIS(innate_symbol_lookup)
        si

        apply(root: Trees.Node) is
            root.walk(self)
        si

        pre(`class: Trees.Definitions.CLASS) -> bool is
            _settle(`class)

            return false
        si

        pre(`struct: Trees.Definitions.STRUCT) -> bool is
            _settle(`struct)

            return false
        si

        _settle(definition: Trees.Node) is
            if let classy: Semantic.Symbols.Classy =
                _symbol_table.scope_for(definition)
            then
                _synthesis.try_synthesize(classy)
            fi
        si
    si
si
