namespace Syntax.Process is
    use Semantic.Types.Type

    // Rules for a statement used where a value is wanted whose only exits
    // diverge — `throw`, or an `if`/`case`/`val` whose every arm diverges.
    // Such a statement produces no value, but the continuation after it is
    // unreachable and needs none, so a value-requiring context must not
    // treat the absent value as an error.
    class DIVERGING_VALUE_POSITION is
        // True when a value-wanting position should report its statement
        // having produced no value: it wants one, none was produced, and
        // control actually reaches the continuation. A diverging statement
        // makes that continuation unreachable, so the value is legitimately
        // absent and nothing should be reported.
        is_missing_value_reportable(want_value: bool, has_value: bool, is_unreachable: bool) -> bool static =>
            want_value /\ !has_value /\ !is_unreachable

        // True when a diverging expression body (`=> throw E`, or an
        // `=> if/case` whose arms all diverge) should adopt void as its
        // return type. A return type the user declared — any settled type —
        // is kept; only an unsettled one (absent, or still carrying an
        // inference placeholder) is replaced, since the body yields nothing
        // to infer from. A type parameter (`-> T`) is settled, not wild:
        // `is_wild` answers true for one, but that is its overload-resolution
        // soft-match meaning, not "unsettled".
        settles_inferred_return_to_void(return_type: Type?) -> bool static =>
            !return_type? \/ return_type.contains_inferred

        // True when an `if` or `case` gives no value because every arm
        // diverges: none of its arms produced a value and control does not
        // reach its end. An arm that produced only `null` is not divergence.
        is_all_diverging(seen_any_values: bool, is_unreachable: bool) -> bool static =>
            !seen_any_values /\ is_unreachable

        // The type of an expression whose every path diverges: it has no
        // value, and nothing after it runs to consume one, so it takes the
        // type its context expects, or void where the context expects none.
        type_of_all_diverging(expected_type: Type?, void_type: Type) -> Type static =>
            expected_type ?? void_type

        // The type of `a ?? b` where `b` diverges on every path: `b` runs
        // only for its exit and contributes no type, so the result is the
        // present type of `a`. Null where `a` is not a settled optional,
        // which leaves the operator to the general rule.
        diverging_coalesce_result_type(left_type: Type?) -> Type? static =>
            if !left_type? \/ left_type.is_error \/ left_type.contains_inferred \/ !left_type.is_optional then
                null
            else
                left_type.optional_inner_type
            fi
    si
si
