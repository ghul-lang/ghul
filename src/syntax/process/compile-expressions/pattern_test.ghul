namespace Syntax.Process is
    use IR.Values.Value

    // The test a pattern value performs against the value at its
    // position, and how it was reached: by a `~` that matches, or by
    // equality. A test reached through `~` decides nothing about which
    // values the position can hold, so coverage treats it as opaque.
    class PATTERN_TEST is
        value: Value

        // The `~` the test calls, or null for an equality test.
        match_function: Semantic.Symbols.Function?

        is_match: bool => match_function?

        init(value: Value, match_function: Semantic.Symbols.Function?) is
            self.value = value
            self.match_function = match_function
        si

        // Whether a pattern value is tested by the `~` that resolved with
        // `match_score` rather than by the `=~` that resolved with
        // `equal_score`, or by none. The lower score needs less
        // conversion and wins; `~` wins an exact tie.
        prefers_match(match_score: Semantic.Types.MATCH, equal_score: Semantic.Types.MATCH?) -> bool static =>
            if let equal = equal_score then
                cast int(match_score) <= cast int(equal)
            else
                true
            fi
    si
si
