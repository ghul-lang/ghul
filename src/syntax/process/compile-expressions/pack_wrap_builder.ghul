namespace Syntax.Process is
    use Semantic.Types.Type

    use IR.Values.Value

    // Presents a function value of one argument pack shape in the other.
    // A function of two or more parameters going into a formal that takes
    // the pack as one tuple is wrapped in a thunk that takes the tuple,
    // unpacks it and calls the function; the other direction packs the
    // elements into the tuple the function takes.
    //
    // A thunk is a static closure symbol with no literal behind it, whose
    // body is emitted from the description recorded on it. Its first
    // parameter is the function it stands for, and its delegate is built
    // closed over that parameter, so the value is evaluated once, where
    // it stands, and nothing is captured. A pack marked past the
    // function's own type - `make: (int) -> T.. -> U` - takes a chain:
    // each thunk above the pack calls its function and returns the next
    // thunk's delegate, closed over the result.
    //
    // Nothing here touches a syntax tree. A call is compiled once for
    // every walk of the body it stands in, so the thunks made for a given
    // argument of a given call are kept and reused rather than declared
    // again.
    class PACK_WRAP_BUILDER is
        _symbol_table: Semantic.SYMBOL_TABLE
        _symbol_loader: Semantic.SYMBOL_LOADER
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup

        _thunks: Collections.MAP[Trees.Node, Collections.MAP[int, Collections.LIST[Semantic.Symbols.Closure]]]

        _index: int

        init(
            symbol_table: Semantic.SYMBOL_TABLE,
            symbol_loader: Semantic.SYMBOL_LOADER,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        ) is
            _symbol_table = symbol_table
            _symbol_loader = symbol_loader
            _innate_symbol_lookup = innate_symbol_lookup

            _thunks = Collections.MAP[Trees.Node, Collections.MAP[int, Collections.LIST[Semantic.Symbols.Closure]]]()
        si

        // The delegate of a thunk that calls `target` with its parameters,
        // for a function that has no method a delegate could point at.
        // `callee_type` is the function type the thunk presents, and so
        // the type `target` is called at; `delegate_type` is the named
        // delegate type the value is wanted as, where it is not a ghūl
        // function type. One thunk serves every use of `target` at that
        // type within the enclosing function. Absent outside a function
        // body.
        forward(
            location: Source.LOCATION,
            target: Semantic.Symbols.Function,
            callee_type: Type,
            delegate_type: Type?
        ) -> Value? is
            let enclosing = _symbol_table.current_function

            if !enclosing? then
                return null
            fi

            let thunk = _forwarder_for(location, enclosing, target, callee_type, delegate_type)

            if !thunk? then
                return null
            fi

            return thunk.load(location, _symbol_loader)
        si

        // The forwarding thunks are found on the enclosing function rather
        // than kept here: a reference to the operator is compiled wherever
        // a name is, and every builder has to find the one thunk.
        _forwarder_for(
            location: Source.LOCATION,
            enclosing: Semantic.Symbols.Function,
            target: Semantic.Symbols.Function,
            callee_type: Type,
            delegate_type: Type?
        ) -> Semantic.Symbols.Closure? is
            let declared = Collections.LIST[Semantic.Symbols.Closure]()

            for symbol in enclosing.symbols do
                if let closure: Semantic.Symbols.Closure = symbol, description = closure.pack_thunk /\ description.is_forward then
                    declared.add(closure)

                    if
                        description.target!.root_specialized_from == target.root_specialized_from /\
                        description.callee_type.is_equivalent_to(callee_type) /\
                        (closure.delegate_target_type ?? callee_type).is_equivalent_to(delegate_type ?? callee_type)
                    then
                        return closure
                    fi
                fi
            od

            let thunk = _declare_thunk(location, enclosing, "$forward_thunk_{declared.count}")

            if !thunk? then
                return null
            fi

            _describe(thunk, location, callee_type, callee_type, Semantic.Symbols.PACK_THUNK.forward(callee_type, target))

            thunk.delegate_target_type = delegate_type

            if target.is_declared_pure then
                thunk.mark_declared_pure()
            fi

            return thunk
        si

        // The type `function_type` has once its parameters after the
        // first `fixed_count` are taken as one tuple. Absent where the
        // type is not one this applies to, or where a parameter is not
        // settled enough to be a tuple element.
        packed_type(function_type: Type?, fixed_count: int) -> Type? =>
            packed_type(function_type, fixed_count, false)

        // As above. `provisional` lets a parameter still being inferred
        // stand in the tuple, for a value that nothing has typed yet and
        // that a later use of the call's result will.
        packed_type(function_type: Type?, fixed_count: int, provisional: bool) -> Type? is
            if !function_type? \/ !function_type.is_function then
                return null
            fi

            let count = Semantic.ARGUMENT_PACK.parameter_count(function_type)
            let arity = count - fixed_count

            if arity < 2 \/ arity > Semantic.ARGUMENT_PACK.MAXIMUM_ARITY then
                return null
            fi

            let parameters = Collections.LIST[Type]()
            let elements = Collections.LIST[Type]()

            for i in 0..count do
                let parameter = function_type.arguments[i]

                // A type parameter of the function being compiled, or of
                // one enclosing it, names a type as definitely as a
                // concrete one does. `is_wild` answers true for those as
                // well as for a parameter whose index means something
                // only inside an overload specialization that may already
                // have been discarded, and it is the second that has no
                // tuple element to be.
                if
                    parameter.is_error \/
                    (parameter.contains_inferred /\ !provisional) \/
                    parameter.has_function_generic_argument_foreign_to(_symbol_table.current_function)
                then
                    return null
                fi

                if i < fixed_count then
                    parameters.add(parameter)
                else
                    elements.add(parameter)
                fi
            od

            parameters.add(_innate_symbol_lookup.get_tuple_type(elements, null))

            parameters.add(
                if function_type.is_action then
                    _innate_symbol_lookup.get_void_type()
                else
                    function_type.arguments[count]
                fi
            )

            return _innate_symbol_lookup.get_function_type(parameters, function_type.is_pure_function)
        si

        // `function_type` with the function `depth` returns along its
        // spine packed as above, and every hop before it kept as it is.
        // Absent where the spine is shorter than that.
        packed_spine(function_type: Type?, depth: int, fixed_count: int) -> Type? is
            if depth == 0 then
                return packed_type(function_type, fixed_count)
            fi

            if !function_type? \/ !function_type.is_function \/ function_type.is_action then
                return null
            fi

            let count = Semantic.ARGUMENT_PACK.parameter_count(function_type)

            let inner = packed_spine(function_type.arguments[count], depth - 1, fixed_count)

            if !inner? then
                return null
            fi

            let parameters = Collections.LIST[Type]()

            for i in 0..count do
                parameters.add(function_type.arguments[i])
            od

            parameters.add(inner)

            return _innate_symbol_lookup.get_function_type(parameters, function_type.is_pure_function)
        si

        // The type `function_type` has once the tuple it takes after its
        // first `fixed_count` parameters is spread out as parameters of
        // its own. Absent where the type is not one this applies to.
        spread_type(function_type: Type?, fixed_count: int) -> Type? is
            if !function_type? \/ !function_type.is_function then
                return null
            fi

            let count = Semantic.ARGUMENT_PACK.parameter_count(function_type)

            if count != fixed_count + 1 then
                return null
            fi

            let tuple = function_type.arguments[fixed_count]

            if
                !(tuple.is_value_tuple \/ isa Semantic.Types.TUPLE(tuple)) \/
                tuple.arguments.count < 2 \/
                tuple.arguments.count > Semantic.ARGUMENT_PACK.MAXIMUM_ARITY \/
                tuple.contains_inferred
            then
                return null
            fi

            let parameters = Collections.LIST[Type]()

            for i in 0..fixed_count do
                parameters.add(function_type.arguments[i])
            od

            for element in tuple.arguments do
                parameters.add(element)
            od

            parameters.add(
                if function_type.is_action then
                    _innate_symbol_lookup.get_void_type()
                else
                    function_type.arguments[count]
                fi
            )

            return _innate_symbol_lookup.get_function_type(parameters, function_type.is_pure_function)
        si

        // Wraps `value`, a function of the pack's elements, as a function
        // of their tuple. `key` and `index` say which argument of which
        // call this is.
        unpack(
            key: Trees.Node,
            index: int,
            location: Source.LOCATION,
            value: Value,
            fixed_count: int
        ) -> Value? =>
            unpack(key, index, location, value, fixed_count, 0)

        // As above, for a pack `depth` returns past the value's own type:
        // the value is a function that, called that many times, gives the
        // function of the pack's elements.
        unpack(
            key: Trees.Node,
            index: int,
            location: Source.LOCATION,
            value: Value,
            fixed_count: int,
            depth: int
        ) -> Value? is
            let callee_type = value.type

            if !callee_type? then
                return null
            fi

            let presented = packed_spine(callee_type, depth, fixed_count)

            if !presented? then
                return null
            fi

            let enclosing = _symbol_table.current_function

            if !enclosing? then
                return null
            fi

            let thunks = _thunks_for(key, index, location, enclosing, depth + 1)

            if !thunks? then
                return null
            fi

            // The chain is built from the pack upwards: the thunk at depth
            // zero packs, and each above it hands its result down.
            let hop_types = _hops(callee_type, depth)
            let hop_presented = _hops(presented, depth)

            let innermost_type = hop_types[depth]

            let elements = Collections.LIST[Type]()

            for i in fixed_count..Semantic.ARGUMENT_PACK.parameter_count(innermost_type) do
                elements.add(innermost_type.arguments[i])
            od

            let target = if depth == 0 then _direct_target(value) else null fi

            _describe(
                thunks[0],
                location,
                innermost_type,
                hop_presented[depth],
                Semantic.Symbols.PACK_THUNK(true, fixed_count, elements, innermost_type, target)
            )

            for d in 1..depth + 1 do
                _describe(
                    thunks[d],
                    location,
                    hop_types[depth - d],
                    hop_presented[depth - d],
                    Semantic.Symbols.PACK_THUNK.chain(hop_types[depth - d], d, thunks[d - 1], hop_presented[depth - d + 1])
                )
            od

            return _present(thunks[depth], location, value, presented)
        si

        // Wraps `value`, a function of the pack's tuple, as a function of
        // its elements. `callee_type` is the type it is called at, which
        // may be more settled than the value's own.
        pack(
            key: Trees.Node,
            index: int,
            location: Source.LOCATION,
            value: Value,
            callee_type: Type,
            fixed_count: int
        ) -> Value? is
            let presented = spread_type(callee_type, fixed_count)

            if !presented? then
                return null
            fi

            let enclosing = _symbol_table.current_function

            if !enclosing? then
                return null
            fi

            let thunks = _thunks_for(key, index, location, enclosing, 1)

            if !thunks? then
                return null
            fi

            let elements = Collections.LIST[Type]()

            for element in callee_type.arguments[fixed_count].arguments do
                elements.add(element)
            od

            _describe(
                thunks[0],
                location,
                callee_type,
                presented,
                Semantic.Symbols.PACK_THUNK(false, fixed_count, elements, callee_type, _direct_target(value))
            )

            return _present(thunks[0], location, value, presented)
        si

        // `function_type` and the type each of `depth` returns along its
        // spine gives, outermost first.
        _hops(function_type: Type, depth: int) -> Collections.LIST[Type] is
            let result = Collections.LIST[Type]()

            let hop mut = function_type

            result.add(hop)

            for _ in 0..depth do
                hop = hop.arguments[hop.arguments.count - 1]

                result.add(hop)
            od

            return result
        si

        // Gives `thunk` the parameters of `presented`, its function as a
        // parameter before them where it is not called by name, its
        // return, and `description` as what its body does.
        _describe(
            thunk: Semantic.Symbols.Closure,
            location: Source.LOCATION,
            callee_type: Type,
            presented: Type,
            description: Semantic.Symbols.PACK_THUNK
        ) is
            let parameter_types = Collections.LIST[Type]()
            let parameter_names = Collections.LIST[string]()

            if description.takes_callee then
                parameter_types.add(callee_type)
                parameter_names.add("$pack_callee")

                _parameter(thunk, location, "$pack_callee").set_type(callee_type)
            fi

            for i in 0..Semantic.ARGUMENT_PACK.parameter_count(presented) do
                parameter_types.add(presented.arguments[i])
                parameter_names.add("$pack_{i}")

                _parameter(thunk, location, "$pack_{i}").set_type(presented.arguments[i])
            od

            thunk.arguments = parameter_types
            thunk.argument_names = parameter_names

            thunk.set_return_type(
                if presented.is_action then
                    _innate_symbol_lookup.get_void_type()
                else
                    presented.arguments[presented.arguments.count - 1]
                fi
            )

            for t in parameter_types do
                _record_type_arguments(thunk, t)
            od

            _record_type_arguments(thunk, thunk.return_type!)

            thunk.pack_thunk = description
        si

        // The presented value: `thunk`'s delegate, closed over `value`
        // where the thunk takes its function as a parameter, and built
        // once and kept where it calls one by name.
        _present(
            thunk: Semantic.Symbols.Closure,
            location: Source.LOCATION,
            value: Value,
            presented: Type
        ) -> Value is
            let block = IR.Values.PACK_WRAP(presented, value)

            if thunk.pack_thunk!.takes_callee then
                block.add(thunk.load_closed_over(location, value, presented))
            else
                block.add(thunk.load(location, _symbol_loader))
            fi

            return block
        si

        _direct_target(value: Value) -> Semantic.Symbols.Function? is
            let function = value.referenced_function

            if
                !function? \/
                function.is_instance \/
                function.is_generic \/
                isa Semantic.Symbols.Closure(function) \/
                !(isa Semantic.Symbols.GLOBAL_FUNCTION(function) \/ isa Semantic.Symbols.STATIC_METHOD(function))
            then
                return null
            fi

            return function
        si

        _parameter(
            thunk: Semantic.Symbols.Closure,
            location: Source.LOCATION,
            name: string
        ) -> Semantic.Symbols.Variable is
            if let existing: Semantic.Symbols.Variable = thunk.find_direct(name) then
                return existing
            fi

            thunk.start_declaring_arguments()

            let declared = cast Semantic.Symbols.Variable?(thunk.declare_variable(location, name, false, null))!

            thunk.end_declaring_arguments()

            declared.mark_synthesized()
            declared.define()

            return declared
        si

        _record_type_arguments(thunk: Semantic.Symbols.Closure, type: Type) is
            let collected = Collections.LIST[Semantic.Symbols.Symbol]()

            Semantic.INFERENCE_HELPERS.collect_method_level_type_variables(type, collected)

            for u in collected do
                thunk.add_type_argument_reference(u)
            od
        si

        // The thunks for argument `index` of the call `key` is, `count` of
        // them from the pack upwards, declared on first use and kept.
        _thunks_for(
            key: Trees.Node,
            index: int,
            location: Source.LOCATION,
            enclosing: Semantic.Symbols.Function,
            count: int
        ) -> Collections.LIST[Semantic.Symbols.Closure]? is
            let for_key: Collections.MAP[int, Collections.LIST[Semantic.Symbols.Closure]] mut

            if !_thunks.try_get_value(key, for_key ref) then
                for_key = Collections.MAP[int, Collections.LIST[Semantic.Symbols.Closure]]()
                _thunks[key] = for_key
            fi

            let thunks: Collections.LIST[Semantic.Symbols.Closure] mut

            if !for_key.try_get_value(index, thunks ref) then
                thunks = Collections.LIST[Semantic.Symbols.Closure]()
                for_key[index] = thunks
            fi

            while thunks.count < count do
                let thunk = _declare_thunk(location, enclosing, "$pack_thunk_{_index}")

                _index = _index + 1

                if !thunk? then
                    return null
                fi

                thunks.add(thunk)
            od

            return thunks
        si

        _declare_thunk(
            location: Source.LOCATION,
            enclosing: Semantic.Symbols.Function,
            name: string
        ) -> Semantic.Symbols.Closure? is
            let thunk =
                cast Semantic.Symbols.Closure?(
                    enclosing.declare_closure(
                        location,
                        name,
                        cast Semantic.Scope?(_symbol_table.current_closure_context)!,
                        _symbol_table.current_scope,
                        false,
                        null
                    )
                )

            if !thunk? then
                return null
            fi

            thunk.mark_synthesized()

            _symbol_table.current_closure_context.add_closure(thunk)

            return thunk
        si
    si
si
