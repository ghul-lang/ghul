namespace Syntax.Process is
    use Semantic.Types.Type

    // The element type of the array a list comprehension builds. An
    // annotation (`[...]: T[]`) decides it first, then the type the
    // context expects, and only then the element expression's own type.
    class COMPREHENSION_ELEMENT_TYPE is
        init() is si

        // The element type the annotation or the context asks for, or null
        // where neither asks. A context still being inferred asks nothing:
        // its element type is a placeholder that the elements themselves
        // have to decide.
        constraint(explicit_array_type: Type?, expected_type: Type?) -> Type? =>
            if let explicit = explicit_array_type then
                explicit.get_element_type()
            elif let expected = expected_type /\ expected.is_settled then
                expected.get_element_type()
            else
                null
            fi

        // The constraint where there is one, otherwise the element's own
        // type. Null where the element has no type to give, which is only
        // the case for `null` itself; an error type passes through, since
        // the error has been reported already.
        element_type(constraint: Type?, value_type: Type?) -> Type? =>
            if let c = constraint then
                c
            elif let v = value_type then
                if v.is_error then
                    v
                elif v.is_null then
                    null
                else
                    v
                fi
            else
                Semantic.Types.ERROR()
            fi

        // Whether an element of `value_type` can go into an array whose
        // element type is `constraint`. Anything already in error fits, so
        // that one mistake is reported once.
        fits(constraint: Type?, value_type: Type?) -> bool is
            if let c = constraint, v = value_type then
                return c.is_error \/ v.is_error \/ c.is_assignable_from(v)
            fi

            return true
        si
    si
si
