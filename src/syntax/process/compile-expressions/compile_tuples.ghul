namespace Syntax.Process is
    use System.Exception

    use Logging

    use Semantic.LEAST_UPPER_BOUND_MAP
    use Semantic.Types.Type

    use IR.Values
    use IR.VALUE_BOXER

    use Ghul.Pipes

    // Compiles tuple and list/array (`SEQUENCE`) literal expressions.
    // Split out of COMPILE_EXPRESSIONS, which delegates pre(tuple),
    // visit(tuple) and the inner sequence compile here. The
    // exception-handling and walk orchestration for visit(sequence)
    // stays on the visitor; visit_sequence is the enclosed logic.
    class COMPILE_TUPLES is
        _logger: Logger
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        _value_boxer: VALUE_BOXER
        _visitor: COMPILE_EXPRESSIONS
        _placeholder_resolver: Semantic.SETTLED_PLACEHOLDER_RESOLVER
        _match_propagator: Semantic.MATCH_PROPAGATOR

        init(
            logger: Logger,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup,
            value_boxer: VALUE_BOXER,
            visitor: COMPILE_EXPRESSIONS
        ) is
            super.init()

            _logger = logger
            _innate_symbol_lookup = innate_symbol_lookup
            _value_boxer = value_boxer
            _visitor = visitor
            _placeholder_resolver = Semantic.SETTLED_PLACEHOLDER_RESOLVER()
            _match_propagator = Semantic.MATCH_PROPAGATOR(logger)
        si

        pre_tuple(tuple: Trees.Expressions.TUPLE) -> bool is
            if tuple.elements.expressions.count == 1 then
                // Single-element TUPLE is a parenthesised expression
                // (TUPLE.visit unwraps its value). Forward whatever
                // constraint applies to the outer expression directly
                // to the inner one — splitting a value-tuple constraint
                // across a phantom 1-tuple slot would push the wrong
                // element type down into the inner expression.
                if tuple.expected_type? then
                    let forward_pack = tuple.compile_expressions_state.pack_marker
                    let forward_slot = tuple.compile_expressions_state.pack_slot

                    tuple.elements.expressions[0].set_expected_type(tuple.expected_type, tuple.expected_type_error_message)

                    if forward_pack > 0 then
                        tuple.set_expects_pack(forward_pack - 1, forward_slot)
                    fi
                else
                    tuple.elements.expressions[0].clear_expected_type()
                fi
            elif let tuple.expected_type? /\ expected_type.is_value_tuple then
                for (element, type) in tuple.elements |> zip(expected_type.arguments) do
                    element.set_expected_type(type, tuple.expected_type_error_message)
                od
            else
                for element in tuple.elements do
                    element.clear_expected_type()
                od
            fi

            return false
        si

        visit_tuple(tuple: Trees.Expressions.TUPLE) is
            // A type ascription on a parenthesised group only means
            // something when the group turns out to be a lambda's
            // destructured parameter, which consumes it before any
            // value is compiled. Reaching here with one still attached
            // means the group is an ordinary tuple value, where the
            // ascription has no effect and would otherwise be dropped
            // in silence.
            if let tuple.type_expression? then
                _logger.error(type_expression.location, "type not allowed here")
            fi

            let names: Collections.LIST[string]? mut = Collections.LIST[string]()
            let values = Collections.LIST[Value]()
            let types = Collections.LIST[Type]()

            let element_constraints: Collections.List[Type]? mut = null
            let expected_type_error_message: string? mut = null

            if let tuple.expected_type? /\ expected_type.is_value_tuple then
                element_constraints = expected_type.arguments
                expected_type_error_message = tuple.expected_type_error_message
            fi

            if tuple.elements.expressions.count == 1 then
                // A single parenthesised element is a grouped expression,
                // not a tuple — there are no single-element tuples (a bare
                // `(x)` is just `x`). A named/typed sole element (`(x = 1)`
                // / `(x: int)`) is an attempt at one; report it rather than
                // collapsing to the element's unset value, which would
                // poison to ERROR and crash IL emission far downstream.
                if let element: Trees.Expressions.TUPLE_ELEMENT = tuple.elements.expressions[0] then
                    _logger.error(element.location, "single-element tuples are not supported; a tuple needs two or more elements")
                    tuple.compile_expressions_state.value = IR.Values.DUMMY(Semantic.Types.ERROR(), tuple.location)
                else
                    tuple.compile_expressions_state.value = tuple.elements.expressions[0].value
                fi
                return
            elif tuple.elements.expressions.count == 0 then
                tuple.compile_expressions_state.value = IR.Values.DUMMY(Semantic.Types.ERROR(), tuple.location)

                _logger.error(tuple.location, "empty tuple")
                return
            elif tuple.elements.expressions.count > Semantic.Lookups.INNATE_TYPE_LIMITS.MAX_TUPLE_ELEMENTS then
                tuple.compile_expressions_state.value = IR.Values.DUMMY(Semantic.Types.ERROR(), tuple.location)

                _logger.error(
                    tuple.location,
                    "a tuple literal cannot have more than {Semantic.Lookups.INNATE_TYPE_LIMITS.MAX_TUPLE_ELEMENTS} elements")
                return
            fi

            let seen_any_named mut = false

            for (index, v) in tuple.elements |> index() do
                let element_type_constraint =
                    if element_constraints? then
                        element_constraints[index]
                    else
                        null
                    fi

                if isa Trees.Expressions.TUPLE_ELEMENT(v) then
                    let element = v

                    seen_any_named = true
                    names.add(element.name.name)

                    // An attribute pragma only makes sense on a lambda
                    // parameter — reaching here means the parenthesised
                    // list was never rewritten into one (no `->`/`=>`/
                    // `is`/`rec` followed), so this is a genuine tuple
                    // literal instead.
                    if element.pragmas? then
                        for pragma in element.pragmas do
                            _logger.error(pragma.location, "attribute is not allowed here")
                        od
                    fi

                    if element.initializer? then
                        if Value.check_is_consumable(_logger, element.initializer.location, element.initializer.value) then
                            if element.type_expression.type? then
                                let expr_type = element.type_expression.type
                                let type =
                                    if element_type_constraint? then
                                        element_type_constraint
                                    else
                                        expr_type
                                    fi

                                let init_value = element.initializer!.value!

                                if element.type_expression.check_is_not_reference(_logger, "tuple element cannot be a ref type") then
                                    if !type.is_assignable_from(init_value.type!) then
                                        let use qualified = IoC.CONTAINER.instance.name_display.qualifying_alike(init_value.type, type)
                                        _logger.error(element.location, "{init_value.type} is not assignable to {type}")
                                    elif element_type_constraint? /\ !element_type_constraint.is_assignable_from(expr_type) then
                                        let use qualified = IoC.CONTAINER.instance.name_display.qualifying_alike(expr_type, element_type_constraint)
                                        _logger.error(
                                            element.type_expression.location,
                                            string.format(expected_type_error_message!, [expr_type, element_type_constraint]:object))
                                    fi
                                fi

                                types.add(type)
                                values.add(_value_boxer.box_if_needed(init_value, type))

                            elif element_type_constraint? then
                                let type = element_type_constraint
                                let init_value = element.initializer!.value!

                                if !type.is_assignable_from(init_value.type!) then
                                    let use qualified = IoC.CONTAINER.instance.name_display.qualifying_alike(init_value.type, type)
                                    _logger.error(
                                        element.location,
                                        string.format(expected_type_error_message!, [init_value.type!, type]:object))
                                fi

                                types.add(type)
                                values.add(_value_boxer.box_if_needed(init_value, type))
                            else
                                let init_value = element.initializer!.value!
                                types.add(init_value.type!)
                                values.add(init_value)
                            fi

                            continue
                        fi
                    else
                        _logger.error(element.location, "tuple element must have a value")
                    fi

                    values.add(IR.Values.DUMMY(Semantic.Types.ERROR(), element.location))
                    types.add(Semantic.Types.ERROR())

                elif Value.check_is_consumable(_logger, v.location, v.value) then
                    let v_value = v.value!

                    if v.is_identifier then
                        // An unnamed element that is a plain identifier
                        // takes its name from that identifier: `(a, b)`
                        // is `(a = a, b = b)`. TUPLE_ELEMENT_NAME owns
                        // the underscore-strip corner cases.
                        let identifier_name = v.try_copy_as_identifer()!.name
                        let is_field_symbol =
                            isa IR.Values.Load.SYMBOL(v_value) /\
                            v_value.has_symbol /\
                            v_value.symbol.is_field

                        names.add(TUPLE_ELEMENT_NAME.infer(identifier_name, is_field_symbol))
                        seen_any_named = true
                    else
                        names.add("{index}")
                    fi

                    if element_type_constraint? then
                        let type = element_type_constraint

                        if !type.is_assignable_from(v_value.type!) then
                            let use qualified = IoC.CONTAINER.instance.name_display.qualifying_alike(v_value.type, type)
                            _logger.error(
                                v.location,
                                string.format(expected_type_error_message!, [v_value.type!, type]:object))
                        fi

                        types.add(type)
                        values.add(_value_boxer.box_if_needed(v_value, type))
                    else
                        types.add(v_value.type!)
                        values.add(v_value)
                    fi
                else
                    values.add(IR.Values.DUMMY(Semantic.Types.ERROR(), v.location))
                    types.add(Semantic.Types.ERROR())
                fi

                debug_unindent()
            od

            if !seen_any_named then
                names = null
            fi

            let type = _innate_symbol_lookup.get_tuple_type(_placeholder_resolver.resolve_all(types), names)
            tuple.compile_expressions_state.value = TUPLE(type, values)
        si

        // The element type of an empty literal nothing around it has
        // typed. The literal stands as an array of a placeholder while the
        // body is walked: a sibling it joins with, or a formal it is
        // passed to, bounds the placeholder, and the next walk types the
        // literal from that. A placeholder nothing bounds is taken to
        // object by the fixing step, and null here then lets the caller
        // take that default.
        _await_element_type(sequence: Trees.Expressions.SEQUENCE) -> Type? is
            let function = _visitor.current_function

            if !function? then
                return null
            fi

            let origin =
                Semantic.RESULT_ORIGINS.origin_for(
                    sequence,
                    sequence.location,
                    cast Semantic.Scope(function),
                    "$[]@{sequence.location.start_line}:{sequence.location.start_column}")

            if !origin? \/ Semantic.OBLIGATIONS.has_default_for(origin) then
                return null
            fi

            origin.description = "the element type of this list literal"

            let inferred = origin.try_get_inferred_type()

            if inferred? /\ inferred.is_settled then
                return inferred
            fi

            let placeholder = Semantic.Types.INFERRED_VARIABLE_TYPE(origin)

            Semantic.OBLIGATIONS.defer(Semantic.OBLIGATIONS.EMPTY_LITERAL, placeholder, sequence.location)

            return placeholder
        si

        visit_sequence(sequence: Trees.Expressions.SEQUENCE) is
            let type: Type? mut = _
            let have_explicit_type: bool mut = _

            let elements = Collections.LIST[Trees.Expressions.Expression](sequence.elements)

            let constraint_type: Type? mut = _
            if let sequence.expected_type? then
                constraint_type = expected_type.get_element_type()
            fi

            if !isa Trees.TypeExpressions.INFER(sequence.type_expression) then
                if sequence.type_expression.type? then
                    type = sequence.type_expression.type

                    have_explicit_type = true
                else
                    // FIXME probably not needed - type pass will have given an error
                    _logger.error(sequence.type_expression.location, "bad explicit type expression")
                    return
                fi
            elif elements.count == 0 then
                if constraint_type? then
                    type = constraint_type
                    have_explicit_type = true
                elif let awaited = _await_element_type(sequence) then
                    type = awaited
                else
                    // No elements to infer from, no constraint pushed by
                    // the surrounding context, and nothing the walks
                    // recorded against the element type: fall back to an
                    // object element type, the same as a literal whose
                    // elements are all null.
                    _logger.hint(
                        sequence.location,
                        "infer-object-from-list-literal",
                        "list literal element type inferred as object",
                        sequence.location,
                        "help: give the literal an explicit type")

                    type = _innate_symbol_lookup.get_object_type()
                fi
            else
                let seen_any mut = false
                let seen_error mut = false
                let all_tuple_literals mut = elements.count > 0 // assume all tuples until proved otherwise
                let tuples_element_count mut = -1
                let any_tuple_argument_is_null mut = false
                let lub = LEAST_UPPER_BOUND_MAP()

                for v in elements do
                    let is_tuple =
                        v.is_tuple_literal \/
                        (v.value? /\ v.value.type? /\ (v.value.type.is_value_tuple \/ isa Semantic.Types.TUPLE(v.value.type)) /\ !v.value.type.is_optional)

                    if !is_tuple then
                        all_tuple_literals = false
                    fi

                    if let v.value? /\ value.type? then
                        if value.check_is_consumable(_logger, v.location) then
                            if value.type!.is_inferred then
                                // A placeholder answers `is_null`, so it is
                                // added to the join here, ahead of the null
                                // literal's own handling.
                                lub.add(value.type!)
                            elif !value.type!.is_null then
                                seen_any = true
                                lub.add(value.type!)
                            elif value.type!.is_error then
                                seen_error = true
                            fi

                            if is_tuple then
                                if tuples_element_count == -1 then
                                    tuples_element_count = value.type!.arguments.count
                                elif value.type!.arguments.count != tuples_element_count then
                                    all_tuple_literals = false
                                fi

                                // `Types.NULL.matches` answers true against
                                // any type, so a naive structural LUB over
                                // the whole tuple types below judges a
                                // `null`-carrying tuple argument position
                                // "the same as" a value-carrying one at a
                                // sibling element and picks one arbitrarily,
                                // instead of widening that position to its
                                // optional carrier. Route around the naive
                                // LUB and straight to the per-position
                                // TUPLE_ELEMENT_LUB whenever that can happen.
                                if value.type!.arguments |> any(a => a.is_null /\ !a.is_inferred) then
                                    any_tuple_argument_is_null = true
                                fi
                            fi
                        else
                            seen_error = true
                        fi
                    else
                        seen_error = true
                    fi
                od

                if !type? then
                    type = lub.get_result()

                    // The join waits for an element whose type is still
                    // being inferred - a local assigned later in the body -
                    // so the literal waits with it rather than settling
                    // whatever it is assigned to at a type that element may
                    // not fit.
                    if type? /\ type.is_inferred /\ !constraint_type? then
                        _logger.mark_consumed_any()
                        _logger.error(sequence.location, "cannot infer type here")

                        sequence.compile_expressions_state.value = DUMMY(_innate_symbol_lookup.get_array_type(Semantic.Types.ERROR()), sequence.location)
                        return
                    fi

                    if all_tuple_literals /\ (!type? \/ !type.is_value_tuple \/ any_tuple_argument_is_null) then
                        let tuple_types = Collections.LIST[Type]()

                        for element in elements do
                            if let element.value? /\ value.type? then
                                tuple_types.add(value.type)
                            fi
                        od

                        // The join builds a tuple of as many elements as
                        // the widest element has, so an element that is
                        // not a usable tuple - one already reported, or
                        // one past the element limit - has no tuple type
                        // to join into. The element's own diagnostic is
                        // the one worth keeping.
                        if
                            tuple_types |> any(t =>
                                t.is_error \/
                                t.arguments.count == 0 \/
                                t.arguments.count >
                                    Semantic.Lookups.INNATE_TYPE_LIMITS.MAX_TUPLE_ELEMENTS)
                        then
                            sequence.compile_expressions_state.value =
                                DUMMY(_innate_symbol_lookup.get_array_type(Semantic.Types.ERROR()), sequence.location)

                            return
                        fi

                        type = Semantic.TUPLE_ELEMENT_LUB(_innate_symbol_lookup).combine(tuple_types, lub.element_names)

                        let use retry_site = RETRY_SITE_STATS.enter("tuples.sequence_element_rewalk")
                        // going to walk the elements again, so roll back
                        // and re-speculate to avoid duplicate / misleading
                        // error messages
                        _logger.roll_back()
                        _logger.speculate()

                        // re-walk the type expression if present, to avoid
                        // hiding any error message it may generate

                        sequence.type_expression.walk(_visitor)

                        for e in sequence.elements do
                            e.set_expected_type(type, "element type {{0}} not compatible with inferred list type {{1}}")
                            _visitor.rewalk(e)
                        od
                    fi
                fi

                // Reconcile bottom-up LUB with any constraint pushed
                // by the parent context. Prefer the more-specific
                // bottom-up type when it satisfies the constraint —
                // that preserves the runtime allocation precision the
                // covariance idiom relies on (e.g. `let ao: object[]
                // = ["a", "b"];` should produce a string[] at run
                // time, even though the variable is declared
                // object[]). When the LUB doesn't satisfy the
                // constraint, fall back to the constraint's element
                // type and drive per-element mismatch errors via the
                // post-walk assignability check.
                if constraint_type? then
                    if !type? \/ !constraint_type.is_assignable_from(type) then
                        type = constraint_type
                        have_explicit_type = true
                    fi
                fi

                if !type? then
                    if seen_error then
                        sequence.compile_expressions_state.value = DUMMY(_innate_symbol_lookup.get_array_type(Semantic.Types.ERROR()), sequence.location)
                        return
                    elif seen_any then
                        _logger.hint(
                            sequence.location,
                            "infer-object-from-list-literal",
                            "list literal element type inferred as object",
                            sequence.location,
                            "help: give the literal an explicit type")
                        type = _innate_symbol_lookup.get_object_type()
                    else
                        _logger.error(sequence.location, "cannot infer type of list literal with only null elements")

                        sequence.compile_expressions_state.value = DUMMY(_innate_symbol_lookup.get_array_type(Semantic.Types.ERROR()), sequence.location)
                        return
                    fi
                fi
            fi

            let values = Collections.LIST[Value](sequence.elements.expressions.count)

            for v in sequence.elements do
                if let v.value? /\ value.type? then
                    let u = value.type

                    // An element whose own type is still being inferred - a
                    // local the body types from its uses - is one of those
                    // uses, so the element type the literal settled on is
                    // pushed back to it as a bound. The propagation recurses
                    // into generic arguments, so an element with a
                    // placeholder anywhere inside it is one to push into.
                    if u.contains_inferred then
                        _match_propagator.propagate_match(type, u)

                        values.add(v.value!)

                        continue
                    fi

                    // FIXME should push explicit type into element as constraint and retry
                    if have_explicit_type /\ !type.is_assignable_from(u) then
                        _logger.error(v.location, "element not compatible with explicit type")
                    fi

                    values.add(v.value!)
                else
                    values.add(DUMMY(Semantic.Types.ERROR(), v.location))
                fi
            od

            sequence.compile_expressions_state.value =
                SEQUENCE(_innate_symbol_lookup.get_array_type(type), type, values)
        si
    si
si
