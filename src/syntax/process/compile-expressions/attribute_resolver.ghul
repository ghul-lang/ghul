namespace Syntax.Process is
    use Logging
    use Source
    use IoC

    use Semantic.Types.Type

    use System.Text.StringBuilder

    // Resolves an attribute pragma — a pragma whose name is not a built-in
    // compiler pragma — to a .NET attribute type and constructor, and
    // attaches the resolved CUSTOM_ATTRIBUTE to the target symbol, from
    // which the emitter encodes the attribute's value blob.
    //
    // The `format_*` half renders the arguments as assembler source. The
    // rendering itself is unused (see CUSTOM_ATTRIBUTE), but an argument
    // shape it cannot render makes it answer null, and that is what
    // rejects the attribute — so it is the argument validation, spelled
    // as a renderer.
    class ATTRIBUTE_RESOLVER is
        _logger: Logger
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        _overload_resolver: Semantic.OVERLOAD_RESOLVER
        _visitor: ScopedVisitor

        init(
            logger: Logger,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup,
            overload_resolver: Semantic.OVERLOAD_RESOLVER,
            visitor: ScopedVisitor
        ) is
            super.init()

            _logger = logger
            _innate_symbol_lookup = innate_symbol_lookup
            _overload_resolver = overload_resolver
            _visitor = visitor
            _unsettled_offsets = Collections.MAP[Semantic.Symbols.Field, Source.LOCATION]()
        si

        // A built-in pragma is handled by the compiler itself; anything
        // else is taken to name a .NET attribute.
        is_built_in(name: string) -> bool =>
            IL_PRAGMAS.is_il_pragma(name) \/
            name.starts_with("IF.") \/
            name =~ "precedence" \/
            name =~ "entry" \/
            name =~ "suppress" \/
            name =~ "equality" \/
            name =~ "intrinsic"

        resolve(pragma: Trees.Pragmas.PRAGMA, target: Semantic.Symbols.Symbol?) is
            let name = pragma.name.to_string()

            // The test pragmas emitted MSTest 3 attributes against an
            // assembly name MSTest 4 no longer ships, so the tests they
            // marked were silently not discovered. The attributes are
            // written as attributes now instead. The name is rejected
            // whatever the pragma was written against, so a use inside a
            // body — which resolves against no target — reports too.
            if name =~ "test" \/ name =~ "test_class" \/ name =~ "test_method" then
                _logger.error(
                    pragma.name.location,
                    "{name} is not supported",
                    pragma.name.location,
                    "help: use the test framework's attributes, as in @TestClass() on the class and @TestMethod() on the method")
                return
            fi

            // A pragma in the `IL.` family the compiler does not act on is
            // a misspelling or one that has been removed. Left to the
            // built-in test below it would be acted on as one and emit
            // nothing: the program would compile and quietly mean something
            // other than what it says. Reported whatever the pragma was
            // written against, so a use inside a body — which resolves
            // against no target — reports too.
            if
                IL_PRAGMAS.is_il_pragma(name) /\
                !IL_PRAGMAS.is_known(name)
            then
                _logger.warn(
                    pragma.name.location, "unknown-pragma", "unknown pragma {name}")

                return
            fi

            // A pragma naming a fact about a .NET assembly is a use of a
            // feature the target may not carry. Reported after the
            // unknown-pragma check, so a misspelling draws the one
            // diagnostic about it being unknown and not a second one about
            // the target; and before the target check, so one inside a
            // body reports too. The compiler's own synthesised pragma is
            // not a use the program wrote.
            if IL_PRAGMAS.is_il_pragma(name) /\ !pragma.is_synthesised then
                IoC.CONTAINER.instance.capability_checker.check(
                    Semantic.Capability.IL_PRAGMA,
                    pragma.name.location,
                    "pragma {name}")
            fi

            if !target? then
                return
            fi

            // `intrinsic` is the compiler's own spelling of the intrinsic
            // marker. The operation it names is recorded from the pragma
            // whatever the target; where this compilation's reference set
            // holds Ghul.Internal.INTRINSIC_ATTRIBUTE — .NET, whose
            // reflected compilations read the marker back — the pragma is
            // emitted as that attribute, and where nothing holds it, it
            // emits nothing.
            if name =~ "intrinsic" then
                let intrinsic_attribute = _intrinsic_attribute()

                if intrinsic_attribute? then
                    _record_attribute(pragma, target, intrinsic_attribute)
                fi

                return
            fi

            if is_built_in(name) then
                return
            fi

            let attribute_type = resolve_attribute_type(pragma.name)

            if !attribute_type? then
                _logger.error(pragma.name.location, "unknown attribute {name}")
                return
            fi

            _record_attribute(pragma, target, attribute_type)
        si

        // Resolves the pragma's arguments against the attribute type's
        // constructor and records the attribute on the target, shared by
        // the ordinary pragma-as-attribute path and the `intrinsic`
        // spelling.
        _record_attribute(
            pragma: Trees.Pragmas.PRAGMA,
            target: Semantic.Symbols.Symbol,
            attribute_type: Semantic.Symbols.Classy
        ) is
            let positional = gather_positional_arguments(pragma)

            let constructor = resolve_constructor(pragma, attribute_type, positional)

            if !constructor? then
                return
            fi

            let completed = complete_positional_arguments(constructor, positional)

            let named = resolve_named_arguments(attribute_type, pragma)

            if !named? then
                return
            fi

            if !format_arguments(pragma, constructor, completed, named)? then
                return
            fi

            // `DllImport` is not carried as a custom attribute: it is a
            // pseudo-attribute, whose whole content becomes flags on the
            // method row and a row in the ImplMap table.
            if attribute_type == _dll_import_attribute() then
                _resolve_pinvoke(pragma, target, completed, named)
                return
            fi

            // `MethodImpl` is a pseudo-attribute too: the runtime reads
            // the options it names from the method row's implementation
            // flags, so carrying it as a custom attribute leaves the JIT
            // seeing nothing.
            if attribute_type == _method_impl_attribute() then
                _resolve_method_impl(pragma, target, completed)
                return
            fi

            // `StructLayout` and `FieldOffset` are pseudo-attributes as well:
            // the runtime lays a type out from its flags and its ClassLayout
            // and FieldLayout rows, and reads neither as a custom attribute.
            if attribute_type == _struct_layout_attribute() then
                _resolve_struct_layout(pragma, target, completed, named)
                return
            fi

            if attribute_type == _field_offset_attribute() then
                _resolve_field_offset(pragma, target, completed)
                return
            fi

            if !target.custom_attributes? then
                target.custom_attributes = Collections.LIST[Semantic.CUSTOM_ATTRIBUTE]()
            fi

            let attributes = target.custom_attributes!

            for i in 0..attributes.count do
                if attributes[i].pragma == pragma then
                    attributes.remove_at(i)
                    break
                fi
            od

            attributes.add(
                Semantic.CUSTOM_ATTRIBUTE(constructor, completed, named, pragma))

            if attribute_type == _obsolete_attribute() then
                target.set_deprecation(_deprecation_of(completed))
            fi
        si

        _obsolete_attribute_resolved: bool
        _obsolete: Semantic.Symbols.Symbol?

        _obsolete_attribute() -> Semantic.Symbols.Symbol? is
            if !_obsolete_attribute_resolved then
                _obsolete_attribute_resolved = true
                _obsolete = _visitor.find("System")?.find_member("ObsoleteAttribute")
            fi

            return _obsolete
        si

        _intrinsic_attribute_resolved: bool
        _intrinsic_attribute_symbol: Semantic.Symbols.Classy?

        // Resolved through the symbol table rather than the scope: the
        // namespace is deliberately unnameable from source, so no `use`
        // can import it, and the table holds the type whether or not the
        // compilation names it. Null where the reference set carries no
        // runtime to declare it.
        _intrinsic_attribute() -> Semantic.Symbols.Classy? is
            if !_intrinsic_attribute_resolved then
                _intrinsic_attribute_resolved = true

                _intrinsic_attribute_symbol =
                    cast Semantic.Symbols.Classy?(
                        IoC.CONTAINER.instance.dotnet_symbol_table.value
                            .get_symbol("Ghul.Internal.INTRINSIC_ATTRIBUTE"))
            fi

            return _intrinsic_attribute_symbol
        si

        // ObsoleteAttribute's arguments, in constructor order: a message,
        // then whether a use is an error. Either can be left out.
        _deprecation_of(arguments: Collections.List[IR.Values.Value]) -> Semantic.DEPRECATION is
            let message =
                if arguments.count > 0 then
                    if let text: IR.Values.Literal.STRING = arguments[0] then text.value else null fi
                else
                    null
                fi

            let is_error =
                if arguments.count > 1 then
                    if let number: IR.Values.Literal.NUMBER = arguments[1] then
                        if let i4: IR.Values.Literal.CONSTANT.I4 = number.constant then i4.value != 0 else false fi
                    else
                        false
                    fi
                else
                    false
                fi

            return Semantic.DEPRECATION(message, is_error)
        si

        // Every type in the signature has to be one the runtime can
        // carry into the library. Reported at the method, naming the
        // type that cannot cross.
        _check_pinvoke_signature(
            pragma: Trees.Pragmas.PRAGMA,
            function: Semantic.Symbols.Function
        ) -> bool is
            let signature = Semantic.PINVOKE_SIGNATURE(_innate_symbol_lookup)

            let names = function.argument_names

            for i in 0..function.arguments.count do
                if !signature.can_take(function.arguments[i]) then
                    _logger.error(
                        pragma.name.location,
                        "{names[i]} is a {function.arguments[i]}, which cannot be passed to a shared library")

                    return false
                fi
            od

            if !signature.can_return(function.return_type) then
                _logger.error(
                    pragma.name.location,
                    "{function.return_type} cannot be returned from a shared library")

                return false
            fi

            return true
        si

        // The attribute type itself, resolved once through the symbol
        // table and compared by identity: a type is recognised by which
        // symbol it is rather than by what it renders as, so a user type
        // that happens to qualify the same way is not taken for this one
        // and a change to how a type is spelled cannot quietly stop it
        // being recognised.
        _dll_import: Semantic.Symbols.Symbol?
        _dll_import_resolved: bool

        _dll_import_attribute() -> Semantic.Symbols.Symbol? is
            if _dll_import_resolved then
                return _dll_import
            fi

            _dll_import_resolved = true

            let system = _visitor.find("System")

            if !system? then
                return null
            fi

            let runtime = system.find_member("Runtime")

            if !runtime? then
                return null
            fi

            let interop = runtime.find_member("InteropServices")

            if !interop? then
                return null
            fi

            _dll_import = interop.find_member("DllImportAttribute")

            return _dll_import
        si

        _method_impl: Semantic.Symbols.Symbol?
        _method_impl_resolved: bool

        _method_impl_attribute() -> Semantic.Symbols.Symbol? is
            if _method_impl_resolved then
                return _method_impl
            fi

            _method_impl_resolved = true

            let system = _visitor.find("System")

            if !system? then
                return null
            fi

            let runtime = system.find_member("Runtime")

            if !runtime? then
                return null
            fi

            let compiler_services = runtime.find_member("CompilerServices")

            if !compiler_services? then
                return null
            fi

            _method_impl = compiler_services.find_member("MethodImplAttribute")

            return _method_impl
        si

        // Reads a `MethodImpl` into the flags the method row carries.
        // `MethodImplOptions` and `MethodImplAttributes` number the same
        // bits, so the value the attribute names is the value the row
        // takes.
        _resolve_method_impl(
            pragma: Trees.Pragmas.PRAGMA,
            target: Semantic.Symbols.Symbol,
            positional: Collections.List[IR.Values.Value]
        ) is
            let function = cast Semantic.Symbols.Function?(target)

            if !function? then
                _logger.error(pragma.name.location, "only a method can carry MethodImpl")
                return
            fi

            // Written with no options at all, the attribute asks for
            // nothing and the row keeps its defaults. Written with one
            // this cannot read, saying so beats leaving the method with
            // the flags it would have had anyway.
            if positional.count == 0 then
                return
            fi

            let options = _number_argument(positional, 0)

            if !options? then
                _logger.error(pragma.name.location, "cannot read the options this MethodImpl names")
                return
            fi

            function.method_impl_attributes =
                cast System.Reflection.MethodImplAttributes(options)
        si

        _interop_services: Semantic.Symbols.Symbol?
        _interop_services_resolved: bool

        _interop_services_namespace() -> Semantic.Symbols.Symbol? is
            if !_interop_services_resolved then
                _interop_services_resolved = true
                _interop_services = _visitor.find("System")?.find_member("Runtime")?.find_member("InteropServices")
            fi

            return _interop_services
        si

        _struct_layout: Semantic.Symbols.Symbol?
        _struct_layout_resolved: bool

        _struct_layout_attribute() -> Semantic.Symbols.Symbol? is
            if !_struct_layout_resolved then
                _struct_layout_resolved = true
                _struct_layout = _interop_services_namespace()?.find_member("StructLayoutAttribute")
            fi

            return _struct_layout
        si

        _field_offset: Semantic.Symbols.Symbol?
        _field_offset_resolved: bool

        _field_offset_attribute() -> Semantic.Symbols.Symbol? is
            if !_field_offset_resolved then
                _field_offset_resolved = true
                _field_offset = _interop_services_namespace()?.find_member("FieldOffsetAttribute")
            fi

            return _field_offset
        si

        // Reads a `StructLayout` into the layout the type is emitted with.
        // A type's own pragmas are resolved after its members', so every
        // `FieldOffset` in it is already recorded, and an explicit layout
        // that leaves a field without one - which the runtime refuses to
        // load - is reported here.
        _resolve_struct_layout(
            pragma: Trees.Pragmas.PRAGMA,
            target: Semantic.Symbols.Symbol,
            positional: Collections.List[IR.Values.Value],
            named: Collections.List[Semantic.NAMED_ATTRIBUTE_ARGUMENT]
        ) is
            let type = cast Semantic.Symbols.Classy?(target)

            if
                !type? \/
                type.is_trait \/
                isa Semantic.Symbols.UNION(type) \/
                isa Semantic.Symbols.VARIANT(type) \/
                isa Semantic.Symbols.ENUM_STRUCT(type)
            then
                _logger.error(pragma.name.location, "only a class or a struct can carry StructLayout")
                return
            fi

            let layout =
                Semantic.TYPE_LAYOUT(
                    cast System.Runtime.InteropServices.LayoutKind(_number_argument(positional, 0) ?? 0),
                    System.Math.max(_named_number(named, "Pack"), 0),
                    System.Math.max(_named_number(named, "Size"), 0),
                    System.Math.max(_named_number(named, "CharSet"), 0))

            type.layout = layout

            _settle_offsets(type, layout.is_explicit)

            if layout.is_explicit then
                let missing = Collections.LIST[string]()

                for symbol in type.symbols do
                    if let `field = _instance_field(symbol) /\ `field.owner == type /\ !`field.layout_offset? then
                        missing.add(if `field.name.starts_with("$") then `field.name.substring(1) else `field.name fi)
                    fi
                od

                if missing.count > 0 then
                    missing.sort()

                    _logger.error(
                        pragma.name.location,
                        "explicit layout needs a FieldOffset on {missing |> Ghul.Pipes.join(", ")}")
                fi
            fi
        si

        // A field each instance holds its own copy of, in a class or in a
        // struct: the only kind a layout places.
        _instance_field(symbol: Semantic.Symbols.Symbol) -> Semantic.Symbols.Field? =>
            if isa Semantic.Symbols.INSTANCE_FIELD(symbol) \/ isa Semantic.Symbols.STRUCT_FIELD(symbol) then
                cast Semantic.Symbols.Field(symbol)
            else
                null
            fi

        _resolve_field_offset(
            pragma: Trees.Pragmas.PRAGMA,
            target: Semantic.Symbols.Symbol,
            positional: Collections.List[IR.Values.Value]
        ) is
            let `field = _instance_field(target)

            if !`field? then
                _logger.error(pragma.name.location, "only an instance field can carry FieldOffset")
                return
            fi

            `field.layout_offset = _number_argument(positional, 0)

            _unsettled_offsets[`field] = pragma.name.location
        si

        // Offsets whose type has not yet said whether it is laid out
        // explicitly. A type's own pragmas are resolved after its members',
        // so its StructLayout settles them, and any left when the type's file
        // has been walked belong to a type that never asked for explicit
        // layout.
        _unsettled_offsets: Collections.MAP[Semantic.Symbols.Field, Source.LOCATION]

        _settle_offsets(type: Semantic.Symbols.Classy, explicit: bool) is
            let settled = Collections.LIST[Semantic.Symbols.Field]()

            for (`field, location) in _unsettled_offsets do
                if `field.owner == type then
                    settled.add(`field)

                    if !explicit then
                        _report_offset_without_explicit_layout(location)
                    fi
                fi
            od

            for `field in settled do
                _unsettled_offsets.remove(`field)
            od
        si

        // Reports the offsets still unsettled on types declared in
        // `file_name`, whose pragmas have all been resolved by now.
        report_unsettled_offsets(file_name: string) is
            let reported = Collections.LIST[Semantic.Symbols.Field]()

            for (`field, location) in _unsettled_offsets do
                if let owner: Semantic.Symbols.Symbol = `field.owner /\ owner.location.file_name =~ file_name then
                    reported.add(`field)
                    _report_offset_without_explicit_layout(location)
                fi
            od

            for `field in reported do
                _unsettled_offsets.remove(`field)
            od
        si

        _report_offset_without_explicit_layout(location: Source.LOCATION) is
            _logger.error(location, "a field with a FieldOffset needs a type with explicit layout")
        si

        // Reads a `DllImport` into the import the method is emitted
        // from, and reports the declarations it cannot be written on.
        // Reported here rather than at emission, so a program that
        // cannot be called into says so before any IL is written.
        _resolve_pinvoke(
            pragma: Trees.Pragmas.PRAGMA,
            target: Semantic.Symbols.Symbol,
            positional: Collections.List[IR.Values.Value],
            named: Collections.List[Semantic.NAMED_ATTRIBUTE_ARGUMENT]
        ) is
            let function = cast Semantic.Symbols.Function?(target)

            if !function? then
                _logger.error(pragma.name.location, "only a method can carry DllImport")
                return
            fi

            if function.is_instance then
                _logger.error(pragma.name.location, "a method carrying DllImport must be static")
                return
            fi

            let module = _string_argument(positional, 0)

            if !module? \/ module.length == 0 then
                _logger.error(pragma.name.location, "the module to call into is missing from this DllImport")
                return
            fi

            if !function.is_declared_without_body then
                _logger.error(
                    pragma.name.location,
                    "a method carrying DllImport is the call into the library, so it takes no body of its own")
                return
            fi

            if !_check_pinvoke_signature(pragma, function) then
                return
            fi

            let entry_point = _named_string(named, "EntryPoint") ?? function.name

            function.pinvoke =
                Semantic.PINVOKE_IMPORT(module, entry_point, _import_attributes(named))
        si

        // The flags the runtime marshals the call by, read off the
        // attribute's named arguments. What is not written takes the
        // platform's default, which is what leaving the bit clear says.
        _import_attributes(
            named: Collections.List[Semantic.NAMED_ATTRIBUTE_ARGUMENT]
        ) -> System.Reflection.MethodImportAttributes is
            let flags mut = 0

            if _named_number(named, "SetLastError") == 1 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.SET_LAST_ERROR)
            fi

            if _named_number(named, "ExactSpelling") == 1 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.EXACT_SPELLING)
            fi

            case _named_number(named, "CharSet")
            when 2 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CHAR_SET_ANSI)
            when 3 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CHAR_SET_UNICODE)
            when 4 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CHAR_SET_AUTO)
            else
            esac

            case _named_number(named, "CallingConvention")
            when 1 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CALLING_CONVENTION_WIN_API)
            when 2 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CALLING_CONVENTION_C_DECL)
            when 3 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CALLING_CONVENTION_STD_CALL)
            when 4 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CALLING_CONVENTION_THIS_CALL)
            when 5 then
                flags = flags | cast int(System.Reflection.MethodImportAttributes.CALLING_CONVENTION_FAST_CALL)
            else
            esac

            cast System.Reflection.MethodImportAttributes(flags)
        si

        _string_argument(values: Collections.List[IR.Values.Value], index: int) -> string? is
            if index >= values.count then
                return null
            fi

            if let literal: IR.Values.Literal.STRING = values[index] then
                return literal.value
            fi

            null
        si

        _number_argument(values: Collections.List[IR.Values.Value], index: int) -> int? is
            if index >= values.count then
                return null
            fi

            if let literal: IR.Values.Literal.NUMBER = values[index] then
                if let i4: IR.Values.Literal.CONSTANT.I4 = literal.constant then
                    return i4.value
                fi
            fi

            null
        si

        _named_string(
            named: Collections.List[Semantic.NAMED_ATTRIBUTE_ARGUMENT],
            il_name: string
        ) -> string? is
            for argument in named do
                if argument.il_name =~ il_name then
                    if let literal: IR.Values.Literal.STRING = argument.value then
                        return literal.value
                    fi
                fi
            od

            null
        si

        // A named argument written as a number - an enum member, or a
        // bool - or -1 when the attribute did not write one.
        _named_number(
            named: Collections.List[Semantic.NAMED_ATTRIBUTE_ARGUMENT],
            il_name: string
        ) -> int is
            for argument in named do
                if argument.il_name =~ il_name then
                    if let literal: IR.Values.Literal.NUMBER = argument.value then
                        let rendered = literal.rendered
                        let value mut = 0

                        if int.try_parse(rendered, value ref) then
                            return value
                        fi
                    fi
                fi
            od

            -1
        si

        // The constructor's parameters filled out from what the call
        // site supplied, so that both back ends encode the same
        // arguments in the same order rather than each deciding what an
        // omitted trailing parameter meant.
        //
        // A parameter beyond what was supplied is only reachable through
        // resolve_constructor_with_omitted_optionals, which has already
        // established that every one of them carries a usable literal
        // default.
        complete_positional_arguments(
            constructor: Semantic.Symbols.Function,
            positional: Collections.List[IR.Values.Value]
        ) -> Collections.List[IR.Values.Value] is
            let parameters = constructor.arguments
            let completed = Collections.LIST[IR.Values.Value]()

            for i in 0..parameters.count do
                if i < positional.count then
                    completed.add(positional[i])
                else
                    completed.add(
                        DEFAULT_ARGUMENT_VALUES.build(
                            constructor.argument_defaults[i],
                            parameters[i],
                            _innate_symbol_lookup
                        ))
                fi
            od

            return completed
        si

        // Every `name = value` argument resolved against the attribute's
        // own members, or null once one of them has been reported as
        // naming nothing, naming something that is neither a field nor a
        // property, or having no usable type.
        resolve_named_arguments(
            attribute_type: Semantic.Symbols.Classy,
            pragma: Trees.Pragmas.PRAGMA
        ) -> Collections.List[Semantic.NAMED_ATTRIBUTE_ARGUMENT]? is
            let resolved = Collections.LIST[Semantic.NAMED_ATTRIBUTE_ARGUMENT]()

            let named = pragma.named_arguments

            if !named? then
                return resolved
            fi

            for named_argument in named do
                let name = named_argument.name.to_string()

                let member = attribute_type.find_member(name)

                if !member? then
                    _logger.error(
                        named_argument.name.location,
                        "attribute {attribute_type.name} has no field or property {name}")

                    return null
                fi

                let is_field = member.symbol_kind == Semantic.Symbols.SymbolKind.FIELD

                if
                    !is_field /\
                    member.symbol_kind != Semantic.Symbols.SymbolKind.PROPERTY
                then
                    _logger.error(
                        named_argument.name.location,
                        "{name} is not a field or property of attribute {attribute_type.name}")

                    return null
                fi

                let member_type = member.type

                if !member_type? then
                    _logger.error(
                        named_argument.name.location,
                        "attribute argument {name} has an unsupported type")

                    return null
                fi

                resolved.add(
                    Semantic.NAMED_ATTRIBUTE_ARGUMENT(
                        is_field,
                        member.il_name_override ?? name,
                        member_type,
                        named_argument.value.value,
                        named_argument.value.location))
            od

            return resolved
        si

        // Resolve the pragma name to a .NET attribute class, accepting the
        // `Foo` short form for a `FooAttribute` — whether `Foo` is written
        // bare or fully qualified (`A.B.Foo` resolves `A.B.FooAttribute`).
        resolve_attribute_type(name: Trees.Identifiers.Identifier) -> Semantic.Symbols.Classy? is
            let direct = as_classy(_visitor.try_find(name))

            if direct? then
                return direct
            fi

            let suffixed_name = "{name.name}Attribute"

            if name.is_qualified then
                let qualifier = _visitor.try_find(name.qualifier!)

                if !qualifier? then
                    return null
                fi

                return as_classy(qualifier.find_member(suffixed_name))
            fi

            return as_classy(_visitor.find(suffixed_name))
        si

        as_classy(symbol: Semantic.Symbols.Symbol?) -> Semantic.Symbols.Classy? is
            if !symbol? then
                return null
            fi

            // A name shared across generic arities resolves to a TYPE_GROUP.
            // Applying an attribute supplies no type arguments, so the
            // non-generic member is the intended one.
            if let group: Semantic.Symbols.TYPE_GROUP = symbol then
                return group.find_by_generic_arguments_count(0)
            fi

            return cast Semantic.Symbols.Classy?(symbol)
        si

        gather_positional_arguments(pragma: Trees.Pragmas.PRAGMA) -> Collections.LIST[IR.Values.Value] is
            let result = Collections.LIST[IR.Values.Value]()

            for argument in pragma.arguments.expressions do
                if argument.value? then
                    result.add(argument.value)
                fi
            od

            return result
        si

        resolve_constructor(
            pragma: Trees.Pragmas.PRAGMA,
            attribute_type: Semantic.Symbols.Classy,
            positional: Collections.List[IR.Values.Value]
        ) -> Semantic.Symbols.Function? is
            let init_group = cast Semantic.Symbols.FUNCTION_GROUP?(attribute_type.find_member("init"))

            if !init_group? then
                _logger.error(pragma.location, "attribute {attribute_type.name} has no usable constructor")
                return null
            fi

            let argument_types = Collections.LIST[Type]()

            for argument in positional do
                if argument.type? then
                    argument_types.add(argument.type)
                else
                    argument_types.add(Semantic.Types.ERROR())
                fi
            od

            _logger.speculate()

            let overload_result = _overload_resolver.resolve(pragma.location, init_group, argument_types, false, true, true)

            if overload_result? then
                _logger.commit()
                return overload_result.function
            fi

            let use retry_site = RETRY_SITE_STATS.enter("attributes.constructor_fallback")
            let with_empty_arrays = resolve_constructor_with_empty_arrays(init_group, positional, argument_types)

            if with_empty_arrays? then
                _logger.roll_back()
                return with_empty_arrays
            fi

            let with_omitted_optionals = resolve_constructor_with_omitted_optionals(init_group, argument_types)

            if with_omitted_optionals? then
                _logger.roll_back()
                return with_omitted_optionals
            fi

            _logger.commit()
            _logger.error(pragma.location, "no constructor of attribute {attribute_type.name} matches the supplied arguments")
            return null
        si

        // An empty array literal argument carries no element type of its
        // own, so it falls back to object[] and fails to match a more
        // specific array parameter. An empty array is compatible with any
        // array type, so when the direct resolution fails, retry accepting
        // each empty-array argument against any array parameter of a
        // uniquely matching constructor. The empty array is then formatted
        // with the parameter's element type in format_argument.
        resolve_constructor_with_empty_arrays(
            init_group: Semantic.Symbols.FUNCTION_GROUP,
            positional: Collections.List[IR.Values.Value],
            argument_types: Collections.List[Type]
        ) -> Semantic.Symbols.Function? is
            let have_empty_array mut = false

            for argument in positional do
                if is_empty_array(argument) then
                    have_empty_array = true
                fi
            od

            if !have_empty_array then
                return null
            fi

            let match: Semantic.Symbols.Function? mut = null

            for candidate in init_group.functions do
                if candidate.arguments.count != positional.count then
                    continue
                fi

                let ok mut = true

                for i in 0..positional.count do
                    let parameter = candidate.arguments[i]

                    if is_empty_array(positional[i]) then
                        if !parameter.get_element_type()? then
                            ok = false
                        fi
                    elif !parameter.is_assignable_from(argument_types[i]) then
                        ok = false
                    fi
                od

                if ok then
                    if match? then
                        return null
                    fi

                    match = candidate
                fi
            od

            return match
        si

        // ghūl cannot omit an optional parameter in an ordinary call,
        // so a constructor called with fewer positional arguments
        // than its arity — e.g. an attribute whose .NET constructor
        // carries `CallerFilePath`/`CallerLineNumber` defaults —
        // would otherwise need every trailing default spelled out at
        // the call site. Retry accepting the supplied prefix against
        // a uniquely matching constructor whose unsupplied trailing
        // parameters all declare a default value; format_arguments
        // fills those defaults in.
        //
        // Only a concrete literal default qualifies — the "default"
        // sentinel (a ghūl source `= _` parameter, or a reflected
        // parameter whose CLR default is itself `default(T)`) is
        // excluded, since format_argument has no ilasm literal to
        // render it as for an arbitrary parameter type.
        resolve_constructor_with_omitted_optionals(
            init_group: Semantic.Symbols.FUNCTION_GROUP,
            argument_types: Collections.List[Type]
        ) -> Semantic.Symbols.Function? is
            let match: Semantic.Symbols.Function? mut = null

            for candidate in init_group.functions do
                if candidate.arguments.count <= argument_types.count then
                    continue
                fi

                let ok mut = true

                for i in 0..argument_types.count do
                    if !candidate.arguments[i].is_assignable_from(argument_types[i]) then
                        ok = false
                    fi
                od

                if ok then
                    for i in argument_types.count..candidate.arguments.count do
                        if
                            i >= candidate.argument_defaults.count \/
                            !candidate.argument_defaults[i]? \/
                            candidate.argument_defaults[i] =~ "default"
                        then
                            ok = false
                        fi
                    od
                fi

                if ok then
                    if match? then
                        return null
                    fi

                    match = candidate
                fi
            od

            return match
        si

        is_empty_array(value: IR.Values.Value) -> bool is
            if let sequence: IR.Values.SEQUENCE = value then
                return sequence.values.count == 0
            fi

            return false
        si

        // The ilasm textual custom-attribute body: `( 01 00 00 00 )` when
        // there are no arguments at all, otherwise `{ <fixed>... <named>... }`.
        // Returns null if any argument is not a compile-time constant.
        format_arguments(
            pragma: Trees.Pragmas.PRAGMA,
            constructor: Semantic.Symbols.Function,
            positional: Collections.List[IR.Values.Value],
            named: Collections.List[Semantic.NAMED_ATTRIBUTE_ARGUMENT]
        ) -> string? is
            let have_named = named.count > 0

            if constructor.arguments.count == 0 /\ !have_named then
                return "( 01 00 00 00 )"
            fi

            let parameter_types = constructor.arguments

            let buffer = StringBuilder()

            buffer.append("{{")

            for i in 0..parameter_types.count do
                let formatted = format_argument(parameter_types[i], positional[i])

                if !formatted? then
                    _logger.error(pragma.location, "attribute argument {i + 1} is not a compile-time constant")
                    return null
                fi

                buffer.append(" ").append(formatted)
            od

            if have_named then
                for named_argument in named do
                    let formatted = format_named_argument(named_argument)

                    if !formatted? then
                        return null
                    fi

                    buffer.append(" ").append(formatted)
                od
            fi

            buffer.append(" }}")

            return buffer.to_string()
        si

        // One `name = value` argument in the ilasm textual form —
        // `property <type> 'Name' = <value>` or `field <type> 'Name' = ...`.
        // Returns null (after logging) if the member's type or the value
        // cannot be rendered.
        format_named_argument(
            named_argument: Semantic.NAMED_ATTRIBUTE_ARGUMENT
        ) -> string? is
            let name = named_argument.il_name

            let keyword = if named_argument.is_field then "field" else "property" fi

            let type_token = named_argument_type_token(named_argument.member_type)

            if !type_token? then
                _logger.error(named_argument.location, "attribute argument {name} has an unsupported type")
                return null
            fi

            let formatted_value =
                format_argument(named_argument.member_type, named_argument.value)

            if !formatted_value? then
                _logger.error(named_argument.location, "attribute argument {name} is not a compile-time constant")
                return null
            fi

            return "{keyword} {type_token} '{name}' = {formatted_value}"
        si

        // One positional or named-value argument in the ilasm textual
        // form, or null if `value` is not a supported compile-time
        // constant — a string, a number (optionally negated), a bool, an
        // enum member, `null`, or an array of those.
        format_argument(parameter_type: Type?, value: IR.Values.Value?) -> string? is
            if !value? then
                return null
            fi

            if parameter_type? /\ parameter_type.matches(_innate_symbol_lookup.get_object_type()) then
                let inner = format_typed_value(value)

                if inner? then
                    return "object({inner})"
                fi

                return null
            fi

            if isa IR.Values.NULL(value) then
                if parameter_type? /\ parameter_type.matches(_innate_symbol_lookup.get_string_type()) then
                    return "string(nullref)"
                fi

                return null
            fi

            if let string_value: IR.Values.Literal.STRING = value then
                return "string({quote(string_value.value)})"
            fi

            let number_text = try_get_number_text(value)

            if number_text? then
                let keyword = serialization_keyword(parameter_type)

                if keyword =~ "bool" then
                    return "bool({number_text_to_bool(number_text)})"
                fi

                return "{keyword}({number_text})"
            fi

            if let sequence: IR.Values.SEQUENCE = value then
                // An empty array literal carried no elements to infer from
                // and fell back to object[]; take its element type from the
                // parameter instead.
                if sequence.values.count == 0 /\ parameter_type? then
                    let element_type = parameter_type.get_element_type()

                    if element_type? then
                        let element_token = named_argument_type_token(element_type)

                        if element_token? then
                            return "{element_token}[0]()"
                        fi
                    fi
                fi

                return format_array(sequence)
            fi

            if let typeof_value: IR.Values.TYPEOF = value then
                // A typeof argument can name any type; only a class/struct/
                // enum or an array of one serializes to a blob name, so a
                // typeof of anything else is rejected here rather than
                // reaching the encoder as a name it cannot serialize.
                if _typeof_arg_is_serializable(typeof_value.typeof_type) then
                    return "type"
                fi

                return null
            fi

            return null
        si

        // The ilasm `<element>[N](e0 e1 ...)` form for an array argument.
        format_array(sequence: IR.Values.SEQUENCE) -> string? is
            let element_token = named_argument_type_token(sequence.element_type)

            if !element_token? then
                return null
            fi

            let buffer = StringBuilder()

            buffer
                .append(element_token)
                .append("[")
                .append(sequence.values.count)
                .append("](")

            for i in 0..sequence.values.count do
                if i > 0 then
                    buffer.append(" ")
                fi

                let element = format_array_element(sequence.element_type, sequence.values[i])

                if !element? then
                    return null
                fi

                buffer.append(element)
            od

            buffer.append(")")

            return buffer.to_string()
        si

        // A single array element — the bare form, without the
        // `keyword(...)` wrapper that a scalar argument carries. An
        // element of an `object[]` is itself self-describing, so for
        // an `object`-typed element type each element is emitted in its
        // value-typed form (`int32(5)`, `string('x')`, …) rather than
        // bare — that is what `format_typed_value` produces.
        format_array_element(element_type: Type?, value: IR.Values.Value) -> string? is
            if element_type? /\ element_type.matches(_innate_symbol_lookup.get_object_type()) then
                return format_typed_value(value)
            fi

            if let string_value: IR.Values.Literal.STRING = value then
                return quote(string_value.value)
            fi

            let number_text = try_get_number_text(value)

            if number_text? then
                if serialization_keyword(element_type) =~ "bool" then
                    return number_text_to_bool(number_text)
                fi

                return number_text
            fi

            return null
        si

        // The ilasm typed self-describing form for a value, used as the
        // inner of an `object(...)` wrapper and as each element of an
        // `object[]` array. Keys off the value's own type rather than
        // any enclosing slot type, because that is exactly the
        // information that has to be re-asserted inline when the slot's
        // declared type is `System.Object`.
        format_typed_value(value: IR.Values.Value) -> string? is
            if isa IR.Values.NULL(value) then
                // No top-level `nullref` form inside ilasm's `object(...)`;
                // a null reference is encoded as a null string (the form
                // C# emits for `[Foo((object)null)]`).
                return "string(nullref)"
            fi

            if let string_value: IR.Values.Literal.STRING = value then
                return "string({quote(string_value.value)})"
            fi

            let number_text = try_get_number_text(value)

            if number_text? then
                if value.type? then
                    let primitive = try_primitive_keyword(value.type)

                    if primitive? then
                        if primitive =~ "bool" then
                            return "bool({number_text_to_bool(number_text)})"
                        fi

                        return "{primitive}({number_text})"
                    fi

                    // An enum-typed value inside an `object` slot would
                    // require encoding the enum's type-name SerString
                    // into the blob, and ilasm's `{...}` grammar has no
                    // production for `enum` inside `object(...)` or as
                    // an object-array element — the whole `.custom`
                    // would have to be emitted as raw bytes. Reject for
                    // now; the caller surfaces "not a compile-time
                    // constant".
                fi

                return null
            fi

            if let typeof_value: IR.Values.TYPEOF = value then
                // A typeof argument can name any type; only a class/struct/
                // enum or an array of one serializes to a blob name, so a
                // typeof of anything else is rejected here rather than
                // reaching the encoder as a name it cannot serialize.
                if _typeof_arg_is_serializable(typeof_value.typeof_type) then
                    return "type"
                fi

                return null
            fi

            if let sequence: IR.Values.SEQUENCE = value then
                return format_array(sequence)
            fi

            return null
        si

        // The numeric text of a NUMBER literal, or of a unary minus
        // applied to one — `-5` parses as a `-` innate over `5`, not as a
        // negative literal — or null if `value` is not a numeric constant.
        try_get_number_text(value: IR.Values.Value) -> string? is
            if let number: IR.Values.Literal.NUMBER = value then
                return number.rendered
            fi

            if let innate_call: IR.Values.Call.INNATE = value then
                if
                    innate_call.function.name =~ "-" /\
                    innate_call.arguments.count == 1
                then
                    if let number: IR.Values.Literal.NUMBER = innate_call.arguments[0] then
                        return "-{number.rendered}"
                    fi
                fi
            fi

            return null
        si

        number_text_to_bool(number_text: string) -> string =>
            if number_text =~ "0" then "false" else "true" fi

        // The ilasm type token for a named-argument member, an array
        // member, or an array element — a primitive keyword, `string`,
        // `enum <name>`, or `<element>[]`; null if the type cannot be
        // encoded into a custom-attribute blob from a textual literal.
        named_argument_type_token(type: Type?) -> string? is
            if !type? then
                return null
            fi

            if type.matches(_innate_symbol_lookup.get_string_type()) then
                return "string"
            fi

            if type.matches(_innate_symbol_lookup.get_type_type()) then
                return "type"
            fi

            if type.matches(_innate_symbol_lookup.get_object_type()) then
                return "object"
            fi

            let primitive = try_primitive_keyword(type)

            if primitive? then
                return primitive
            fi

            if let array: Semantic.Types.ARRAY = type then
                let element_token = named_argument_type_token(array.arguments[0])

                if element_token? then
                    return "{element_token}[]"
                fi

                return null
            fi

            if type.symbol.symbol_kind == Semantic.Symbols.SymbolKind.ENUM then
                if let classy: Semantic.Symbols.Classy = type.symbol then
                    if classy.il_assembly_name? then
                        return "enum [{classy.il_assembly_name}]{classy.qualified_name}"
                    fi

                    return "enum {classy.qualified_name}"
                fi
            fi

            return null
        si

        // Whether a typeof argument's type can be serialized into an
        // attribute blob. The answer is the serializer's own - the same
        // one the encoder uses - so what is accepted here is exactly
        // what the blob can spell, and a typeof of anything else (a
        // pointer, a type parameter) is rejected as a diagnostic rather
        // than reaching the encoder.
        _typeof_arg_is_serializable(type: Type?) -> bool is
            if !type? then
                return false
            fi

            return Semantic.DotNet.REFLECTION_TYPE_NAME.try_serialize(type)?
        si

        // The serialization keyword for a primitive value type, or null
        // for anything that is not a primitive. The keyword itself
        // reaches only discarded text; what matters is the null/non-null
        // answer, which gates whether the attribute argument is accepted.
        // Classification is by type identity, matching the binary blob
        // encoder, not by rendering the type and string-matching.
        try_primitive_keyword(type: Type?) -> string? is
            if !type? then
                return null
            fi

            let t = type

            if t.matches(_innate_symbol_lookup.get_bool_type()) then return "bool"; fi
            if t.matches(_innate_symbol_lookup.get_char_type()) then return "char"; fi
            if t.matches(_innate_symbol_lookup.get_byte_type()) then return "int8"; fi
            if t.matches(_innate_symbol_lookup.get_ubyte_type()) then return "uint8"; fi
            if t.matches(_innate_symbol_lookup.get_short_type()) then return "int16"; fi
            if t.matches(_innate_symbol_lookup.get_ushort_type()) then return "uint16"; fi
            if t.matches(_innate_symbol_lookup.get_int_type()) then return "int32"; fi
            if t.matches(_innate_symbol_lookup.get_uint_type()) then return "uint32"; fi
            if t.matches(_innate_symbol_lookup.get_long_type()) then return "int64"; fi
            if t.matches(_innate_symbol_lookup.get_ulong_type()) then return "uint64"; fi
            if t.matches(_innate_symbol_lookup.get_single_type()) then return "float32"; fi
            if t.matches(_innate_symbol_lookup.get_double_type()) then return "float64"; fi

            return null
        si

        // The ilasm serialization keyword for a numeric or bool value:
        // the parameter type's primitive keyword, or `int32` for an enum,
        // whose fixed-argument form encodes the underlying value.
        serialization_keyword(parameter_type: Type?) -> string is
            let primitive = try_primitive_keyword(parameter_type)

            if primitive? then
                return primitive
            fi

            return "int32"
        si

        quote(value: string) -> string =>
            Semantic.DotNet.IL_ATTRIBUTE_ARGUMENTS.quote(value)
    si
si
