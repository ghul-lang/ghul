namespace Syntax.Process is
    use System.Exception

    use IO.Std

    use Logging
    use Source

    use IR.Values
    use IR.VALUE_CONVERTER
    use IR.VALUE_BOXER

    use Semantic.LEAST_UPPER_BOUND_MAP
    use Semantic.Types.Type

    use Syntax.Trees.Definitions.PRAGMA

    use Ghul.Pipes


    // Iterator setup for for loops and the pipe-fusion recognizer and stage builder.
    partial COMPILE_EXPRESSIONS is
        // Why the last _resolve_chain_fusion declined, for the
        // pipe-fusion study. Nothing the compiler decides reads it.
        _chain_resolve_reason: string?

        // The owner of the Ghul.Pipes free functions, taken from a
        // combinator fusion already knows, so a call to a Pipes function
        // fusion does not recognise can still be told from any other
        // global call. Null when the runtime is unavailable, or before
        // the first lookup.
        _pipes_owner: Semantic.Scope?
        _pipes_owner_known: bool

        _pipes_owner_symbol: Semantic.Scope? is
            if !_pipes_owner_known then
                for combinator in _innate_symbol_lookup.get_pipes_fusion_functions().keys do
                    _pipes_owner = combinator.owner

                    break
                od

                _pipes_owner_known = true
            fi

            return _pipes_owner
        si

        // Whether `function` is declared in Ghul.Pipes.
        _is_pipes_function(function: Semantic.Symbols.Function?) -> bool is
            let owner = _pipes_owner_symbol

            return function? /\ owner? /\ function.root_specialized_from.owner == owner
        si

        // The name of the Ghul.Pipes function `call` resolved to, or null
        // for any other call.
        _pipes_function_name(call: Trees.Expressions.CALL) -> string? is
            if !isa IR.Values.Call.GLOBAL(call.value) then
                return null
            fi

            let function = (cast IR.Values.Call.GLOBAL(call.value)).function

            if !_is_pipes_function(function) then
                return null
            fi

            return function.name
        si

        // Iterable inference: a still-placeholder iterated expression
        // records an ITERABLE_CONSTRAINT on its origin so the body-retry
        // loop can filter candidate types to those that actually
        // iterate. set_iterator_for will still emit "not iterable" on
        // this iteration - the speculate/roll-back wrapper drops the
        // error on retry once the placeholder resolves.
        record_iterable_constraint(expression: Trees.Expressions.Expression?) is
            if let
                ev = expression?.value,
                ev_type = ev.type /\
            isa Semantic.Types.INFERRED_VARIABLE_TYPE(ev_type)
            then
                let placeholder = cast Semantic.Types.INFERRED_VARIABLE_TYPE(ev_type)

                _logger.mark_consumed_any_if(Semantic.INFERENCE_TRACE.add_constraint("pipe_fusion.iterable", placeholder.origin, Semantic.ITERABLE_CONSTRAINT()))
            fi
        si

        set_iterator_for(carrier: Trees.IteratorCarrier, type: Type, recursing: bool) -> bool is
            let expression = carrier.iterated!

            expression.value!.check_is_consumable(_logger, expression.location)

            if type.is_error then
                return false
            fi

            let move_next = get_zero_argument_function(type, "move_next")

            if move_next? then
                let read_current mut = get_zero_argument_function(type, "$get_current")

                if !read_current? then
                    read_current = get_zero_argument_function(type, "$get_Current")
                fi

                if !read_current? then
                    _logger.error(expression.location, "incomplete iterator type (has move_next method but no current property)")
                    return false
                fi

                carrier.move_next = move_next
                carrier.read_current = read_current

                _declare_state_machine_iterator_field(carrier, type)

                return true
            elif !recursing then
                let read_iterator = get_zero_argument_function(type, "$get_iterator")

                if read_iterator? then
                    carrier.read_iterator = read_iterator

                    return set_iterator_for(carrier, read_iterator.return_type!, true)
                fi
            fi

            _logger.error(expression.location, "not iterable")

            return false
        si

        // Recognise a fusible Pipe[T] chain on the loop expression and,
        // if found, resolve the source's own iterator members (exactly
        // as a plain `for x in source` would) so the IL pass can drive
        // them directly, skipping the pipe objects entirely. Returns
        // null - fall back to the normal iterator loop - when the chain
        // isn't fusible or the source doesn't expose a complete iterator
        // surface.
        _recognize_pipe_fusion(`for: Trees.Statements.FOR) -> PIPE_FUSION? is
            // `@suppress("pipe-fusion")` disables fusion for a scope, so the
            // loop runs the ordinary pipe-object lowering - used where the
            // real Pipe implementations must be exercised (the Ghul.Pipes
            // unit tests) rather than the fused equivalent.
            if _logger.is_suppressed("pipe-fusion", `for.location) then
                return null
            fi

            let recognizer = PIPE_FUSION_RECOGNIZER(_innate_symbol_lookup.get_pipes_fusion_functions())
            let fusion = recognizer.recognize(`for)

            if !_resolve_chain_fusion(fusion) then
                _note_fusion_site(`for.location, "for", true, recognizer, false)

                return null
            fi

            _note_fusion_site(`for.location, "for", true, recognizer, true)

            return fusion
        si

        // Record for the pipe-fusion study what a consumption site
        // decided, with the reason the recogniser or the resolver gave.
        // Inert unless the study is enabled.
        //
        // A site that peeled no stage is recorded only when the peel
        // stopped at a Ghul.Pipes function - a combinator fusion has no
        // stage for, which is what teaching the fuser a new stage would
        // recover. Stopping anywhere else means the expression was never
        // a chain, which every ordinary `for` loop does.
        _note_fusion_site(
            location: Source.LOCATION,
            consumer: string,
            consumer_fusible: bool,
            recognizer: PIPE_FUSION_RECOGNIZER,
            fused: bool
        ) is
            if !PIPE_FUSION_STUDY.enabled then
                return
            fi

            let roles = recognizer.peeled_roles ?? ""

            if roles.length == 0 /\ !_is_pipes_function(recognizer.boundary_function) then
                return
            fi

            PIPE_FUSION_STUDY.note_site(
                location,
                consumer,
                consumer_fusible,
                roles,
                fused,
                if fused then
                    ""
                else
                    recognizer.decline_reason ?? _chain_resolve_reason ?? "unknown"
                fi)
        si

        // Record a call to a Ghul.Pipes function for the study, whether or
        // not fusion recognises it, so the sites fusion reaches can be read
        // as a fraction of the whole combinator surface.
        _note_pipes_call(call: Trees.Expressions.CALL) is
            if !PIPE_FUSION_STUDY.enabled then
                return
            fi

            if let name = _pipes_function_name(call) then
                PIPE_FUSION_STUDY.note_call(call.location, name)
            fi
        si

        // Record a Ghul.Pipes call that consumes a chain but that fusion
        // has no consumer for - `collect`, `join`, `sum` and the rest -
        // naming the chain it would have consumed. This is where teaching
        // the fuser a new consumer pays, so the shapes are worth counting
        // even though nothing here declined on their account.
        _note_unfusible_consumer(call: Trees.Expressions.CALL) is
            if !PIPE_FUSION_STUDY.enabled then
                return
            fi

            let name = _pipes_function_name(call)

            if !name? \/ call.arguments.expressions.count == 0 then
                return
            fi

            let fusion_functions = _innate_symbol_lookup.get_pipes_fusion_functions()
            let role: string mut

            if
                isa IR.Values.Call.GLOBAL(call.value) /\
                fusion_functions.try_get_value(
                    (cast IR.Values.Call.GLOBAL(call.value)).function.root_specialized_from, role ref) /\
                PIPE_CONSUMER_KIND.is_stage_role(role)
            then
                return
            fi

            let recognizer = PIPE_FUSION_RECOGNIZER(fusion_functions)

            let _ = recognizer.recognize_any(call.arguments.expressions[0])

            _chain_resolve_reason = "consumer-not-fusible"

            _note_fusion_site(call.location, name, false, recognizer, false)
        si

        // Finish a recognised chain plan: resolve the source's own iterator
        // members, and resolve each stage (index constructor, or inline a
        // literal lambda). Returns false when any of that fails, in which case the
        // chain must not be fused. Shared by the `for` and consumer paths.
        _resolve_chain_fusion(fusion: PIPE_FUSION?) -> bool =>
            _resolve_chain_fusion(fusion, true)

        // `inline_stages` false skips the inline re-walk of map/filter lambda
        // bodies - consumer fusion calls the stage delegates rather than
        // inlining them, and the re-walk can disturb a stage lambda whose
        // body nests a capturing closure.
        _resolve_chain_fusion(fusion: PIPE_FUSION?, inline_stages: bool) -> bool is
            _chain_resolve_reason = null

            if !fusion? then
                return false
            fi

            let source_value = fusion.source.value

            if !source_value? \/ !source_value.type? then
                _chain_resolve_reason = "source-not-compiled"

                return false
            fi

            if !_resolve_fusion_source_iterator(fusion, source_value.type, false) then
                _chain_resolve_reason = "source-iterator-unresolved"

                return false
            fi

            for stage in fusion.stages_outermost_first do
                if stage.is_countdown then
                    // take/skip carry an int count evaluated once into the
                    // running counter; nothing to inline or resolve, but the
                    // count must have compiled to a value.
                    let count_value = stage.argument!.value

                    if !count_value? \/ !count_value.type? then
                        _chain_resolve_reason = "count-not-compiled"

                        return false
                    fi
                elif stage.is_index then
                    // The INDEXED_VALUE the stage builds is the element
                    // type of the `index` call's own `Pipe[INDEXED_VALUE[E]]`
                    // return, so it is read off the call rather than
                    // rebuilt from the element type flowing into the stage.
                    if !_resolve_index_stage(stage) then
                        _chain_resolve_reason = "index-stage-unresolved"

                        return false
                    fi
                else
                    // A map/filter stage's function argument must have
                    // compiled to a function-typed value. One that failed
                    // to resolve - a bare overloaded group with no
                    // member the formal could pick - carries a group
                    // type with no call shape, and building consumer
                    // stages from it would index past an empty argument
                    // list. Decline fusion; the ordinary call path
                    // reports the argument's own error.
                    let stage_argument = stage.argument!.value


                    if
                        !stage_argument? \/
                        !stage_argument.type? \/
                        !stage_argument.type.is_function \/
                        stage_argument.type.arguments.count == 0
                    then
                        _chain_resolve_reason = "stage-argument-not-a-function"

                        return false
                    fi

                    if inline_stages then
                        _try_inline_stage(stage)
                    fi
                fi
            od

            return true
        si

        // Determine whether `call` is a terminal Pipe consumer: a
        // `Ghul.Pipes` free-function call, reached via |> thread-first
        // desugaring (`chain |> count()`) or written directly
        // (`count(chain)`), the two being indistinguishable by the time
        // this pass runs. It is identified by comparing the call's
        // resolved target against the fusible-combinator symbols, so
        // what fuses follows the function the call bound rather than
        // how it spells itself. Only a global call can be one: `Pipe[T]`
        // carries no combinator methods of its own, so a member call
        // never resolves to a combinator. Returns the consumer's role
        // and the chain expression feeding it, which is the call's
        // first argument.
        _consumer_call_shape(call: Trees.Expressions.CALL) -> (name: string, chain_before: Trees.Expressions.Expression)? is
            if !isa IR.Values.Call.GLOBAL(call.value) then
                return null
            fi

            let function = (cast IR.Values.Call.GLOBAL(call.value)).function
            let role: string mut

            if !_innate_symbol_lookup.get_pipes_fusion_functions().try_get_value(function.root_specialized_from, role ref) then
                return null
            fi

            if call.arguments.expressions.count == 0 then
                return null
            fi

            return (role, call.arguments.expressions[0])
        si

        // Recognise a terminal Pipe consumer (`chain |> count()`, or the
        // equivalent `count(chain)`) whose chain is fusible, and build the
        // FUSED_CONSUMER value the call lowers to.
        // Every stage fuses (a map/filter delegate is called rather than
        // inlined). A `memo` stage is elided - the consumer is the memo's
        // only reader, so the cache would never be consulted.
        _recognize_consumer_fusion(call: Trees.Expressions.CALL) -> IR.Values.FUSED_CONSUMER? is
            _note_pipes_call(call)

            if _logger.is_suppressed("pipe-fusion", call.location) then
                return null
            fi

            let shape = _consumer_call_shape(call)

            if !shape? then
                _note_unfusible_consumer(call)

                return null
            fi

            let name = shape.name
            let chain_before = shape.chain_before
            let arg_count = call.arguments.expressions.count - 1

            let recognized_kind = PIPE_CONSUMER_KIND.of(name, arg_count)

            if !recognized_kind? then
                _note_unfusible_consumer(call)

                return null
            fi

            let consumer_kind = recognized_kind

            if !call.value? \/ !call.value.type? then
                return null
            fi

            let recognizer = PIPE_FUSION_RECOGNIZER(_innate_symbol_lookup.get_pipes_fusion_functions())
            let fusion = recognizer.recognize_any(chain_before)

            if !_resolve_chain_fusion(fusion, false) then
                _note_fusion_site(call.location, _pipes_function_name(call) ?? consumer_kind, true, recognizer, false)

                return null
            fi

            let plan = fusion!

            let id = _next_fused_local_id()

            let iterator_il_name = ".fc_iter.{id}"
            let element_il_name = ".fc_element.{id}"

            let source_read_iterator = plan.source_read_iterator

            let iterator_type =
                if source_read_iterator? then
                    source_read_iterator.return_type!
                else
                    plan.source.value!.type!
                fi

            let iterator_init =
                if source_read_iterator? then
                    source_read_iterator.call(plan.source.location, plan.source.value!, Collections.LIST[IR.Values.Value](0), null, _function_caller)
                else
                    plan.source.value!
                fi

            let iterator_load = cast IR.Values.Value(IR.Values.Load.TEMP(iterator_il_name, iterator_type))

            let move_next = plan.source_move_next!.call(plan.source.location, iterator_load, Collections.LIST[IR.Values.Value](0), null, _function_caller)
            let read_current = plan.source_read_current!.call(plan.source.location, iterator_load, Collections.LIST[IR.Values.Value](0), null, _function_caller)

            let element_type = plan.source_read_current!.return_type!

            let built = _build_consumer_stages(plan, element_il_name, element_type)

            let result_il_name = ".fc_result.{id}"

            let fused = IR.Values.FUSED_CONSUMER(
                call.value!.type!,
                iterator_init,
                source_read_iterator?,
                iterator_il_name,
                iterator_type,
                move_next,
                read_current,
                element_il_name,
                element_type,
                built.ops,
                built.final_il_name,
                built.final_type,
                consumer_kind,
                result_il_name
            )

            if let plan.pipe_reset, pipe_type = plan.pipe_type then
                let pipe_il_name = ".fc_pipe.{id}"

                fused.pipe_il_name = pipe_il_name
                fused.pipe_type = pipe_type
                fused.pipe_cast = IR.Values.CAST(pipe_type, iterator_load, false)
                fused.pipe_reset =
                    pipe_reset.call(
                        plan.source.location,
                        IR.Values.Load.TEMP(pipe_il_name, pipe_type),
                        Collections.LIST[IR.Values.Value](0),
                        null,
                        _function_caller)
            fi

            let final_element_load = cast IR.Values.Value(IR.Values.Load.TEMP(built.final_il_name, built.final_type))

            if PIPE_CONSUMER_KIND.takes_function(consumer_kind) then
                // Hoist the predicate / action delegate and apply it to the
                // surviving element per iteration. A function argument that
                // failed to resolve has no call shape to apply - decline
                // fusion and let the ordinary call path report it.
                let function = call.arguments.expressions[1].value

                if !function? \/ !function.type? \/ !function.type.is_function then
                    return _decline_consumer(call, recognizer, consumer_kind)
                fi

                let func_type = function.type

                let arg_il_name = ".fc_arg.{id}"

                let result_type =
                    if func_type.is_action then
                        _innate_symbol_lookup.get_void_type()
                    else
                        func_type.arguments[func_type.arguments.count - 1]
                    fi

                let call_arguments = Collections.LIST[IR.Values.Value]()
                call_arguments.add(final_element_load)

                fused.consumer_arg_il_name = arg_il_name
                fused.consumer_arg_type = func_type
                fused.consumer_arg_init = function
                fused.consumer_apply = IR.Values.Call.CLOSURE(
                    IR.Values.Load.TEMP(arg_il_name, func_type), result_type, func_type.is_action, func_type, call_arguments)
            elif consumer_kind =~ "reduce" then
                // running = accumulator(running, element).
                let seed = call.arguments.expressions[1].value!
                let accumulator = call.arguments.expressions[2].value!
                let func_type = accumulator.type!

                let arg_il_name = ".fc_arg.{id}"
                let running_type = call.value!.type!

                let call_arguments = Collections.LIST[IR.Values.Value]()
                call_arguments.add(cast IR.Values.Value(IR.Values.Load.TEMP(result_il_name, running_type)))
                call_arguments.add(final_element_load)

                fused.seed_init = seed
                fused.consumer_arg_il_name = arg_il_name
                fused.consumer_arg_type = func_type
                fused.consumer_arg_init = accumulator
                fused.consumer_apply = IR.Values.Call.CLOSURE(
                    IR.Values.Load.TEMP(arg_il_name, func_type), running_type, false, func_type, call_arguments)
            fi

            // find / first return a MAYBE: seed with the empty MAYBE, and
            // wrap the surviving element with MAYBE(element).
            if consumer_kind =~ "find" \/ consumer_kind =~ "first" then
                let maybe_type = call.value!.type!

                let empty_ctor = _resolve_ctor_by_arity(maybe_type, 0)
                let wrap_ctor = _resolve_ctor_by_arity(maybe_type, 1)

                if !empty_ctor? \/ !wrap_ctor? then
                    return _decline_consumer(call, recognizer, consumer_kind)
                fi

                fused.seed_init = IR.Values.NEW(maybe_type, empty_ctor, Collections.LIST[IR.Values.Value](0))

                let wrap_args = Collections.LIST[IR.Values.Value]()
                wrap_args.add(final_element_load)

                fused.wrap_element = IR.Values.NEW(maybe_type, wrap_ctor, wrap_args)
            fi

            // collect_mutable returns a fresh LIST[element]; seed it empty and
            // add the surviving element each iteration.
            if consumer_kind =~ "collect" then
                let list_type = call.value!.type!

                let ctor = _resolve_ctor_by_arity(list_type, 0)
                let add_fn = _resolve_member_by_arity(list_type, "add", 1)

                if !ctor? \/ !add_fn? then
                    return _decline_consumer(call, recognizer, consumer_kind)
                fi

                fused.seed_init = IR.Values.NEW(list_type, ctor, Collections.LIST[IR.Values.Value](0))

                let add_args = Collections.LIST[IR.Values.Value]()
                add_args.add(final_element_load)

                fused.add_element = add_fn.call(
                    call.location, IR.Values.Load.TEMP(result_il_name, list_type), add_args, null, _function_caller)
            fi

            if consumer_kind =~ "collect_array" then
                // `collect` is `collect_mutable(source).to_array()`: fill a
                // LIST over the chain's element type exactly as the fused
                // collect_mutable does, then hand back its array. The
                // call's own type is the array; the list is built here.
                let unspecialized_list = _innate_symbol_lookup.get_unspecialized_mutable_list_type()

                if !isa Semantic.Types.NAMED(unspecialized_list) then
                    return _decline_consumer(call, recognizer, consumer_kind)
                fi

                // The open generic's symbol is the GENERIC specialization
                // over its own parameters; the type to specialize is the
                // Classy it stands for.
                let list_symbol mut = (cast Semantic.Types.NAMED(unspecialized_list)).symbol

                if isa Semantic.Symbols.GENERIC(list_symbol) then
                    list_symbol = (cast Semantic.Symbols.GENERIC(list_symbol)).symbol
                fi

                if !isa Semantic.Symbols.Classy(list_symbol) then
                    return _decline_consumer(call, recognizer, consumer_kind)
                fi

                let list_arguments = Collections.LIST[Type]()
                list_arguments.add(built.final_type)

                let list_type =
                    cast Type(
                        Semantic.Types.GENERIC(
                            call.location,
                            cast Semantic.Symbols.Classy(list_symbol),
                            list_arguments))

                let ctor = _resolve_ctor_by_arity(list_type, 0)
                let add_fn = _resolve_member_by_arity(list_type, "add", 1)
                let to_array = _resolve_member_by_arity(list_type, "to_array", 0)

                if !ctor? \/ !add_fn? \/ !to_array? then
                    return _decline_consumer(call, recognizer, consumer_kind)
                fi

                fused.result_local_type = list_type

                fused.seed_init = IR.Values.NEW(list_type, ctor, Collections.LIST[IR.Values.Value](0))

                let add_args = Collections.LIST[IR.Values.Value]()
                add_args.add(final_element_load)

                fused.add_element = add_fn.call(
                    call.location, IR.Values.Load.TEMP(result_il_name, list_type), add_args, null, _function_caller)

                fused.finish = to_array.call(
                    call.location,
                    IR.Values.Load.TEMP(result_il_name, list_type),
                    Collections.LIST[IR.Values.Value](0),
                    null,
                    _function_caller)
            fi

            if consumer_kind =~ "collect" \/ consumer_kind =~ "collect_array" then
                _try_presize(fused, plan, call, consumer_kind, built.final_type)
            fi

            _note_fusion_site(call.location, _pipes_function_name(call) ?? consumer_kind, true, recognizer, true)

            return fused
        si

        // Size a fused collect's result up front where the source's count
        // is known before the loop and every stage keeps it. The source is
        // then read twice - for its iterator and for its count - so it is
        // evaluated once into a local and the iterator rebuilt over that.
        // A list result is constructed at the count as its capacity; an
        // array result is allocated at the count and written by index,
        // with no list and no copy. Nothing changes where the count is not
        // known or a stage can drop or add elements.
        _try_presize(
            fused: IR.Values.FUSED_CONSUMER,
            plan: PIPE_FUSION,
            call: Trees.Expressions.CALL,
            consumer_kind: string,
            element_type: Type
        ) is
            if !_stages_keep_count(plan) then
                return
            fi

            let source_value = plan.source.value!
            let source_type = source_value.type!

            let source_il_name = ".fc_source.{_next_fused_local_id()}"
            let source_load = cast IR.Values.Value(IR.Values.Load.TEMP(source_il_name, source_type))

            let count = known_counts.count_of(plan.source, source_load, source_type, call.location)

            if !count? then
                return
            fi

            fused.source_il_name = source_il_name
            fused.source_type = source_type
            fused.source_init = source_value

            fused.iterator_init =
                if let read_iterator = plan.source_read_iterator then
                    read_iterator.call(plan.source.location, source_load, Collections.LIST[IR.Values.Value](0), null, _function_caller)
                else
                    source_load
                fi

            if consumer_kind =~ "collect_array" then
                fused.presize_array = true
                fused.presize_count = count
                fused.presize_index_il_name = ".fc_fill.{_next_fused_local_id()}"
                fused.presize_element_type = element_type
                fused.result_local_type = null
                fused.seed_init = null
                fused.add_element = null
                fused.finish = null
            else
                let list_type = fused.result_local_type ?? call.value!.type!
                let ctor = _resolve_ctor_taking_int(list_type)

                if !ctor? then
                    return
                fi

                let capacity = Collections.LIST[IR.Values.Value]()
                capacity.add(count)

                fused.seed_init = IR.Values.NEW(list_type, ctor, capacity)
            fi
        si

        // Whether every stage passes each element through: map and index
        // do, filter, take and skip do not.
        _stages_keep_count(plan: PIPE_FUSION) -> bool is
            for stage in plan.stages_outermost_first do
                if stage.is_filter \/ stage.is_countdown then
                    return false
                fi
            od

            return true
        si

        // How many elements a source will produce, where that is known
        // before the loop starts.
        known_counts: KNOWN_COUNT_SOURCE =>
            KNOWN_COUNT_SOURCE(
                _innate_symbol_lookup,
                _function_caller,
                (type, name) => get_zero_argument_function(type, name),
                call => _pipes_function_name(call)
            )

        // The constructor of `type` taking one int - a list's capacity.
        _resolve_ctor_taking_int(type: Type) -> Semantic.Symbols.Function? is
            let member = type.find_member("init")

            if !member? \/ !isa Semantic.Symbols.FUNCTION_GROUP(member) then
                return null
            fi

            let int_type = _innate_symbol_lookup.get_int_type()

            for f in (cast Semantic.Symbols.FUNCTION_GROUP(member)).functions do
                if f.arguments.count != 1 then
                    continue
                fi

                if let parameter_type = f.arguments[0].type then
                    if int_type.is_assignable_from(parameter_type) /\ parameter_type.is_assignable_from(int_type) then
                        return f
                    fi
                fi
            od

            return null
        si

        // Decline a consumer whose chain resolved but whose own shape did
        // not - an unresolved function argument, list constructor or
        // member - recording the site as declined for the study.
        _decline_consumer(call: Trees.Expressions.CALL, recognizer: PIPE_FUSION_RECOGNIZER, consumer_kind: string) -> IR.Values.FUSED_CONSUMER? is
            _chain_resolve_reason = "consumer-unresolved"

            _note_fusion_site(call.location, _pipes_function_name(call) ?? consumer_kind, true, recognizer, false)

            return null
        si

        // A member of `type` named `name` taking `arity` arguments (or null).
        _resolve_member_by_arity(type: Type, name: string, arity: int) -> Semantic.Symbols.Function? is
            let member = type.find_member(name)

            if !member? \/ !isa Semantic.Symbols.FUNCTION_GROUP(member) then
                return null
            fi

            let group = cast Semantic.Symbols.FUNCTION_GROUP(member)

            for f in group.functions do
                if f.argument_names.count == arity then
                    return f
                fi
            od

            return null
        si

        // The constructor of `type` taking `arity` arguments (or null).
        _resolve_ctor_by_arity(type: Type, arity: int) -> Semantic.Symbols.Function? =>
            _resolve_member_by_arity(type, "init", arity)

        // Pre-build the per-stage application for a consumer loop, threading
        // the element through freshly-named locals (a map produces a new
        // typed local the next stage reads). Every stage is an inlinable
        // lambda: assign the current element to the lambda's parameter local,
        // then the harvested inline body is the applied value.
        _build_consumer_stages(fusion: PIPE_FUSION, start_il_name: string, start_type: Type) -> (ops: Collections.LIST[IR.Values.FUSED_CONSUMER_STAGE], final_il_name: string, final_type: Type) is
            let ops = Collections.LIST[IR.Values.FUSED_CONSUMER_STAGE]()

            let current_il_name mut = start_il_name
            let current_type mut = start_type

            let index mut = fusion.stages_outermost_first.count - 1

            while index >= 0 do
                let stage = fusion.stages_outermost_first[index]

                if stage.is_countdown then
                    // take/skip: a running counter, no delegate and no
                    // output local - the element passes through unchanged.
                    let counter_il_name = ".fc_countdown.{_next_fused_local_id()}"

                    ops.add(IR.Values.FUSED_CONSUMER_STAGE(stage.is_take, stage.is_skip, counter_il_name, stage.argument!.value!))

                    index = index - 1

                    continue
                fi

                if stage.is_index then
                    // A running counter and an INDEXED_VALUE built per
                    // element from it, in place of an INDEX_PIPE. The
                    // counter is seeded with the caller's start where one
                    // was given, and with zero otherwise.
                    let int_type = _innate_symbol_lookup.get_int_type()
                    let counter_il_name = ".fc_index.{_next_fused_local_id()}"
                    let output_il_name = ".fc_indexed.{_next_fused_local_id()}"
                    let indexed_type = stage.indexed_value_type!

                    let start =
                        if let start_expression = stage.argument then
                            start_expression.value!
                        else
                            cast IR.Values.Value(IR.Values.Literal.NUMBER(0, int_type))
                        fi

                    let build_arguments = Collections.LIST[IR.Values.Value]()
                    build_arguments.add(
                        cast IR.Values.Value(IR.Values.POST_INCREMENT(counter_il_name, int_type)))
                    build_arguments.add(
                        cast IR.Values.Value(IR.Values.Load.TEMP(current_il_name, current_type)))

                    ops.add(
                        IR.Values.FUSED_CONSUMER_STAGE(
                            counter_il_name,
                            start,
                            output_il_name,
                            indexed_type,
                            IR.Values.NEW(indexed_type, stage.indexed_value_constructor!, build_arguments)))

                    current_il_name = output_il_name
                    current_type = indexed_type

                    index = index - 1

                    continue
                fi

                let delegate = stage.argument!.value!
                let func_type = delegate.type!

                let delegate_il_name = ".fc_stage.{_next_fused_local_id()}"

                let result_type =
                    if func_type.is_action then
                        _innate_symbol_lookup.get_void_type()
                    else
                        func_type.arguments[func_type.arguments.count - 1]
                    fi

                let call_arguments = Collections.LIST[IR.Values.Value]()
                call_arguments.add(cast IR.Values.Value(IR.Values.Load.TEMP(current_il_name, current_type)))

                let apply = cast IR.Values.Value(IR.Values.Call.CLOSURE(
                    IR.Values.Load.TEMP(delegate_il_name, func_type), result_type, func_type.is_action, func_type, call_arguments))

                if stage.is_filter then
                    ops.add(IR.Values.FUSED_CONSUMER_STAGE(true, delegate_il_name, func_type, delegate, apply, "", null))
                else
                    ops.add(IR.Values.FUSED_CONSUMER_STAGE(false, delegate_il_name, func_type, delegate, apply, ".fc_map.{_next_fused_local_id()}", result_type))

                    current_il_name = ops[ops.count - 1].output_il_name
                    current_type = result_type
                fi

                index = index - 1
            od

            return (ops, current_il_name, current_type)
        si

        // Fill an index stage's INDEXED_VALUE type and constructor, and
        // check the start it was given compiled. False declines the whole
        // chain, which then runs through its own INDEX_PIPE unchanged.
        _resolve_index_stage(stage: PIPE_FUSION_STAGE) -> bool is
            if let start = stage.argument then
                let start_value = start.value

                if !start_value? \/ !start_value.type? then
                    return false
                fi
            fi

            let pipe = _innate_symbol_lookup.get_unspecialized_pipe_type()

            if !pipe? \/ !stage.chain_type? then
                return false
            fi

            stage.indexed_value_type =
                Semantic.Symbols.TYPE_ARGUMENT_EXTRACTOR.extract(stage.chain_type, pipe)

            if !stage.indexed_value_type? then
                return false
            fi

            stage.indexed_value_constructor = _resolve_index_constructor(stage.indexed_value_type)

            return stage.is_index_ready
        si

        // The single INDEXED_VALUE[element] constructor `init(int, element)`,
        // specialized to the stage's element type, that the fused index stage
        // calls per element in place of building an INDEX_PIPE.
        _resolve_index_constructor(indexed_value_type: Type) -> Semantic.Symbols.Function? is
            let init_symbol = indexed_value_type.find_member("init")

            if !init_symbol? \/ !isa Semantic.Symbols.FUNCTION_GROUP(init_symbol) then
                return null
            fi

            let group = cast Semantic.Symbols.FUNCTION_GROUP(init_symbol)

            if group.count != 1 then
                return null
            fi

            return group.functions[0]
        si

        _fused_local_id_counter: int static

        _next_fused_local_id() -> int static is
            let result = _fused_local_id_counter
            _fused_local_id_counter = _fused_local_id_counter + 1
            return result
        si

        // Attempt to inline a stage's `map`/`filter` lambda so the fused
        // loop runs its body directly, with no delegate or closure
        // frame. Only literal, single-parameter, expression-bodied
        // lambdas qualify; anything else keeps the delegate path
        // (`stage` left unmodified).
        //
        // Mechanism: declare a synthetic local, owned by the enclosing
        // method, for the parameter, then re-walk the body with that
        // local bound. Because the current function is the enclosing
        // method (not the closure), the parameter and any captured outer
        // locals resolve as ordinary local loads. The re-walk's
        // diagnostics and symbol-use records are discarded (the first,
        // normal walk already recorded them). The body's nodes keep the
        // loop-context IR, and generate-il walks the body where the loop
        // wants it, so the closure's own method is never emitted. Only a
        // decline after that walk restores the nodes, by walking the whole
        // lambda again.
        _try_inline_stage(stage: PIPE_FUSION_STAGE) is
            // A body whose statements become a state machine keeps its
            // loops as pipe objects, so the stage's delegate is still
            // built and called. Inlining marks the literal to load its
            // names as the enclosing body's locals, which in a state
            // machine they are not, so the delegate's own method would be
            // emitted reading locals that do not exist there.
            let enclosing = _symbol_table.current_function

            if
                Semantic.Symbols.state_machine_for(enclosing)? \/
                Semantic.Symbols.async_state_machine_for(enclosing)?
            then
                return
            fi

            if !isa Trees.Expressions.FUNCTION(stage.argument) then
                return
            fi

            let function = cast Trees.Expressions.FUNCTION(stage.argument)

            if
                function.is_recursive \/
                function.contains_let_await \/
                function.arguments.expressions.count != 1 \/
                !isa Trees.Bodies.EXPRESSION(function.body)
            then
                return
            fi

            let param = function.arguments.expressions[0]

            if !isa Trees.Expressions.VARIABLE(param) then
                return
            fi

            let variable = cast Trees.Expressions.VARIABLE(param)

            // The harvest below declares one enclosing-method local, for
            // the formal's own name. A destructure pattern's leaves are
            // separate symbols owned by the closure, and nothing here
            // rebinds them, so the body would read them against the
            // enclosing method. Inlining one needs a local per leaf and
            // an unpack in the fused loop; until then the stage keeps
            // the delegate.
            if variable.is_destructuring then
                return
            fi

            let param_name = variable.name.name

            let closure = cast Semantic.Symbols.Closure?(_symbol_table.scope_for(function))

            if !closure? then
                return
            fi

            let param_symbol = closure.find_direct(param_name)

            if !param_symbol? \/ !isa Semantic.Types.Typed(param_symbol) then
                return
            fi

            let param_type = (cast Semantic.Types.Typed(param_symbol)).type

            if !param_type? \/ param_type.is_sentinel \/ param_type.is_error then
                return
            fi

            let body = cast Trees.Bodies.EXPRESSION?(function.body)

            if !body? then
                return
            fi

            // The parameter local the fused loop stores each element into.
            // It is declared in a scope of its own so its name cannot
            // collide with anything the method already has - nothing ever
            // looks it up by name, since the loader translates the
            // literal's parameter symbol to it directly.
            //
            // The body is walked again on every body retry, and the local
            // has to be the same one each time. A nested literal captures
            // it, and a capture is keyed on the symbol, so a second local
            // would leave that capture naming a slot the retained walk
            // never declares.
            let local: Semantic.Symbols.Symbol mut

            if let inlined = closure.inlined_into then
                local = inlined.local
            else
                let scope = Semantic.BLOCK_SCOPE(_symbol_table.current_scope)

                // The local-id generator is only in a function frame during
                // the declare pass; push one so the LOCAL_VARIABLE ctor can
                // mint an id, then give the local a globally-unique IL slot
                // name so it can't collide with an enclosing local.
                let local_id_generator = IoC.CONTAINER.instance.local_id_generator

                local_id_generator.enter_function()

                let declared = scope.declare_variable(function.location, param_name, false, null)

                local_id_generator.leave_function()

                if !isa Semantic.Symbols.Variable(declared) \/ !isa Semantic.Types.SettableTyped(declared) then
                    return
                fi

                declared.il_name_override = ".fused_param.{_next_fused_local_id()}"

                (cast Semantic.Symbols.Variable(declared)).define()
                (cast Semantic.Types.SettableTyped(declared)).set_type(param_type)

                local = declared
            fi

            // Compile the body inline: the literal keeps its own scope, so
            // every name in it resolves exactly as it does when the literal
            // is compiled as a closure, at every nesting depth. The marker
            // is what makes those names load as the method's locals.
            closure.inlined_into = (_symbol_table.current_function!, param_symbol, cast Semantic.Symbols.Variable(local))

            _reset_nested_captures(body)

            let harvest_site = RETRY_SITE_STATS.enter("fusion.harvest", RetrySiteKind.ALTERNATIVE)

            _symbol_table.enter_scope(closure)

            _logger.speculate()
            _symbol_use_locations.speculate()

            body.expression.walk(self)

            let harvested = body.expression.value

            _logger.roll_back()
            _symbol_use_locations.roll_back()

            _symbol_table.leave_scope(closure)

            harvest_site.dispose()

            // The one late decline. The body compiled to nothing, or to an
            // error, in loop context. Nothing after the walk may decline
            // without putting the closure back as it was, since the nodes
            // now hold loop-context IR and the closure is still the only
            // thing that could be called instead.
            if !harvested? \/ !harvested.type? \/ harvested.type.is_error then
                closure.inlined_into = null

                if System.Environment.get_environment_variable("GHUL_FUSION_LATE_DECLINE")? then
                    IO.Std.error.write_line(
                        "fusion: late decline restoring {function.location}")
                fi

                let restore_site = RETRY_SITE_STATS.enter("fusion.restore", RetrySiteKind.ALTERNATIVE)

                _reset_nested_captures(body)

                _logger.speculate()
                _symbol_use_locations.speculate()

                function.walk(self)

                _logger.roll_back()
                _symbol_use_locations.roll_back()

                restore_site.dispose()

                return
            fi

            // The body's IL is emitted into this block by generate-il's
            // visit of the literal, and the fused loop emits the block
            // where it wants the body. The nodes in the body still carry
            // their own placeholders, which that visit fills in place.
            let block = IR.Values.BLOCK(harvested.type!)

            closure.inlined_block = block
            closure.inlined_body_node = body.expression

            stage.inlined_closure = closure

            stage.param_local = cast Semantic.Symbols.Variable(local)
            stage.inline_body = block
        si

        // Drop what the literals in a stage body captured, so the walk that
        // follows records what the body reads under the rule now in force.
        // A capture is keyed on the symbol while the frame field it declares
        // is keyed on the name, so a walk that resolves the same name to a
        // different symbol than the last one adds a second value under a
        // name the frame already has one field for, and the frame's
        // constructor is then called with one argument too many. Neither
        // walk's captures are part of what the logger rolls back, so each
        // walk over the body is preceded by this.
        _reset_nested_captures(body: Trees.Bodies.EXPRESSION) is
            for nested in NESTED_LITERAL_COLLECTOR().collect(body) do
                if let nested_closure = cast Semantic.Symbols.Closure?(_symbol_table.scope_for(nested)) then
                    nested_closure.reset_captures()
                fi
            od
        si

        // Fill the fusion plan's iterator slots for `type`, mirroring
        // set_iterator_for: bind move_next / read_current directly when
        // `type` is itself an iterator, else follow $get_iterator once
        // and recurse. Returns false if no complete iterator surface is
        // found (fall back to the normal loop).
        _resolve_fusion_source_iterator(fusion: PIPE_FUSION, type: Type, recursing: bool) -> bool is
            let move_next = get_zero_argument_function(type, "move_next")

            if move_next? then
                let read_current mut = get_zero_argument_function(type, "$get_current")

                if !read_current? then
                    read_current = get_zero_argument_function(type, "$get_Current")
                fi

                if !read_current? then
                    return false
                fi

                fusion.source_move_next = move_next
                fusion.source_read_current = read_current

                _resolve_fusion_pipe_rewind(fusion, type, read_current)

                return true
            elif !recursing then
                let read_iterator = get_zero_argument_function(type, "$get_iterator")

                if read_iterator? then
                    fusion.source_read_iterator = read_iterator

                    return _resolve_fusion_source_iterator(fusion, read_iterator.return_type!, true)
                fi
            fi

            return false
        si

        // Resolve the rewind a spent take owes the cursor `cursor_type`,
        // as `Pipe[E].reset` over the element type the cursor yields. The
        // loop tests the cursor for `Pipe[E]` before calling it, so a
        // cursor that is one is reset wherever it came from and a cursor
        // that is not is left alone - which is what rewinding a stage's
        // own cursor does. A value-type cursor is the loop's own copy and
        // is nobody else's to restore, so it gets none.
        _resolve_fusion_pipe_rewind(
            fusion: PIPE_FUSION,
            cursor_type: Type,
            read_current: Semantic.Symbols.Function
        ) is
            if cursor_type.is_value_type then
                return
            fi

            let unspecialized = _innate_symbol_lookup.get_unspecialized_pipe_type()

            if !unspecialized? then
                return
            fi

            let element_type = read_current.return_type

            if !element_type? then
                return
            fi

            let classy = cast Semantic.Symbols.Classy?(unspecialized.symbol.unspecialized_symbol)

            if !classy? then
                return
            fi

            let arguments = Collections.LIST[Type]()
            arguments.add(element_type)

            let pipe_type = cast Type(
                Semantic.Types.GENERIC(Source.LOCATION.internal, classy, arguments))

            let reset = get_zero_argument_function(pipe_type, "reset")

            if !reset? then
                return
            fi

            fusion.pipe_type = pipe_type
            fusion.pipe_reset = reset
        si
    si
si
