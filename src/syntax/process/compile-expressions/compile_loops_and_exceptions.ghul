namespace Syntax.Process is
    use Logging

    use Semantic.LEAST_UPPER_BOUND_MAP

    // Compiles `while` / `do` loops and `try` / `catch` statements,
    // and the flow-sensitive narrowing around them. Split out of
    // COMPILE_EXPRESSIONS, which delegates the matching pre / visit
    // methods here. The `super.pre` / `super.visit` base-visitor
    // calls stay in the visitor's thin stubs; the methods here are
    // the enclosed logic.
    //
    // A loop drops narrows on variables its body writes (they cannot
    // survive the back-edge) — see loop_kept_env, which the `for`
    // loop on the visitor also uses. A `try` opens a TRY_FLOW_FRAME
    // tracking whether the body / handlers can complete normally;
    // narrowing established inside a try is discarded conservatively
    // (an exception can leave the body anywhere).
    class COMPILE_LOOPS_AND_EXCEPTIONS is
        _logger: Logger
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        _flow: NARROWING_FLOW
        _condition_analyzer: CONDITION_ANALYZER
        _conditionals: COMPILE_CONDITIONALS
        _visitor: COMPILE_EXPRESSIONS
        _try_flow_stack: Collections.LIST[TRY_FLOW_FRAME]
        _loop_kept_stack: Collections.LIST[NARROW_ENV]

        // Heap epoch captured at each pre_do, compared at visit_do:
        // the kept environment was snapshot before the loop's
        // condition and body walked, so a kill during either means
        // its heap facts cannot be restored after the loop.
        _loop_epoch_stack: Collections.LIST[int]
        _loop_mark_stack: Collections.LIST[int]

        // Settles loop-expression result types from break contributions
        // (see LOOP_RESULT_SETTLER). The makers are wired to the
        // reflected-runtime lookups here so unit fixtures can inject
        // stand-ins.
        _settler: LOOP_RESULT_SETTLER

        init(
            logger: Logger,
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup,
            flow: NARROWING_FLOW,
            condition_analyzer: CONDITION_ANALYZER,
            conditionals: COMPILE_CONDITIONALS,
            visitor: COMPILE_EXPRESSIONS,
            try_flow_stack: Collections.LIST[TRY_FLOW_FRAME],
            loop_kept_stack: Collections.LIST[NARROW_ENV]
        ) is
            super.init()

            _logger = logger
            _innate_symbol_lookup = innate_symbol_lookup
            _flow = flow
            _condition_analyzer = condition_analyzer
            _conditionals = conditionals
            _visitor = visitor
            _try_flow_stack = try_flow_stack
            _loop_kept_stack = loop_kept_stack
            _loop_epoch_stack = Collections.LIST[int]()
            _loop_mark_stack = Collections.LIST[int]()
            _settler = LOOP_RESULT_SETTLER(
                (t: Semantic.Types.Type) => innate_symbol_lookup.get_optional_type(t),
                (t: Semantic.Types.Type) => innate_symbol_lookup.get_maybe_type(t),
                (t: Semantic.Types.Type) => t.as_optional()
            )
        si

        // The narrowing environment to use inside and after a loop
        // whose body is `body`. A loop body may run any number of
        // times, so a narrow on a variable the body *writes* cannot
        // be assumed across the back-edge — those narrows are
        // dropped. A narrow on a variable the body never writes is
        // loop-invariant and survives. The body is scanned
        // syntactically for assignment / `ref` targets.
        loop_kept_env(body: Trees.Node) -> NARROW_ENV is
            let env = _flow.current_env

            if env.is_bottom then
                return env.copy()
            fi

            let collector = LOOP_ASSIGNMENT_COLLECTOR()
            body.walk(collector)

            let kept = NARROW_ENV()

            for v in env.variables do
                if let v_name = v.name, t = env.narrowed_type_of(v) then
                    if !collector.names.contains(v_name) then
                        kept.set_narrow(v, t)
                        kept.copy_crossings_of(v, env)
                    fi
                fi
            od

            // Definite-assignment is not subject to the kill-set: a
            // variable assigned before the loop stays assigned
            // regardless of what the body writes. Body-only
            // assignments are dropped by restoring `kept` after the
            // loop (a loop may run zero times).
            for v in env.assigned_variables do
                kept.set_assigned(v)
            od

            for v in env.non_null_variables do
                if !collector.names.contains(v.name) then
                    kept.set_non_null(v)
                    kept.copy_crossings_of(v, env)
                fi
            od

            return kept
        si

        pre_try(`try: Trees.Statements.TRY) -> bool is
            // Record the pre-try environment. Its narrowing facts
            // are discarded after the try (an exception can leave
            // the body anywhere), but its definite-assignment facts
            // survive — those assignments already happened.
            let frame = TRY_FLOW_FRAME(_flow.current_env.copy())
            _try_flow_stack.add(frame)

            // Drive the walk so the finally body gets an entry
            // environment of its own. It runs on every path out of
            // the try — completing, returning, or throwing — so it
            // is never unreachable, and because an exception can
            // leave the body anywhere it enters with only the
            // pre-try definite-assignment facts, exactly as a catch
            // handler does.
            `try.body.walk(_visitor)
            _visitor.end_try_body(`try)

            if !frame.body_seen then
                frame.body_seen = true

                if !_flow.is_unreachable then
                    frame.can_complete = true
                fi
            fi

            for c in `try.catches do
                c.walk(_visitor)
            od

            if `try.`finally? then
                let finally_body = `try.`finally

                // The finally runs on every path out of the try, so a
                // fact proven before the try holds there too, unless
                // the body or a catch writes the local it was proven
                // on. The finally's own writes are not collected: they
                // invalidate from the write onward, which the ordinary
                // walk does, rather than at entry.
                let written = LOOP_ASSIGNMENT_COLLECTOR(true)

                `try.body.walk(written)

                for c in `try.catches do
                    c.walk(written)
                od

                // The body and catches have been compiled, so a plain
                // assignment names the symbol it stores to, and a local
                // of the same name declared inside the try is not
                // mistaken for the one the fact is about. A target with
                // no store to read falls back to its name, which can
                // only cost a narrow, never keep a stale one.
                _flow.set_env(
                    frame.entry.with_only_assigned_and_kept_locals(
                        v => v.name? /\ !written.wrote(v)))

                finally_body.walk(_visitor)

                if _flow.is_unreachable then
                    frame.finally_diverges = true
                fi
            fi

            return true
        si

        // The frame for the `try` currently being walked, or null.
        _try_flow_frame: TRY_FLOW_FRAME? =>
            if _try_flow_stack.count > 0 then
                _try_flow_stack[_try_flow_stack.count - 1]
            else
                null
            fi

        visit_try(`try: Trees.Statements.TRY) is
            let frame = _try_flow_frame

            if _try_flow_stack.count > 0 then
                _try_flow_stack.remove_at(_try_flow_stack.count - 1)
            fi

            if frame? then
                // Conservative: an exception can leave the try body
                // at any point, so no narrowing survives the try —
                // only the pre-try definite-assignment facts. When
                // neither the body nor any handler can complete
                // normally, or the finally cannot, control never
                // falls through the try.
                if frame.can_complete /\ !frame.finally_diverges then
                    _flow.set_env(frame.entry.with_only_assigned())
                else
                    _flow.set_unreachable()
                fi
            else
                _flow.set_env(NARROW_ENV())
            fi

            if
                `try.catches.count == 0 /\
                !`try.`finally?
            then
                _logger.warn(
                    `try.keyword_location,
                    "try-without-handler",
                    "try statement has no catch clause and no finally clause",
                    `try.keyword_location,
                    "help: add a catch clause, a finally clause, or both")
            fi
        si

        pre_catch(`catch: Trees.Statements.CATCH) -> bool is
            let frame = _try_flow_frame

            // The first catch is reached right after the try body,
            // so the current environment is the body's exit: record
            // whether the body can complete normally.
            if frame? /\ !frame.body_seen then
                frame.body_seen = true

                if !_flow.is_unreachable then
                    frame.can_complete = true
                fi
            fi

            // A throw can land anywhere in the try body, so nothing
            // narrowed there can be assumed in the handler — the
            // catch body is walked with only the pre-try
            // definite-assignment facts.
            _flow.set_env(
                if frame? then frame.entry.with_only_assigned() else NARROW_ENV() fi
            )

            return false
        si

        visit_catch(`catch: Trees.Statements.CATCH) is
            // A catch handler that completes normally is a path that
            // reaches the end of the try statement.
            let frame = _try_flow_frame

            if frame? /\ !_flow.is_unreachable then
                frame.can_complete = true
            fi

            if !`catch.variable? then
                return
            fi

            let variable = `catch.variable

            // Catch parameters must always have an explicit type —
            // their whole purpose is to identify which exception
            // shape the clause handles. Type inference (placeholder
            // + LUB across writes) does not apply here, so the
            // generalised let-without-type relaxation in
            // pre(VARIABLE) doesn't extend to catch.
            if isa Trees.TypeExpressions.INFER(variable.type_expression) then
                _logger.error(variable.location, "catch variable must have an explicit type")
                return
            fi

            let type = variable.type_expression.type

            if !type? then
                return
            fi

            let exception_type = _innate_symbol_lookup.get_exception_type()

            if !exception_type.is_assignable_from(type) then
                _logger.error(variable.type_expression.location, "cannot catch {type} because it does not derive from System.Exception")
            fi
        si

        pre_do(`do: Trees.Statements.DO) -> bool is
            // Controlled walk that mirrors `pre_if_branch`: compute
            // the loop's kill-set environment, walk the condition (or
            // `while let` binding) under it, derive the body's
            // narrowing environment from that, walk the body, and
            // stash the kept environment for visit(DO) to restore
            // after the loop. Per-iteration narrows established by the
            // condition or binding flow into the body; the kill-set
            // drops any narrow on a variable the loop writes so
            // back-edge invariance is preserved.
            let kept = loop_kept_env(`do)
            _loop_kept_stack.add(kept)
            _loop_epoch_stack.add(_flow.heap_epoch)
            _loop_mark_stack.add(_flow.crossing_mark)

            _flow.set_env(kept)

            if `do.binding? then
                _conditionals.check_refutable_binding(`do.binding)
            elif `do.condition? then
                let condition = `do.condition
                let epoch = _flow.heap_epoch
                let mark = _flow.crossing_mark

                condition.walk(_visitor)

                let facts = _condition_analyzer.analyze_condition(condition, kept)

                // The body environment derives from the pre-condition
                // snapshot; a store during the condition's own walk
                // invalidates its heap facts, and its calls attach as
                // crossings.
                if _flow.heap_killed_since(epoch) then
                    facts.then_env.drop_heap_facts()
                else
                    _flow.adopt_crossings_since(facts.then_env, mark)
                fi

                _flow.set_env(facts.then_env)
            fi

            `do.body.walk(_visitor)

            return true
        si

        visit_do(`do: Trees.Statements.DO) is
            if _loop_kept_stack.count > 0 then
                let kept = _loop_kept_stack[_loop_kept_stack.count - 1]
                _loop_kept_stack.remove_at(_loop_kept_stack.count - 1)

                let epoch = _loop_epoch_stack[_loop_epoch_stack.count - 1]
                _loop_epoch_stack.remove_at(_loop_epoch_stack.count - 1)

                let mark = _loop_mark_stack[_loop_mark_stack.count - 1]
                _loop_mark_stack.remove_at(_loop_mark_stack.count - 1)

                if !`do.condition? /\ !`do.binding? /\ !_loop_body_has_break(`do.body) then
                    // An unconditional loop with no `break` cannot
                    // be exited — control never falls through it.
                    _flow.set_unreachable()
                else
                    // The kept environment was snapshot before the
                    // loop walked; the assignment kill-set covers
                    // direct writes but not member stores inside the
                    // loop, so a store during the walk drops its heap
                    // facts before restoration, and the loop's calls
                    // attach as crossings.
                    if _flow.heap_killed_since(epoch) then
                        kept.drop_heap_facts()
                    else
                        _flow.adopt_crossings_since(kept, mark)
                    fi

                    _flow.set_env(kept)
                fi
            fi
        si

        // True iff `body` contains a `break` targeting the loop it
        // is the body of — a `break` inside a nested loop does not
        // count (it targets that inner loop).
        _loop_body_has_break(body: Trees.Statements.LIST) -> bool is
            let finder = LOOP_BREAK_FINDER()
            body.walk(finder)

            return finder.found
        si

        // --- loop-as-expression value machinery ---

        push_loop_value_frame(
            node: Trees.Statements.Statement,
            label_name: string?,
            wants_value: bool,
            expected_type: Semantic.Types.Type?,
            expected_type_error_message: string?
        ) is
            let frame = LOOP_VALUE_FRAME(node, label_name, wants_value, expected_type, expected_type_error_message)

            _visitor.loop_value_frames.add(frame)
        si

        // The innermost open loop frame that consumes a value — the
        // target of a valued `break`. Intermediate loops that are not
        // expressions are exited through: the value needs a taker, so
        // the search skips frames whose loop discards its result.
        // Null when no enclosing loop is an expression.
        innermost_consuming_frame() -> LOOP_VALUE_FRAME? is
            let frames = _visitor.loop_value_frames

            let i mut = frames.count - 1

            while i >= 0 do
                let frame = frames[i]

                if frame.wants_value then
                    return frame
                fi

                i = i - 1
            od

            return null
        si

        // The innermost open loop frame, for a `break` that names no
        // label. Null outside any loop.
        current_loop_frame() -> LOOP_VALUE_FRAME? is
            let frames = _visitor.loop_value_frames

            if frames.count == 0 then
                return null
            fi

            return frames[frames.count - 1]
        si

        // The open loop frame whose label is `name`, innermost first.
        // Null when no enclosing labelled loop carries that name.
        find_labelled_loop_frame(name: string) -> LOOP_VALUE_FRAME? is
            let frames = _visitor.loop_value_frames

            let i mut = frames.count - 1

            while i >= 0 do
                let frame = frames[i]

                if frame.label_name? /\ frame.label_name =~ name then
                    return frame
                fi

                i = i - 1
            od

            return null
        si

        // Pops the innermost frame (which must be `node`'s) and settles
        // the loop's expression value: the optional-wrapped LUB of every
        // valued-break contribution. With an expected type and no
        // contributions the loop yields absence everywhere, so the
        // expected type stands. With neither, the type cannot be
        // inferred.
        pop_and_settle_loop_value(node: Trees.Statements.Statement) is
            let frames = _visitor.loop_value_frames

            assert frames.count > 0 else "loop value frame underflow"

            let frame = frames[frames.count - 1]

            assert frame.node == node else "loop value frame head is not the loop being visited"

            frames.remove_at(frames.count - 1)

            // A valued break under a loop that consumes nothing was
            // already reported at the break itself; nothing to settle.
            if !frame.wants_value then
                return
            fi

            let result = _settler.settle(
                frame.contributions,
                frame.expected_type
            )

            if !result? then
                // A loop ending a body whose return is still being
                // inferred, reached only as the tail of that body or of
                // one of its arms, delivers no value: without a valued
                // break it is the statement it was written as.
                if node.void_tolerated /\ frame.contributions.count == 0 then
                    return
                fi

                _logger.error(node.location, "cannot infer the type of this loop")

                return
            fi

            node.compile_expressions_state.value = IR.Values.BLOCK(result)

            _visitor.declare_composite_spill_field_for(node, node.compile_expressions_state.value)
        si
    si

    // One open loop's value bookkeeping: what its valued `break`s
    // contribute, whether anything consumes the result, and the label
    // name when the loop is written under a LABELLED wrapper. Lives on
    // COMPILE_EXPRESSIONS.loop_value_frames for the walk's duration.
    class LOOP_VALUE_FRAME is
        node: Trees.Statements.Statement
        label_name: string?
        wants_value: bool
        expected_type: Semantic.Types.Type?
        expected_type_error_message: string?
        contributions: Collections.MutableList[Semantic.Types.Type]
        has_valued_break: bool public
        valued_break_location: Source.LOCATION? public

        init(
            node: Trees.Statements.Statement,
            label_name: string?,
            wants_value: bool,
            expected_type: Semantic.Types.Type?,
            expected_type_error_message: string?
        ) is
            self.node = node
            self.label_name = label_name
            self.wants_value = wants_value
            self.expected_type = expected_type
            self.expected_type_error_message = expected_type_error_message
            self.contributions = Collections.LIST[Semantic.Types.Type]()
            self.has_valued_break = false
            self.valued_break_location = null
        si

        note_contribution(type: Semantic.Types.Type, location: Source.LOCATION) is
            contributions.add(type)

            if !has_valued_break then
                has_valued_break = true
                valued_break_location = location
            fi
        si
    si
si
