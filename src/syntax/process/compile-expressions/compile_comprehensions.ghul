namespace Syntax.Process is
    use System.Exception
    use Ghul.Pipes.any

    use IR.Values.Value
    use Semantic.Types.Type

    // `[element for p in source if condition ...]`. The clauses are
    // compiled outermost first, each inside the scope of the ones before
    // it: a `for` clause types its source and pattern the way a `for`
    // statement does, and an `if` clause narrows everything after it the
    // way an `if` narrows its then-arm. The element comes last, and its
    // type is the element type of the resulting array. generate-il emits
    // the loops into the BLOCK left as the node's value.
    partial COMPILE_EXPRESSIONS is
        pre(comprehension: Trees.Expressions.COMPREHENSION) -> bool is
            super.pre(comprehension)

            try
                if comprehension.is_lazy then
                    _compile_lazy_comprehension(comprehension)
                else
                    _compile_comprehension(comprehension)
                fi
            catch ex: Exception
                comprehension.compile_expressions_state.value = IR.Values.DUMMY(Semantic.Types.ERROR(), comprehension.location)
                _logger.exception(comprehension.location, ex, "exception compiling list comprehension")
            yrt

            return true
        si

        visit(comprehension: Trees.Expressions.COMPREHENSION) is
            super.visit(comprehension)
        si

        // `{element for p in source ...}`: the clauses are compiled exactly
        // as an array comprehension's are, but inside the generator literal
        // the comprehension owns, so its iterators and loop variables become
        // fields of that literal's frame and survive between elements. The
        // literal returns Pipe[T] for the element's type T, and the
        // comprehension's value is a call to it: each evaluation makes a new
        // pipe, which rewinds and re-runs the clauses as any pipe does.
        _compile_lazy_comprehension(comprehension: Trees.Expressions.COMPREHENSION) is
            let generator = cast Semantic.Symbols.Closure?(comprehension.scope)!
            let state_machine = Semantic.Symbols.state_machine_for(generator)!

            generator.map_type_arguments()

            if let dropped = state_machine.reset() then
                _composite_spill_state.drop_owned_by(dropped)
            fi

            // The literal takes no arguments; declaring that is what lets its
            // function type be built once its return type is known.
            generator.set_arguments(Collections.LIST[string](), Collections.LIST[Type]())

            generator.set_return_type(Semantic.Types.INFERRED_RETURN_TYPE())

            _symbol_table.current_closure_context.add_closure(generator)

            let element_constraint = Semantic.Symbols.sequence_element_type(comprehension.expected_type)

            if let constraint = element_constraint then
                comprehension.element.set_expected_type(
                    constraint,
                    "element type {0} not compatible with comprehension type {1}"
                )
            else
                comprehension.element.clear_expected_type()
            fi

            let outside = _flow.current_env.copy()

            _flow.push_literal_frame()

            generator.enter_literal_body()
            _compile_clause(comprehension, comprehension.first)
            generator.leave_literal_body()

            generator.literal_body_impure = _flow.pop_literal_frame()

            _flow.set_env(outside)

            COMPREHENSION_RESTRICTIONS(_logger).check(comprehension, loop_value_frames.count > 0)

            let value_type = comprehension.element.value?.type

            let element_type: Type =
                if let constraint = element_constraint then
                    constraint
                elif let settled = value_type /\ settled.is_settled then
                    settled
                else
                    _logger.error(comprehension.element.location, "cannot infer the element type of this comprehension")
                    Semantic.Types.ERROR()
                fi

            if let constraint = element_constraint, actual = value_type /\ !constraint.is_assignable_from(actual) then
                _logger.error(
                    comprehension.element.location,
                    "element type {actual} not compatible with comprehension type {constraint}"
                )
            fi

            comprehension.element_type = element_type

            let pipe_type = if !element_type.is_error then Semantic.Symbols.generator_return_type(element_type) else null fi

            if !pipe_type? then
                generator.set_return_type(Semantic.Types.ERROR())
                generator.unmap_type_arguments()
                comprehension.compile_expressions_state.value = IR.Values.DUMMY(Semantic.Types.ERROR(), comprehension.location)

                return
            fi

            generator.set_return_type(pipe_type)

            generator.unmap_type_arguments()

            let delegate = generator.load(comprehension.location, _symbol_loader)

            // Loading the literal is what gives it a captures frame when it
            // needs one, and the generator frame's reference to that is
            // settled when the frame is declared, so the frame is declared
            // after the load, as a generator literal's is.
            if let frame = state_machine.frame then
                frame.declare()
            fi

            comprehension.compile_expressions_state.value =
                IR.Values.Call.CLOSURE(
                    delegate,
                    pipe_type,
                    false,
                    delegate.type!,
                    Collections.LIST[Value]()
                )
        si

        pre(clause: Trees.Expressions.COMPREHENSION_FOR) -> bool => true
        visit(clause: Trees.Expressions.COMPREHENSION_FOR) is si

        pre(clause: Trees.Expressions.COMPREHENSION_IF) -> bool => true
        visit(clause: Trees.Expressions.COMPREHENSION_IF) is si

        _compile_comprehension(comprehension: Trees.Expressions.COMPREHENSION) is
            comprehension.type_expression.walk(self)

            let explicit_type =
                if !isa Trees.TypeExpressions.INFER(comprehension.type_expression) then
                    comprehension.type_expression.type
                else
                    null
                fi

            let element_types = COMPREHENSION_ELEMENT_TYPE()
            let element_constraint = element_types.constraint(explicit_type, comprehension.expected_type)

            if let constraint = element_constraint then
                comprehension.element.set_expected_type(
                    constraint,
                    "element type {0} not compatible with list comprehension type {1}"
                )
            else
                comprehension.element.clear_expected_type()
            fi

            // Nothing the clauses prove about a variable outlives the
            // comprehension.
            let outside = _flow.current_env.copy()

            _compile_clause(comprehension, comprehension.first)

            _flow.set_env(outside)

            COMPREHENSION_RESTRICTIONS(_logger).check(comprehension, loop_value_frames.count > 0)

            let value_type = comprehension.element.value?.type

            let element_type: Type =
                if let resolved = element_types.element_type(element_constraint, value_type) then
                    resolved
                else
                    _logger.error(comprehension.element.location, "cannot infer the element type of this list comprehension")
                    Semantic.Types.ERROR()
                fi

            if !element_types.fits(element_constraint, value_type) then
                _logger.error(
                    comprehension.element.location,
                    "element type {value_type} not compatible with list comprehension type {element_type}"
                )
            fi

            let array_type =
                if let explicit = explicit_type then
                    explicit
                else
                    _innate_symbol_lookup.get_array_type(element_type)
                fi

            comprehension.element_type = element_type

            if !element_type.is_error then
                _resolve_comprehension_list(comprehension, element_type)
                _try_presize_comprehension(comprehension)
            fi

            comprehension.compile_expressions_state.value = IR.Values.BLOCK(array_type)
        si

        // One `for` clause and no `if` means one element per source
        // element, so where the source's count is known before the loop the
        // array can be allocated at that length and filled by index.
        _try_presize_comprehension(comprehension: Trees.Expressions.COMPREHENSION) is
            let clause = comprehension.first

            if clause.inner? then
                return
            fi

            if let source_value = clause.source.value, source_type = source_value.type then
                let name = ".comprehension_source.{_next_fused_local_id()}"
                let load = IR.Values.Load.TEMP(name, source_type)

                if let count = known_counts.count_of(clause.source, load, source_type, comprehension.location) then
                    comprehension.presize_count = count
                    comprehension.presize_source_name = name
                    comprehension.presize_source_type = source_type
                fi
            fi
        si

        _resolve_comprehension_list(comprehension: Trees.Expressions.COMPREHENSION, element_type: Type) is
            let list_type = _innate_symbol_lookup.get_list_type(element_type)

            if !list_type? then
                _logger.error(comprehension.location, "cannot resolve the list type a list comprehension is built with")
                return
            fi

            comprehension.list_type = list_type
            comprehension.list_constructor = _resolve_ctor_by_arity(list_type, 0)
            comprehension.list_add = _resolve_member_by_arity(list_type, "add", 1)
            comprehension.list_to_array = _resolve_member_by_arity(list_type, "to_array", 0)
        si

        _compile_clause(comprehension: Trees.Expressions.COMPREHENSION, clause: Trees.Expressions.COMPREHENSION_CLAUSE?) is
            if !clause? then
                comprehension.element.walk(self)
                return
            fi

            if let for_clause: Trees.Expressions.COMPREHENSION_FOR = clause then
                _compile_for_clause(comprehension, for_clause)
            elif let if_clause: Trees.Expressions.COMPREHENSION_IF = clause then
                _compile_if_clause(comprehension, if_clause)
            fi
        si

        _compile_for_clause(comprehension: Trees.Expressions.COMPREHENSION, clause: Trees.Expressions.COMPREHENSION_FOR) is
            super.pre(clause)

            try
                let source = clause.source
                let variable = clause.variable
                let type: Type mut = Semantic.Types.ERROR()

                if !source.is_poisoned then
                    source.walk(self)

                    record_iterable_constraint(source)

                    if let sv = source.value, sv_type = sv.type /\ set_iterator_for(clause, sv_type, false) then
                        check_receiver_present(source)

                        if _never_ends(sv) /\ !comprehension.is_lazy then
                            _logger.warn(
                                source.location,
                                "unbounded-comprehension-source",
                                "list comprehension over a sequence that never ends"
                            )
                        fi

                        let current = clause.read_current!.return_type!

                        if let
                            te = variable.type_expression,
                            te_type = te.type /\
                        !isa Trees.TypeExpressions.INFER(te)
                        then
                            if te_type.is_assignable_from(current) then
                                type = te_type
                            else
                                _logger.error(variable.location, "type mismatch")
                            fi
                        else
                            type = current
                        fi
                    fi
                fi

                if !variable.is_poisoned then
                    set_symbol_type(variable.left, type)
                    declare_state_machine_local_fields(variable.left)
                fi

                // The clauses after this one run once per element, so a
                // narrow on anything they write cannot be assumed on the
                // way round.
                _flow.set_env(_loops.loop_kept_env(comprehension))

                _compile_clause(comprehension, clause.inner)
            finally
                super.visit(clause)
            yrt
        si

        // Whether `value` is a `Ghul.Pipes` source that never ends, or one
        // seen through stages that keep every element coming: map,
        // filter, index, skip and memo. Anything else - take, or a
        // function this does not know - may end, and is not reported.
        _never_ends(value: Value) -> bool is
            if let call: IR.Values.Call.GLOBAL = value then
                let function = call.function.root_specialized_from

                if _innate_symbol_lookup.get_pipes_unbounded_sources().contains(function) then
                    return true
                fi

                let role: string mut

                if
                    _innate_symbol_lookup.get_pipes_fusion_functions().try_get_value(function, role ref) /\
                    ["map", "filter", "index", "skip", "memo"] |> any(r => r =~ role) /\
                    call.arguments.count > 0
                then
                    return _never_ends(call.arguments[0])
                fi
            fi

            return false
        si

        _compile_if_clause(comprehension: Trees.Expressions.COMPREHENSION, clause: Trees.Expressions.COMPREHENSION_IF) is
            let condition = clause.condition
            let epoch = _flow.heap_epoch
            let mark = _flow.crossing_mark

            condition.walk(self)

            if Value.check_is_consumable(_logger, condition.location, condition.value) then
                if !condition.value!.type!.matches(_innate_symbol_lookup.get_bool_type()) then
                    _logger.error(condition.location, "list comprehension condition must be bool")
                fi
            fi

            let facts = _condition_analyzer.analyze_condition(condition, _flow.current_env)

            if _flow.heap_killed_since(epoch) then
                facts.then_env.drop_heap_facts()
            else
                _flow.adopt_crossings_since(facts.then_env, mark)
            fi

            _flow.set_env(facts.then_env)

            _compile_clause(comprehension, clause.inner)
        si
    si
si
