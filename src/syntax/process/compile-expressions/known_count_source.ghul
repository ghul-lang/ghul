namespace Syntax.Process is
    use IR.Values.Value
    use Semantic.Types.Type

    // How many elements a source will produce, known before any of them
    // is read: an array's or list's count, a range's `to - from` (plus one
    // when inclusive), or the count `repeat(value, count)` was given where
    // that is a literal or a variable read. The count is built over
    // `source_load`, the source already evaluated into a local, so reading
    // it evaluates nothing twice - except `repeat`'s count, which is why
    // only a count with no effect qualifies.
    //
    // A range or `repeat` count can be negative, meaning nothing is
    // produced, so it is clamped at zero here. A collection's own count
    // cannot be negative and is not.
    class KNOWN_COUNT_SOURCE is
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        _function_caller: Semantic.FUNCTION_CALLER
        _zero_argument_function: (Type, string) -> Semantic.Symbols.Function?
        _pipes_function_name: (Trees.Expressions.CALL) -> string?

        init(
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup,
            function_caller: Semantic.FUNCTION_CALLER,
            zero_argument_function: (Type, string) -> Semantic.Symbols.Function?,
            pipes_function_name: (Trees.Expressions.CALL) -> string?
        ) is
            _innate_symbol_lookup = innate_symbol_lookup
            _function_caller = function_caller
            _zero_argument_function = zero_argument_function
            _pipes_function_name = pipes_function_name
        si

        count_of(
            source: Trees.Expressions.Expression,
            source_load: Value,
            source_type: Type,
            location: Source.LOCATION
        ) -> Value? is
            let int_type = _innate_symbol_lookup.get_int_type()
            let no_arguments = Collections.LIST[Value](0)

            if isa Semantic.Types.ARRAY(source_type) \/
                is_same_generic(source_type, _innate_symbol_lookup.get_unspecialized_mutable_list_type()) \/
                is_same_generic(source_type, _innate_symbol_lookup.get_unspecialized_list_type())
            then
                if let count = _zero_argument_function(source_type, "$get_count") then
                    return count.call(location, source_load, no_arguments, null, _function_caller)
                fi

                return null
            fi

            // The range types resolve only as reflected ghul-runtime types,
            // and are absent while compiling the runtime itself, where they
            // are source symbols in the project. Sizing is an optimisation
            // and nothing may throw out of it, so it asks for them in the
            // form that can decline.
            let ranges = _innate_symbol_lookup.get_int_range_types()

            if !ranges? then
                return null
            fi

            let is_range = is_same_generic(source_type, ranges.exclusive)
            let is_inclusive = is_same_generic(source_type, ranges.inclusive)

            if is_range \/ is_inclusive then
                let to = _zero_argument_function(source_type, "$get_to")
                let from = _zero_argument_function(source_type, "$get_from")

                if !to? \/ !from? then
                    return null
                fi

                let span =
                    cast Value(
                        IR.Values.ARITHMETIC(
                            IR.ArithmeticOperation.SUBTRACT,
                            to.call(location, source_load, no_arguments, null, _function_caller),
                            from.call(location, source_load, no_arguments, null, _function_caller),
                            int_type).unmarked())

                let extent =
                    if is_inclusive then
                        cast Value(
                            IR.Values.ARITHMETIC(
                                IR.ArithmeticOperation.ADD,
                                span,
                                IR.Values.Literal.NUMBER(1, int_type),
                                int_type).unmarked())
                    else
                        span
                    fi

                return IR.Values.INT_MAX_ZERO(extent, int_type)
            fi

            if let source_call = cast Trees.Expressions.CALL?(source) then
                if let name = _pipes_function_name(source_call) then
                    let arguments = source_call.arguments.expressions

                    if name =~ "repeat" /\ arguments.count == 2 then
                        let given = arguments[1].value

                        if isa IR.Values.Literal.NUMBER(given) \/ isa IR.Values.Load.SYMBOL(given) then
                            return IR.Values.INT_MAX_ZERO(given, int_type)
                        fi
                    fi
                fi
            fi

            return null
        si

        // Whether `type` is an instantiation of the generic `generic`
        // stands for, by the identity of the Classy each is over.
        is_same_generic(type: Type, generic: Type?) -> bool is
            if !generic? then
                return false
            fi

            let a = _classy_of(type)
            let b = _classy_of(generic)

            return a? /\ b? /\ a == b
        si

        _classy_of(type: Type) -> Semantic.Symbols.Classy? is
            if !isa Semantic.Types.NAMED(type) then
                return null
            fi

            let symbol mut = (cast Semantic.Types.NAMED(type)).symbol

            if isa Semantic.Symbols.GENERIC(symbol) then
                symbol = (cast Semantic.Symbols.GENERIC(symbol)).symbol
            fi

            if isa Semantic.Symbols.Classy(symbol) then
                return cast Semantic.Symbols.Classy(symbol)
            fi

            return null
        si
    si
si
