namespace Syntax.Process is
    use Logging

    use Semantic.LEAST_UPPER_BOUND_MAP
    use Semantic.Types.Type

    // Settles a loop expression's result type from its valued-`break`
    // contributions: the LUB of the contributions — falling back to the
    // pushed expected type when nothing usable contributes — widened to
    // the optional of the element type, as a written `T?` of it is.
    // An already-optional LUB stands. Where the element is an
    // unconstrained type parameter and `MAYBE` is unavailable, which is
    // the case while compiling ghul-runtime itself, it takes the flagged
    // reference optional.
    //
    // The optional maker is injected: it depends on reflected runtime
    // assemblies that unit-test fixtures do not load.
    class LOOP_RESULT_SETTLER is
        _make_optional: (Type) -> Type?

        init(make_optional: (Type) -> Type?) is
            _make_optional = make_optional
        si

        // Null means "cannot infer" — contributions empty or all-error,
        // with no expected type — for the caller to report against the
        // loop's own location.
        settle(contributions: Collections.Iterable[Type], expected: Type?) -> Type? is
            let lub = LEAST_UPPER_BOUND_MAP()

            let saw_contribution mut = false

            // A `break null` says only that the result can be absent, which
            // the optional result already says, so it adds nothing to the
            // join, as exhaustion adds nothing.
            for t in contributions do
                if !t.is_error /\ !t.is_null then
                    lub.add(t)

                    saw_contribution = true
                fi
            od

            if !saw_contribution then
                return expected
            fi

            let inner mut = lub.get_result() ?? expected

            if !inner? then
                return null
            fi

            if inner.is_optional then
                return inner
            fi

            return _make_optional(inner) ?? inner.as_optional()
        si
    si
si
