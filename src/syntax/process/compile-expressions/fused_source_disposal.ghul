namespace Syntax.Process is
    use Semantic.Types.Type

    /// Whether a fused consumer disposes the iterator it read its source
    /// through, as the runtime terminal it stands in for does. It does,
    /// except where the source is one whose iterator is known to hold
    /// nothing, so that fusing a chain never changes what it disposes and a
    /// chain over such a source pays nothing for the dispose.
    class FUSED_SOURCE_DISPOSAL is
        /// Whether a fused consumer over a source of static type `source`
        /// must dispose the iterator it took.
        ///
        /// - source: the static type of the chain's source
        /// - ranges: the runtime's int range types, or null where they are
        ///   not known, as while compiling the runtime itself
        needs_dispose(source: Type, ranges: (exclusive: Type, inclusive: Type)?) -> bool static is
            // An array's iterator holds only the array and an index.
            if isa Semantic.Types.ARRAY(source) then
                return false
            fi

            // An int range is a struct and its own iterator, with an empty
            // dispose.
            if let known = ranges then
                if KNOWN_COUNT_SOURCE.is_same_generic(source, known.exclusive) \/ KNOWN_COUNT_SOURCE.is_same_generic(source, known.inclusive) then
                    return false
                fi
            fi

            return true
        si
    si
si
