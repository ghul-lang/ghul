namespace Syntax.Process is
    use Source.LOCATION

    // A call's arguments as the callee's formals see them.
    //
    // Written one expression per formal, the two lists agree and every
    // slot is the expression standing in it. Written with an argument
    // pack spread out - `apply(f, "a", "b")` against `v: T..` - the
    // trailing expressions fill one formal between them. That slot has a
    // location and, once walked, a value, but no expression of its own:
    // the tuple is built as a value over the elements' values, and the
    // call keeps the argument list it was written with.
    class ARGUMENT_SLOTS is
        written: Trees.Expressions.Expression[]

        // The formal the trailing expressions fill, and negative where
        // every formal has an expression of its own.
        spread_index: int

        init(written: Trees.Expressions.Expression[], spread_index: int) is
            self.written = written
            self.spread_index = spread_index
        si

        plain(written: Trees.Expressions.Expression[]) -> ARGUMENT_SLOTS static =>
            ARGUMENT_SLOTS(written, -1)

        has_spread: bool => spread_index >= 0

        count: int =>
            if has_spread then spread_index + 1 else written.count fi

        is_spread(index: int) -> bool =>
            has_spread /\ index == spread_index

        // The expression standing in the slot, and absent for the one the
        // spread fills.
        expression(index: int) -> Trees.Expressions.Expression? =>
            if is_spread(index) then null else written[index] fi

        // One entry per formal.
        expressions: Trees.Expressions.Expression?[] is
            let result = Collections.LIST[Trees.Expressions.Expression?]()

            for i in 0..count do
                result.add(expression(i))
            od

            return result
        si

        // The expressions the spread collects, in order.
        elements: Trees.Expressions.Expression[] is
            let result = Collections.LIST[Trees.Expressions.Expression]()

            if has_spread then
                for i in spread_index..written.count do
                    result.add(written[i])
                od
            fi

            return result
        si

        // Where the slot is written: its expression, or the span from the
        // first spread element to the last.
        location(index: int) -> LOCATION is
            if let expression = expression(index) then
                return expression.location
            fi

            let first = written[spread_index].location
            let last = written[written.count - 1].location

            return LOCATION(first.file_name, first.start_line, first.start_column, last.end_line, last.end_column)
        si
    si
si
