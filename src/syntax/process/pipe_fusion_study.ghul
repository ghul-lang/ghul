namespace Syntax.Process is
    use Collections

    // Env-gated measurement reporting for pipe fusion.
    //
    // GHUL_PIPE_FUSION_STUDY names the file the report is written to;
    // unset, nothing here runs and nothing is recorded. Reporting-only:
    // nothing in this class alters what the compiler concludes, reports
    // or emits.
    //
    // The report answers the questions a corpus sweep asks of fusion.
    // One record per site where a chain of Ghul.Pipes combinators is
    // consumed says whether that chain fused and, when it did not, the
    // reason the recogniser or the resolver gave - so the reasons can be
    // counted and the shapes that lose most often ranked. One record per
    // Ghul.Pipes call gives the total combinator surface the site
    // records are a fraction of.
    //
    // A third record, per function a fused site runs, says whether the
    // function is inlined into the loop or called through a delegate, and
    // whether that delegate captures anything: what fusion still allocates.
    //
    // All are keyed by source position, and a later record for a
    // position replaces the one before it: compile-expressions walks a
    // body more than once - speculatively, on overload retry, and again
    // in the combined-solve rounds - and what a site finally decided is
    // what the last walk decided.
    class PIPE_FUSION_STUDY is

        _path: string? static
        _enabled: bool static
        _enabled_known: bool static

        enabled: bool static is
            if !_enabled_known then
                _path = Driver.COMPILER_ENVIRONMENT.pipe_fusion_study
                _enabled = _path? /\ _path.length > 0
                _enabled_known = true
            fi

            return _enabled
        si

        _sites: MutableMap[string, string]? static
        _calls: MutableMap[string, string]? static

        _site_records: MutableMap[string, string] static is
            if !_sites? then
                _sites = MAP[string, string]()
            fi

            return _sites
        si

        _call_records: MutableMap[string, string] static is
            if !_calls? then
                _calls = MAP[string, string]()
            fi

            return _calls
        si

        _position(location: Source.LOCATION) -> string static =>
            "{location.file_name}:{location.start_line}:{location.start_column}"

        // Record what a consumption site decided. `consumer` names what
        // was going to read the chain - `for`, or the Ghul.Pipes function
        // the chain was an argument of - and `consumer_fusible` whether
        // fusion has a consumer for it, which decides half of whether
        // the site could fuse whatever the chain looks like. `stages` is
        // the chain's roles outermost first, comma separated. `reason` is
        // empty for a site that fused.
        note_site(
            location: Source.LOCATION,
            consumer: string,
            consumer_fusible: bool,
            stages: string,
            fused: bool,
            reason: string
        ) static is
            if !enabled then
                return
            fi

            _site_records[_position(location)] =
                "{consumer}\t{if consumer_fusible then "consumer-fusible" else "consumer-unfusible" fi}\t"
                "{if stages.length == 0 then "-" else stages fi}\t"
                "{if fused then "fused" else "declined" fi}\t"
                "{if reason.length == 0 then "-" else reason fi}"
        si

        // Record how a fused site runs one of the functions it was
        // given - a stage's mapper or predicate, or the consumer's own
        // function argument. `closure` is the literal's closure, or null
        // where the argument is not a literal. Whether the literal
        // captures anything is read when the report is written, once
        // every walk of its body has settled what it captures.
        note_fused_function(
            site: Source.LOCATION,
            function: Source.LOCATION,
            role: string,
            inlined: bool,
            closure: Semantic.Symbols.Closure?
        ) static is
            if !enabled then
                return
            fi

            _function_records[_position(function)] = (_position(site), role, inlined, closure)
        si

        _functions: MutableMap[string, (site: string, role: string, inlined: bool, closure: Semantic.Symbols.Closure?)]? static

        _function_records: MutableMap[string, (site: string, role: string, inlined: bool, closure: Semantic.Symbols.Closure?)] static is
            if !_functions? then
                _functions = MAP[string, (site: string, role: string, inlined: bool, closure: Semantic.Symbols.Closure?)]()
            fi

            return _functions
        si

        // How a fused function runs: in the loop itself, or through a
        // delegate - one built once where the literal captures nothing,
        // or one built with a frame each time the site runs where it does.
        _function_lowering(inlined: bool, closure: Semantic.Symbols.Closure?) -> string static =>
            if inlined then
                "inlined"
            elif !closure? then
                "function-value"
            elif (closure.captured_values?.count ?? 0) > 0 \/ closure.is_self_captured then
                "delegate-capturing"
            else
                "delegate-capture-free"
            fi

        // Record a call to a Ghul.Pipes function, whether or not fusion
        // ever looked at it.
        note_call(location: Source.LOCATION, name: string) static is
            if !enabled then
                return
            fi

            _call_records[_position(location)] = name
        si

        report() static is
            if !enabled \/ !_path? then
                return
            fi

            try
                let use writer = IO.StreamWriter(_path)

                for position in _site_records.keys do
                    writer.write_line("site\t{position}\t{_site_records[position]}")
                od

                for position in _call_records.keys do
                    writer.write_line("call\t{position}\t{_call_records[position]}")
                od

                for position in _function_records.keys do
                    let (site, role, inlined, closure) = _function_records[position]

                    writer.write_line("function\t{position}\t{site}\t{role}\t{_function_lowering(inlined, closure)}")
                od

                writer.flush()
            catch ex: System.Exception
                IO.Std.error.write_line("pipe fusion study: report failed: {ex}")
            yrt
        si
    si
si
