namespace Syntax.Process is
    use IR.Values.Value
    use Semantic.Types.Type

    // How a failed `u!` returns its error from the enclosing function rather
    // than throwing: the operand, the test that it holds the default variant,
    // how to read the unwrapped value, and one way out for each other
    // variant. The values that read the operand take it from the stack.
    //
    // Built by COMPILE_ACCESS, emitted by GENERATE_IL.visit(UNWRAP).
    class UNWRAP_PROPAGATION is
        operand: Value
        presence_test: Value
        value_extract: Value
        failures: Collections.LIST[UNWRAP_PROPAGATED_FAILURE]

        init(operand: Value, presence_test: Value, value_extract: Value, failures: Collections.LIST[UNWRAP_PROPAGATED_FAILURE]) is
            self.operand = operand
            self.presence_test = presence_test
            self.value_extract = value_extract
            self.failures = failures
        si
    si

    // One variant other than the default one: the test that the operand
    // holds it, how to read its error field, and the constructor of the same
    // variant at the function's return type, which the error is returned in.
    class UNWRAP_PROPAGATED_FAILURE is
        variant_test: Value
        error_extract: Value
        error_type: Type
        constructor: Semantic.Symbols.Function
        returned_type: Type

        init(variant_test: Value, error_extract: Value, error_type: Type, constructor: Semantic.Symbols.Function, returned_type: Type) is
            self.variant_test = variant_test
            self.error_extract = error_extract
            self.error_type = error_type
            self.constructor = constructor
            self.returned_type = returned_type
        si
    si
si
