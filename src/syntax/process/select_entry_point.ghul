namespace Syntax.Process is
    use Source.LOCATION
    use Trees

    use Logging.Logger

    use Semantic.Symbols.Function

    // Picks the assembly's entry point out of every candidate the project
    // declares, before generate-il runs.
    //
    // Three kinds of declaration can name one, and they rank against each
    // other rather than competing first-come:
    //
    //   1. an `@entry` (or `@IL.entrypoint`) pragma
    //   2. a function named by `--entry`, or `entry` when that is not given
    //   3. the entry synthesised from a file's top-level statements
    //
    // The highest rank any candidate reaches wins, and two candidates at
    // that rank are the duplicate-entrypoint error - except at rank 3,
    // where several files each carrying top-level statements is a project
    // shape rather than a mistake: none of them is selected, each is told
    // its statements will not run, and an executable build that ends up
    // with no entry point at all reports that separately.
    //
    // Ranking matters most for rank 3. A synthesised entry is a file-private
    // definition like any other, so a project may hold any number of them -
    // an umbrella project globbing a directory of one-file examples, say -
    // and naming the real entry point with `--entry` is what tells them
    // apart. `--entry` also takes rank 3 out of the running entirely: a
    // build that asks for an entry point by name does not want statements
    // from some other file instead.
    // A declaration of the entry-point name whose shape cannot be
    // entered at, and which part of it says so.
    class REJECTED_ENTRY_NAME(location: LOCATION, name: string, fault: string)

    class SELECT_ENTRY_POINT: Visitor is
        UNRUN_STATEMENTS: string static => "top-level-statements-not-run"

        _PRAGMA_RANK: int static => 0
        _NAMED_RANK: int static => 1
        _TOP_LEVEL_RANK: int static => 2

        _logger: Logger
        _symbol_table: Semantic.SYMBOL_TABLE
        _entry_point: Compiler.ENTRY_POINT
        _build_flags: Compiler.GLOBAL_BUILD_FLAGS

        _candidates: Collections.LIST[ENTRY_POINT_CANDIDATE]
        _pending_entry_pragma: bool

        // The function declaration the next synthesised `_entry` wrapper
        // stands in for. The wrapper is appended after the original in its
        // definition list, so the original is always walked first.
        _wrapped_original: Definitions.FUNCTION?

        // A declaration of the entry-point name that cannot be entered
        // at, held until the choice is made: whether it is a fault at
        // all depends on what else the build found.
        _rejected_named: REJECTED_ENTRY_NAME?

        // Whether a function the entry-point name selects was rejected
        // for its shape. The program has said where it starts, so the
        // statements of some other file are not taken in its place -
        // starting somewhere the author did not name is as surprising as
        // not starting at all, and the error at the function is the
        // whole of what to say about it.
        _entry_name_claimed: bool

        // Whether the project carries top-level statements that no build
        // will run. Read by the compiler so an executable build with no
        // entry point can say which of the two shapes it is in.
        left_top_level_statements_unrun: bool public

        // Whether `--entry` named a function that no candidate matches -
        // distinct from several top-level files leaving the choice open,
        // since here the caller did name one and nothing answered to it.
        // Read by the compiler for the same reason as the field above.
        named_entry_point_not_found: bool public

        init(
            logger: Logger,
            symbol_table: Semantic.SYMBOL_TABLE,
            entry_point: Compiler.ENTRY_POINT,
            build_flags: Compiler.GLOBAL_BUILD_FLAGS
        ) is
            super.init()

            _logger = logger
            _symbol_table = symbol_table
            _entry_point = entry_point
            _build_flags = build_flags
            _candidates = Collections.LIST[ENTRY_POINT_CANDIDATE]()
        si

        start() is
            _candidates.clear()
            _pending_entry_pragma = false
            _entry_name_claimed = false
            _rejected_named = null
            left_top_level_statements_unrun = false
            named_entry_point_not_found = false
        si

        apply(source_file: Compiler.SOURCE_FILE) is
            _pending_entry_pragma = false
            _wrapped_original = null

            source_file.definition.walk(self)
        si

        pre(pragma: Definitions.PRAGMA) -> bool is
            let name = pragma.pragma.name.to_string()

            if name =~ "entry" \/ name =~ IL_PRAGMAS.ENTRYPOINT then
                _pending_entry_pragma = true
            fi

            return false
        si

        pre(function: Definitions.FUNCTION) -> bool is
            let is_pragma_marked = _pending_entry_pragma

            _pending_entry_pragma = false

            // Stands in for by a synthesised `_entry` wrapper: this
            // function's own signature is never Main-compatible, so it
            // is never itself a candidate. Remembered, so the wrapper's
            // candidate can describe this declaration - the user wrote
            // this one, and no diagnostic should name the wrapper.
            if function.wrapped_by_synthesized_main then
                _wrapped_original = function
                return true
            fi

            let name = function.name
            let is_named_entry =
                (name? /\ name.name =~ _entry_point.name) \/
                function.is_synthesized_main_wrapper

            // Nothing inside a body can be a candidate - a lambda is never
            // one, and a function cannot nest - so the walk stops at every
            // function header rather than descending through every
            // expression in the project. The three cheap tests come first
            // so the vast majority of headers cost a string compare and
            // never reach the symbol table.
            if !function.is_top_level_entry /\ !is_pragma_marked /\ !is_named_entry then
                return true
            fi

            let symbol = _function_for(function)

            // Only the two kinds the runtime can enter at: a global
            // function or a static method. An instance method named
            // `entry` is an ordinary member.
            if !symbol? \/ !(isa Semantic.Symbols.GLOBAL_FUNCTION(symbol) \/ isa Semantic.Symbols.STATIC_METHOD(symbol)) then
                return true
            fi

            let declared_at = if name? then name.location else function.location fi

            if function.is_top_level_entry then
                _candidates.add(
                    ENTRY_POINT_CANDIDATE(
                        _TOP_LEVEL_RANK,
                        symbol,
                        _first_statement_location(function),
                        true,
                        symbol.name))
            elif function.is_synthesized_main_wrapper then
                // Emission enters the wrapper, but no diagnostic should
                // name it: the candidate borrows the wrapped declaration's
                // name and a location the user can jump to. A wrapper for a
                // top-level entry carries the top-level rank - several files
                // each holding statements stay the tolerated tie they are
                // without wrappers, and `--entry` still takes them all out
                // of the running.
                let original = _wrapped_original

                let wrapped_name =
                    if original? /\ original.name? then
                        original.name.name
                    else
                        symbol.name
                    fi

                let wrapped_location =
                    if original? /\ original.is_top_level_entry then
                        _first_statement_location(original)
                    elif original? /\ original.name? then
                        original.name.location
                    else
                        declared_at
                    fi

                let rank = if function.wraps_top_level_entry then _TOP_LEVEL_RANK else _NAMED_RANK fi

                _candidates.add(
                    ENTRY_POINT_CANDIDATE(
                        rank,
                        symbol,
                        wrapped_location,
                        function.wraps_top_level_entry,
                        wrapped_name))
            elif is_pragma_marked then
                _candidates.add(ENTRY_POINT_CANDIDATE(_PRAGMA_RANK, symbol, declared_at, false, symbol.name))
            else
                let fault = _entry_point_shape_fault(symbol)

                if !fault? then
                    _candidates.add(ENTRY_POINT_CANDIDATE(_NAMED_RANK, symbol, declared_at, false, symbol.name))
                elif
                    _build_flags.want_executable /\
                    !_build_flags.want_library /\
                    isa Semantic.Symbols.GLOBAL_FUNCTION(symbol) /\
                    !_rejected_named?
                then
                    // Only a global function is selected by the name: a
                    // static method of the same name is an ordinary
                    // member, as it is for the environment parameter. A
                    // library enters nowhere, so the name means nothing
                    // there either. Whether this is a fault waits for the
                    // choice - an `@entry` pragma elsewhere names the
                    // entry point over any name match, and then this
                    // declaration was never where the program starts.
                    _rejected_named = REJECTED_ENTRY_NAME(declared_at, symbol.name, fault)
                fi
            fi

            return true
        si

        finish() is
            let chosen mut = _choose()

            // A rejected name is a fault only where nothing outranked
            // it: with an `@entry` pragma elsewhere the program starts
            // there and this declaration was never consulted, while a
            // file's top-level statements rank below the name and do not
            // stand in for it - a program that declares where it starts
            // has said so.
            if let rejected = _rejected_named /\ (!chosen? \/ chosen.is_top_level) then
                _logger.error(rejected.location, "cannot start at {rejected.name}: {rejected.fault}")

                _entry_name_claimed = true
                chosen = null
            fi

            if let selected = chosen then
                selected.symbol.is_entry_point = true
            fi

            // `--entry` excludes every top-level candidate from `_choose`,
            // so a null result while it was given means nothing else
            // matched the name either - not the multi-file tie the
            // fallback message below otherwise assumes.
            named_entry_point_not_found = !chosen? /\ _entry_point.name_is_explicit

            for candidate in _candidates do
                if !candidate.is_top_level \/ (chosen? /\ candidate.symbol == chosen.symbol) then
                    continue
                fi

                left_top_level_statements_unrun = true

                _warn_unrun(candidate, chosen)
            od
        si

        // The winner, or absent when nothing is declared or when the top
        // rank is a tie the project is allowed to have.
        _choose() -> ENTRY_POINT_CANDIDATE? is
            let best: ENTRY_POINT_CANDIDATE? mut = null

            for candidate in _candidates do
                if candidate.rank == _TOP_LEVEL_RANK /\ _entry_point.name_is_explicit then
                    continue
                fi

                if !best? \/ candidate.rank < best.rank then
                    best = candidate
                fi
            od

            if !best? then
                return null
            fi

            let winners = Collections.LIST[ENTRY_POINT_CANDIDATE]()

            for candidate in _candidates do
                if candidate.rank == best.rank /\
                    !(candidate.rank == _TOP_LEVEL_RANK /\ _entry_point.name_is_explicit)
                then
                    winners.add(candidate)
                fi
            od

            if winners.count == 1 then
                return winners[0]
            fi

            // Two files each carrying top-level statements is a shape an
            // umbrella project has on purpose, so it selects nothing and
            // says so per file rather than failing here.
            if best.rank != _TOP_LEVEL_RANK then
                for i in 1..winners.count do
                    _logger.error(
                        winners[i].location,
                        "duplicate entrypoint",
                        winners[0].location,
                        "entry point already declared here")
                od

                return winners[0]
            fi

            return null
        si

        _warn_unrun(candidate: ENTRY_POINT_CANDIDATE, chosen: ENTRY_POINT_CANDIDATE?) is
            if _entry_name_claimed then
                // The error at the function named as the entry point says
                // why nothing runs; that these statements are what did
                // not run instead is not a second fault.
                return
            fi

            if let selected = chosen then
                _logger.warn(
                    candidate.location,
                    UNRUN_STATEMENTS,
                    "top-level statements will not run: the entry point is {selected.display_name}",
                    selected.location,
                    "entry point declared here")
            elif named_entry_point_not_found then
                _logger.warn(
                    candidate.location,
                    UNRUN_STATEMENTS,
                    "top-level statements will not run: no function matches the --entry name {_entry_point.name}")
            else
                _logger.warn(
                    candidate.location,
                    UNRUN_STATEMENTS,
                    "top-level statements will not run: more than one file carries them and none is named with --entry")
            fi
        si

        // Which part of this function's shape the runtime cannot enter
        // at, or null where it can: an entry point takes no arguments or
        // one `string[]` - a `Ghul.Environment` parameter is carried by
        // a synthesised wrapper, which is what reaches here in its place
        // - and returns `int` or `void`. A return type the walk has not
        // settled yet - analysis mode leaves an unopened file's body
        // uncompiled - is taken on trust rather than silently dropping
        // the candidate.
        _entry_point_shape_fault(symbol: Function) -> string? is
            let return_type = symbol.return_type

            if !return_type? then
                return null
            fi

            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            // An asynchronous function is ruled out here too, by the
            // task-like it returns rather than by anything else about
            // it: neither a task nor a task-like is int or void.
            if !return_type.matches(lookup.get_int_type()) /\ !return_type.matches(lookup.get_void_type()) then
                return "the return type is neither int nor void"
            fi

            if symbol.arguments.count > 1 then
                return "an entry point takes at most one string[] and one Ghul.Environment"
            fi

            if symbol.arguments.count == 1 /\
                !symbol.arguments[0].matches(lookup.get_array_type(lookup.get_string_type()))
            then
                return "the parameter type is neither string[] nor Ghul.Environment"
            fi

            return null
        si

        _first_statement_location(function: Definitions.FUNCTION) -> LOCATION is
            if let block = cast Bodies.BLOCK?(function.body) then
                for statement in block.statements do
                    return statement.location
                od
            fi

            return function.location
        si

        _function_for(node: Trees.Node) -> Function? is
            let scope = _symbol_table.scope_for(node)

            if !scope? then
                return null
            fi

            return cast Function?(scope.underlying_scope)
        si
    si

    class ENTRY_POINT_CANDIDATE(
        rank: int,
        symbol: Function,
        location: LOCATION,
        is_top_level: bool,
        display_name: string
    ) is si
si
