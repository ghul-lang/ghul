namespace Syntax.Process.Printer is
    // Chooses which written type annotations the formatter leaves out, so
    // a program can be printed with some of what its author wrote for
    // inference to recover. The sites are numbered in print order - a
    // local's type, a function literal's parameter or return type, a
    // call's type arguments - and the selection names them by number:
    // `all` for every site, `list` for none (the numbering is then what
    // is wanted), or comma-separated numbers and `a-b` ranges.
    //
    // A selection prefixed `cast:` numbers the targets of explicit casts
    // instead, and only those: `cast double(n)` printed as `cast(n)`.
    //
    // A selection prefixed `signature:` numbers the signatures of the
    // functions in a file with top-level statements that could be written
    // with no types at all, and only those. A chosen one is printed with
    // its type parameters, parameter types and return type left out:
    // `step(n: int) -> int` printed as `step(n)`.
    class ANNOTATION_STRIPPER(selection: string) is
        sites: Collections.LIST[string]
        _selected: Collections.SET[int]
        _all: bool
        _casts: bool
        _signatures: bool

        // Whether `selection` names one of the prefixed site kinds.
        _prefixed(prefix: string) -> bool => selection.starts_with(prefix)

        init(..) is
            sites = Collections.LIST[string]()
            _selected = Collections.SET[int]()
            _casts = _prefixed("cast:")
            _signatures = _prefixed("signature:")

            let chosen =
                if _casts then selection.substring(5)
                elif _signatures then selection.substring(10)
                else selection fi

            _all = chosen =~ "all"

            if !_all /\ !(chosen =~ "list") then
                for part in chosen.split([',']) do
                    let range = part.trim().split(['-'])

                    if range.count == 2 then
                        for i in int.parse(range[0])::int.parse(range[1]) do
                            _selected.add(i)
                        od
                    elif range[0].length > 0 then
                        _selected.add(int.parse(range[0]))
                    fi
                od
            fi
        si

        // Numbers the site and says whether its annotation is left out.
        // The listing gives the text the annotation occupies, so a tool can
        // take it out of the source in place rather than reprinting the file:
        // `type` names the written type, which a separating ':' or '->'
        // precedes, and `after` names what follows the end of `from` up to
        // the last ']' at or before the end of `to`. A call's location runs
        // on past its type arguments, so the end given is not the ']' itself.
        strip(kind: string, location: Source.LOCATION, mode: string, from: Source.LOCATION, to: Source.LOCATION) -> bool is
            if (kind =~ "cast") != _casts \/ _signatures then
                return false
            fi

            let n = sites.count

            sites.add("{n} {kind} {location.start_line},{location.start_column} {mode} {from.start_line},{from.start_column},{from.end_line},{from.end_column} {to.end_line},{to.end_column}")

            _all \/ _selected.contains(n)
        si

        // Numbers a function's signature, under a `signature:` selection,
        // and says whether it is printed without its types. The listing
        // gives the span from the start of the name to the end of the last
        // of the return type, the modifiers and the parameters, and the text
        // the signature reads as with the types left out, which runs to the
        // end of the line. Where the span ends at a parameter, the closing
        // `)` that follows it is not in the span.
        strip_signature(from: Source.LOCATION, to: Source.LOCATION, replacement: string) -> bool is
            if !_signatures then
                return false
            fi

            let n = sites.count

            sites.add("{n} signature {from.start_line},{from.start_column} replace {from.start_line},{from.start_column},{to.end_line},{to.end_column} {replacement}")

            _all \/ _selected.contains(n)
        si
    si
si
