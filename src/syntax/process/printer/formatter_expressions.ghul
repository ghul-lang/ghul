namespace Syntax.Process.Printer is
    use Collections

    use Trees
    use Source

    use Lexical.TRIVIA


    // Expression and member formatting: interpolation, variables, properties, modifiers,
    // calls, parameter and argument lists.
    partial FORMATTER is

        // A binary chain is one breaking unit: the left-nested spine of its
        // lowest-precedence operator shares a single group with a soft break
        // after each operator, so a chain that does not fit breaks one
        // operand per line, every operand at the indent of the first, with
        // each operator left at the end of the line above it. Breaks go after an operator only - a line-start operator
        // opens something new, so a break before one would change what the
        // next line re-parses as.
        visit(binary: Expressions.BINARY) is
            note(binary.location)

            if is_tight_range(binary) then
                binary.left.accept(self)
                write_operation(binary)
                binary.right.accept(self)
                return
            fi

            // A short last operand of a two-operand chain stays with its
            // operator: `(...).count == 7` never leaves the 7 on its own.
            if !_is_chain_link(binary.left, binary) /\ _is_simple_element(binary.right) then
                binary.left.accept(self)
                write(' ')
                write_operation(binary)
                write(' ')
                binary.right.accept(self)
                return
            fi

            _builder.begin_group()
            _emit_binary_chain(binary)
            _builder.end_group()
        si

        // Whether `left` is flattened into `binary`'s chain.
        _is_chain_link(left: Expressions.Expression, binary: Expressions.BINARY) -> bool =>
            if let left_binary: Expressions.BINARY = left then
                !is_tight_range(left_binary) /\ _precedence(left_binary) == _precedence(binary)
            else
                false
            fi

        // Emit a chain's operands and operators in tree order, a soft break
        // after each operator. Only the left spine of operators of the
        // chain's own precedence is flattened into the enclosing group, so
        // `a * b - c * d` breaks after the `-` and keeps each product whole;
        // any other binary operand recurses through visit(BINARY) and breaks
        // as its own unit, so a nested chain indents once rather than once
        // per enclosing operator.
        _emit_binary_chain(binary: Expressions.BINARY) is
            if _is_chain_link(binary.left, binary) then
                _emit_binary_chain(cast Expressions.BINARY(binary.left))
            else
                binary.left.accept(self)
            fi

            write(' ')
            write_operation(binary)
            _builder.line()
            binary.right.accept(self)
        si

        _precedence(binary: Expressions.BINARY) -> Syntax.Parsers.Expressions.PRECEDENCE =>
            Syntax.Parsers.Expressions.EXPRESSION.auto_precedence_for(binary.actual_operation ?? binary.operation.name)

        write_operation(binary: Expressions.BINARY) is
            if binary.actual_operation? then
                write(binary.actual_operation)
            else
                binary.operation.accept(self)
            fi
        si

        is_tight_range(binary: Expressions.BINARY) -> bool is
            let name = binary.actual_operation ?? binary.operation.name

            if !(name.starts_with("..") \/ name.starts_with("::")) then
                return false
            fi

            return _ends_in_term(binary.left) /\ _starts_with_term(binary.right)
        si

        // A range is written tight unless that would run its operator into
        // an operator beside it: `0..n - 1` and `i + 1..n` read as written,
        // but `0..-1` would scan `..-` as a single operator.
        _ends_in_term(e: Expressions.Expression) -> bool =>
            if let b: Expressions.BINARY = e then
                _ends_in_term(b.right)
            elif let u: Expressions.UNARY = e then
                _ends_in_term(u.right)
            else
                is_range_term(e)
            fi

        _starts_with_term(e: Expressions.Expression) -> bool =>
            if let b: Expressions.BINARY = e then
                _starts_with_term(b.left)
            elif let c: Expressions.CALL = e /\ _is_pipe_stage(c) then
                _starts_with_term(c.arguments.expressions[0])
            else
                is_range_term(e)
            fi

        // An operand that needs no separating space beside a range operator:
        // it ends in a name character or a closing delimiter.
        is_range_term(e: Expressions.Expression) -> bool =>
            isa Expressions.Literals.Literal(e) \/
            isa Expressions.IDENTIFIER(e) \/
            isa Expressions.MEMBER(e) \/
            isa Expressions.CALL(e) \/
            isa Expressions.INDEX(e) \/
            isa Expressions.TUPLE(e)

        // --- faithfulness fix: string interpolation. The inherited visit
        //     runs each literal fragment through visit(STRING), which wraps
        //     it in quotes — producing invalid nested-string output. Emit the
        //     literal fragments as raw escaped text instead. ---

        visit(interpolation: Expressions.STRING_INTERPOLATION) is
            note(interpolation.location)

            write(cast char(34))

            // A string literal is never broken: an expression inside one
            // is laid out flat whatever the width.
            _builder.begin_group()

            for fragment in interpolation.values do
                if fragment.is_expression then
                    write('{')
                    fragment.expression.accept(self)
                    if let fragment.alignment? then
                        write(',')
                        alignment.accept(self)
                    fi
                    if fragment.format? then
                        let format = fragment.format!
                        write(':')
                        write(format)
                    fi
                    write('}')
                else
                    emit_interpolation_literal(fragment)
                fi
            od

            _builder.end_flat()

            write(cast char(34))
        si

        emit_interpolation_literal(fragment: Expressions.INTERPOLATION_FRAGMENT) is
            let literal = cast Expressions.Literals.STRING?(fragment.expression)

            if !literal? then
                return
            fi

            _emit_literal_characters(literal.value_string, literal.location.end)
        si

        // A literal's characters, brace-escaped, split back into the
        // adjacent literals the author chained it from, each on the line the
        // author put it on.
        _emit_literal_characters(value: string, end: int) is
            let i mut = 0

            while i <= value.length do
                while
                    let b: TRIVIA.STRING_BREAK = _next_string_break(end) /\
                    b.offset == i
                do
                    write(cast char(34))

                    if b.on_new_line then
                        _builder.hard_line()
                    else
                        write(" ")
                    fi

                    write(cast char(34))
                    _consume()
                od

                if i == value.length then
                    break
                fi

                let c = value[i]

                if c == '{' then
                    write('{')
                    write('{')
                elif c == '}' then
                    write('}')
                    write('}')
                else
                    write_escape_char(c)
                fi

                i = i + 1
            od
        si

        // A numeric literal as written, its `_` digit separators put back.
        visit(integer: Expressions.Literals.INTEGER) is
            note(integer.location)
            _emit_numeric(integer.value_string, integer.location.end)
        si

        visit(float: Expressions.Literals.FLOAT) is
            note(float.location)
            _emit_numeric(float.value_string, float.location.end)
        si

        _emit_numeric(value: string, end: int) is
            let text = System.Text.StringBuilder()
            let i mut = 0

            while i <= value.length do
                while
                    _has_trivia /\
                    isa TRIVIA.DIGIT_SEPARATOR(_peek) /\
                    _peek.location.start < end /\
                    cast TRIVIA.DIGIT_SEPARATOR(_peek).offset == i
                do
                    text.append('_')
                    _consume()
                od

                if i == value.length then
                    break
                fi

                text.append(value[i])
                i = i + 1
            od

            write(text.to_string())
        si

        _next_string_break(end: int) -> TRIVIA? =>
            if _has_trivia /\ isa TRIVIA.STRING_BREAK(_peek) /\ _peek.location.start < end then
                _peek
            else
                null
            fi

        // --- faithfulness fix: the inherited write_escape_char renders
        //     control characters via string.format("X", ci), which returns
        //     the literal "X" (no placeholder), mangling e.g. '\n' to '\X'.
        //     Emit the escapes the tokenizer actually understands. ---

        write_escape_char(c: char) is
            let ci = cast int(c)

            if c == '\n' then
                write("\\")
                write('n')
            elif ci == 9 then
                write("\\")
                write('t')
            elif ci == 13 then
                write("\\")
                write('r')
            elif ci == 34 then
                write("\\")
                write(cast char(34))
            elif ci == 92 then
                write("\\\\")
            elif ci < 32 then
                write("\\u00")
                write(hex_digit((ci >> 4) & 15))
                write(hex_digit(ci & 15))
            else
                write(c)
            fi
        si

        hex_digit(n: int) -> char is
            if n < 10 then
                return cast char(cast int('0') + n)
            fi

            return cast char(cast int('A') + n - 10)
        si

        // --- faithfulness fix: a plain string literal loses its brace
        //     escaping. `{{` written back as `{` opens an interpolation on
        //     the next parse. The interpolated path doubles braces
        //     (emit_interpolation_literal); the plain path must agree. ---

        visit(string: Expressions.Literals.STRING) is
            note(string.location)
            write(cast char(34))
            _emit_literal_characters(string.value_string, string.location.end)
            write(cast char(34))
        si

        // --- faithfulness fix: a character literal's quote must stay
        //     escaped - `'\''` written back as `'''` is reported as a
        //     zero-length literal - and a double quote needs no escape in
        //     this context, where the inherited write_escape_char (which
        //     carries the string literal's rules) adds one. ---

        visit(character: Expressions.Literals.CHARACTER) is
            note(character.location)
            write("'")

            let c = character.value_string[0]

            if c == '\'' then
                write("\\'")
            elif c == cast char(34) then
                write(c)
            else
                write_escape_char(c)
            fi

            write("'")
        si

        // --- faithfulness fix: a prefix operator is written tight against
        //     its operand. The inherited visit spaces it (`! x`), which is
        //     a faithfulness change on every reformat; a line-start
        //     operator is significant to boundary inference, so the
        //     spacing must not drift. ---

        visit(unary: Expressions.UNARY) is
            note(unary.location)
            unary.operation.accept(self)

            // Operator characters run together into one operator, so an
            // operand that itself starts with one - a `*` placeholder, a
            // nested prefix operator - is kept apart from the operator.
            if isa Expressions.PLACEHOLDER(unary.right) \/ isa Expressions.UNARY(unary.right) then
                write(' ')
            fi

            unary.right.accept(self)
        si

        // --- faithfulness fix: the inherited expression-list emitter
        //     writes `,` with no following space, so a tuple literal comes
        //     back as `(a,b)`. ---

        visit(expressions: Expressions.LIST) is
            note(expressions.location)

            let seen_any mut = false

            for e in expressions do
                if seen_any then
                    write(", ")
                fi
                e.accept(self)
                seen_any = true
            od

            if expressions.has_trailing_comma then
                write(',')
            fi
        si

        // --- faithfulness fix: a postfix type constructor applied to a
        //     function type binds to that function's *result*, so
        //     `(() -> T)?` written back without its parens is `() -> T?`,
        //     a function returning an optional. Parenthesise the operand
        //     whenever it is a function type. ---

        visit(optional: TypeExpressions.OPTIONAL) is
            note(optional.location)
            emit_type_operand(optional.element)
            write("?")
        si

        visit(array: TypeExpressions.ARRAY_) is
            note(array.location)
            emit_type_operand(array.element)
            write("[]")
        si

        visit(iterable: TypeExpressions.ITERABLE) is
            note(iterable.location)
            emit_type_operand(iterable.element)
            write("{{}}")
        si

        visit(pointer: TypeExpressions.POINTER) is
            note(pointer.location)
            emit_type_operand(pointer.element)
            write(" ptr")
        si

        visit(reference: TypeExpressions.REFERENCE) is
            note(reference.location)
            emit_type_operand(reference.element)
            write(" ref")
        si

        emit_type_operand(element: TypeExpressions.TypeExpression) is
            if isa TypeExpressions.FUNCTION(element) then
                write("(")
                element.accept(self)
                write(")")
                return
            fi

            element.accept(self)
        si

        // --- faithfulness fix: a VARIABLE carries three optional pieces
        //     the inherited printer never emits — the `..` splice marker
        //     (only inside a secondary `init` formal-arg list), the
        //     trailing `mut` keyword (set by the parser when source had
        //     `mut`), and a trailing modifier suffix list (only on
        //     primary-ctor parameter declarations, where `public`,
        //     `field`, and `init` describe the auto-generated body
        //     member). ---

        // A lambda parameter written as a destructure group has a synthesised
        // name - the source names only the leaves - and the group itself is on
        // `left`. Printing the name hands back `$destructured_argument`, which
        // is not what was written and does not parse.
        visit(variable: Expressions.VARIABLE) is
            emit_parameter_pragmas(variable.pragmas)

            if variable.is_synthesized /\ variable.left? then
                variable.left.accept(self)
            else
                variable.name.accept(self)
            fi

            let type_expression = variable.type_expression

            if !isa TypeExpressions.INFER(type_expression) /\ !_strip("parameter", variable.location, "type", type_expression.location, type_expression.location) then
                write(": ")
                type_expression.accept(self)
            elif let annotation = _annotation(a => a.parameter_type(variable.location)) then
                write(": {annotation}")
            fi

            if !variable.is_synthesized /\ variable.initializer? then
                write(" = ")
                variable.initializer!.accept(self)
            fi
        si

        visit(variable: Variables.VARIABLE) is
            note(variable.location)

            if variable.is_splice then
                write("..")
                return
            fi

            emit_parameter_pragmas(variable.pragmas)

            variable.left.accept(self)

            let variable_type_expression = variable.type_expression

            if !isa TypeExpressions.INFER(variable_type_expression) /\ !(_in_let /\ _strip("local", variable.location, "type", variable_type_expression.location, variable_type_expression.location)) then
                write(": ")
                variable_type_expression.accept(self)
            elif let annotation = _annotation(a => a.local_type(variable.location)) then
                write(": {annotation}")
            fi

            if variable.is_mutable_marked then
                write(" mut")
            fi

            if let variable.modifiers? /\ !modifiers.is_empty then
                write(" ")
                emit_modifiers(modifiers)
            fi

            let initializer = variable.initializer
            if initializer? then
                write(" ")
                emit_right_hand_side("=", initializer)
            fi
        si

        visit(element: Expressions.TUPLE_ELEMENT) is
            note(element.location)
            element.name.accept(self)

            let type_expression = element.type_expression

            if !isa TypeExpressions.INFER(type_expression) then
                write(": ")
                type_expression.accept(self)
            fi

            if let element.initializer? then
                write(" ")
                emit_right_hand_side("=", initializer)
            fi
        si

        visit(assign: Statements.ASSIGNMENT) is
            note(assign.location)
            assign.left.accept(self)
            write(" ")
            emit_right_hand_side("=", assign.right)
            write_terminator()
        si

        visit(expression: Bodies.EXPRESSION) is
            emit_right_hand_side("=>", expression.expression)
        si

        // The right-hand side of `=>` or `=`. One that opens with a bracket
        // stays on the line and breaks inside its own brackets; any other
        // moves to the next line, one level in, when it does not fit.
        emit_right_hand_side(operator: string, expression: Expressions.Expression) is
            write(operator)

            // The body of a function literal that hugs its call moves to the
            // next line before it breaks inside its own brackets, and the
            // call's closer then takes a line of its own.
            let hugged = _hugged_body_group
            _hugged_body_group = 0

            if _opens_with_bracket(expression) /\ (hugged == 0 \/ _is_bracket_literal(expression)) then
                write(" ")
                expression.accept(self)
                return
            fi

            _builder.begin_group()
            _builder.begin_nest(4)
            _builder.line()
            expression.accept(self)
            _builder.end_nest()

            if hugged != 0 then
                _builder.end_tracked_group(hugged)
            else
                _builder.end_group()
            fi
        si

        // Set while a hugged function literal's body is being written: the
        // id of the group that body's line break belongs to.
        _hugged_body_group: int

        // A literal written between brackets of its own: a block, an array
        // literal, a comprehension, a tuple.
        _is_bracket_literal(e: Expressions.Expression) -> bool =>
            if let tuple: Expressions.TUPLE = e then
                tuple.elements.count > 1
            else
                _opens_broken_bracket(e)
            fi

        // A name, plain or qualified, with any type arguments.
        _is_name(e: Expressions.Expression) -> bool =>
            if let member: Expressions.MEMBER = e then
                _is_name(member.left)
            elif let generic: Expressions.GENERIC_APPLICATION = e then
                if let generic.left? then _is_name(left) else true fi
            elif let ambiguous: Expressions.AMBIGUOUS_EXPRESSION = e then
                if let ambiguous.left? then _is_name(left) else true fi
            else
                isa Expressions.IDENTIFIER(e) \/ isa Expressions.SELF(e) \/ isa Expressions.SUPER(e)
            fi

        _opens_with_bracket(expression: Expressions.Expression) -> bool =>
            if let call: Expressions.CALL = expression then
                // A pipe chain whose head is a bracketed literal opens with
                // that bracket, and stays on the line as the literal would.
                if _is_pipe_stage(call) then
                    _is_bracket_literal(_pipe_head(call))
                else
                    // Only a call of a name: one on a longer receiver, such
                    // as a string literal, moves to the next line instead.
                    _is_name(call.function)
                fi
            else
                isa Expressions.VAL_BLOCK(expression) \/
                    isa Expressions.TUPLE(expression) \/
                    isa Expressions.SEQUENCE(expression) \/
                    isa Expressions.COMPREHENSION(expression) \/
                    isa Expressions.CONSTRUCT(expression) \/
                    isa Expressions.FUNCTION(expression)
            fi

        // --- faithfulness fix: a body-less property (a field) is terminated
        //     with `;` and a newline, which the plain printer omits ---

        visit(property: Definitions.PROPERTY) is
            if property.name? then
                property.name.accept(self)
            fi

            let property_type_expression = property.type_expression

            if !isa TypeExpressions.INFER(property_type_expression) then
                write(": ")
                property_type_expression.accept(self)
            fi

            if !property.modifiers.is_empty then
                write(" ")
                emit_modifiers(property.modifiers)
            fi

            if !property.read_body? /\ !property.assign_body? then
                write_terminator()
                return
            fi

            let out_again =
                indent_property(
                    property.read_body? /\ !_has_no_written_body(property.read_body),
                    property.assign_body?
                )

            if property.read_body? then
                property.read_body.accept(self)
                if property.assign_body? then
                    write_line(",")
                else
                    after_body(property.read_body!)
                fi
            else
                write(" ")
            fi

            if property.assign_body? then
                write("= ")
                property.assign_argument!.accept(self)
                // The block body opens with `is`, written directly after
                // whatever precedes it. The argument does not end in a
                // space, so without one here the keyword runs onto it -
                // `= valueis` - and the result no longer parses.
                if !at_line_start then
                    write(" ")
                fi
                property.assign_body!.accept(self)
                after_body(property.assign_body!)
            fi

            if out_again then
                outdent()
            fi
        si

        // Emit modifiers without the trailing space the inherited
        // Modifiers.LIST visit appends (which would strand a space before a
        // following `;`).
        emit_modifiers(modifiers: Modifiers.LIST) is
            let first mut = true

            if let modifiers.access_modifier? then
                access_modifier.accept(self)
                first = false
            fi

            if let modifiers.storage_class? then
                if !first then
                    write(" ")
                fi
                storage_class.accept(self)
                first = false
            fi

            if modifiers.is_abstract then
                if !first then
                    write(" ")
                fi
                write("abstract")
                first = false
            fi

            if modifiers.is_pure then
                if !first then
                    write(" ")
                fi
                write("pure")
                first = false
            fi

            if modifiers.is_stable then
                if !first then
                    write(" ")
                fi
                write("stable")
                first = false
            fi

            if modifiers.is_memo then
                if !first then
                    write(" ")
                fi
                write("memo")
                first = false
            fi
        si

        // --- wrapping: call argument lists and function parameter lists ---

        // A pipe stage is not noted itself: its span can start on a later
        // line than its head's, and noting it first would mark the lines
        // the head has yet to write as already passed.
        visit(call: Expressions.CALL) is
            if _is_pipe_stage(call) then
                _builder.begin_group()
                _emit_pipe_chain(call)
                _builder.end_group()
            else
                note(call.location)
                emit_callee(call.function)
                emit_inferred_type_arguments(call.function)
                write("(")
                emit_argument_list(call.arguments, 0, call.argument_names)
                write(")")
            fi
        si

        _is_pipe_stage(call: Expressions.CALL) -> bool =>
            call.is_thread_first /\ call.arguments.count >= 1

        // A chain of `|>` and `~>` stages is one breaking unit: broken, each
        // stage starts its own line with its operator, one level in from the
        // chain's head.
        _pipe_head(call: Expressions.CALL) -> Expressions.Expression =>
            if let stage: Expressions.CALL = call.arguments.expressions[0] /\ _is_pipe_stage(stage) then
                _pipe_head(stage)
            else
                call.arguments.expressions[0]
            fi

        _emit_pipe_chain(call: Expressions.CALL) is
            let stages = LIST[Expressions.CALL]()
            let head: Expressions.Expression mut = call

            while let stage: Expressions.CALL = head /\ _is_pipe_stage(stage) do
                stages.insert(0, stage)
                head = stage.arguments.expressions[0]
            od

            // The head is outside the stages' indent, so a head that breaks
            // inside its own brackets lays them out at the chain's indent.
            head.accept(self)

            _builder.begin_nest(4)

            for stage in stages do
                _builder.line()
                write(if stage.propagates_absence then "~> " else "|> " fi)
                emit_callee(stage.function)
                emit_inferred_type_arguments(stage.function)
                write("(")
                emit_argument_list(stage.arguments, 1)
                write(")")
            od

            _builder.end_nest()
        si

        // A callee that writes its own type arguments prints without
        // them when the stripper takes that site.
        // A single type argument parses as an index until the build
        // decides, so that shape arrives as the ambiguous node.
        emit_callee(callee: Expressions.Expression) is
            if let generic: Expressions.GENERIC_APPLICATION = callee /\ _strip("type-arguments", callee.location, "after", generic.identifier.location, callee.location) then
                if let generic.left? then
                    left.accept(self)
                    write(".")
                fi

                generic.identifier.accept(self)
            elif let ambiguous: Expressions.AMBIGUOUS_EXPRESSION = callee /\ _names_a_type(_bracketed(ambiguous.index)) /\ _strip("type-arguments", callee.location, "after", ambiguous.identifier.location, callee.location) then
                if let ambiguous.left? then
                    left.accept(self)
                    write(".")
                fi

                ambiguous.identifier.accept(self)
            else
                callee.accept(self)
            fi
        si

        // What an ambiguous bracket holds: the node keeps the whole indexing
        // expression, whose own index is the bracket's content.
        _bracketed(index: Expressions.Expression) -> Expressions.Expression =>
            if let indexed: Expressions.INDEX = index then indexed.index else index fi

        // Whether an ambiguous bracket's content is a type rather than an
        // index: a capitalised or qualified name, or a primitive's.
        _names_a_type(index: Expressions.Expression) -> bool is
            if let identifier: Expressions.IDENTIFIER = index then
                let name = identifier.identifier.name

                char.is_upper(name[0]) \/
                    ["int", "string", "bool", "double", "char", "object", "single", "long", "byte", "short", "decimal", "bigint", "uint", "ulong", "ubyte", "ushort", "word", "uword", "void"]
                        |> Ghul.Pipes.any(p => p =~ name)
            elif isa Expressions.MEMBER(index) then
                true
            else
                false
            fi
        si

        emit_inferred_type_arguments(callee: Expressions.Expression) is
            // Only a bare or qualified name: a callee that writes its own
            // type arguments parses as something else.
            if !isa Expressions.IDENTIFIER(callee) /\ !isa Expressions.MEMBER(callee) then
                return
            fi

            if let arguments = _annotation(a => a.type_arguments(callee.location)) then
                write("[")
                write(arguments)
                write("]")
            fi
        si

        visit(function: Definitions.FUNCTION) is
            if let function.name? then
                name.accept(self)
            fi

            if _has_type_arguments(function.generic_arguments) then
                write("[")
                function.generic_arguments.accept(self)
                write("]")
            fi

            write("(")
            emit_parameter_list(function.arguments)
            write(")")

            let function_type_expression = function.type_expression

            if !isa TypeExpressions.INFER(function_type_expression) then
                write(" -> ")
                function_type_expression.accept(self)
            fi

            if !function.modifiers.is_empty then
                write(" ")
                emit_modifiers(function.modifiers)
            fi

            let body = function.body

            if body? /\ !_has_no_written_body(body) then
                write(" ")
                body.accept(self)
            fi

            after_body(body)
        si

        emit_parameter_list(parameters: Variables.LIST) is
            if !_has_parameters(parameters) then
                return
            fi

            _builder.begin_group()
            _builder.begin_nest(4)
            _builder.soft_line()

            let first mut = true
            for p in parameters do
                if !first then
                    _builder.text(",")
                    _builder.line()
                fi
                p.accept(self)
                first = false
            od

            _builder.end_nest()
            _builder.soft_line()
            _builder.end_group()
        si

        _has_parameters(parameters: Variables.LIST?) -> bool is
            if !parameters? then
                return false
            fi
            for p in parameters do
                return true
            od
            return false
        si

        _has_type_arguments(arguments: TypeExpressions.LIST?) -> bool is
            if !arguments? then
                return false
            fi
            for a in arguments do
                return true
            od
            return false
        si

        // --- faithfulness fix: a NAMED_TUPLE_ELEMENT in type-parameter
        //     position can carry up to four pieces of constraint syntax
        //     past its name:type slot — the trailing kind keyword after a
        //     type bound (`[T: A class]`), an `init` ctor constraint, and a
        //     trailing `in` / `out` variance. The inherited visit emits
        //     only `name: type_expression`, dropping the other three.
        //     The `[T: out]` variance-only form also needs its
        //     TYPE_PARAMETER_CONSTRAINT(NONE) placeholder suppressed
        //     (the inherited path renders it as `?`). ---

        visit(element: TypeExpressions.NAMED_TUPLE_ELEMENT) is
            note(element.location)
            element.name.accept(self)
            write(": ")

            let constraint = cast TypeExpressions.TYPE_PARAMETER_CONSTRAINT?(element.type_expression)
            let is_placeholder =
                constraint? /\
                constraint.kind == Semantic.Symbols.TypeParameterConstraintKind.NONE
            let need_separator mut = false

            if !is_placeholder then
                element.type_expression.accept(self)
                need_separator = true
            fi

            for bound in element.additional_bounds do
                write(" /\\ ")
                bound.accept(self)
            od

            if element.combined_kind != Semantic.Symbols.TypeParameterConstraintKind.NONE then
                if need_separator then
                    write(" ")
                fi
                write(_constraint_kind_keyword(element.combined_kind))
                need_separator = true
            fi

            if element.has_constructor then
                if need_separator then
                    write(" ")
                fi
                write("init")
                need_separator = true
            fi

            if element.variance == Semantic.Types.TypeVariance.COVARIANT then
                if need_separator then
                    write(" ")
                fi
                write("out")
            elif element.variance == Semantic.Types.TypeVariance.CONTRAVARIANT then
                if need_separator then
                    write(" ")
                fi
                write("in")
            fi
        si

        _constraint_kind_keyword(kind: Semantic.Symbols.TypeParameterConstraintKind) -> string is
            if kind == Semantic.Symbols.TypeParameterConstraintKind.REFERENCE then
                return "class"
            elif kind == Semantic.Symbols.TypeParameterConstraintKind.VALUE then
                return "struct"
            elif kind == Semantic.Symbols.TypeParameterConstraintKind.OPTIONAL then
                return "optional"
            fi
            return ""
        si

        emit_argument_list(arguments: Expressions.LIST) is
            emit_argument_list(arguments, 0)
        si

        emit_argument_list(arguments: Expressions.LIST, start: int) is
            emit_argument_list(arguments, start, null)
        si

        // Attributes written before a parameter stay on its own line.
        emit_parameter_pragmas(pragmas: Collections.LIST[Pragmas.PRAGMA]?) is
            if !pragmas? then
                return
            fi

            for pragma in pragmas do
                pragma.accept(self)
                write(" ")
            od
        si

        // `names`, when the call used named-argument syntax, runs parallel
        // to `arguments`: the parser moved each value into the list and
        // kept the name beside it.
        emit_argument_list(arguments: Expressions.LIST, start: int, names: Collections.List[Identifiers.Identifier]?) is
            emit_argument_list(arguments, start, names, true)
        si

        // `hug` is for a call's arguments and a tuple's elements: the
        // elements of an array literal break one per line as written.
        emit_argument_list(arguments: Expressions.LIST, start: int, names: Collections.List[Identifiers.Identifier]?, hug: bool) is
            if arguments.count <= start then
                return
            fi

            let last = arguments.count - 1

            // A last argument that opens a bracket of its own - an array
            // literal, a block - or is a function literal hugs the call when
            // it breaks: `f([` ... `])`, `map(x => (` ... `))`, `any(x =>`
            // with the body on the next line. The arguments before it stay on
            // the call's line.
            if hug /\ !arguments.has_trailing_comma /\ _hugs(arguments.expressions[last]) then
                _builder.begin_group()
                _builder.begin_nest(4)

                for i in start..last do
                    _emit_argument(arguments, i, names)
                    _builder.text(",")
                    _builder.line()
                od

                _builder.end_nest()
                _builder.end_group()

                let lambda_body = _hugged_lambda_body(arguments.expressions[last])

                if lambda_body then
                    _hugged_body_group = _builder.new_group_id()
                fi

                let body_group = _hugged_body_group

                _emit_argument(arguments, last, names)

                if lambda_body then
                    _builder.emit(DOC.IF_BROKEN(body_group, DOC.HARD_LINE(), DOC.NIL()))
                fi

                return
            fi

            _builder.begin_group()
            _builder.begin_nest(4)
            _builder.soft_line()

            let first mut = true
            for i in start..arguments.count do
                if !first then
                    _builder.text(",")
                    _builder.line()
                fi

                _emit_argument(arguments, i, names)
                first = false
            od

            // Written hard against the argument it trails, inside the nest,
            // so a broken layout puts it at the end of that argument's line
            // and leaves the closing bracket on its own.
            if arguments.has_trailing_comma then
                _builder.text(",")
            fi

            _builder.end_nest()
            _builder.soft_line()
            _builder.end_group()
        si

        _emit_argument(arguments: Expressions.LIST, i: int, names: Collections.List[Identifiers.Identifier]?) is
            if names? /\ i < names.count then
                names[i].accept(self)
                write(" = ")
            fi

            arguments.expressions[i].accept(self)
        si

        _hugs(argument: Expressions.Expression) -> bool =>
            isa Expressions.FUNCTION(argument) \/ _opens_broken_bracket(argument)

        // A hugged function literal whose body is an expression other than a
        // bracket the call already hugs: its body moves to the next line,
        // and the call's closer below it, when it does not fit.
        _hugged_lambda_body(argument: Expressions.Expression) -> bool =>
            if let function: Expressions.FUNCTION = argument then
                if let expression: Bodies.EXPRESSION = function.body then
                    !_is_bracket_literal(expression.expression)
                else
                    false
                fi
            else
                false
            fi

        _opens_broken_bracket(e: Expressions.Expression) -> bool =>
            if let block: Expressions.VAL_BLOCK = e then
                block.is_parenthesised
            elif let sequence: Expressions.SEQUENCE = e then
                sequence.elements.count > 0
            elif isa Expressions.COMPREHENSION(e) then
                true
            else
                false
            fi

        // Several variables in one `let` break one per line, each after the
        // first one level in.
        visit(variables: Variables.LIST) is
            note(variables.location)

            if variables |> Ghul.Pipes.count() <= 1 then
                for v in variables do
                    v.accept(self)
                od

                return
            fi

            _builder.begin_group()
            _builder.begin_nest(4)

            let first mut = true
            for v in variables do
                if !first then
                    write(",")
                    _builder.line()
                fi
                v.accept(self)
                first = false
            od

            _builder.end_nest()
            _builder.end_group()
        si

        // A tuple type breaks as an argument list does.
        visit(tuple: TypeExpressions.TUPLE) is
            note(tuple.location)
            write("(")

            _builder.begin_group()
            _builder.begin_nest(4)
            _builder.soft_line()

            let first mut = true
            for e in tuple.elements do
                if !first then
                    write(",")
                    _builder.line()
                fi
                e.accept(self)
                first = false
            od

            _builder.end_nest()
            _builder.soft_line()
            _builder.end_group()

            write(")")
        si

        // A comprehension that does not fit puts its brackets on lines of
        // their own, with the element and each `for` and `if` clause on a
        // line one level in between them.
        visit(comprehension: Expressions.COMPREHENSION) is
            note(comprehension.location)

            write(if comprehension.is_lazy then "{{" else "[" fi)

            _builder.begin_group()
            _builder.begin_nest(4)
            _builder.soft_line()

            comprehension.element.accept(self)

            let clause: Expressions.COMPREHENSION_CLAUSE? mut = comprehension.first

            while let c = clause do
                _builder.line()

                if let f: Expressions.COMPREHENSION_FOR = c then
                    write("for ")
                    f.variable.accept(self)
                    write(" in ")
                    f.source.accept(self)
                elif let i: Expressions.COMPREHENSION_IF = c then
                    write("if ")
                    i.condition.accept(self)
                fi

                clause = c.inner
            od

            _builder.end_nest()
            _builder.soft_line()
            _builder.end_group()

            write(if comprehension.is_lazy then "}}" else "]" fi)

            let type_expression = comprehension.type_expression

            if !isa Trees.TypeExpressions.INFER(type_expression) then
                write(": ")
                type_expression.accept(self)
            fi
        si

        // A tuple breaks as an argument list does, and so does a single
        // element in parentheses, which is a parenthesised expression. A
        // tuple of literals and names is filled, as such an array is.
        visit(tuple: Expressions.TUPLE) is
            note(tuple.location)
            write("(")

            if tuple.elements.count > 1 /\ tuple.elements |> Ghul.Pipes.all(e => _is_simple_element(e)) then
                _emit_filled(tuple.elements)
            elif tuple.elements.count == 1 /\ !tuple.elements.has_trailing_comma then
                _builder.begin_group()
                _builder.begin_nest(4)
                _builder.soft_line()
                tuple.elements.expressions[0].accept(self)
                _builder.end_nest()
                _builder.soft_line()
                _builder.end_group()
            else
                emit_argument_list(tuple.elements, 0, null, true)
            fi

            write(")")
        si

        // An array literal written on one line breaks as an argument list
        // does. One written over several lines keeps the author's rows -
        // a board, a matrix, a lookup table - with the brackets on lines of
        // their own; each row breaks one element per line only if it does
        // not fit.
        visit(sequence: Expressions.SEQUENCE) is
            note(sequence.location)

            let elements = sequence.elements

            write("[")

            if elements.count == 0 then
                write("]")
            elif sequence.location.start_line == sequence.location.end_line then
                if elements |> Ghul.Pipes.all(e => _is_simple_element(e)) then
                    _emit_filled(elements)
                else
                    emit_argument_list(elements, 0, null, false)
                fi

                write("]")
            else
                _emit_sequence_rows(elements)
                write_line()
                write("]")
            fi

            let type_expression = sequence.type_expression

            if !isa Trees.TypeExpressions.INFER(type_expression) then
                write(": ")
                type_expression.accept(self)
            fi
        si

        // Literals and names: short and alike, so a list of them that does
        // not fit is filled rather than run down the page one per line.
        _is_simple_element(e: Expressions.Expression) -> bool =>
            if let unary: Expressions.UNARY = e then
                isa Expressions.Literals.Literal(unary.right)
            elif let element: Expressions.TUPLE_ELEMENT = e then
                if let element.initializer? then _is_simple_element(initializer) else true fi
            else
                isa Expressions.Literals.Literal(e) \/
                    isa Expressions.IDENTIFIER(e) \/
                    isa Expressions.MEMBER(e)
            fi

        // Broken, the brackets take lines of their own and the elements
        // between them are filled: as many on each line as fit.
        _emit_filled(elements: Expressions.LIST) is
            _builder.begin_group()
            _builder.begin_nest(4)
            _builder.soft_line()

            let first mut = true

            for e in elements do
                if first then
                    e.accept(self)
                else
                    write(",")
                    _builder.begin_group()
                    _builder.line()
                    e.accept(self)
                    _builder.end_group()
                fi

                first = false
            od

            if elements.has_trailing_comma then
                write(",")
            fi

            _builder.end_nest()
            _builder.soft_line()
            _builder.end_group()
        si

        // Each row the author wrote starts a line of its own. A row too
        // long for the width is filled: as many elements as fit on each
        // line, the rest carried on to the next.
        _emit_sequence_rows(elements: Expressions.LIST) is
            _builder.begin_nest(4)

            let previous: Expressions.Expression? mut = null

            for e in elements do
                if let p = previous then
                    write(",")

                    if e.location.start_line > p.location.end_line then
                        write_line()
                        flush_leading(e.location.start)
                        e.accept(self)
                    else
                        _builder.begin_group()
                        _builder.line()
                        e.accept(self)
                        _builder.end_group()
                    fi
                else
                    write_line()
                    flush_leading(e.location.start)
                    e.accept(self)
                fi

                previous = e
            od

            if elements.has_trailing_comma then
                write(",")
            fi

            _builder.end_nest()
        si

        _has_arguments(arguments: Expressions.LIST) -> bool is
            for a in arguments do
                return true
            od
            return false
        si
    si
si
