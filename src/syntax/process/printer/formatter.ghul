namespace Syntax.Process.Printer is
    use Collections
    use Ghul

    use Trees
    use Source

    use Lexical.TRIVIA

    // The ghūl code formatter.
    //
    // Extends the plain GHUL printer (which the diagnostics path uses via
    // Node.to_string and must not be disturbed) and redirects its output
    // primitives into a DOC tree, so DOC_RENDERER can lay the result out
    // against a column budget. Comments and blank lines collected by the
    // tokenizer as TRIVIA are interleaved back in by source position.
    //
    // Selected visits are overridden to introduce soft breaks (GROUP/LINE)
    // where wrapping should happen; everything else inherits the printer's
    // structural layout unchanged.
    class FORMATTER: GHUL is
        _builder: DOC_BUILDER
        _width: int

        // Types a build settled at inferred sites, written in where the
        // source left them out. Null prints the source as written.
        annotations: InferredAnnotations? public

        _annotation(lookup: (InferredAnnotations) -> string?) -> string? =>
            if let a = annotations then lookup(a) else null fi

        // Written annotations to leave out, so the source is printed with
        // less than its author wrote. Null prints every annotation.
        stripper: ANNOTATION_STRIPPER? public

        // Whether the variable being printed is a `let` local: the only
        // kind of Variables.VARIABLE whose type is an annotation rather
        // than a signature.
        _in_let: bool

        _strip(kind: string, location: Source.LOCATION, mode: string, from: Source.LOCATION, to: Source.LOCATION) -> bool =>
            if let s = stripper then s.strip(kind, location, mode, from, to) else false fi

        strip_cast_target(`cast: Trees.Expressions.CAST, type_expression: Trees.TypeExpressions.TypeExpression) -> bool =>
            _strip("cast", `cast.location, "type", type_expression.location, type_expression.location)

        _trivia: LIST[TRIVIA]
        _trivia_index: int

        // Source line of the furthest content emitted so far. Drives
        // trailing-comment detection: a comment starting on a line we have
        // already passed trails that line rather than leading the next node.
        _last_line: int

        // True between opening a block and emitting its first real content;
        // suppresses a blank line immediately inside a block.
        _at_block_start: bool

        // True when nothing has been written since the last line break. A
        // statement whose rendering ends in a block terminator - `od`, `esac` -
        // leaves the line open, and the statement after it must not be run onto
        // the same line.
        _at_line_start: bool

        // True while inside a union that declared a primary-constructor
        // header. Variants emitted under this flag can drop a sole
        // `(..)` field list — the rewriter implicitly splices the primary
        // params for a variant with no field list. Without a primary
        // header, a sole `..` is a hard error, and dropping the parens
        // would silently turn the error into valid empty-fields source.
        _union_has_primary_params: bool

        init(trivia: Iterable[TRIVIA]?, width: int) is
            super.init()

            _width = width
            _builder = DOC_BUILDER()

            _trivia = LIST[TRIVIA]()
            if trivia? then
                for t in trivia do
                    _trivia.add(t)
                od
            fi
        si

        // Format a parsed file (or any node) and return the rendered text.
        format(node: Node) -> string is
            node.accept(self)
            flush_remaining()

            let text = DOC_RENDERER(_width).render(_builder.build())

            // Strip trailing whitespace from every line (blank lines pick up
            // indentation from the renderer), then settle each terminator.
            let lines = Collections.LIST[string]()

            for line in text.split(['\n']) do
                lines.add(line.trim_end())
            od

            _settle_terminators(lines)

            let result = System.Text.StringBuilder()
            let first mut = true
            for line in lines do
                if !first then
                    result.append('\n')
                fi
                result.append(line)
                first = false
            od

            return "{result.to_string().trim_end()}\n"
        si

        // A statement terminator is written as this marker rather than as
        // `;`, because whether it is needed depends on what follows it,
        // which is not known when the statement is emitted.
        // _settle_terminators resolves every one of them once the text has
        // been laid out.
        // A control character, so it cannot occur in the source being
        // formatted. Held and searched for as a `char`: `index_of(string)`
        // compares by culture, under which a control character has no
        // collation weight and so matches at the start of any string at
        // all, while the `char` overload compares ordinally.
        TERMINATOR_MARKER: char static => cast char(1)

        write_terminator() is
            write(TERMINATOR_MARKER)
            write_line()
        si

        // A line break stands in for a statement terminator, so a marker
        // that nothing but a comment follows is dropped. The exception is
        // the one terminator that carries meaning: adjacent string literals
        // chain into a single literal across a line break, so a statement
        // ending on one and followed by a statement starting with one keeps
        // its `;`. A marker with code after it separates two statements on
        // one line and is kept.
        _settle_terminators(lines: Collections.LIST[string]) is
            let i mut = 0

            while i < lines.count do
                let line = lines[i]
                let at = line.index_of(TERMINATOR_MARKER)

                if at >= 0 then
                    let before = line[0..at]
                    let after = line[at + 1..<0]

                    let keep =
                        !_is_only_a_comment(after) \/
                            (_ends_with_string(before) /\
                                _next_line_starts_with_string(lines, i))

                    lines[i] = if keep then "{before};{after}" else "{before}{after}" fi
                fi

                i = i + 1
            od
        si

        // Whether the rest of a line, after a terminator marker, is nothing
        // but whitespace and a comment - in which case the line break is
        // what ends the statement.
        _is_only_a_comment(rest: string) -> bool is
            let trimmed = rest.trim()

            if trimmed.length == 0 \/ trimmed.starts_with("//") then
                return true
            fi

            return
                trimmed.starts_with("/*") /\
                trimmed.ends_with("*/") /\
                trimmed.index_of("*/") == trimmed.length - 2
        si

        _ends_with_string(line: string) -> bool is
            let trimmed = line.trim_end()

            return trimmed.length > 0 /\ trimmed[trimmed.length - 1] == cast char(34)
        si

        // Comments are transparent to string chaining, so a comment line
        // between the two literals does not break the chain and is looked
        // through here too - a block comment as well as a line comment.
        //
        // A line this cannot classify - the opening line of a block comment
        // that runs on, say - is answered as though a literal followed.
        // The two errors are not equal: a terminator written where none was
        // needed costs a warning, while one dropped where it was needed
        // merges two literals into one and changes what the program says.
        _next_line_starts_with_string(lines: Collections.LIST[string], from: int) -> bool is
            let i mut = from + 1

            while i < lines.count do
                let candidate = lines[i].trim()

                if candidate.length == 0 \/ _is_only_a_comment(candidate) then
                    i = i + 1
                elif candidate.starts_with("/*") then
                    return true
                else
                    return candidate[0] == cast char(34)
                fi
            od

            return false
        si

        // --- output primitives, redirected into the DOC builder ---

        write(value: string?) is
            if !value? then
                return
            fi

            if value.length > 0 then
                _at_block_start = false
                _at_line_start = false
            fi

            _builder.text(value)
        si

        write(c: char) is
            _at_block_start = false
            _at_line_start = false
            _builder.text("{c}")
        si

        // A name that collides with a keyword, or that would tokenise as a
        // number, only reached the tree via a backtick escape; the inherited
        // printer drops the backtick and the result no longer re-parses.
        // Restore it. Operator names are left to visit(Expressions.IDENTIFIER):
        // they must stay bare in definition and binary-operation positions,
        // which route through here too.
        write_name(name: string) is
            if Lexical.TOKENIZER.is_reserved_word(name) \/ Lexical.TOKENIZER.is_numeric_identifier(name) then
                write('`')
            fi
            write(name)
        si

        // An operator referred to as a plain value, rather than applied,
        // reached the tree via a backtick escape and must keep it to re-parse
        // as an identifier rather than an operator. This is the one identifier
        // position where an operator escapes; definition names and binary
        // operations render the operator bare through the inherited visits.
        visit(identifier: Expressions.IDENTIFIER) is
            location(identifier)
            let inner = identifier.identifier
            if !inner.is_qualified /\ Lexical.TOKENIZER.is_operator_name(inner.name) then
                write('`')
                write(inner.name)
            else
                inner.accept(self)
            fi
        si

        at_line_start: bool => _at_line_start

        write_line() is
            flush_trailing_comments()
            _builder.hard_line()
            _at_line_start = true
        si

        indent() is
            _builder.begin_nest(4)
            _at_block_start = true
        si

        outdent() is
            _builder.end_nest()
        si

        write_indent() is si

        // --- line tracking ---

        location(location: LOCATION) is
            note(location)
        si

        note(location: LOCATION?) is
            if location? /\ location.start_line > _last_line then
                _last_line = location.start_line
            fi
        si

        // --- trivia interleaving ---

        _has_trivia: bool => _trivia_index < _trivia.count

        // Whether any unemitted trivia still sits before `limit` (a
        // LOCATION.start value). A body with none can take a one-line
        // rendering, since there is no comment to keep inside it.
        _has_trivia_before(limit: int) -> bool =>
            _has_trivia /\ _peek.location.start < limit

        _peek: TRIVIA => _trivia[_trivia_index]

        _consume() is
            _trivia_index = _trivia_index + 1
        si

        // Emit any trivia positioned strictly before `limit` (a LOCATION.start
        // value) that is not a trailing comment of an already-emitted line.
        flush_leading(limit: int) is
            while _has_trivia /\ _peek.location.start < limit do
                let t = _peek

                if isa TRIVIA.BLANK_LINE(t) then
                    // A blank line written inside an expression the layout
                    // joins onto one line has nowhere to go, and emitting it
                    // here puts it after the whole construct instead - one
                    // more blank line on every reformat. Its source line has
                    // already been passed, which is what distinguishes it
                    // from a blank line genuinely separating two constructs.
                    if !_at_block_start /\ _peek.location.start_line > _last_line then
                        _builder.hard_line()
                    fi
                    _consume()
                else
                    emit_comment(t)
                    _builder.hard_line()
                    _at_block_start = false
                    _consume()
                fi
            od
        si

        // Emit comments that start on a line we have already emitted: they
        // trail that line. Called from write_line, before the newline.
        flush_trailing_comments() is
            while
                _has_trivia /\
                _is_comment(_peek) /\
                _peek.location.start_line <= _last_line
            do
                _builder.text(" ")
                emit_comment(_peek)
                _consume()
            od
        si

        // Emit everything left over (file-trailing comments).
        flush_remaining() is
            while _has_trivia do
                let t = _peek
                if _is_comment(t) then
                    emit_comment(t)
                    _builder.hard_line()
                fi
                _consume()
            od
        si

        _is_comment(t: TRIVIA) -> bool =>
            isa TRIVIA.LINE_COMMENT(t) \/ isa TRIVIA.DOC_COMMENT(t) \/ isa TRIVIA.BLOCK_COMMENT(t)

        // The leading whitespace every non-blank continuation line of a
        // block comment has in common.
        _common_indent(lines: string[]) -> int is
            let common mut = -1
            let first mut = true

            for line in lines do
                if !first /\ line.trim().length > 0 then
                    let indent = line.length - line.trim_start().length

                    if common < 0 \/ indent < common then
                        common = indent
                    fi
                fi

                first = false
            od

            return if common < 0 then 0 else common fi
        si

        _strip_indent(line: string, amount: int) -> string is
            let i mut = 0

            while i < amount /\ i < line.length /\ char.is_white_space(line[i]) do
                i = i + 1
            od

            return line[i..<0]
        si

        emit_comment(t: TRIVIA) is
            note(t.location)

            if let bc: TRIVIA.BLOCK_COMMENT = t then
                let lines = bc.text.split(['\n'])

                // A continuation line carries the indentation it was
                // written at, and the renderer indents it again, so
                // re-emitting it verbatim moves the comment four columns
                // right on every reformat. Strip what every continuation
                // line shares and let the renderer supply it instead; the
                // relative shape of the comment is preserved.
                let common = _common_indent(lines)

                let first mut = true
                for line in lines do
                    if !first then
                        _builder.hard_line()
                        _builder.text(_strip_indent(line, common))
                    else
                        _builder.text(line)
                    fi
                    first = false
                od
            elif let lc: TRIVIA.LINE_COMMENT = t then
                _builder.text(lc.text)
            elif let dc: TRIVIA.DOC_COMMENT = t then
                _builder.text(dc.text)
            elif let sb: TRIVIA.SHEBANG = t then
                _builder.text(sb.text)
            fi
        si
    si
si
