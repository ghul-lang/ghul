namespace Syntax.Process is
    use Logging

    use Source.LOCATION
    use Function = Semantic.Symbols.Function

    // One value that reached a pure function-typed slot, held until
    // the effect relations can say whether it is store-free.
    // `slot_index` is the argument's position for a call record and
    // -1 for a store: several arguments of one call can fall back to
    // the same reported location, and the index is what keeps their
    // records distinct.
    //
    // The two carry different slugs because they are worth different
    // things. A store is what makes the slot's claim true, and is
    // trusted wherever the slot is read; an argument's own call is
    // judged on its callee regardless, so the report there is advice
    // rather than the thing soundness rests on.
    class PURE_SLOT_RECORD(
        location: LOCATION,
        slot_index: int,
        value: IR.Values.Value?,
        slug: string,
        message: string
    )

    // Values that reached a pure function-typed slot, recorded while
    // expressions compile and judged once the effect relations are
    // solved.
    //
    // Deferred because a body's own store-freedom is not known until
    // then: the answer available before expressions are compiled
    // cannot see the types most receivers are reached through, so it
    // gives up on bodies that write nothing.
    //
    // Held per file and dropped exactly where a file's other
    // expression-level output is, so an analysis-mode recompile of one
    // file re-records rather than reporting twice. Speculative walks
    // are mirrored from the flow: a rolled-back walk's records are
    // truncated, so an attempt that was scrubbed from the diagnostics
    // does not report.
    class PURE_SLOTS is
        _records: Collections.MAP[string, Collections.LIST[PURE_SLOT_RECORD]] static
        _marks: Collections.LIST[Collections.MAP[string, int]] static

        init() static is
            _records = Collections.MAP[string, Collections.LIST[PURE_SLOT_RECORD]]()
            _marks = Collections.LIST[Collections.MAP[string, int]]()
        si

        note(record: PURE_SLOT_RECORD) static is
            let path = record.location.file_name

            if !_records.contains_key(path) then
                _records[path] = Collections.LIST[PURE_SLOT_RECORD]()
            fi

            _records[path].add(record)
        si

        clear_for(path: string) static is
            _records.remove(path)
        si

        clear_within(path: string, span: LOCATION) static is
            let entries: Collections.LIST[PURE_SLOT_RECORD] mut

            if _records.try_get_value(path, entries ref) then
                let kept = Collections.LIST[PURE_SLOT_RECORD]()

                for c in entries do
                    if !span.contains(c.location) then
                        kept.add(c)
                    fi
                od

                _records[path] = kept
            fi
        si

        clear() static is
            _records.clear()
            _marks.clear()
        si

        // Speculation, mirrored from NARROWING_FLOW: a record made
        // inside a walk that is rolled back would otherwise survive the
        // scrubbing of that walk's diagnostics. The mark snapshots each
        // file list's length, so a rollback trims every list back to
        // exactly its own length at the mark and touches nothing
        // recorded before it.
        speculate() static is
            let snapshot = Collections.MAP[string, int]()

            for entry in _records do
                snapshot[entry.key] = entry.value.count
            od

            _marks.add(snapshot)
        si

        commit() static is
            if _marks.count > 0 then
                _marks.remove_at(_marks.count - 1)
            fi
        si

        roll_back() static is
            if _marks.count == 0 then
                return
            fi

            let snapshot = _marks[_marks.count - 1]

            _marks.remove_at(_marks.count - 1)

            for entry in _records do
                let list = entry.value

                let keep =
                    if snapshot.contains_key(entry.key) then
                        snapshot[entry.key]
                    else
                        0
                    fi

                while list.count > keep do
                    list.remove_at(list.count - 1)
                od
            od
        si

        // Hand over what has been recorded and start fresh: the caller
        // reports against the relations just solved. One record per
        // location: a body re-walked to convergence (overload retry,
        // delegate conversion) records the same slot once per walk,
        // and the last walk is the one whose compilation stands.
        take() -> Collections.List[PURE_SLOT_RECORD] static is
            let by_slot = Collections.MAP[(LOCATION, int), PURE_SLOT_RECORD]()

            for entry in _records do
                for record in entry.value do
                    by_slot[(record.location, record.slot_index)] = record
                od
            od

            _records.clear()
            _marks.clear()

            let taken = Collections.LIST[PURE_SLOT_RECORD]()

            for pair in by_slot do
                taken.add(pair.value)
            od

            return taken
        si
    si

    // Records values reaching pure function-typed slots as expressions
    // compile. The judgement itself is PURE_SLOT_JUDGE, after the
    // effect relations are solved.
    class PURE_SLOT_CHECK is
        _build_flags: Compiler.GLOBAL_BUILD_FLAGS
        _flow: NARROWING_FLOW

        // Resolves argument values to the functions their shapes name.
        // A fresh resolver rather than the effects walk's: at this
        // point in the build its local-variable record does not exist
        // yet, and the structural shapes — literals, delegates, named
        // functions — are all a crossing's callee needs.
        _functions: FUNCTION_VALUES

        init(flow: NARROWING_FLOW, build_flags: Compiler.GLOBAL_BUILD_FLAGS) is
            super.init()

            _flow = flow
            _build_flags = build_flags
            _functions = FUNCTION_VALUES()
        si

        // Every argument of a fully-built call that lands in a pure
        // formal. Applies to any call-shaped value: an ordinary call,
        // a user-defined operator or indexer, a construction.
        //
        // `syntax_arguments` are the written argument expressions, used
        // to report against the offending argument rather than the whole
        // call. They are only trusted when their count matches the
        // built call's, so a lowering that inserts or drops an argument
        // falls back to the call's own location rather than blaming the
        // wrong one.
        check_call(
            location: LOCATION,
            value: IR.Values.Value?,
            syntax_arguments: Trees.Expressions.LIST?
        ) is
            let function: Function? mut = null
            let arguments: Collections.List[IR.Values.Value]? mut = null

            if let call: IR.Values.Call.INSTANCE = value then
                function = call.function
                arguments = call.arguments
            elif let call: IR.Values.Call.GLOBAL = value then
                function = call.function
                arguments = call.arguments
            elif let call: IR.Values.Call.STATIC = value then
                function = call.function
                arguments = call.arguments
            elif let call: IR.Values.Call.STRUCT = value then
                function = call.function
                arguments = call.arguments
            else
                return
            fi

            let formals = function.arguments

            for i in 0..formals.count do
                if i >= arguments.count then
                    return
                fi

                if formals[i].is_pure_function then
                    // suppressing the warning must not change what is
                    // compiled, so only the record is gated: the
                    // crossing below registers either way
                    if !_build_flags.no_warn_impure_function_argument then
                        PURE_SLOTS.note(
                            PURE_SLOT_RECORD(
                                _argument_location(syntax_arguments, i, arguments.count, location),
                                i,
                                arguments[i],
                                "impure-function-argument",
                                "argument must be a pure function"))
                    fi

                    _note_untrusted_argument(location, arguments[i])
                fi
            od
        si

        // The callee is trusted on its own store-freedom, and that
        // trust assumes its pure function-typed parameters hold
        // store-free values. An argument that is not structurally
        // trustworthy is a hole in that assumption, so the call is
        // recorded as a crossing against the function the argument
        // names — dischargeable once the solve proves it — or as an
        // unbounded crossing when the value names none.
        _note_untrusted_argument(location: LOCATION, argument: IR.Values.Value?) is
            if argument? /\ argument.type? /\ argument.type.is_pure_function then
                return
            fi

            if let function = _functions.function_value_of(argument) then
                if !function.is_store_free then
                    _flow.on_call_of(location, function)
                fi

                return
            fi

            _flow.on_call(location)
        si

        _argument_location(
            syntax_arguments: Trees.Expressions.LIST?,
            index: int,
            count: int,
            fallback: LOCATION
        ) -> LOCATION is
            let syntax_index = _syntax_index(syntax_arguments, index, count)

            if syntax_index >= 0 then
                return syntax_arguments!.expressions[syntax_index].location
            fi

            return fallback
        si

        // The written argument standing behind built argument
        // `index`, or -1 when the two lists cannot be aligned. Equal
        // counts align directly; one extra built argument is the
        // thread-first `\|>` shape, where the threaded value is the
        // built call's first argument and the written list supplies
        // the rest. Anything else is a lowering this cannot see
        // through, and the caller falls back to the built value and
        // the call's own location.
        _syntax_index(
            syntax_arguments: Trees.Expressions.LIST?,
            index: int,
            count: int
        ) -> int is
            if !syntax_arguments? then
                return -1
            fi

            let offset = count - syntax_arguments.count

            if offset != 0 /\ offset != 1 then
                return -1
            fi

            let syntax_index = index - offset

            if syntax_index < 0 then
                return -1
            fi

            return syntax_index
        si

        // A value stored into a slot whose type is a pure function
        // type. The slot's type is a claim that it holds store-free
        // values, and is trusted wherever the slot is read, so the
        // store is where the value has to be shown store-free.
        check_store(location: LOCATION, target_type: Semantic.Types.Type?, value: IR.Values.Value?) is
            // A slot whose type is still settling is not a claim about
            // anything: the walk that produced it is superseded by a
            // later one, and the purity of a placeholder shape says
            // only what inference happened to be holding at the time.
            // Recording it leaves a judgement standing against a
            // contract that no longer exists once the type settles.
            if
                target_type? /\ target_type.is_pure_function /\
                !target_type.contains_inferred /\
                !_build_flags.no_warn_impure_function_value
            then
                PURE_SLOTS.note(
                    PURE_SLOT_RECORD(
                        location,
                        -1,
                        value,
                        "impure-function-value",
                        "value must be a pure function"))
            fi
        si
    si

    // Judges what reached a pure function-typed slot, once the effect
    // relations can answer whether each value is store-free.
    //
    // The test is "cannot prove store-free", not "is known to store",
    // so it is conservative and reports a warning.
    class PURE_SLOT_JUDGE is
        _logger: Logger

        // Resolves a compiled value to the function it denotes,
        // including a lambda literal's closure and an immutable local
        // holding one. Owned by INFER_STORE_FREE, whose resolved walk
        // populates the local-value map this consults.
        _functions: FUNCTION_VALUES

        init(logger: Logger, functions: FUNCTION_VALUES) is
            super.init()

            _logger = logger
            _functions = functions
        si

        judge() is
            let trace = System.Environment.get_environment_variable("GHUL_PURE_SLOT_TRACE")?

            for record in PURE_SLOTS.take() do
                if !is_satisfied(record.value) then
                    if trace then
                        let function = _functions.function_value_of(record.value)

                        IO.Std.error.write_line(
                            "pure-slot miss at {record.location}: value kind {record.value?.get_type()} resolved {function} effects {EFFECTS.is_store_free(function)} type {record.value?.type}")
                    fi

                    _logger.warn(record.location, record.slug, record.message)
                fi
            od
        si

        is_satisfied(argument: IR.Values.Value?) -> bool is
            if !argument? then
                return true
            fi

            // A read of a slot already typed pure — a local, field or
            // parameter — is trusted on the type: the store into that
            // slot is where this same check made the value show
            // itself, and re-reporting every later read of a slot
            // whose one offending store was already reported would be
            // noise.
            if _is_pure_typed_slot_read(argument) then
                return true
            fi

            // A lambda literal, a named function, or an immutable
            // local holding one: the function's own store-free answer
            // decides, whether declared, whitelisted or solved.
            if let function = _functions.function_value_of(argument) then
                return EFFECTS.is_store_free(function)
            fi

            // Otherwise only the value's own type can say: a slot
            // already declared pure holds store-free values by the
            // same contract this check enforces at its stores.
            return argument.type? /\ argument.type.is_pure_function
        si

        _is_pure_typed_slot_read(argument: IR.Values.Value) -> bool is
            if !argument.type? \/ !argument.type.is_pure_function then
                return false
            fi

            return
                isa IR.Values.Load.LOCAL_VARIABLE(argument) \/
                isa IR.Values.Load.LOCAL_ARGUMENT(argument) \/
                isa IR.Values.Load.ARGUMENT(argument) \/
                isa IR.Values.Load.INSTANCE_FIELD(argument) \/
                isa IR.Values.Load.STATIC_FIELD(argument) \/
                isa IR.Values.Load.GLOBAL_FIELD(argument)
        si
    si
si
