namespace Syntax.Process is
    use IO.Std

    use Collections.Iterable

    use Logging
    use Source
    use Trees

    class CONDITIONAL_COMPILATION: Visitor is
        _flags: Collections.MAP[string,bool]

        is_analysis: bool

        init() is
            super.init()

            _flags = Collections.MAP[string,bool]()
        si

        // The names `--define` turns on, and then the ones the build
        // decides for itself. The target comes after the defines so that
        // it always wins: a `--define dotnet` on a wasm build, or the
        // reverse, describes a build that is not the one being made.
        set_is_enabled(names: Iterable[string], profile: Semantic.TargetProfile) is
            for name in names do
                set_is_enabled(name, true)
            od

            set_is_enabled("legacy", false)

            for other in Semantic.TARGET_PROFILES.all do
                for condition in other.conditions do
                    set_is_enabled(condition, false)
                od
            od

            for condition in profile.conditions do
                set_is_enabled(condition, true)
            od
        si

        set_is_enabled(name: string, value: bool) is
            _flags[name] = value
        si

        get_is_enabled(name: string mut) -> bool is
            let not_result mut = false
            let result mut = false

            if name.starts_with("not.") then
                name = name.substring(4)

                not_result = true
            fi

            if _flags.contains_key(name) then
                result = _flags[name]
            fi

            if not_result then
                return !result
            fi

            return result
        si

        get_is_enabled(pragma: Pragmas.PRAGMA) -> bool is
            let name = pragma.name.to_string()

            if !name.starts_with("IF.") then
                return true
            fi

            return get_is_enabled(name.substring(3))
        si

        apply(
            node: Node
        ) is
            node.walk(self)
        si

        // Whether a file-level `@@IF.<name>()` whose name is off leaves the
        // whole file out.
        excludes_file(definitions: Definitions.LIST) -> bool is
            if let file_pragmas = definitions.file_pragmas then
                for pragma in file_pragmas do
                    if !get_is_enabled(pragma) then
                        return true
                    fi
                od
            fi

            return false
        si

        // A file left out loses its definitions and its top-level
        // statements alike.
        pre(definitions: Definitions.LIST) -> bool is
            if excludes_file(definitions) then
                definitions.clear_definitions()
                definitions.top_level_statements = null

                return true
            fi

            return false
        si

        // FIXME: pragma handling code is duplicated across multiple visitors
        visit(pragma: Definitions.PRAGMA) is
            if !get_is_enabled(pragma.pragma) then
                pragma.definition =
                    Definitions.LIST(
                        pragma.definition.location,
                        Collections.LIST[Definitions.Definition](0)
                    )
            fi
        si

        visit(pragma: Statements.PRAGMA) is
            if !get_is_enabled(pragma.pragma) then
                pragma.statement = null
            fi
        si
    si
si
