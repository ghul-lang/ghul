namespace Syntax.Process is
    use Trees

    // Warns at each power operator whose left operand is a power the same
    // chain built, `a ** b ** c`, which groups as `(a ** b) ** c` where a
    // reader of mathematics expects `a ** (b ** c)`. The parser marks such
    // an operator; the warning is reported here, once a file's tree is
    // settled, rather than while a speculative parse may still discard it.
    class CHECK_POWER_CHAINS: Visitor is
        _logger: Logging.Logger

        init(logger: Logging.Logger) is
            super.init()

            _logger = logger
        si

        apply(source_file: Compiler.SOURCE_FILE) is
            source_file.definition.walk(self)
        si

        visit(binary: Expressions.BINARY) is
            if binary.is_power_chain then
                let op = binary.actual_operation ?? binary.operation.name

                _logger.warn(binary.operation.location, "power-chain", "'{op}' chain groups to the left, as '(a {op} b) {op} c'")
                _logger.hint(binary.operation.location, "power-chain-hint", "parentheses around one pair make the grouping explicit")
            fi
        si
    si
si
