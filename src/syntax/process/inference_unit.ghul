namespace Syntax.Process is
    use Collections.LIST

    // The bodies of one file that compile-expressions walks as a single
    // inference body: the file's functions with inferred signatures, its
    // synthesised top-level entry, and the file-level functions written
    // with types whose bodies call one of those or read a top-level `let`.
    // Every walk visits every member's body, so a call in one member
    // bounds the parameter types of another and the walks share one
    // obligation queue.
    class INFERENCE_UNIT is
        members: LIST[Trees.Definitions.FUNCTION]

        // The members something walked before them, or they themselves,
        // call: a walk that ends on a different return for one of them has
        // to be followed by another, since those calls read the return the
        // walk started at.
        read_early: Collections.SET[Trees.Definitions.FUNCTION]

        // Set once compile-expressions has walked the unit, so the members'
        // own visits skip their bodies.
        is_compiled: bool public

        init() is
            members = LIST[Trees.Definitions.FUNCTION]()
            read_early = Collections.SET[Trees.Definitions.FUNCTION]()
        si

        add(function: Trees.Definitions.FUNCTION) is
            members.add(function)
            function.inference_unit = self
        si
    si
si

