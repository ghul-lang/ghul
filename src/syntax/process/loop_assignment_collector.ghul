namespace Syntax.Process is
    // Collects the variables written within a walked
    // subtree — by assignment (`=`, including destructuring) or by
    // being passed `ref`. Two consumers, each dropping a narrow on
    // a variable the walked subtree writes: the loop kill-set, where
    // a narrow cannot be assumed across the back-edge, and the entry
    // to a finally body, where a narrow proven before the try
    // survives what the try did not write.
    //
    // A `Visitor` whose default per-node visits are no-ops, so only
    // ASSIGNMENT and REFERENCE need overriding; default `pre`
    // returns false, so the framework descends through everything.
    class LOOP_ASSIGNMENT_COLLECTOR: Visitor is
        names: Collections.SET[string] public

        // Targets of assignments that have already been compiled, by the
        // symbol they store to. Only filled when asked for: before a
        // walk, or between walks, an assignment holds no value or a stale
        // one.
        symbols: Collections.SET[Semantic.Symbols.Symbol] public
        _use_resolved_targets: bool

        init() is
            init(false)
        si

        init(use_resolved_targets: bool) is
            super.init()
            names = Collections.SET[string]()
            symbols = Collections.SET[Semantic.Symbols.Symbol]()
            _use_resolved_targets = use_resolved_targets
        si

        // Whether the walk wrote the variable, by symbol where the store
        // was resolved and by name where it was not.
        wrote(variable: Semantic.Symbols.Symbol) -> bool =>
            symbols.contains(variable) \/ (variable.name? /\ names.contains(variable.name))

        visit(assignment: Trees.Statements.ASSIGNMENT) is
            if _use_resolved_targets then
                if let store: IR.Values.Store.SYMBOL = assignment.value then
                    symbols.add(store.symbol)
                    return
                fi
            fi

            let targets = Collections.LIST[Trees.Expressions.Expression]()
            assignment.left.get_names_into(targets)

            for target in targets do
                _collect(target)
            od
        si

        visit(reference: Trees.Expressions.REFERENCE) is
            // `x ref` — a `ref` argument may be written by the callee.
            _collect(reference.left)
        si

        _collect(expr: Trees.Expressions.Expression) is
            if !isa Trees.Expressions.IDENTIFIER(expr) then
                return
            fi

            let identifier = expr

            names.add(identifier.identifier.name)
        si
    si
si
