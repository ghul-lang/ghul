namespace Syntax.Process is
    use Function = Semantic.Symbols.Function
    use Symbol = Semantic.Symbols.Symbol

    // Resolves a compiled value to the function it denotes, when the
    // value's shape names one: a lambda literal compiled to a
    // closure, a delegate constructed from a named function, a
    // function pointer, an immutable local holding one of those.
    // Populated by the resolved-mode effects walk, which notes each
    // immutable local whose initializer named a function; consumed
    // there and by the pure-slot judge.
    class FUNCTION_VALUES is
        // Immutable locals whose initializer named a function value,
        // recorded by the current effects round's walk.
        _local_function_values: Collections.MutableMap[Symbol, Function]

        init() is
            _local_function_values = Collections.MAP[Symbol, Function]()
        si

        note_local(symbol: Symbol, function: Function) is
            _local_function_values[symbol] = function
        si

        // Dropped at the start of each effects round: the walk that is
        // about to run re-records every live local, so anything left
        // from an earlier round is either redundant or stale — a
        // retained symbol whose initializer no longer names a function
        // must stop resolving, and abandoned symbol generations must
        // not be kept reachable for the life of an analysis process.
        clear() is
            _local_function_values.clear()
        si

        // Dropped for one file ahead of a round that re-walks only it:
        // the locals recorded there are re-recorded by that walk, and
        // every other file's stay current.
        drop_file(file_name: string) is
            let stale = Collections.LIST[Symbol]()

            for symbol in _local_function_values.keys do
                if symbol.location.file_name =~ file_name then
                    stale.add(symbol)
                fi
            od

            for symbol in stale do
                _local_function_values.remove(symbol)
            od
        si

        function_value_of(value: IR.Values.Value?) -> Function? is
            if !value? then
                return null
            fi

            if let view: IR.Values.NARROW_VIEW = value then
                return function_value_of(view.underlying)
            fi

            if let wrapper: IR.Values.WRAPPER = value then
                return function_value_of(wrapper.value)
            fi

            if let wrapper: IR.Values.TYPE_WRAPPER = value then
                return function_value_of(wrapper.value)
            fi

            if let memoized: IR.Values.MEMOIZED_DELEGATE = value then
                return function_value_of(memoized.inner)
            fi

            if let wrap: IR.Values.PACK_WRAP = value then
                if let wrapped = function_value_of(wrap.inner) then
                    return wrapped
                fi
            fi

            // a capturing literal lowers to a block — frame setup,
            // then the delegate load the block leaves behind, which
            // may itself be spilled to a temp and reloaded
            if let block: IR.Values.BLOCK = value then
                return function_value_of(_block_result_source(block))
            fi

            if let closure: IR.Values.MAKE_CLOSURE = value then
                return closure.function
            fi

            if let load: IR.Values.Load.INSTANCE_ANONYMOUS_FUNCTION = value then
                return cast Function?(load.symbol)
            fi

            if let load: IR.Values.Load.STATIC_ANONYMOUS_FUNCTION = value then
                return cast Function?(load.symbol)
            fi

            if let load: IR.Values.Load.GLOBAL_ANONYMOUS_FUNCTION = value then
                return cast Function?(load.symbol)
            fi

            // an immutable local can only ever hold its initializer's
            // value, so a load of one denotes whatever function that
            // named
            if let load: IR.Values.Load.LOCAL_VARIABLE = value then
                if _local_function_values.contains_key(load.symbol) then
                    return _local_function_values[load.symbol]
                fi

                return null
            fi

            // two closure-frame fields also name their value: the
            // `$recurse` capture is the frame's own closure referring
            // to itself, and a capture of an immutable local holds
            // whatever that local does
            if let load: IR.Values.Load.INSTANCE_FIELD = value then
                if let frame_field: Semantic.Symbols.Field = load.symbol then
                    if frame_field.is_recurse_capture then
                        if let frame: Semantic.Symbols.FRAME = frame_field.owner then
                            return frame.closure
                        fi
                    fi

                    if let captured = frame_field.captured_symbol then
                        if _local_function_values.contains_key(captured) then
                            return _local_function_values[captured]
                        fi
                    fi
                fi

                return null
            fi

            return value.referenced_function
        si

        // The value a block leaves behind. When that is a temp
        // reload, the value stored into the temp — the entry
        // immediately before the matching store, since STORE_TEMP
        // consumes what the previous entry pushed.
        _block_result_source(block: IR.Values.BLOCK) -> IR.Values.Value? is
            let result = block.result_value

            if let load: IR.Values.Load.TEMP = result then
                let entries = block.values

                for i in 1..entries.count do
                    if let store: IR.Values.STORE_TEMP = entries[i] then
                        if store.local == load.local then
                            return entries[i - 1]
                        fi
                    fi
                od
            fi

            return result
        si
    si
si
