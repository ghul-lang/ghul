namespace Syntax.Process is
    use IO.Std

    use System.Text.StringBuilder

    use Logging
    use Trees
    use Source

    use IR
    use IR.Values

    use Ghul.Pipes


    // Expression IL: call/await/spill/cast walks, await-suspend construction and string interpolation.
    partial GENERATE_IL is
        // Override CALL.walk's default args-first order so SPILLs in
        // the receiver position emit before AWAIT_SUSPENDs in the
        // argument position — needed for source-order side effects
        // across instance-call receivers.
        pre(call: Trees.Expressions.CALL) -> bool is
            super.pre(call)

            call.function.walk(self)
            call.arguments.walk(self)

            return true
        si

        visit(`await: Trees.Expressions.AWAIT) is
            // Emit AWAIT_SUSPEND eagerly, stash the result into a
            // fresh frame field (NOT a CLR local — CLR locals reset
            // on every MoveNext re-entry), and rebind the wrapper to
            // a `ldfld <field>` load. The CLR-local TEMP is a
            // one-MoveNext bridge: we can't `ldarg.0` before
            // AWAIT_SUSPEND (would push across its internal labels),
            // so the suspend's result goes to a tmp first, then
            // `ldarg.0 / ldloc / stfld`.
            let await_wrapper = cast Values.WRAPPER?(`await.value)

            if !await_wrapper? then
                return
            fi

            let casm = _current_async_state_machine

            if !casm? \/ current_function != casm.function then
                _logger.error(`await.location, "await outside async state-machine context")
                return
            fi

            let operand_value = `await.operand.value
            if !operand_value? then return; fi
            let operand_type = operand_value.type
            if !operand_type? then return; fi

            let awaitable = `await.awaitable
            if !awaitable? then return; fi

            let suspend =
                _build_await_suspend(`await.location, operand_value, awaitable, `await.awaiter_field)

            let frame = casm.frame

            assert frame? else "async state machine has no frame at await emission"

            let suspend_type = suspend.type

            if !suspend_type.is_void then
                let result_field = `await.result_field

                assert result_field? else "await has no result field at IL generation"

                let result_temp = TEMP(current_block, "await_bridge", suspend)

                add(_build_frame_field_store(frame, result_field, result_temp.load()))

                await_wrapper.value =
                    IR.Values.Load.INSTANCE_FIELD(
                        IR.Values.Load.REFERENCE_SELF(frame, frame.type),
                        result_field
                    )
            else
                // void-async — emit the suspend IL eagerly. The wrapper
                // already holds a void-typed DUMMY which surrounding
                // emit paths must skip (the type check in
                // visit(Statements.EXPRESSION) handles the only place
                // this matters in practice — bare `await E;`).
                add(suspend)
            fi
        si

        visit(spill: Trees.Expressions.SPILL) is
            // Eagerly emit the operand's IL, then `stfld` to a fresh
            // frame field. The wrapper's value becomes a
            // `ldarg.0; ldfld <field>` load that surrounding IR
            // consumes lazily. Used by the SPILL_AWAITS pass to
            // persist intermediate values evaluated to the left of an
            // `await` so they survive the suspend.
            let spill_wrapper = cast Values.WRAPPER?(spill.value)

            if !spill_wrapper? then
                return
            fi

            let operand_value = spill.operand.value
            if !operand_value? then return; fi

            let casm = _current_async_state_machine

            // Outside an async body nothing suspends, so the value only
            // has to be off the stack while a protected region opens,
            // and a local holds it.
            if !casm? \/ current_function != casm.function \/ !spill.spill_field? then
                spill_wrapper.value = IR.TEMP(current_block, "spill", operand_value).load()
                return
            fi

            let frame = casm.frame

            assert frame? else "async state machine has no frame at spill emission"

            let spill_field = spill.spill_field

            assert spill_field? else "spill has no frame field at IL generation"

            add(_build_frame_field_store(frame, spill_field, operand_value))

            spill_wrapper.value =
                IR.Values.Load.INSTANCE_FIELD(
                    IR.Values.Load.REFERENCE_SELF(frame, frame.type),
                    spill_field
                )
        si

        visit(`cast: Trees.Expressions.CAST) is
            let cast_wrapper = cast Values.WRAPPER?(`cast.value)

            if !cast_wrapper? then return; fi

            let right_value = `cast.right.value
            if !right_value? then return; fi
            let cast_type = cast_wrapper.type
            if !cast_type? then return; fi

            // Use the WRAPPER's type, not `cast.type_expression.type`
            // — for a bare-variant cast on a generic union (a `cast V(x)`
            // or the `cast` produced by `if let v: V = x` lowering),
            // compile_expressions.visit(CAST) already substituted the
            // receiver-specialized variant type, but the user's
            // type_expression still reads as the open generic.
            cast_wrapper.value =
                _type_caster
                    .cast_value(
                        `cast.location,
                        right_value,
                        cast_type,
                        true,
                        `cast.is_checked
                    )
        si

        // Build an AWAIT_SUSPEND for `awaited`: allocates a state
        // number + a cold resume label + a fresh `$awaiter_N`
        // field, and records the (state, awaiter, label) triple
        // for entry-dispatch population.
        //
        // The three member calls the suspend makes are built as
        // ordinary call values, so a struct awaitable or awaiter is
        // addressed and a class one dispatched exactly as a call
        // written in source would be.
        _build_await_suspend(
            location: Source.LOCATION,
            awaited: Value,
            awaitable: Semantic.AWAITABLE,
            declared_awaiter_field: Semantic.Symbols.Field?
        ) -> IR.Values.AWAIT_SUSPEND is
            let async_sm = _current_async_state_machine!
            let frame = async_sm.frame

            assert frame? else "async state machine has no frame at await suspend emission"

            let awaiter_type = awaitable.awaiter_type
            let state = async_sm.allocate_state()
            let cold_resume = IR.LABEL()
            let awaiter_field =
                declared_awaiter_field ?? frame.declare_awaiter_field(awaiter_type)

            async_sm.record_label(state, awaiter_field, cold_resume)

            _register_resume_with_dispatch(state, cold_resume)

            let frame_type =
                _specialized_frame_type(frame, async_sm.get_construction_type_arguments(), location) ?? frame.type!

            let no_arguments = Collections.LIST[Value]()

            let get_awaiter =
                awaitable.get_awaiter.call(location, awaited, no_arguments, null, _function_caller)

            let awaiter_load = () =>
                IR.Values.Load.INSTANCE_FIELD(
                    IR.Values.Load.REFERENCE_SELF(frame, frame_type),
                    awaiter_field
                )

            let is_completed =
                awaitable.is_completed.call(location, awaiter_load(), no_arguments, null, _function_caller)

            let get_result =
                awaitable.get_result.call(location, awaiter_load(), no_arguments, null, _function_caller)

            return IR.Values.AWAIT_SUSPEND(
                awaitable.result_type,
                get_awaiter,
                is_completed,
                get_result,
                awaiter_type,
                awaitable.is_critical,
                state,
                _current_state_local()!,
                cold_resume,
                _current_async_resumable!,
                frame_type,
                frame.state_field,
                awaiter_field,
                frame.builder_field!
            )
        si

        visit(interpolation: Expressions.STRING_INTERPOLATION) is
            ensure_runtime_symbols_are_materialized()

            enter_block(cast IR.Values.BLOCK?(interpolation.value)!)

            let string_type = _innate_symbol_lookup.get_string_type()

            let literal_length = Literal.NUMBER(interpolation.literal_length, _innate_symbol_lookup.get_int_type())
            let expression_count = Literal.NUMBER(interpolation.expression_count, _innate_symbol_lookup.get_int_type())

            let interpolator =
                TEMP(
                    current_block,
                    "interpolator",
                    Values.RUNTIME(
                        IR.RuntimeOperation.NEW_STRING_BUILDER,
                        literal_length,
                        expression_count,
                        _innate_symbol_lookup.get_interpolated_string_handler_type()
                    )
                )

            for eaf in interpolation.values do
                let expression = eaf.expression
                let alignment = eaf.alignment
                let format = eaf.format
                let expr_value = expression.value!

                if !eaf.is_expression then
                    let literal = cast Expressions.Literals.STRING?(expression)!

                    if literal.value_string.length == 0 then
                        continue
                    fi

                    add(Values.RUNTIME(IR.RuntimeOperation.APPEND_TEXT, interpolator.load(), expr_value, null))
                elif !format? /\ !alignment? then
                    _append_interpolated_value(interpolation.location, interpolator, expr_value)
                else
                    let operands = Collections.LIST[Value](4)

                    operands.add(interpolator.load())
                    operands.add(expr_value)

                    let operation: IR.RuntimeOperation mut

                    if format? /\ alignment? then
                        operands.add(alignment.value!)
                        operands.add(Literal.STRING(format, string_type))

                        operation = IR.RuntimeOperation.APPEND_ALIGNED_FORMATTED_VALUE
                    elif format? then
                        operands.add(Literal.STRING(format, string_type))

                        operation = IR.RuntimeOperation.APPEND_FORMATTED_VALUE
                    else
                        operands.add(alignment!.value!)

                        operation = IR.RuntimeOperation.APPEND_ALIGNED_VALUE
                    fi

                    add(Values.RUNTIME(operation, operands, null, expr_value.type!))
                fi
            od

            add(Values.RUNTIME(IR.RuntimeOperation.BUILD_STRING, interpolator.load(), string_type))

            leave_block()
        si
            // Append an interpolated value given no format or alignment, as
        // INTERPOLATED_VALUE_CLASSIFIER says it reads.
        _append_interpolated_value(location: Source.LOCATION, interpolator: TEMP, value: Value) is
            let type = value.type!

            case _interpolated_value_classifier.classify(type, false)
            when Semantic.InterpolatedValueRendering.BOOL then
                _append_bool(location, interpolator, value)

            when Semantic.InterpolatedValueRendering.OPTIONAL then
                _append_optional(location, interpolator, value)

            when Semantic.InterpolatedValueRendering.DISPLAYED then
                if let display = _display_function then
                    _append_formatted(location, interpolator, display.call(location, null, [value]:Value, null, _function_caller))
                else
                    _append_formatted(location, interpolator, value)
                fi

            else
                _append_formatted(location, interpolator, value)
            esac
        si

        _append_formatted(location: Source.LOCATION, interpolator: TEMP, value: Value) is
            add(Values.RUNTIME(IR.RuntimeOperation.APPEND_VALUE, [interpolator.load(), value]:Value, null, value.type!))
        si

        _append_text(location: Source.LOCATION, interpolator: TEMP, text: string) is
            add(
                Values.RUNTIME(
                    IR.RuntimeOperation.APPEND_TEXT,
                    interpolator.load(),
                    Literal.STRING(text, _innate_symbol_lookup.get_string_type()),
                    null))
        si

        _append_bool(location: Source.LOCATION, interpolator: TEMP, value: Value) is
            let done = _open_region(LABEL())
            let true_arm = _open_region(LABEL())

            add(Values.BREAK(true_arm, IR.BRANCH.Z, value))
            _append_text(location, interpolator, "true")
            add(Values.BREAK(done))

            _close_structured(true_arm)
            _append_text(location, interpolator, "false")

            _close_structured(done)
        si

        // Append what an optional holds, by the rules for its non-optional
        // type, or `null` when it holds nothing.
        _append_optional(location: Source.LOCATION, interpolator: TEMP, value: Value) is
            let type = value.type!
            let inner = type.optional_inner_type!

            if type.is_value_type /\ (!type.find_member("has_value")? \/ !type.find_member("value")?) then
                _append_formatted(location, interpolator, value)

                return
            fi

            let done = _open_region(LABEL())
            let present = _open_region(LABEL())

            if type.is_value_type then
                let has_value = type.find_member("has_value")!
                let payload = type.find_member("value")!

                let holder = TEMP(current_block, "optional", value)
                let symbol_loader = IoC.CONTAINER.instance.symbol_loader

                add(Values.BREAK(present, IR.BRANCH.Z, has_value.load(location, IR.Values.ADDRESS(holder.load()), symbol_loader)))
                _append_interpolated_value(location, interpolator, payload.load(location, IR.Values.ADDRESS(holder.load()), symbol_loader))
            else
                let holder = TEMP(current_block, "optional", inner)

                holder.store(value)

                add(Values.BREAK(present, IR.BRANCH.Z, holder.load()))
                _append_interpolated_value(location, interpolator, holder.load())
            fi

            add(Values.BREAK(done))

            _close_structured(present)
            _append_text(location, interpolator, "null")

            _close_structured(done)
        si
    si
si
