namespace Syntax.Process is
    use IO.Std

    use Text.STRING_BUILDER

    use Logging
    use Trees
    use Source

    use IR
    use IR.Values

    use Ghul.Pipes


    // Expression IL: call/await/spill/cast walks, await-suspend construction and string interpolation.
    partial GENERATE_IL is
        // Override CALL.walk's default args-first order so SPILLs in
        // the receiver position emit before AWAIT_SUSPENDs in the
        // argument position — needed for source-order side effects
        // across instance-call receivers.
        pre(call: Trees.Expressions.CALL) -> bool is
            super.pre(call)

            call.function.walk(self)
            call.arguments.walk(self)

            return true
        si

        visit(`await: Trees.Expressions.AWAIT) is
            // Emit AWAIT_SUSPEND eagerly, stash the result into a
            // fresh frame field (NOT a CLR local — CLR locals reset
            // on every MoveNext re-entry), and rebind the wrapper to
            // a `ldfld <field>` load. The CLR-local TEMP is a
            // one-MoveNext bridge: we can't `ldarg.0` before
            // AWAIT_SUSPEND (would push across its internal labels),
            // so the suspend's result goes to a tmp first, then
            // `ldarg.0 / ldloc / stfld`.
            let await_wrapper = cast Values.WRAPPER?(`await.value)

            if !await_wrapper? then
                return
            fi

            let casm = _current_async_state_machine

            if !casm? \/ current_function != casm.function then
                _logger.error(`await.location, "await-outside-async-context", "'await' outside async state-machine context")
                return
            fi

            let operand_value = `await.operand.value
            if !operand_value? then return; fi
            let operand_type = operand_value.type
            if !operand_type? then return; fi

            let awaitable = `await.awaitable
            if !awaitable? then return; fi

            let suspend =
                _build_await_suspend(`await.location, operand_value, awaitable, `await.awaiter_field)

            let frame = casm.frame

            assert frame? else "async state machine has no frame at await emission"

            let suspend_type = suspend.type

            if !suspend_type.is_void then
                let result_field = `await.result_field

                assert result_field? else "await has no result field at IL generation"

                let result_temp = TEMP(current_block, "await_bridge", suspend)

                add(_build_frame_field_store(frame, result_field, result_temp.load()))

                await_wrapper.value =
                    IR.Values.Load.INSTANCE_FIELD(
                        IR.Values.Load.REFERENCE_SELF(frame, frame.type),
                        result_field
                    )
            else
                // void-async — emit the suspend IL eagerly. The wrapper
                // already holds a void-typed DUMMY which surrounding
                // emit paths must skip (the type check in
                // visit(Statements.EXPRESSION) handles the only place
                // this matters in practice — bare `await E;`).
                add(suspend)
            fi
        si

        visit(spill: Trees.Expressions.SPILL) is
            // Eagerly emit the operand's IL, then `stfld` to a fresh
            // frame field. The wrapper's value becomes a
            // `ldarg.0; ldfld <field>` load that surrounding IR
            // consumes lazily. Used by the SPILL_AWAITS pass to
            // persist intermediate values evaluated to the left of an
            // `await` so they survive the suspend.
            let spill_wrapper = cast Values.WRAPPER?(spill.value)

            if !spill_wrapper? then
                return
            fi

            let operand_value = spill.operand.value
            if !operand_value? then return; fi

            let casm = _current_async_state_machine

            // Outside an async body nothing suspends, so the value only
            // has to be off the stack while a protected region opens,
            // and a local holds it.
            if !casm? \/ current_function != casm.function \/ !spill.spill_field? then
                spill_wrapper.value = IR.TEMP(current_block, "spill", operand_value).load()
                return
            fi

            let frame = casm.frame

            assert frame? else "async state machine has no frame at spill emission"

            let spill_field = spill.spill_field

            assert spill_field? else "spill has no frame field at IL generation"

            add(_build_frame_field_store(frame, spill_field, operand_value))

            spill_wrapper.value =
                IR.Values.Load.INSTANCE_FIELD(
                    IR.Values.Load.REFERENCE_SELF(frame, frame.type),
                    spill_field
                )
        si

        visit(`cast: Trees.Expressions.CAST) is
            let cast_wrapper = cast Values.WRAPPER?(`cast.value)

            if !cast_wrapper? then return; fi

            let right_value = `cast.right.value
            if !right_value? then return; fi
            let cast_type = cast_wrapper.type
            if !cast_type? then return; fi

            // Use the WRAPPER's type, not `cast.type_expression.type`
            // — for a bare-variant cast on a generic union (a `cast V(x)`
            // or the `cast` produced by `if let v: V = x` lowering),
            // compile_expressions.visit(CAST) already substituted the
            // receiver-specialized variant type, but the user's
            // type_expression still reads as the open generic.
            cast_wrapper.value =
                _type_caster
                    .cast_value(
                        `cast.location,
                        right_value,
                        cast_type,
                        true,
                        `cast.is_checked
                    )
        si

        // Build an AWAIT_SUSPEND for `awaited`: allocates a state
        // number + a cold resume label + a fresh `$awaiter_N`
        // field, and records the (state, awaiter, label) triple
        // for entry-dispatch population.
        //
        // The three member calls the suspend makes are built as
        // ordinary call values, so a struct awaitable or awaiter is
        // addressed and a class one dispatched exactly as a call
        // written in source would be.
        _build_await_suspend(
            location: Source.LOCATION,
            awaited: Value,
            awaitable: Semantic.AWAITABLE,
            declared_awaiter_field: Semantic.Symbols.Field?
        ) -> IR.Values.AWAIT_SUSPEND is
            let async_sm = _current_async_state_machine!
            let frame = async_sm.frame

            assert frame? else "async state machine has no frame at await suspend emission"

            let awaiter_type = awaitable.awaiter_type
            let state = async_sm.allocate_state()
            let cold_resume = IR.LABEL()
            let awaiter_field =
                declared_awaiter_field ?? frame.declare_awaiter_field(awaiter_type)

            async_sm.record_label(state, awaiter_field, cold_resume)

            _register_resume_with_dispatch(state, cold_resume)

            let frame_type =
                _specialized_frame_type(frame, async_sm.get_construction_type_arguments(), location) ?? frame.type!

            let no_arguments = Collections.LIST[Value]()

            let get_awaiter =
                awaitable.get_awaiter.call(location, awaited, no_arguments, null, _function_caller)

            let awaiter_load = () =>
                IR.Values.Load.INSTANCE_FIELD(
                    IR.Values.Load.REFERENCE_SELF(frame, frame_type),
                    awaiter_field
                )

            let is_completed =
                awaitable.is_completed.call(location, awaiter_load(), no_arguments, null, _function_caller)

            let get_result =
                awaitable.get_result.call(location, awaiter_load(), no_arguments, null, _function_caller)

            return IR.Values.AWAIT_SUSPEND(
                awaitable.result_type,
                get_awaiter,
                is_completed,
                get_result,
                awaiter_type,
                awaitable.is_critical,
                state,
                _current_state_local()!,
                cold_resume,
                _current_async_resumable!,
                frame_type,
                frame.state_field,
                awaiter_field,
                frame.builder_field!
            )
        si

        visit(interpolation: Expressions.STRING_INTERPOLATION) is
            ensure_runtime_symbols_are_materialized()

            enter_block(cast IR.Values.BLOCK?(interpolation.value)!)

            let string_type = _innate_symbol_lookup.get_string_type()
            let int_type = _innate_symbol_lookup.get_int_type()

            if _try_interpolation_shortcut(interpolation, string_type) then
                leave_block()
                return
            fi

            if _build_flags.target != Compiler.Target.DOTNET /\ _try_interpolate_into_draft(interpolation, string_type) then
                leave_block()
                return
            fi

            let literal_length = Literal.NUMBER(interpolation.literal_length, int_type)
            let expression_count = Literal.NUMBER(interpolation.expression_count, int_type)
            let capacity = Literal.NUMBER(_estimated_capacity(interpolation), int_type)

            let interpolator =
                TEMP(
                    current_block,
                    "interpolator",
                    Values.RUNTIME(
                        IR.RuntimeOperation.NEW_STRING_BUILDER,
                        [literal_length, expression_count, capacity]:Value,
                        _innate_symbol_lookup.get_interpolated_string_handler_type()
                    )
                )

            for eaf in interpolation.values do
                _append_fragment(interpolation.location, interpolator, eaf)
            od

            add(Values.RUNTIME(IR.RuntimeOperation.BUILD_STRING, interpolator.load(), string_type))

            leave_block()
        si

        // Builds an interpolation without a builder, as wasm and llvm do:
        // each hole is evaluated once, left to right, into a temporary; the
        // lengths of the pieces are added up; one draft of exactly that many
        // code units is made; each piece is written into it in order; and
        // the draft becomes the string. Nothing is shared with any other
        // interpolation, an inner one included, and a hole that throws
        // leaves no draft behind. A hole whose text isn't known until it is
        // written, such as a double, a formatted or aligned hole, or a value
        // displayed, is read into a string of its own first. Adds the value
        // and answers true, or adds nothing and answers false where the core
        // library doesn't declare the writers.
        _try_interpolate_into_draft(interpolation: Expressions.STRING_INTERPOLATION, string_type: Semantic.Types.Type) -> bool is
            let lookup = _innate_symbol_lookup
            let int_type = lookup.get_int_type()
            let long_type = lookup.get_long_type()
            let ulong_type = lookup.get_ulong_type()
            let char_type = lookup.get_char_type()
            let draft_type = lookup.get_array_type(char_type)
            let optional_string = string_type.as_optional()

            let text_length = IR.Program.CORE_LIBRARY.global_function("_text_length", [optional_string])
            let signed_length = IR.Program.CORE_LIBRARY.global_function("_decimal_length", [long_type])
            let unsigned_length = IR.Program.CORE_LIBRARY.global_function("_decimal_length", [ulong_type])
            let write_text = IR.Program.CORE_LIBRARY.global_function("_write_text", [draft_type, int_type, optional_string])
            let write_char = IR.Program.CORE_LIBRARY.global_function("_write_char", [draft_type, int_type, char_type])
            let write_signed = IR.Program.CORE_LIBRARY.global_function("_write_decimal", [draft_type, int_type, int_type, long_type])
            let write_unsigned = IR.Program.CORE_LIBRARY.global_function("_write_decimal", [draft_type, int_type, int_type, ulong_type])
            let from_draft = IR.Program.CORE_LIBRARY.global_function("_string_from_draft", [draft_type])
            let copy_to = IR.Program.CORE_LIBRARY.global_function("_string_copy_to", [string_type, int_type, draft_type, int_type, int_type])

            // A core library from before the floating-point writers reads a
            // double or a single hole into text of its own instead.
            let double_type = lookup.get_double_type()
            let single_type = lookup.get_single_type()
            let double_length = IR.Program.CORE_LIBRARY.global_function("_double_length", [double_type])
            let write_double = IR.Program.CORE_LIBRARY.global_function("_write_double", [draft_type, int_type, double_type])
            let single_length = IR.Program.CORE_LIBRARY.global_function("_single_length", [single_type])
            let write_single = IR.Program.CORE_LIBRARY.global_function("_write_single", [draft_type, int_type, single_type])

            if
                !text_length? \/ !signed_length? \/ !unsigned_length? \/ !write_text? \/
                !write_char? \/ !write_signed? \/ !write_unsigned? \/ !from_draft? \/ !copy_to?
            then
                return false
            fi

            let location = interpolation.location
            let pieces = Collections.LIST[DraftPiece]()

            for eaf in interpolation.values do
                if !eaf.is_expression \/ _is_plain_string_literal_hole(eaf) then
                    let literal = cast Expressions.Literals.STRING?(eaf.expression)!

                    if literal.value_string.length > 0 then
                        pieces.add(DraftPiece.LITERAL(literal.value_string))
                    fi

                    continue
                fi

                let value = eaf.expression.value!
                let type = value.type!

                if let alignment = eaf.alignment then
                    if let literal: Values.Literal.NUMBER = alignment.value, width: Values.Literal.CONSTANT.I4 = literal.constant then
                        pieces.add(DraftPiece.ALIGNED(_hole_text(location, value, eaf.format), width.value))
                    else
                        pieces.add(DraftPiece.TEXT(_render_hole(location, eaf)))
                    fi
                elif let format = eaf.format then
                    pieces.add(DraftPiece.TEXT(_hole_text(location, value, format)))
                elif !type.is_optional /\ _is(type, string_type) then
                    pieces.add(DraftPiece.TEXT(TEMP(current_block, "hole", _type_caster.cast_value(location, value, optional_string, true, false))))
                elif _is(type, char_type) then
                    pieces.add(DraftPiece.CHAR(TEMP(current_block, "hole", value)))
                elif _is_signed_decimal(type) then
                    pieces.add(DraftPiece.DECIMAL(TEMP(current_block, "hole", _type_caster.cast_value(location, value, long_type, true, false)), false))
                elif _is(type, ulong_type) then
                    pieces.add(DraftPiece.DECIMAL(TEMP(current_block, "hole", value), true))
                elif _is(type, double_type) /\ double_length? /\ write_double? then
                    pieces.add(DraftPiece.FLOATING(TEMP(current_block, "hole", value), double_length!, write_double!))
                elif _is(type, single_type) /\ single_length? /\ write_single? then
                    pieces.add(DraftPiece.FLOATING(TEMP(current_block, "hole", value), single_length!, write_single!))
                else
                    pieces.add(DraftPiece.TEXT(_hole_text(location, value, null)))
                fi
            od

            // Every hole has been evaluated: only now is anything measured.
            let known mut = 0
            let lengths = Collections.LIST[TEMP?]()
            let total: Value mut = Literal.NUMBER(0, int_type)

            for piece in pieces do
                let measured: TEMP? =
                    case piece
                    when literal: DraftPiece.LITERAL then
                        known = known + literal.text.length
                        null
                    when text: DraftPiece.TEXT then
                        TEMP(current_block, "length", text_length!.call(location, null, [text.text.load()]:Value, null, _function_caller))
                    when aligned: DraftPiece.ALIGNED then
                        // the text's length and the padding the width
                        // leaves past it
                        let width = if aligned.width < 0 then -aligned.width else aligned.width fi
                        let length = TEMP(current_block, "length", text_length!.call(location, null, [aligned.text.load()]:Value, null, _function_caller))
                        let short_by = ARITHMETIC(IR.ArithmeticOperation.SUBTRACT, Literal.NUMBER(width, int_type), length.load(), int_type)
                        let padding = TEMP(current_block, "padding", INT_MAX_ZERO(short_by, int_type))

                        total = ARITHMETIC(IR.ArithmeticOperation.ADD, total, length.load(), int_type)

                        padding
                    when unit: DraftPiece.CHAR then
                        known = known + 1
                        null
                    when number: DraftPiece.DECIMAL then
                        let measure = if number.is_unsigned then unsigned_length! else signed_length! fi

                        TEMP(current_block, "length", measure.call(location, null, [number.value.load()]:Value, null, _function_caller))
                    when floating: DraftPiece.FLOATING then
                        TEMP(current_block, "length", floating.measure.call(location, null, [floating.value.load()]:Value, null, _function_caller))
                    esac

                if let length = measured then
                    total = ARITHMETIC(IR.ArithmeticOperation.ADD, total, length.load(), int_type)
                fi

                lengths.add(measured)
            od

            total = ARITHMETIC(IR.ArithmeticOperation.ADD, total, Literal.NUMBER(known, int_type), int_type)

            let draft = TEMP(current_block, "draft", NEW_ARRAY(draft_type, char_type, total))
            let at = TEMP(current_block, "at", Literal.NUMBER(0, int_type))

            for i in 0..pieces.count do
                let written: Value =
                    case pieces[i]
                    when literal: DraftPiece.LITERAL then
                        let text = _type_caster.cast_value(location, Literal.STRING(literal.text, string_type), optional_string, true, false)

                        write_text!.call(location, null, [draft.load(), at.load(), text]:Value, null, _function_caller)
                    when text: DraftPiece.TEXT then
                        write_text!.call(location, null, [draft.load(), at.load(), text.text.load()]:Value, null, _function_caller)
                    when aligned: DraftPiece.ALIGNED then
                        let width = if aligned.width < 0 then -aligned.width else aligned.width fi
                        let spaces = Literal.STRING("".pad_left(width), string_type)
                        let padding = lengths[i]!

                        if aligned.width < 0 then
                            at.store(write_text!.call(location, null, [draft.load(), at.load(), aligned.text.load()]:Value, null, _function_caller))
                            add(copy_to!.call(location, null, [spaces, Literal.NUMBER(0, int_type), draft.load(), at.load(), padding.load()]:Value, null, _function_caller))

                            ARITHMETIC(IR.ArithmeticOperation.ADD, at.load(), padding.load(), int_type)
                        else
                            add(copy_to!.call(location, null, [spaces, Literal.NUMBER(0, int_type), draft.load(), at.load(), padding.load()]:Value, null, _function_caller))
                            at.store(ARITHMETIC(IR.ArithmeticOperation.ADD, at.load(), padding.load(), int_type))

                            write_text!.call(location, null, [draft.load(), at.load(), aligned.text.load()]:Value, null, _function_caller)
                        fi
                    when unit: DraftPiece.CHAR then
                        write_char!.call(location, null, [draft.load(), at.load(), unit.unit.load()]:Value, null, _function_caller)
                    when number: DraftPiece.DECIMAL then
                        let write = if number.is_unsigned then write_unsigned! else write_signed! fi

                        write.call(location, null, [draft.load(), at.load(), lengths[i]!.load(), number.value.load()]:Value, null, _function_caller)
                    when floating: DraftPiece.FLOATING then
                        floating.write.call(location, null, [draft.load(), at.load(), floating.value.load()]:Value, null, _function_caller)
                    esac

                at.store(written)
            od

            add(from_draft!.call(location, null, [draft.load()]:Value, null, _function_caller))

            return true
        si

        // Whether a value of `type` is written through the signed decimal
        // writer: a signed integer, or an unsigned one narrower than a long,
        // which a long holds exactly.
        _is_signed_decimal(type: Semantic.Types.Type) -> bool is
            let lookup = _innate_symbol_lookup

            return
                _is(type, lookup.get_int_type()) \/ _is(type, lookup.get_long_type()) \/
                _is(type, lookup.get_short_type()) \/ _is(type, lookup.get_byte_type()) \/
                _is(type, lookup.get_uint_type()) \/ _is(type, lookup.get_ushort_type()) \/
                _is(type, lookup.get_ubyte_type())
        si

        // The text of a hole's `value` under `format`, if any, as the builder
        // would append it, for a draft to copy: a string as itself, a bool as
        // a literal, a displayed value through `$`, an optional through a
        // builder of its own, and anything else through its type's
        // `to_string`, chosen once the type is known.
        _hole_text(location: Source.LOCATION, value: Value, format: string?) -> TEMP is
            let string_type = _innate_symbol_lookup.get_string_type()
            let optional_string = string_type.as_optional()
            let type = value.type!

            if !format? /\ !type.is_optional /\ _is(type, string_type) then
                return TEMP(current_block, "hole", _type_caster.cast_value(location, value, optional_string, true, false))
            fi

            let text: Value =
                case _interpolated_value_classifier.classify(type, false)
                when Semantic.InterpolatedValueRendering.BOOL then
                    return _bool_text(location, value, optional_string)

                when Semantic.InterpolatedValueRendering.OPTIONAL then
                    _rendered_text(location, value, format)

                when Semantic.InterpolatedValueRendering.DISPLAYED then
                    if let display = _display_function then
                        display.call(location, null, [value]:Value, null, _function_caller)
                    else
                        Values.RUNTIME(IR.RuntimeOperation.VALUE_TEXT, [value]:Value, string_type, type)
                    fi

                else
                    if let format_text = format then
                        Values.RUNTIME(IR.RuntimeOperation.FORMATTED_VALUE_TEXT, [value, Literal.STRING(format_text, string_type)]:Value, string_type, type)
                    else
                        Values.RUNTIME(IR.RuntimeOperation.VALUE_TEXT, [value]:Value, string_type, type)
                    fi
                esac

            return TEMP(current_block, "hole", _type_caster.cast_value(location, text, optional_string, true, false))
        si

        // `value` under `format` appended to a builder of its own, as an
        // optional is: the builder's rendering decides what an absent value
        // reads as.
        _rendered_text(location: Source.LOCATION, value: Value, format: string?) -> Value is
            let int_type = _innate_symbol_lookup.get_int_type()

            let rendered =
                TEMP(
                    current_block,
                    "rendered",
                    Values.RUNTIME(
                        IR.RuntimeOperation.NEW_STRING_BUILDER,
                        Literal.NUMBER(0, int_type),
                        Literal.NUMBER(1, int_type),
                        _innate_symbol_lookup.get_interpolated_string_handler_type()
                    )
                )

            _append_interpolated_value(location, rendered, value, format)

            return Values.RUNTIME(IR.RuntimeOperation.BUILD_STRING, rendered.load(), _innate_symbol_lookup.get_string_type())
        si

        // A hole read into a string of its own, as the builder would append
        // it, for a draft to copy.
        _render_hole(location: Source.LOCATION, eaf: Expressions.INTERPOLATION_FRAGMENT) -> TEMP is
            let int_type = _innate_symbol_lookup.get_int_type()
            let string_type = _innate_symbol_lookup.get_string_type()

            let rendered =
                TEMP(
                    current_block,
                    "rendered",
                    Values.RUNTIME(
                        IR.RuntimeOperation.NEW_STRING_BUILDER,
                        Literal.NUMBER(0, int_type),
                        Literal.NUMBER(1, int_type),
                        _innate_symbol_lookup.get_interpolated_string_handler_type()
                    )
                )

            _append_fragment(location, rendered, eaf)

            let text = Values.RUNTIME(IR.RuntimeOperation.BUILD_STRING, rendered.load(), string_type)

            return TEMP(current_block, "hole", _type_caster.cast_value(location, text, string_type.as_optional(), true, false))
        si

        // The literal `true` or `false` as the bool `value` reads, which
        // allocates nothing.
        _bool_text(location: Source.LOCATION, value: Value, optional_string: Semantic.Types.Type) -> TEMP is
            let string_type = _innate_symbol_lookup.get_string_type()
            let result = TEMP(current_block, "hole", optional_string)

            let done = _open_region(LABEL())
            let true_arm = _open_region(LABEL())

            add(Values.BREAK(true_arm, IR.BRANCH.Z, value))
            add(_type_caster.cast_value(location, Literal.STRING("true", string_type), optional_string, true, false))
            add(Values.STORE_TEMP(result.local))
            add(Values.BREAK(done))

            _close_structured(true_arm)
            add(_type_caster.cast_value(location, Literal.STRING("false", string_type), optional_string, true, false))
            add(Values.STORE_TEMP(result.local))

            _close_structured(done)

            return result
        si

        // Appends one piece of an interpolation to `interpolator`: literal
        // text, or a hole's value read as its alignment and format say.
        _append_fragment(location: Source.LOCATION, interpolator: TEMP, eaf: Expressions.INTERPOLATION_FRAGMENT) is
            let string_type = _innate_symbol_lookup.get_string_type()

            let expression = eaf.expression
            let alignment = eaf.alignment
            let format = eaf.format
            let expr_value = expression.value!

            if !eaf.is_expression \/ _is_plain_string_literal_hole(eaf) then
                let literal = cast Expressions.Literals.STRING?(expression)!

                if literal.value_string.length == 0 then
                    return
                fi

                add(Values.RUNTIME(IR.RuntimeOperation.APPEND_TEXT, interpolator.load(), Literal.STRING(literal.value_string, string_type), null))
            elif !format? /\ !alignment? then
                _append_interpolated_value(location, interpolator, expr_value, null)
            elif _reads_differently_from_formatted(expr_value.type!) then
                // A value .NET would not print as ghūl does reads as it
                // would in a plain hole, and an alignment then pads that
                // text; a format applies where the rendering reaches a
                // value .NET formats, as the payload of an optional.
                if let aligned_by = alignment then
                    let rendered =
                        TEMP(
                            current_block,
                            "rendered",
                            Values.RUNTIME(
                                IR.RuntimeOperation.NEW_STRING_BUILDER,
                                Literal.NUMBER(0, _innate_symbol_lookup.get_int_type()),
                                Literal.NUMBER(1, _innate_symbol_lookup.get_int_type()),
                                _innate_symbol_lookup.get_interpolated_string_handler_type()
                            )
                        )

                    _append_interpolated_value(location, rendered, expr_value, format)

                    let text = TEMP(current_block, "text", Values.RUNTIME(IR.RuntimeOperation.BUILD_STRING, rendered.load(), string_type))

                    add(
                        Values.RUNTIME(
                            IR.RuntimeOperation.APPEND_ALIGNED_VALUE,
                            [interpolator.load(), text.load(), aligned_by.value!]:Value,
                            null,
                            string_type
                        )
                    )
                else
                    _append_interpolated_value(location, interpolator, expr_value, format)
                fi
            else
                let operands = Collections.LIST[Value](4)

                operands.add(interpolator.load())
                operands.add(expr_value)

                let operation: IR.RuntimeOperation mut

                if format? /\ alignment? then
                    operands.add(alignment.value!)
                    operands.add(Literal.STRING(format, string_type))

                    operation = IR.RuntimeOperation.APPEND_ALIGNED_FORMATTED_VALUE
                elif format? then
                    operands.add(Literal.STRING(format, string_type))

                    operation = IR.RuntimeOperation.APPEND_FORMATTED_VALUE
                else
                    operands.add(alignment!.value!)

                    operation = IR.RuntimeOperation.APPEND_ALIGNED_VALUE
                fi

                add(Values.RUNTIME(operation, operands, null, expr_value.type!))
            fi
        si

        // An interpolation whose text needs no builder: a single plain hole
        // holding a non-optional string is that string, or the empty string
        // where it is null, as appending it would give. An interpolation of
        // literal text alone still builds, so each evaluation gives a new
        // string, as one built from parts at run time does. Adds the value
        // and answers true, or adds nothing and answers false.
        _try_interpolation_shortcut(interpolation: Expressions.STRING_INTERPOLATION, string_type: Semantic.Types.Type) -> bool is
            let only_hole: Expressions.Expression? mut = null
            let holes mut = 0
            let any_text mut = false

            for eaf in interpolation.values do
                if !eaf.is_expression \/ _is_plain_string_literal_hole(eaf) then
                    let literal = cast Expressions.Literals.STRING?(eaf.expression)!

                    if literal.value_string.length > 0 then
                        any_text = true
                    fi
                else
                    holes = holes + 1

                    if !eaf.format? /\ !eaf.alignment? then
                        only_hole = eaf.expression
                    fi
                fi
            od

            if holes == 1 /\ !any_text then
                if let hole = only_hole, value = hole.value, type = value.type /\ !type.is_optional /\ type.compare(string_type) == Semantic.Types.MATCH.SAME then
                    add(Values.NULL_COALESCE(value, Literal.STRING("", string_type), string_type))

                    return true
                fi
            fi

            return false
        si

        // A hole that is a string literal with no alignment or format, such
        // as `"{"a"}"`: its text is known here.
        _is_plain_string_literal_hole(eaf: Expressions.INTERPOLATION_FRAGMENT) -> bool =>
            eaf.is_expression /\ !eaf.format? /\ !eaf.alignment? /\ isa Expressions.Literals.STRING(eaf.expression)

        // The number of code units an interpolation is predicted to take:
        // its literal text, and for each value the most its type usually
        // writes, at least the width an alignment pads it to.
        _estimated_capacity(interpolation: Expressions.STRING_INTERPOLATION) -> int is
            let total mut = interpolation.literal_length

            for eaf in interpolation.values do
                if !eaf.is_expression then
                    continue
                fi

                if _is_plain_string_literal_hole(eaf) then
                    total = total + cast Expressions.Literals.STRING(eaf.expression).value_string.length
                    continue
                fi

                let estimate mut =
                    if eaf.format? then
                        24
                    elif let value = eaf.expression.value, type = value.type then
                        _estimated_length(type)
                    else
                        16
                    fi

                if let alignment = eaf.alignment, literal: Values.Literal.NUMBER = alignment.value, width: Values.Literal.CONSTANT.I4 = literal.constant then
                    let padded = if width.value < 0 then -width.value else width.value fi

                    if padded > estimate then
                        estimate = padded
                    fi
                fi

                total = total + estimate
            od

            return total
        si

        // The most code units a value of `type` usually takes as text: the
        // longest number of its kind, `false` for a bool, one for a char,
        // and 16 for a string or anything else, whose length isn't known
        // here.
        _estimated_length(type: Semantic.Types.Type) -> int is
            let lookup = _innate_symbol_lookup
            let inner = if type.is_optional then type.optional_inner_type ?? type else type fi

            let estimate =
                if _is(inner, lookup.get_int_type()) \/ _is(inner, lookup.get_uint_type()) then 11
                elif _is(inner, lookup.get_long_type()) \/ _is(inner, lookup.get_ulong_type()) then 20
                elif _is(inner, lookup.get_short_type()) \/ _is(inner, lookup.get_ushort_type()) then 6
                elif _is(inner, lookup.get_byte_type()) \/ _is(inner, lookup.get_ubyte_type()) then 4
                elif _is(inner, lookup.get_char_type()) then 1
                elif _is(inner, lookup.get_bool_type()) then 5
                elif _is(inner, lookup.get_double_type()) \/ _is(inner, lookup.get_single_type()) then 24
                else 16
                fi

            // An absent optional reads as `null`.
            return if type.is_optional /\ estimate < 4 then 4 else estimate fi
        si

        _is(type: Semantic.Types.Type, other: Semantic.Types.Type) -> bool =>
            type.compare(other) == Semantic.Types.MATCH.SAME

        // Whether a plain hole renders a value of `type` other than as .NET
        // formats it, so an aligned or formatted hole has to render it first.
        _reads_differently_from_formatted(type: Semantic.Types.Type) -> bool =>
            case _interpolated_value_classifier.classify(type, false)
            when Semantic.InterpolatedValueRendering.BOOL, Semantic.InterpolatedValueRendering.OPTIONAL then true
            when Semantic.InterpolatedValueRendering.DISPLAYED then _display_function?
            else false
            esac

        // Append an interpolated value as INTERPOLATED_VALUE_CLASSIFIER says
        // it reads, with `format`, if any, applied where .NET formats it.
        _append_interpolated_value(location: Source.LOCATION, interpolator: TEMP, value: Value, format: string?) is
            let type = value.type!

            case _interpolated_value_classifier.classify(type, false)
            when Semantic.InterpolatedValueRendering.BOOL then
                _append_bool(location, interpolator, value)

            when Semantic.InterpolatedValueRendering.OPTIONAL then
                _append_optional(location, interpolator, value, format)

            when Semantic.InterpolatedValueRendering.DISPLAYED then
                if let display = _display_function then
                    _append_formatted(location, interpolator, display.call(location, null, [value]:Value, null, _function_caller))
                else
                    _append_formatted(location, interpolator, value)
                fi

            else
                _append_formatted(location, interpolator, value, format)
            esac
        si

        _append_formatted(location: Source.LOCATION, interpolator: TEMP, value: Value) is
            _append_formatted(location, interpolator, value, null)
        si

        _append_formatted(location: Source.LOCATION, interpolator: TEMP, value: Value, format: string?) is
            if let format_text = format then
                add(
                    Values.RUNTIME(
                        IR.RuntimeOperation.APPEND_FORMATTED_VALUE,
                        [interpolator.load(), value, Literal.STRING(format_text, _innate_symbol_lookup.get_string_type())]:Value,
                        null,
                        value.type!
                    )
                )
            else
                add(Values.RUNTIME(IR.RuntimeOperation.APPEND_VALUE, [interpolator.load(), value]:Value, null, value.type!))
            fi
        si

        _append_text(location: Source.LOCATION, interpolator: TEMP, text: string) is
            add(
                Values.RUNTIME(
                    IR.RuntimeOperation.APPEND_TEXT,
                    interpolator.load(),
                    Literal.STRING(text, _innate_symbol_lookup.get_string_type()),
                    null))
        si

        _append_bool(location: Source.LOCATION, interpolator: TEMP, value: Value) is
            let done = _open_region(LABEL())
            let true_arm = _open_region(LABEL())

            add(Values.BREAK(true_arm, IR.BRANCH.Z, value))
            _append_text(location, interpolator, "true")
            add(Values.BREAK(done))

            _close_structured(true_arm)
            _append_text(location, interpolator, "false")

            _close_structured(done)
        si

        // Append what an optional holds, by the rules for its non-optional
        // type, or `null` when it holds nothing.
        _append_optional(location: Source.LOCATION, interpolator: TEMP, value: Value, format: string?) is
            let type = value.type!
            let inner = type.optional_inner_type!

            if type.is_value_type /\ (!type.find_member("has_value")? \/ !type.find_member("value")?) then
                _append_formatted(location, interpolator, value, format)

                return
            fi

            let done = _open_region(LABEL())
            let present = _open_region(LABEL())

            if type.is_value_type then
                let has_value = type.find_member("has_value")!
                let payload = type.find_member("value")!

                let holder = TEMP(current_block, "optional", value)
                let symbol_loader = IoC.CONTAINER.instance.symbol_loader

                add(Values.BREAK(present, IR.BRANCH.Z, has_value.load(location, IR.Values.ADDRESS(holder.load()), symbol_loader)))
                _append_interpolated_value(location, interpolator, payload.load(location, IR.Values.ADDRESS(holder.load()), symbol_loader), format)
            else
                let holder = TEMP(current_block, "optional", inner)

                holder.store(value)

                add(Values.BREAK(present, IR.BRANCH.Z, holder.load()))
                _append_interpolated_value(location, interpolator, holder.load(), format)
            fi

            add(Values.BREAK(done))

            _close_structured(present)
            _append_text(location, interpolator, "null")

            _close_structured(done)
        si
    si

    // One piece of an interpolation built into a draft, held in the order
    // it is written.
    union DraftPiece is
        LITERAL(text: string)
        TEXT(text: TEMP)
        ALIGNED(text: TEMP, width: int)
        CHAR(unit: TEMP)
        DECIMAL(value: TEMP, is_unsigned: bool)
        FLOATING(value: TEMP, measure: Semantic.Symbols.Function, write: Semantic.Symbols.Function)
    si
si
