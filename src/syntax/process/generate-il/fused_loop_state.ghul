namespace Syntax.Process is
    use Collections

    // Where a fused loop in a generator or asynchronous body keeps what
    // it carries from one element to the next: the source's iterator,
    // and each stage's counter or delegate, all in frame fields so that
    // they survive the suspensions in the loop body.
    class FUSED_LOOP_STATE is
        frame: Semantic.Symbols.STATE_MACHINE_FRAME_BASE
        iterator_field: Semantic.Symbols.Field

        _stage_fields: List[Semantic.Symbols.Field?]?
        _stage_inits: List[IR.Values.Value?]?
        _stage_flags: List[Semantic.Symbols.Field?]?

        init(
            frame: Semantic.Symbols.STATE_MACHINE_FRAME_BASE,
            iterator_field: Semantic.Symbols.Field,
            stage_fields: List[Semantic.Symbols.Field?]?
        ) is
            self.init(frame, iterator_field, stage_fields, null)
        si

        // As above, where a stage's counter starts from `stage_inits` at
        // its position rather than from the stage's own argument: the
        // value a generated generator was passed it as.
        init(
            frame: Semantic.Symbols.STATE_MACHINE_FRAME_BASE,
            iterator_field: Semantic.Symbols.Field,
            stage_fields: List[Semantic.Symbols.Field?]?,
            stage_inits: List[IR.Values.Value?]?
        ) is
            self.frame = frame
            self.iterator_field = iterator_field
            _stage_fields = stage_fields
            _stage_inits = stage_inits
        si

        // As above, with the field a skip_while stage keeps its dropping
        // flag in, by stage position.
        init(
            frame: Semantic.Symbols.STATE_MACHINE_FRAME_BASE,
            iterator_field: Semantic.Symbols.Field,
            stage_fields: List[Semantic.Symbols.Field?]?,
            stage_inits: List[IR.Values.Value?]?,
            stage_flags: List[Semantic.Symbols.Field?]?
        ) is
            self.init(frame, iterator_field, stage_fields, stage_inits)

            _stage_flags = stage_flags
        si

        // What the stage at `index` starts its counter from, where that is
        // not its own argument.
        stage_init(index: int) -> IR.Values.Value? is
            if let inits = _stage_inits /\ index < inits.count then
                return inits[index]
            fi

            return null
        si

        // The frame field of the stage at `index`, or null for a stage
        // that carries nothing from one element to the next.
        stage_field(index: int) -> Semantic.Symbols.Field? is
            if let fields = _stage_fields /\ index < fields.count then
                return fields[index]
            fi

            return null
        si

        // The frame field a skip_while stage at `index` keeps its dropping
        // flag in, where it has one.
        stage_flag(index: int) -> Semantic.Symbols.Field? is
            if let flags = _stage_flags /\ index < flags.count then
                return flags[index]
            fi

            return null
        si
    si
si
