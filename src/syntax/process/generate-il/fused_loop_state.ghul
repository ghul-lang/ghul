namespace Syntax.Process is
    use Collections

    // Where a fused loop in a generator or asynchronous body keeps what
    // it carries from one element to the next: the source's iterator,
    // and each stage's counter, delegate or flag, all in frame fields so
    // that they survive the suspensions in the loop body.
    class FUSED_LOOP_STATE is
        frame: Semantic.Symbols.STATE_MACHINE_FRAME_BASE
        iterator_field: Semantic.Symbols.Field

        _stages: List[FUSED_STAGE_FIELDS]?

        init(
            frame: Semantic.Symbols.STATE_MACHINE_FRAME_BASE,
            iterator_field: Semantic.Symbols.Field,
            stages: List[FUSED_STAGE_FIELDS]?
        ) is
            self.frame = frame
            self.iterator_field = iterator_field
            _stages = stages
        si

        // What the stage at `index` starts its counter or delegate from,
        // where that is not its own argument: the parameter a generated
        // generator was passed it as.
        stage_init(index: int) -> IR.Values.Value? is
            if let parameter = _stage(index)?.parameter then
                return IR.Values.Load.LOCAL_ARGUMENT(parameter)
            fi

            return null
        si

        // The frame field of the stage at `index`, or null for a stage
        // that carries nothing from one element to the next.
        stage_field(index: int) -> Semantic.Symbols.Field? => _stage(index)?.carried

        // The frame field a skip_while stage at `index` keeps its dropping
        // flag in, where it has one.
        stage_flag(index: int) -> Semantic.Symbols.Field? => _stage(index)?.flag

        _stage(index: int) -> FUSED_STAGE_FIELDS? is
            if let stages = _stages /\ index < stages.count then
                return stages[index]
            fi

            return null
        si
    si

    // The locals one stage of a fused loop keeps what it carries in,
    // outside a state machine: a take, skip or index counter, or a hoisted
    // delegate, and a skip_while stage's dropping flag. Null where the
    // stage has none, or keeps it in a frame field instead.
    class FUSED_STAGE_TEMPS(
        carried: IR.TEMP? public,
        flag: IR.TEMP? public
    )
si
