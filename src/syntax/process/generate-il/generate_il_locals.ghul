namespace Syntax.Process is
    use IO.Std

    use System.Text.StringBuilder

    use Logging
    use Trees
    use Source

    use IR
    use IR.Values

    use Ghul.Pipes


    // Local-variable IL: assignments, variable visits, refutable bindings and destructuring.
    partial GENERATE_IL is
        visit(assign: Statements.ASSIGNMENT) is
            super.visit(assign)

            let v = assign.value
            if v? then
                add(v)
            fi
        si

        visit(expression: Statements.EXPRESSION) is
            super.visit(expression)

            try
                if !expression.want_value /\ expression.expression.value? then
                    let value = expression.expression.value

                    // `NULL.matches` answers true for every type, so a
                    // null-typed value reads as void here. It is not: emit
                    // it and pop, as for any other discarded statement
                    // value.
                    let is_void =
                        value.type? /\
                        !value.type.is_null /\
                        value.type.matches(_innate_symbol_lookup.get_void_type())

                    // Bare `await E;` with void result: visit(AWAIT)
                    // emitted the suspend eagerly; re-emitting the
                    // wrapper would call gen on its unreplaced DUMMY.
                    if is_void then
                        if !isa Values.WRAPPER(value) then
                            add(value)
                        fi
                    else
                        add(Values.DISCARD(value))
                    fi
                fi
            catch e: System.Exception
                _logger.exception(expression.location, e, "caught exception generating IL for expression")
            yrt
        si

        // A local's declaration is a slot in the body's signature, so
        // it is only a local at all inside a block. Answers whether
        // the symbol was taken as one.
        _declare_local(symbol: Semantic.Symbols.Symbol?) -> bool is
            if !_block_context.is_in_block then
                return false
            fi

            if let local: Semantic.Symbols.LOCAL_VARIABLE = symbol /\ local.type? then
                current_block.add(Values.DECLARE_LOCAL(local.ir_local))
            fi

            return true
        si

        pre(variable: Variables.VARIABLE) -> bool is
            super.pre(variable)

            if variable.want_dispose then
                // variable will be declared outside the enclosing .try
                // so don't declare it here
                return false
            fi

            // Generator / async body locals: `state_machine_field`
            // was wired up in compile-expressions (so closures
            // freezing inside the body capture the right
            // ldarg.0/ldfld IL). Skip emitting `.locals init` here;
            // load/store routes through the frame field via
            // state_machine_field.
            let cf = current_function
            if cf? then
                let sm_for_function = Semantic.Symbols.state_machine_for(cf)

                if sm_for_function? /\ sm_for_function.frame? then
                    return false
                fi

                let async_sm = Semantic.Symbols.async_state_machine_for(cf)

                if async_sm? /\ async_sm.frame? then
                    return false
                fi
            fi

            // A local's declaration is a value in the block: metadata
            // has no `.locals init` directive, and the slot it
            // allocates has to be in place before any load of the
            // same name is encoded. A declaration at namespace or
            // class scope is a field, whose row the structure walk
            // writes, so nothing is emitted for one here.
            if _block_context.is_in_block then
                for name in variable.names do
                    _declare_local(find(name))
                od
            fi

            return false
        si

        visit(v: Variables.VARIABLE) is
            let initializer = v.initializer
            if initializer? then
                let init_value = initializer.value
                if init_value? then
                    gen_destructuring_initialize(v.left, init_value)
                    return
                fi
            fi

            // Destructured formal argument: no initializer expression -
            // the "source" to destructure is the synthesised physical
            // parameter declare-members attached to this VARIABLE.
            if v.is_argument /\ !v.left.is_simple_name then
                let group_symbol = symbol_for(v)

                if group_symbol? then
                    gen_destructuring_initialize(v.left, group_symbol.load(v.location, null, _symbol_loader))
                fi

                return
            fi

            // No initializer, but the local is captured by a closure
            // and reassigned, so `mark-boxed-locals` promoted its slot
            // to `Ghul.BOX[T]`. Allocate the empty box at declaration —
            // `Variable.store` routes through `_store_boxed_local`,
            // which emits `newobj Ghul.BOX[T]::.ctor()` when the value
            // is null. Without this the slot stays null, then the
            // closure frame's ctor stashes a null box reference and
            // every later read or write NREs.
            if v.left.is_simple_name then
                // is_simple_name => SIMPLE_VARIABLE_LEFT, whose name is non-null
                let name = v.left.name!
                let symbol = find(name)

                if let variable: Semantic.Symbols.LOCAL_VARIABLE = symbol /\ variable.is_boxed then
                    add(variable.store_empty_box(v.left.location, _symbol_loader))
                    return
                fi
            fi

            // Loop-scoped `let x: T;` (no initializer) needs an
            // explicit default store: .NET only initialises locals
            // on method entry, so without re-zeroing each iteration
            // the variable carries its previous iteration's value
            // (issue #483). Outside a loop, the method-entry
            // initialisation is correct and we leave the existing
            // behaviour alone. Catch handlers receive their value
            // from the runtime — skip the default-store there too.
            if _loops.is_in_loop /\ !_in_catch_variable then
                gen_destructuring_default(v.left)
            fi
        si

        // `if let` clauses' bound names are declared as CLR locals
        // here — same as `pre(VARIABLE)` does for a plain let. The
        // store IL itself is emitted later by
        // `gen_destructuring_initialize` in the if-branch handler.
        pre(rb: Statements.REFUTABLE_BINDING) -> bool is
            let cf = current_function
            if cf? then
                let sm_for_function = Semantic.Symbols.state_machine_for(cf)

                if sm_for_function? /\ sm_for_function.frame? then
                    return false
                fi

                let async_sm = Semantic.Symbols.async_state_machine_for(cf)

                if async_sm? /\ async_sm.frame? then
                    return false
                fi
            fi

            for c in rb.clauses do
                for name in c.pattern.names! do
                    _declare_local(find(name))
                od
            od

            return false
        si

        visit(rb: Statements.REFUTABLE_BINDING) is
        si

        gen_destructuring_default(left: Variables.VariableLeft) is
            if left.is_simple_name then
                // is_simple_name => SIMPLE_VARIABLE_LEFT, whose name is non-null
                let name = left.name!
                let symbol = find(name)

                if !symbol? \/ symbol.is_argument then
                    return
                fi
                let symbol_type = symbol.type
                if !symbol_type? then return; fi

                let default_value = IR.Values.DEFAULT(symbol_type)

                let store = symbol.store(left.location, null, default_value, _symbol_loader, true)

                add(store)
            else
                for e in left.elements! do
                    gen_destructuring_default(e)
                od
            fi
        si

        // A sequence pattern over `value`: check how many elements it has,
        // then bind each leading element from its position and a rest element
        // from the remainder. The reads were built in compile-expressions over
        // a hole for the value, filled here. A refutable pattern leaves
        // `narrow_fail` when the count is wrong; anywhere else a wrong count
        // is an error.
        gen_sequence_destructuring_initialize(
            left: Variables.VariableLeft,
            elements: Collections.List[Variables.VariableLeft],
            value: Value,
            narrow_fail: Values.Breakable?
        ) is
            let state = _variable_left_state.get(left)

            if state?.lazy_sequence? then
                _gen_lazy_sequence_destructuring_initialize(left, elements, state!.lazy_sequence!, value, narrow_fail)

                return
            fi

            let sequence = state?.sequence

            if !sequence? then
                return
            fi

            let int_type = _innate_symbol_lookup.get_int_type()
            let has_rest = elements.count > 0 /\ elements[elements.count - 1].is_rest
            let head_count = if has_rest then elements.count - 1 else elements.count fi

            let source = TEMP(current_block, "sequence", value)

            sequence.source.value = source.load()

            let expected = IR.Values.Literal.NUMBER(head_count, int_type)

            if narrow_fail? then
                add(Values.BREAK(narrow_fail, if has_rest then BRANCH.LT else BRANCH.NE fi, sequence.count, expected))
            else
                add(IR.Values.SEQUENCE_COUNT_CHECK(
                    sequence.count,
                    expected,
                    has_rest,
                    IR.Values.Literal.STRING(
                        "{left.location}: a sequence pattern did not match",
                        _innate_symbol_lookup.get_string_type()),
                    _innate_symbol_lookup.get_void_type()))
            fi

            for i in 0..elements.count do
                let element_value =
                    if has_rest /\ i == head_count then
                        sequence.rest!
                    else
                        sequence.elements[i]
                    fi

                gen_destructuring_initialize(elements[i], element_value, narrow_fail)
            od
        si

        // A sequence pattern over a lazy sequence. The probe's pull is
        // lowered once - by the first arm to reach it - and every arm
        // tests `pulled` against the count its own pattern needs: the
        // elements it brought, and no more than those, are what any arm
        // of the statement can see. Leading elements bind from the
        // pull's locals; a rest element is the unmatched ones followed
        // by the iterator as the pull left it.
        _gen_lazy_sequence_destructuring_initialize(
            left: Variables.VariableLeft,
            elements: Collections.List[Variables.VariableLeft],
            lazy_values: LAZY_SEQUENCE_PATTERN_VALUES,
            value: Value,
            narrow_fail: Values.Breakable?
        ) is
            let probe = lazy_values.probe

            if !probe.lowered? then
                _lower_lazy_sequence_probe(probe, value)
            fi

            let locals = probe.lowered!
            let int_type = _innate_symbol_lookup.get_int_type()

            let expected = IR.Values.Literal.NUMBER(lazy_values.head_count, int_type)

            if narrow_fail? then
                add(Values.BREAK(narrow_fail, if lazy_values.has_rest then BRANCH.LT else BRANCH.NE fi, locals.pulled.load(), expected))
            else
                add(IR.Values.SEQUENCE_COUNT_CHECK(
                    locals.pulled.load(),
                    expected,
                    lazy_values.has_rest,
                    IR.Values.Literal.STRING(
                        "{left.location}: a sequence pattern did not match",
                        _innate_symbol_lookup.get_string_type()),
                    _innate_symbol_lookup.get_void_type()))
            fi

            for i in 0..elements.count do
                let element_value: Value =
                    if lazy_values.has_rest /\ i == lazy_values.head_count then
                        _gen_lazy_rest_value(lazy_values, locals)
                    else
                        locals.elements[i].load()
                    fi

                gen_destructuring_initialize(elements[i], element_value, narrow_fail)
            od
        si

        // Lower a probe's pull: take an iterator from the source (or
        // copy a value-type source that is its own iterator, so the
        // pull cannot touch the matched value), then pull up to
        // `pull_count` elements into locals, recording how many
        // arrived. The pull is unrolled - `pull_count` is the widest
        // head any arm matches, a handful of elements - which is what
        // lets each element live in its own local.
        _lower_lazy_sequence_probe(probe: LAZY_SEQUENCE_PROBE, source: Value) is
            let location = probe.location

            probe.source.value = source

            let iterator_value: Value =
                if probe.read_iterator? then
                    probe.read_iterator.call(location, probe.source.value!, Collections.LIST[Value](0), null, _function_caller)
                else
                    probe.source.value!
                fi

            let iterator = TEMP(current_block, "lazy_iter", iterator_value)

            let int_type = _innate_symbol_lookup.get_int_type()
            let pulled = TEMP(current_block, "lazy_pulled", IR.Values.Literal.NUMBER(0, int_type))

            let elements = Collections.LIST[IR.TEMP]()

            for i in 0..probe.pull_count do
                elements.add(TEMP(current_block, "lazy_element", IR.Values.DEFAULT(probe.element_type)))
            od

            let done = _open_region(LABEL())

            for i in 0..probe.pull_count do
                let has_next =
                    probe.move_next!.call(location, iterator.load(), Collections.LIST[Value](0), null, _function_caller)

                add(Values.BREAK(done, BRANCH.Z, has_next))

                add(probe.read_current!.call(location, iterator.load(), Collections.LIST[Value](0), null, _function_caller))
                add(Values.STORE_TEMP(elements[i].local))

                add(IR.Values.Literal.NUMBER(i + 1, int_type))
                add(Values.STORE_TEMP(pulled.local))
            od

            _close_structured(done)

            probe.lowered = LAZY_SEQUENCE_PROBE_LOCALS(iterator, pulled, elements)
        si

        // The value a rest element binds: the elements the pull took
        // past the leading ones, followed by what remained of the
        // iterator as the pull left it, through `Ghul.Pipes.buffered`.
        // The first read continues that iterator; every later read
        // re-derives from the source, skipping the elements the pattern
        // matched. How many unmatched elements there are is only known
        // at runtime, so when the pull could have brought more than the
        // arm matched, a chain of tests picks the construction for the
        // count that arrived.
        _gen_lazy_rest_value(
            lazy_values: LAZY_SEQUENCE_PATTERN_VALUES,
            locals: LAZY_SEQUENCE_PROBE_LOCALS
        ) -> Value is
            let probe = lazy_values.probe
            let unmatched_max = probe.pull_count - lazy_values.head_count

            if unmatched_max == 0 then
                return _call_buffered(probe, locals, lazy_values.head_count, 0, probe.pull_count)
            fi

            let rest_temp = TEMP(current_block, "lazy_rest", IR.Values.DEFAULT(lazy_values.rest_type))

            let done = _open_region(LABEL())

            for j in lazy_values.head_count::probe.pull_count do
                let skip = _open_region(LABEL())

                add(Values.BREAK(skip, BRANCH.NE, locals.pulled.load(), IR.Values.Literal.NUMBER(j, _innate_symbol_lookup.get_int_type())))

                add(_call_buffered(probe, locals, lazy_values.head_count, j - lazy_values.head_count, j))
                add(Values.STORE_TEMP(rest_temp.local))

                add(Values.BREAK(done))

                _close_structured(skip)
            od

            _close_structured(done)

            return rest_temp.load()
        si

        // One buffered pipe stage construction: the `count` unmatched
        // elements from `from` on as the prefix, the matched value's
        // source to re-derive from, `skip`, how many elements of it the
        // pattern consumed, and the pull's iterator for a first read to
        // continue. Counts past three chain single-element stages over
        // the live core, which is rarer than any arm matching that far
        // ahead.
        _call_buffered(
            probe: LAZY_SEQUENCE_PROBE,
            locals: LAZY_SEQUENCE_PROBE_LOCALS,
            from: int,
            count: int,
            skip: int
        ) -> Value is
            let stages = probe.rest_stages!
            let int_type = _innate_symbol_lookup.get_int_type()

            let live = locals.iterator.load()
            let source = probe.source.value!
            let skip_value = IR.Values.Literal.NUMBER(skip, int_type)

            if count <= 3 then
                let stage = stages[count]!

                return _new_buffered_stage(probe, stage, _prefix_arguments(probe, locals, from, count), source, skip_value, live)
            fi

            // The live core plays the tail; each stage out holds one
            // more unmatched element, outermost first, wrapping with no
            // live iterator of its own: its first read drives the stage
            // it wraps.
            let core = stages[0]!

            let value: Value mut =
                _new_buffered_stage(
                    probe,
                    core,
                    Collections.LIST[Value](),
                    source,
                    skip_value,
                    live)

            let wrap = stages[1]!
            let zero = IR.Values.Literal.NUMBER(0, int_type)

            for i in 0..count do
                let arguments = Collections.LIST[Value]([locals.elements[from + count - 1 - i].load()])

                value = _new_buffered_stage(probe, wrap, arguments, value, zero, null)
            od

            return value
        si

        // The prefix elements of a stage construction, before the
        // source, skip and live iterator every stage takes.
        _prefix_arguments(
            probe: LAZY_SEQUENCE_PROBE,
            locals: LAZY_SEQUENCE_PROBE_LOCALS,
            from: int,
            count: int
        ) -> Collections.List[Value] is
            let arguments = Collections.LIST[Value]()

            for i in 0..count do
                arguments.add(locals.elements[from + i].load())
            od

            return arguments
        si

        // One buffered pipe stage construction from its prefix
        // arguments, the source, the skip and the live iterator: a
        // plain NEW over the constructor's own formal types, so an
        // argument the stage holds as an interface - a value-type
        // source's iterator, a null live for a wrapping stage - is
        // converted to what the constructor takes.
        _new_buffered_stage(
            probe: LAZY_SEQUENCE_PROBE,
            stage: LAZY_REST_STAGE,
            prefix: Collections.List[Value],
            source: Value,
            skip: Value,
            live: Value?
        ) -> Value is
            let formals = stage.constructor.arguments
            let arguments = Collections.LIST[Value]()

            for i in 0..prefix.count do
                arguments.add(prefix[i])
            od

            let source_argument = _convert_for(stage.constructor, formals.count - 3, source, probe)
            arguments.add(source_argument)
            arguments.add(skip)

            let live_formal = formals[formals.count - 1].type
            let live_argument: Value mut =
                if live? then
                    _convert_for(stage.constructor, formals.count - 1, live!, probe)
                else
                    IR.Values.NULL(live_formal ?? probe.iterator_type)
                fi

            arguments.add(live_argument)

            return Values.NEW(stage.stage_type, stage.constructor, arguments)
        si

        // `value` as the constructor's formal at `at` takes it, cast
        // where it does not already match - the live iterator of a
        // value-type source, driven as itself, is one.
        _convert_for(
            constructor: Semantic.Symbols.Function,
            at: int,
            value: Value,
            probe: LAZY_SEQUENCE_PROBE
        ) -> Value is
            let formal = constructor.arguments[at].type

            if formal? /\ value.type? /\ value.type!.matches(formal!) then
                return value
            fi

            if !formal? then
                return value
            fi

            return _type_caster.cast_value(probe.location, value, formal!, true, false)
        si

        // TODO use Pre/Visit instead
        gen_destructuring_initialize(left: Variables.VariableLeft, value: Value) is
            gen_destructuring_initialize(left, value, null)
        si

        // Per-element narrowing: when `narrow_fail` is set (the `if
        // let` path), an element carrying a `type_expression` emits
        // `isinst T` and leaves `narrow_fail` on a mismatch before
        // binding. The cast result is what gets stored / recursively
        // destructured, so the bound slot is typed T. Plain `let` and
        // `for` pass null and just store the raw value (the declared
        // element type is a compile-time assertion only, not a runtime
        // test).
        gen_destructuring_initialize(
            left: Variables.VariableLeft,
            value: Value,
            narrow_fail: Values.Breakable?
        ) is
            // Literal-leaf inside a destructure pattern — runtime
            // value-equality test against the source position. Only
            // valid in refutable contexts (`if let` / `case`-when);
            // a plain `let` with a literal leaf is rejected during
            // semantic analysis, so by the time we get here a literal
            // leaf without a narrow_fail is a no-op (the
            // emit-nothing path).
            if isa Variables.LITERAL_VARIABLE_LEFT(left) then
                if narrow_fail? then
                    let literal_leaf = cast Variables.LITERAL_VARIABLE_LEFT(left)
                    let leaf_state = _variable_left_state.get(literal_leaf)

                    // The value-equality test compile-expressions built
                    // for this leaf embeds the literal and reads the
                    // source position through a hole; fill the hole and
                    // branch on the result. The test can read the
                    // operand more than once - a null-safe `=~` tests
                    // presence before dispatching - and an instance
                    // operator on a value type needs its address, so
                    // spill anything that is not already a local.
                    if let
                        test = leaf_state?.match_test,
                        operand = leaf_state?.match_operand
                    then
                        operand.value =
                            if value.is_lightweight_pure /\ value.has_address then
                                value
                            else
                                TEMP(current_block, "literal-leaf", value).load()
                            fi

                        add(Values.BREAK(narrow_fail, BRANCH.Z, test))

                        return
                    fi

                    // No test: a `null` leaf, or a type for which
                    // neither `=~` nor `<>` resolved. Compare raw, which
                    // is what a bare `==` does too.
                    literal_leaf.expression.walk(self)

                    let leaf_value = literal_leaf.expression.value
                    if leaf_value? then
                        add(Values.BREAK(narrow_fail, BRANCH.NE, value, leaf_value))
                    fi
                fi

                return
            fi

            let narrowed mut = value

            let type_expression = left.type_expression
            if
                type_expression? /\
                type_expression.type? /\
                narrow_fail?
            then
                let cast_value = IR.Values.CAST(type_expression.type, value, false)
                let temp = TEMP(current_block, "narrow", cast_value)

                add(Values.BREAK(narrow_fail, BRANCH.Z, temp.load()))

                narrowed = temp.load()
            fi

            if left.is_simple_name then
                // is_simple_name => SIMPLE_VARIABLE_LEFT, whose name is non-null
                let name = left.name!
                let symbol = find(name)

                if !symbol? then
                    return
                fi

                let store = symbol.store(left.location, null, narrowed, _symbol_loader, true)

                add(store)
            else
                let from_type = narrowed.type

                if !from_type? then return; fi

                // !is_simple_name => a destructure group, whose elements are non-null
                let elements = left.elements!

                if left.is_sequence then
                    gen_sequence_destructuring_initialize(left, elements, narrowed, narrow_fail)

                    return
                fi

                let get_from =
                    if narrowed.is_lightweight_pure then
                        () => narrowed
                    else
                        let temp = TEMP(current_block, "destructure", narrowed)
                        () => temp.load()
                    fi

                let is_named_group = elements.count > 0 /\ elements[0].source_field_name?

                let strategy =
                    if is_named_group then
                        let field_names = Collections.LIST[string?]()
                        for e in elements do
                            let sfn = e.source_field_name
                            field_names.add(if sfn? then sfn.name else null fi)
                        od
                        DESTRUCTURE_RESOLVER.resolve_strategy_by_name(from_type, field_names)
                    else
                        DESTRUCTURE_RESOLVER.resolve_strategy(from_type, elements.count)
                    fi

                if strategy.is_deconstruct then
                    // is_deconstruct ⇔ deconstruct_function? per its definition
                    let deconstruct = strategy.deconstruct_function!
                    let arg_temps = Collections.LIST[IR.TEMP]()
                    let call_args = Collections.LIST[Value]()

                    for i in 0..deconstruct.arguments.count do
                        let ref_type = deconstruct.arguments[i]
                        let element_type = ref_type.get_element_type()
                        assert element_type? else "deconstruct arg type has no element type"
                        let arg_temp = IR.TEMP(current_block, "destructure_arg", i, element_type)

                        arg_temps.add(arg_temp)
                        call_args.add(IR.Values.ADDRESS(arg_temp.load(), ref_type))
                    od

                    let call_value =
                        deconstruct.call(
                            left.location,
                            get_from(),
                            call_args,
                            null,
                            _function_caller
                        )

                    add(call_value)

                    for (i, e) in elements |> index() do
                        gen_destructuring_initialize(e, arg_temps[i].load(), narrow_fail)
                    od
                else
                    let members = strategy.members

                    for (i, e) in elements |> index() do
                        let member = members[i]

                        if member? then
                            let member_value = member.load(LOCATION.internal, get_from(), _symbol_loader)

                            gen_destructuring_initialize(e, member_value, narrow_fail)
                        fi
                    od
                fi
            fi
        si

    si
si
