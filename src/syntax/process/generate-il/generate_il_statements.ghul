namespace Syntax.Process is
    use System.Reflection.Metadata.ILOpCode
    use IO.Std

    use System.Text.StringBuilder

    use Logging
    use Trees
    use Source

    use IR
    use IR.Values

    use Ghul.Pipes


    // Statement walking: statement and block lists, assertions, pragmas, labelled loops, break and continue.
    partial GENERATE_IL is
        pre(statement: Expressions.STATEMENT) -> bool is
            super.pre(statement)

            return false
        si

        visit(statement: Expressions.STATEMENT) is
        si

        // `val ... lav` emits as the IL contained in block.value
        // (the BLOCK Value set by compile-expressions). The shape
        // mirrors how `if`/`case`-in-expression emit:
        //
        //   <body statements' IL>
        //   <tail value's IL>      ; pushes value (or empty for void)
        //   <return-targeted return inside body>: push value; br end
        //   end:                   ; value (or empty) on the stack
        //
        // The natural fall-through emits the tail's value at the end
        // of the body and falls into the label. Return-targeted
        // returns push their value and `br` to the same label. No
        // CLR local or frame field carries the value across the
        // join — so an async/yield suspend point inside the body
        // composes with the existing state-machine rewriting
        // without bespoke handling.
        pre(block: Trees.Expressions.VAL_BLOCK) -> bool is
            super.pre(block)

            if !block.value? \/ !isa Values.BLOCK(block.value) then
                // No usable value from compile-expressions (a
                // poisoned block, or a void-tolerant block whose
                // BLOCK has been set with void type — both still
                // need their body's IL to run for side effects).
                // Fall back to a plain walk; returns inside will
                // dispatch via val_block_target either way.
                return false
            fi

            let value_block = cast Values.BLOCK(block.value)

            // Capture-vs-spill decision: in a state machine whose
            // body contains a suspend, the val-block's result
            // routes through a frame field instead of being
            // captured inline in value_block. Body IL (including
            // suspend emission and val-targeted-return stores)
            // flows to outer current_block; value_block ends up
            // holding just a `ldfld` so consumers see a clean load.
            let spiller = COMPOSITE_VALUE_SPILLER(
                self,
                block,
                block.value,
                _current_state_machine_frame()
            )

            spiller.enter()

            try
                let end_label = LABEL()
                block.end_label = end_label

                let result_type = value_block.type
                let is_void = result_type.matches(_innate_symbol_lookup.get_void_type())

                let frame_il = VAL_BLOCK_IL(
                    block,
                    end_label,
                    result_type,
                    is_void,
                    _loops.open_try_count,
                    value_block
                )
                frame_il.spill_field = spiller.spill_field
                frame_il.region = _open_region(end_label)

                // Eagerly allocate the capture-mode cross-try TEMP
                // so its declaration is encoded at the head of
                // value_block rather than somewhere inside the
                // body: lazy allocation mid-body would leave the
                // post-body load of it reaching a slot that has
                // not been declared yet. The TEMP is
                // unused (and the join block un-emitted) when no
                // val-targeted return crosses an inner try — set
                // `cross_try_used` then drives the post-body
                // emission. Spill mode doesn't need either: the
                // frame field handles cross-try directly.
                if !is_void /\ !spiller.is_spilling then
                    frame_il.cross_try_temp = IR.TEMP(value_block, "val_cross_try", value_block.type)
                    frame_il.cross_try_join_region = _open_region(LABEL())
                fi

                _val_block_il_stack.add(frame_il)

                // A block whose own statements dispose something runs
                // them in a disposal region. A value cannot stay on the
                // stack across the region's end, so the tail goes to the
                // cross-try temp inside it and is loaded back after it,
                // as a return that crosses an inner try already does.
                let disposals = if block.body.want_dispose then block.body.variables_to_dispose else null fi
                let region = if disposals? then _open_disposal_region(disposals) else null fi
                let holds_tail_in_temp = region? /\ !is_void /\ !spiller.is_spilling

                try
                    for s in block.body.statements do
                        self.enter_node(s)
                        try
                            s.walk(self)
                        finally
                            self.leave_node(s)
                        yrt
                    od

                    // Natural fall-through. The tail statement is
                    // the last EXPRESSION in the body; in want_value
                    // mode visit(Statements.EXPRESSION) suppresses
                    // its own emission so the consuming context can
                    // emit the tail value. Val-block bypasses LIST,
                    // so we emit it here — the spiller picks spill-
                    // to-field or push-on-stack based on the mode
                    // chosen above. Val-targeted returns use the
                    // same emit_value path (see _gen_val_block_
                    // targeted_return), so all paths converge at
                    // end_label with the value on the stack (or in
                    // the spill field) consistently.
                    if let block.body.last?, last.value? then
                        // Coerce the fall-through value to the block's
                        // settled type so a value-type branch is boxed or
                        // wrapped (T → T?) and a genuine-null tail lowers
                        // to the optional's default — the same join the
                        // if / case paths apply to every arm value before
                        // spiller.emit_value.
                        let coerced =
                            if !is_void /\ !result_type.is_error then
                                _boxer.box_if_needed(value, result_type)
                            else
                                value
                            fi

                        if holds_tail_in_temp then
                            frame_il.cross_try_temp!.store(coerced)
                        else
                            spiller.emit_value(coerced)
                        fi
                    fi
                finally
                    assert _val_block_il_stack.count > 0 else "val_block_il_stack underflow"
                    _val_block_il_stack.remove_at(_val_block_il_stack.count - 1)
                yrt

                if region? then
                    _close_disposal_region(region, disposals!, block.location)

                    if holds_tail_in_temp then
                        add(frame_il.cross_try_temp!.load())
                    fi
                fi

                // Capture-mode cross-try paths stashed their value
                // into cross_try_temp and left cross_try_join_region.
                // Skip over the join on the natural path (tail value
                // already on the stack) so the join paths ldloc the
                // value back on and fall through to the end. Only
                // emit when the join was actually targeted —
                // otherwise the unconditional ldloc would push an
                // uninitialised value onto the end's stack on
                // divergent natural paths.
                if let join = frame_il.cross_try_join_region then
                    if frame_il.cross_try_used then
                        add(Values.BREAK(frame_il.region!))
                    fi

                    _close_structured(join)

                    if frame_il.cross_try_used then
                        add(frame_il.cross_try_temp!.load())
                    fi
                fi

                _close_structured(frame_il.region!)
            finally
                spiller.leave()
            yrt

            return true
        si

        visit(block: Trees.Expressions.VAL_BLOCK) is
            super.visit(block)
        si

        // Emit the conditional-throw IL shared between statement-form
        // `assert` and the expression-form `assert ... in expr`. Condition
        // value is tested by a conditional exit; on the failure path the
        // message (or default condition-printout) is loaded, optionally
        // wrapped in an AssertFailedException, and thrown. Falls through
        // at the success label.
        emit_assertion(
            location: Source.LOCATION,
            condition_value: IR.Values.Value,
            message: Trees.Expressions.Expression?,
            default_message_source: object
        ) is
            let passed = _open_region(LABEL())

            add(Values.BREAK(passed, BRANCH.NZ, condition_value))

            let need_exception_wrapper mut = true

            if message? then
                let message_value = message.value
                if !_innate_symbol_lookup.get_exception_type().is_assignable_from(message_value!.type!) then
                    add(
                        Literal.STRING(
                            "{location}: ",
                            _innate_symbol_lookup.get_string_type()
                        )
                    )

                    add(message_value!)

                    add(Values.CALL_STRING_CONCAT())
                else
                    add(message_value!)
                    need_exception_wrapper = false
                fi
            else
                add(
                    Literal.STRING(
                        "{location}: {default_message_source}",
                        _innate_symbol_lookup.get_string_type()
                    )
                )
            fi

            if need_exception_wrapper then
                add(Values.NEW_ASSERT_FAILED_EXCEPTION())
            fi

            add(Values.INSTRUCTION(ILOpCode.THROW))

            _close_structured(passed)
        si

        visit(`assert: Statements.ASSERT) is
            super.visit(`assert)

            emit_assertion(
                `assert.location,
                `assert.expression.value!,
                `assert.message,
                `assert.expression
            )
        si

        pre(assert_in: Expressions.ASSERT_IN) -> bool is
            super.pre(assert_in)

            assert_in.condition.walk(self)

            if assert_in.message? then
                assert_in.message.walk(self)
            fi

            emit_assertion(
                assert_in.location,
                assert_in.condition.value!,
                assert_in.message,
                assert_in.condition
            )

            assert_in.expression.walk(self)

            return true
        si

        visit(assert_in: Expressions.ASSERT_IN) is
            assert_in.compile_expressions_state.value = assert_in.expression.value
        si

        pre(list: Statements.LIST) -> bool is
            super.pre(list)
            return true
        si

        visit(list: Statements.LIST) is
            // BLOCK-with-suspend spill. When the LIST is in a value-
            // required position (list.value non-null) AND we're in
            // a state machine AND any statement (outside nested
            // function literals) contains an `await` or `yield`, the
            // captured-IL pattern would trap the suspend's `leave` /
            // `ret` inside list.value's BLOCK; when the consumer
            // later gens that BLOCK, the suspend replays wrapped in
            // the consumer's stack setup (receiver on stack at leave
            // is invalid IL; state lost across yield's MoveNext re-
            // entry breaks the next stfld). Spill the BLOCK's value
            // to a frame field: body IL (including the suspend)
            // flows to outer current_block in the same flat MoveNext-
            // body stream as the dispatcher; the BLOCK is rewritten
            // to a load of the spill field. The recursive case (val-
            // block inside `if` in expression position, etc.) works
            // because each composite's spill produces a clean load
            // for its enclosing composite.
            //
            // The `want_dispose` (RAII) path keeps the existing .try
            // wrapping — its body must live inside the protected
            // region.
            if _try_spill_block_with_suspend(list) then
                return
            fi

            if list.value? then
                enter_block(cast IR.Values.BLOCK?(list.value)!)
            fi

            // A statement list leaves its tail value on the stack for
            // whatever consumes the list - the function epilogue's
            // `ret`, or an enclosing expression. A disposal region is
            // left with `leave`, which empties the stack, so a tail
            // inside one is stored here and loaded again once the
            // region is behind it.
            let tail_value: TEMP? mut = _

            // The same, for a tail statement that is itself a disposal
            // region because it holds a `let use ... in` expression.
            let statement_tail: TEMP? mut = _

            let region =
                if list.want_dispose then
                    _open_disposal_region(list.variables_to_dispose)
                else
                    null
                fi

            for s in list.statements do
                enter_node(s)
                try
                    if let disposals = s.let_in_disposals then
                        let statement_region = _open_disposal_region(disposals)

                        s.walk(self)

                        if list.value? /\ s == list.last then
                            if let value = s.value then
                                statement_tail = TEMP(current_block, "tail", _tail_type(list))
                                statement_tail.store(value)
                            fi
                        fi

                        _close_disposal_region(statement_region, disposals, s.location)
                    else
                        s.walk(self)
                    fi
                finally
                    leave_node(s)
                yrt
            od

            if list.value? then
                if let list.last?, last.value? then
                    let tail_mut = statement_tail?.load() ?? value

                    // A null tail in a block typed for a function's optional
                    // return is that optional's empty value.
                    let block_type = cast IR.Values.BLOCK?(list.value)!.type
                    let tail =
                        if tail_mut.type? /\ tail_mut.type.is_null /\ !block_type.is_null then
                            _boxer.box_if_needed(tail_mut, block_type)
                        else
                            tail_mut
                        fi

                    if region? then
                        tail_value = TEMP(current_block, "tail", _tail_type(list))

                        tail_value.store(tail)
                    else
                        add(tail)
                    fi
                fi
            fi

            if region? then
                _close_disposal_region(region, list.variables_to_dispose, list.location)

                if tail_value? then
                    add(tail_value.load())
                fi
            fi

            if list.value? then
                leave_block()
            fi
        si

        // The type a list's tail presents rather than the value's own: a
        // tail of `null` has the null type, which no local can be
        // declared with, and a body whose every contribution is null
        // takes its type from what the function returns.
        _tail_type(list: Statements.LIST) -> Semantic.Types.Type is
            let block = cast IR.Values.BLOCK?(list.value)!
            let return_type = current_function!.return_type

            return
                if block.type.is_null /\ return_type? then
                    return_type
                else
                    block.type
                fi
        si

        // Opens a `.try` whose `finally` disposes `variables`. The locals
        // are declared outside it, so that `finally` can still reach them
        // after an exception has left the region. Inside a state machine
        // the region gets its own dispatch holder, so that awaits and
        // yields within it register there and keep their resume branches
        // in the same protected region.
        _open_disposal_region(variables: Collections.List[Semantic.Symbols.Variable]) -> DISPOSAL_REGION is
            let (outer_try, return_needed, return_value) = get_exception_handler_temps()

            for v in variables do
                _declare_local(v)
            od

            let label = _loops.enter_try(return_needed, return_value)
            let `try = Values.TRY(label.start, _innate_symbol_lookup.get_void_type())

            label.structured_try = `try

            _open_structured(`try)

            return DISPOSAL_REGION(outer_try, return_value, label, `try, _maybe_push_dispatch_holder())
        si

        // Closes a region opened by _open_disposal_region, disposing its
        // locals in reverse order of declaration and skipping any that
        // are null. The finally body is state-guarded, so a suspend's
        // `leave` does not dispose.
        _close_disposal_region(
            region: DISPOSAL_REGION,
            variables: Collections.List[Semantic.Symbols.Variable],
            location: Source.LOCATION
        ) is
            let try_label = region.label

            _maybe_pop_dispatch_holder(region.dispatch_holder)

            ensure_runtime_symbols_are_materialized()

            try_label.is_in_finally = true

            add(Values.BREAK(region.`try))

            _close_try_body(region.`try)

            let finally_region = _open_finally_region(region.`try, try_label)

            let skip_dispose = _open_finally_state_guard()

            let i mut = variables.count - 1

            while i >= 0 do
                let v = variables[i]

                let skip: Values.REGION? mut = null

                if !v.type!.is_value_type then
                    skip = _open_region(LABEL())

                    // v.load rather than load_local_variable: a top-level
                    // `let use` promotes the variable to a field on the
                    // globals container, whose owner is not the current
                    // function, and load_local_variable would route it
                    // through the captured-value path. Both loads carry
                    // the variable's own location rather than the list's:
                    // the list starts before the declaration, which a
                    // top-level variable reads as use-before-declaration.
                    add(Values.BREAK(skip, BRANCH.Z, v.load(v.location, null, _symbol_loader)))
                fi

                let variable_value = v.load(v.location, null, _symbol_loader)
                let dispose_call = _dispose.call(location, variable_value, System.Array.empty`[Value](), null, _function_caller)

                add(dispose_call)

                if skip? then
                    _close_structured(skip)
                fi

                i = i - 1
            od

            _close_finally_state_guard(skip_dispose)

            _close_finally_region(finally_region)

            _loops.leave_loop()

            region.`try.close()

            gen_exception_handler_exit(region.outer_try, try_label, region.return_value)
        si

        pre(pragma: Statements.PRAGMA) -> bool is
            process_pragma(pragma.pragma, true)
            return false
        si

        visit(pragma: Statements.PRAGMA) is
            process_pragma(pragma.pragma, false)
        si

        pre(labelled: Statements.LABELLED) -> bool is
            super.pre(labelled)

            return true
        si

        visit(labelled: Statements.LABELLED) is
            _loops.next_name(labelled.label.name)

            labelled.statement.walk(self)

            super.visit(labelled)
        si

        visit(`break: Statements.BREAK) is
            // A valued break delivers to the innermost *consuming* loop,
            // skipping intermediate loops that are not expressions. A
            // labelled break follows its resolved target; a bare one
            // exits the innermost loop.
            let target mut =
                if let `break.expression? /\ !`break.resolved_target? then
                    _loops.find_value_loop()
                elif let `break.resolved_target? then
                    _loops.find_by_node(`break.resolved_target!)
                else
                    _loops.get_current_loop()
                fi

            if !target? then
                // Reported at compile-expressions; nothing to emit.
                return
            fi

            let expression = `break.expression

            // A valued break delivers its value to the loop's
            // convergence point (see _gen_loop_result). The three
            // shapes mirror _gen_val_block_targeted_return: spill mode
            // stores to the frame field; capture mode pushes and
            // branches; capture crossing a `.try` stashes into the
            // loop's cross-try TEMP and `leave`s to the join.
            if
                target.wants_value /\
                expression? /\
                expression.value?
            then
                let result_type = target.result_type!

                let v =
                    if let value = expression.value then
                        _boxer.box_if_needed(value, result_type)
                    else
                        IR.Values.DEFAULT(result_type)
                    fi

                if let spill_field = target.spill_field then
                    add(_build_frame_field_store(_current_state_machine_frame()!, spill_field, v))
                    add(Values.BREAK(target.result_region!))
                elif _loops.open_try_count <= target.enclosing_try_count then
                    add(v)
                    add(Values.BREAK(target.result_region!))
                else
                    assert target.cross_try_temp? else "value-carrying loop missing cross-try TEMP"
                    assert target.cross_try_join_region? else "value-carrying loop missing cross-try join"

                    target.cross_try_used = true
                    target.cross_try_temp!.store(v)
                    add(Values.BREAK(target.cross_try_join_region!))
                fi

                return
            fi

            // Bare break — including a valued one under a loop that
            // consumes nothing, which compile-expressions has already
            // reported. The natural-exit path yields absence.
            add(Values.BREAK(target.structured!))
        si

        visit(`continue: Statements.CONTINUE) is
            // Unresolved labels and loop-less continues were reported at
            // compile-expressions; nothing user-facing is diagnosed here.
            let target mut =
                if let `continue.resolved_target? then
                    _loops.find_by_node(`continue.resolved_target!)
                else
                    _loops.get_current_loop()
                fi

            if !target? then
                return
            fi

            add(Values.CONTINUE(target.structured!))
        si

    si

    // A disposal region between _open_disposal_region and
    // _close_disposal_region.
    class DISPOSAL_REGION(
        outer_try: LOOP_LABELS?,
        return_value: TEMP?,
        label: LOOP_LABELS,
        `try: IR.Values.TRY,
        dispatch_holder: ASYNC_DISPATCH_HOLDER?
    )
si
