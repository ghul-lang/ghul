namespace Syntax.Process is
    use Collections.LIST

    use Semantic.Types.Type

    // The operands a failing `assert` reports, each held in the local it
    // was evaluated into before the condition was tested, and how the
    // report labels them.
    class ASSERT_REPORT is
        // Whether the condition is a call, whose operands are its
        // arguments, rather than a comparison of two sides.
        is_call: bool

        entries: LIST[(label: string, local: IR.LOCAL)]

        count: int => entries.count

        init(is_call: bool) is
            self.is_call = is_call
            entries = LIST[(label: string, local: IR.LOCAL)]()
        si

        add(label: string, local: IR.LOCAL) is
            entries.add((label = label, local = local))
        si

        // The comparison operators whose two sides a failing assert reports.
        is_comparison(name: string) -> bool static =>
            name =~ "=~" \/ name =~ "!~" \/ name =~ "==" \/ name =~ "!=" \/
            name =~ "<" \/ name =~ "<=" \/ name =~ ">" \/ name =~ ">="

        // The quote a value of `type` is written between, so a string or a
        // character reads as one: `inspect` writes a string itself unquoted.
        // None for an optional, whose absent value is written as `null`.
        quote_for(type: Type, lookup: Semantic.Lookups.InnateSymbolLookup) -> string static is
            if lookup.get_string_type().compare(type) == Semantic.Types.MATCH.SAME then
                return "\""
            fi

            if lookup.get_char_type().compare(type) == Semantic.Types.MATCH.SAME then
                return "'"
            fi

            return ""
        si

        // Whether `value` can be held in a local and written by `inspect`:
        // not void, not the type of a `null` literal or one not yet settled,
        // not a reference or pointer, and not a function, whose text says
        // nothing about why the assert failed.
        can_report(value: IR.Values.Value) -> bool static is
            let type = value.type

            if !type? \/ type.is_void \/ type.is_null \/ type.is_function then
                return false
            fi

            if isa Semantic.Types.REFERENCE(type) \/ isa Semantic.Types.POINTER(type) then
                return false
            fi

            return true
        si
    si
si
