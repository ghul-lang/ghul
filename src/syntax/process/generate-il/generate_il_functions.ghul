namespace Syntax.Process is
    use IO.Std

    use System.Text.StringBuilder

    use Logging
    use Trees
    use Source

    use IR
    use IR.Values

    use Ghul.Pipes


    // Function and closure IL: plain function pre/visit and body generation, closure walking and
    // the async-closure prologue.
    partial GENERATE_IL is
        pre(function: Definitions.FUNCTION) -> bool is
            let symbol = function_for(function)!

            // Generator branch: a `*_GENERATOR_*` function expands
            // into TWO IL methods (the outer stub returning a fresh
            // state-machine instance + the state machine class with
            // its MoveNext / get_Current / GetEnumerator / Dispose /
            // Reset implementations). The split is handled by the
            // gen-generator-function path so the rest of generate_il
            // doesn't need to know.
            //
            // Both branches come before ordinary function emission,
            // because a state machine is a shape rather than a body:
            // the expansion has to happen before any of the pieces it
            // produces can be emitted.
            let state_machine = Semantic.Symbols.state_machine_for(cast Semantic.Symbols.Function?(symbol)!)

            if state_machine? then
                return _pre_generator_function(function, cast Semantic.Symbols.Function?(symbol)!, state_machine)
            fi

            // Async branch (parallel to the generator branch above).
            let async_sm = Semantic.Symbols.async_state_machine_for(cast Semantic.Symbols.Function?(symbol)!)

            if async_sm? then
                return _pre_async_function(function, cast Semantic.Symbols.Function?(symbol)!, async_sm)
            fi

            return _pre_function_body(function, cast Semantic.Symbols.Function?(symbol)!)
        si

        // The body of every function the assembly defines, begun here
        // and finished against the function's symbol once the walk of
        // it is done.
        _pre_function_body(function: Definitions.FUNCTION, symbol: Semantic.Symbols.Function) -> bool is
            // A declaration with no body - an abstract method, or a
            // trait member left to its implementors - has nothing to
            // encode, and its row is marked abstract rather than
            // pointed at an empty body.
            if symbol.is_abstract then
                return true
            fi

            // A method that calls into a shared library has no body of
            // its own: the runtime builds the call from the import its
            // row names.
            if symbol.pinvoke? then
                return true
            fi

            enter_scope(function)

            _backend.begin_body()

            // Which function the assembly enters at was settled by
            // select-entry-point, before any IL was written; this hands
            // the choice to the backend as the walk reaches it.
            if symbol.is_entry_point then
                IoC.CONTAINER.instance.entry_point.seen = true

                _backend.mark_entry_point(symbol)
            fi

            enter_block()

            return false
        si

        // Walk an inlined literal's body into the block the fused loop
        // emits, so every placeholder in it is filled by the ordinary
        // visit of its own node, exactly as it would be in any method.
        //
        // Called both from the literal's own visit and from the fused
        // loop's emission, because which runs first differs by path: a
        // `for` loop emits its stages before the walk reaches the literal,
        // and a terminal consumer's literal is walked as a call argument
        // before the call's value is emitted. Filling once, from whichever
        // arrives first, needs no knowledge of the order.
        fill_inlined_body(closure: Semantic.Symbols.Closure) is
            if closure.is_inlined_body_filled then
                return
            fi

            closure.is_inlined_body_filled = true

            enter_block(closure.inlined_block!)

            closure.inlined_body_node!.walk(self)

            add(closure.inlined_body_node!.value!)

            leave_block()
        si

        // The tail of `visit(function)` below.
        _visit_function_body(function: Definitions.FUNCTION, symbol: Semantic.Symbols.Function) is
            if System.Environment.get_environment_variable("GHUL_EMIT_TRACE")? then
                IO.Std.error.write_line("emit: {symbol.qualified_name} {symbol.location}")
            fi

            // A body-less method that overrides an implemented one has
            // a slot to fill and nothing to fill it with, so the body
            // is a throw naming the method rather than a load of the
            // return type's default.
            let throws_unimplemented = symbol.throws_unimplemented

            if throws_unimplemented then
                add(
                    Values.THROW(
                        Values.RUNTIME(
                            IR.RuntimeOperation.NEW_NOT_IMPLEMENTED,
                            Values.Literal.STRING(symbol.qualified_name, _innate_symbol_lookup.get_string_type()),
                            null)))
            fi

            // An implicit tail return delivers the body list's captured
            // value - the whole body IL ending in the tail's value - boxed
            // against the declared return type, in place of the default
            // value loaded below.
            let tail = if throws_unimplemented then null else _function_body_tail(function.body) fi

            if tail? then
                add(_boxer.box_if_needed(tail, symbol.return_type!))
            fi

            _backend.write(current_block)

            leave_block()

            // A non-void function ends with a default value loaded
            // ahead of the trailing `ret`. The
            // `ret` is unreachable whenever every path already
            // returned, but unreachable is not the same as unverified:
            // a method containing a protected region is checked whole,
            // so a bare `ret` where a value is due is rejected outright
            // rather than pruned.
            //
            // A body that delivered a tail value already leaves exactly
            // that value on the stack, so no default load follows it.
            // A machine-less result-less task-like return completes
            // here instead of loading the default: its fall-through
            // owes a handle, and the builder produces one.
            if !tail? /\ !throws_unimplemented then
                if let return_type = symbol.return_type then
                    if return_type.compare(_innate_symbol_lookup.get_void_type()) != Semantic.Types.MATCH.SAME then
                        if let completion = _builder_task_like_completion(symbol, return_type) then
                            _backend.write(completion)
                        else
                            _backend.write(Values.DEFAULT_RETURN(return_type))
                        fi
                    fi
                fi
            fi

            _backend.write(Values.RET())

            _backend.finish_body(symbol)
            _backend.end_body()

            leave_scope(function)
        si

        // The completion value a machine-less body owes for a bare
        // `return;` or a fall-through: the handle produced by driving
        // the task-like's own builder. Which return types complete this
        // way is TASK_CONVERSION's to say - asking it rather than
        // restating it keeps emission and the semantic side, which
        // suppresses the definite-return warning on the same answer,
        // from drifting apart. A state machine's own trailer completes
        // through the builder field, so a body with one never asks.
        _builder_task_like_completion(
            function_symbol: Semantic.Symbols.Function,
            return_type: Semantic.Types.Type?
        ) -> IR.Values.Value? is
            if
                Semantic.Symbols.async_state_machine_for(function_symbol)? \/
                Semantic.Symbols.state_machine_for(function_symbol)?
            then
                return null
            fi

            if let task_like = _task_conversion.builder_completion_for(return_type) then
                return IR.Values.COMPLETED_TASK_LIKE(return_type!, task_like.builder_type)
            fi

            return null
        si

        // The captured value of a function body whose final statement is
        // an implicit tail return - the whole body IL, ending in the
        // tail's value - or null when the body delivers nothing
        // (terminated tails, empty bodies, void bodies, generators).
        _function_body_tail(body: Trees.Bodies.Body?) -> IR.Values.Value? is
            if let block = cast Trees.Bodies.BLOCK?(body) then
                if let v = block.statements.compile_expressions_state.value then
                    return v
                fi
            fi

            return null
        si

        // Deliver what an async body produces to its state machine's
        // result, before the leave to the success label whose trailer
        // reads that field to complete the builder.
        _gen_async_body_result(
            body: Trees.Bodies.Body?,
            frame: Semantic.Symbols.ASYNC_STATE_MACHINE_FRAME
        ) is
            if let result_field = frame.result_field, class_result_type = frame.class_result_type then
                if let value = _async_body_value(body) then
                    add(_build_frame_field_store(
                        frame,
                        result_field,
                        _boxer.box_if_needed(value, class_result_type)
                    ))
                fi

                return
            fi

            // A result-less machine has nowhere to put a value, so an
            // expression body is emitted for its effects and whatever it
            // leaves standing is dropped. A block body's statements have
            // already emitted themselves.
            if let expression_body = cast Trees.Bodies.EXPRESSION?(body) then
                if let value = expression_body.expression.value then
                    if value.type? /\ !value.type.is_void then
                        add(Values.DISCARD(value))
                    else
                        add(value)
                    fi
                fi
            fi
        si

        // What an async body leaves for the result field. A block body
        // leaves its tail; an `=> body` leaves its expression, whose own
        // visitor emits nothing when the machine has a result field so
        // the value arrives here once.
        _async_body_value(body: Trees.Bodies.Body?) -> IR.Values.Value? is
            if let expression_body = cast Trees.Bodies.EXPRESSION?(body) then
                return expression_body.expression.value
            fi

            return _function_body_tail(body)
        si

        visit(function: Definitions.FUNCTION) is
            let symbol = symbol_for(function)

            let state_machine = Semantic.Symbols.state_machine_for(cast Semantic.Symbols.Function?(symbol)!)

            if state_machine? then
                _visit_generator_function(function, cast Semantic.Symbols.Function?(symbol)!, state_machine)

                return
            fi

            let async_sm = Semantic.Symbols.async_state_machine_for(cast Semantic.Symbols.Function?(symbol)!)

            if async_sm? then
                // _pre_async_function already emitted the outer
                // method and stashed the move_next block onto
                // _pending_async_state_machines. Nothing else to
                // do at AST visit time.
                return
            fi

            let symbol_function = cast Semantic.Symbols.Function?(symbol)!

            if !symbol_function.is_abstract /\ !symbol_function.pinvoke? then
                _visit_function_body(function, symbol_function)
            fi
        si

        pre(function: Trees.Expressions.FUNCTION) -> bool is
            super.pre(function)

            let closure = cast Semantic.Symbols.Closure?(scope_for(function))

            if !closure? then
                return true
            fi

            closure.map_type_arguments()

            return true
        si

        // A function literal's body is a method of its own, so the loops
        // and protected regions it is written inside are not ones it can
        // branch out of: a return in it leaves its own method, whatever
        // try, disposal region or loop encloses the literal.
        visit(function: Trees.Expressions.FUNCTION) is
            let enclosing_loops = _loops

            _loops = LOOP_LABEL_STACK()

            _visit_function_literal(function)

            _loops = enclosing_loops
        si

        _visit_function_literal(function: Trees.Expressions.FUNCTION) is
            let closure = cast Semantic.Symbols.Closure?(scope_for(function))!

            // A literal compiled inline has no method to emit. Its body is
            // walked here, into the block the fused loop emits, so every
            // placeholder in it - an interpolation's block, a cast's
            // wrapper, a statement list's block - is filled in place by the
            // ordinary visit of that node, exactly as it is in any method.
            if closure.inlined_block? then
                fill_inlined_body(closure)

                super.visit(function)

                return
            fi

            // Async closure dispatch (parallel to the named-function
            // path in pre(Definitions.FUNCTION)). The lambda's $anon
            // method body becomes a state-machine launch sequence
            // (Create + MoveNext + return Task); the lambda body
            // walks into a separate move_next_block; the SM class is
            // queued for emission at class/namespace tail.
            // Generator closure dispatch: the literal's body becomes a
            // generator's MoveNext, and its own method constructs the
            // frame and returns it.
            if let state_machine = Semantic.Symbols.state_machine_for(closure) then
                _emit_generator_closure(function, closure, state_machine)
                super.visit(function)
                closure.unmap_type_arguments()
                return
            fi

            let async_sm = Semantic.Symbols.async_state_machine_for(closure)
            if async_sm? then
                _emit_async_closure(function, closure, async_sm)
                super.visit(function)
                closure.unmap_type_arguments()
                return
            fi

            enter_block()

            // Safety net: if a closure's return type resolved to ERROR
            // (e.g. its body referenced a variable that itself never got
            // a type), the consume-side check that should have surfaced
            // a diagnostic missed this path — but `get_il_type()` will
            // throw NotImplementedException as soon as we ask it to emit
            // ERROR. Report a located diagnostic at the function's site
            // and skip IL emission for this body. The function symbol
            // itself remains valid; any caller will already have its
            // own ERROR-typed result and will be handled by its own
            // visit. (See error.ghul:30-34 for the underlying rule.)
            if closure.return_type? /\ closure.return_type.is_error then
                _logger.error(function.location, "cannot infer return type here")
                leave_block()
                super.visit(function)
                closure.unmap_type_arguments()
                return
            fi

            // The closure's body is a body of its own, begun while the
            // enclosing one is still open. Its values name types in the
            // closure's terms, so the backend is told which member it
            // is writing into.
            _backend.begin_body(closure)

            _gen_closure_destructure_prologue(function, closure)

            function.body.walk(self)

            // An implicit tail return delivers the body list's captured
            // value boxed against the closure's return type, in place of
            // the default value a non-void fall-off loads.
            let closure_tail = _function_body_tail(function.body)

            if let ct = closure_tail, crt = closure.return_type then
                add(_boxer.box_if_needed(ct, crt))
            elif
                closure.return_type? /\
                closure.return_type.compare(_innate_symbol_lookup.get_void_type()) != Semantic.Types.MATCH.SAME
            then
                if let completion = _builder_task_like_completion(closure, closure.return_type) then
                    add(completion)
                else
                    add(Values.DEFAULT_RETURN(closure.return_type!))
                fi
            fi

            add(Values.RET())

            _backend.write(current_block)

            leave_block()

            _backend.finish_body(closure)
            _backend.end_body()

            super.visit(function)

            closure.unmap_type_arguments()
        si

        // Declare and fill the names bound by any destructured lambda
        // parameter, before the body that reads them runs. The
        // parameter itself is one physical argument holding the
        // aggregate; its leaves are ordinary locals, so they need both
        // a `.locals init` slot and the unpacking stores - the same
        // pair `pre(Variables.VARIABLE)` and `visit(Variables.VARIABLE)`
        // emit for a named function's destructured formal argument.
        _gen_closure_destructure_prologue(
            function: Trees.Expressions.FUNCTION,
            closure: Semantic.Symbols.Closure
        ) is
            _gen_packed_parameter_prologue(function.location, closure)

            for a in function.arguments.expressions do
                let argument = cast Trees.Expressions.VARIABLE?(a)

                if !argument? \/ !argument.left? then
                    continue
                fi

                let left = argument.left

                for name in left.names! do
                    _declare_local(closure.find_direct(name.name))
                od

                let group_symbol = closure.find_direct(argument.name.name)

                if group_symbol? then
                    gen_destructuring_initialize(left, group_symbol.load(argument.location, null, _symbol_loader))
                fi
            od
        si

        // A literal written with an argument pack spread out is emitted
        // taking the pack's tuple. Each parameter it declared is a local,
        // filled from the tuple before the body that reads it runs. The
        // pack binds to anything that destructures by position, so the
        // elements come from the tuple's members or from a `deconstruct`
        // call, as they do for a destructuring `let`.
        _gen_packed_parameter_prologue(location: Source.LOCATION, closure: Semantic.Symbols.Closure) is
            let packed = closure.packed_parameters
            let group = closure.pack_group

            if !packed? \/ !group? then
                return
            fi

            for parameter in packed do
                current_block.add(Values.DECLARE_LOCAL(IR.Values.packed_parameter_local_for(parameter)!))
            od

            let strategy = DESTRUCTURE_RESOLVER.resolve_strategy(group.type, packed.count)

            let elements = Collections.LIST[Value]()

            if strategy.is_deconstruct then
                let deconstruct = strategy.deconstruct_function!
                let call_arguments = Collections.LIST[Value]()

                for i in 0..deconstruct.arguments.count do
                    let ref_type = deconstruct.arguments[i]
                    let element_type = ref_type.get_element_type()

                    assert element_type? else "deconstruct argument type has no element type"

                    let element = IR.TEMP(current_block, "pack_element", i, element_type)

                    elements.add(element.load())
                    call_arguments.add(IR.Values.ADDRESS(element.load(), ref_type))
                od

                add(
                    deconstruct.call(
                        location,
                        group.load(location, null, _symbol_loader),
                        call_arguments,
                        null,
                        _function_caller
                    )
                )
            else
                for i in 0..packed.count do
                    elements.add(strategy.members[i]!.load(location, group.load(location, null, _symbol_loader), _symbol_loader))
                od
            fi

            assert elements.count == packed.count else "argument pack of {packed.count} parameters has {elements.count} elements"

            for i in 0..packed.count do
                add(Values.Store.LOCAL_ARGUMENT(packed[i], _boxer.box_if_needed(elements[i], packed[i].type!)))
            od
        si

        // Unpack a named function's destructured formal arguments into
        // their leaf frame fields. The plain path needs no call to this:
        // its AST walk reaches each formal's Variables.VARIABLE and
        // `visit(Variables.VARIABLE)` emits the same stores at method
        // entry. The generator and async paths drive their own walk into
        // MoveNext and never reach those nodes, so they emit this first -
        // placed after the state dispatch, so a resumed MoveNext branches
        // straight to its await label and the unpack runs once, on first
        // entry. The aggregate loads through its `$arg_*` frame field;
        // compile-expressions registered every leaf's field.
        _gen_destructured_formal_prologue(function: Definitions.FUNCTION) is
            for v in function.arguments do
                if v.is_argument /\ !v.left.is_simple_name then
                    let group_symbol = symbol_for(v)

                    if group_symbol? then
                        gen_destructuring_initialize(v.left, group_symbol.load(v.location, null, _symbol_loader))
                    fi
                fi
            od
        si

        // Async closure: the lambda's $anon body becomes a builder-
        // create / Start / return-Task launch sequence; the user body
        // walks into a separate move_next_block; the SM class is
        // queued for class-tail emission alongside named-function SMs.
        _emit_async_closure(
            function: Trees.Expressions.FUNCTION,
            closure: Semantic.Symbols.Closure,
            async_state_machine: Semantic.Symbols.ASYNC_STATE_MACHINE
        ) is
            let frame = async_state_machine.frame

            if !frame? then
                _logger.error(function.location, "async function must return a task-like type — one carrying AsyncMethodBuilderAttribute, such as Tasks.TASK or Tasks.ValueTask")
                return
            fi

            frame.declare()

            // Body walk before launch IL — populates the frame's
            // await labels / locals / awaiters before launch
            // references any of them.
            async_state_machine.install_body_emission_overrides()

            enter_scope(function)

            let move_next_block = Values.BLOCK()

            enter_block(move_next_block)

            add(Values.MAX_STACK(64))

            // Same V_state caching + per-region dispatch pattern as
            // `_pre_async_function` (see its commentary). Awaits in
            // the closure body register with the outer holder unless
            // an inner `.try` pushes its own.
            let move_next = _open_async_move_next()

            let outer_dispatch_holder =
                _open_state_machine_entry(frame, frame.state_field, ".async_state")

            let prev_async_sm = _current_async_state_machine
            let prev_success = _current_async_success
            let prev_resumable = _current_async_resumable
            _current_async_state_machine = async_state_machine
            _current_async_success = move_next.success
            _current_async_resumable = move_next.resumable

            // The plain-closure path emits this before its body walk
            // too - here into MoveNext, after the state dispatch, where
            // the leaves' loads route through the frame fields
            // `_register_lambda_pattern_fields` registered.
            _gen_closure_destructure_prologue(function, closure)

            function.body.walk(self)

            // What the body produces goes into the frame's result before
            // leaving to success, the same as a named function's state
            // machine - the trailer reads that field to complete the
            // builder, so a body that never reaches it completes with the
            // result type's default.
            _gen_async_body_result(function.body, frame)

            add(Values.BREAK(move_next.success))

            _current_async_state_machine = prev_async_sm
            _current_async_success = prev_success
            _current_async_resumable = prev_resumable

            _pop_async_dispatch_holder(outer_dispatch_holder)

            _close_async_move_next(move_next)

            leave_block()
            leave_scope(function)

            async_state_machine.uninstall_body_emission_overrides()

            // --- Build the builder-launch sequence ---
            enter_block()
            add(Values.MAX_STACK(64))

            let construction_type_args = async_state_machine.get_construction_type_arguments()

            let constructor =
                _specialized_constructor(
                    frame, frame.constructor, construction_type_args, function.location)

            let state_machine_type =
                _specialized_frame_type(frame, construction_type_args, function.location) ?? frame.type!

            // Ctor args: instance closures prepend ldarg.0 (the
            // closure-frame instance, which holds captures), then
            // each user-declared lambda parameter via ldarg '<name>'.
            let ctor_args_block = Values.BLOCK()

            // As above: the closure's receiver, when it has one, takes
            // slot 0 and its declared parameters follow.
            let slot mut = if closure.is_emitted_with_receiver then 1 else 0 fi

            if frame.outer_self_field? then
                ctor_args_block.add(Values.Load.ARGUMENT_SLOT(0, "ldarg.0"))
            fi
            for arg_name in closure.argument_names do
                ctor_args_block.add(Values.Load.ARGUMENT_SLOT(slot, "ldarg '{arg_name}'"))
                slot = slot + 1
            od
            ctor_args_block.close()

            let task_type = closure.return_type!

            let launch = IR.Values.ASYNC_METHOD_LAUNCH(
                task_type,
                state_machine_type,
                constructor,
                ctor_args_block,
                frame.state_field,
                frame.builder_field!
            )

            add(launch)
            add(Values.RET())

            // The launch is the closure's own method body, not part of
            // whatever is being emitted around the literal, so it needs
            // a body of its own or it lands in the enclosing method.
            _backend.begin_body()

            try
                _backend.write(current_block)

                _backend.finish_body(closure)
            finally
                _backend.end_body()
            yrt

            leave_block()

            _pending_async_state_machines.add(
                PENDING_ASYNC_STATE_MACHINE(
                    async_state_machine,
                    move_next_block,
                    move_next
                )
            )
        si

    si
si
