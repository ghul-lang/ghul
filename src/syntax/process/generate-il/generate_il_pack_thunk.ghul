namespace Syntax.Process is
    use IR
    use IR.Values

    // An argument pack thunk has no literal behind it, so its body is
    // generated from the description on its closure rather than walked.
    // At the pack, it reads its own parameters, turns the pack from the
    // shape the thunk takes into the shape the function it stands for
    // takes, calls that function and returns what it returns. Above the
    // pack, it calls that function with its parameters and returns the
    // next thunk's delegate, built closed over the result. A forwarding
    // thunk passes its parameters straight through to its target.
    partial GENERATE_IL is
        _gen_pack_thunk(closure: Semantic.Symbols.Closure) is
            let thunk = closure.pack_thunk

            if !thunk? then
                return
            fi

            closure.map_type_arguments()

            _backend.begin_body(closure)

            enter_block()

            let callee: Value? =
                if thunk.takes_callee then
                    _pack_thunk_parameter(closure, "$pack_callee")
                else
                    null
                fi

            if let inner = thunk.inner, inner_presented = thunk.inner_presented then
                let hop_arguments = Collections.LIST[Value]()

                for i in 0..closure.arguments.count - 1 do
                    hop_arguments.add(_pack_thunk_parameter(closure, "$pack_{i}"))
                od

                let result_type = thunk.callee_type.arguments[thunk.callee_type.arguments.count - 1]

                let result = Values.Call.CLOSURE(callee!, result_type, false, thunk.callee_type, hop_arguments)

                add(inner.load_closed_over(closure.location, result, inner_presented))

                _finish_pack_thunk(closure)

                return
            fi

            let arguments = Collections.LIST[Value]()

            if thunk.is_forward then
                for i in 0..closure.arguments.count do
                    arguments.add(_pack_thunk_parameter(closure, "$pack_{i}"))
                od
            else
                for i in 0..thunk.fixed_count do
                    arguments.add(_pack_thunk_parameter(closure, "$pack_{i}"))
                od
            fi

            if thunk.is_unpack then
                let tuple = IR.TEMP(current_block, "pack_thunk_tuple", _pack_thunk_parameter(closure, "$pack_{thunk.fixed_count}"))

                let strategy = DESTRUCTURE_RESOLVER.resolve_strategy(tuple.type, thunk.element_types.count)

                for i in 0..thunk.element_types.count do
                    arguments.add(strategy.members[i]!.load(closure.location, tuple.load(), _symbol_loader))
                od
            elif !thunk.is_forward then
                let elements = Collections.LIST[Value]()

                for i in 0..thunk.element_types.count do
                    elements.add(_pack_thunk_parameter(closure, "$pack_{thunk.fixed_count + i}"))
                od

                arguments.add(
                    Values.TUPLE(
                        _innate_symbol_lookup.get_tuple_type(thunk.element_types, null),
                        elements
                    )
                )
            fi

            let return_type = closure.return_type!

            if let target = thunk.target, constructed_type = thunk.constructed_type then
                add(_construct_in_pack_thunk(closure.location, target, arguments, constructed_type))
            elif let target = thunk.target then
                add(target.call(closure.location, null, arguments, null, _function_caller))
            else
                add(
                    Values.Call.CLOSURE(
                        callee!,
                        return_type,
                        return_type.compare(_innate_symbol_lookup.get_void_type()) == Semantic.Types.MATCH.SAME,
                        thunk.callee_type,
                        arguments
                    )
                )
            fi

            _finish_pack_thunk(closure)
        si

        // The instance a constructing thunk returns: a scalar conversion
        // converts its one argument as `cast` would, and any other
        // constructor constructs as a call to it does.
        _construct_in_pack_thunk(
            location: Source.LOCATION,
            constructor: Semantic.Symbols.Function,
            arguments: Collections.List[Value],
            constructed_type: Semantic.Types.Type
        ) -> Value is
            if constructor.is_scalar_conversion then
                let caster = IoC.CONTAINER.instance.type_caster

                return Values.SCALAR_CONVERSION(caster.cast_value(location, arguments[0], constructed_type, false, true))
            fi

            let argument_types = Collections.LIST[Semantic.Types.Type](arguments.count)

            for a in arguments do
                argument_types.add(a.type!)
            od

            return _function_caller.construct(constructor, arguments, argument_types, constructed_type)
        si

        _finish_pack_thunk(closure: Semantic.Symbols.Closure) is
            add(Values.RET())

            _backend.write(current_block)

            leave_block()

            _backend.finish_body(closure)
            _backend.end_body()

            closure.unmap_type_arguments()
        si

        _pack_thunk_parameter(closure: Semantic.Symbols.Closure, name: string) -> Value =>
            closure.find_direct(name)!.load(closure.location, null, _symbol_loader)
    si
si
