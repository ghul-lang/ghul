namespace Syntax.Process is
    use Trees

    use IR
    use IR.Values

    // A list comprehension emits its loops directly into the BLOCK that
    // compile-expressions left as its value: one iterator loop per `for`
    // clause, outermost first, a branch past the rest of the body for each
    // `if` clause, and at the innermost point the element stored. Where the
    // length is known up front the element goes straight into an array
    // allocated at that length; otherwise it is added to a list, which is
    // turned into the array after the loops finish.
    partial GENERATE_IL is
        pre(comprehension: Expressions.COMPREHENSION) -> bool is
            super.pre(comprehension)

            if comprehension.is_lazy then
                _emit_lazy_comprehension(comprehension)

                return true
            fi

            if
                !comprehension.value? \/
                !isa Values.BLOCK(comprehension.value) \/
                !comprehension.list_type? \/
                !comprehension.list_constructor? \/
                !comprehension.list_add? \/
                !comprehension.list_to_array? \/
                !comprehension.element_type?
            then
                // compile-expressions has already reported why there is
                // nothing to emit; walk on so any function literal inside
                // is still generated.
                return false
            fi

            let spiller = COMPOSITE_VALUE_SPILLER(self, comprehension, comprehension.value, _current_state_machine_frame())

            spiller.enter()

            try
                if
                    let count = comprehension.presize_count,
                    source_local = comprehension.presize_source
                then
                    let source = comprehension.first.source

                    source.walk(self)

                    add(Values.DECLARE_LOCAL(source_local))
                    add(source.value!)
                    add(Values.STORE_TEMP(source_local))

                    let array_type = comprehension.value!.type!
                    let int_type = _innate_symbol_lookup.get_int_type()

                    let fill =
                        COMPREHENSION_FILL(
                            TEMP(current_block, "comprehension", Values.NEW_ARRAY(array_type, comprehension.element_type!, count)),
                            TEMP(current_block, "comprehension_index", Values.Literal.NUMBER(0, int_type)),
                            int_type
                        )

                    _gen_comprehension_for(comprehension, comprehension.first, fill, Values.Load.TEMP(source_local))

                    spiller.emit_value(fill.result!.load())
                else
                    let fill =
                        COMPREHENSION_FILL(
                            TEMP(
                                current_block,
                                "comprehension",
                                Values.NEW(comprehension.list_type!, comprehension.list_constructor!, Collections.LIST[Value](0))
                            )
                        )

                    _gen_comprehension_clause(comprehension, comprehension.first, fill)

                    spiller.emit_value(
                        comprehension.list_to_array!.call(
                            comprehension.location,
                            fill.result!.load(),
                            Collections.LIST[Value](0),
                            null,
                            _function_caller
                        )
                    )
                fi
            finally
                spiller.leave()
            yrt

            return true
        si

        visit(comprehension: Expressions.COMPREHENSION) is
            super.visit(comprehension)
        si

        // A lazy comprehension: the generator literal it owns is emitted as
        // any generator literal is, with the clause loops as its MoveNext
        // body and each element yielded rather than stored. The value
        // compile-expressions left, a call to the literal, is emitted where
        // the comprehension is used.
        _emit_lazy_comprehension(comprehension: Expressions.COMPREHENSION) is
            let generator = cast Semantic.Symbols.Closure?(comprehension.scope)

            if !generator? \/ isa Values.DUMMY(comprehension.value) then
                return
            fi

            let state_machine = Semantic.Symbols.state_machine_for(generator)

            if !state_machine? then
                return
            fi

            generator.map_type_arguments()

            if let frame = state_machine.frame then
                frame.declare()

                let enclosing_loops = _loops

                _loops = LOOP_LABEL_STACK()

                _gen_generator_move_next(
                    comprehension,
                    state_machine,
                    frame,
                    () is
                        _gen_comprehension_clause(comprehension, comprehension.first, COMPREHENSION_FILL(state_machine))
                    si
                )

                _loops = enclosing_loops

                _without_position(() is _emit_generator_outer_method(generator, frame, state_machine) si)
            fi

            generator.unmap_type_arguments()
        si

        _gen_comprehension_clause(
            comprehension: Expressions.COMPREHENSION,
            clause: Expressions.COMPREHENSION_CLAUSE?,
            fill: COMPREHENSION_FILL
        ) is
            if !clause? then
                _gen_comprehension_element(comprehension, fill)
            elif let for_clause: Expressions.COMPREHENSION_FOR = clause then
                _gen_comprehension_for(comprehension, for_clause, fill, null)
            elif let if_clause: Expressions.COMPREHENSION_IF = clause then
                _gen_comprehension_if(comprehension, if_clause, fill)
            fi
        si

        _gen_comprehension_element(comprehension: Expressions.COMPREHENSION, fill: COMPREHENSION_FILL) is
            let element = comprehension.element

            // Walked for what it contains - a function literal's body, a
            // block's captured IL - before its value is emitted.
            element.walk(self)

            if let state_machine = fill.state_machine then
                _gen_yield_value(state_machine, element.value)
            elif let index = fill.index then
                add(Values.STORE_ARRAY_ELEMENT(fill.result!.load(), index.load(), element.value!, comprehension.element_type!))

                index.store(
                    Values.ARITHMETIC(
                        IR.ArithmeticOperation.ADD,
                        index.load(),
                        Values.Literal.NUMBER(1, fill.int_type!),
                        fill.int_type!
                    ).unmarked()
                )
            else
                // The call converts the element to the list's element type,
                // boxing or wrapping it as its parameter needs.
                let arguments = Collections.LIST[Value]()
                arguments.add(element.value!)

                add(
                    comprehension.list_add!.call(
                        element.location,
                        fill.result!.load(),
                        arguments,
                        null,
                        _function_caller
                    )
                )
            fi
        si

        _gen_comprehension_for(
            comprehension: Expressions.COMPREHENSION,
            clause: Expressions.COMPREHENSION_FOR,
            fill: COMPREHENSION_FILL,
            evaluated_source: Value?
        ) is
            super.pre(clause)

            try
                let source = clause.source

                // A source already evaluated into a local, for its count,
                // has been walked too.
                let source_value: Value =
                    if let evaluated = evaluated_source then
                        evaluated
                    else
                        source.walk(self)
                        source.value!
                    fi

                let iterator: Value =
                    if let read_iterator = clause.read_iterator then
                        read_iterator.call(source.location, source_value, Collections.LIST[Value](0), null, _function_caller)
                    else
                        source_value
                    fi

                clause.variable.walk(self)

                // Inside a state machine the iterator is kept in the frame
                // field compile-expressions allocated for it, as a `for`
                // loop's is, so it survives each suspend between elements.
                let iterator_field = clause.iterator_field
                let iterator_frame = _current_state_machine_frame()

                let load_iterator: () -> Value =
                    if let stored = iterator_field, frame = iterator_frame then
                        add(_build_frame_field_store(frame, stored, iterator))

                        () => cast Value(IR.Values.Load.INSTANCE_FIELD(IR.Values.Load.REFERENCE_SELF(frame, frame.type), stored))
                    else
                        let temp = TEMP(current_block, "comprehension_iterator", iterator)

                        () => cast Value(temp.load())
                    fi

                let loop = Values.LOOP(LABEL(), LABEL(), _innate_symbol_lookup.get_void_type())

                _open_structured(loop)

                let has_next = clause.move_next!.call(source.location, load_iterator(), Collections.LIST[Value](0), null, _function_caller)

                add(Values.BREAK(loop, BRANCH.Z, has_next))

                let current = clause.read_current!.call(source.location, load_iterator(), Collections.LIST[Value](0), null, _function_caller)

                gen_destructuring_initialize(clause.variable.left, current)

                _gen_comprehension_clause(comprehension, clause.inner, fill)

                _close_structured(loop)
            finally
                super.visit(clause)
            yrt
        si

        _gen_comprehension_if(
            comprehension: Expressions.COMPREHENSION,
            clause: Expressions.COMPREHENSION_IF,
            fill: COMPREHENSION_FILL
        ) is
            let condition = clause.condition

            condition.walk(self)

            let skip = _open_region(LABEL())

            add(Values.BREAK(skip, BRANCH.Z, condition.value!))

            _gen_comprehension_clause(comprehension, clause.inner, fill)

            _close_structured(skip)
        si
    si

    // Where a comprehension's elements go: straight into an array at a
    // running index when its length is known up front, into a list, or,
    // for a lazy comprehension, out of its generator one yield at a time.
    class COMPREHENSION_FILL is
        result: TEMP?
        state_machine: Semantic.Symbols.STATE_MACHINE?
        index: TEMP?
        int_type: Semantic.Types.Type?

        init(result: TEMP) is
            self.result = result
        si

        init(result: TEMP, index: TEMP, int_type: Semantic.Types.Type) is
            self.result = result
            self.index = index
            self.int_type = int_type
        si

        init(state_machine: Semantic.Symbols.STATE_MACHINE) is
            self.state_machine = state_machine
        si
    si
si
