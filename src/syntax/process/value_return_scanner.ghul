namespace Syntax.Process is

    // Whether a function body has a `return` with a value that leaves the
    // function. A `return` inside a `val` block leaves the block, and one
    // inside a nested function or literal leaves that, so neither counts.
    class VALUE_RETURN_SCANNER: Visitor is
        _found: bool

        init() is
            super.init()
        si

        returns_a_value(body: Trees.Bodies.Body) -> bool is
            _found = false

            body.walk(self)

            return _found
        si

        pre(r: Trees.Statements.RETURN) -> bool is
            if r.expression? then
                _found = true
            fi

            return true
        si

        pre(block: Trees.Expressions.VAL_BLOCK) -> bool => true
        pre(function: Trees.Definitions.FUNCTION) -> bool => true
        pre(function: Trees.Expressions.FUNCTION) -> bool => true
    si
si
