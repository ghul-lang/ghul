namespace Syntax.Process is
    // Decides whether a pattern vector matches anything the rows
    // above it do not, and produces witnesses — the value shapes that
    // escape — when it does.
    //
    // Both questions a `case` needs are this one query: the arms are
    // exhaustive when a row of wildcards is useless against all of
    // them, and an arm is redundant when its own row is useless
    // against the arms before it.
    //
    // The walk is driven by the patterns rather than by the values
    // they range over, which is what keeps it affordable: a column is
    // only ever split by the constructors some row actually names, so
    // the width of the search follows the arms that were written, not
    // the size of the type. Enumerating the product of the columns
    // would instead cost the product of the domains, and an enum with
    // a few hundred members in three columns would price the check
    // out of a pass that runs on every keystroke.
    class CASE_USEFULNESS is
        // Spent one per visited node. A `case` whose arms interact
        // badly enough to exhaust it is answered as though a value
        // escapes: the author is asked for an `else` that may not be
        // needed, rather than being told a gap is covered when the
        // walk never finished proving it.
        _budget: int

        _BUDGET_PER_QUERY: int static => 20000

        init() is
            super.init()
        si

        // Up to `limit` witnesses that `query` admits and no row of
        // `matrix` matches. Empty when `query` adds nothing.
        find_witnesses(
            matrix: CASE_PATTERN[][],
            domains: PATTERN_DOMAIN?[],
            query: CASE_PATTERN[],
            limit: int
        ) -> CASE_PATTERN[][] is
            _budget = _BUDGET_PER_QUERY

            return _witnesses(matrix, domains, query, limit)
        si

        _witnesses(
            matrix: CASE_PATTERN[][],
            domains: PATTERN_DOMAIN?[],
            query: CASE_PATTERN[],
            limit: int
        ) -> CASE_PATTERN[][] is
            let result = Collections.LIST[CASE_PATTERN[]]()

            if limit <= 0 then
                return result
            fi

            _budget = _budget - 1

            if _budget <= 0 then
                result.add(CASE_PATTERN_BUILDER.wildcards(query.count))

                return result
            fi

            if query.count == 0 then
                // Nothing left to distinguish values by, so a value
                // escapes exactly when no row survived to match it.
                if matrix.count == 0 then
                    result.add(Collections.LIST[CASE_PATTERN]())
                fi

                return result
            fi

            let head = query[0]

            if let constructor = head.constructor then
                _collect_specialized(matrix, domains, query, constructor, head.fields, limit, result)

                return result
            fi

            let domain = domains[0]
            let present = _constructors_in_first_column(matrix)
            let is_complete = domain? /\ _is_complete(domain, present)

            // A value escapes in one of two ways, and both are
            // reported so that fixing the ones named does not just
            // reveal the rest one recompile at a time.
            //
            // It can take an alternative no row names at all — only
            // possible while the column is short of its domain — in
            // which case only a row headed by a wildcard can still
            // match it.
            if !is_complete then
                let tail_witnesses =
                    _witnesses(_default_matrix(matrix), _tail_domains(domains), _tail_patterns(query), limit)

                if tail_witnesses.count > 0 then
                    let missing = _missing(domain, present)

                    if missing.count == 0 then
                        for tail in tail_witnesses do
                            result.add(_prepend(CASE_PATTERN(), tail))

                            if result.count >= limit then
                                return result
                            fi
                        od
                    else
                        for m in missing do
                            for tail in tail_witnesses do
                                result.add(
                                    _prepend(
                                        CASE_PATTERN(m, CASE_PATTERN_BUILDER.wildcards(m.arity)),
                                        tail
                                    )
                                )

                                if result.count >= limit then
                                    return result
                                fi
                            od
                        od
                    fi
                fi
            fi

            // Or it can take an alternative some row does name, and
            // escape underneath it on one of that alternative's own
            // fields.
            for c in _covered_constructors(domain, present, is_complete) do
                _collect_specialized(
                    matrix,
                    domains,
                    query,
                    c,
                    CASE_PATTERN_BUILDER.wildcards(c.arity),
                    limit - result.count,
                    result
                )

                if result.count >= limit then
                    return result
                fi
            od

            return result
        si

        // The alternatives worth descending under. A complete column
        // is walked in the domain's own order, which is the order a
        // diagnostic reads best in; an incomplete one is walked over
        // just the alternatives some row named, since the rest are
        // reported whole rather than descended into.
        _covered_constructors(
            domain: PATTERN_DOMAIN?,
            present: PATTERN_CONSTRUCTOR[],
            is_complete: bool
        ) -> PATTERN_CONSTRUCTOR[] static is
            if is_complete /\ domain? then
                return domain.constructors
            fi

            return present
        si

        // Recurse under `constructor`, then fold the sub-witnesses
        // back up into it.
        _collect_specialized(
            matrix: CASE_PATTERN[][],
            domains: PATTERN_DOMAIN?[],
            query: CASE_PATTERN[],
            constructor: PATTERN_CONSTRUCTOR,
            head_fields: CASE_PATTERN[],
            limit: int,
            into: Collections.LIST[CASE_PATTERN[]]
        ) is
            if limit <= 0 then
                return
            fi

            let arity = constructor.arity

            if head_fields.count != arity then
                return
            fi

            let sub_domains = _concat_domains(constructor.field_domains, _tail_domains(domains))
            let sub_query = _concat_patterns(head_fields, _tail_patterns(query))

            let witnesses = _witnesses(_specialize(matrix, constructor, arity), sub_domains, sub_query, limit)

            for witness in witnesses do
                let fields = Collections.LIST[CASE_PATTERN]()

                for i in 0..arity do
                    fields.add(witness[i])
                od

                let rest = Collections.LIST[CASE_PATTERN]()

                for i in arity..witness.count do
                    rest.add(witness[i])
                od

                into.add(_prepend(CASE_PATTERN(constructor, fields), rest))
            od
        si

        // The rows that can still match once the first column is
        // known to hold `constructor`, with that column replaced by
        // the constructor's fields.
        _specialize(
            matrix: CASE_PATTERN[][],
            constructor: PATTERN_CONSTRUCTOR,
            arity: int
        ) -> CASE_PATTERN[][] static is
            let result = Collections.LIST[CASE_PATTERN[]]()

            for row in matrix do
                let head = row[0]

                if head.is_wildcard then
                    result.add(_concat_patterns(CASE_PATTERN_BUILDER.wildcards(arity), _tail_patterns(row)))
                elif head.constructor! == constructor then
                    if head.fields.count == arity then
                        result.add(_concat_patterns(head.fields, _tail_patterns(row)))
                    fi
                fi
            od

            return result
        si

        // The rows that can still match once the first column is
        // known to hold none of the constructors any row names.
        _default_matrix(
            matrix: CASE_PATTERN[][]
        ) -> CASE_PATTERN[][] static is
            let result = Collections.LIST[CASE_PATTERN[]]()

            for row in matrix do
                if row[0].is_wildcard then
                    result.add(_tail_patterns(row))
                fi
            od

            return result
        si

        _constructors_in_first_column(
            matrix: CASE_PATTERN[][]
        ) -> PATTERN_CONSTRUCTOR[] static is
            let result = Collections.LIST[PATTERN_CONSTRUCTOR]()

            for row in matrix do
                if let constructor = row[0].constructor then
                    if !_contains(result, constructor) then
                        result.add(constructor)
                    fi
                fi
            od

            return result
        si

        _is_complete(
            domain: PATTERN_DOMAIN,
            present: PATTERN_CONSTRUCTOR[]
        ) -> bool static is
            for c in domain.constructors do
                if !_contains(present, c) then
                    return false
                fi
            od

            return true
        si

        _missing(
            domain: PATTERN_DOMAIN?,
            present: PATTERN_CONSTRUCTOR[]
        ) -> PATTERN_CONSTRUCTOR[] static is
            let result = Collections.LIST[PATTERN_CONSTRUCTOR]()

            if !domain? then
                return result
            fi

            for c in domain.constructors do
                if !_contains(present, c) then
                    result.add(c)
                fi
            od

            return result
        si

        _contains(
            constructors: PATTERN_CONSTRUCTOR[],
            constructor: PATTERN_CONSTRUCTOR
        ) -> bool static is
            for c in constructors do
                if c == constructor then
                    return true
                fi
            od

            return false
        si

        _prepend(
            head: CASE_PATTERN,
            tail: CASE_PATTERN[]
        ) -> CASE_PATTERN[] static is
            let result = Collections.LIST[CASE_PATTERN]()

            result.add(head)

            for p in tail do
                result.add(p)
            od

            return result
        si

        _tail_patterns(patterns: CASE_PATTERN[]) -> CASE_PATTERN[] static is
            let result = Collections.LIST[CASE_PATTERN]()

            for i in 1..patterns.count do
                result.add(patterns[i])
            od

            return result
        si

        _tail_domains(domains: PATTERN_DOMAIN?[]) -> PATTERN_DOMAIN?[] static is
            let result = Collections.LIST[PATTERN_DOMAIN?]()

            for i in 1..domains.count do
                result.add(domains[i])
            od

            return result
        si

        _concat_patterns(
            first: CASE_PATTERN[],
            second: CASE_PATTERN[]
        ) -> CASE_PATTERN[] static is
            let result = Collections.LIST[CASE_PATTERN]()

            for p in first do
                result.add(p)
            od

            for p in second do
                result.add(p)
            od

            return result
        si

        _concat_domains(
            first: PATTERN_DOMAIN?[],
            second: PATTERN_DOMAIN?[]
        ) -> PATTERN_DOMAIN?[] static is
            let result = Collections.LIST[PATTERN_DOMAIN?]()

            for d in first do
                result.add(d)
            od

            for d in second do
                result.add(d)
            od

            return result
        si
    si
si
