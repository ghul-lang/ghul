namespace Syntax.Process is
    use System.Uri
    use System.UriKind

    use System.IO.Abstractions
    use Source
    use Trees

    use Ghul.Pipes

    class EXPAND_NAMESPACES: Visitor is
        _file_system: IFileSystem
        _depth: int

        init(file_system: IFileSystem) is
            super.init()

            _file_system = file_system
        si

        apply(node: Node) is
            assert isa Definitions.LIST(node) else "expected the root syntax tree node of file to be a definition list"

            let list = cast Definitions.LIST(node)

            let seen_any_namespaces mut = false
            let seen_any_other_definitions mut = false

            // A definition is classified by what it is under any pragmas
            // written on it: a pragma-wrapped function is still a global
            // definition, and a pragma-wrapped namespace still a namespace.
            // One conditional compilation dropped is an empty list, and is
            // neither.
            for definition in list do
                if isa Definitions.NAMESPACE(definition.without_pragmas) then
                    seen_any_namespaces = true
                elif !_is_dropped(definition) then
                    seen_any_other_definitions = true
                fi
            od

            if seen_any_namespaces /\ seen_any_other_definitions then
                let logger = IoC.CONTAINER.instance.logger

                for definition in list do
                    if !isa Definitions.NAMESPACE(definition.without_pragmas) /\ !_is_dropped(definition) then
                        logger.error(definition.location, "cannot mix global definitions and namespaces in the same file")
                    fi
                od
            elif seen_any_other_definitions then
                let root_namespace_name: string mut

                if IoC.CONTAINER.instance.build_flags.want_global_namespace then
                    // An empty name aggregates every file's global
                    // definitions into the single unnamed root namespace,
                    // so they are mutually visible across the project.
                    root_namespace_name = ""
                else
                    // The per-file name keeps each file's global
                    // definitions private to that file.
                    let first_node = list |> first()
                    let path = first_node!.location.file_name

                    root_namespace_name =
                        IoC.CONTAINER.instance.build_flags.submission_name ??
                        get_namespace_name(path)
                fi

                let new_definitions = Collections.LIST[Definitions.Definition](
                    list
                )

                if IoC.CONTAINER.instance.build_flags.want_implicit_default_use then
                    new_definitions.insert(_after_pragmas(new_definitions), _implicit_default_use(list.location))
                fi

                let root_namespace =
                    Definitions.NAMESPACE(
                        list.location,
                        Trees.Identifiers.Identifier(Source.LOCATION.internal, root_namespace_name),
                        Definitions.LIST(list.location, new_definitions),
                        true
                    )

                list.clear_definitions()

                list.add(root_namespace)
            fi

            node.walk(self)
        si

        _is_dropped(definition: Definitions.Definition) -> bool =>
            let unwrapped = definition.without_pragmas in
            isa Definitions.LIST(unwrapped) /\ (cast Definitions.LIST(unwrapped) |> count()) == 0

        // Where an implicit `use default` goes: after any pragmas, so a
        // file-level pragma still comes first.
        _after_pragmas(definitions: Collections.List[Definitions.Definition]) -> int is
            let index mut = 0

            while index < definitions.count /\ isa Definitions.PRAGMA(definitions[index]) do
                index = index + 1
            od

            return index
        si

        _implicit_default_use(location: LOCATION) -> Definitions.USE is
            let result = Definitions.USE(location, null, null)

            result.is_default = true

            return result
        si

        is_root_directory(info: IDirectoryInfo) -> bool is
            let root_path = _file_system.path.get_path_root(info.full_name)

            return root_path =~ info.full_name
        si

        convert_file_name_to_identifier(name: string mut) -> string is
            if name.length == 0 then
                return name
            fi

            name =
                name
                    .replace('-', '_')
                    .replace('.', '_') |>
                    filter(c => char.is_letter_or_digit(c) \/ c == '_') |> join("")

            // Filesystem root names ("/", "C:\\") and any other input
            // whose characters are all dropped by the filter reduce to
            // empty here. The post-parse pass walks up parent
            // directories when no ghul.json / *.ghulproj marks the
            // project root, so a file opened from a path with no
            // upstream marker can deliver such a name. Earlier versions
            // crashed on the index below, taking down the whole
            // build pipeline (hover, completion, …) for the file.
            if name.length == 0 then
                return name
            fi

            if !char.is_letter(name[0]) then
                name = "`{name}"
            fi

            return name
        si

        get_namespace_name(path: string) -> string is
            let local_path: string mut
            let uri: Uri? mut = null

            if Uri.is_well_formed_uri_string(path, UriKind.ABSOLUTE) then
                uri = Uri(path)
            fi

            if uri? /\ uri.is_file then
                local_path = uri.local_path
            else
                local_path = path
            fi

            let result mut =
                convert_file_name_to_identifier(
                    _file_system.path.get_file_name_without_extension(local_path) ?? ""
                )

            let folder = _file_system.path.get_directory_name(local_path) ?? ""

            result = "{get_namespace_name_for_folder(folder)}{result}"

            return result
        si

        get_namespace_name_for_folder(path: string? mut) -> string is
            let original_path = path

            if !path? \/ path =~ "" then
                path = _file_system.directory.get_current_directory()
            fi

            let info = _file_system.directory_info.`new(path)

            let result = get_namespace_name_for_folder(info)

            return result
        si

        get_namespace_name_for_folder(info: IDirectoryInfo) -> string is
            let result mut = "{convert_file_name_to_identifier(info.name)}__"

            if
                _file_system.file.exists(_file_system.path.combine(info.full_name, "ghul.json")) \/
                _file_system.directory.get_files(info.full_name, "*.ghulproj").count > 0
            then
                return result
            fi

            if info.parent? /\ !is_root_directory(info) then
                result = "{get_namespace_name_for_folder(info.parent!)}{result}"
            fi

            return result
        si

        pre(`namespace: Definitions.NAMESPACE) -> bool is
            _depth = _depth + 1
            return false
        si

        visit(`namespace: Definitions.NAMESPACE) is
            let names = `namespace.name.qualifier_names

            if _depth == 1 then
                // `Ghul.Intrinsics` is the ambient set: the names the
                // language lets every namespace block reference without
                // a `use` - the magic types and the intrinsic operators.
                // Anything else declared in `Ghul`, by the runtime or by
                // any consumed assembly, is imported like any other
                // namespace's symbols.
                `namespace.body.push(
                    Definitions.USE(
                        Source.LOCATION.internal,
                        null,
                        Trees.Identifiers.QUALIFIED(
                            Source.LOCATION.internal,
                            Trees.Identifiers.Identifier(Source.LOCATION.internal, "Ghul"),
                            "Intrinsics",
                            Source.LOCATION.internal,
                            Source.LOCATION.internal
                        )
                    )
                )
            fi

            if names.count > 0 then
                `namespace.name = Identifiers.Identifier(`namespace.name.location, `namespace.name.name)
                let body = `namespace.body
                let current = `namespace

                for n in names do
                    current.body =
                        Definitions.LIST(
                            current.location,
                            Collections.LIST[Definitions.Definition](
                                [Definitions.NAMESPACE(current.location, current.name, current.body, current.is_compiler_generated)]: Definitions.Definition
                            )
                        )
                    current.name = Identifiers.Identifier(`namespace.name.location, n)
                od
            fi

            _depth = _depth - 1
        si
    si
si
