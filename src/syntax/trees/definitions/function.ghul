namespace Syntax.Trees.Definitions is
    use IO.Std

    use Source

    class FUNCTION(
        location: LOCATION,
        name: Identifiers.Identifier?,
        generic_arguments: TypeExpressions.LIST,
        arguments: Variables.LIST public,
        type_expression: TypeExpressions.TypeExpression,
        modifiers: Modifiers.LIST,
        body: Bodies.Body? public
    ): MODIFIABLE, ScopeCarrier is
        scope: Semantic.Scope? public

        // True when the body contains an `await` expression (not in
        // a nested lambda). Set by declare-symbols. Drives async
        // classification + downstream IL emission decisions.
        contains_let_await: bool public

        // True when `contains_let_await` is set AND the body has no
        // value-returning `return X;` statements — meaning the
        // function returns the non-generic `Tasks.TASK` (rather than
        // `Tasks.TASK[T]` for some T).
        is_void_async: bool public

        // Set on the `init` FUNCTION synthesised by
        // rewrite-primary-constructors from a class's primary-constructor
        // header. Lets declare-symbols record the primary constructor on
        // the owning type (a class can have secondary constructors too, so
        // the primary is not simply the only `init`).
        is_primary_constructor: bool public

        // Set on a FUNCTION the compiler wrote that stands for no
        // member the user did, and that keeps a real source location so
        // its diagnostics anchor somewhere meaningful — a union's
        // structural `=~` and `get_hash_code`, for instance, which are
        // built at the union's own declaration. Distinct from a
        // synthesised accessor, which does stand for a written member.
        is_synthesized: bool public

        mark_synthesized() is
            is_synthesized = true
        si

        // Set on the FUNCTION synthesise-top-level-entry builds from a
        // file's top-level statements. Declare-members copies it onto the
        // function's symbol, which distinguishes the synthesised entry
        // from every other function during name resolution.
        is_top_level_entry: bool public

        // Set on the private CLR-facing `_entry` wrapper that
        // synthesise-entry-environment-wrapper builds beside a hand-written
        // entry function declaring a `Ghul.Environment` parameter. Read by
        // select-entry-point, which treats it as a named-entry candidate
        // even though its own name never matches `--entry`.
        is_synthesized_main_wrapper: bool public

        // Set on the hand-written entry function a synthesised `_entry`
        // wrapper stands in for. Read by select-entry-point, which excludes
        // it from candidacy entirely: its own signature is never
        // Main-compatible, and the wrapper is what represents it.
        wrapped_by_synthesized_main: bool public

        // Set on a synthesised `_entry` wrapper whose wrapped function is a
        // top-level entry. Read by select-entry-point, which ranks it with
        // the top-level candidates rather than the named ones, so several
        // files each carrying top-level statements stay the tolerated tie
        // they are without a wrapper.
        wraps_top_level_entry: bool public

        for_property: PROPERTY? public

        // Set on the accessor FUNCTIONs synthesised by add-accessors-for-
        // properties when the owning property is underscore-prefixed. The
        // accessor's own IL name ($get_/$set_) does not start with an
        // underscore, so this carries the property's underscore scope
        // through to declare-symbols, where it drives the access policy.
        is_underscore_scoped: bool public

        // Set on FUNCTIONs synthesised by add-accessors-for-
        // properties from a `[index]: T` indexer. The CLR-required
        // accessor names aren't user-chosen, so
        // diagnostics that target user naming (e.g. the snake_case
        // member-name warning) gate on `!for_indexer?`.
        for_indexer: INDEXER? public

        // For a synthesised accessor (for_property or for_indexer
        // set): true for the assign accessor, false for the read
        // accessor. Carries which half this is structurally, so
        // nothing has to infer it back from the accessor's name.
        is_assign_accessor: bool public

        // For a synthesised read accessor: the operation an `@intrinsic`
        // pragma on its property or indexer names. The accessor is added
        // beside the property rather than inside the pragma, so the
        // pragma's scope does not reach it.
        intrinsic_operation: string? public

        super(location, modifiers)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                // the children can be left null when the parser hits
                // catastrophic input and unwinds out of the declaration
                if name? then
                    name.walk(visitor)
                fi

                arguments.walk(visitor)

                type_expression.walk(visitor)

                if body? then
                    body.walk(visitor)
                fi
            fi

            accept(visitor)
        si
    si
si
