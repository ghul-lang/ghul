namespace Syntax.Trees.Definitions is
    use Source

    class INDEXER(
        location: LOCATION,
        name: Identifiers.Identifier?,
        index_arguments: Collections.LIST[Variables.VARIABLE],
        type_expression: TypeExpressions.TypeExpression,
        modifiers: Modifiers.LIST,
        read_body: Bodies.Body?,
        assign_argument: Identifiers.Identifier?,
        assign_body: Bodies.Body?
    ): MODIFIABLE is
        super(location, modifiers)

        // The first of the indexer's arguments.
        index_argument: Variables.VARIABLE => index_arguments[0]

        // The accessor functions synthesised from the indexer's bodies.
        read_accessor: FUNCTION? public
        assign_accessor: FUNCTION? public

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                modifiers.walk(visitor)

                if name? then
                    name.walk(visitor)
                fi

                for argument in index_arguments do
                    argument.walk(visitor)
                od
                type_expression.walk(visitor)

                if read_body? then
                    read_body.walk(visitor)
                fi

                if assign_argument? then
                    assign_argument.walk(visitor)
                fi

                if assign_body? then
                    assign_body.walk(visitor)
                fi
            fi

            accept(visitor)
        si
    si
si
