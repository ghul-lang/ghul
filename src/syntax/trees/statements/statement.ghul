namespace Syntax.Trees.Statements is
    use Source
    use IR.Values.Value

    use Logging

    class Statement(location: LOCATION): Trees.Node, Trees.DisposalHost abstract is
        // Compile-expressions output; contents owned by that pass.
        compile_expressions_state: Syntax.Process.STATEMENT_STATE field

        value: Value? => compile_expressions_state.value
        want_value: bool => compile_expressions_state.want_value
        void_tolerated: bool => compile_expressions_state.void_tolerated
        let_in_disposals: Collections.List[Semantic.Symbols.Variable]? => compile_expressions_state.let_in_disposals

        expects_semicolon: bool => false
        provides_value: bool => false
        is_tuple_literal: bool => false

        super(location)

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
        si

        clear_expected_type() is
        si

        add_let_in_disposal(v: Semantic.Symbols.Variable) is
            compile_expressions_state.add_let_in_disposal(v)
        si

        clear() is
            super.clear()
            compile_expressions_state.clear()
        si

        clear_outputs() is
            compile_expressions_state.clear_outputs()
        si

    si
si
