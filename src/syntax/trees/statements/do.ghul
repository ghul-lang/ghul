namespace Syntax.Trees.Statements is
    use Source

    class DO: Statement, ScopeCarrier is
        scope: Semantic.Scope? public

        condition: Expressions.Expression?
        binding: REFUTABLE_BINDING?
        body: Statements.LIST

        // What a `use` in the condition, or in a `while let` binding,
        // belongs to: one iteration of the loop.
        iteration: LOOP_ITERATION

        // Pushed expected type from the wrapping context when the loop
        // is an expression; compile-expressions unwraps the optional and
        // threads it onto every valued break so they infer against T.
        expected_state: Syntax.Process.EXPECTED_TYPE_STATE field

        expected_type: Semantic.Types.Type? => expected_state.expected_type
        expected_type_error_message: string? => expected_state.expected_type_error_message

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            expected_state.set(expected_type, error_message)
        si

        clear_expected_type() is
            expected_state.clear()
        si

        clear() is
            super.clear()
            expected_state.clear()
            iteration.clear()
        si

        init(location: LOCATION, condition: Expressions.Expression?, body: Statements.LIST) is
            init(location, condition, null, body)
        si

        init(
            location: LOCATION,
            condition: Expressions.Expression?,
            binding: REFUTABLE_BINDING?,
            body: Statements.LIST
        ) is
            super.init(location)

            self.condition = condition
            self.binding = binding
            self.body = body
            iteration = LOOP_ITERATION()
        si

        debug_location: LOCATION is
            if let self.condition? then
                return location.start_position :: condition.location
            elif let self.binding? then
                return location.start_position :: binding.location
            fi

            return location.start_position
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                if let self.binding? then
                    binding.walk(visitor)
                fi

                if let self.condition? then
                    condition.walk(visitor)
                fi

                body.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
