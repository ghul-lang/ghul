namespace Syntax.Trees.Statements is
    use Source

    class FOR(
        location: LOCATION,
        variable: Variables.VARIABLE?,
        expression: Expressions.Expression?,
        body: Statements.LIST?
    ): Statement, ScopeCarrier, IteratorCarrier is
        scope: Semantic.Scope? public

        iterated: Expressions.Expression? => expression

        read_iterator: Semantic.Symbols.Function? public => iterator_state.read_iterator, = value is iterator_state.read_iterator = value si
        read_current: Semantic.Symbols.Function? public => iterator_state.read_current, = value is iterator_state.read_current = value si
        move_next: Semantic.Symbols.Function? public => iterator_state.move_next, = value is iterator_state.move_next = value si

        iterator_field: Semantic.Symbols.Field? public => iterator_state.iterator_field, = value is iterator_state.iterator_field = value si
        fused_stages: Collections.LIST[Syntax.Process.FUSED_STAGE_FIELDS]? public => iterator_state.fused_stages, = value is iterator_state.fused_stages = value si

        iterator_state: Syntax.Process.ITERATOR_STATE field

        // Set by compile-expressions when the loop expression is a
        // fusible Pipe[T] chain: the IL pass then lowers the whole
        // chain to one inline loop instead of iterating the built pipe
        // objects. Null means iterate normally. See
        // Syntax.Process.PIPE_FUSION_RECOGNIZER.
        fusion: Syntax.Process.PIPE_FUSION? public => iterator_state.fusion, = value is iterator_state.fusion = value si

        // Pushed expected type from the wrapping context when the loop
        // is an expression; compile-expressions unwraps the optional and
        // threads it onto every valued break so they infer against T.
        expected_state: Syntax.Process.EXPECTED_TYPE_STATE field

        expected_type: Semantic.Types.Type? => expected_state.expected_type
        expected_type_error_message: string? => expected_state.expected_type_error_message

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            expected_state.set(expected_type, error_message)
        si

        clear_expected_type() is
            expected_state.clear()
        si

        clear() is
            super.clear()
            expected_state.clear()
            iterator_state.clear()
        si

        clear_outputs() is
            super.clear_outputs()
            iterator_state.clear_outputs()
        si

        super(location)

        debug_location: LOCATION is
            if let self.expression? then
                return location.start_position :: expression.location
            fi

            return location.start_position
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                if variable? then
                    variable.walk(visitor)
                fi

                if expression? then
                    expression.walk(visitor)
                fi

                if body? then
                    body.walk(visitor)
                fi
            fi

            accept(visitor)
        si
    si
si
