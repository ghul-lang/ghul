namespace Syntax.Trees.Expressions is

    use Source

    class REFERENCE(location: LOCATION, left: Expression): Expression is
        super(location)

        // Set once the enclosing call is resolved: true when the matched
        // parameter writes this `ref` slot, so passing it definitely
        // assigns the target. Read by the condition analyzer to place
        // that assignment on the branch edges a `ref` in a condition
        // reaches.
        writes_target: bool public => reference_state.writes_target, = value is reference_state.writes_target = value si

        reference_state: Syntax.Process.REFERENCE_STATE field

        clear() is
            super.clear()
            reference_state.clear()
        si

        clear_outputs() is
            super.clear_outputs()
            reference_state.clear()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                left.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
