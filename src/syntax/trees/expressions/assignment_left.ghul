namespace Syntax.Trees.Expressions is
    use Source

    class AssignmentLeftExpression: Expression is
        is_simple_expression: bool => false
        expression: Expression? => null
        elements: Collections.List[AssignmentLeftExpression]? => null
        assign_location: LOCATION public

        // True on the target that takes the rest of a sequence: the last
        // element of a destructuring target written in square brackets.
        is_rest: bool public

        // The assignment's own location is stamped on by compile-
        // bindings, which is where the left expression learns what it
        // is part of.
        @suppress("field-definite-assignment")
        init(location: LOCATION) is
            super.init(location)
        si

        get_names_into(into: Collections.MutableList[Expression])

        copy() -> AssignmentLeftExpression
    si

    class SIMPLE_LEFT_EXPRESSION: AssignmentLeftExpression is
        expression: Expression
        is_simple_expression: bool => true

        elements: Collections.List[AssignmentLeftExpression] => []

        init(
            location: LOCATION,
            name: Expression
        ) is
            super.init(location)

            self.expression = name

            // will be set more accurately in compile expressions
            // but must have some non-null value
            assign_location = location
        si

        get_names_into(into: Collections.MutableList[Expression]) is
            into.add(expression)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                expression.walk(visitor)
            fi

            accept(visitor)
        si

        copy() -> AssignmentLeftExpression is
            let result = SIMPLE_LEFT_EXPRESSION(location, expression)

            result.assign_location = assign_location
            result.is_rest = is_rest

            return result
        si
    si

    class DESTRUCTURING_LEFT_EXPRESSION: AssignmentLeftExpression is
        elements: Collections.List[AssignmentLeftExpression]

        // True when the target is written in square brackets and takes the
        // elements of a sequence rather than the parts of a tuple.
        is_sequence: bool public

        // Compile-expressions output for a sequence target over a lazy
        // sequence; see LAZY_SEQUENCE_ASSIGNMENT.
        lazy_assignment_state: Syntax.Process.LAZY_ASSIGNMENT_STATE field

        lazy_assignment: Syntax.Process.LAZY_SEQUENCE_ASSIGNMENT? public => lazy_assignment_state.assignment, = value is lazy_assignment_state.assignment = value si

        clear() is
            super.clear()
            lazy_assignment_state.clear()
        si

        clear_outputs() is
            super.clear_outputs()
            lazy_assignment_state.clear()
        si

        init(location: LOCATION, elements: Collections.List[AssignmentLeftExpression]) is
            super.init(location)
            self.elements = elements
        si

        get_names_into(into: Collections.MutableList[Expression]) is
            for e in elements do
                e.get_names_into(into)
            od
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                for e in elements do
                    e.walk(visitor)
                od
            fi
            accept(visitor)
        si

        copy() -> AssignmentLeftExpression is
            let new_elements = Collections.LIST[AssignmentLeftExpression](elements.count)

            for e in elements do
                new_elements.add(e.copy())
            od

            let result = DESTRUCTURING_LEFT_EXPRESSION(location, new_elements)

            result.assign_location = assign_location
            result.is_sequence = is_sequence
            result.is_rest = is_rest

            return result
        si
    si
si
