namespace Syntax.Trees.Expressions is

    use Source

    class UNWRAP(location: LOCATION, left: Expression): Expression is
        super(location)

        // Set by compile-expressions where a failed unwrap returns its error
        // from the enclosing function, and null where it throws.
        propagation: Syntax.Process.UNWRAP_PROPAGATION? public

        // Set by compile-expressions where the error a failed unwrap would
        // return does not fit the enclosing function's return type: what to
        // report, once the walk is no longer speculating.
        unreturnable_error: string? public

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                left.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
