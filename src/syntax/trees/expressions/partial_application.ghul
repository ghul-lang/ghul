namespace Syntax.Trees.Expressions is

    use Source

    use Ghul.Pipes

    // A call with `*` for one or more of its arguments, or an operator
    // expression with `*` for one of its operands: a function value of
    // one parameter per `*`, in order, that makes the call with its
    // parameters in those positions and the other arguments as they were
    // evaluated once, where the partial application is written. An
    // operator expression is a call of the operator, `a + *` being
    // `+(a, *)`, so it is taken apart the same way.
    //
    // A chain of member accesses, calls and indexes whose receiver is a
    // `*`, written `* .name`, is a function of the receiver too: its `*`
    // arguments follow the receiver as parameters, in order.
    //
    // `body` is the call or operator expression as written. It is
    // resolved and typed as any call is, with each `*` typed from its
    // formal; the value this expression stands for is built from the
    // result.
    class PARTIAL_APPLICATION: Expression is
        body: Expression
        placeholders: Collections.LIST[PLACEHOLDER]

        // The body where it is a call; absent for an operator body.
        call: CALL? => cast CALL?(body)

        right_location: LOCATION => body.right_location

        init(location: LOCATION, body: Expression) is
            super.init(location)

            self.body = body

            placeholders = Collections.LIST[PLACEHOLDER]()

            for argument in operands do
                if let placeholder: PLACEHOLDER = argument then
                    placeholder.owner = self
                    placeholder.index = placeholders.count

                    placeholders.add(placeholder)
                fi
            od

            if let binary: BINARY = body then
                binary.is_partial_body = true
            elif let unary: UNARY = body then
                unary.is_partial_body = true
            fi
        si

        // Whether the body is a chain whose receiver is a `*`.
        is_chain: bool => receiver_placeholder(body)?

        // The body's written arguments in order: a call's argument list,
        // an operator's operands, or a chain's receiver followed by the
        // arguments and indexes along it.
        operands: Expression[] =>
            if receiver_placeholder(body)? then
                chain_operands(body)
            elif let call: CALL = body then
                call.arguments.expressions
            elif let binary: BINARY = body then
                _flattened(Collections.LIST[Expression]([binary.left, binary.right]))
            elif let unary: UNARY = body then
                _flattened(Collections.LIST[Expression]([unary.right]))
            else
                Collections.LIST[Expression]()
            fi

        // Whether `expression` is an operand that makes the operator it is
        // an operand of a partial application: a `*`, or a chain on one.
        is_placeholder_operand(expression: Expression) -> bool static =>
            isa PLACEHOLDER(expression) \/ receiver_placeholder(expression)?

        // `operands` with each `* .name` chain among them replaced by its
        // own operands, so an operator over a chain takes the chain's `*`s.
        _flattened(operands: Collections.LIST[Expression]) -> Collections.LIST[Expression] static is
            let result = Collections.LIST[Expression]()

            for operand in operands do
                if receiver_placeholder(operand)? then
                    for o in chain_operands(operand) do
                        result.add(o)
                    od
                else
                    result.add(operand)
                fi
            od

            return result
        si

        // The `*` at the root of `expression` when it is a chain of member
        // accesses, calls and indexes on a `*`; otherwise null.
        receiver_placeholder(expression: Expression) -> PLACEHOLDER? static is
            let current mut = expression

            while true do
                if let placeholder: PLACEHOLDER = current then
                    if current == expression then
                        return null
                    fi

                    return placeholder
                elif let member: MEMBER = current then
                    current = member.left
                elif let call: CALL = current then
                    current = call.function
                elif let index: INDEX = current then
                    current = index.left
                else
                    return null
                fi
            od

            return null
        si

        // The receiver of a chain, then the arguments and indexes along it,
        // in the order they are written.
        chain_operands(expression: Expression) -> Collections.LIST[Expression] static is
            let result: Collections.LIST[Expression] mut

            if let member: MEMBER = expression then
                result = chain_operands(member.left)
            elif let call: CALL = expression then
                result = chain_operands(call.function)

                for argument in call.arguments.expressions do
                    result.add(argument)
                od
            elif let index: INDEX = expression then
                result = chain_operands(index.left)

                for i in index.indexes do
                    result.add(i)
                od
            else
                result = Collections.LIST[Expression]()
                result.add(expression)
            fi

            return result
        si

        // Whether `arguments` has a `*` among its elements: what makes a
        // call a partial application.
        has_placeholder(arguments: LIST) -> bool static =>
            arguments.expressions |> any(a => isa PLACEHOLDER(a))

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            compile_expressions_state.set_expected_type(expected_type, error_message)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            visitor.enter_node(self)
            try
                if !visitor.pre(self) then
                    body.walk(visitor)
                fi

                accept(visitor)
            finally
                visitor.leave_node(self)
            yrt
        si
    si
si
