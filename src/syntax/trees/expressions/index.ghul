namespace Syntax.Trees.Expressions is

    use Source

    // `left[a]`, or `left[a, b, ...]` for an indexer taking several
    // arguments. `index` is the first of them.
    class INDEX: Expression is
        left: Expression public
        indexes: Collections.LIST[Expression] public

        index: Expression public => indexes[0], = value is indexes[0] = value; si

        init(location: LOCATION, left: Expression, index: Expression) is
            init(location, left, Collections.LIST[Expression]([index]))
        si

        init(location: LOCATION, left: Expression, indexes: Collections.LIST[Expression]) is
            super.init(location)

            assert indexes.count > 0 else "an index needs at least one argument"

            self.left = left
            self.indexes = indexes
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                left.walk(visitor)

                for i in indexes do
                    i.walk(visitor)
                od
            fi

            accept(visitor)
        si

        replace_child(old: Expression, replacement: Expression) is
            if left == old then
                left = replacement
                return
            fi

            for i in 0..indexes.count do
                if indexes[i] == old then
                    indexes[i] = replacement
                    return
                fi
            od
        si
    si
si
