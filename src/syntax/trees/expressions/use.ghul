namespace Syntax.Trees.Expressions is

    use Source

    // `use E` expression. Evaluates to the operand's value, and disposes
    // that value when the enclosing statement list ends.
    class USE: Expression is
        operand: Expression

        use_state: Syntax.Process.USE_STATE field

        // The local the value is held in until it is disposed. Declared
        // once and retyped by later walks, so a capture or a registration
        // made on one walk still names it on the next.
        target: Semantic.Symbols.Variable? public => use_state.target, = value is use_state.target = value si

        init(location: LOCATION, operand: Expression) is
            super.init(location)

            self.operand = operand
        si

        clear() is
            super.clear()
            use_state.clear()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                operand.walk(visitor)
            fi
            accept(visitor)
        si
    si
si
