namespace Syntax.Trees.Expressions is
    use Source

    // `[element for p in source if condition ...]`, an array, or the same
    // clauses in braces, `{element for ...}`, a pipe whose elements are
    // produced as it is read. The clauses form a
    // chain rather than a list: each clause holds the one after it, and
    // the last holds the element, so a `for` clause's scope covers every
    // later clause and the element, and a walk reaches the element inside
    // every clause scope.
    class COMPREHENSION: Expression, ScopeCarrier is
        element: Expression
        first: COMPREHENSION_FOR
        type_expression: TypeExpressions.TypeExpression

        // Written in braces: the result is a Pipe[T] produced by a
        // generator literal the comprehension owns, whose scope this is.
        is_lazy: bool
        scope: Semantic.Scope? public

        description: string =>
            if is_lazy then
                "comprehension"
            else
                "list comprehension"
            fi

        // Compile-expressions output: the element type of the result, and
        // the list the elements are gathered into before the array is
        // made from it.
        element_type: Semantic.Types.Type? public
        list_type: Semantic.Types.Type? public
        list_constructor: Semantic.Symbols.Function? public
        list_add: Semantic.Symbols.Function? public
        list_to_array: Semantic.Symbols.Function? public

        // Set where the result can be allocated at its final length up
        // front: a single `for` clause, no `if`, and a source whose count
        // is known before the loop. The source is evaluated once into the
        // local here, and the count is read from that local.
        presize_count: IR.Values.Value? public
        presize_source: IR.LOCAL? public

        clear() is
            super.clear()
            _clear_comprehension_outputs()
        si

        clear_outputs() is
            super.clear_outputs()
            _clear_comprehension_outputs()
        si

        _clear_comprehension_outputs() is
            element_type = null
            list_type = null
            list_constructor = null
            list_add = null
            list_to_array = null
            presize_count = null
            presize_source = null
        si

        init(location: LOCATION, element: Expression, first: COMPREHENSION_FOR, type_expression: TypeExpressions.TypeExpression, is_lazy: bool) is
            super.init(location)

            self.is_lazy = is_lazy

            self.element = element
            self.first = first
            self.type_expression = type_expression

            let last: COMPREHENSION_CLAUSE mut = first

            while let next = last.inner do
                last = next
            od

            last.element = element
        si

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            compile_expressions_state.set_expected_type(expected_type, error_message)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                first.walk(visitor)
                type_expression.walk(visitor)
            fi

            accept(visitor)
        si
    si

    // A clause of a comprehension. `inner` is the clause after this one;
    // the last clause has none, and holds the comprehension's element
    // instead.
    class COMPREHENSION_CLAUSE: Trees.Node abstract is
        inner: COMPREHENSION_CLAUSE? public
        element: Expression? public

        init(location: LOCATION) is
            super.init(location)
        si

        walk_inner(visitor: Visitor) is
            if let inner = self.inner then
                inner.walk(visitor)
            elif let element = self.element then
                element.walk(visitor)
            fi
        si
    si

    // `for pattern in source`. Iterates the same way a `for` statement
    // does, so it carries the same iterator state.
    class COMPREHENSION_FOR: COMPREHENSION_CLAUSE, ScopeCarrier, IteratorCarrier is
        scope: Semantic.Scope? public

        variable: Variables.VARIABLE
        source: Expression

        iterated: Expression? => source

        read_iterator: Semantic.Symbols.Function? public => iterator_state.read_iterator, = value is iterator_state.read_iterator = value si
        read_current: Semantic.Symbols.Function? public => iterator_state.read_current, = value is iterator_state.read_current = value si
        move_next: Semantic.Symbols.Function? public => iterator_state.move_next, = value is iterator_state.move_next = value si

        iterator_field: Semantic.Symbols.Field? public => iterator_state.iterator_field, = value is iterator_state.iterator_field = value si

        fusion: Syntax.Process.PIPE_FUSION? public => iterator_state.fusion, = value is iterator_state.fusion = value si

        iterator_state: Syntax.Process.ITERATOR_STATE field

        init(location: LOCATION, variable: Variables.VARIABLE, source: Expression) is
            super.init(location)

            self.variable = variable
            self.source = source
        si

        clear() is
            iterator_state.clear()
        si

        clear_outputs() is
            iterator_state.clear_outputs()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                variable.walk(visitor)
                source.walk(visitor)
                walk_inner(visitor)
            fi

            accept(visitor)
        si
    si

    // `if condition`: later clauses and the element see only the
    // elements for which it holds.
    class COMPREHENSION_IF: COMPREHENSION_CLAUSE is
        condition: Expression

        init(location: LOCATION, condition: Expression) is
            super.init(location)

            self.condition = condition
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                condition.walk(visitor)
                walk_inner(visitor)
            fi

            accept(visitor)
        si
    si
si
