namespace Syntax.Trees.Expressions is
    use IO.Std

    use Source

    class BINARY(
        location: LOCATION,
        operation: Identifiers.Identifier,
        actual_operation: string?,
        left: Expression,
        right: Expression
    ): Expression is
        super(location)

        // True where this expression is the body of a partial application,
        // `a + *`: the operator is compiled as the call it is, and the
        // partial application takes its arguments apart, so an innate
        // operator is left for the backend to lower.
        is_partial_body: bool public

        // An operator whose declared return type carries the pack marker
        // takes the pack from the function type its context expects, as
        // a call does.
        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            compile_expressions_state.set_expected_type(expected_type, error_message)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            // enter/leave_node wrap the whole visit so the ambient
            // location covers Values built by `pre()` overrides that
            // take control of the walk — `pre_binary` for `/\`/`\/`
            // does its own narrowing-aware walk and returns true,
            // skipping the default recursion below.
            visitor.enter_node(self)
            try
                if !visitor.pre(self) then
                    left.walk(visitor)
                    right.walk(visitor)
                fi
                accept(visitor)
            finally
                visitor.leave_node(self)
            yrt
        si

        replace_child(old: Expression, replacement: Expression) is
            if left == old then
                left = replacement
            elif right == old then
                right = replacement
            fi
        si
    si
si
