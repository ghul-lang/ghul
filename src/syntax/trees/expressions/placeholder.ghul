namespace Syntax.Trees.Expressions is

    use Source

    // `*` written as a whole actual argument of a call: the parameter the
    // call's partial application takes in that position. Its type is the
    // formal's, pushed in once the callee is resolved, the way a bare `_`
    // argument takes its type.
    class PLACEHOLDER(location: LOCATION): Expression is
        // The partial application this is an argument of, and the
        // position among its placeholders. Absent for a `*` written
        // anywhere other than as an argument of a call, which is an
        // error reported when the expression is compiled.
        owner: PARTIAL_APPLICATION? public
        index: int public

        super(location)

        awaits_context_type: bool => true

        set_expected_type(expected_type: Semantic.Types.Type?, error_message: string?) is
            compile_expressions_state.set_expected_type(expected_type, error_message)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            visitor.pre(self)

            accept(visitor)
        si
    si
si
