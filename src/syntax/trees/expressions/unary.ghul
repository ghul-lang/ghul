namespace Syntax.Trees.Expressions is

    use Source

    class UNARY(location: LOCATION, operation: Identifiers.Identifier, right: Expression): Expression is
        super(location)

        // True where this expression is the body of a partial application,
        // `- *`, which takes the operator's call apart.
        is_partial_body: bool public

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                right.walk(visitor)
            fi
            accept(visitor)
        si
    si
si
