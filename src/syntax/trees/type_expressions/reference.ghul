namespace Syntax.Trees.TypeExpressions is
    use Source

    class REFERENCE(location: LOCATION, element: TypeExpression): Structured is
        is_reference: bool => true

        // Set on the `ref` parameter types of a synthesised `deconstruct`.
        is_synthesised: bool public

        super(location, element)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                element.walk(visitor)
            fi
            accept(visitor)
        si
    si
si
