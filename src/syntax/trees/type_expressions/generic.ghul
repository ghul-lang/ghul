namespace Syntax.Trees.TypeExpressions is

    use Source

    use Ghul.Pipes

    class GENERIC(location: LOCATION, name: Identifiers.Identifier, arguments: TypeExpressions.LIST): NAMED is
        argument_count: int => arguments.count

        is_void: bool =>
            arguments |> any(e => e.is_void)

        // The index this reads as where it is written in value position:
        // `m[i]`, or `m[i, j]` where every argument is a name, the same rule
        // the expression parser reads `m[i, j]` by. A tuple, function or
        // generic type among several arguments says this is a type.
        try_copy_as_value_expression() -> Expressions.Expression? is
            if arguments.count == 1 then
                let ee = arguments.elements[0].try_copy_as_value_expression()

                if !ee? then
                    return null
                fi

                return
                    Expressions.INDEX(
                        location,
                        name.copy_as_expression(),
                        ee
                    )
            fi

            let indexes = Collections.LIST[Expressions.Expression]()

            for element in arguments.elements do
                if !isa NAMED(element) then
                    return null
                fi

                if let index = element.try_copy_as_value_expression() then
                    indexes.add(index)
                else
                    return null
                fi
            od

            return Expressions.INDEX(location, name.copy_as_expression(), indexes)
        si

        super(location, name)

        qualify_member(member: Identifiers.Identifier) -> TypeExpression =>
            let member_identifier = Identifiers.QUALIFIED(
                location,
                name,
                member.name,
                name.location::member.location,
                member.location
            ) in
            GENERIC(
                location,
                member_identifier,
                arguments.shallow_copy()
            )

        copy() -> TypeExpression is
            let result =
                GENERIC(
                    location,
                    name.copy(),
                    arguments.shallow_copy()
                )

            result.parenthesised = parenthesised

            return result
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                name.walk(visitor)
                arguments.walk(visitor)
            fi
            accept(visitor)
        si
    si
si
