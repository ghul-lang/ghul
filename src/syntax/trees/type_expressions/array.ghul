namespace Syntax.Trees.TypeExpressions is
    use Source

    // The `E[]` suffix: Collections.List[E] when parsed from source, the
    // array `ARRAY[E]` itself when `is_array` is set, which only
    // synthesised code does (an entry point's `Main` takes the array).
    class ARRAY_(location: LOCATION, element: TypeExpression, is_array: bool public): Structured is
        super(location, element)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                element.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
