namespace Syntax.Trees.TypeExpressions is
    use Source

    // The `E[]` suffix: E[] when parsed from source, the
    // array `ARRAY[E]` itself when `is_array` is set, which only
    // synthesised code does (an entry point's `Main` takes the array).
    // A `rank` of 2 or 3 is the `E[,]` or `E[,,]` suffix, the
    // two- and three-dimensional array traits.
    class ARRAY_(location: LOCATION, element: TypeExpression, is_array: bool public, rank: int public): Structured is
        super(location, element)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                element.walk(visitor)
            fi

            accept(visitor)
        si
    si
si
