namespace Syntax.Trees.TypeExpressions is

    use Source

    class NAMED_TUPLE_ELEMENT(location: LOCATION, name: Identifiers.Identifier, type_expression: TypeExpression): TypeExpression is
        // Declared variance, when this element is a generic type
        // parameter declared `[T: ... out]` / `[T: ... in]`. INVARIANT
        // for every other use of NAMED_TUPLE_ELEMENT (tuple elements,
        // function parameters) and for an unannotated type parameter.
        variance: Semantic.Types.TypeVariance public

        // True when this generic type parameter carries an `init`
        // constraint — `[T: init]` standalone or compound with a kind /
        // type bound (`[T: class init]`, `[T: A init]`, `[T: A class init]`).
        has_constructor: bool public

        // A trailing kind expected_type after a type bound — `[T: A class]`.
        // NONE when no trailing kind keyword is present. When the
        // NAMED_TUPLE_ELEMENT *is* a pure kind expected_type (`[T: class]`),
        // the kind is carried inside the `type_expression` slot as a
        // TYPE_PARAMETER_CONSTRAINT, and `combined_kind` stays NONE.
        combined_kind: Semantic.Symbols.TypeParameterConstraintKind public

        // Further `/\`-joined bounds after the first — `[T: A /\ B]`. The
        // first bound lives in `type_expression`. Empty for every other use
        // of NAMED_TUPLE_ELEMENT.
        additional_bounds: Collections.LIST[TypeExpression] public

        is_named: bool => true
        is_reference: bool => type_expression.is_reference
        is_void: bool => type_expression.is_void

        super(location)

        init(..) is
            additional_bounds = Collections.LIST[TypeExpression](0)
        si

        copy() -> TypeExpression is
            let result =
                NAMED_TUPLE_ELEMENT(
                    location,
                    name.copy(),
                    type_expression.copy()
                )

            result.variance = variance
            result.parenthesised = parenthesised
            result.has_constructor = has_constructor
            result.combined_kind = combined_kind

            for b in additional_bounds do
                result.additional_bounds.add(cast TypeExpression(b.copy()))
            od

            return result
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                name.walk(visitor)
                type_expression.walk(visitor)

                for b in additional_bounds do
                    b.walk(visitor)
                od
            fi

            accept(visitor)
        si
    si
si
