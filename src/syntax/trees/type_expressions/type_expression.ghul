namespace Syntax.Trees.TypeExpressions is
    use System.Exception
    use System.NotImplementedException

    use Source

    use Semantic.Types.Type

    class TypeExpression(location: LOCATION): Trees.Node abstract is
        name: Identifiers.Identifier? => null
        type_expression: TypeExpression? => null

        type: Type? public

        // Whether the source wrapped this type expression in a
        // parenthesised group, which the formatter writes back. The parser
        // collapses the group onto its single element and sets this, so
        // `((T))` and `(T)` both read back as `(T)`; nothing downstream
        // but the printer reads it.
        parenthesised: bool public

        right_location: LOCATION => location
        is_named: bool => false
        is_bare_identifier: bool => false
        is_reference: bool => false
        is_void: bool => false
        is_inferred: bool => false

        could_be_value_expression: bool => false

        try_copy_as_value_expression() -> Expressions.Expression? => null

        check_is_not_reference(logger: Logging.Logger, message: string) -> bool is
            if is_reference then
                logger.error(location, message)
                return false
            fi

            return true
        si

        check_is_not_void(logger: Logging.Logger, message: string) -> bool is
            // TODO: this highlights the whole type expression, which might be
            // quite complex. Instead we should recurse down the type expression
            // tree and show errors only for the actual references to void
            if is_void then
                logger.error(location, message)
                return false
            fi

            return true
        si

        // Non-recursive clear of per-build state on this type expression.
        // Resets `type` (set by resolve-type-expressions). See Node.clear()
        // and CLEAR_STATE_VISITOR for the orchestration.
        clear() is
            type = null
        si

        super(location)

        qualify_member(member: Identifiers.Identifier) -> TypeExpression => throw NotImplementedException("cannot qualify member {member} with type expression {self}")
        copy() -> TypeExpression => throw NotImplementedException("cannot copy type expression {self.get_type()} {self}")
        accept(visitor: Visitor) is
            visitor.visit(self)
        si
    si
si
