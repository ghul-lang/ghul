namespace Syntax.Trees is

    // A node that disposes the locals `let use ... in` expressions
    // within it declare, once it completes: a statement in a statement
    // list, or a function's expression body. Either begins and ends
    // with nothing on the evaluation stack, which a disposal region
    // needs.
    trait DisposalHost is
        let_in_disposals: Semantic.Symbols.Variable[]?

        add_let_in_disposal(v: Semantic.Symbols.Variable)
    si

    // One iteration of a `while` loop: it disposes what a `use` in the
    // loop's condition holds at the end of each iteration, and when the
    // loop is left, so each evaluation's value is disposed before the next
    // is taken.
    class LOOP_ITERATION: DisposalHost is
        dispose_state: Syntax.Process.LIST_DISPOSAL_STATE field

        let_in_disposals: Semantic.Symbols.Variable[]? => dispose_state.variables_to_dispose

        init() is
        si

        add_let_in_disposal(v: Semantic.Symbols.Variable) is
            dispose_state.add(v)
        si

        clear() is
            dispose_state.clear()
        si
    si
si
