namespace Syntax.Trees.Bodies is
    use Source

    class EXPRESSION(location: LOCATION, expression: Expressions.Expression public): Body, ScopeCarrier, DisposalHost is
        scope: Semantic.Scope? public

        // Where the `=>` that opens the body was written, when it was. The
        // body's own location is the expression's, which is where a
        // diagnostic about the value belongs.
        arrow: LOCATION? public

        // From the `=>`: the expression can start later than the body does,
        // as a thread-first call is located from its `|>` rather than from
        // its subject.
        extent: LOCATION => if let a = arrow then a :: location else location fi

        // Compile-expressions output, read by IL generation.
        dispose_state: Syntax.Process.LIST_DISPOSAL_STATE field

        let_in_disposals: Collections.List[Semantic.Symbols.Variable]? => dispose_state.variables_to_dispose

        super(location)

        add_let_in_disposal(v: Semantic.Symbols.Variable) is
            dispose_state.add(v)
        si

        clear() is
            super.clear()
            dispose_state.clear()
        si

        clear_outputs() is
            super.clear_outputs()
            dispose_state.clear()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        walk(visitor: Visitor) is
            if !visitor.pre(self) then
                visitor.enter_node(expression)
                try
                    expression.walk(visitor)
                finally
                    visitor.leave_node(expression)
                yrt
            fi

            accept(visitor)
        si
    si
si
