namespace Syntax.Parsers.Expressions is
    use IO.Std

    use Source

    class LIST(expression_parser: Parser[Trees.Expressions.Expression]): Base[Trees.Expressions.LIST] is
        super()

        description: string => "expression list"

        parse(context: CONTEXT) -> Trees.Expressions.LIST is
            let start = context.location

            let first = parse_element(context)

            if !first? then
                return Trees.Expressions.LIST(start::context.location, Collections.LIST[Trees.Expressions.Expression]())
            fi

            return parse_after(context, start, first)
        si

        parse_element(context: CONTEXT) -> Trees.Expressions.Expression? is
            // A bare `..` before a comma or the closing bracket is the
            // discarded rest of a sequence pattern, read as `.._`. Nothing
            // else gives `..` an operand-less meaning, so a `..` followed by
            // anything else is the prefix operator it always was.
            if context.current.token == Lexical.TOKEN.OPERATOR /\ context.current.value_string =~ ".." then
                let location = context.location

                let is_bare =
                    (
                        let use snapshot = context.tokenizer_speculate_then_backtrack()

                        context.next_token()

                        context.current.token == Lexical.TOKEN.COMMA \/
                        context.current.token == Lexical.TOKEN.SQUARE_CLOSE
                    )

                if is_bare then
                    context.next_token()

                    return Trees.Expressions.UNARY(
                        location,
                        Trees.Identifiers.Identifier(location, ".."),
                        Trees.Expressions.DEFAULT(location, null))
                fi
            fi

            // A lone `*` before a comma or the closing parenthesis is a
            // partial application's placeholder. `*` has no prefix
            // reading, so nothing else is written this way.
            if context.current.token == Lexical.TOKEN.OPERATOR /\ context.current.value_string =~ "*" then
                let location = context.location

                let is_bare =
                    (
                        let use snapshot = context.tokenizer_speculate_then_backtrack()

                        context.next_token()

                        context.current.token == Lexical.TOKEN.COMMA \/
                        context.current.token == Lexical.TOKEN.PAREN_CLOSE
                    )

                if is_bare then
                    context.next_token()

                    return Trees.Expressions.PLACEHOLDER(location)
                fi
            fi

            context.allow_tuple_element = true
            let expression = expression_parser.parse(context)
            context.allow_tuple_element = false

            return expression
        si

        // The rest of a list whose first element the caller has already
        // parsed - a list literal looks at the token after its first
        // element before deciding it is a list at all.
        parse_after(context: CONTEXT, start: LOCATION, first: Trees.Expressions.Expression) -> Trees.Expressions.LIST is
            let expressions = Collections.LIST[Trees.Expressions.Expression]()
            let expression mut = first

            do
                expressions.add(expression)

                if context.current.token != Lexical.TOKEN.COMMA then
                    return Trees.Expressions.LIST(start::expression.location, expressions)
                fi

                context.next_token()

                // Trailing comma: stop when a closing bracket follows.
                // The same parser drives list literals (`[a, b,]`),
                // tuple literals (`(a, b,)`) and call argument lists
                // (`f(a, b,)`), so one check covers all three.
                if
                    context.current.token == Lexical.TOKEN.SQUARE_CLOSE \/
                    context.current.token == Lexical.TOKEN.PAREN_CLOSE
                then
                    return Trees.Expressions.LIST(start::context.location, expressions)
                fi

                // The expression parser chain bottoms out at a poisoned
                // placeholder rather than null, but that's an invariant of
                // the current wiring, not a contract: guard here so a
                // future element parser without that override can't put
                // a null in the list.
                let next = parse_element(context)

                if !next? then
                    break
                fi

                expression = next
            od

            return Trees.Expressions.LIST(start::context.location, expressions)
        si
    si
si
