namespace Syntax.Parsers.Expressions is
    use IO.Std
    use Ghul.Disposable

    use Source
    use Logging

    class SECONDARY(
        identifier_parser: Parser[Trees.Identifiers.Identifier],
        type_parser: Parser[Trees.TypeExpressions.TypeExpression],
        type_list_parser: Parser[Trees.TypeExpressions.LIST],
        expression_parser: Parser[Trees.Expressions.Expression],
        expression_primary_parser: Parser[Trees.Expressions.Expression],
        expression_list_parser: Parser[Trees.Expressions.LIST],
        body_parser: Parser[Trees.Bodies.Body]
    ): Base[Trees.Expressions.Expression] is
        description: string => "secondary expression"

        super()

        // A token sits in identifier position after a `.` if it
        // looks like a word (its `value_string` opens with a letter
        // or underscore) and it shares a line with the dot. The
        // line guard matters: a `.` at the end of a line followed
        // by a structural keyword on the next (`namespace Foo.\n is`)
        // must not eat that keyword.
        looks_like_partial_member_keyword(context: CONTEXT, dot_location: LOCATION) -> bool is
            if context.current.token == Lexical.TOKEN.IDENTIFIER then
                return false
            fi

            let s = context.current.value_string

            // value_string is null for a value-less token
            @suppress("presence-test-non-optional")
            if !s? \/ s.length == 0 then
                return false
            fi

            let first = s[0]

            if !((first >= 'a' /\ first <= 'z') \/ (first >= 'A' /\ first <= 'Z') \/ first == '_') then
                return false
            fi

            return context.current.location.start_line == dot_location.start_line
        si

        // An operator token sits in member-name position after a `.`
        // when whitespace separates the two: the tokenizer scans a run
        // of operator characters greedily and `.` is one of them, so
        // `a.=~(b)` lexes as the single operator `.=~` and never
        // reaches here — only `a. =~(b)` does. The backtick escape
        // (`a.`=~(b)`) arrives as an ordinary IDENTIFIER and takes the
        // branch above.
        //
        // The same line guard as the keyword case, for the same
        // reason: a `.` ending a line must not swallow an operator
        // leading the next one.
        looks_like_operator_member_name(context: CONTEXT, dot_location: LOCATION) -> bool is
            if context.current.token != Lexical.TOKEN.OPERATOR then
                return false
            fi

            let s = context.current.value_string

            // value_string is null for a value-less token
            @suppress("presence-test-non-optional")
            if !s? \/ s.length == 0 then
                return false
            fi

            return context.current.location.start_line == dot_location.start_line
        si

        // What may continue a `|>` onto the next line: a plain name, or a
        // function named with operator characters.
        _can_lead_thread_first_right_side(context: CONTEXT) -> bool static =>
            context.current.token == Lexical.TOKEN.IDENTIFIER \/
            context.current.token == Lexical.TOKEN.OPERATOR

        // The stand-in for a `|>` right side that has not been typed
        // yet. An empty, poisoned name resolves to nothing and reports
        // nothing, the same recovery a bare `.` at the end of a line
        // gets.
        _missing_thread_first_function(location: LOCATION) -> Trees.Expressions.Expression static is
            let name = Trees.Expressions.IDENTIFIER(location, Trees.Identifiers.Identifier(location, ""))

            name.poison()

            return name
        si

        // Build the thread-first call for a right side that is not a call:
        // either nothing at all, or a name with no argument list. The
        // subject is threaded in as it is for a complete call, so the
        // node the completer meets has the same shape whether or not the
        // user has finished typing.
        _incomplete_thread_first(
            start: LOCATION,
            subject: Trees.Expressions.Expression,
            completion_target: LOCATION,
            function: Trees.Expressions.Expression
        ) -> Trees.Expressions.CALL static is
            let call =
                Trees.Expressions.CALL(
                    start::function.location,
                    function,
                    Trees.Expressions.LIST(subject.location, [subject])
                )

            call.is_thread_first = true
            call.completion_target = completion_target
            call.poison()

            return call
        si

        parse(context: CONTEXT) -> Trees.Expressions.Expression is
            let use tokenizer_state = context.tokenizer_speculate_then_commit()

            let start = context.location
            let result = expression_primary_parser.parse(context)!

            return _parse_trailers(context, start, result, tokenizer_state)
        si

        // The right side of `|>` or `~>`, with `subject` threaded in as
        // the first argument of its call. Reached from the expression
        // parser, where both operators are a binary precedence level: the
        // subject is whatever that level gathered on the left, and the
        // call is a closed form, so an operator after it applies to the
        // whole chain.
        parse_thread_first(
            context: CONTEXT,
            subject: Trees.Expressions.Expression,
            propagating: bool,
            spelling: string
        ) -> Trees.Expressions.Expression is
            let use tokenizer_state = context.tokenizer_speculate_then_commit()

            return _parse_thread_first(context, subject.location, subject, tokenizer_state, propagating, spelling)
        si

        // Parse the right side as a function call with the subject
        // threaded in as its first argument, so the call resolves and
        // emits like any other, then apply any trailers that follow the
        // call to its result. `propagating` marks a `~>` call, whose
        // evaluation the expression passes lower inside a presence test
        // on the subject.
        _parse_thread_first(
            context: CONTEXT,
            start: Source.LOCATION,
            subject: Trees.Expressions.Expression,
            tokenizer_state: Syntax.Parsers.TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT,
            propagating: bool,
            spelling: string
        ) -> Trees.Expressions.Expression is
            let operator_location = context.location

            context.next_token()

            let pipe_start = context.location

            // A thread-first operator at the end of a line usually
            // carries its call over to the next one, which is how a
            // wrapped chain is written. What it must not do is reach
            // across the boundary for something that was never a call:
            // an unfinished `xs |>` is followed by the next statement,
            // and reading that as the right side loses it and reports
            // the loss somewhere else entirely. Only a name continues
            // the chain, so anything else on a fresh line means the
            // call has not been typed yet - hand back the placeholder
            // the completer anchors on.
            if context.current.first_on_line /\ !_can_lead_thread_first_right_side(context) then
                context.error(operator_location, "expected a function call after {spelling}")

                return _incomplete_thread_first(
                    start,
                    subject,
                    operator_location::pipe_start,
                    _missing_thread_first_function(operator_location)
                )
            fi

            // A function named with an operator is not a primary
            // expression, so `xs |> $` needs its own step here.
            // With no argument list after the name the threaded
            // value is the only argument, which is the point of
            // the spelling; an argument list is still accepted
            // and threads the value in ahead of it as usual.
            let rhs: Trees.Expressions.Expression mut

            if context.current.token == Lexical.TOKEN.OPERATOR then
                let name_location = context.location

                let name =
                    Trees.Expressions.IDENTIFIER(
                        name_location,
                        Trees.Identifiers.Identifier(name_location, context.current.value_string)
                    )

                context.next_token()

                if context.current.token == Lexical.TOKEN.PAREN_OPEN then
                    rhs = _parse_trailers(context, pipe_start, name, tokenizer_state)
                else
                    rhs =
                        _parse_trailers(
                            context,
                            pipe_start,
                            Trees.Expressions.CALL(
                                name_location,
                                name,
                                Trees.Expressions.LIST(
                                    name_location,
                                    Collections.LIST[Trees.Expressions.Expression]()
                                )
                            ),
                            tokenizer_state
                        )
                fi
            else
                rhs =
                    _parse_trailers(context, pipe_start, expression_primary_parser.parse(context)!, tokenizer_state)
            fi

            let rhs_call = _call_to_thread_into(rhs)

            if rhs_call? then
                // Thread the subject in as the first actual argument
                // and flag the call, so every later pass sees an
                // ordinary call.
                rhs_call.arguments.expressions.insert(0, subject)
                rhs_call.is_thread_first = true
                rhs_call.propagates_absence = propagating
                rhs_call.completion_target = operator_location::rhs_call.function.location

                return rhs
            fi

            // A name with no argument list is what half-typed code
            // looks like, so keep the thread-first shape for the
            // completer instead of handing back the bare right side.
            // Poisoning the name is what stops the placeholder call
            // resolving and cascading.
            context.error(rhs.location, "the right side of {spelling} must be a function call")
            rhs.poison()

            return _incomplete_thread_first(start, subject, operator_location::rhs.location, rhs)
        si

        // The call a `|>` right side threads its subject into: the
        // outermost one, reached through any trailers written after it.
        // `xs |> f().count` threads into `f()` and reads `count` from the
        // result, while `xs |> BOX(10).combine(3)` threads into `combine`
        // with `BOX(10)` as its receiver. Absent when there is no call.
        _call_to_thread_into(rhs: Trees.Expressions.Expression) -> Trees.Expressions.CALL? static is
            let current: Trees.Expressions.Expression mut = rhs

            do
                if let call: Trees.Expressions.CALL = current then
                    return call
                elif let member: Trees.Expressions.MEMBER = current then
                    current = member.left
                elif let index: Trees.Expressions.INDEX = current then
                    current = index.left
                elif let unwrap: Trees.Expressions.UNWRAP = current then
                    current = unwrap.left
                elif let has_value: Trees.Expressions.HAS_VALUE = current then
                    current = has_value.left
                else
                    return null
                fi
            od
        si

        // Consume the postfix trailers (`.member`, `(args)`, `[index]`, …)
        // that follow a primary.
        _parse_trailers(
            context: CONTEXT,
            start: LOCATION,
            result_in: Trees.Expressions.Expression,
            tokenizer_state: Syntax.Parsers.TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT
        ) -> Trees.Expressions.Expression =>
            _parse_trailers(context, start, result_in, tokenizer_state, null, null)

        // A member name written on the line after its `.`. Wrapping a chain
        // that way is legal, but so is a `.` left dangling at the end of a
        // half-written line, and then the next line is some other statement
        // or definition whose first name the `.` would take. The member and
        // everything after it are read speculatively, and kept only if they
        // parse without complaint; otherwise the name is reported missing
        // after the `.` and the next line is left to be read as what it is.
        // A program that parses keeps its reading whatever its layout.
        _parse_member_on_next_line(
            context: CONTEXT,
            start: LOCATION,
            left: Trees.Expressions.Expression,
            completion_target_start: LOCATION,
            tokenizer_state: Syntax.Parsers.TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT
        ) -> Trees.Expressions.Expression is
            let missing_at = context.previous_end

            let use diagnostics_snapshot = context.diagnostics_speculate_then_backtrack()
            let use snapshot = context.tokenizer_speculate_then_backtrack_bounded()

            let errors_before = context.logger.error_count

            let member = identifier_parser.parse(context)!

            let result =
                _parse_trailers(
                    context,
                    start,
                    Trees.Expressions.MEMBER(start::member.location, left, member, completion_target_start::member.location),
                    tokenizer_state,
                    left,
                    member
                )

            if !result.is_poisoned /\ context.logger.error_count == errors_before then
                snapshot.commit()
                diagnostics_snapshot.commit()

                return result
            fi

            snapshot.backtrack()
            diagnostics_snapshot.backtrack()

            context.error(missing_at, "expected a member name here")

            return Trees.Expressions.MEMBER(
                start..context.location,
                left,
                Trees.Identifiers.Identifier(completion_target_start, ""),
                completion_target_start::context.location
            )
        si

        _parse_trailers(
            context: CONTEXT,
            start: LOCATION,
            result_in: Trees.Expressions.Expression,
            tokenizer_state: Syntax.Parsers.TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT,
            previous_left_in: Trees.Expressions.Expression?,
            previous_identifier_in: Trees.Identifiers.Identifier?
        ) -> Trees.Expressions.Expression is
            let result: Trees.Expressions.Expression mut = result_in
            let previous_left: Trees.Expressions.Expression? mut = previous_left_in
            let previous_identifier: Trees.Identifiers.Identifier? mut = previous_identifier_in

            do
                // A trailer that could equally open a new member or
                // statement never glues across a line break: a line-start
                // `(`, `[`, backtick generic-argument list or operator ends
                // the expression. A line-start `!` is a prefix `not`
                // opening the next statement, a line-start `=~` the next
                // operator member, a line-start `rec` the self-reference
                // call of an enclosing anonymous function rather than a
                // rec-lambda marker for this expression. Trailers that lead
                // continuation lines by convention (`.`, `?`, `ref`) still
                // continue.
                if
                    context.current.first_on_line /\
                    (
                        context.current.token == Lexical.TOKEN.PAREN_OPEN \/
                        context.current.token == Lexical.TOKEN.SQUARE_OPEN \/
                        context.current.token == Lexical.TOKEN.SQUARE_OPEN_TICK \/
                        context.current.token == Lexical.TOKEN.REC \/
                        context.current.token == Lexical.TOKEN.OPERATOR
                    )
                then
                    return result
                fi

                case context.current.token
                when Lexical.TOKEN.PAREN_OPEN then
                    context.next_token()
                    let arguments: Trees.Expressions.LIST mut
                    if context.current.token != Lexical.TOKEN.PAREN_CLOSE then
                        arguments = expression_list_parser.parse(context)!
                    else
                        arguments = Trees.Expressions.LIST(context.location, Collections.LIST[Trees.Expressions.Expression]())
                    fi
                    let call_expression = Trees.Expressions.CALL(start::context.location, result, arguments)
                    call_expression.rewrite_named_arguments(context.logger)
                    result = call_expression
                    context.expect_bracket_closer(Lexical.TOKEN.PAREN_OPEN, Lexical.TOKEN.PAREN_CLOSE, syntax_error_message)

                when Lexical.TOKEN.SQUARE_OPEN then
                    context.next_token()

                    let done mut = false

                    let left: Trees.Expressions.Expression? mut = _
                    let identifier: Trees.Identifiers.Identifier? mut = _

                    if result.is_member then
                        left = previous_left
                        identifier = previous_identifier

                    elif result.is_identifier then
                        left = null
                        identifier = result.try_copy_as_identifer()
                    fi

                    if identifier? then
                        let use tokenizer_state = context.tokenizer_speculate_then_commit()
                        let use logger_state = context.logger_speculate_then_commit()

                        let type_arguments = type_list_parser.parse(context)

                        if type_arguments? /\ !type_arguments.is_poisoned /\ context.next_token(Lexical.TOKEN.SQUARE_CLOSE) then
                            let index_expression: Trees.Expressions.Expression? mut = _

                            if type_arguments.count == 1 then
                                let index = type_arguments.elements[0].try_copy_as_value_expression()
                                if index? then
                                    index_expression = Trees.Expressions.INDEX(start::context.location, result, index)
                                fi
                            fi

                            done = true

                            if index_expression? then
                                result = Trees.Expressions.AMBIGUOUS_EXPRESSION(
                                    start::context.location,
                                    index_expression,
                                    left,
                                    identifier,
                                    type_arguments
                                )
                            else
                                result = Trees.Expressions.GENERIC_APPLICATION(
                                    start::context.location,
                                    left,
                                    identifier,
                                    type_arguments
                                )
                            fi

                            tokenizer_state.commit()
                            logger_state.commit()

                            // FIXME: continue generates incorrect code here
                            // continue;
                        fi

                        tokenizer_state.backtrack_if_speculating()
                        logger_state.backtrack_if_speculating()
                    fi

                    if !done then
                        let index = expression_parser.parse(context)!

                        result = Trees.Expressions.INDEX(start::context.location, result, index)

                        context.next_token(Lexical.TOKEN.SQUARE_CLOSE, syntax_error_message)
                    fi

                when Lexical.TOKEN.DOT then
                    let completion_target_start = context.location

                    context.next_token()

                    if
                        context.current.token == Lexical.TOKEN.IDENTIFIER /\
                        context.current.first_on_line
                    then
                        return _parse_member_on_next_line(context, start, result, completion_target_start, tokenizer_state)
                    elif
                        context.current.token == Lexical.TOKEN.IDENTIFIER
                    then
                        let member = identifier_parser.parse(context)!

                        previous_left = result
                        previous_identifier = member

                        result = Trees.Expressions.MEMBER(start::member.location, result, member, completion_target_start::member.location)
                    elif looks_like_partial_member_keyword(context, completion_target_start) then
                        // Mid-typing case like `value.is` (en route to
                        // `value.is_empty`). The token is a reserved
                        // word the tokenizer has already classified,
                        // but it sits in identifier position after a
                        // `.`; treat it as a partial member name so
                        // the completer has a MEMBER node with a
                        // populated `right` to anchor suggestions on.
                        // The same-line guard prevents this consuming
                        // a structural keyword on the next line
                        // (`namespace Test.\n is`).
                        let name = context.current.value_string
                        let member = Trees.Identifiers.Identifier(context.location, name)
                        context.next_token()

                        previous_left = result
                        previous_identifier = member

                        result = Trees.Expressions.MEMBER(start::member.location, result, member, completion_target_start::member.location)
                    elif looks_like_operator_member_name(context, completion_target_start) then
                        // `a. =~(b)` — an operator member named after a
                        // dot. Same node as any other member access;
                        // the operator's name is just spelled in
                        // operator characters.
                        let name = context.current.value_string
                        let member = Trees.Identifiers.Identifier(context.location, name)
                        context.next_token()

                        previous_left = result
                        previous_identifier = member

                        result = Trees.Expressions.MEMBER(start::member.location, result, member, completion_target_start::member.location)
                    elif
                        context.current.token == Lexical.TOKEN.INT_LITERAL \/
                        context.current.token == Lexical.TOKEN.FLOAT_LITERAL \/
                        context.current.token == Lexical.TOKEN.DOUBLE_LITERAL
                    then
                        // `.` followed by a numeric literal, e.g. `p.0`.
                        // Positional tuple members are named by their
                        // index, but a bare number is not an identifier, so
                        // the index must be backtick-escaped (`p.` followed
                        // by a backtick and the number). Point at that, then
                        // consume the number so it doesn't linger and
                        // cascade into a spurious "expected ;" on the rest of
                        // the statement. Recover with a poisoned placeholder
                        // identifier so later passes that assume
                        // MEMBER.identifier is non-null don't crash.
                        context.error(context.location, "a numeric member name must be escaped with a leading backtick")
                        let member_location = context.location
                        context.next_token()
                        result = Trees.Expressions.MEMBER(start::member_location, result, Trees.Identifiers.Identifier(completion_target_start, ""), completion_target_start::member_location)
                    else
                        // `.` not followed by a member name: expect_token
                        // reports it. Recover with a poisoned placeholder
                        // identifier rather than null — later passes assume
                        // MEMBER.identifier is non-null and would otherwise
                        // crash dereferencing it. The offending token is left
                        // for the enclosing context to resynchronise on.
                        context.expect_token(Lexical.TOKEN.IDENTIFIER)
                        result = Trees.Expressions.MEMBER(start..context.location, result, Trees.Identifiers.Identifier(completion_target_start, ""), completion_target_start::context.location)
                    fi

                when Lexical.TOKEN.ARROW_THIN, Lexical.TOKEN.ARROW_FAT, Lexical.TOKEN.IS, Lexical.TOKEN.REC then
                    // we could be in a global function or in a method. If the left part looks like it could be a function or method definition
                    // then it's an error and we need to recover.

                    // we'll need a heuristic to try to decide if the user is trying to define a nested function or if they've missed off a closing `si`
                    // and actually this is a method definition (if we're in a classy context) or a global function definition (if we're not in a classy context)

                    let is_nested_function_definition mut = false

                    if result.could_be_nested_function_definition /\ tokenizer_state.is_speculating then
                        // TODO need same logic but for nested within a global function
                        if context.in_member then
                            if result.location.start_column > context.member_indent then
                                // probably an attempt at nesting a named function definition
                                is_nested_function_definition = true
                            elif
                                result.location.start_column <= context.member_indent /\
                                result.location.start_column > context.global_indent
                            then
                                // probably a missing `si` in a preceding member definition
                                context.error(result.location, "expected 'si' after member definition")

                                tokenizer_state.backtrack()

                                throw UNWIND_TO_MEMBER_EXCEPTION(null)
                            fi
                        elif context.in_global_function then
                            if result.location.start_column > context.global_indent then
                                // probably an attempt at nesting a named function definition
                                is_nested_function_definition = true
                            else
                                // probably a missing `si` in a preceding member definition
                                context.error(result.location, "expected 'si' after member definition")

                                tokenizer_state.backtrack()

                                throw UNWIND_TO_GLOBAL_EXCEPTION(null)
                            fi
                        elif context.in_classy then
                            // not clear how we might have ended up here
                            tokenizer_state.backtrack()

                            throw UNWIND_TO_GLOBAL_EXCEPTION(null)
                        fi
                    fi

                    // it's unlikely to be member or global function definition, so we should
                    // parse it as a function literal, even if it has a name or is otherwise garbled.
                    // In particular, if has a block body delimited with with is / si, then we want to
                    // consume that block, otherwise our view of the block structure will get out of sync
                    // and we'll think we've let the enclosing function or method when we reach the closing
                    // `si` of the function literal

                    // A named function among the statements of a body. The
                    // statement parser has already established that the shape
                    // can only be one, so the name and the parenthesised
                    // formals are taken from the call and the literal is built
                    // from them. Everywhere else the same shape is still the
                    // mistake it always was.
                    let nested_name: Trees.Identifiers.Identifier? mut = _
                    let nested_call: Trees.Expressions.CALL? mut = _
                    let should_poison mut = false

                    if result.could_be_nested_function_definition then
                        let claimed mut = false

                        if context.allow_nested_function then
                            if let call: Trees.Expressions.CALL = result then
                                if let callee: Trees.Expressions.IDENTIFIER = call.function then
                                    context.allow_nested_function = false

                                    nested_call = call
                                    nested_name = callee.identifier
                                    claimed = true
                                fi
                            fi
                        fi

                        if !claimed then
                            should_poison = true
                            context.error(result.location, "nested function definition")
                        fi
                    elif !result.could_be_formal_argument then
                        should_poison = true
                        context.error(result.location, "expected function literal formal arguments")
                    fi

                    let type_expression: Trees.TypeExpressions.TypeExpression mut
                    let arguments: Trees.Expressions.LIST mut

                    if context.current.token == Lexical.TOKEN.ARROW_THIN then
                        context.next_token()
                        type_expression = type_parser.parse(context)!
                        type_expression.check_is_not_reference(context.logger, "function cannot return a ref type")
                    else
                        type_expression = Trees.TypeExpressions.INFER(start::result.location)
                    fi

                    if context.expect_token([Lexical.TOKEN.ARROW_FAT, Lexical.TOKEN.IS, Lexical.TOKEN.REC]) then
                        if should_poison then
                            // error already reported
                            arguments = Trees.Expressions.LIST(start::result.location, Collections.LIST[Trees.Expressions.Expression]())
                        elif nested_name? then
                            arguments = nested_call!.arguments
                            arguments.rewrite_as_variables()
                        elif isa Trees.Expressions.TUPLE(result) then
                            arguments = result.elements
                            arguments.rewrite_as_variables()
                        else
                            let elements = Collections.LIST[Trees.Expressions.Expression]()
                            elements.add(result)
                            arguments = Trees.Expressions.LIST(start::result.location, elements)
                        fi

                        let is_recursive =
                            if context.current.token == Lexical.TOKEN.REC then
                                context.next_token()
                                true
                            else
                                false
                            fi

                        // A lambda body is a fresh statement context. The
                        // enclosing argument list leaves allow_tuple_element
                        // set while an argument expression parses, so without
                        // this reset the body's leading `x = e` statement is
                        // consumed as a formal-argument-style variable
                        // declaration rather than an assignment. A body
                        // written inside a top-level statement is an ordinary
                        // body too, and takes named functions like any other.
                        context.allow_tuple_element = false

                        let was_top_level = context.in_top_level_statements

                        context.in_top_level_statements = false

                        let body: Trees.Bodies.Body mut = _

                        try
                            body = body_parser.parse(context)!
                        finally
                            context.in_top_level_statements = was_top_level
                        yrt

                        let literal =
                            Trees.Expressions.FUNCTION(
                                start::body.location,
                                arguments,
                                type_expression,
                                body,
                                is_recursive
                            )

                        if let name = nested_name then
                            literal.set_nested_name(name)
                        fi

                        result = literal

                        if should_poison then
                            result.poison()
                        fi

                        return result
                    else
                        // TODO: is this possible?
                        return Trees.Expressions.Literals.NONE(start::context.location)
                    fi

                when Lexical.TOKEN.QUESTION then
                    let question_location = context.location
                    tokenizer_state.commit_if_speculating()

                    context.next_token()

                    if context.current.token == Lexical.TOKEN.DOT then
                        // `?.` coalescing member access. Tokenizer
                        // breaks `?.` into two adjacent tokens (per
                        // the `?`/`!` followed-by-`.` rule in
                        // read_operator), so we recognise the
                        // sequence here.
                        let completion_target_start = question_location
                        context.next_token()

                        if context.current.token == Lexical.TOKEN.IDENTIFIER then
                            let member = identifier_parser.parse(context)!

                            previous_left = result
                            previous_identifier = member

                            let member_node =
                                Trees.Expressions.MEMBER(
                                    start::member.location,
                                    result,
                                    member,
                                    completion_target_start::member.location
                                )

                            member_node.is_coalesce = true
                            result = member_node
                        else
                            // `?.` not followed by a member name: recover
                            // with a poisoned placeholder identifier, not
                            // null, so passes assuming MEMBER.identifier is
                            // non-null don't crash.
                            context.expect_token(Lexical.TOKEN.IDENTIFIER)

                            let member_node =
                                Trees.Expressions.MEMBER(
                                    start..context.location,
                                    result,
                                    Trees.Identifiers.Identifier(completion_target_start, ""),
                                    completion_target_start::context.location
                                )

                            member_node.is_coalesce = true
                            result = member_node
                        fi
                    else
                        result = Trees.Expressions.HAS_VALUE(start::question_location, result)
                    fi

                when Lexical.TOKEN.REF then
                    result = Trees.Expressions.REFERENCE(start::context.location, result)
                    tokenizer_state.commit_if_speculating()

                    context.next_token()

                when Lexical.TOKEN.OPERATOR then
                    tokenizer_state.commit_if_speculating()

                    if context.current_string =~ "!" then
                        result = Trees.Expressions.UNWRAP(start::context.location, result)

                        context.next_token()
                    else
                        return result
                    fi

                when Lexical.TOKEN.SQUARE_OPEN_TICK then
                    tokenizer_state.commit_if_speculating()

                    context.next_token()

                    let type_arguments = type_list_parser.parse(context)!

                    let left: Trees.Expressions.Expression? mut = _
                    let identifier: Trees.Identifiers.Identifier? mut = _

                    if result.is_member then
                        left = previous_left
                        identifier = previous_identifier

                    elif result.is_identifier then
                        left = null
                        identifier = result.try_copy_as_identifer()
                    fi

                    if identifier? then
                        result = Trees.Expressions.GENERIC_APPLICATION(
                            start::context.location,
                            left,
                            identifier,
                            type_arguments
                        )
                    else
                        result.poison()
                        context.error(result.location, "cannot apply type arguments to this")
                    fi

                    context.next_token(Lexical.TOKEN.SQUARE_CLOSE)

                else
                    return result
                esac
            od
        si
    si
si
