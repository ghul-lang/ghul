namespace Syntax.Parsers is
    // The `~` that marks a pattern value to match rather than a name to
    // bind. It is scanned as an OPERATOR like any other run of operator
    // characters, so the spelling is what is checked; the leaf parser and
    // the `case` arm parser both read it.
    is_match_marker(context: CONTEXT) -> bool =>
        context.current.token == Lexical.TOKEN.OPERATOR /\
        context.current.value_string =~ "~"

    // A `~` scanned as one operator token with the operator characters
    // after it, as `~-1` and `~*` are: the marker, then that operator.
    is_joined_match_marker(context: CONTEXT) -> bool =>
        context.current.token == Lexical.TOKEN.OPERATOR /\
        context.current.value_string.length > 1 /\
        context.current.value_string.starts_with("~")

    // Where the `~` of a joined marker is: the first character of the
    // run.
    match_marker_location(context: CONTEXT) -> Source.LOCATION =>
        _split_location(context.location, true)

    // Where the operator after a joined marker is: the rest of the run.
    after_match_marker_location(context: CONTEXT) -> Source.LOCATION =>
        _split_location(context.location, false)

    _split_location(run: Source.LOCATION, marker: bool) -> Source.LOCATION =>
        if marker then
            Source.LOCATION(run.file_name, run.start_line, run.start_column, run.start_line, run.start_column + 1)
        else
            Source.LOCATION(run.file_name, run.start_line, run.start_column + 1, run.end_line, run.end_column)
        fi
si
