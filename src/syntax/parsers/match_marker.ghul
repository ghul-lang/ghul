namespace Syntax.Parsers is
    // The `~` that marks a pattern value to match rather than a name to
    // bind. It is scanned as an OPERATOR like any other run of operator
    // characters, so the spelling is what is checked; the leaf parser and
    // the `case` arm parser both read it.
    is_match_marker(context: CONTEXT) -> bool =>
        context.current.token == Lexical.TOKEN.OPERATOR /\
        context.current.value_string =~ "~"

    // A `~` scanned as one operator with the operator characters that
    // follow it, as `~-1` is. The run is a single token, so the marker
    // cannot be read off it.
    is_joined_match_marker(context: CONTEXT) -> bool =>
        context.current.token == Lexical.TOKEN.OPERATOR /\
        context.current.value_string.length > 1 /\
        context.current.value_string.starts_with("~")

    // Reports a marker joined to the operator after it, and consumes the
    // run so that what follows still parses as the pattern value.
    report_joined_match_marker(context: CONTEXT) is
        let run = context.current.value_string

        context.error(
            context.location,
            "match-marker-joined-to-operator", "match marker '~' is joined to the operator '{run.substring(1)}' that follows it"
        )

        context.next_token()
    si
si
