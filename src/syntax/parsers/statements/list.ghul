namespace Syntax.Parsers.Statements is
    use System.Exception

    use IO.Std

    use Source

    use Ghul.Pipes

    class LIST(
        terminators: Collections.LIST[Lexical.TOKEN],
        statement_parser: Parser[Trees.Statements.Statement]
    ): Base[Trees.Statements.LIST] is
        terminators: Collections.List[Lexical.TOKEN]
        description: string => "statement list"

        super()

        parse(context: CONTEXT) -> Trees.Statements.LIST is
            self.terminators = terminators

            let start = context.location
            let end mut = context.location
            let statements = Collections.LIST[Trees.Statements.Statement]()

            let want_semicolon mut = false

            // Whether the final statement of the list was terminated with
            // a written `;`. Compound statements never demand one, so a
            // `;` after them is consumed here and recorded - at end-of-body
            // the fact distinguishes a discarded statement from an
            // implicit tail return.
            let last_terminated mut = true

            // Set while a stray clause keyword skipped as debris has not yet
            // met its closer: a pasted fragment such as `else ... esac` is
            // one mistake, so the closer that ends it is skipped unreported.
            let in_debris_fragment mut = false

            while !context.is_end_of_file /\ !at_terminator(context) do
                if context.at_debris_closer then
                    let is_clause = context.is_clause_keyword(context.current_token)

                    if is_clause \/ !in_debris_fragment then
                        context.error(context.location, "syntax error: unexpected {context.current_token_name}")
                    fi

                    in_debris_fragment = is_clause

                    context.next_token()
                elif context.current.token == Lexical.TOKEN.SEMICOLON then
                    let semicolon = context.current
                    context.next_token()
                    context.note_written_terminator(semicolon)

                    want_semicolon = false
                    last_terminated = true
                elif context.current_token == Lexical.TOKEN.COMMA then
                    // Nothing open is waiting for this comma, or the list
                    // would have ended at it: it is debris left by an
                    // expression that broke off before it.
                    context.error(context.location, "syntax error: unexpected {context.current_token_name}")

                    context.next_token()

                    want_semicolon = false
                elif want_semicolon then
                    case context.accept_terminator()
                    when Parsers.TERMINATOR.WRITTEN then
                        last_terminated = true
                    when Parsers.TERMINATOR.INFERRED then
                        last_terminated = false
                    when Parsers.TERMINATOR.MISSING then
                        // reported; recovery continues below as before
                    esac

                    want_semicolon = false
                else
                    try
                        let statement = statement_parser.parse(context)

                        if statement? then
                            statements.add(statement)

                            end = statement.location

                            if statement.expects_semicolon then
                                want_semicolon = true
                                last_terminated = false
                            elif context.current.token == Lexical.TOKEN.SEMICOLON then
                                let semicolon = context.current
                                context.next_token()
                                context.note_written_terminator(semicolon)
                                last_terminated = true
                            else
                                // A compound statement demands no terminator,
                                // so its boundary never reaches
                                // accept_terminator - but a `;` written here
                                // is redundant, so the boundary is one the
                                // inlay marks.
                                context.note_inferred_terminator()

                                last_terminated = false
                            fi
                        else
                            // the statement parser reported its errors and gave up:
                            // skip ahead so the unparsed tokens don't produce a
                            // cascade of follow-on errors
                            end = recover_to_terminator(context, start.start_column)
                        fi
                    catch e: UnwindException
                        throw e
                    catch e: Exception
                        end = recover_to_terminator(context, start.start_column)
                    yrt
                fi
            od

            // The last statement of the list falls out of the loop before
            // reaching accept_terminator, so its boundary is recorded here.
            if want_semicolon then
                context.note_inferred_terminator()
            fi

            let result = Trees.Statements.LIST(start::end, statements)
            result.last_was_terminated = last_terminated

            return result
        si

        // A comma ends a statement list only where something is waiting for
        // one, so a stray comma in a function body does not end the body.
        at_terminator(context: CONTEXT) -> bool =>
            (
                terminators |> any(t => t == context.current_token) \/
                (context.current_token == Lexical.TOKEN.COMMA /\ context.is_awaited_ender(Lexical.TOKEN.COMMA))
            ) /\
            !context.at_debris_closer

        // Resynchronise after a statement the parser could not build. The
        // tokens from here to the next statement boundary are unparsed, so
        // skipping them stops each producing an error of its own - but
        // skipping too many is far worse than skipping too few. A keyword
        // consumed here that some enclosing construct was waiting for
        // leaves that construct hunting an ender that no longer exists, and
        // one unparseable statement takes the rest of the body with it.
        //
        // Three things stop the skip:
        //
        //   a token some construct still being parsed would end at, which
        //     is read from those parsers rather than guessed at - see
        //     CONTEXT._awaited_enders. A closing keyword that ends nothing
        //     open belongs to a construct the parser never entered, so it
        //     is debris and the skip goes past it;
        //   a line indented no further than the list itself;
        //   a keyword that can only begin a statement.
        //
        // Nothing is counted. An earlier version tracked how deep in
        // brackets the skip had gone, which fails for the reason such
        // counting always fails here: the code being recovered from is
        // incomplete, so its brackets do not balance, and a count taken
        // from them is a count of the mistake. Asking the parsers what they
        // are waiting for needs no such assumption.
        //
        // The skip always consumes at least one token once it has started,
        // or the caller re-attempts the same failing parse forever.
        recover_to_terminator(context: CONTEXT, indent: int) -> LOCATION is
            let end mut = context.previous_end
            let consumed mut = false

            while !context.is_end_of_file do
                if context.is_awaited_ender(context.current_token) then
                    break
                fi

                if consumed /\ _at_resync_point(context, indent) then
                    break
                fi

                end = context.current.location

                context.next_token()

                consumed = true
            od

            return end
        si

        // Where the skip can hand back to the statement parser. A keyword
        // that can begin nothing but a statement is one wherever it stands,
        // including on the line the skip started on - a construct written
        // after a stray token is still a construct, and stopping at its
        // first keyword parses it rather than discarding it. An identifier
        // or a literal is not, since either is far more often the tail of
        // whatever is being skipped; those resynchronise only once a line
        // has dedented back to the list's own level, which starts something
        // new whatever it opens with.
        _at_resync_point(context: CONTEXT, indent: int) -> bool =>
            _starts_statement(context.current_token) \/
            (context.current.first_on_line /\ context.current.location.start_column <= indent)

        _starts_statement(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.LET \/
            token == Lexical.TOKEN.IF \/
            token == Lexical.TOKEN.CASE \/
            token == Lexical.TOKEN.WHILE \/
            token == Lexical.TOKEN.FOR \/
            token == Lexical.TOKEN.TRY \/
            token == Lexical.TOKEN.RETURN \/
            token == Lexical.TOKEN.YIELD \/
            token == Lexical.TOKEN.THROW \/
            token == Lexical.TOKEN.BREAK \/
            token == Lexical.TOKEN.CONTINUE \/
            token == Lexical.TOKEN.ASSERT


    si
si
