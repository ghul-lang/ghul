namespace Syntax.Parsers.Modifiers is

    use Source

    class LIST(modifier_parser: Parser[Trees.Modifiers.Modifier]): Base[Trees.Modifiers.LIST] is
        super()

        parse(context: CONTEXT) -> Trees.Modifiers.LIST is
            let start = context.location
            let end mut = context.location
            let access_modifier: Trees.Modifiers.AccessModifier? mut = null
            let storage_class: Trees.Modifiers.StorageClass? mut = null
            let is_abstract mut = false
            let is_pure mut = false
            let is_stable mut = false
            let memo: Trees.Modifiers.Modifier? mut = null

            while true do
                // A modifier attaches on the declaration's own line: a
                // line-start `init`, `public`, `static`, ... is the next
                // member, not a wrapped modifier.
                if context.current.first_on_line then
                    break
                fi

                let modifier = modifier_parser.parse(context)

                if !modifier? then
                    break
                fi

                end = modifier.location

                if isa Trees.Modifiers.AccessModifier(modifier) then
                    if access_modifier? then
                        context.error(modifier.location, "duplicate access modifier", access_modifier.location, "first written here")
                    else
                        access_modifier = modifier
                    fi
                elif modifier.is_abstract then
                    is_abstract = true
                elif modifier.is_pure then
                    is_pure = true
                elif modifier.is_stable then
                    is_stable = true
                elif modifier.is_memo then
                    if memo? then
                        context.error(modifier.location, "duplicate memo modifier", memo.location, "first written here")
                    else
                        memo = modifier
                    fi
                elif isa Trees.Modifiers.StorageClass(modifier) then
                    if storage_class? then
                        context.error(modifier.location, "duplicate storage class modifier", storage_class.location, "first written here")
                    else
                        storage_class = modifier
                    fi
                else
                    context.error(modifier.location, "unexpected modifier {modifier}")
                fi
            od

            let result = Trees.Modifiers.LIST(start::end, access_modifier, storage_class)
            result.is_abstract = is_abstract
            result.is_pure = is_pure
            result.is_stable = is_stable
            result.is_memo = memo?
            return result
        si
    si
si
