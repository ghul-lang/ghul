namespace Syntax.Parsers is
    // Whether the current token is one of the contextual markers - `memo`
    // or `pure` - that can sit between a function literal's parameters or
    // return type and its body, sharing a line with what came before.
    //
    // The expression parser's literal-marker scan and the statement
    // parser's nested-function peek both test for the same thing, so the
    // test lives here once and a third marker is added in one place.
    is_function_literal_marker(context: CONTEXT) -> bool =>
        context.current.token == Lexical.TOKEN.IDENTIFIER /\
        !context.current.first_on_line /\
        (context.current.value_string =~ "memo" \/ context.current.value_string =~ "pure")
si
