namespace Syntax.Parsers.Definitions is
    use System.Exception
    use IO.Std
    use Ghul.Disposable

    use Source

    class GLOBAL_LIST(
        pragma_parser: Parser[Trees.Pragmas.PRAGMA],
        definition_parser: Parser[Trees.Definitions.Definition],
        statement_parser: Parser[Trees.Statements.Statement],
        precedence_map: Collections.MutableMap[string,Syntax.Parsers.Expressions.PRECEDENCE],
        precedence_helper: PRAGMA_PRECEDENCE
    ): Base[Trees.Definitions.LIST] is
        description: string => "definition list"

        super()

        _resync: DEFINITION_RESYNC

        init(..) is
            _resync = DEFINITION_RESYNC()
        si

        parse(context: CONTEXT) -> Trees.Definitions.LIST is
            let start = context.location
            let end mut = context.location
            let definitions = Collections.LIST[Trees.Definitions.Definition]()
            let statements = Collections.LIST[Trees.Statements.Statement]()
            let file_pragmas = Collections.LIST[Trees.Pragmas.PRAGMA]()

            // @@ pragmas are only read here, before the main loop: a
            // whole-file pragma must precede everything else in the file,
            // so one seen once anything has been collected is reported
            // and skipped in the loop below. GLOBAL_LIST is reused as the
            // namespace body parser (see CONTEXT.namespace_depth), so this
            // is gated to depth 0 - a namespace body is never the file
            // root, and `@@` inside one falls through to the misplaced-
            // pragma report in the main loop instead.
            while
                context.namespace_depth == 0 /\
                context.current.token == Lexical.TOKEN.AT_AT /\
                !context.is_end_of_file
            do
                let pragma = pragma_parser.parse(context)

                if !pragma? then
                    break
                fi

                file_pragmas.add(pragma)

                // A file-level `precedence` applies to the rest of the
                // file's parse and is never restored.
                if pragma.is_name_equal_to("precedence") then
                    let operator_name: string mut = ""
                    let previous: Syntax.Parsers.Expressions.PRECEDENCE mut = _
                    let had_previous mut = false

                    precedence_helper.apply(context, pragma, precedence_map, operator_name ref, previous ref, had_previous ref)
                fi
            od

            // `si` closes a namespace *block* body (block depth > 0); at
            // the file root and inside a whole-file namespace it is stray
            // input the definition parser reports, so it must not end the
            // loop there.
            while
                !context.is_end_of_file /\
                (context.block_namespace_depth == 0 \/ context.current.token != Lexical.TOKEN.SI)
            do
                // A definition or statement attempt that fails without
                // throwing (its parser logs an error and returns null,
                // rather than raising) can leave the tokenizer position
                // exactly where it started - the failed attempt's own
                // speculation is backed out. Without a forced advance
                // here, the loop would re-attempt the identical parse at
                // the identical position forever.
                let attempt_start = context.location
                let progress_start = context.location.start
                let errors_before = context.logger.error_count

                // A closing keyword left over by a construct already
                // reported as unclosed is skipped rather than described
                // again as a definition that is not one. At the file root
                // and inside a whole-file namespace `si` is such a keyword
                // too; inside a namespace block the loop above has already
                // stopped on it.
                if context.at_stray_construct_closer(context.block_namespace_depth == 0) then
                    context.next_token()

                    continue
                fi

                try
                    if context.current.token == Lexical.TOKEN.AT_AT then
                        _reject_misplaced_file_pragma(context)
                    // Script mode: at the file root (no enclosing
                    // namespace) or inside a whole-file namespace - never
                    // inside a namespace block - a leading token that isn't
                    // a definition keyword may begin a top-level statement.
                    // Inside a block this is skipped and parsing is
                    // unchanged.
                    elif context.block_namespace_depth == 0 /\ !_is_definition_head(context.current.token) then
                        if _is_ambiguous_head(context.current.token) then
                            // IDENTIFIER / OPERATOR / [ can each begin a global
                            // member or a statement; a shallow peek routes the
                            // clear definitions. The rest are parsed as a
                            // statement, but speculatively: an incomplete
                            // definition that the peek couldn't recognise (e.g.
                            // `foo(` with no close) fails to parse as a statement
                            // and falls back to the definition parser's recovery.
                            if _starts_definition(context) \/ !_try_collect_statement(context, statements) then
                                _parse_definition(context, definitions, statements)
                                end = _end_of(definitions, end)
                            else
                                end = _end_of_statement(statements, end)
                            fi
                        elif _is_statement_head(context.current.token) then
                            _parse_statement(context, statements)
                            end = _end_of_statement(statements, end)
                        else
                            // Not a definition keyword and not a statement head:
                            // stray input, reported by the definition parser as
                            // before.
                            _parse_definition(context, definitions, statements)
                            end = _end_of(definitions, end)
                        fi
                    else
                        _parse_definition(context, definitions, statements)
                        end = _end_of(definitions, end)
                    fi
                catch ue: UNWIND_TO_GLOBAL_EXCEPTION
                    // carry on from here
                catch e: Exception
                    IoC.CONTAINER.instance.logger.exception(context.current.location, e, "parse exception: {e.message}")

                    while
                        !context.is_end_of_file /\
                        context.current.token != Lexical.TOKEN.SI /\
                        context.current.token != Lexical.TOKEN.SEMICOLON
                    do
                        context.next_token()
                    od

                    if context.is_end_of_file then
                        break
                    fi
                yrt

                _resync.recover(context, attempt_start, errors_before)

                if context.location.start == progress_start /\ !context.is_end_of_file then
                    context.next_token()
                fi
            od

            let result = Trees.Definitions.LIST(start::end, definitions)

            if file_pragmas.count > 0 then
                result.file_pragmas = file_pragmas
            fi

            // Hand any bare top-level statements to synthesise-top-level-entry,
            // which wraps them into a global entry point. Reachable at the
            // file root and inside a whole-file namespace (block depth 0).
            //
            // Spanned by the statements themselves rather than by the whole
            // file: the span becomes the synthesised entry's body location, and
            // an incremental edit treats everything inside a re-walked body as
            // re-recorded by that re-walk. A whole-file span therefore discards
            // what the re-walk does not produce - the imports at the head of the
            // file among them - and nothing puts those back.
            if statements.count > 0 then
                result.top_level_statements =
                    Trees.Statements.LIST(
                        statements[0].location :: statements[statements.count - 1].location,
                        statements
                    )
            fi

            return result
        si

        // A @@ seen once the file has anything in it. Reports where it must
        // have been instead, then hands off to the ordinary pragma parser
        // to consume its tokens (name, arguments, however they're shaped)
        // so the loop can carry on. The parsed pragma itself is discarded:
        // a misplaced one is never applied.
        _reject_misplaced_file_pragma(context: CONTEXT) is
            context.error(context.current.location, "a @@ pragma must precede everything else in the file")

            pragma_parser.parse(context)

            _skip_semicolon(context)
        si

        _parse_definition(
            context: CONTEXT,
            definitions: Collections.MutableList[Trees.Definitions.Definition],
            statements: Collections.MutableList[Trees.Statements.Statement]) is
            let definition = definition_parser.parse(context)

            if definition? then
                // A whole-file namespace opens the file's scope, so it must
                // open the file: anything collected before it would sit at
                // the file root instead of inside it. Checked here, where
                // both lists are in hand; the parse has already succeeded,
                // so the namespace stays in the tree and the error stands
                // alone.
                if
                    context.namespace_depth == 0 /\
                    (definitions.count > 0 \/ statements.count > 0)
                then
                    if let `namespace = cast Trees.Definitions.NAMESPACE?(definition.without_pragmas) then
                        if `namespace.is_file_scope then
                            context.error(
                                `namespace.location,
                                "a whole-file namespace must be the first declaration in the file")
                        fi
                    fi
                fi

                definitions.add(definition)
            fi
        si

        _parse_statement(context: CONTEXT, statements: Collections.MutableList[Trees.Statements.Statement]) is
            let statement: Trees.Statements.Statement? mut = _

            context.in_top_level_statements = true

            try
                statement = statement_parser.parse(context)
            finally
                context.in_top_level_statements = false
            yrt

            if statement? then
                statements.add(statement)
                _skip_semicolon(context)
            elif !context.is_end_of_file then
                context.next_token()
            fi
        si

        // Speculatively parse a statement at an ambiguous head, collecting it
        // and returning true only if it parses cleanly to a statement boundary.
        // Otherwise the tokens are rewound — tokenizer (the exempt bounded-probe
        // kind, so it does not feed the loop detector) and diagnostics — so the
        // caller can hand them to the definition parser instead. A well-formed
        // call commits with no rewind; only an incomplete definition misrouted
        // here takes the fallback.
        _try_collect_statement(context: CONTEXT, statements: Collections.MutableList[Trees.Statements.Statement]) -> bool is
            let use diagnostics_snapshot = context.diagnostics_speculate_then_backtrack()
            let use snapshot = context.tokenizer_speculate_then_backtrack_bounded()

            let errors_before = context.logger.error_count
            let away_before = context.errors_away_from_end_of_input
            let head_line = context.location.start_line

            let statement: Trees.Statements.Statement? mut = _

            context.in_top_level_statements = true

            try
                statement = statement_parser.parse(context)
            finally
                context.in_top_level_statements = false
            yrt

            if
                statement? /\
                !statement.is_poisoned /\
                context.logger.error_count == errors_before /\
                (
                    context.current.token == Lexical.TOKEN.SEMICOLON \/
                    context.current.token == Lexical.TOKEN.SI \/
                    context.is_end_of_file \/
                    context.at_inferred_terminator
                )
            then
                snapshot.commit()
                diagnostics_snapshot.commit()

                statements.add(statement)
                _skip_semicolon(context)

                return true
            fi

            // A statement that runs out of input, with nothing wrong with it
            // but where it stopped, is a statement not finished yet - a call
            // whose arguments are still being typed. Read as a definition it
            // would fail somewhere inside it instead, describing a mistake
            // that is not there.
            if
                statement? /\
                context.is_end_of_file /\
                context.logger.error_count > errors_before /\
                context.errors_away_from_end_of_input == away_before
            then
                snapshot.commit()
                diagnostics_snapshot.commit()

                statements.add(statement)

                return true
            fi

            // Neither reading parses. Where the statement's error is on the
            // line it began, it describes what was written and the peek has
            // already ruled the definition out; an error further down is a
            // statement that swallowed the lines after an unclosed argument
            // list, which is a definition being typed.
            if context.last_error_line == head_line then
                snapshot.commit()
                diagnostics_snapshot.commit()

                if statement? then
                    statements.add(statement)
                    _skip_semicolon(context)
                elif !context.is_end_of_file then
                    context.next_token()
                fi

                return true
            fi

            return false
        si

        _end_of(definitions: Collections.List[Trees.Definitions.Definition], previous: Source.LOCATION) -> Source.LOCATION =>
            if definitions.count > 0 then definitions[definitions.count - 1].location else previous fi

        _end_of_statement(statements: Collections.List[Trees.Statements.Statement], previous: Source.LOCATION) -> Source.LOCATION =>
            if statements.count > 0 then statements[statements.count - 1].location else previous fi

        // Definition-introducing keywords: everything the definition parser
        // dispatches on that a statement can never begin with. The three
        // tokens a statement *can* also begin with (IDENTIFIER, OPERATOR,
        // SQUARE_OPEN) are deliberately excluded and disambiguated instead.
        _is_definition_head(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.NAMESPACE \/
            token == Lexical.TOKEN.USE \/
            token == Lexical.TOKEN.CLASS \/
            token == Lexical.TOKEN.TRAIT \/
            token == Lexical.TOKEN.STRUCT \/
            token == Lexical.TOKEN.PARTIAL \/
            token == Lexical.TOKEN.IMPL \/
            token == Lexical.TOKEN.UNION \/
            token == Lexical.TOKEN.ENUM \/
            token == Lexical.TOKEN.AT

        // The tokens shared between a global-member definition and a statement.
        _is_ambiguous_head(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.IDENTIFIER \/
            token == Lexical.TOKEN.OPERATOR \/
            token == Lexical.TOKEN.SQUARE_OPEN

        // Tokens that unambiguously begin a statement (the statement parser's
        // dispatch set, minus the ambiguous heads handled above). A token that
        // is neither a definition head, an ambiguous head, nor one of these is
        // stray input handled by the definition parser.
        _is_statement_head(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.PAREN_OPEN \/
            token == Lexical.TOKEN.NEW \/
            token == Lexical.TOKEN.CAST \/
            token == Lexical.TOKEN.ISA \/
            token == Lexical.TOKEN.TYPEOF \/
            token == Lexical.TOKEN.INT_LITERAL \/
            token == Lexical.TOKEN.FLOAT_LITERAL \/
            token == Lexical.TOKEN.STRING_LITERAL \/
            token == Lexical.TOKEN.ENTER_STRING \/
            token == Lexical.TOKEN.CHAR_LITERAL \/
            token == Lexical.TOKEN.TRUE \/
            token == Lexical.TOKEN.FALSE \/
            token == Lexical.TOKEN.NULL \/
            token == Lexical.TOKEN.SELF \/
            token == Lexical.TOKEN.SUPER \/
            token == Lexical.TOKEN.REC \/
            token == Lexical.TOKEN.VAL \/
            token == Lexical.TOKEN.LET \/
            token == Lexical.TOKEN.IF \/
            token == Lexical.TOKEN.CASE \/
            token == Lexical.TOKEN.AWAIT \/
            token == Lexical.TOKEN.ASSERT \/
            token == Lexical.TOKEN.RETURN \/
            token == Lexical.TOKEN.YIELD \/
            token == Lexical.TOKEN.THROW \/
            token == Lexical.TOKEN.WHILE \/
            token == Lexical.TOKEN.FOR \/
            token == Lexical.TOKEN.DO \/
            token == Lexical.TOKEN.TRY \/
            token == Lexical.TOKEN.BREAK \/
            token == Lexical.TOKEN.CONTINUE

        // Decide whether an ambiguous head begins a global definition, by a
        // shallow bounded token peek — never a full parse, so it does not feed
        // the speculation-loop detector (its rewind is the exempt bounded-probe
        // kind). Because parameters are always typed, a definition is
        // recognisable from the first couple of tokens: a `: type` annotation,
        // a `(name: ...` / `[name: ...` typed parameter list, or an empty `()`
        // followed by a signature tail. The peek stops at a call argument's
        // opening token, so a formatted string argument is never read into and
        // never mis-lexed.
        _starts_definition(context: CONTEXT) -> bool is
            use context.tokenizer_speculate_then_backtrack_bounded()

            let head = context.current.token

            context.next_token()

            if head == Lexical.TOKEN.SQUARE_OPEN then
                // [i: int] -> T (indexer) vs [a, b]... (array literal).
                return _is_typed_parameter_head(context)
            fi

            // IDENTIFIER or OPERATOR.
            let after = context.current.token

            // name: type — global variable or typed member. A loop keyword
            // after the colon makes the name a loop label instead, which
            // begins a statement.
            if after == Lexical.TOKEN.COLON then
                context.next_token()

                let labelled = context.current.token

                return
                    labelled != Lexical.TOKEN.FOR /\
                    labelled != Lexical.TOKEN.WHILE /\
                    labelled != Lexical.TOKEN.DO
            fi

            // name[T](...) — generic function definition vs name[i]... (index).
            if after == Lexical.TOKEN.SQUARE_OPEN then
                _skip_balanced(context, Lexical.TOKEN.SQUARE_OPEN, Lexical.TOKEN.SQUARE_CLOSE)

                return _parameter_list_starts_definition(context)
            fi

            // name(...) — function definition vs call statement.
            if after == Lexical.TOKEN.PAREN_OPEN then
                return _parameter_list_starts_definition(context)
            fi

            return false
        si

        // The current token is expected to be `(`. Distinguishes a parameter
        // list (definition) from a call argument list (statement). A parameter
        // is always `name: type`, so a definition is `()` followed by a
        // definition tail, or `(name: …`; every other shape after `(` — a
        // literal or compound-expression argument, or `(name` continued by
        // anything but `:` (`,`, `)`, `.`, `(`, `[`, an operator, …) — is a
        // call argument list, i.e. a statement.
        _parameter_list_starts_definition(context: CONTEXT) -> bool is
            if context.current.token != Lexical.TOKEN.PAREN_OPEN then
                return false
            fi

            // A parameter whose type is missing leaves the list looking
            // like a call's arguments, so what settles it is what follows
            // the list: a body or a return type is a definition written
            // wrongly, and a definition is what it is reported as.
            if _definition_tail_follows(context) then
                return true
            fi

            context.next_token()

            if context.current.token == Lexical.TOKEN.PAREN_CLOSE then
                context.next_token()

                return _begins_definition_tail(context.current.token)
            fi

            if context.current.token != Lexical.TOKEN.IDENTIFIER then
                return false
            fi

            context.next_token()

            return context.current.token == Lexical.TOKEN.COLON
        si

        // Whether a definition tail - a body, a return type, a modifier -
        // follows the parenthesised list. A list whose parameters have no
        // types reads as a call passing bare names, and the tail is what
        // says otherwise.
        //
        // An interpolated string ends the peek: its interior lexes
        // according to where the parser is, so running the tokenizer
        // through one from here leaves the real parse reading it
        // differently. A parameter list never contains one, so reaching
        // one means this is a call.
        _definition_tail_follows(context: CONTEXT) -> bool is
            use context.tokenizer_speculate_then_backtrack_bounded()

            let depth mut = 0

            while !context.is_end_of_file /\ context.current.token != Lexical.TOKEN.SI do
                let token = context.current.token

                if token == Lexical.TOKEN.ENTER_STRING then
                    return false
                fi

                context.next_token()

                if token == Lexical.TOKEN.PAREN_OPEN \/ token == Lexical.TOKEN.SQUARE_OPEN then
                    depth = depth + 1
                elif token == Lexical.TOKEN.PAREN_CLOSE \/ token == Lexical.TOKEN.SQUARE_CLOSE then
                    depth = depth - 1

                    if depth <= 0 then
                        return _begins_definition_tail(context.current.token)
                    fi
                fi
            od

            return false
        si

        // The current token should be the first parameter name, followed by `:`.
        _is_typed_parameter_head(context: CONTEXT) -> bool is
            if context.current.token != Lexical.TOKEN.IDENTIFIER then
                return false
            fi

            context.next_token()

            return context.current.token == Lexical.TOKEN.COLON
        si

        // What can follow the `()` of an empty parameter list in a function
        // definition: the body (`is` / `=>`), a return type (`->`), or a
        // trailing modifier (`static`, `public`, …). A call statement's `()`
        // is followed by a statement continuation (`.`, `;`, an operator, …)
        // instead.
        _begins_definition_tail(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.IS \/
            token == Lexical.TOKEN.ARROW_FAT \/
            token == Lexical.TOKEN.ARROW_THIN \/
            token == Lexical.TOKEN.STATIC \/
            token == Lexical.TOKEN.PUBLIC \/
            token == Lexical.TOKEN.PRIVATE \/
            token == Lexical.TOKEN.PROTECTED \/
            token == Lexical.TOKEN.ABSTRACT \/
            token == Lexical.TOKEN.FIELD

        // Consume a balanced bracket group. On entry the current token is the
        // opening bracket; on return it is the token following the matching
        // close (or end-of-input / SI if unterminated).
        _skip_balanced(context: CONTEXT, open: Lexical.TOKEN, close: Lexical.TOKEN) is
            let depth mut = 0

            while !context.is_end_of_file /\ context.current.token != Lexical.TOKEN.SI do
                let token = context.current.token

                context.next_token()

                if token == open then
                    depth = depth + 1
                elif token == close then
                    depth = depth - 1

                    if depth <= 0 then
                        return
                    fi
                fi
            od
        si

        _skip_semicolon(context: CONTEXT) is
            if context.current.token == Lexical.TOKEN.SEMICOLON then
                let semicolon = context.current
                context.next_token()
                context.note_written_terminator(semicolon)
            else
                // A top-level statement's boundary never reaches
                // accept_terminator - the terminator is consumed here - so
                // the inlay is recorded here too, or a file of top-level
                // statements shows none.
                context.note_inferred_terminator()
            fi
        si
    si
si
