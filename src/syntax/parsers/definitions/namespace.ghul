namespace Syntax.Parsers.Definitions is
    use Source

    class NAMESPACE(
        identifier_qualified_parser: Parser[Trees.Identifiers.Identifier],
        definition_list_parser: Parser[Trees.Definitions.LIST]
    ): Base[Trees.Definitions.NAMESPACE] is
        super()

        parse(context: CONTEXT) -> Trees.Definitions.NAMESPACE? is
            context.next_token(Lexical.TOKEN.NAMESPACE)

            let start = context.location
            let identifier = identifier_qualified_parser.parse(context)

            if !identifier? then
                return null
            fi

            // `namespace N` with no `is` is a whole-file namespace: the
            // rest of the file is its body, top-level statements included.
            // An `is` anywhere after the name - same line or a later one -
            // still opens the block form below. It is legal only where a
            // file can start one, never inside another namespace. A
            // misplaced one is parsed anyway, so the error lands on the
            // declaration rather than on whatever follows it.
            if context.current.token != Lexical.TOKEN.IS then
                if identifier.is_poisoned then
                    return null
                fi

                let misplaced = context.namespace_depth > 0

                if misplaced then
                    context.error(
                        identifier.location,
                        "a whole-file namespace cannot be nested inside another namespace")
                fi

                context.namespace_depth = context.namespace_depth + 1

                let body = definition_list_parser.parse(context)!

                context.namespace_depth = context.namespace_depth - 1

                let result =
                    Trees.Definitions.NAMESPACE(
                        start::context.location,
                        identifier,
                        body,
                        false,
                        !misplaced
                    )

                if identifier.is_poisoned then
                    result.poison()
                fi

                return result
            fi

            if
                (context.current.token == Lexical.TOKEN.IS \/ !identifier.is_poisoned) /\
                context.next_token(Lexical.TOKEN.IS)
            then
                use context.open_construct(Lexical.TOKEN.SI)

                context.namespace_depth = context.namespace_depth + 1
                context.block_namespace_depth = context.block_namespace_depth + 1

                let body = definition_list_parser.parse(context)!

                context.namespace_depth = context.namespace_depth - 1
                context.block_namespace_depth = context.block_namespace_depth - 1

                let result =
                    Trees.Definitions.NAMESPACE(
                        start::context.location,
                        identifier,
                        body,
                        false,
                        false
                    )

                if !identifier.is_poisoned \/ context.current.token == Lexical.TOKEN.SI then
                    context.expect_closer(Lexical.TOKEN.SI)
                fi

                if identifier.is_poisoned then
                    result.poison()
                fi

                return result
            fi
            return null
        si
    si
si
