namespace Syntax.Parsers is
    use IO.Std
    use Ghul.Disposable

    use Logging
    use Source

    use Ghul.Pipes

    // How a statement terminator was satisfied: a written `;`, a boundary
    // inferred from an end of line, or not at all (an error has been
    // reported).
    enum TERMINATOR is
        WRITTEN,
        INFERRED,
        MISSING,
    si

    // Reference type, not a struct: `let use` disposal and the explicit
    // commit()/backtrack()/cancel() calls must act on the same instance, or
    // a speculation can be committed twice (once explicitly, once by the
    // disposer working from a stale copy) — an unbalanced commit underflows
    // the token queue's mark stack and leaves speculation mode stuck on.
    class TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT: Disposable is
        _context: CONTEXT?

        is_speculating: bool => _context?

        init(context: CONTEXT) is
            _context = context
            _context.tokenizer_speculate()
        si

        // _context is cleared before the delegated call, not after: if
        // tokenizer_backtrack/commit throws (a detected speculation loop
        // does throw), the disposer must not run a second time and
        // unbalance the token queue's mark stack.
        backtrack() is
            let context = _context
            _context = null
            context!.tokenizer_backtrack()
        si

        backtrack_if_speculating() is
            if _context? then
                backtrack()
            fi
        si

        commit() is
            let context = _context
            _context = null
            context!.tokenizer_commit()
        si

        commit_if_speculating() is
            if _context? then
                commit()
            fi
        si

        cancel() is
            _context = null
        si

        dispose() is
            commit_if_speculating()
        si
    si

    // Reference type, not a struct — see TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT.
    class TOKEN_LOOKAHEAD_SPECULATE_THEN_BACKTRACK: Disposable is
        _context: CONTEXT?

        // False for a single, provably-bounded probe whose backtrack must not
        // feed the speculation-loop detector (see TOKEN_LOOKAHEAD.backtrack).
        _check_for_loop: bool

        is_speculating: bool => _context?

        init(context: CONTEXT) is
            init(context, true)
        si

        init(context: CONTEXT, check_for_loop: bool) is
            _context = context
            _check_for_loop = check_for_loop
            _context.tokenizer_speculate()
        si

        backtrack() is
            let context = _context
            _context = null
            context!.tokenizer_backtrack(_check_for_loop)
        si

        backtrack_if_speculating() is
            if _context? then
                backtrack()
            fi
        si

        commit() is
            let context = _context
            _context = null
            context!.tokenizer_commit()
        si

        commit_if_speculating() is
            if _context? then
                commit()
            fi
        si

        cancel() is
            _context = null
        si

        dispose() is
            backtrack_if_speculating()
        si
    si

    // Reference type, not a struct — see TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT.
    //
    // Speculate the diagnostics stream and the repeated-error recovery
    // cursor as one unit. The cursor — last_error_location /
    // last_error_message on CONTEXT — drives the recovery in
    // CONTEXT.error(): on an exact-repeat error it drops the duplicate and
    // consumes a token to force progress. A speculative parse that raises
    // an error and is then abandoned has to rewind that cursor along with
    // the diagnostics, or the real parse of the same tokens raises the same
    // error, error() reads it as a repeat, and recovery eats both the
    // diagnostic and a token. Capturing the cursor here makes the rewind
    // automatic: backtrack() (and dispose) restore it, commit() keeps it.
    class DIAGNOSTICS_SPECULATE_THEN_BACKTRACK: Disposable is
        _context: CONTEXT?
        _last_error_location: LOCATION
        _last_error_message: string
        _missing_closer_at: LOCATION?

        is_speculating: bool => _context?

        init(context: CONTEXT) is
            _context = context
            _last_error_location = context.last_error_location
            _last_error_message = context.last_error_message
            _missing_closer_at = context.missing_closer_at
            _context.logger_speculate()
        si

        backtrack() is
            let context = _context
            _context = null
            context!.logger_backtrack()
            context.restore_last_error(_last_error_location, _last_error_message)
            context.missing_closer_at = _missing_closer_at
        si

        backtrack_if_speculating() is
            if _context? then
                backtrack()
            fi
        si

        commit() is
            let context = _context
            _context = null
            context!.logger_commit()
        si

        commit_if_speculating() is
            if _context? then
                commit()
            fi
        si

        cancel() is
            _context = null
        si

        dispose() is
            backtrack_if_speculating()
        si
    si

    // Holds a construct's enders open for the span between the parser
    // consuming its opening keyword and expecting its closing one. Used as
    // `let use`, so they are released however that span is left - the
    // return, or one of the recovery unwinds.
    class OPEN_CONSTRUCT: Disposable is
        _context: CONTEXT?

        init(context: CONTEXT, enders: Collections.LIST[Lexical.TOKEN]) is
            _context = context

            context.push_awaited_enders(enders)
        si

        dispose() is
            let context = _context
            _context = null

            if context? then
                context.pop_awaited_enders()
            fi
        si
    si

    class CONTEXT is
        _repeated_error_count_at_eof: int

        last_error_location: LOCATION
        last_error_message: string

        // Where a construct last failed to find its closing keyword, and
        // nothing if the last one closed cleanly. See expect_closer.
        missing_closer_at: LOCATION? public

        // The tokens that would end the body each parser currently in this
        // parse is reading - a construct's own closing keyword, and the
        // keywords that start its next clause. Each construct parser holds
        // its own open across the span between its opening keyword and its
        // closing one, so this is the recursive descent's own stack made
        // legible rather than a second copy of it kept in step by hand.
        //
        // Error recovery reads it to tell a keyword that some construct
        // still being parsed is waiting for - where a skip has to stop and
        // hand the token up - from one that ends nothing open, which is
        // debris from a construct the parser never entered and can be
        // skipped past.
        //
        // Nothing here counts anything, and deliberately so. Counting how
        // deeply nested the source is counts the very thing the mistake
        // being recovered from has broken: brackets in code that is being
        // edited are not balanced, which is what makes it code that needs
        // recovering. What a parser is waiting for stays true whatever the
        // source does next.
        _awaited_enders: Collections.LIST[Collections.LIST[Lexical.TOKEN]]

        // The indentation of the line each awaiting construct opened on, in
        // step with _awaited_enders. Read only by error recovery, to tell
        // which of two constructs a misplaced closer was written for.
        _awaited_indents: Collections.LIST[int]

        // Where each error reported with the parser at end of input was
        // located. A speculative report that is later rolled back stays here,
        // which is harmless: this lists what could be an early end, and the
        // reports that stand are what a caller checks against it.
        end_of_input_error_locations: Collections.LIST[LOCATION]

        // How many errors have been reported with the parser anywhere but at
        // end of input, rolled-back speculative reports included.
        errors_away_from_end_of_input: int

        // The line the parser last reported on, rolled-back speculative
        // reports included, so a caller weighing two readings of the same
        // tokens can tell a mistake inside what it was reading from one
        // far beyond it.
        last_error_line: int public

        allow_tuple_element: bool public

        // Set by the statement parser for the one expression parse where a
        // named function definition is legal - a statement head whose shape
        // can only be one. The secondary parser clears it as soon as it
        // takes the name, so a literal written anywhere inside that
        // statement, the function body included, is still anonymous.
        allow_nested_function: bool public

        // True while the statement being parsed is one of a file's bare
        // top-level statements, where a named function is a global
        // definition and its argument types are required. A lambda body
        // written inside one is an ordinary body again, and clears it.
        in_top_level_statements: bool public

        in_trait: bool public

        in_global_function: bool public
        in_classy: bool public
        in_member: bool public

        // Depth of enclosing `namespace ... is ... si` blocks. Zero only at
        // the file root, where a file with no namespace may carry bare
        // top-level statements collected into a synthesised entry point.
        // GLOBAL_LIST (reused as the namespace body parser) consults this to
        // confine that handling to depth 0; inside any namespace it behaves
        // exactly as before.
        namespace_depth: int public

        // True only while parsing the `[ ... ]` type-parameter list of a
        // generic type declaration. Distinguishes a type-parameter
        // declaration from a named-tuple-element type (both produce
        // NAMED_TUPLE_ELEMENT via the same parse path) so the `out` /
        // `in` variance modifier is recognised only on a type parameter.
        in_type_parameters: bool public

        // True only while parsing any `[ ... ]` list of type parameters —
        // a type definition's header or a function or method's generic
        // arguments. This is wider than in_type_parameters, which covers
        // only type definitions, and it is what decides whether a second
        // `/\`-joined bound after a bound belongs on a type parameter.
        in_generic_parameter_list: bool public

        // True only at the head of one element of a type-parameter list,
        // and cleared as soon as that element's own name has been read.
        // The `..` argument-pack marker is postfix on the parameter
        // itself, so this keeps it from being taken as a marker on a
        // type named inside the same element - a bound, say.
        at_generic_parameter_head: bool public

        // True only while parsing the formal-argument list of an
        // `init` method. The `..` splice marker is permitted there
        // (it's expanded by the primary-constructor rewrite); anywhere
        // else `..` in a variable-list position is a syntax error.
        in_init_arguments: bool public

        // True only while parsing the primary-ctor parameter list of a
        // class or struct header. The variable parser consults this to
        // decide whether to read a trailing modifier list on each
        // parameter — in other variable-parsing contexts (`let`, formal
        // args, secondary inits) it leaves the modifier slot alone, so
        // a stray `public` / `init` there falls through to the caller's
        // normal "unexpected token" handling. The modifier parser itself
        // matches `init` unconditionally; gating happens only here at
        // the variable-parser layer.
        in_primary_ctor_params: bool public

        // True only while parsing the formal-argument list of a
        // function or method definition. The variable parser consults
        // this to decide whether an `@` before a parameter starts an
        // attribute pragma — elsewhere (`let`, primary-ctor headers,
        // variant field lists) a stray `@` falls through to the
        // caller's normal "unexpected token" handling.
        in_formal_arguments: bool public

        // True only while parsing a function or method definition's
        // declared return type, after the `->`. The argument-pack
        // marker is legal there on the parameter of a function type -
        // `-> T.. -> U` says the function returns an N-ary one - as it
        // is on a formal's own type.
        in_return_type: bool public

        // True only while parsing a pattern that can fail to match —
        // an `if let` / `while let` clause or a `case` `when` arm. The
        // destructure parser consults this to reject the `~` match
        // marker everywhere a leaf can only ever bind: a plain `let`,
        // a formal argument, a lambda parameter. Defaulting to false
        // means a position added later rejects the marker until it
        // says otherwise.
        in_refutable_pattern: bool public

        // intentation is not part of the syntax, but it is used for
        // for error recovery: we may want to skip over a block of code
        // out to a given indentation level
        global_indent: int public
        member_indent: int public

        tokenizer: Lexical.TOKEN_LOOKAHEAD
        logger: Logger

        location: LOCATION => current.location

        is_end_of_file: bool

        current: Lexical.TOKEN_PAIR

        // End of the token before `current` - where an inferred statement
        // terminator belongs, since that is the position the `;` would have
        // been written at. Tracked here rather than taken from the caller's
        // `end`: several callers pass `context.location`, which after a line
        // break is the *next* line's first token, so a hint placed there
        // lands on the following construct.
        //
        // Maintained wherever `current` moves. A backtrack cannot recompute
        // it from the restored token - that token's own location is where
        // `current` is, not where the one before it ended - so it is saved
        // on speculate and restored on backtrack, alongside the token
        // stream it belongs to.
        previous_end: LOCATION

        // previous_end as it stood at each open speculation, innermost last.
        _previous_end_marks: Collections.STACK[LOCATION]

        current_token: Lexical.TOKEN => current.token

        current_string: string? => current.value_string

        current_token_name: string is
            let result mut = Lexical.TOKEN_NAMES[current_token]

            if current_string? /\ current_string !~ result then
                result = "{result} {current_string}"
            fi

            return result
        si

        init(tokenizer: Lexical.TOKEN_LOOKAHEAD, logger: Logger) is
            self.tokenizer = tokenizer
            self.logger = logger

            _previous_end_marks = Collections.STACK[LOCATION]()
            _awaited_enders = Collections.LIST[Collections.LIST[Lexical.TOKEN]]()
            _awaited_indents = Collections.LIST[int]()
            end_of_input_error_locations = Collections.LIST[LOCATION]()

            current = tokenizer.read_token()
            previous_end = current.location

            // next_token() sets this on every read after the first; the
            // first-token read here has to match.
            is_end_of_file = current.token == Lexical.TOKEN.END_OF_INPUT

            last_error_location = self.location
            last_error_message = ""
        si

        tokenizer_speculate_then_commit() -> TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT =>
            TOKEN_LOOKAHEAD_SPECULATE_THEN_COMMIT(self)

        tokenizer_speculate_then_backtrack() -> TOKEN_LOOKAHEAD_SPECULATE_THEN_BACKTRACK =>
            TOKEN_LOOKAHEAD_SPECULATE_THEN_BACKTRACK(self)

        // A single, provably-bounded probe: its backtrack does not feed the
        // speculation-loop detector.
        tokenizer_speculate_then_backtrack_bounded() -> TOKEN_LOOKAHEAD_SPECULATE_THEN_BACKTRACK =>
            TOKEN_LOOKAHEAD_SPECULATE_THEN_BACKTRACK(self, false)

        logger_speculate_then_commit() -> LOGGER_SPECULATE_THEN_COMMIT => logger.speculate_then_commit()

        diagnostics_speculate_then_backtrack() -> DIAGNOSTICS_SPECULATE_THEN_BACKTRACK =>
            DIAGNOSTICS_SPECULATE_THEN_BACKTRACK(self)

        tokenizer_speculate() is
            _previous_end_marks.push(previous_end)

            tokenizer.speculate()
        si

        tokenizer_commit() is
            // The speculated tokens are kept, so the position reached
            // inside them is the position now.
            _pop_previous_end_mark()

            tokenizer.commit()
        si

        tokenizer_backtrack() is
            current = tokenizer.backtrack()
            previous_end = _pop_previous_end_mark() ?? current.location
        si

        tokenizer_backtrack(check_for_loop: bool) is
            current = tokenizer.backtrack(check_for_loop)
            previous_end = _pop_previous_end_mark() ?? current.location
        si

        // Null when the stack is empty, which happens only if a commit or
        // backtrack is reached without its speculate - a caller bug the
        // tokenizer's own mark stack reports; the fallback keeps this from
        // adding a second failure on top of it.
        _pop_previous_end_mark() -> LOCATION? is
            if _previous_end_marks.count == 0 then
                return null
            fi

            return _previous_end_marks.pop()
        si

        logger_speculate() is
            logger.speculate()
        si

        logger_commit() is
            logger.commit()
        si

        logger_backtrack() -> DIAGNOSTICS_STATE => logger.roll_back()

        // Rewind the repeated-error recovery cursor read by error() below.
        // Called by DIAGNOSTICS_SPECULATE_THEN_BACKTRACK when a speculative
        // parse is abandoned; see that class for why the cursor has to move
        // in step with the diagnostics.
        restore_last_error(location: LOCATION, message: string) is
            last_error_location = location
            last_error_message = message
        si
        expect_format_specifier() is
            tokenizer.expect_format_specifier()
        si

        next_token() -> bool is
            previous_end = current.location
            current = tokenizer.read_token()

            is_end_of_file = current.token == Lexical.TOKEN.END_OF_INPUT

            return is_end_of_file
        si

        next_token(token: Lexical.TOKEN, message: string) -> bool is
            if expect_token(token, message) then
                next_token()
                return true
            fi
            return false
        si

        next_token(tokens: Collections.List[Lexical.TOKEN], message: string) -> bool is
            if expect_token(tokens, message) then
                next_token()
                return true
            fi
            return false
        si

        next_token(token: Lexical.TOKEN) -> bool => next_token(token, "syntax error")
        next_token(tokens: Collections.List[Lexical.TOKEN]) -> bool => next_token(tokens, "syntax error")

        // True when the grammar expects a statement terminator here and the
        // line break before the current token can stand in for it: the
        // current token opened a new source line. End of file ends the last
        // line as well as the file, so it stands in too.
        at_inferred_terminator: bool =>
            current.first_on_line \/ is_end_of_file

        // Whether the current token can continue the construct that began
        // at `anchor`, at a point where the grammar could equally end that
        // construct and hand the token to an enclosing one. On the
        // anchor's own line it always can. On a later line it can only
        // when that line is indented at least as far as the anchor's: a
        // token dedented past the construct it would extend closes an
        // enclosing one instead, as the `else` of the `if` around a bare
        // `assert` does.
        continues(anchor: LOCATION) -> bool =>
            !current.first_on_line \/
            current.location.start_column >= tokenizer.indent_of_line(anchor.start_line)

        // Accept a statement terminator: a written `;` is consumed, and
        // where one is missing an end-of-line boundary stands in for it.
        // Callers only reach this at points where the grammar could accept
        // a `;`, which is what keeps the inference parser-driven.
        accept_terminator(message: string) -> TERMINATOR is
            if current_token == Lexical.TOKEN.SEMICOLON then
                let semicolon = current
                next_token()
                note_written_terminator(semicolon)
                return TERMINATOR.WRITTEN
            fi

            if at_inferred_terminator then
                note_inferred_terminator()

                return TERMINATOR.INFERRED
            fi

            expect_token(Lexical.TOKEN.SEMICOLON, message)
            return TERMINATOR.MISSING
        si

        accept_terminator() -> TERMINATOR => accept_terminator("syntax error")

        // Record a statement boundary that no `;` marks, for the terminator
        // inlay. The hint goes after the last token actually consumed: the
        // current token is the next line's first, and the boundary is behind
        // it. Every boundary a written `;` would be reported redundant at
        // gets one, so the two are exact complements - which includes the
        // boundaries the grammar never demanded a terminator at, after a
        // compound statement and at the end of a statement list.
        note_inferred_terminator() is
            if at_inferred_terminator then
                logger.note_inferred_terminator(previous_end)
            fi
        si

        // A written `;` at the end of a source line adds nothing the
        // line break would not infer: nothing reads the terminator for
        // meaning, a body's tail included, which is judged by its type.
        // Report them so the terminator-free style has an enforcing
        // warning; the slug is suppressed by default and enabled with
        // `--warn redundant-semicolon`. Neither does the last one in a
        // file, since end of file ends a line as well as the file.
        //
        // The one exemption is a `;` between two string literals: without
        // it the tokenizer chains the fragments into a single literal, so
        // it separates rather than terminates and removing it changes the
        // program. That the current token opened a new line makes no
        // difference — fragment chaining crosses line breaks.
        note_written_terminator(semicolon: Lexical.TOKEN_PAIR) is
            if !at_inferred_terminator then
                return
            fi

            if
                semicolon.follows_string /\
                (current_token == Lexical.TOKEN.STRING_LITERAL \/
                    current_token == Lexical.TOKEN.ENTER_STRING)
            then
                return
            fi

            logger.warn(semicolon.location, "redundant-semicolon", "';' is redundant here")
        si
        location_and_next() -> LOCATION is
            let result = location
            next_token()
            return result
        si

        skip_token(tokens: Collections.List[Lexical.TOKEN], message: string) is
            let start = location

            do
                if is_end_of_file then
                    error(start::location, "{message}: expected {Lexical.TOKEN_NAMES[current_token]}")
                    return
                elif tokens |> any(t => t == current_token) then
                    error(start::location, "{message}: expected {Lexical.TOKEN_NAMES[current_token]}")
                    next_token()
                    return
                else
                    next_token()
                fi
            od
        si

        skip_token(token: Lexical.TOKEN, message: string) is
            let t = Collections.LIST[Lexical.TOKEN]()
            t.add(token)
            skip_token(t, message)
        si

        expect_token(token: Lexical.TOKEN, message: string) -> bool is
            if current_token != token then
                if current_token != Lexical.TOKEN.CANCEL_STRING then
                    error(location, "{message}: expected {Lexical.TOKEN_NAMES[token]} but found {current_token_name}")
                fi

                return false
            else
                return true
            fi
        si

        expect_token(token: Lexical.TOKEN) -> bool => expect_token(token, "syntax error")
        expect_token(tokens: Collections.List[Lexical.TOKEN], message: string) -> bool is
            if !(tokens |> any(t => t == current_token)) then
                if current_token != Lexical.TOKEN.CANCEL_STRING then
                    error(location, "{message}: expected {Lexical.TOKEN_NAMES[tokens]} but found {current_token_name}")
                fi

                return false
            else
                return true
            fi
        si

        expect_token(tokens: Collections.List[Lexical.TOKEN]) -> bool =>
            expect_token(tokens, "syntax error")

        // The closing keyword of a construct, which is a different thing
        // from any other expected token: every construct that was open when
        // one goes missing wants its own closer at the same token, and each
        // of them reports it. The `while` wanting `od`, the body wanting
        // `si` and the definition list wanting a definition are one mistake
        // described three times, and only the first of them - the innermost,
        // which is the one that knows which closer is actually missing - is
        // worth saying. So the first report at a token marks it, and the
        // constructs unwinding through the same token afterwards stay quiet.
        //
        // The mark is cleared by any closer that is found, so it never
        // reaches a later, unrelated failure; it is keyed on the location
        // as well, so it could not anyway.
        expect_closer(token: Lexical.TOKEN, message: string) -> bool is
            if current_token == token then
                missing_closer_at = null

                next_token()

                return true
            fi

            if current_token == Lexical.TOKEN.CANCEL_STRING then
                return false
            fi

            let at = location

            if !(missing_closer_at? /\ missing_closer_at =~ at) then
                error(at, "{message}: expected {Lexical.TOKEN_NAMES[token]} but found {current_token_name}")
            fi

            if _is_misplaced_closer_for(token) then
                missing_closer_at = null

                next_token()

                return true
            fi

            missing_closer_at = at

            return false
        si

        expect_closer(token: Lexical.TOKEN) -> bool => expect_closer(token, "syntax error")

        // The closing bracket of a call's arguments, a tuple or a list.
        // Where something else is found first, the bracketed text on this
        // line is skipped up to its own closer, so a missing separator inside
        // the brackets is one error rather than leaving the rest of the list
        // to be read as statements. Nothing is skipped when the closer is not
        // on this line.
        expect_bracket_closer(opener: Lexical.TOKEN, closer: Lexical.TOKEN, message: string) -> bool is
            if next_token(closer, message) then
                return true
            fi

            if current.first_on_line then
                return false
            fi

            let use snapshot = tokenizer_speculate_then_backtrack_bounded()

            let depth mut = 1

            while !is_end_of_file /\ !current.first_on_line do
                if current_token == opener then
                    depth = depth + 1
                elif current_token == closer then
                    depth = depth - 1

                    if depth == 0 then
                        next_token()
                        snapshot.commit()

                        return true
                    fi
                fi

                next_token()
            od

            return false
        si

        // Whether the closing keyword found where the innermost construct's
        // own was expected is that construct's closer, mistyped, rather than
        // an enclosing construct's closer arriving early. It is the
        // innermost's when it is not dedented past the innermost's own line
        // and either no enclosing construct is waiting for it, or the
        // nearest one that is waiting opened on a line indented less deeply
        // than the keyword is written: a closer is written level with the
        // construct it closes. Consuming it keeps the statements after
        // it in the body they were written in, where leaving it would end
        // that body and hand them to the member list.
        _is_misplaced_closer_for(expected: Lexical.TOKEN) -> bool is
            let token = current_token

            if !_is_construct_closer(token) then
                return false
            fi

            // A construct that releases its enders before expecting its
            // closer is no longer on the stack, so the innermost frame is
            // its own only while it still awaits the expected closer.
            let top = _awaited_enders.count - 1
            let is_own = top >= 0 /\ _awaited_enders[top] |> any(t => t == expected)

            // Dedented past the line the construct opened on, it closes
            // something further out.
            if is_own /\ current.first_on_line /\ current.location.start_column < _awaited_indents[top] then
                return false
            fi

            let outer mut = if is_own then top - 1 else top fi

            while outer >= 0 do
                if _awaited_enders[outer] |> any(t => t == token) then
                    return current.first_on_line /\ current.location.start_column > _awaited_indents[outer]
                fi

                outer = outer - 1
            od

            return true
        si

        // Whether the current token is a closing or clause keyword that no
        // construct still open can have been written for: the innermost is not
        // waiting for it, and it stands on its own line indented deeper
        // than the line every open construct that would take it opened on.
        // A closer is written level with its construct, so this one is
        // debris - a duplicate, or one left behind by an edit - and a
        // statement list skips it rather than ending there.
        at_debris_closer: bool is
            let token = current_token

            if !(_is_construct_closer(token) \/ is_clause_keyword(token)) \/ !current.first_on_line then
                return false
            fi

            let innermost = _awaited_enders.count - 1

            if innermost < 0 \/ _awaited_enders[innermost] |> any(t => t == token) then
                return false
            fi

            let column = current.location.start_column

            if column <= _awaited_indents[innermost] then
                return false
            fi

            let outer mut = innermost - 1

            while outer >= 0 do
                if column <= _awaited_indents[outer] /\ _awaited_enders[outer] |> any(t => t == token) then
                    return false
                fi

                outer = outer - 1
            od

            return true
        si

        // A keyword that starts the next clause of a construct. Where a
        // program means one, the construct it belongs to is the innermost
        // open one and is waiting for it, so one that nothing open awaits
        // is debris like a stray closer - a pasted duplicate, say.
        is_clause_keyword(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.ELSE \/
            token == Lexical.TOKEN.ELIF \/
            token == Lexical.TOKEN.WHEN \/
            token == Lexical.TOKEN.CATCH \/
            token == Lexical.TOKEN.FINALLY

        _is_construct_closer(token: Lexical.TOKEN) -> bool =>
            token == Lexical.TOKEN.FI \/
            token == Lexical.TOKEN.OD \/
            token == Lexical.TOKEN.ESAC \/
            token == Lexical.TOKEN.YRT \/
            token == Lexical.TOKEN.LAV \/
            token == Lexical.TOKEN.SI

        // Hold `enders` open until the returned value is disposed.
        open_construct(enders: Collections.LIST[Lexical.TOKEN]) -> OPEN_CONSTRUCT =>
            OPEN_CONSTRUCT(self, enders)

        open_construct(ender: Lexical.TOKEN) -> OPEN_CONSTRUCT =>
            OPEN_CONSTRUCT(self, Collections.LIST[Lexical.TOKEN]([ender]))

        push_awaited_enders(enders: Collections.LIST[Lexical.TOKEN]) is
            _awaited_enders.add(enders)
            _awaited_indents.add(tokenizer.indent_of_line(previous_end.start_line))
        si

        pop_awaited_enders() is
            if _awaited_enders.count > 0 then
                _awaited_enders.remove_at(_awaited_enders.count - 1)
                _awaited_indents.remove_at(_awaited_indents.count - 1)
            fi
        si

        // Whether some construct still being parsed would end at this token.
        // True of the innermost as well as any further out, so a skip that
        // stops here hands the token to whichever of them claims it first.
        is_awaited_ender(token: Lexical.TOKEN) -> bool =>
            _awaited_enders |> any(enders => enders |> any(t => t == token))

        // Whether the current token starts a line indented no further than
        // the line the innermost open construct started on: code written
        // level with a construct is not part of it, which lets a skip over
        // a construct that was never closed stop before the next statement.
        is_level_with_open_construct: bool =>
            _awaited_indents.count > 0 /\
            current.first_on_line /\
            current.location.start_column <= _awaited_indents[_awaited_indents.count - 1]

        // Debris: a statement construct's closing or clause keyword sitting
        // where a definition should be, after a construct has already been
        // reported as unclosed. Every keyword left over by that failure
        // arrives here one at a time, and reporting each as a definition
        // that is not one describes the same mistake once per keyword - the
        // shape a reader sees as a file-long cascade.
        //
        // Only debris is skipped: without a missing closer behind it, a
        // stray `fi` is reported as it always was, and the mark is cleared
        // by the next closer that is found, so the silence lasts exactly as
        // long as the unwinding does.
        //
        // `si` closes a namespace as well as a body, so the caller says
        // whether one is debris where it stands.
        at_stray_construct_closer(include_si: bool) -> bool is
            if !missing_closer_at? then
                return false
            fi

            let token = current_token

            if include_si /\ token == Lexical.TOKEN.SI then
                return true
            fi

            token == Lexical.TOKEN.FI \/
            token == Lexical.TOKEN.OD \/
            token == Lexical.TOKEN.ESAC \/
            token == Lexical.TOKEN.YRT \/
            token == Lexical.TOKEN.LAV \/
            token == Lexical.TOKEN.CATCH \/
            token == Lexical.TOKEN.FINALLY \/
            token == Lexical.TOKEN.ELSE \/
            token == Lexical.TOKEN.ELIF \/
            token == Lexical.TOKEN.WHEN \/
            token == Lexical.TOKEN.THEN
        si

        warn(location: LOCATION, message: string) is
            logger.warn(location, message)
        si

        // The repeated-error recovery cursor: true when `location` and
        // `message` are new and should be reported, having updated the
        // cursor to match; false when this is an exact repeat of the
        // last error, having already taken the recovery action (consume
        // a token, or count towards the end-of-file bail-out).
        _should_report_error(location: LOCATION, message: string) -> bool is
            if location !~ last_error_location \/ message !~ last_error_message then
                _repeated_error_count_at_eof = 0

                last_error_location = location
                last_error_message = message

                return true
            elif !is_end_of_file then
                next_token()
            else
                _repeated_error_count_at_eof = _repeated_error_count_at_eof + 1

                if (_repeated_error_count_at_eof > 10) then
                    throw Compiler.PARSE_EXCEPTION("repeated errors at end of file")
                fi
            fi

            return false
        si

        error(location: LOCATION, message: string) is
            if _should_report_error(location, message) then
                logger.error(location, message)
                _note_if_at_end_of_input(location)
            fi
        si

        // Same as error(location, message), plus a related location.
        error(location: LOCATION, message: string, related_location: LOCATION, related_message: string) is
            if _should_report_error(location, message) then
                logger.error(location, message, related_location, related_message)
                _note_if_at_end_of_input(location)
            fi
        si

        // An error reported with the parser at end of input is one more input
        // could have answered: the construct being read was still open, or
        // the value it demanded had not been written yet. Recorded so a
        // caller can tell input that stops early from input that is wrong.
        _note_if_at_end_of_input(location: LOCATION) is
            last_error_line = location.start_line

            if current_token == Lexical.TOKEN.END_OF_INPUT then
                end_of_input_error_locations.add(location)
            else
                errors_away_from_end_of_input = errors_away_from_end_of_input + 1
            fi
        si
    si
si
