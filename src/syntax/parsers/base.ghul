namespace Syntax.Parsers is
    use System.Exception

    trait Parser[T: class] is
        // Null means the parser could not produce a result — parsers
        // return null on unparseable input as part of error recovery,
        // so every caller sees the possibility in the type.
        parse(context: CONTEXT) -> T?
    si

    class Base[T: class]: Parser[T] abstract is
        _expected_tokens: Collections.MutableList[Lexical.TOKEN]?
        parsers: Collections.MAP[Lexical.TOKEN, (CONTEXT) -> T?]

        expected_tokens: Collections.Iterable[Lexical.TOKEN] is
            let result = _expected_tokens ?? _build_expected_tokens()

            _expected_tokens = result

            return result
        si

        description: string? => null

        // What the parser wants at this point, as a phrase, for a parser
        // that accepts too many tokens to list: "an expression". Null where
        // the tokens are few enough to name.
        expectation: string? => null

        // The slug a token this parser cannot start anything with is
        // reported under. A parser that can say more about its own case
        // names it.
        unexpected_code: string => "expected-token-not-found"

        syntax_error_message: string =>
            let d = description in
            if d? then
                "in {d}"
            else
                "syntax error"
            fi

        init() is
            parsers = Collections.MAP[Lexical.TOKEN, (CONTEXT) -> T?]()
        si

        add_parser(p: (CONTEXT) -> T?, token: Lexical.TOKEN) is
            if parsers.contains_key(token) then
                throw Exception("{token} already has a parser")
            fi

            parsers[token] = p
        si

        add_parser(p: (CONTEXT) -> T?, tokens: Collections.Iterable[Lexical.TOKEN]) is
            for t in tokens do
                add_parser(p, t)
            od
        si

        parse(context: CONTEXT) -> T? is
            let token = context.current.token

            return
                if parsers.contains_key(token) then
                    let p = parsers[token]

                    p(context)
                else
                    other_token(context)
                fi
        si

        other_token(context: CONTEXT) -> T? is
            if context.current.token != Lexical.TOKEN.CANCEL_STRING then
                if context.is_construct_closer(context.current.token) then
                    context.error(context.location,
                        "unmatched-block-closer", "{context.current_token_name} does not close anything here"
                    )
                elif let kind: string = expectation then
                    context.error(context.location,
                        unexpected_code, "expected {kind} but found {context.current_token_name}"
                    )
                else
                    context.error(context.location,
                        unexpected_code, "{syntax_error_message}: expected {Lexical.TOKEN_NAMES[expected_tokens]} but found {context.current_token_name}"
                    )
                fi
            fi
            return _
        si

        _build_expected_tokens() -> Collections.MutableList[Lexical.TOKEN] is
            let et = Collections.LIST[Lexical.TOKEN]()

            for k in parsers.keys do
                et.add(k)
            od

            assert et.count > 0 else "should have at least one expected token"

            return et
        si
    si
si
