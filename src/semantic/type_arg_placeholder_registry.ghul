namespace Semantic is
    use Source.LOCATION

    use Types.Type

    // Registry of phantom Variables that stand in for unbound
    // owner-generic type-args at constructor expressions.
    //
    // Each constructor AST node gets one phantom INFERRED_TYPE_ARG_
    // ORIGIN per type-arg slot. The phantom carries a `_lub_map`
    // accumulator that overload match propagation pushes downstream-discovered
    // concrete types onto, and a `_constraints` SET that records
    // operation-level requirements (member access, call shape) from
    // sites that consume the placeholder. The body-retry loop's next
    // iteration resolves the type-arg by calling
    // `try_get_inferred_type()` on the phantom.
    //
    // The registry is owned by the COMPILE_EXPRESSIONS visitor (one
    // registry per visitor instance, lifetime = the body retry loop)
    // rather than living on the AST nodes themselves. The visitor
    // instance is the body retry loop's lifecycle, so origins
    // persist across iterations — constraint accumulation needs that
    // stability.
    //
    // `clear()` is called at apply() boundaries; without it stale
    // entries from a previous compile of the same file would
    // reference Type instances from a symbol table that's since been
    // wiped by clear_symbols.
    class TYPE_ARG_PLACEHOLDER_REGISTRY(_symbol_table: SYMBOL_TABLE) is
        // Two-level cache: cache_key (an AST node, identity-compared)
        // -> container (the Classy / Function the phantoms stand in
        // for, identity-compared) -> phantom origin list. The container
        // level matters when the same AST node drives two distinct
        // retries in one pass — `visit_binary` retries the free-function
        // group and the member group from the same BINARY node, and
        // without the container split the second retry would receive
        // the first's phantoms (wrong container, possibly wrong
        // arity).
        _origins: Collections.MAP[Syntax.Trees.Node, Collections.MAP[Symbols.Symbol, Collections.LIST[Symbols.Variable]]]

        // Constructions already reported by report_unresolved,
        // so later sweeps of the same registry don't repeat the
        // error.
        _reported: Collections.SET[Syntax.Trees.Node]

        // The body whose walk created each construction's phantoms. A
        // sweep at the end of one body reports only its own: another
        // body's phantoms were settled, or reported, by that body's walk.
        _origin_bodies: Collections.MAP[Syntax.Trees.Node, int]
        _body: int

        // The walk each construction's phantoms were last asked for in, and
        // a count of walks across every body. A construction the final walk
        // of its body resolved without its phantoms, and that resolved, is
        // not reported: its phantoms belong to an earlier, superseded
        // resolution.
        _last_walks: Collections.MAP[Syntax.Trees.Node, int]
        _walk: int

        super()

        init(..) is
            _origins = Collections.MAP[Syntax.Trees.Node, Collections.MAP[Symbols.Symbol, Collections.LIST[Symbols.Variable]]]()
            _reported = Collections.SET[Syntax.Trees.Node]()
            _origin_bodies = Collections.MAP[Syntax.Trees.Node, int]()
            _last_walks = Collections.MAP[Syntax.Trees.Node, int]()
        si

        clear() is
            _origins.clear()
            _reported.clear()
            _origin_bodies.clear()
            _last_walks.clear()
        si

        // Starts a function body's retry loop: phantoms created from here
        // until the next call belong to it.
        begin_body() is
            _body = _body + 1
        si

        // Starts a walk of the current body, and returns the number that
        // walk carries, for `report_unresolved` to compare against.
        begin_walk() -> int is
            _walk = _walk + 1

            return _walk
        si

        // Returns the phantom origin list for `cache_key`. On cache
        // miss creates one phantom Variable per slot in
        // `type_symbol.argument_names`, owned by the current function.
        // The phantom's name encodes type / arg / location for
        // debuggability — `${ClassName}.{arg_name}@{line}:{col}`.
        get_or_create(
            cache_key: Syntax.Trees.Node,
            location: LOCATION,
            type_symbol: Symbols.Classy
        ) -> Collections.LIST[Symbols.Variable] is
            return _get_or_create(cache_key, location, type_symbol, type_symbol.argument_names)
        si

        // Same as the Classy overload, but anchors phantoms against
        // a Function's own generic_argument_names — for free-function
        // call sites whose own type-args need binding from sibling
        // actuals.
        get_or_create_for_function(
            cache_key: Syntax.Trees.Node,
            location: LOCATION,
            function: Symbols.Function?
        ) -> Collections.LIST[Symbols.Variable] is
            if !function? then
                return Collections.LIST[Symbols.Variable]()
            fi

            return _get_or_create(cache_key, location, function, function.generic_argument_names)
        si

        // Whether the container's type parameter at `index` was declared
        // `[T..]`.
        _slot_is_argument_pack(container: Symbols.Symbol, index: int) -> bool is
            if let function: Symbols.Function = container then
                if index < function.generic_arguments.count then
                    return function.generic_arguments[index].symbol.is_argument_pack
                fi
            elif let classy: Symbols.Classy = container then
                if let parameter: Symbols.GenericArgument = classy.type_parameter_at(index) then
                    return parameter.is_argument_pack
                fi
            fi

            return false
        si

        _get_or_create(
            cache_key: Syntax.Trees.Node,
            location: LOCATION,
            container: Symbols.Symbol,
            argument_names: Collections.List[string]
        ) -> Collections.LIST[Symbols.Variable] is
            let inner: Collections.MAP[Symbols.Symbol, Collections.LIST[Symbols.Variable]] mut

            _last_walks[cache_key] = _walk

            if _origins.contains_key(cache_key) then
                inner = _origins[cache_key]

                if inner.contains_key(container) then
                    return inner[container]
                fi
            else
                inner = Collections.MAP[Symbols.Symbol, Collections.LIST[Symbols.Variable]]()
                _origins[cache_key] = inner
                _origin_bodies[cache_key] = _body
            fi

            let result = Collections.LIST[Symbols.Variable]()
            let owner = cast Scope(_symbol_table.current_function!)

            for i in 0..argument_names.count do
                let arg_name = argument_names[i]
                let phantom_name = "${container.name}.{arg_name}@{location.start_line}:{location.start_column}"
                let phantom = Symbols.INFERRED_TYPE_ARG_ORIGIN(location, owner, phantom_name)
                phantom.is_argument_pack = _slot_is_argument_pack(container, i)
                result.add(phantom)

                INFERENCE_TRACE.mint(container, arg_name, phantom, location, _symbol_table.current_function)
            od

            inner[container] = result

            return result
        si

        // Produce a specialised owner where each type-arg slot
        // carries either the phantom's currently-resolved type (if
        // body-retry has accumulated enough constraints to pin it)
        // or an INFERRED_VARIABLE_TYPE pointing at the phantom.
        //
        // Returns the original function unchanged when:
        //   - cache_key is null (caller hasn't given us an AST node
        //     to anchor the phantoms against)
        //   - the candidate already has a specialised owner
        //   - the owner isn't generic
        //   - GENERIC.try_create_from or find_specialized_function
        //     rejects the result
        specialize_with_placeholders(
            location: LOCATION,
            function: Symbols.Function,
            cache_key: Syntax.Trees.Node?
        ) -> Symbols.Function is
            if !cache_key? then
                return function
            fi

            if isa Symbols.GENERIC(function.owner) then
                return function
            fi

            let owner_classy = cast Symbols.Classy?(function.owner)

            if !owner_classy? \/ !owner_classy.is_generic then
                return function
            fi

            let origins = get_or_create(cache_key, location, owner_classy)

            let type_map = Collections.MAP[Symbols.Symbol, Type]()

            for i in 0..owner_classy.argument_names.count do
                let parameter
                    = cast Symbols.GenericArgument?(owner_classy.type_parameter_at(i))
                let origin = origins[i]
                let resolved = origin.try_get_inferred_type()
                let arg_type: Type mut

                if resolved? /\ !resolved.is_sentinel then
                    arg_type = resolved
                else
                    arg_type = Types.INFERRED_VARIABLE_TYPE(origin)
                fi

                if parameter? then
                    type_map[parameter] = arg_type
                fi
            od

            let specialized_owner = Symbols.GENERIC.try_create_from(location, owner_classy, type_map)

            if !specialized_owner? then
                return function
            fi

            let specialized = specialized_owner.find_specialized_function(function)

            if !specialized? then
                return function
            fi

            return specialized
        si

        // Walk all phantom origins; a construction whose owner
        // type-args were never pinned by any usage (e.g.
        // `let m = Box(); Std.write_line("hi")`) has no type to
        // settle to, so report it at the construction site. One
        // error per construction, however many slots are open.
        //
        // Reported constructions are remembered: the visitor calls
        // this after every function body's retry loop, the registry
        // spans the whole walk, and a phantom that was unresolved at
        // the end of its own function's walk stays unresolved - a
        // repeat report from a later function's sweep would be
        // noise.
        //
        // Only a construction the body's final walk asked for, or one that
        // ended in an error, is reported. Another construction resolved on
        // the final walk without its phantoms, which belong to an earlier,
        // superseded resolution. A failed construction's phantoms are what
        // it could not settle, whichever walk last asked for them.
        report_unresolved(logger: Logging.Logger, final_walk: int) is
            for kv in _origins do
                if _reported.contains(kv.key) then
                    continue
                fi

                let body mut = 0

                if !_origin_bodies.try_get_value(kv.key, body ref) \/ body != _body then
                    continue
                fi

                let last_walk mut = 0

                if (!_last_walks.try_get_value(kv.key, last_walk ref) \/ last_walk < final_walk) /\ !_has_failed(kv.key) then
                    continue
                fi

                for inner_kv in kv.value do
                    for origin in inner_kv.value do
                        let resolved = origin.try_get_inferred_type()

                        if !resolved? \/ !resolved.is_settled then
                            _reported.add(kv.key)
                            logger.error(origin.location, "cannot infer type here")
                            break
                        fi
                    od

                    if _reported.contains(kv.key) then
                        break
                    fi
                od
            od
        si

        // Whether the construction or call ended in an error.
        _has_failed(node: Syntax.Trees.Node) -> bool is
            if let expression: Syntax.Trees.Expressions.Expression = node, value = expression.value, type = value.type then
                return type.is_error
            fi

            return false
        si
    si
si
