namespace Semantic is
    use Types.Type

    // Decides whether a named-delegate formal that a plain
    // assignability check rejects is worth pushing as a constraint
    // and re-walking the argument under - a bare function reference,
    // or a lambda literal that resolved to its own native shape
    // before the delegate slot was known. `Func`/`Action` slots never
    // reach here: `DELEGATE_SHAPE.is_named_delegate` answers false
    // for them, so they keep going through the ordinary function-type
    // assignability path.
    class DELEGATE_PUSH_CANDIDATES(
        _delegate_shape: DELEGATE_SHAPE,
        _innate_symbol_lookup: Lookups.InnateSymbolLookup
    ) is
        super()

        init(..) is
        si

        // `formal` is a named delegate `actual` isn't already
        // assignable to, but which `actual` could satisfy once its
        // own call shape is pushed against the delegate's invoke
        // shape and re-walked.
        is_push_candidate(formal: Type, actual: Type) -> bool is
            if !_delegate_shape.is_named_delegate(formal, _innate_symbol_lookup) \/ formal.is_assignable_from(actual) then
                return false
            fi

            if !actual.is_function then
                return false
            fi

            let shape = _delegate_shape.try_get_function_type(formal, _innate_symbol_lookup)

            return shape? /\ shape.is_assignable_from(actual)
        si

        // True when pushing `candidate`'s own formal types onto the
        // current actuals stands a chance of resolving a named-
        // delegate mismatch that a plain assignability check missed
        // on the first walk.
        has_push_mismatch(candidate: Symbols.Function, argument_types: Collections.LIST[Type]) -> bool is
            for i in 0..argument_types.count do
                if is_push_candidate(candidate.arguments[i], argument_types[i]) then
                    return true
                fi
            od

            return false
        si

        // Same shape as a plain single-arity-candidate search, for
        // when that search finds nothing because more than one
        // arity-matching overload exists (`T[].sort` has both
        // `Sort(Comparison[T])` and `Sort(IComparer[T])`). A named
        // delegate formal narrows the field: an overload whose
        // mismatched argument isn't even delegate-pushable is
        // rejected outright, so genuine ambiguity between two
        // delegate-shaped formals both able to accept the actual
        // still falls through to null - only a group that resolves to
        // exactly one push-worthy overload is picked here.
        find_single_pushable_candidate(
            group: Symbols.FUNCTION_GROUP,
            argument_types: Collections.LIST[Type],
            want_instance: bool
        ) -> Symbols.Function? is
            let result: Symbols.Function? mut = null
            let count mut = 0

            for f in group.functions do
                if !want_instance /\ f.is_instance then
                    continue
                fi

                if !f.are_arguments_declared then
                    continue
                fi

                if f.arguments.count != argument_types.count then
                    continue
                fi

                let compatible mut = true
                let any_pushed mut = false

                for i in 0..argument_types.count do
                    let formal = f.arguments[i]
                    let actual = argument_types[i]

                    if formal.is_assignable_from(actual) then
                        continue
                    fi

                    if is_push_candidate(formal, actual) then
                        any_pushed = true
                        continue
                    fi

                    compatible = false
                od

                if compatible /\ any_pushed then
                    result = f
                    count = count + 1
                fi
            od

            if count == 1 then
                return result
            fi

            return null
        si
    si
si
