namespace Semantic is
    use IR.Values.Value
    use Ghul.Disposable

    use Types.Type

    // Resolves an index whose argument is a `System.Range`, `Ghul.INT_RANGE`
    // or `Ghul.INT_RANGE_INCLUSIVE` to a slice of the source:
    // `Ghul.Pipes.slice(source, range)`.
    //
    // The slice cannot be supplied as a member of the types that want it.
    // `E[]` is the interface every list-shaped receiver
    // satisfies, and a member added there does not reach the types that
    // implement it: a reflected type arrives from .NET with its inherited
    // members already pulled down, so nothing propagates a later addition.
    // Supplying it per receiver instead reaches an array and a string,
    // which are the receiver types themselves, and then owes the same work
    // to the next collection and to every user type. Resolving it as an
    // ordinary call lets the receiver's own type select the overload.
    class RANGE_SLICE_RESOLVER(
        _innate_symbol_lookup: Lookups.InnateSymbolLookup,
        _overload_resolver: OVERLOAD_RESOLVER,
        _function_caller: FUNCTION_CALLER,
        _logger: Logging.Logger
    ) is
        // The `slice` overload serving this index, or null when there is
        // none: the argument is not a range, or nothing in scope takes one
        // over this source. A caller reports its own diagnostic then.
        try_resolve(
            location: Source.LOCATION,
            source: Value,
            index_type: Type
        ) -> OVERLOAD_RESOLVE_RESULT? is
            if !is_range(index_type) then
                return null
            fi

            let functions = _innate_symbol_lookup.get_slice_functions()

            if !functions? then
                return null
            fi

            let source_type = source.type

            if !source_type? then
                return null
            fi

            let types = Collections.LIST[Type]([source_type, index_type])

            let use logger_snapshot = _logger.speculate_then_backtrack()

            let resolved = _overload_resolver.resolve(location, functions, types, false, false, false)

            logger_snapshot.backtrack()

            return resolved
        si

        is_range(index_type: Type) -> bool =>
            index_type.compare(_innate_symbol_lookup.get_range_type()) == Types.MATCH.SAME \/
            index_type.compare(_innate_symbol_lookup.get_int_range_type()) == Types.MATCH.SAME \/
            index_type.compare(_innate_symbol_lookup.get_int_range_inclusive_type()) == Types.MATCH.SAME

        // The call itself, once the caller has recorded the use it wants
        // recorded against the resolved function.
        call(
            location: Source.LOCATION,
            resolved: OVERLOAD_RESOLVE_RESULT,
            source: Value,
            range: Value
        ) -> Value =>
            resolved.function.call(
                location,
                null,
                Collections.LIST[Value]([source, range]),
                null,
                _function_caller)
    si
si
