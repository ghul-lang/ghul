namespace Semantic.Types is
    // The pure counterpart of a function/action type: same delegate
    // symbol and arguments as the impure shape, since PURE_FUNCTION /
    // PURE_ACTION only mark that values of the type are trusted
    // store-free — this changes nothing about generated IL.
    class PURE_FUNCTION_SHAPE is
        // Returns the pure shape, or null when `type` isn't a plain
        // (not-already-pure) function type.
        pure_shape_of(type: Type, innate_symbol_lookup: Lookups.InnateSymbolLookup) -> Type? static is
            if type.is_function /\ isa GENERIC(type) /\ !type.is_pure_function then
                let types = Collections.LIST[Type]()

                for a in (cast GENERIC(type)).arguments do
                    types.add(a)
                od

                if type.is_action then
                    types.add(innate_symbol_lookup.get_void_type())
                fi

                return innate_symbol_lookup.get_function_type(types, true)
            fi

            return null
        si

        // `type` with every function type in it, at any depth, written at
        // its impure shape: the same type as far as identity, assignability
        // and overload resolution go, since purity takes no part in those.
        // A function literal's purity is only settled once its callees'
        // effects are, after expressions are compiled, so a type shown
        // before then shows it this way rather than state what isn't known
        // yet. An optional function type is left as it is.
        impure_shape_of(type: Type, innate_symbol_lookup: Lookups.InnateSymbolLookup) -> Type static is
            if !type.is_function \/ type.is_optional \/ !isa GENERIC(type) then
                return type
            fi

            let changed mut = type.is_pure_function
            let types = Collections.LIST[Type]()

            for a in (cast GENERIC(type)).arguments do
                let shown = impure_shape_of(a, innate_symbol_lookup)

                if shown != a then
                    changed = true
                fi

                types.add(shown)
            od

            if !changed then
                return type
            fi

            if type.is_action then
                types.add(innate_symbol_lookup.get_void_type())
            fi

            return innate_symbol_lookup.get_function_type(types, false)
        si
    si
si
