namespace Semantic.Types is
    // Whether a type holds the type of a bare `null` somewhere inside it, as
    // a tuple built with a `null` element does when nothing says what that
    // element holds. Such a type has no runtime representation, so it cannot
    // be the type of a variable or a type argument.
    class NULL_ELEMENT is
        within(type: Type) -> bool static is
            if let generic: GENERIC = type then
                for argument in generic.arguments do
                    if isa NULL(argument) \/ within(argument) then
                        return true
                    fi
                od
            fi

            return false
        si

        // Whether an actual argument of type `actual` can be passed to a formal
        // of type `formal`, as far as a bare `null` inside it is concerned. A
        // tuple formal gives each element its own type; any other formal leaves
        // the `null` element with none, and the tuple with no runtime
        // representation to pass.
        fits(formal: Type, actual: Type) -> bool static is
            if !within(actual) then
                return true
            fi

            let unwrapped = formal.optional_inner_type ?? formal

            // A type parameter is bound element by element where the actual
            // is a tuple, and binding refuses a `null` element itself.
            if unwrapped.is_type_variable \/ unwrapped.is_function_generic_argument \/ unwrapped.is_classy_generic_argument then
                return true
            fi

            return unwrapped.is_value_tuple \/ isa TUPLE(unwrapped)
        si
    si
si
