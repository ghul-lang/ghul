namespace Semantic.Types is

    use Source.LOCATION

    class ENUM: GENERIC is
        init(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Type[]
        ) is
            super.init(location, symbol, arguments)
        si

        create(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Type[]
        ) -> GENERIC =>
            Types.ENUM(location, symbol, arguments)

        to_string() -> string =>
            arguments[0].to_string() ?? ""
    si

si
