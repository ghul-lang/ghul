namespace Semantic.Types is

    use Source.LOCATION

    // `Ghul.MAYBE[T]` — the runtime's unconstrained-T optional
    // carrier. is_maybe drives the implicit conversion to `T?` at
    // slot boundaries; surfacing it as a distinct GENERIC subclass
    // means recognition is a virtual-property check (no per-call
    // symbol lookup, and source-side MAYBE structs inside
    // `ghul-runtime`'s own compile stay as plain GENERIC where the
    // conversion is correctly inactive).
    class MAYBE: GENERIC is
        is_maybe: bool => true

        is_optional: bool => true

        optional_inner_type: Type? => arguments[0]

        short_description: string => get_short_description(self)

        get_short_description(reference: GENERIC) -> string static => "{reference.arguments[0].short_description}?"

        init(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Type[]
        ) is
            super.init(location, symbol, arguments)
        si

        create(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Type[]
        ) -> GENERIC =>
            Types.MAYBE(location, symbol, arguments)

        // MAYBE[T] accepts a value of T via the implicit T -> T? widening,
        // the same rule NULLABLE uses: the boxer emits a MAYBE<T>::.ctor
        // wrap at the slot boundary. Reported as ASSIGNABLE, not SAME, so
        // an overload resolver with both f(T) and f(T?) candidates and a T
        // argument still prefers f(T). Shares NULLABLE's helper — both are
        // value-type optional carriers with a single-argument present-value
        // constructor.
        compare(other: Type) -> Types.MATCH is
            let direct = Types.NULLABLE.compare_optional(self, other, super.compare(other))

            if cast int(direct) <= cast int(Types.MATCH.ASSIGNABLE) then
                return direct
            fi

            // Any other `T?` lowering flowing into a MAYBE[T] slot: a
            // reference type carrying the optional flag, or a
            // NULLABLE[T]. The three lowerings are intercompatible by
            // design, so the slot accepts all of them and VALUE_BOXER
            // emits the coercion. ASSIGNABLE rather than SAME, so an
            // exact-typed candidate still wins overload resolution.
            if arguments.count == 1 /\ !other.is_null /\ !other.is_error /\ other.is_optional then
                let other_inner = other.optional_inner_type

                if other_inner? /\ arguments[0].is_assignable_from(other_inner) then
                    return Types.MATCH.ASSIGNABLE
                fi
            fi

            return direct
        si

        // A MAYBE[T] formal binds T against whatever the actual's own
        // optional carrier holds — so `f[T](value: T?)` infers T from a
        // `string?`, an `int?`, a MAYBE[T'] or a bare non-optional
        // actual alike. Without this the base walks the actual's
        // ancestors looking for a MAYBE instantiation and finds none.
        bind_type_variables(other: Type, results: Types.GENERIC_ARGUMENT_BIND_RESULTS) -> bool is
            // `MAYBE[T]` written out by name is a plain GENERIC over the
            // same symbol: the same carrier, so it pairs argument by argument.
            if other.is_null \/ other.is_error \/ other.is_maybe \/ arguments.count != 1 \/ is_construction_of_same_symbol_as(other) then
                return super.bind_type_variables(other, results)
            fi

            let other_inner = other.optional_inner_type

            if other_inner? then
                return arguments[0].bind_type_variables(other_inner, results)
            fi

            return arguments[0].bind_type_variables(other, results)
        si

        to_string() -> string => "{arguments[0]}?"
    si
si
