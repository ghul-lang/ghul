namespace Semantic.Types is
    use Source.LOCATION

    use Ghul.Pipes

    class FUNCTION: GENERIC is
        is_function: bool => true

        short_description: string => with_optionality(self, get_short_description(self))

        // An optional function type keeps its parentheses around the
        // shape, so `(() -> int)?` reads as one optional function.
        with_optionality(function: Type, text: string) -> string static =>
            if function.is_optional then "({text})?" else text fi

        get_short_description(function: GENERIC) -> string static is
            let result = System.Text.StringBuilder()

            let args = function.arguments

            if args.count == 2 then
                result
                    .append(FUNCTION.lone_parameter_description(args[0]))
                    .append(" -> ")
                    .append(FUNCTION.return_description(args[1]))
            elif args.count == 1 then
                result
                    .append("() -> ")
                    .append(FUNCTION.return_description(args[0]))
            else
                result.append('(')

                (0..args.count-1) |> map(i => args[i]) |> append_to(result)

                result
                    .append(") -> ")
                    .append(FUNCTION.return_description(args[args.count-1]))
            fi

            return result.to_string()
        si

        // A returned pure function keeps its parentheses, so the purity
        // that belongs to it is not read as the outer function's:
        // `int -> ((int) -> int pure)` rather than `int -> int -> int pure`.
        return_description(result: Type) -> string static =>
            if result.is_pure_function then "({result})" else "{result}" fi

        // A lone parameter that is itself a tuple, a list or a function
        // keeps its own parentheses, so that `((int, int)) -> int` is not
        // written as the two-parameter `(int, int) -> int`, `(int[]) -> int`
        // as a function returning `int[]`, nor `(int -> int) -> int` as a
        // curried `int -> int -> int`.
        lone_parameter_description(parameter: Type) -> string static =>
            if isa TUPLE(parameter) \/ LIST_SPELLING.applies_to_type(parameter) \/ parameter.is_value_tuple \/ parameter.is_function then
                "({parameter})"
            else
                "{parameter}"
            fi

        init(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Collections.List[Type]
        ) is
            super.init(location, symbol, arguments)
        si

        get_argument_type_variance(index: int) -> TypeVariance =>
            if index == arguments.count - 1 then
                TypeVariance.COVARIANT
            else
                TypeVariance.CONTRAVARIANT
            fi

        create(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Collections.List[Type]
        ) -> GENERIC =>
            FUNCTION(location, symbol, arguments)

        to_string() -> string => with_optionality(self, get_short_description(self))
    si
si
