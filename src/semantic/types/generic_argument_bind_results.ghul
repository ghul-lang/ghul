namespace Semantic.Types is
    use IO.Std

    use Collections.MutableList
    use Collections.LIST
    use Collections.MAP

    use Logging

    use Ghul.Pipes

    class GENERIC_ARGUMENT_BINDING is
        type_argument: GenericArgument
        actual_type: Type public

        init(
            type_argument: GenericArgument,
            actual_type: Type
        ) is
            self.type_argument = type_argument
            self.actual_type = actual_type
        si

        to_string() -> string =>
            "{type_argument} bound to {actual_type}"
    si

    // `unbound` is filled in by check_complete, which every reader of
    // it runs first.
    @suppress("field-definite-assignment")
    class GENERIC_ARGUMENT_BIND_RESULTS is
        is_bound: bool

        // True iff at least one bind() call resolved a sibling conflict via
        // LUB widening rather than ordinary pairwise widening. Callers can
        // use this to know whether a post-bind structural conformance check
        // is warranted (it isn't otherwise — pairwise widening is monotonic).
        used_lub: bool public

        bindings: MAP[Symbols.Symbol,GENERIC_ARGUMENT_BINDING]

        // The scope the bind is resolved from, which decides whose type
        // parameters stand for real types. Null reads the symbol table's
        // current scope.
        site: Scope? public

        // Type-argument names whose only actual was a bare null literal,
        // which binds nothing. Used to default such a variable to object if
        // no other argument pins it (see default_null_only_unbound).
        _null_only_names: Collections.SET[Symbols.Symbol]

        // Per type argument, the placeholders an argument paired with it
        // while it already had a binding, so that a later widening of the
        // binding reaches them too.
        _paired: MAP[Symbols.Symbol,LIST[INFERRED_VARIABLE_TYPE]]

        unbound: MutableList[Type]

        // The type arguments this bind is allowed to pin, or null for
        // no restriction. A formal can mention type variables that
        // belong to neither the function being bound nor its owner -
        // most often the *caller's* own, arriving through a receiver
        // like `BOX[T]` where `T` is the enclosing generic function's.
        // Those are fixed where the call is written, so binding one
        // from an actual would substitute a caller's type variable out
        // of the candidate's formals and hand the call site a formal
        // it never declared.
        _bindable: Collections.List[Type]?

        map: MAP[Symbols.Symbol,Type] is
            let result = MAP()

            for binding in bindings do
                result.add(binding.key, binding.value.actual_type)
            od

            return result
        si

        // True when any bound actual still names a method-level type
        // parameter that does not belong to `owner`. Such a value is
        // not safe to emit as a call-site type argument: its `!!N`
        // index is only meaningful inside the function that declared
        // it.
        contains_function_generic_argument_foreign_to(owner: Scope?) -> bool is
            for binding in bindings do
                if binding.value.actual_type.has_function_generic_argument_foreign_to(owner) then
                    return true
                fi
            od

            return false
        si

        init() is
            init(null)
        si

        init(bindable: Collections.List[Type]?) is
            bindings = MAP[Symbols.Symbol,GENERIC_ARGUMENT_BINDING]()
            _null_only_names = Collections.SET[Symbols.Symbol]()
            _paired = MAP[Symbols.Symbol,LIST[INFERRED_VARIABLE_TYPE]]()
            _bindable = bindable
        si

        _is_bindable(type_argument: GenericArgument) -> bool is
            if !_bindable? then
                return true
            fi

            for b in _bindable do
                if b.symbol == type_argument.symbol then
                    return true
                fi
            od

            return false
        si

        // `newer` named with every element name either tuple gives: a
        // name from one side is kept when the other leaves the element
        // unnamed, and the same name from both is kept once. Null when
        // the two give one element different names.
        _with_both_names(existing: Type, newer: Type) -> Type? is
            let names = LIST[string?]()
            let any_name mut = false

            for index in 0..newer.arguments.count do
                let from_existing = _element_name(existing, index)
                let from_newer = _element_name(newer, index)

                if from_existing? /\ from_newer? /\ from_existing !~ from_newer then
                    return null
                fi

                let name = from_newer ?? from_existing

                if name? then
                    any_name = true
                fi

                names.add(name)
            od

            if !any_name then
                return newer
            fi

            return newer.apply_tuple_element_names(names)
        si

        // The name a tuple gives its element at `index`, or null where it
        // gives none. A positional name such as `0` is not a name.
        _element_name(tuple: Type, index: int) -> string? =>
            if
                let names = tuple.tuple_element_names /\
                index < names.count /\
                !Symbols.Symbol.is_positional_member_name(names[index])
            then
                names[index]
            fi

        bind(type_argument: GenericArgument, actual_type: Type mut) -> bool is
            if !_is_bindable(type_argument) then
                return true
            fi

            let existing: GENERIC_ARGUMENT_BINDING mut

            if bindings.try_get_value(type_argument.symbol, existing ref) then
                if !existing.actual_type.is_none then
                    // Tuple assignability ignores element names, so two
                    // tuples of the same shape are each assignable from
                    // the other whatever they are called. Neither simply
                    // replaces the other: the binding keeps every name
                    // either side gives, and two different names for the
                    // same element mean the types differ.
                    if
                        existing.actual_type.is_value_tuple /\
                        actual_type.is_value_tuple /\
                        actual_type.is_assignable_from(existing.actual_type) /\
                        existing.actual_type.is_assignable_from(actual_type)
                    then
                        if let named = _with_both_names(existing.actual_type, actual_type) then
                            existing.actual_type = named

                            return true
                        fi

                        existing.actual_type = NONE.instance

                        return false
                    fi

                    if actual_type.is_assignable_from(existing.actual_type) then
                        if !actual_type.is_null /\ !actual_type.is_sentinel then
                            existing.actual_type = actual_type
                        else
                            _pair_placeholder(type_argument.symbol, actual_type)
                        fi

                        return true
                    elif existing.actual_type.is_assignable_from(actual_type) then
                        return true
                    else
                        // Neither candidate is assignable from the other —
                        // they're siblings (or otherwise unrelated). Fall
                        // back to the least upper bound across both, so
                        // generic-argument inference for calls like
                        // `merge[T](a: T, b: T)` with sibling argument types
                        // succeeds with T = their common ancestor instead
                        // of failing the overload match entirely.
                        let lub = Semantic.LEAST_UPPER_BOUND_MAP()
                        lub.add(existing.actual_type)
                        lub.add(actual_type)

                        let common = lub.get_result()

                        if common? then
                            existing.actual_type = common
                            used_lub = true

                            return true
                        fi

                        existing.actual_type = NONE.instance
                        return false
                    fi
                else
                    // already know can't be bound
                    return false
                fi
            elif actual_type.is_null \/ actual_type.is_sentinel then
                // Special-case an INFERRED_VARIABLE_TYPE actual that
                // body-retry match propagation has already pinned: bind to the
                // resolved type rather than skipping. Without this an
                // outer overload resolve like
                // `run(int, int -> STEP[<phantom>])` leaves `T` unbound
                // even when the inner YIELD's match propagation pinned the
                // phantom to int — the resolver then can't tell that
                // `run[T = int, S = int]` cleanly satisfies the call.
                //
                // Only applies when this is a NEW binding (the
                // existing-binding branch above already handles
                // is_sentinel-actual vs concrete-existing the right way:
                // skip the overwrite, keep the concrete existing).
                if isa INFERRED_VARIABLE_TYPE(actual_type) then
                    let placeholder = actual_type
                    let resolved = placeholder.origin.try_get_inferred_type()

                    if resolved? /\ resolved.is_settled then
                        bindings.add(type_argument.symbol, GENERIC_ARGUMENT_BINDING(type_argument, resolved))
                        return true
                    fi

                    _pair_placeholder(type_argument.symbol, placeholder)
                fi

                // A genuine null literal carries no type information, so
                // record it as a candidate for object-defaulting if nothing
                // else pins the variable. The test is `isa NULL`, not
                // is_null: error and inference-sentinel types also answer
                // is_null true, and defaulting those to object would pre-empt
                // the constraint-push retry that is meant to resolve them.
                if isa NULL(actual_type) then
                    _null_only_names.add(type_argument.symbol)
                fi

                return true
            elif NULL_ELEMENT.within(actual_type) then
                // A type argument is emitted in the call's signature, and a
                // type holding a bare `null` has no runtime representation.
                return false
            else
                bindings.add(type_argument.symbol, GENERIC_ARGUMENT_BINDING(type_argument, actual_type))
                return true
            fi

            assert false else "should not be reachable"
        si

        // When a sibling-bound type-arg pairs a concrete (or
        // type-variable) `existing` against an INFERRED_VARIABLE_TYPE
        // placeholder actual, push the concrete back to the
        // placeholder's origin. Without this, a construction like
        // `CONS(x, NIL())` resolves CONS's T from x but leaves NIL's
        // own owner type-arg placeholder unpinned, and the
        // never-pinned slot is reported as cannot infer type here
        // even though the sibling argument carried the answer.
        //
        // Skipped when existing isn't carrying real information
        // (itself a placeholder / inferred / error). Pushing those
        // would just propagate uncertainty.
        _propagate_existing_into_placeholder(existing_type: Type?, actual_type: Type) is
            if !isa INFERRED_VARIABLE_TYPE(actual_type) then
                return
            fi

            if !existing_type? \/ existing_type.is_inferred \/ existing_type.is_error then
                return
            fi

            // A type parameter of the function being resolved - the `T`
            // of a `filter[T]` whose source is still settling - is no
            // type the placeholder could take; only a type parameter the
            // site is written inside stands for one.
            let site_scope = site ?? IoC.CONTAINER.instance.symbol_table.current_scope

            if existing_type.has_function_generic_argument_foreign_to(site_scope) then
                return
            fi

            let placeholder = cast INFERRED_VARIABLE_TYPE(actual_type)

            // A local variable takes its type from its initializer and its
            // assignments; a call it is passed to only checks that type.
            // A parameter or a type argument, which has no assignments of
            // its own, takes the type of what it is used with.
            let origin = placeholder.origin

            if (origin.is_local /\ !origin.is_argument) \/ isa Symbols.TOP_LEVEL_VARIABLE(origin) then
                return
            fi

            Semantic.INFERENCE_TRACE.add_lower_bound("bind.existing_into_placeholder", placeholder.origin, existing_type)
        si

        _pair_placeholder(symbol: Symbols.Symbol, actual_type: Type) is
            if let placeholder: INFERRED_VARIABLE_TYPE = actual_type then
                let paired: LIST[INFERRED_VARIABLE_TYPE] mut

                if !_paired.try_get_value(symbol, paired ref) then
                    paired = LIST[INFERRED_VARIABLE_TYPE]()
                    _paired.add(symbol, paired)
                fi

                paired.add(placeholder)
            fi
        si

        // Offers each placeholder argument the type its type argument was
        // bound to. Called for the candidate the caller finally selects,
        // and for no other: a placeholder then takes the final binding
        // whichever order the arguments came in, and a candidate that
        // bound cleanly and then lost - on score, or on a tie-break -
        // records nothing, since a lower bound is never withdrawn.
        offer_bindings_to_placeholders() is
            for kv in _paired do
                let binding: GENERIC_ARGUMENT_BINDING mut

                if bindings.try_get_value(kv.key, binding ref) /\ !binding.actual_type.is_none then
                    for placeholder in kv.value do
                        _propagate_existing_into_placeholder(binding.actual_type, placeholder)
                    od
                fi
            od
        si

        check_complete(location: Source.LOCATION, expected_arguments: Collections.List[Type]?) -> bool is
            is_bound = true

            unbound = LIST[Type]()

            for binding in bindings do
                if binding.value.actual_type.is_none then
                    IoC.CONTAINER.instance.logger.info(location, "conflicting types inferred for {binding.value.type_argument}")
                    is_bound = false
                fi
            od

            if !is_bound then
                is_bound = false
                return false
            fi

            // Defensive: callers should pass a non-null list of the
            // type-args the bind was supposed to satisfy. A null
            // means the caller had nothing to check (e.g. a non-
            // generic function calling check_complete with its own
            // null generic_arguments). Treat that as "nothing to
            // verify" rather than NREing — bindings still happened,
            // they just have no expected list to confirm against.
            if !expected_arguments? then
                return is_bound
            fi

            for expected_argument in expected_arguments do
                let argument_is_bound mut = false

                for bound_argument in bindings.values do
                    if bound_argument.type_argument.symbol == expected_argument.symbol then
                        argument_is_bound = true
                        break
                    else
                        unbound.add(expected_argument)
                    fi
                od

                if !argument_is_bound then
                    is_bound = false
                    return false
                fi
            od

            return is_bound
        si

        // Bind any expected type argument whose only actual was a bare
        // null literal — and so was never pinned — to default_type (object).
        // A null argument against a `T?` parameter carries no information
        // about T, but the call is still well-formed with T at its widest;
        // defaulting here keeps the selected overload fully specialized.
        // Type arguments a concrete actual could still pin, or that were
        // bound to conflicting types, are left untouched.
        default_null_only_unbound(expected_arguments: Collections.List[Type], default_type: Type) is
            for expected_argument in expected_arguments do
                if let type_argument = cast GenericArgument?(expected_argument) then
                    if
                        _null_only_names.contains(type_argument.symbol) /\
                        !bindings.contains_key(type_argument.symbol)
                    then
                        bindings.add(
                            type_argument.symbol,
                            GENERIC_ARGUMENT_BINDING(type_argument, default_type)
                        )
                    fi
                fi
            od
        si

        to_string() -> string is
            let result = System.Text.StringBuilder()

            let seen_any mut = false

            for binding in bindings.values do
                if seen_any then
                    result.append(",")
                fi

                result
                    .append(binding.type_argument)
                    .append("=>")
                    .append(binding.actual_type)

                seen_any = true
            od

            return result.to_string()
        si
    si
si
