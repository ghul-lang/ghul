namespace Semantic.Types is
    use Source.LOCATION

    class ACTION_0: NAMED is
        is_function: bool => true
        is_action: bool => true

        init(
            symbol: Symbols.Classy
        ) is
            super.init(symbol)
        si

        create(
            location: LOCATION,
            symbol: Symbols.Classy
        ) -> ACTION_0 =>
            ACTION_0(symbol)

        short_description: string => to_string()

        to_string() -> string => FUNCTION.with_optionality(self, "() -> void")
    si
si
