namespace Semantic is
    use Types.Type

    // Where a function literal's inferred return settles when its body
    // produced a value type and its slot returns a reference type, or the
    // value-type optional of what the body produced.
    //
    // A delegate assignment cannot carry the conversion: reaching the
    // slot's type that way needs return covariance, and a value-type
    // instantiation is invariant however the delegate is declared, which
    // nothing checks at run time. So the conversion is made inside the
    // literal, and the literal's return is the body's own implementation
    // of what the slot returns - the slot's type once the arguments it
    // left open follow from the body.
    class VALUE_RETURN_PIN is
        // The type to settle at, or null to leave the body's own type
        // alone. Null whenever the question does not arise: no slot, a
        // slot that is neither a reference type nor a value-type
        // optional, a body that is not a value type, or a body that does
        // not implement what the slot returns.
        of(slot: Type?, produced: Type?) -> Type? static is
            if !slot? \/ !produced? then
                return null
            fi

            if !applies_to_slot(slot) then
                return null
            fi

            if !produced.is_value_type \/ !produced.is_settled then
                return null
            fi

            if slot.is_value_type then
                if
                    let inner = slot.optional_inner_type /\
                    !produced.is_optional /\
                    inner.is_equivalent_to(produced)
                then
                    return slot
                fi

                return null
            fi

            return produced.find_ancestor(slot)
        si

        // Whether a slot's return type is one a value-typed body has to be
        // converted to rather than assigned through. Its own type
        // arguments need not have settled: what decides this is the shape,
        // and a slot is a reference type or is not whatever they turn out
        // to be.
        applies_to_slot(slot: Type?) -> bool static =>
            slot?                                                        /\
            !slot.is_void                                                /\
            (!slot.is_value_type \/ (slot.is_optional /\ !slot.is_maybe)) /\
            !slot.is_type_variable
    si
si
