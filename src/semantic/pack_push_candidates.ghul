namespace Semantic is
    // Chooses which overload's formals to push onto the arguments of a
    // call whose first resolve failed, when more than one overload takes
    // the call's number of arguments and so none is the lone candidate.
    // Whether an overload's argument-pack adaptation applies to the call
    // depends on the argument expressions, so the caller answers that.
    class PACK_PUSH_CANDIDATES is
        init() is si

        // The one overload `adapts` accepts, or null where none or
        // several do: a pack adaptation open to two overloads gives no
        // reason to push either's formals, so the retry is not made.
        find_single(
            group: Symbols.FUNCTION_GROUP,
            want_instance: bool,
            adapts: Symbols.Function -> bool
        ) -> Symbols.Function? is
            let result: Symbols.Function? mut = null
            let count mut = 0

            for f in group.functions do
                if !want_instance /\ f.is_instance then
                    continue
                fi

                if !f.are_arguments_declared then
                    continue
                fi

                if adapts(f) then
                    result = f
                    count = count + 1
                fi
            od

            if count == 1 then
                return result
            fi

            return null
        si
    si
si
