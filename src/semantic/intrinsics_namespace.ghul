namespace Semantic is
    use Source.LOCATION

    // Materialises `Ghul.Intrinsics` before any pass runs, so the
    // ambient `use` every namespace block carries resolves against a
    // namespace that already exists rather than one something else has
    // to create in time. On .NET the assembly import adds the magic
    // types and the intrinsic operators to what is here; under a target
    // that loads no assemblies, the built-in types are declared into it
    // directly. Runs again after `clear_symbols`, which drops the
    // namespace symbols with everything else.
    class INTRINSICS_NAMESPACE is
        materialise(symbol_table: SYMBOL_TABLE, namespaces: NAMESPACES) static is
            let global =
                cast Symbols.NAMESPACE?(symbol_table.global_scope)

            if !global? then
                return
            fi

            let ghul = namespaces.find_or_add_namespace("Ghul", ".Ghul", false)

            if global.find_direct("Ghul") == null then
                global.declare_namespace(LOCATION.internal, "Ghul", ghul, null)
            fi

            let intrinsics = namespaces.find_or_add_namespace("Intrinsics", ".Ghul.Intrinsics", false)

            if ghul.find_direct("Intrinsics") == null then
                ghul.declare_namespace(LOCATION.internal, "Intrinsics", intrinsics, null)
            fi

            intrinsics.mark_implicitly_imported()
        si
    si
si
