namespace Semantic is
    use Symbols.Symbol
    use Ghul.Disposable

    // Decides the scope that symbol names render relative to. By default
    // that is the scope currently being compiled (read on demand from the
    // symbol table, so it stays correct however the scope stack is
    // unwound), which is why a diagnostic reads relative to where it is
    // reported. An override replaces that default for the duration of a
    // language-service render (targeting the cursor's scope) or a region
    // that needs scope-independent output (`with_scope(null)` forces fully
    // qualified names, e.g. for a canonical ordering). Separately, a set of
    // symbols can be marked to render fully qualified whatever the scope,
    // so that a diagnostic never names two distinct types identically.
    class NAME_DISPLAY is
        _override_scope: Scope?
        _has_override: bool
        _qualified: Symbol[]

        init() is
            _qualified = Collections.LIST[Symbol](0)
        si

        render_scope: Scope? =>
            if _has_override then
                _override_scope
            else
                _current_build_scope
            fi

        _current_build_scope: Scope? is
            let symbol_table = IoC.CONTAINER.instance.symbol_table

            return symbol_table.current_scope
        si

        name_for(symbol: Symbol) -> string =>
            symbol.render_name(_scope_for(symbol))

        // The scope-relative name without its type-argument suffix — for
        // rendering a constructed generic's head, which then appends its own
        // actual arguments.
        bare_name_for(symbol: Symbol) -> string =>
            symbol._render_scope_relative_name(_scope_for(symbol))

        // The bare declared name, except for a symbol marked to render
        // fully qualified.
        short_name_for(symbol: Symbol) -> string =>
            if _qualified.count > 0 /\ _is_qualified(symbol.unspecialized_symbol) then
                symbol.unspecialized_symbol._render_scope_relative_name(null)
            else
                symbol.name
            fi

        _is_qualified(symbol: Symbol) -> bool is
            for q in _qualified do
                if q == symbol then
                    return true
                fi
            od

            return false
        si

        _scope_for(symbol: Symbol) -> Scope? =>
            if _qualified.count > 0 /\ _is_qualified(symbol) then
                null
            else
                render_scope
            fi

        // Across `left` and `right`, render every distinct declaration that
        // shares its name with another fully qualified until the returned
        // holder is disposed. Consume with `let use`.
        qualifying_alike(left: Types.Type?, right: Types.Type?) -> QUALIFIED_SYMBOLS_HOLDER is
            let alike = ALIKE_NAMED_SYMBOLS()

            alike.add(left)
            alike.add(right)

            return qualifying(alike)
        si

        qualifying(alike: ALIKE_NAMED_SYMBOLS) -> QUALIFIED_SYMBOLS_HOLDER is
            let holder = QUALIFIED_SYMBOLS_HOLDER(self, _qualified)

            if alike.symbols.count > 0 then
                let combined = Collections.LIST[Symbol](_qualified)

                combined.add_range(alike.symbols)

                _qualified = combined
            fi

            return holder
        si

        restore_qualified(qualified: Symbol[]) is
            _qualified = qualified
        si

        // Render relative to `scope` (null forces fully qualified) until the
        // returned holder is disposed. Consume with `let use` so the
        // previous render scope is restored on every exit path, including
        // when rendering throws.
        with_scope(scope: Scope?) -> RENDER_SCOPE_HOLDER is
            let holder = RENDER_SCOPE_HOLDER(self, _override_scope, _has_override)

            _override_scope = scope
            _has_override = true

            return holder
        si

        restore_override(scope: Scope?, has_override: bool) is
            _override_scope = scope
            _has_override = has_override
        si
    si

    struct RENDER_SCOPE_HOLDER: Disposable is
        _display: NAME_DISPLAY?
        _previous_scope: Scope?
        _previous_has_override: bool

        init(display: NAME_DISPLAY, previous_scope: Scope?, previous_has_override: bool) is
            _display = display
            _previous_scope = previous_scope
            _previous_has_override = previous_has_override
        si

        dispose() is
            // A value-type disposable must be safe on its default value:
            // `let use` disposal null-checks reference types before calling
            // dispose but not value types, so an early return past the
            // `let use` hands dispose a zero-initialized holder. A null
            // display means the holder was never constructed and so set no
            // override to restore.
            let display = _display

            if display? then
                display.restore_override(_previous_scope, _previous_has_override)
            fi
        si
    si

    struct QUALIFIED_SYMBOLS_HOLDER: Disposable is
        _display: NAME_DISPLAY?
        _previous: Symbol[]?

        init(display: NAME_DISPLAY, previous: Symbol[]) is
            _display = display
            _previous = previous
        si

        dispose() is
            let display = _display
            let previous = _previous

            if display? /\ previous? then
                display.restore_qualified(previous)
            fi
        si
    si
si
