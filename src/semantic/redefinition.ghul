namespace Semantic is
    // Reports a declaration that redefines a name already declared in the
    // same scope. The error at the new declaration is always reported; its
    // counterpart at the existing declaration only when that declaration is
    // on this side of an assembly boundary, since code in another library or
    // in the core library is not the code that needs changing.
    class REDEFINITION is
        report(location: Source.LOCATION, existing: Source.LOCATION, name: string, as_what: string) static is
            let logger = IoC.CONTAINER.instance.logger

            logger.error(location, "symbol-redefined", "redefining symbol '{name}'{as_what}", existing, "symbol declared here")

            if !IoC.CONTAINER.instance.build_flags.is_across_assembly_boundary(existing, location) then
                logger.error(existing, "symbol-redefined", "symbol '{name}' is redefined{as_what}", location, "redefined here")
            fi
        si
    si
si
