namespace Semantic is
    use Ghul.Pipes
    use Source.LOCATION

    use Types.Type

    use IR.Values

    // Converts a global function, static/instance/struct method, or
    // the single member of an overloaded group into a function/
    // delegate value directly - `ldftn` on the method plus whatever
    // receiver an instance method needs, no closure frame, since a
    // named function has nothing to capture.
    class FUNCTION_REFERENCE_RESOLVER(
        _logger: Logging.Logger,
        _symbol_table: SYMBOL_TABLE,
        _symbol_loader: SYMBOL_LOADER,
        _innate_symbol_lookup: Lookups.InnateSymbolLookup,
        _overload_resolver: OVERLOAD_RESOLVER,
        _pack_wrap_builder: Syntax.Process.PACK_WRAP_BUILDER
    ) is
        _delegate_shape: DELEGATE_SHAPE
        _owner_constraint_specializer: OWNER_CONSTRAINT_SPECIALIZER

        super()

        init(..) is
            _delegate_shape = DELEGATE_SHAPE()
            _owner_constraint_specializer = OWNER_CONSTRAINT_SPECIALIZER()
        si

        // Returns null when `symbol` isn't a function reference in
        // value position, or is an overloaded group with no target
        // shape available yet to pick a member by - the caller then
        // falls back to its ordinary `symbol.load` path.
        try_load(
            location: LOCATION,
            symbol: Symbols.Symbol,
            from: Value?,
            expected_type: Type?,
            is_call_target: bool
        ) -> Value? is
            if is_call_target \/ isa Symbols.Closure(symbol) then
                return null
            fi

            // A type is its constructor where a function is expected.
            if symbol.is_type then
                if let type = symbol.type then
                    return try_load_constructor(location, type, expected_type, false)
                fi

                return null
            fi

            let single: Symbols.Function? mut = cast Symbols.Function?(symbol)

            if !single? then
                let group = cast Symbols.FUNCTION_GROUP?(symbol)

                if !group? \/ group.count == 0 then
                    return null
                fi

                if group.count == 1 then
                    single = group.functions[0]
                else
                    let target_shape = get_target_call_shape(expected_type)

                    if !target_shape? then
                        return null
                    fi

                    single = _resolve_group_member(location, group, from, target_shape)

                    if !single? then
                        return DUMMY(Types.ERROR(), location)
                    fi
                fi
            fi

            // An open generic can't be checked against a target shape
            // until it's instantiated: bind its own type arguments
            // from the shape the slot expects, the same way a call
            // site binds them from its actual arguments.
            if single.is_generic then
                let target_shape = get_target_call_shape(expected_type)

                let specialized =
                    if target_shape? then
                        _try_specialize_from_target_shape(location, single, target_shape)
                    else
                        single
                    fi

                // Nothing here pins the function's own type arguments:
                // there is no slot at all, or the slot is one the
                // enclosing call has still to infer. Building the value
                // at the function's own shape would put its free type
                // variables into the argument types that resolution
                // binds from, and a variable the sibling actuals pin
                // concretely then joins with one of those to `object`.
                // Leave the reference unresolved instead - the state a
                // bare overloaded group is left in - so the caller's
                // deferred re-walk pushes the settled formal and
                // instantiates against that. With no such re-walk to
                // come, the load reports itself as unusable.
                if specialized == single /\ symbol.is_function_group /\ _slot_pins_nothing(target_shape) then
                    return null
                fi

                single = specialized
            fi

            // An innate operator is an IL instruction sequence with no
            // method behind it for a delegate to point at, so its value
            // is a thunk that applies the operator to its parameters.
            if single.is_innate then
                return _build_innate_value(location, single, expected_type)
            fi

            return _build_value(location, single, from, expected_type)
        si

        // A type named in value position where a function is expected is
        // its constructor as a function value: a thunk that constructs the
        // type from its parameters, since a constructor has no method a
        // delegate could point at. The expected function type's parameter
        // types pick the constructor as the arguments of a call would, and
        // its return slot, where it is settled, contributes the type
        // arguments the parameters leave open, as the slot a call is
        // assigned to does.
        //
        // Null where `type` is in call position, or where no settled
        // parameter shape is available to pick a constructor by: the
        // reference then stays a type expression, and the call that pushes
        // a settled formal re-walks it.
        try_load_constructor(
            location: LOCATION,
            type: Type,
            expected_type: Type?,
            is_call_target: bool
        ) -> Value? is
            if is_call_target then
                return null
            fi

            let shape = get_target_call_shape(expected_type)

            if !shape? then
                return null
            fi

            let shape_arguments = shape.arguments
            let parameter_count = ARGUMENT_PACK.parameter_count(shape)

            let parameter_types mut = Collections.LIST[Type](parameter_count)

            for i in 0..parameter_count do
                parameter_types.add(shape_arguments[i])
            od

            // A type parameter of the function the reference sits in is
            // the thunk's own to carry, as a literal's would be; one
            // belonging to the call still being resolved, or a slot still
            // being inferred, leaves nothing fixed to pick a constructor by.
            if parameter_types |> any(p => !_is_fixed(p)) then
                return null
            fi

            // The slot's return type pins type arguments only where it is
            // fixed itself; one still open - a type variable of the call
            // being resolved - is left to bind from the constructed type.
            let return_constraint =
                if !shape.is_action /\ _is_fixed(shape_arguments[parameter_count]) then
                    shape_arguments[parameter_count]
                else
                    null
                fi

            let named = cast Types.NAMED?(type)

            if !named? \/ type.is_value_tuple \/ isa Types.TUPLE(type) \/ type.is_type_variable then
                if !type.is_error then
                    _logger.error(location, "cannot construct {type}")
                fi

                return DUMMY(Types.ERROR(), location)
            fi

            if let abstract_class: Symbols.CLASS = named.symbol /\ abstract_class.is_abstract then
                _logger.error(location, "cannot instantiate abstract class {abstract_class.name}", abstract_class.location, "class declared abstract here")

                return DUMMY(Types.ERROR(), location)
            fi

            let group = cast Symbols.FUNCTION_GROUP?(named.scope.find_direct("init"))

            if !group? \/ group.count == 0 then
                _logger.error(location, "no constructor found init({parameter_types |> join(", ")})")

                return DUMMY(Types.ERROR(), location)
            fi

            // A slot taking one tuple is filled by a constructor of the
            // tuple's elements where none takes the tuple itself: the call
            // presents the value in the slot's shape, as it does a named
            // function of the elements.
            let spread = ARGUMENT_PACK.spread_shape(shape)

            let result mut = cast OVERLOAD_RESOLVE_RESULT?(null)

            if spread? then
                _logger.speculate()

                result = _overload_resolver.resolve(location, group, parameter_types, false, true, true, null, return_constraint)

                if result? then
                    _logger.commit()
                else
                    _logger.roll_back()

                    let spread_count = ARGUMENT_PACK.parameter_count(spread)

                    parameter_types = Collections.LIST[Type](spread_count)

                    for i in 0..spread_count do
                        parameter_types.add(spread.arguments[i])
                    od

                    result = _overload_resolver.resolve(location, group, parameter_types, false, true, true, null, return_constraint)
                fi
            else
                result = _overload_resolver.resolve(location, group, parameter_types, false, true, true, null, return_constraint)
            fi

            if !result? then
                return DUMMY(Types.ERROR(), location)
            fi

            let constructor = _owner_constraint_specializer.specialize_from_constraint(location, result.function, return_constraint)

            let constructed_type mut = type
            let type_symbol: Symbols.Symbol mut = named.symbol

            if isa Symbols.GENERIC(constructor.owner) then
                type_symbol = cast Symbols.Symbol(constructor.owner)
                constructed_type = constructor.owner.type!
            fi

            let is_directly_owned =
                if isa Symbols.GENERIC(type_symbol) /\ isa Symbols.Symbol(constructor.owner) then
                    type_symbol =~ cast Symbols.Symbol(constructor.owner)
                else
                    type_symbol == constructor.owner
                fi

            if !is_directly_owned then
                _logger.error(location, "cannot call superclass constructor {constructor}", constructor.location, "constructor declared here")

                return DUMMY(Types.ERROR(), location)
            fi

            // A generic type whose arguments neither the parameters nor the
            // return slot pin has no one instance to construct: it is still
            // the declaration's own type, not a specialization of it.
            let unbound =
                if let classy: Symbols.Classy = type_symbol then
                    classy.is_generic /\ !isa Types.GENERIC(constructed_type)
                else
                    false
                fi

            if unbound \/ !_is_fixed(constructed_type) then
                let name = type_symbol.root_unspecialized_symbol.name

                _logger.error(
                    location,
                    "cannot tell the type arguments of {name} here",
                    location,
                    "help: write them, {name}[...], or expect a function type that fixes them")

                return DUMMY(Types.ERROR(), location)
            fi

            if let constructed: Types.GENERIC = constructed_type, generic_symbol: Symbols.GENERIC = constructed.symbol then
                generic_symbol.symbol.check_argument_constraints(location, _logger, constructed.arguments)
            fi

            if constructor.is_scalar_conversion then
                let caster = IoC.CONTAINER.instance.type_caster

                if !caster.check_cast_is_valid(location, parameter_types[0], constructed_type) then
                    return DUMMY(Types.ERROR(), location)
                fi
            fi

            // The thunk is built at the shape's parameters and the
            // constructed type, and the ordinary assignability check at
            // the use site accepts or rejects that against the slot, as
            // it does for a named function.
            let callee_types = Collections.LIST[Type](parameter_types.count + 1)

            callee_types.add_range(parameter_types)
            callee_types.add(constructed_type)

            let callee_type = _innate_symbol_lookup.get_function_type(callee_types)

            let delegate_type =
                if expected_type!.is_function \/ !shape.is_assignable_from(callee_type) then
                    null
                else
                    expected_type
                fi

            let value = _pack_wrap_builder.construct(location, constructor, constructed_type, callee_type, delegate_type)

            if !value? then
                _logger.error(location, "cannot take the value of constructor {type} here")

                return DUMMY(Types.ERROR(), location)
            fi

            return value
        si

        // Whether `type` names one type here: settled, with no inference
        // placeholder, and no type variable but those of the enclosing
        // function and classes, which a thunk declared here carries.
        _is_fixed(type: Type) -> bool =>
            type.is_settled /\
            !type.is_none /\
            !type.is_error /\
            !type.contains_inferred /\
            !type.has_function_generic_argument_foreign_to(_symbol_table.current_function) /\
            !_has_classy_generic_argument_foreign_to_here(type)

        // Whether `type` mentions a type parameter of a class other than
        // one enclosing the reference: a generic type whose arguments
        // nothing has bound names no one type to construct.
        _has_classy_generic_argument_foreign_to_here(type: Type) -> bool is
            let scope = _symbol_table.current_function

            for a in type.get_type_arguments() do
                if !a.is_classy_generic_argument then
                    continue
                fi

                if !scope? then
                    return true
                fi

                let found = scope.find_enclosing(a.symbol.name)

                if !found? \/ found != a.symbol then
                    return true
                fi
            od

            return false
        si

        // The thunk standing in for an innate operator, presented at the
        // slot's type where the slot has one and takes the operator, and
        // at the operator's own type otherwise.
        _build_innate_value(location: LOCATION, operator: Symbols.Function, expected_type: Type?) -> Value is
            let shape = _check_shape(location, operator, expected_type)

            if !shape? then
                return DUMMY(Types.ERROR(), location)
            fi

            // A type parameter of the function the reference sits in is
            // the thunk's own to carry, as a literal's would be; one
            // belonging to the call still being resolved, or a slot still
            // being inferred, leaves nothing fixed to stand in for.
            if
                !shape.is_settled \/
                shape.contains_inferred \/
                shape.has_function_generic_argument_foreign_to(_symbol_table.current_function)
            then
                _logger.error(
                    location,
                    "cannot take the value of built-in operator '{operator.name}' here",
                    location,
                    "help: the operator's type is not fixed; write a function literal instead")

                return DUMMY(Types.ERROR(), location)
            fi

            let callee_type = get_target_call_shape(shape) ?? shape
            let delegate_type = if callee_type == shape then null else shape fi

            let value = _pack_wrap_builder.forward(location, operator, callee_type, delegate_type)

            if !value? then
                _logger.error(location, "cannot take the value of built-in operator '{operator.name}' here")

                return DUMMY(Types.ERROR(), location)
            fi

            return value
        si

        // A slot that cannot instantiate an open generic function:
        // absent, still carrying an inference placeholder, or written
        // in type variables belonging to the call being resolved
        // rather than to the function this reference sits in.
        _slot_pins_nothing(target_shape: Type?) -> bool =>
            !target_shape? \/
            target_shape.contains_inferred \/
            target_shape.has_function_generic_argument_foreign_to(_symbol_table.current_function)

        // The function-type shape a value must present to be usable
        // as `expected_type`: `expected_type` itself when it's already
        // a ghūl function type, or the call shape of its `invoke` when
        // it's a named .NET delegate. Null when `expected_type` is
        // absent, or present but not callable at all.
        get_target_call_shape(expected_type: Type?) -> Type? is
            if !expected_type? then
                return null
            fi

            if expected_type.is_function then
                return expected_type
            fi

            return _delegate_shape.try_get_function_type(expected_type, _innate_symbol_lookup)
        si

        // Instantiates an open generic function against a target
        // shape. The shape's parameter types and its return slot both
        // contribute to the function's own type arguments, so a
        // variable split between the two positions still binds.
        // Returns the function unchanged when the shape pins nothing,
        // pins it incompletely, or contradicts it - the ordinary
        // assignability check at the use site then accepts or rejects
        // the uninstantiated form.
        _try_specialize_from_target_shape(
            location: LOCATION,
            function: Symbols.Function,
            target_shape: Type
        ) -> Symbols.Function is
            let shape_arguments = target_shape.arguments
            let parameter_count = ARGUMENT_PACK.parameter_count(target_shape)

            if function.arguments.count != parameter_count then
                return function
            fi

            let parameter_types = Collections.LIST[Type](parameter_count)

            for i in 0..parameter_count do
                parameter_types.add(shape_arguments[i])
            od

            let results = Types.GENERIC_ARGUMENT_BIND_RESULTS(function.generic_arguments)

            // Parameter-driven binding can pin something only when a
            // formal mentions a type variable, and an unsettled slot
            // carries no information to bind with - leave the attempt
            // out in either case rather than binding a type argument
            // to a placeholder. A pair that cannot agree under any
            // instantiation voids the whole attempt.
            let parameters_bound mut = false

            if
                function.arguments |> any(a => a.is_wild) /\
                parameter_types |> all(t => !t.is_error /\ !t.contains_inferred)
            then
                let parameters_ok mut = true

                for i in 0..parameter_count do
                    if !function.arguments[i].bind_type_variables(parameter_types[i], results) then
                        parameters_ok = false
                        break
                    fi
                od

                if parameters_ok then
                    results.check_complete(location, function.generic_arguments)
                    parameters_bound = results.is_bound
                fi
            fi

            // The return slot binds what the parameters left open -
            // including variables that appear only there. Skipped when
            // the parameters already pinned everything: an open return
            // slot carries no information then, and a contradictory
            // one is the assignability check's to report.
            if !parameters_bound /\ !target_shape.is_action then
                let return_slot = shape_arguments[parameter_count]

                if let return_type = function.return_type /\ !return_slot.is_error /\ !return_slot.contains_inferred then
                    return_type.bind_type_variables(return_slot, results)
                fi
            fi

            results.check_complete(location, function.generic_arguments)

            if !results.is_bound \/ !function.check_lub_conformance(results, parameter_types) then
                return function
            fi

            // A slot shape carrying another function's method-level
            // type parameter carries an index that is meaningless
            // here; only the caller's own type parameters may appear.
            let caller = IoC.CONTAINER.instance.symbol_table.current_function

            if results.contains_function_generic_argument_foreign_to(caller) then
                return function
            fi

            return function.specialize_function(results.map, null)
        si

        // Picks the group member whose formal parameters accept
        // `target_shape`'s parameter types, via the same
        // OVERLOAD_RESOLVER a call site uses: those parameter types
        // stand in for the actual argument types (the direction a
        // value of this shape would be invoked with), and its return
        // type is the tie-break constraint.
        _resolve_group_member(
            location: LOCATION,
            group: Symbols.FUNCTION_GROUP,
            from: Value?,
            target_shape: Type
        ) -> Symbols.Function? is
            let shape_arguments = target_shape.arguments
            let parameter_count = ARGUMENT_PACK.parameter_count(target_shape)

            let parameter_types = Collections.LIST[Type](parameter_count)

            for i in 0..parameter_count do
                parameter_types.add(shape_arguments[i])
            od

            let return_constraint =
                if target_shape.is_action then
                    null
                else
                    shape_arguments[parameter_count]
                fi

            let want_instance =
                if from? then
                    from.is_consumable
                else
                    _symbol_table.current_instance_context?
                fi

            // A slot taking one tuple is filled by a member of the tuple's
            // elements where none takes the tuple itself, as for a
            // constructor: the call presents the value in the slot's shape.
            let spread = ARGUMENT_PACK.spread_shape(target_shape)

            let result mut = cast OVERLOAD_RESOLVE_RESULT?(null)

            if spread? then
                _logger.speculate()

                result = _overload_resolver.resolve(location, group, parameter_types, false, want_instance, false, null, return_constraint)

                if result? then
                    _logger.commit()
                else
                    _logger.roll_back()

                    let spread_count = ARGUMENT_PACK.parameter_count(spread)

                    let spread_types = Collections.LIST[Type](spread_count)

                    for i in 0..spread_count do
                        spread_types.add(spread.arguments[i])
                    od

                    result = _overload_resolver.resolve(location, group, spread_types, false, want_instance, false, null, return_constraint)
                fi
            else
                result = _overload_resolver.resolve(location, group, parameter_types, false, want_instance, false, null, return_constraint)
            fi

            if !result? then
                return null
            fi

            return result.function
        si

        // The type the value of `function` is built at: `expected_type`
        // where it is callable and settled, and `function`'s own type
        // otherwise, leaving the ordinary assignability check at the use
        // site to accept or reject the value against the real target.
        // Null, with the error reported, where `expected_type` is settled
        // and cannot take the function.
        _check_shape(location: LOCATION, function: Symbols.Function, expected_type: Type?) -> Type? is
            let source_shape = function.get_full_type(_innate_symbol_lookup)
            let target_shape = get_target_call_shape(expected_type)

            // A target with a slot still open - an inference
            // placeholder, or a free type variable of the enclosing
            // generic callee - can't be checked by assignability: the
            // function's own type is what should flow into that slot,
            // not be tested against it. Build at the source shape and
            // let the ordinary assignability check at the use site
            // accept or reject the value, the same way an absent
            // expected type does.
            //
            // Every position counts, not only the return, and a slot
            // that names nothing counts as open as much as a wild one
            // does. `NONE` compares different from everything, so a
            // parameter the callee has not settled refuses a function
            // the settled target would take.
            let open_slot =
                target_shape? /\
                target_shape.arguments |> any(a => a.is_wild \/ a.is_none)

            if !target_shape? \/ target_shape.contains_inferred \/ open_slot then
                return source_shape
            fi

            // A function of an argument pack's elements going into a
            // formal that takes the pack as one tuple is presented in
            // that shape by the call, once it has the value at its own.
            if ARGUMENT_PACK.adaptation_arity(target_shape, source_shape)? then
                return source_shape
            fi

            if !target_shape.is_assignable_from(source_shape) then
                _logger.error(location, "{function} is not compatible with {expected_type!}")
                return null
            fi

            // `target_shape` is the invoke *shape* used for the
            // assignability check above - when `expected_type` is a
            // real named delegate rather than a ghūl function type,
            // that shape is only the delegate's call signature, not
            // the delegate type itself. The built value has to carry
            // the delegate type so the closure is constructed
            // with `newobj` against the right `.ctor`.
            return expected_type!
        si

        _build_value(
            location: LOCATION,
            function: Symbols.Function,
            from: Value?,
            expected_type: Type?
        ) -> Value is
            let result_type = _check_shape(location, function, expected_type)

            if !result_type? then
                return DUMMY(Types.ERROR(), location)
            fi

            let target: Value =
                if !function.is_instance then
                    NULL(Types.NULL())
                elif from? then
                    from
                else
                    _symbol_loader.load_self(location)
                fi

            // `super.method` binds to the base implementation, the
            // same as an ordinary `super.method()` call site - never
            // virtual, whatever the method's own is_virtual says.
            let is_virtual = function.is_instance /\ function.is_virtual /\ !target.is_super

            return MAKE_CLOSURE(result_type, function, target, is_virtual)
        si
    si
si
