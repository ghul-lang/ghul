namespace Semantic is
    use Ghul.Pipes
    use Source.LOCATION

    use Types.Type

    use IR.Values

    // Converts a global function, static/instance/struct method, or
    // the single member of an overloaded group into a function/
    // delegate value directly - `ldftn` on the method plus whatever
    // receiver an instance method needs, no closure frame, since a
    // named function has nothing to capture.
    class FUNCTION_REFERENCE_RESOLVER(
        _logger: Logging.Logger,
        _symbol_table: SYMBOL_TABLE,
        _symbol_loader: SYMBOL_LOADER,
        _innate_symbol_lookup: Lookups.InnateSymbolLookup,
        _overload_resolver: OVERLOAD_RESOLVER
    ) is
        _delegate_shape: DELEGATE_SHAPE

        super()

        init(..) is
            _delegate_shape = DELEGATE_SHAPE()
        si

        // Returns null when `symbol` isn't a function reference in
        // value position, or is an overloaded group with no target
        // shape available yet to pick a member by - the caller then
        // falls back to its ordinary `symbol.load` path.
        try_load(
            location: LOCATION,
            symbol: Symbols.Symbol,
            from: Value?,
            expected_type: Type?,
            is_call_target: bool
        ) -> Value? is
            if is_call_target \/ isa Symbols.Closure(symbol) then
                return null
            fi

            let single: Symbols.Function? mut = cast Symbols.Function?(symbol)

            if !single? then
                let group = cast Symbols.FUNCTION_GROUP?(symbol)

                if !group? \/ group.count == 0 then
                    return null
                fi

                if group.count == 1 then
                    single = group.functions[0]
                else
                    let target_shape = get_target_call_shape(expected_type)

                    if !target_shape? then
                        return null
                    fi

                    single = _resolve_group_member(location, group, from, target_shape)

                    if !single? then
                        return DUMMY(Types.ERROR(), location)
                    fi
                fi
            fi

            // An open generic can't be checked against a target shape
            // until it's instantiated: bind its own type arguments
            // from the shape the slot expects, the same way a call
            // site binds them from its actual arguments.
            if single.is_generic then
                let target_shape = get_target_call_shape(expected_type)

                let specialized =
                    if target_shape? then
                        _try_specialize_from_target_shape(location, single, target_shape)
                    else
                        single
                    fi

                // Nothing here pins the function's own type arguments:
                // there is no slot at all, or the slot is one the
                // enclosing call has still to infer. Building the value
                // at the function's own shape would put its free type
                // variables into the argument types that resolution
                // binds from, and a variable the sibling actuals pin
                // concretely then joins with one of those to `object`.
                // Leave the reference unresolved instead - the state a
                // bare overloaded group is left in - so the caller's
                // deferred re-walk pushes the settled formal and
                // instantiates against that. With no such re-walk to
                // come, the load reports itself as unusable.
                if specialized == single /\ symbol.is_function_group /\ _slot_pins_nothing(target_shape) then
                    return null
                fi

                single = specialized
            fi

            // An innate operator is an IL instruction declared as a
            // static member, with no method behind it, so a reference
            // to one emits a call to a method the runtime cannot find.
            // Calling it is what it is for.
            if single.is_innate then
                _logger.error(
                    location,
                    "cannot take the value of built-in operator '{single.name}'")

                return DUMMY(Types.ERROR(), location)
            fi

            return _build_value(location, single, from, expected_type)
        si

        // A slot that cannot instantiate an open generic function:
        // absent, still carrying an inference placeholder, or written
        // in type variables belonging to the call being resolved
        // rather than to the function this reference sits in.
        _slot_pins_nothing(target_shape: Type?) -> bool =>
            !target_shape? \/
            target_shape.contains_inferred \/
            target_shape.has_function_generic_argument_foreign_to(_symbol_table.current_function)

        // The function-type shape a value must present to be usable
        // as `expected_type`: `expected_type` itself when it's already
        // a ghūl function type, or the call shape of its `invoke` when
        // it's a named .NET delegate. Null when `expected_type` is
        // absent, or present but not callable at all.
        get_target_call_shape(expected_type: Type?) -> Type? is
            if !expected_type? then
                return null
            fi

            if expected_type.is_function then
                return expected_type
            fi

            return _delegate_shape.try_get_function_type(expected_type, _innate_symbol_lookup)
        si

        // Instantiates an open generic function against a target
        // shape. The shape's parameter types and its return slot both
        // contribute to the function's own type arguments, so a
        // variable split between the two positions still binds.
        // Returns the function unchanged when the shape pins nothing,
        // pins it incompletely, or contradicts it - the ordinary
        // assignability check at the use site then accepts or rejects
        // the uninstantiated form.
        _try_specialize_from_target_shape(
            location: LOCATION,
            function: Symbols.Function,
            target_shape: Type
        ) -> Symbols.Function is
            let shape_arguments = target_shape.arguments
            let parameter_count = shape_arguments.count - 1

            if function.arguments.count != parameter_count then
                return function
            fi

            let parameter_types = Collections.LIST[Type](parameter_count)

            for i in 0..parameter_count do
                parameter_types.add(shape_arguments[i])
            od

            let results = Types.GENERIC_ARGUMENT_BIND_RESULTS(function.generic_arguments)

            // Parameter-driven binding can pin something only when a
            // formal mentions a type variable, and an unsettled slot
            // carries no information to bind with - leave the attempt
            // out in either case rather than binding a type argument
            // to a placeholder. A pair that cannot agree under any
            // instantiation voids the whole attempt.
            let parameters_bound mut = false

            if
                function.arguments |> any(a => a.is_wild) /\
                parameter_types |> all(t => !t.is_error /\ !t.contains_inferred)
            then
                let parameters_ok mut = true

                for i in 0..parameter_count do
                    if !function.arguments[i].bind_type_variables(parameter_types[i], results) then
                        parameters_ok = false
                        break
                    fi
                od

                if parameters_ok then
                    results.check_complete(location, function.generic_arguments)
                    parameters_bound = results.is_bound
                fi
            fi

            // The return slot binds what the parameters left open -
            // including variables that appear only there. Skipped when
            // the parameters already pinned everything: an open return
            // slot carries no information then, and a contradictory
            // one is the assignability check's to report.
            if !parameters_bound then
                let return_slot = shape_arguments[parameter_count]

                if let return_type = function.return_type /\ !return_slot.is_error /\ !return_slot.contains_inferred then
                    return_type.bind_type_variables(return_slot, results)
                fi
            fi

            results.check_complete(location, function.generic_arguments)

            if !results.is_bound \/ !function.check_lub_conformance(results, parameter_types) then
                return function
            fi

            // A slot shape carrying another function's method-level
            // type parameter carries an index that is meaningless
            // here; only the caller's own type parameters may appear.
            let caller = IoC.CONTAINER.instance.symbol_table.current_function

            if results.contains_function_generic_argument_foreign_to(caller) then
                return function
            fi

            return function.specialize_function(results.map, null)
        si

        // Picks the group member whose formal parameters accept
        // `target_shape`'s parameter types, via the same
        // OVERLOAD_RESOLVER a call site uses: those parameter types
        // stand in for the actual argument types (the direction a
        // value of this shape would be invoked with), and its return
        // type is the tie-break constraint.
        _resolve_group_member(
            location: LOCATION,
            group: Symbols.FUNCTION_GROUP,
            from: Value?,
            target_shape: Type
        ) -> Symbols.Function? is
            let shape_arguments = target_shape.arguments
            let parameter_count = shape_arguments.count - 1

            let parameter_types = Collections.LIST[Type](parameter_count)

            for i in 0..parameter_count do
                parameter_types.add(shape_arguments[i])
            od

            let return_constraint = shape_arguments[parameter_count]

            let want_instance =
                if from? then
                    from.is_consumable
                else
                    _symbol_table.current_instance_context?
                fi

            let result = _overload_resolver.resolve(location, group, parameter_types, false, want_instance, false, null, return_constraint)

            if !result? then
                return null
            fi

            return result.function
        si

        // Checked against `expected_type` when it resolves to a
        // callable shape via get_target_call_shape; a non-callable
        // (or absent) `expected_type` yields a null shape here, and
        // the function's own native call shape is used instead,
        // leaving the ordinary assignability check at the use site
        // to accept or reject it against the real target.
        _build_value(
            location: LOCATION,
            function: Symbols.Function,
            from: Value?,
            expected_type: Type?
        ) -> Value is
            let source_shape = function.get_full_type(_innate_symbol_lookup)
            let target_shape = get_target_call_shape(expected_type)

            // A target with a slot still open - an inference
            // placeholder, or a free type variable of the enclosing
            // generic callee - can't be checked by assignability: the
            // function's own type is what should flow into that slot,
            // not be tested against it. Build at the source shape and
            // let the ordinary assignability check at the use site
            // accept or reject the value, the same way an absent
            // expected type does.
            //
            // Every position counts, not only the return, and a slot
            // that names nothing counts as open as much as a wild one
            // does. `NONE` compares different from everything, so a
            // parameter the callee has not settled refuses a function
            // the settled target would take.
            let open_slot =
                target_shape? /\
                target_shape.arguments |> any(a => a.is_wild \/ a.is_none)

            if
                target_shape? /\
                !target_shape.contains_inferred /\
                !open_slot /\
                !target_shape.is_assignable_from(source_shape)
            then
                _logger.error(location, "{function} is not compatible with {expected_type!}")
                return DUMMY(Types.ERROR(), location)
            fi

            // `target_shape` is the invoke *shape* used for the
            // assignability check above - when `expected_type` is a
            // real named delegate rather than a ghūl function type,
            // that shape is only the delegate's call signature, not
            // the delegate type itself. The built value has to carry
            // the delegate type so the closure is constructed
            // with `newobj` against the right `.ctor`.
            let result_type =
                if target_shape? /\ !target_shape.contains_inferred /\ !open_slot then
                    expected_type!
                else
                    source_shape
                fi

            let target: Value =
                if !function.is_instance then
                    NULL(Types.NULL())
                elif from? then
                    from
                else
                    _symbol_loader.load_self(location)
                fi

            // `super.method` binds to the base implementation, the
            // same as an ordinary `super.method()` call site - never
            // virtual, whatever the method's own is_virtual says.
            let is_virtual = function.is_instance /\ function.is_virtual /\ !target.is_super

            return MAKE_CLOSURE(result_type, function, target, is_virtual)
        si
    si
si
