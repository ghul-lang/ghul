namespace Semantic is
    // The old names of the core types, each mapped to the ghūl name the
    // type is declared and printed under. An old name is a second
    // spelling of the one type rather than a second type, on every
    // target: on .NET the reflected type is registered under its new
    // name, and on WebAssembly the core library declares it there.
    //
    // Keyed on the qualified names as source writes them, which is what
    // a program spells and what a lookup is asked for.
    class CORE_TYPE_ALIASES is
        // Each old name and the new name it stands for. Retiring an old
        // name is deleting its line.
        all: (old_name: string, new_name: string)[] static =>
            [
                (old_name = "System.Exception", new_name = "Ghul.Exception"),
                (old_name = "System.NotImplementedException", new_name = "Ghul.NotImplementedException"),
                (old_name = "System.InvalidOperationException", new_name = "Ghul.InvalidOperationException"),
                (old_name = "System.NotSupportedException", new_name = "Ghul.NotSupportedException"),
                (old_name = "System.ArgumentException", new_name = "Ghul.ArgumentException"),
                (old_name = "System.ArgumentOutOfRangeException", new_name = "Ghul.ArgumentOutOfRangeException"),
                (old_name = "System.ArithmeticException", new_name = "Ghul.ArithmeticException"),
                (old_name = "System.DivideByZeroException", new_name = "Ghul.DivideByZeroException"),
                (old_name = "System.OverflowException", new_name = "Ghul.OverflowException"),
                (old_name = "System.IndexOutOfRangeException", new_name = "Ghul.IndexOutOfRangeException"),
                (old_name = "System.InvalidCastException", new_name = "Ghul.InvalidCastException"),
                (old_name = "System.NullReferenceException", new_name = "Ghul.NullReferenceException"),
                (old_name = "System.FormatException", new_name = "Ghul.FormatException"),
                (old_name = "System.Text.StringBuilder", new_name = "Text.STRING_BUILDER"),
                (old_name = "System.Math", new_name = "Ghul.Math"),
                (old_name = "System.Random", new_name = "Ghul.RANDOM"),
                (old_name = "System.StringSplitOptions", new_name = "Ghul.StringSplitOptions"),
                (old_name = "System.StringComparison", new_name = "Ghul.StringComparison"),
                (old_name = "Collections.KeyValuePair", new_name = "Collections.KEY_VALUE_PAIR")
            ]

        // Names that are aliases only where the core library declares the
        // type under its ghūl name, which on .NET it does not: there the
        // old name is the type's own.
        source_only: (old_name: string, new_name: string)[] static =>
            [
                (old_name = "System.Type", new_name = "Ghul.Type")
            ]

        /// The ghūl name `name` stands for, where it is an old name of a
        /// core type the core library declares in source, and otherwise
        /// null.
        ///
        /// - name: a qualified name, as source writes it
        renamed_in_source(name: string) -> string? static is
            for alias in all do
                if alias.old_name =~ name then
                    return alias.new_name
                fi
            od

            for alias in source_only do
                if alias.old_name =~ name then
                    return alias.new_name
                fi
            od

            return null
        si

        /// Whether `name` is a namespace some old name lies in, such as
        /// `System` or `System.Text`, where the core library declares the
        /// types in source.
        ///
        /// - name: a qualified name, as source writes it
        is_namespace_in_source(name: string) -> bool static is
            let prefix = "{name}."

            for alias in all do
                if alias.old_name.starts_with(prefix) then
                    return true
                fi
            od

            for alias in source_only do
                if alias.old_name.starts_with(prefix) then
                    return true
                fi
            od

            return false
        si
    si
si
