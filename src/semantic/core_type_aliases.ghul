namespace Semantic is
    // The old names of the core types, each mapped to the ghūl name the
    // type is declared and printed under. An old name is a second
    // spelling of the one type rather than a second type, on every
    // target: on .NET the reflected type is registered under its new
    // name, and on WebAssembly the core library declares it there.
    //
    // Keyed on the qualified names as source writes them, which is what
    // a program spells and what a lookup is asked for.
    class CORE_TYPE_ALIASES is
        // Each old name and the new name it stands for. Retiring an old
        // name is deleting its line.
        all: (old_name: string, new_name: string)[] static

        // Where a core library from before a type moved still declares it:
        // its new name, and the name it had there. Tried after the new
        // name, so source written against either core library compiles
        // while the libraries that read it move across. Retiring one is
        // deleting its line once nothing still reads the earlier home.
        earlier_homes: (new_name: string, earlier_name: string)[] static

        init() static is
            all = [
                (old_name = "System.Exception", new_name = "Ghul.Exception"),
                (old_name = "System.NotImplementedException", new_name = "Ghul.NotImplementedException"),
                (old_name = "System.InvalidOperationException", new_name = "Ghul.InvalidOperationException"),
                (old_name = "System.NotSupportedException", new_name = "Ghul.NotSupportedException"),
                (old_name = "System.ArgumentException", new_name = "Ghul.ArgumentException"),
                (old_name = "System.ArgumentOutOfRangeException", new_name = "Ghul.ArgumentOutOfRangeException"),
                (old_name = "System.ArithmeticException", new_name = "Ghul.ArithmeticException"),
                (old_name = "System.DivideByZeroException", new_name = "Ghul.DivideByZeroException"),
                (old_name = "System.OverflowException", new_name = "Ghul.OverflowException"),
                (old_name = "System.IndexOutOfRangeException", new_name = "Ghul.IndexOutOfRangeException"),
                (old_name = "System.InvalidCastException", new_name = "Ghul.InvalidCastException"),
                (old_name = "System.NullReferenceException", new_name = "Ghul.NullReferenceException"),
                (old_name = "System.FormatException", new_name = "Ghul.FormatException"),
                (old_name = "System.AggregateException", new_name = "Ghul.AggregateException"),
                (old_name = "System.ObjectDisposedException", new_name = "Ghul.ObjectDisposedException"),
                (old_name = "System.UnauthorizedAccessException", new_name = "Ghul.UnauthorizedAccessException"),
                (old_name = "System.Type", new_name = "Ghul.Type"),
                (old_name = "System.Text.StringBuilder", new_name = "Text.STRING_BUILDER"),
                (old_name = "System.Globalization.UnicodeCategory", new_name = "Text.UnicodeCategory"),
                (old_name = "System.Text.RegularExpressions.Regex", new_name = "Text.REGEX"),
                (old_name = "System.Text.RegularExpressions.Match", new_name = "Text.MATCH"),
                (old_name = "System.Text.RegularExpressions.Group", new_name = "Text.GROUP"),
                (old_name = "System.Text.RegularExpressions.MatchCollection", new_name = "Text.MATCH_COLLECTION"),
                (old_name = "System.Text.RegularExpressions.GroupCollection", new_name = "Text.GROUP_COLLECTION"),
                (old_name = "System.Text.RegularExpressions.RegexOptions", new_name = "Text.RegexOptions"),
                (old_name = "System.DateTime", new_name = "Time.DATE_TIME"),
                (old_name = "System.DateTimeOffset", new_name = "Time.DATE_TIME_OFFSET"),
                (old_name = "System.TimeSpan", new_name = "Time.TIME_SPAN"),
                (old_name = "System.DayOfWeek", new_name = "Time.DayOfWeek"),
                (old_name = "System.DateTimeKind", new_name = "Time.DateTimeKind"),
                (old_name = "System.Diagnostics.Stopwatch", new_name = "Time.STOPWATCH"),
                (old_name = "System.Globalization.ISOWeek", new_name = "Time.ISO_WEEK"),
                (old_name = "System.Random", new_name = "Ghul.RANDOM"),
                (old_name = "System.StringSplitOptions", new_name = "Ghul.StringSplitOptions"),
                (old_name = "System.StringComparison", new_name = "Ghul.StringComparison"),
                (old_name = "System.Lazy", new_name = "Ghul.LAZY"),
                (old_name = "System.FlagsAttribute", new_name = "Ghul.FlagsAttribute"),
                (old_name = "Collections.KeyValuePair", new_name = "Collections.KEY_VALUE_PAIR"),
                (old_name = "Collections.Queue", new_name = "Collections.QUEUE"),
                (old_name = "Collections.PriorityQueue", new_name = "Collections.PRIORITY_QUEUE"),
                (old_name = "Collections.LinkedList", new_name = "Collections.LINKED_LIST"),
                (old_name = "Collections.IComparer", new_name = "Collections.Comparer"),
                (old_name = "Collections.IEqualityComparer", new_name = "Collections.EqualityComparer")
            ]

            earlier_homes = [
                (new_name = "Text.STRING_BUILDER", earlier_name = "Ghul.STRING_BUILDER"),
                (new_name = "Time.DATE_TIME", earlier_name = "System.DateTime"),
                (new_name = "Time.DATE_TIME_OFFSET", earlier_name = "System.DateTimeOffset"),
                (new_name = "Time.TIME_SPAN", earlier_name = "System.TimeSpan"),
                (new_name = "Time.DayOfWeek", earlier_name = "System.DayOfWeek"),
                (new_name = "Time.DateTimeKind", earlier_name = "System.DateTimeKind"),
                (new_name = "Time.STOPWATCH", earlier_name = "System.Diagnostics.Stopwatch"),
                (new_name = "Time.ISO_WEEK", earlier_name = "System.Globalization.ISOWeek")
            ]
        si

        /// Where to look for the type named `new_name` in source, in
        /// order: the name itself, then any earlier home a core library
        /// from before it moved declares it in.
        ///
        /// - new_name: a core type's qualified ghūl name
        homes(new_name: string) -> string[] static is
            let result = Collections.LIST[string]()

            result.add(new_name)

            for home in earlier_homes do
                if home.new_name =~ new_name then
                    result.add(home.earlier_name)
                fi
            od

            return result
        si

        /// The ghūl name `name` stands for, where it is an old name of a
        /// core type the core library declares in source, and otherwise
        /// null.
        ///
        /// - name: a qualified name, as source writes it
        renamed_in_source(name: string) -> string? static is
            for alias in all do
                if alias.old_name =~ name then
                    return alias.new_name
                fi
            od

            return null
        si

        /// Whether `name` is a namespace some old name lies in, such as
        /// `System` or `System.Text`, or one a type is moving to, such as
        /// `Time`, where the core library declares the types in source.
        ///
        /// - name: a qualified name, as source writes it
        is_namespace_in_source(name: string) -> bool static is
            let prefix = "{name}."

            for alias in all do
                if alias.old_name.starts_with(prefix) then
                    return true
                fi
            od

            for home in earlier_homes do
                if home.new_name.starts_with(prefix) then
                    return true
                fi
            od

            return false
        si

        /// Whether the core type named `new_name` has an earlier home, where
        /// a core library from before it moved declares it.
        ///
        /// - new_name: a core type's qualified ghūl name
        has_earlier_home(new_name: string) -> bool static is
            for home in earlier_homes do
                if home.new_name =~ new_name then
                    return true
                fi
            od

            return false
        si
    si
si
