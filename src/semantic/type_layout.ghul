namespace Semantic is
    use System.Runtime.InteropServices.LayoutKind

    // What a type's `StructLayout` says: how its fields are laid out,
    // the alignment they are packed to, the size the type occupies, and
    // the character set strings in it are marshalled as. The runtime
    // reads these from the type's flags and its ClassLayout row rather
    // than from a custom attribute. A pack or size of 0 leaves the
    // runtime's default, and a char set of 0 leaves the type's own.
    class TYPE_LAYOUT(
        kind: LayoutKind public,
        pack: int public,
        size: int public,
        char_set: int public
    ) is
        is_explicit: bool => kind == LayoutKind.EXPLICIT
    si
si
