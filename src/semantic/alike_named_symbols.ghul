namespace Semantic is
    use Symbols.Symbol
    use Types.Type

    // Collects, across the types one diagnostic mentions, the distinct
    // declarations that share a name. Rendered relative to the reader's
    // scope two of those can come out as the same text, so each one found
    // is rendered fully qualified instead.
    class ALIKE_NAMED_SYMBOLS is
        _first_by_name: Collections.MAP[string, Symbol]
        _alike: Collections.LIST[Symbol]

        symbols: Symbol[] => _alike

        init() is
            _first_by_name = Collections.MAP[string, Symbol]()
            _alike = Collections.LIST[Symbol]()
        si

        add(type: Type?) is
            if !type? then
                return
            fi

            if isa Types.NAMED(type) then
                _add_symbol(type.symbol.unspecialized_symbol)

                for argument in type.arguments do
                    add(argument)
                od
            fi
        si

        add_function(function: Symbols.Function) is
            for argument in function.arguments do
                add(argument)
            od

            for argument in function.generic_arguments do
                add(argument)
            od

            add(function.return_type)
        si

        _add_symbol(symbol: Symbol) is
            let name = symbol.name
            let first: Symbol mut

            if _first_by_name.try_get_value(name, first ref) then
                if first != symbol then
                    _note(first)
                    _note(symbol)
                fi
            else
                _first_by_name[name] = symbol
            fi
        si

        _note(symbol: Symbol) is
            for s in _alike do
                if s == symbol then
                    return
                fi
            od

            _alike.add(symbol)
        si
    si
si
