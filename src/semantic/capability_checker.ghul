namespace Semantic is
    use Logging
    use Source

    // Checks a use of a feature against what the target supports, and
    // reports the uses it does not. Every check for every feature goes
    // through check, so the diagnostics all say the same thing in the same
    // shape.
    class CAPABILITY_CHECKER is
        _capabilities: TargetCapabilities
        _logger: Logger

        init(capabilities: TargetCapabilities, logger: Logger) is
            _capabilities = capabilities
            _logger = logger
        si

        // Whether the target supports `capability`. A use it does not is
        // reported at `location`, naming the use `feature`.
        check(capability: Capability, location: LOCATION, feature: string) -> bool is
            if _capabilities.is_supported(capability) then
                return true
            fi

            _logger.error(
                location,
                "{feature} not supported on the {_capabilities.target_name} target")

            return false
        si
    si
si
