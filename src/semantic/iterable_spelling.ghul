namespace Semantic is
    // `T{}` is how `Collections.Iterable[T]` is written and shown, as
    // `T[]` is for an array. This says whether a generic is the one
    // spelled that way, by the reflected trait it is built on.
    class ITERABLE_SPELLING is
        applies_to(unspecialized: Symbols.Symbol, argument_count: int) -> bool static is
            // Checked by name first: every generic rendered comes through
            // here, and only the one named `Iterable` needs the lookup.
            if argument_count != 1 \/ unspecialized.name !~ "Iterable" then
                return false
            fi

            let iterable = IoC.CONTAINER.instance.innate_symbol_lookup.get_unspecialized_iterable_type()

            if let iterable_trait = iterable.symbol?.root_unspecialized_symbol then
                return iterable_trait == unspecialized.root_unspecialized_symbol
            fi

            return false
        si
    si
si
