namespace Semantic is
    // What a target's back end can consume. A pass asks before reporting a
    // feature the target cannot carry, so an editor and a batch build give
    // the same answer.
    trait TargetCapabilities is
        // Whether the target accepts a use of `capability`.
        is_supported(capability: Capability) -> bool

        // The name a diagnostic names the target by.
        target_name: string
    si

    // The .NET target: everything the front end accepts reaches the
    // emitter.
    class DOTNET_TARGET_CAPABILITIES: TargetCapabilities is
        init() is
        si

        is_supported(capability: Capability) -> bool => true

        target_name: string => "dotnet"
    si

    // The WebAssembly target: its back end is not written, so nothing in
    // the enum is supported yet.
    class WASM_TARGET_CAPABILITIES: TargetCapabilities is
        init() is
        si

        is_supported(capability: Capability) -> bool => false

        target_name: string => "wasm"
    si
si
