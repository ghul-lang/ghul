namespace Semantic is
    // `T[]` is how `T[]` is written and shown, as `T{}`
    // is for `Collections.Iterable[T]`. This says whether a generic is
    // the one spelled that way, by the trait it is built on.
    class LIST_SPELLING is
        applies_to(unspecialized: Symbols.Symbol, argument_count: int) -> bool static is
            // Checked by name first: every generic rendered comes through
            // here, and only the one named `List` needs the lookup.
            if argument_count != 1 \/ unspecialized.name !~ "List" then
                return false
            fi

            let list = IoC.CONTAINER.instance.innate_symbol_lookup.get_unspecialized_list_type()

            if let list_trait = list.symbol?.root_unspecialized_symbol then
                return list_trait == unspecialized.root_unspecialized_symbol
            fi

            return false
        si

        // Whether `type` is a `Collections.List` spelled `T[]`.
        applies_to_type(type: Types.Type) -> bool static =>
            if let generic: Types.GENERIC = type then applies_to(generic.symbol, generic.arguments.count) else false fi

        // The element as it is written before the `[]`: a function type
        // keeps its parentheses, so `(int -> int)[]` is not read as a
        // function returning `int[]`.
        element_description(rendered: string, element: Types.Type) -> string static =>
            if element.is_function then "({rendered})" else rendered fi
    si
si
