namespace Semantic is
    use Semantic.Types.Type

    // How an interpolated value becomes text.
    enum InterpolatedValueRendering is
        // Formatted as .NET formats it: a string, a number, an enum, or a
        // type declaring its own to_string. An alignment or a format does
        // not change how a value reads: it pads, or formats, what the
        // value's own rendering produces.
        FORMATTED,

        // `true` or `false`, as ghūl spells them.
        BOOL,

        // The value it holds, rendered by the rules for its non-optional
        // type, or `null` when it holds none.
        OPTIONAL,

        // Rendered by the runtime's `$`: a value whose static type gives
        // it no text of its own, which .NET would print as its type name.
        DISPLAYED
    si

    class INTERPOLATED_VALUE_CLASSIFIER is
        _lookup: Lookups.InnateSymbolLookup

        init(lookup: Lookups.InnateSymbolLookup) is
            _lookup = lookup
        si

        classify(type: Type, is_formatted: bool) -> InterpolatedValueRendering is
            if is_formatted then
                return InterpolatedValueRendering.FORMATTED
            fi

            if type.is_optional /\ type.optional_inner_type? then
                return InterpolatedValueRendering.OPTIONAL
            fi

            if _is(type, _lookup.get_bool_type()) then
                return InterpolatedValueRendering.BOOL
            fi

            // An enum reads as its member's name wherever its base class
            // library gives it no to_string of its own to say so.
            if isa Symbols.ENUM_STRUCT(type.symbol) then
                return InterpolatedValueRendering.FORMATTED
            fi

            // A function value has no text worth reading beyond its type,
            // and rendering its delegate's members would expose the
            // compiler's closure machinery.
            if type.is_function \/ type.is_action then
                return InterpolatedValueRendering.FORMATTED
            fi

            if
                type.is_value_tuple \/
                isa Types.TUPLE(type) \/
                type.is_object \/
                type.is_type_variable \/
                type.is_classy_generic_argument \/
                type.is_function_generic_argument
            then
                return InterpolatedValueRendering.DISPLAYED
            fi

            if _is(type, _lookup.get_string_type()) \/ has_own_to_string(type) then
                return InterpolatedValueRendering.FORMATTED
            fi

            if isa Types.ARRAY(type) \/ type.is_trait \/ type.find_ancestor(_lookup.get_unspecialized_iterable_type())? then
                return InterpolatedValueRendering.DISPLAYED
            fi

            // An imported type that says nothing of itself keeps its .NET
            // type name: rendering it by its members would run whatever
            // its property getters do.
            if type.symbol.is_reflected then
                return InterpolatedValueRendering.FORMATTED
            fi

            return InterpolatedValueRendering.DISPLAYED
        si

        // Whether a type says what it is in its own words, through a
        // to_string declared somewhere other than the roots every type
        // inherits one from. An enum counts: System.Enum's to_string gives
        // the member's name.
        has_own_to_string(type: Type) -> bool is
            let to_string = zero_argument_to_string(type.find_member("to_string"))

            if !to_string? then
                return false
            fi

            let owner = to_string.owner

            return
                owner? /\
                owner != _lookup.get_object_type().symbol /\
                owner != _lookup.get_value_type().symbol
        si

        // The overload of the runtime's `$` that renders any value, or
        // null where the runtime referenced has no `$`.
        display_function: Symbols.Function? is
            if let functions = _lookup.get_display_functions() then
                for function in functions.functions do
                    if !function.is_generic /\ function.arguments.count == 1 then
                        let parameter = function.arguments[0].type!

                        if (parameter.optional_inner_type ?? parameter).is_object then
                            return function
                        fi
                    fi
                od
            fi

            return null
        si

        _is(type: Type, other: Type) -> bool =>
            type.compare(other) == Types.MATCH.SAME

        zero_argument_to_string(member: Symbols.Symbol?) -> Symbols.Function? static is
            if let group: Symbols.FUNCTION_GROUP = member then
                for function in group.functions do
                    if !function.are_arguments_declared \/ function.arguments.count == 0 then
                        return function
                    fi
                od
            fi

            return null
        si
    si
si
