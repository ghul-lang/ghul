namespace Semantic is
    // Where a declaration may carry a mark that only a core library writes,
    // such as @widening() and @widen_operands(): a file of one of the
    // source libraries the build declares, or, in a build that declares
    // none, a build that is its own core because it references no ghūl
    // runtime. An ordinary program always has one or the other, so it
    // never may.
    class CORE_MARKS is
        may_write(file_name: string) -> bool static is
            if let sources = IoC.CONTAINER.instance.build_flags.library_sources /\ sources.declares_any then
                return sources.can_declare_core(file_name)
            fi

            @IF.dotnet()
            if IoC.CONTAINER.instance.assemblies.find_type("Ghul.Internal.PURE_ATTRIBUTE")? then
                return false
            fi

            return true
        si
    si
si
