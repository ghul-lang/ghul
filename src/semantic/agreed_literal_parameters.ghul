namespace Semantic is
    use Ghul.Pipes

    use Types.Type

    // Candidates can tie because a function literal argument has not been
    // typed yet: its parameters have no written types, so its result is not
    // known, and the candidates differ only in the result their function
    // formal asks for. Where every candidate gives the literal the same
    // parameters, the literal can be typed against those parameters alone,
    // with its result left to its own body, and the candidates then compared
    // against the result that body produces.
    class AGREED_LITERAL_PARAMETERS is
        // Per argument, the function type to type a literal argument
        // against: the parameters every candidate's formal agrees on, and
        // an error type in place of the result, which pushes nothing onto
        // the literal's body. Absent for an argument that is not such a
        // literal. Null where the candidates disagree on any literal's
        // parameters, where a parameter is not settled, or where no
        // argument is a literal still to be typed.
        @suppress("presence-test-non-optional")
        shapes(
            candidates: Symbols.Function[],
            arguments: Type[],
            innate_symbol_lookup: Lookups.InnateSymbolLookup
        ) -> Type?[]? static is
            if candidates.count < 2 then
                return null
            fi

            let result = Collections.LIST[Type?]()
            let any_literal mut = false

            for i in 0..arguments.count do
                let argument = arguments[i]

                if !argument? \/ !argument.is_function_with_any_implicit_argument_types then
                    result.add(null)
                    continue
                fi

                // A literal whose result is already known has nothing more
                // to say once re-walked, and the tie stands.
                if !argument.is_action /\ argument.arguments.count > 0 /\ argument.arguments[argument.arguments.count - 1].is_settled then
                    return null
                fi

                let shape = _agreed_shape(candidates, i, innate_symbol_lookup)

                if !shape? then
                    return null
                fi

                result.add(shape)
                any_literal = true
            od

            if !any_literal then
                return null
            fi

            return result
        si

        @suppress("presence-test-non-optional")
        _agreed_shape(
            candidates: Symbols.Function[],
            index: int,
            innate_symbol_lookup: Lookups.InnateSymbolLookup
        ) -> Type? static is
            let first_candidate = candidates[0]

            if index >= first_candidate.arguments.count then
                return null
            fi

            let first = first_candidate.arguments[index]

            if !first? \/ !first.is_function then
                return null
            fi

            let count = ARGUMENT_PACK.parameter_count(first)

            for p in 0..count do
                if !first.arguments[p].is_settled \/ first.arguments[p].is_wild then
                    return null
                fi
            od

            for candidate in candidates do
                if index >= candidate.arguments.count then
                    return null
                fi

                let formal = candidate.arguments[index]

                if
                    !formal? \/ !formal.is_function \/
                    ARGUMENT_PACK.parameter_count(formal) != count \/
                    formal.is_pure_function != first.is_pure_function
                then
                    return null
                fi

                for p in 0..count do
                    if formal.arguments[p].compare(first.arguments[p]) != Types.MATCH.SAME then
                        return null
                    fi
                od
            od

            let types = Collections.LIST[Type]()

            for p in 0..count do
                types.add(first.arguments[p])
            od

            types.add(Types.ERROR())

            return innate_symbol_lookup.get_function_type(types, first.is_pure_function)
        si
    si
si
