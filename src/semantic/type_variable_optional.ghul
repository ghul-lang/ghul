namespace Semantic is
    use Types.Type

    use Symbols.TypeParameterConstraintKind

    // The `T?` form of a type parameter, which lowers by the parameter's
    // declared kind: a `struct` parameter to NULLABLE[T], a `class` one
    // to a flagged reference, an `?` one is already optional, and an
    // unconstrained one to `Ghul.MAYBE[T]`, the runtime carrier that
    // picks neither lowering at declaration site and defers the
    // absent/present distinction to a runtime flag. Null when the
    // parameter is unconstrained and MAYBE is unavailable, which is the
    // case while compiling ghul-runtime itself.
    class TYPE_VARIABLE_OPTIONAL is
        of(type_variable: Type, lookup: Lookups.InnateSymbolLookup) -> Type? static is
            let kind = type_variable.symbol.constraint_kind

            if kind == TypeParameterConstraintKind.VALUE then
                return lookup.get_optional_type(type_variable)
            elif kind == TypeParameterConstraintKind.REFERENCE then
                return type_variable.as_optional()
            elif kind == TypeParameterConstraintKind.OPTIONAL then
                return type_variable
            fi

            return lookup.get_maybe_type(type_variable)
        si
    si
si
