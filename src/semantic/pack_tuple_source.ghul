namespace Semantic is
    use Types.Type

    // Which argument decides the tuple a spread formal's pack binds to.
    //
    // A literal written at `f: T.. -> U` is adapted into a one-parameter
    // wrapper that destructures the pack's tuple, and the wrapper is not
    // rebuilt once it is in place. While the tuple is still a placeholder
    // the adaptation is premature exactly when some other formal holds the
    // same placeholder - `each[T](source: Iterable[T], f: T.. -> void)` -
    // because that formal's argument settles the tuple on a later walk.
    // Where no other formal holds it, the literal is the only thing that
    // can decide it, and adapting it is how that happens.
    class PACK_TUPLE_SOURCE is
        init() is
            super.init()
        si

        is_decided_by_another_formal(formals: Type[], index: int, pack: Type) -> bool is
            for i in 0..formals.count do
                if i != index /\ _shares_placeholder(formals[i], pack) then
                    return true
                fi
            od

            return false
        si

        _shares_placeholder(type: Type, pack: Type) -> bool is
            if type.is_inferred then
                return _holds(pack, type)
            fi

            for argument in type.arguments do
                if _shares_placeholder(argument, pack) then
                    return true
                fi
            od

            return false
        si

        _holds(type: Type, placeholder: Type) -> bool is
            if type == placeholder then
                return true
            fi

            for argument in type.arguments do
                if _holds(argument, placeholder) then
                    return true
                fi
            od

            return false
        si
    si
si
