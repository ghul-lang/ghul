namespace Semantic is
    use Source

    // The scope for the members of a partial or impl block whose target
    // was rejected. The block has already been reported once at its
    // target, so its members are refused without a further error each.
    class REJECTED_BLOCK_SCOPE: BLOCK_SCOPE is
        init(enclosing: Scope?) is
            super.init(enclosing)
        si

        declare_undefined(location: LOCATION, kind: string, name: string) -> Symbols.Symbol =>
            Symbols.UNDEFINED(location, self, name)

        // A local of a function inside the block is an ordinary local; a
        // field of the block itself is declared nowhere, but is still a
        // field, which later passes find typed.
        declare_variable(location: LOCATION, name: string, is_static: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbols.Symbol =>
            if IoC.CONTAINER.instance.local_id_generator.is_in_function then
                super.declare_variable(location, name, is_static, symbol_definition_listener)
            else
                Symbols.INSTANCE_FIELD(location, self, name)
            fi

        // A property, declared nowhere: its accessors are declared after it
        // and look for the property they belong to.
        declare_property(location: LOCATION, span: LOCATION, name: string, is_static: bool, is_private: bool, is_assignable: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbols.Symbol =>
            Symbols.INSTANCE_PROPERTY(location, span, self, name, is_assignable, is_private)
    si
si
