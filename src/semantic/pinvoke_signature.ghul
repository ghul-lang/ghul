namespace Semantic is
    use Types.Type

    // Which types may cross the boundary into a shared library.
    //
    // A native call carries its arguments as the machine lays them out,
    // so the types it can carry are the ones whose layout is fixed: the
    // scalars, a pointer, a reference to a scalar, and a string, which
    // the runtime marshals to a null-terminated buffer for the duration
    // of the call. Anything else - a class, a tuple, an array, a
    // function - has a representation the runtime would have to be told
    // how to marshal, and is reported rather than emitted, so a program
    // that cannot be called says so before any IL is written.
    class PINVOKE_SIGNATURE is
        _innate_symbol_lookup: Lookups.InnateSymbolLookup

        init(innate_symbol_lookup: Lookups.InnateSymbolLookup) is
            super.init()

            _innate_symbol_lookup = innate_symbol_lookup
        si

        // Whether an `@extern` parameter may be declared at this type when
        // building for `target`. Every target takes the scalars and strings.
        // .NET and llvm also take a reference to a scalar, which crosses as
        // the slot's address, and an ARRAY[ubyte], which crosses as the
        // address of its first element, each valid for the call. Only .NET
        // takes a pointer.
        can_take_on(type: Type?, target: Compiler.Target) -> bool =>
            !refusal_on(type, target)?

        // Why a parameter of this type cannot cross to foreign code when
        // building for `target`, or null where it can.
        refusal_on(type: Type?, target: Compiler.Target) -> ExternRefusal? is
            if !type? then
                return ExternRefusal.OTHER
            fi

            if is_scalar(type) \/ is_string(type) then
                return null
            fi

            if type.is_ref then
                if !is_scalar(type.get_element_type()) then
                    return ExternRefusal.REFERENCE_TO_NON_SCALAR
                fi

                return if target == Compiler.Target.WASM then ExternRefusal.REFERENCE_ON_WASM else null fi
            fi

            if is_byte_array(type) then
                return if target == Compiler.Target.WASM then ExternRefusal.ARRAY_ON_WASM else null fi
            fi

            if type.is_pointer then
                return if target == Compiler.Target.DOTNET then null else ExternRefusal.POINTER fi
            fi

            if isa Types.ARRAY(type) then
                return ExternRefusal.ARRAY_OF_NON_BYTE
            fi

            return ExternRefusal.OTHER
        si

        // Whether this is ARRAY[ubyte], the array that crosses as a buffer.
        is_byte_array(type: Type?) -> bool =>
            if let array: Types.ARRAY = type then
                array.arguments.count == 1 /\ array.arguments[0].matches(_innate_symbol_lookup.get_ubyte_type())
            else
                false
            fi

        // Whether an `@extern` may answer this type when building for
        // `target`. A string is only offered where it can be copied out and
        // released, and the declaration says it can.
        can_return_on(type: Type?, target: Compiler.Target, owns_result: bool) -> bool is
            if target == Compiler.Target.DOTNET then
                return can_return(type)
            fi

            if !type? then
                return false
            fi

            if type.is_void \/ type.matches(_innate_symbol_lookup.get_void_type()) \/ is_scalar(type) then
                return true
            fi

            return type.matches(_innate_symbol_lookup.get_string_type()) /\ (owns_result \/ target == Compiler.Target.WASM)
        si

        // Whether this is the string type.
        is_string(type: Type?) -> bool =>
            type? /\ type.matches(_innate_symbol_lookup.get_string_type())

        // Whether a parameter may be declared at this type.
        can_take(type: Type?) -> bool is
            if !type? then
                return false
            fi

            if is_scalar(type) \/ type.is_pointer then
                return true
            fi

            if type.is_ref then
                return is_scalar(type.get_element_type())
            fi

            return type.matches(_innate_symbol_lookup.get_string_type())
        si

        // Whether a method may return this type. A string return is not
        // offered: who frees the buffer the callee returned is the
        // library's business rather than the runtime's, and the default
        // marshalling would free it as if it were the runtime's own.
        can_return(type: Type?) -> bool is
            if !type? then
                return false
            fi

            if type.is_void \/ type.matches(_innate_symbol_lookup.get_void_type()) then
                return true
            fi

            return is_scalar(type) \/ type.is_pointer
        si

        // The scalars, by the symbols the compiler knows them as rather
        // than by what they render as.
        is_scalar(type: Type?) -> bool is
            if !type? then
                return false
            fi

            for scalar in _scalars() do
                if type.matches(scalar) then
                    return true
                fi
            od

            return false
        si

        _scalars() -> Type[] =>
            [
                _innate_symbol_lookup.get_bool_type(),
                _innate_symbol_lookup.get_char_type(),
                _innate_symbol_lookup.get_byte_type(),
                _innate_symbol_lookup.get_ubyte_type(),
                _innate_symbol_lookup.get_short_type(),
                _innate_symbol_lookup.get_ushort_type(),
                _innate_symbol_lookup.get_int_type(),
                _innate_symbol_lookup.get_uint_type(),
                _innate_symbol_lookup.get_long_type(),
                _innate_symbol_lookup.get_ulong_type(),
                _innate_symbol_lookup.get_word_type(),
                _innate_symbol_lookup.get_uword_type(),
                _innate_symbol_lookup.get_single_type(),
                _innate_symbol_lookup.get_double_type()
            ]
    si
si

namespace Semantic is
    // Why a type cannot be an `@extern` parameter on the target being built.
    enum ExternRefusal is
        REFERENCE_TO_NON_SCALAR,
        REFERENCE_ON_WASM,
        ARRAY_ON_WASM,
        ARRAY_OF_NON_BYTE,
        POINTER,
        OTHER
    si
si
