namespace Semantic is
    use Logging.Logger
    use Symbols.Classy
    use Symbols.NAMESPACE

    // The namespaces and types `--rtti-include` names, which reflection
    // describes as it describes those marked `@reflected()`: a namespace's
    // global functions and types, and a type's methods. `*` names every
    // namespace and type, the libraries' included. Each name is resolved
    // to the symbol it names, and symbols are what are compared.
    class RTTI_INCLUDES is
        init() is si

        // Reports each name that is neither a namespace nor a type.
        check(logger: Logger) static is
            for name in _names do
                if !(name =~ "*") /\ !_namespace_named(name)? /\ !_type_named(name)? then
                    logger.error(Source.LOCATION.internal, "rtti-include-not-found", "--rtti-include names '{name}', which is neither a namespace nor a type")
                fi
            od
        si

        // Whether `--rtti-include` names `type`, or the namespace declaring it.
        includes(type: Classy) -> bool static is
            for name in _names do
                if name =~ "*" then
                    return true
                fi

                if let `namespace = _namespace_named(name) /\ type.owner == `namespace then
                    return true
                fi

                if let named = _type_named(name) /\ named == type then
                    return true
                fi
            od

            return false
        si

        // Whether `--rtti-include` names `namespace`.
        includes(`namespace: NAMESPACE) -> bool static is
            for name in _names do
                if name =~ "*" then
                    return true
                fi

                if let named = _namespace_named(name) /\ named == `namespace then
                    return true
                fi
            od

            return false
        si

        _names: Collections.LIST[string] static => IoC.CONTAINER.instance.build_flags.rtti_includes

        _namespace_named(name: string) -> NAMESPACE? static =>
            IoC.CONTAINER.instance.namespaces.try_find_namespace(".{name}")

        _type_named(name: string) -> Classy? static is
            let dot = name.last_index_of('.')

            if dot < 0 then
                return null
            fi

            if let `namespace = _namespace_named(name.substring(0, dot)) then
                return cast Classy?(`namespace.find_direct(name.substring(dot + 1)))
            fi

            return null
        si
    si
si
