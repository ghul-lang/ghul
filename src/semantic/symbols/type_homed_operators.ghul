namespace Semantic.Symbols is
    // The operators a type declares for itself: the arithmetic, bitwise
    // and shift operators, which a .NET type declares as a public static
    // `op_*` method and which ghūl declares as an intrinsic for each
    // scalar type. An operator expression finds every candidate the same
    // way - on the types of its operands - and a reflected operator never
    // competes with an intrinsic for the same operands.
    //
    // An intrinsic is registered on every distinct type among its
    // parameters, so an operand of any of them reaches it: `<<(long, int)`
    // is found through an `int` count as well as through a `long` value,
    // which is what makes `x << 7` with `x` still unknown ambiguous across
    // widths rather than `int` by default.
    //
    // Equality, ordering, the boolean connectives and the range operators
    // stay global: no reflected type contributes one that reaches
    // operator resolution, and equality and ordering carry their own
    // resolution around the null-safe and relational rewrites.
    class TYPE_HOMED_OPERATORS is
        _names: Collections.SET[string] static

        init() static is
            _names = Collections.SET[string]([
                "+", "-", "*", "/", "%",
                "&", "|", "^", "\\",
                "<<", ">>", ">>>"
            ])
        si

        contains(name: string) -> bool static => _names.contains(name)

        // The distinct class-like types among `function`'s parameters, in
        // parameter order: every type an intrinsic operator is registered on.
        homes(function: Function) -> Classy[] static is
            let result = Collections.LIST[Classy]()

            if !function.arguments? then
                return result
            fi

            for argument in function.arguments do
                if let named: Semantic.Types.NAMED = argument, home: Classy = named.symbol then
                    if !result.contains(home) then
                        result.add(home)
                    fi
                fi
            od

            return result
        si
    si
si
