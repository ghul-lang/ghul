namespace Semantic.Symbols is
    use Types.Type

    // What a generated argument pack thunk does. A thunk stands between
    // the two shapes one pack has - a function of the pack's elements and
    // a function of the tuple they make - for a function value that has
    // one shape going where the other is wanted. It has no source: its
    // body is this description, and is emitted from it.
    //
    // The function it stands for is either `target`, called directly, or
    // the thunk's own first parameter, over which the thunk's delegate is
    // built closed. A pack marked past the function's own type is reached
    // through a chain: a thunk at `depth` above zero calls its function
    // with its parameters and returns the next thunk's delegate, built
    // closed over the result, and the thunk at depth zero is the one that
    // packs or unpacks.
    class PACK_THUNK is
        // Whether the thunk takes the tuple and calls a function of the
        // elements, rather than taking the elements and calling a
        // function of the tuple.
        is_unpack: bool

        // Whether the thunk passes every parameter through as it is:
        // the stand-in for a function that has no method behind it to
        // point a delegate at, such as a built-in operator.
        is_forward: bool

        // How many leading parameters are passed through as they are.
        fixed_count: int

        element_types: Type[]

        // The type the function the thunk stands for is called at.
        callee_type: Type

        // A function the thunk calls by name: one that needs no receiver
        // and no type arguments, so there is nothing to close over.
        target: Function?

        // The type a forwarding thunk constructs, where `target` is a
        // constructor: the thunk's parameters are its arguments, and the
        // instance is what the thunk returns.
        constructed_type: Type?

        // How many returns above the pack this thunk sits.
        depth: int

        // The thunk below this one and the type of the delegate built
        // over it, for a thunk above depth zero.
        inner: Closure?
        inner_presented: Type?

        init(
            is_unpack: bool,
            fixed_count: int,
            element_types: Type[],
            callee_type: Type,
            target: Function?
        ) is
            self.is_unpack = is_unpack
            self.fixed_count = fixed_count
            self.element_types = element_types
            self.callee_type = callee_type
            self.target = target
            self.depth = 0
        si

        // A thunk that calls `target` with its own parameters, in order,
        // and returns what it returns.
        forward(callee_type: Type, target: Function) -> PACK_THUNK static is
            let result = PACK_THUNK(false, 0, Collections.LIST[Type](0), callee_type, target)

            result.is_forward = true

            return result
        si

        // A thunk that constructs `constructed_type` through `target`
        // from its own parameters, in order, and returns the instance.
        construct(callee_type: Type, target: Function, constructed_type: Type) -> PACK_THUNK static is
            let result = forward(callee_type, target)

            result.constructed_type = constructed_type

            return result
        si

        // A thunk above the pack: calls its function with its parameters
        // and hands the result on to `inner`.
        chain(callee_type: Type, depth: int, inner: Closure, inner_presented: Type) -> PACK_THUNK static is
            let result = PACK_THUNK(true, 0, Collections.LIST[Type](0), callee_type, null)

            result.depth = depth
            result.inner = inner
            result.inner_presented = inner_presented

            return result
        si

        // Whether the function the thunk stands for is its first
        // parameter.
        takes_callee: bool => !target?
    si
si
