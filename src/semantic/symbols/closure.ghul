namespace Semantic.Symbols is
    use IO.Std

    use System.Text.StringBuilder

    use IoC
    use Logging
    use Source

    use IR.Values.Value

    use Ghul.Pipes

    class Closure: Function, Types.Typed abstract is
        _is_loading_captures: bool

        // A null element is the `$self` capture: the frame's captured
        // instance has no symbol of its own, and its position in the set
        // fixes its position in the frame constructor's argument list.
        captured_values: Collections.SET[Symbol?]?
        captured_type_arguments: Collections.MAP[Symbol, CAPTURED_TYPE_ARGUMENT]?
        next_type_argument_index: int

        is_self_captured: bool
        is_delegate: bool
        is_anon_func: bool => !frame? /\ !is_delegate

        // The named delegate type this literal was compiled as, when its
        // context expected one. The literal's own type stays the
        // equivalent function type, so inference and the body walk are
        // unaffected; only the constructed delegate differs.
        delegate_target_type: Types.Type? public

        // The parameters a literal written with an argument pack spread
        // out declares in place of the one tuple it is emitted taking, in
        // order, and absent for every other literal. The emitted method
        // takes `pack_group` and unpacks it into a local for each on entry.
        packed_parameters: Collections.List[Variable]? public
        pack_group: LOCAL_ARGUMENT? public

        // Set while this literal's body is being compiled, and emitted,
        // inline in the method that would otherwise have called it through
        // a delegate: the method it is inlined into, the literal's own
        // parameter, and the method local that parameter reads. A fused
        // pipe stage sets it.
        //
        // The closure stays the owner of every symbol, scope and nested
        // literal in its body, so names resolve exactly as they do when it
        // is compiled as a closure, at every nesting depth. What changes is
        // how those symbols load: `parameter` as `local`, a captured outer
        // variable as the method's own local, and neither through a frame,
        // since an inlined literal has none. Every other symbol the
        // closure owns - a local a block in the body declares - loads as
        // it does in any method, which is why the load tests the parameter
        // symbol itself rather than what owns the symbol it is given.
        inlined_into: (method: Function, parameter: Symbol, local: Variable)? public

        is_inlined: bool => inlined_into?

        // The block the inlined body's IL is emitted into, by generate-il's
        // visit of the literal, and which the fused loop emits where it
        // wants the body. Emitting into a block rather than in place is what
        // lets the body be walked at the literal and land in the loop.
        inlined_block: IR.Values.BLOCK? public

        // The body node the block is filled from, and whether it has been.
        inlined_body_node: Syntax.Trees.Expressions.Expression? public
        is_inlined_body_filled: bool public

        // Set for a generated argument pack thunk, which has no literal
        // behind it and whose body is emitted from this.
        pack_thunk: PACK_THUNK? public

        is_packed_parameter(symbol: Symbol) -> bool is
            if let packed = packed_parameters then
                for p in packed do
                    if p == symbol then
                        return true
                    fi
                od
            fi

            return false
        si

        // The type of the delegate this literal constructs, and so of the
        // value its load yields.
        // The target a context pushed may name a placeholder whose origin
        // has since settled; the delegate is constructed at what it
        // settled to.
        constructed_delegate_type: Types.Type =>
            if let target = delegate_target_type then
                if target.contains_inferred then
                    SETTLED_PLACEHOLDER_RESOLVER.instance.resolve(target)
                else
                    target
                fi
            else
                type!
            fi

        could_be_delegate: bool => false

        frame: FRAME?

        short_description: string => description

        describe(context: DESCRIBE_CONTEXT) -> SignaturePart =>
            PARTS.type_ref(type!)

        describe_kind(context: DESCRIBE_CONTEXT) -> string? => "closure"

        symbol_kind: SymbolKind => SymbolKind.FUNCTION
        completion_kind: CompletionKind => CompletionKind.FUNCTION

        qualified_name: string => "[closure]{name}" // FIXME

        is_closure: bool => true

        // The local a nested named function statement declared for this
        // literal. The local is not assigned until that statement
        // completes, so a reference to the name from inside the body -
        // the function calling itself - is served from the recurse field
        // rather than from the local, which is still empty there.
        self_reference_variable: Variable? public
        is_recursive: bool

        init(location: LOCATION, owner: Scope, name: string, enclosing_scope: Scope, is_recursive: bool) is
            super.init(location, location, owner, name, enclosing_scope)

            self.is_recursive = is_recursive
        si

        is_stateless_delegate: bool

        // Set once a cacheable literal that captures nothing has been given an
        // empty frame, so that the delegate it caches targets an instance
        // method. The frame makes the literal look like one that captures, so
        // the decision to cache it is latched here rather than re-derived.
        is_cached_on_frame: bool

        // Set when the delegate's body loads self (its `ldarg.0` target).
        // Such a delegate, e.g. `() => self`, returns a self-dependent
        // result, so it must not be shared across receivers even though it
        // captures no values.
        _delegate_body_loads_self: bool

        delegate_body_loads_self: bool => _delegate_body_loads_self

        note_delegate_body_loads_self() is
            _delegate_body_loads_self = true
        si

        // True only while this closure's own literal body is being walked,
        // so a self-load can be attributed to the body rather than to a
        // separate scope constructing the delegate (binding its target).
        _walking_literal_body: bool

        enter_literal_body() is
            _walking_literal_body = true

            // Each walk of the body answers for itself: a self-load an
            // earlier walk saw - a nested delegate bound to the receiver
            // before it was found capture-free, say - is not one this
            // walk makes.
            _delegate_body_loads_self = false
        si

        leave_literal_body() is
            _walking_literal_body = false
        si

        // A receiver load (`ldarg.0`) is about to be emitted; mark the
        // closure whose body it lands in. That is the innermost closure
        // currently walking its literal body - not necessarily the closure
        // that answered the load: a nested literal's construction site sits
        // in its enclosing literal's body, so binding the nested delegate's
        // target loads the receiver in the enclosing body.
        note_enclosing_body_loads_self() is
            let stack = IoC.CONTAINER.instance.symbol_table.stack
            let index mut = stack.count - 1

            while index >= 0 do
                if let closure: Closure = stack[index] then
                    if closure._walking_literal_body then
                        closure.note_delegate_body_loads_self()
                        return
                    fi
                fi

                index = index - 1
            od
        si

        // A literal written inside one that is being compiled inline
        // captures different symbols than it did when the enclosing
        // literal was a closure: what was the enclosing literal's
        // parameter is a local of the method it is inlined into. The
        // captures an earlier walk recorded name the symbols it read
        // then, and a capture is keyed on the symbol while the frame
        // field it declares is keyed on the name, so keeping both sets
        // leaves the frame with one field and the constructor call with
        // two arguments. Dropping them lets the walk that follows record
        // what the body now reads.
        reset_captures() is
            is_self_captured = false
            captured_values = null
            frame = null
        si

        convert_to_delegate() is
            assert could_be_delegate

            is_stateless_delegate = !captured_values?

            is_self_captured = false
            captured_values = null
            frame = null
            is_delegate = true

            _drop_carried_type_arguments()
        si

        // A frame is a class of its own, so it declares every type
        // parameter the closure's signature names. A delegate's method
        // is emitted on the enclosing class instead and reaches that
        // class's parameters through the receiver, so it must not
        // declare them again - only an enclosing generic method's are
        // left for it to carry.
        _drop_carried_type_arguments() is
            if !captured_type_arguments? then
                return
            fi

            let kept =
                get_sorted_captured_type_argument_symbols()! |>
                    filter(p => !is_type_argument_carried_by_emitting_class(p)) |>
                    collect()

            // The slots that remain number from zero again: the position
            // each installs is its index in the emitted method's own
            // parameter list. Renumbered in place rather than recorded
            // again, because recording goes back through the guard that
            // treats a frozen copy of a parameter as that parameter, and
            // a survivor that is a frozen copy of another survivor would
            // be dropped there instead of renumbered.
            let renumbered = Collections.MAP[Symbol, CAPTURED_TYPE_ARGUMENT]()

            for i in 0..kept.count do
                renumbered.add(kept[i], CAPTURED_TYPE_ARGUMENT(i))
            od

            next_type_argument_index = renumbered.count

            if renumbered.count > 0 then
                captured_type_arguments = renumbered
            else
                captured_type_arguments = null
            fi
        si

        // True when this closure is emitted into the class that declares
        // `parameter`, which then reaches the closure's body through the
        // receiver rather than through a parameter of its own. A trait's
        // parameter never is: the closure is not emitted on the trait.
        is_type_argument_carried_by_emitting_class(parameter: Symbol) -> bool is
            let symbol: Symbol? mut = self

            while symbol? do
                if let classy: Classy = symbol then
                    return !classy.is_trait /\ parameter.owner == classy
                fi

                let enclosing = cast Symbol?(symbol.owner)

                // A namespace is its own owner, so a chain that reaches
                // one without passing a class ends there.
                if enclosing == symbol then
                    return false
                fi

                symbol = enclosing
            od

            return false
        si

        // A stateless, ground function literal whose delegate carries no
        // per-evaluation state, so it can be built once and cached in a
        // static field instead of reallocated on every use. Two shapes
        // qualify, both with no captured type arguments and a fully-settled,
        // ground function type:
        //
        //   - a static or global anonymous function with no captures, cached
        //     on the enclosing namespace's `$globals`;
        //   - an instance-context delegate that captures no values and never
        //     loads self in its body, cached on its enclosing non-generic
        //     class, so the cache retains no receiver instance.
        //
        // Either way the cached delegate targets an empty frame: see
        // _load_cached_on_frame.
        //
        // The settled/ground-type gate excludes literals whose inference
        // never resolved or whose type mentions a type variable (either
        // would produce an invalid cache field). The self-load gate
        // excludes a delegate like `() => self` whose result depends on the
        // receiver even though it captures nothing.
        is_memoizable_delegate: bool is
            if is_cached_on_frame then
                return true
            fi

            if captured_type_arguments? then
                return false
            fi

            let function_type = type

            if !function_type? \/ !function_type.is_settled \/ !_is_ground_type(function_type) then
                return false
            fi

            if is_anon_func then
                return _enclosing_namespace()?
            fi

            if is_delegate /\ is_stateless_delegate /\ !_delegate_body_loads_self then
                // Async literals lower through the state-machine path;
                // their delegate creation is not worth caching (the state
                // machine allocation dominates) and is left untouched.
                if async_state_machine_for(self)? then
                    return false
                fi

                // Any class-like owner, a struct among them. A struct's
                // instance member holds self as a managed pointer, which
                // is not a legal delegate target, so a literal there has
                // to reach this static shape rather than fall through to
                // the receiver-bound one.
                if let owner: Classy = get_il_owner() then
                    return !owner.is_generic
                fi

                return false
            fi

            return false
        si

        _is_ground_type(candidate: Semantic.Types.Type) -> bool is
            let mentions_type_variable mut = false

            candidate.walk((element: Semantic.Types.Type) is
                if element.is_type_variable then
                    mentions_type_variable = true
                fi

                // A plain named reference to a generic type's own symbol -
                // a union variant among these - rather than an
                // instantiation of it names the open generic. It carries no
                // arguments for a type-argument walk to see, and an open
                // generic in a static field signature fails to load. A
                // pack wrapper whose generic callee has not yet had its
                // type arguments bound reaches this shape.
                if
                    isa Semantic.Types.NAMED(element) /\
                    !isa Semantic.Types.GENERIC(element) /\
                    isa Semantic.Symbols.Classy(element.symbol) /\
                    cast Semantic.Symbols.Classy(element.symbol).is_generic
                then
                    mentions_type_variable = true
                fi
            si)

            return !mentions_type_variable
        si

        // Static field caching this literal's delegate. A static/global
        // anonymous function caches on the enclosing namespace's `$globals`
        // class; a stateless instance-context delegate caches on its
        // enclosing class. Built lazily and shared between the load-site
        // reference and the definition emitted by generate-il.
        _delegate_cache_field: Field?

        // True once a load site has referenced the cache field; the field
        // definition is emitted iff this holds, so the definition tracks
        // what the frozen load-site IL actually references.
        has_delegate_cache_field: bool => _delegate_cache_field?

        delegate_cache_field: Field is
            if !_delegate_cache_field? then
                let `field: Field =
                    if is_anon_func then
                        Symbols.GLOBAL_VARIABLE(LOCATION.internal, _enclosing_namespace()!, "{name}$cache")
                    else
                        Symbols.STATIC_FIELD(LOCATION.internal, get_il_owner(), "{name}$cache")
                    fi
                `field.set_type(constructed_delegate_type)
                _delegate_cache_field = `field
            fi

            // Retyped on every access: the closure's own type is
            // rebuilt whenever its return is settled again, and the
            // field created by an earlier walk has to hold what the
            // final walk constructs.
            let `field = _delegate_cache_field!

            `field.set_type(constructed_delegate_type)

            return `field
        si

        // Wrap a delegate-creation value so it is built once and reused.
        // A no-op for literals that aren't memoizable.
        memoize_delegate(value: Value) -> Value is
            if !is_memoizable_delegate then
                return value
            fi

            return IR.Values.MEMOIZED_DELEGATE(
                value, delegate_cache_field, constructed_delegate_type)
        si

        // A cacheable literal that captures nothing: its cached delegate targets
        // one instance of an empty frame, built when the cache is first filled,
        // so the method the delegate calls is an instance method. The JIT does
        // not devirtualise or inline a call through a delegate over a static
        // method.
        _load_cached_on_frame(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            // Fetched before the frame exists: building the frame moves the
            // literal's owner, and the cache stays where it has always been.
            let cache = delegate_cache_field

            is_cached_on_frame = true

            _ensure_frame()

            // Straight to the frame, not through load_closure: a literal already
            // converted to a delegate would be bound to self there.
            let delegate = _load_closure_non_generic(_get_actual_arguments(loader), loader)

            return IR.Values.MEMOIZED_DELEGATE(delegate, cache, constructed_delegate_type)
        si

        // Whether this load is one to route through _load_cached_on_frame.
        _is_cached_on_frame_load: bool =>
            is_cached_on_frame \/ (!frame? /\ !captured_type_arguments? /\ is_memoizable_delegate)

        _enclosing_namespace() -> NAMESPACE? is
            let scope: Scope? mut = owner

            let guard mut = 0
            while scope? /\ guard < 64 do
                if let ns: NAMESPACE = scope then
                    return ns
                fi

                if let ns_scope: Semantic.NAMESPACE_SCOPE = scope then
                    return ns_scope.containing_namespace
                fi

                if let symbol: Symbol = scope then
                    scope = symbol.owner
                else
                    return null
                fi

                guard = guard + 1
            od

            return null
        si

        // The frame and its captured-value set materialise together on
        // first capture.
        _ensure_frame() -> FRAME is
            if !frame? then
                captured_values = Collections.SET[Symbol?]()

                frame = Semantic.Symbols.FRAME(owner!, self)
            fi

            return frame!
        si

        // A captured value's type is what makes the frame generic, and
        // the frame is a class of its own, so every parameter that type
        // names has to be one of its own. Recording it where the
        // capture is made rather than where the frame is built is what
        // lets anything compiled against the frame agree with it: the
        // set is otherwise empty until emission.
        _capture_type_arguments_of(type: Types.Type?) is
            if !type? then
                return
            fi

            type.walk(
                t is
                    if t.is_type_variable then
                        add_type_argument_reference(t.symbol)
                    fi
                si)
        si

        find_or_add_capture(variable: Symbol?) -> Field is
            let frame = _ensure_frame()
            let captured_values = self.captured_values!

            if variable? then
                if !captured_values.contains(variable) then
                    captured_values.add(variable)

                    // `storage_type` is the slot/field type at IL
                    // level — `Ghul.BOX[T]` when the captured
                    // local is boxed, plain `T` otherwise. For
                    // boxed locals the frame holds a reference to
                    // the shared box, so closure and enclosing
                    // scope agree on the cell.
                    let `field_type =
                        if isa Variable(variable) then
                            variable.storage_type
                        else
                            cast Types.Typed?(variable)!.type
                        fi

                    let captured = frame.declare_captured(variable.name, `field_type, IoC.CONTAINER.instance.symbol_definition_locations)

                    captured.captured_symbol = variable

                    _capture_type_arguments_of(`field_type)

                    return captured
                else
                    let existing = frame.get_captured(variable.name)

                    if should_refresh_capture(existing, variable) then
                        // Mirror the boxed/unboxed distinction
                        // from declaration time — see comment in
                        // the declare-new branch above.
                        let refreshed_type =
                            if isa Variable(variable) then
                                variable.storage_type
                            else
                                cast Types.Typed?(variable)!.type
                            fi

                        existing!.set_type(refreshed_type!)

                        _capture_type_arguments_of(refreshed_type)
                    fi

                    return existing!
                fi
            else
                if !is_self_captured then
                    is_self_captured = true

                    captured_values.add(null)

                    return frame.declare_captured("$self", _self_capture_type(), IoC.CONTAINER.instance.symbol_definition_locations)
                else
                    // is_self_captured guarantees a prior declare_captured
                    // populated the "$self" slot.
                    return frame.get_captured("$self")!
                fi
            fi
        si

        // Type of the frame's captured `$self` field. The enclosing
        // instance type comes from the scope stack rather than from the
        // closure's owner, which for a body written in a `partial` or
        // `impl` block is the block's own scope and carries no type.
        _self_capture_type() -> Types.Type? is
            let context = IoC.CONTAINER.instance.symbol_table.current_instance_context ?? cast Classy?(owner)

            if !context? then
                return owner!.type
            fi

            let resolved = Collections.LIST[Symbol]()

            let result = SELF_CAPTURE_TYPE((classy, name) => _own_type_argument(classy, name, resolved)).of(context)

            // Recording is what gives the frame class the parameters the
            // instantiated reference resolves against, so it applies only
            // once every parameter resolved and that reference was built.
            if isa Types.GENERIC(result) then
                for argument in resolved do
                    add_type_argument_reference(argument)
                od
            fi

            return result
        si

        _own_type_argument(context: Classy, name: string, resolved: Collections.LIST[Symbol]) -> Types.Type? is
            let argument = context.find_direct(name)

            if !argument? \/ !argument.type? then
                return null
            fi

            resolved.add(argument)

            return argument.type
        si

        // True iff the captured field's recorded type should be replaced
        // on a re-capture pass. The previous iteration may have captured
        // `source` before its type was IL-emit-stable, leaving the field
        // pinned to an `INFERRED_VARIABLE_TYPE` sentinel or a null slot.
        // Refresh when the source has a usable shape AND the existing
        // field's recorded type is itself still un-settled. Two source-
        // side gates:
        //
        //   - `!is_sentinel` rather than `is_settled` so a composite like
        //     `Function[T,U]` with inner placeholders still promotes the
        //     field from `INFERRED_VARIABLE_TYPE` to `Function[T,U]`,
        //     letting call sites on the captured value see a NAMED
        //     function rather than an opaque sentinel. Inner T/U slots
        //     refine via the next body-retry iteration.
        //
        //   - `is_defined` (for LOCAL_VARIABLE sources) guards against a
        //     `let f = ... f ...` forward self-reference silently
        //     "fixing" itself before the user-visible "cannot emit IL for
        //     function with unresolved return type" diagnostic fires.
        //     Destructured locals set `is_defined` ahead of the inner
        //     closure reference, so they still refresh correctly.
        //
        // A settled field over an unsettled source is refreshed too. Within
        // one build a local keeps its placeholder until it settles, so that
        // pairing only arises when the file's expressions are walked again
        // against a retained closure: the field still holds what the
        // previous walk settled, and binding the body against it would hide
        // the body's uses from the placeholder the new walk is inferring.
        should_refresh_capture(existing: Field?, source: Symbol?) -> bool static is
            if !existing? \/ !source? then
                return false
            fi

            let source_type = source.type

            if !source_type? \/ source_type.is_sentinel then
                return false
            fi

            let local = cast LOCAL_VARIABLE?(source)
            if local? /\ !local.is_defined then
                return false
            fi

            let existing_type = existing.type

            return !existing_type? \/ !existing_type.is_settled \/ !source_type.is_settled
        si

        find_or_add_recurse() -> Field is
            let frame = _ensure_frame()

            let recurse = frame.find_member("$recurse")

            if recurse? then
                return cast Field?(recurse)!
            else
                return frame.declare_recurse(IoC.CONTAINER.instance.symbol_definition_locations)
            fi
        si

        find_or_add_capture_self() -> Field => find_or_add_capture(null)

        outer_recurse_field_name(outer: Closure) -> string =>
            "$outer_recurse_{outer.name}"

        // Captures the recurse-target of an outer recursive ancestor
        // so `rec` can be used from a nested non-recursive lambda.
        // The captured Symbol stored in `captured_values` is the
        // outer Closure itself, used as a sentinel by
        // `_get_actual_arguments` to dispatch to the outer-recurse
        // codepath. Declaration order in `captured_values` mirrors
        // declaration order in the frame, so the constructor-arg
        // ordering stays in step with the frame-field ordering.
        find_or_add_captured_outer_recurse(outer: Closure) -> Field is
            assert outer != self else "cannot capture self as outer recurse"

            let frame = _ensure_frame()
            let captured_values = self.captured_values!

            let field_name = outer_recurse_field_name(outer)
            let existing = frame.find_member(field_name)

            if existing? then
                let `field = cast Field?(existing)!

                // Always refresh from outer.type when non-error.
                // outer.type is rebuilt by Function.set_return_type
                // each iteration so a stale field would miss any
                // widening (arg slot CONS[int] → List[int] from rec
                // match propagation) or any return-slot resolution (INFERRED
                // → string). Type-level `matches` returns true whenever
                // one side is INFERRED, so it can't distinguish
                // "still placeholder" from "now concrete".
                // Refreshing unconditionally is safe: gen_type on
                // placeholders emits a comment (per
                // INFERRED_VARIABLE_TYPE / INFERRED_RETURN_TYPE
                // overrides) and the next iter's freeze produces a
                // cleaner RAW.
                let outer_type = outer.type

                if outer_type? /\ !outer_type.is_error then
                    `field.set_type(outer_type)
                fi

                return `field
            fi

            captured_values.add(outer)

            return frame.declare_captured(field_name, outer.type, IoC.CONTAINER.instance.symbol_definition_locations)
        si

        load_captured_outer_recurse(location: LOCATION, outer: Closure, loader: SYMBOL_LOADER) -> Value is
            let `field = find_or_add_captured_outer_recurse(outer)

            return loader.load_instance_variable(LOCATION.internal, _capture_frame_self_load(), `field)
        si

        // Called from the enclosing closure's _get_actual_arguments to
        // produce the value to pass for an inner frame's
        // $outer_recurse_<outer> capture. If we are outer directly,
        // load $recurse from our own frame; otherwise we must have
        // captured outer's recurse ourselves (the chain-establish loop
        // in visit(RECURSE) guarantees it).
        load_outer_recurse_value(outer: Closure, location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            if self == outer then
                return load_recurse(location, loader)
            fi

            // the chain-establish loop captured outer's recurse here,
            // so the frame exists
            let frame = self.frame!

            let field_name = outer_recurse_field_name(outer)
            let `field = cast Field?(frame.find_member(field_name))

            assert `field? else "outer recurse field {field_name} not found on intermediate closure {name}"

            return loader.load_instance_variable(LOCATION.internal, _capture_frame_self_load(), `field)
        si

        // Walks the live scope stack to find the closure that
        // lexically encloses self — i.e. the closure into whose body
        // the IR currently being built will be inserted. `current_function`
        // is no good here: when this runs, self is still on the stack so
        // `current_function` returns self.
        _find_enclosing_closure() -> Closure? is
            let stack = IoC.CONTAINER.instance.symbol_table.stack
            let i mut = stack.count - 1
            let seen_self mut = false

            while i >= 0 do
                let scope = stack[i]

                if seen_self /\ isa Closure(scope) then
                    return scope
                fi

                if scope == self then
                    seen_self = true
                fi

                i = i - 1
            od
            return null
        si

        type_updated(type: Semantic.Types.Type) is
            if let self.frame? /\ is_recursive then
                frame.try_update_recurse_type(type)
            fi
        si

        add_type_argument_reference(type: Symbol) is
            // A type variable is emitted as an index into the type
            // parameters of whatever declares it, and a block scope
            // declares none: one owned by a block scope has no index to
            // be written as. Such a variable reaches here from a formal
            // resolved against a scope of its own, and recording it makes
            // the frame generic in a parameter nothing binds, so the
            // reference comes out against the enclosing method's
            // parameters, which are not there, and the assembly will not
            // load.
            if isa BLOCK_SCOPE(type.owner) then
                return
            fi

            if !captured_type_arguments? then
                captured_type_arguments = Collections.MAP[Symbol,CAPTURED_TYPE_ARGUMENT]()
            fi

            let captures = captured_type_arguments!

            if captures.contains_key(type) then
                return
            fi

            // One frame slot per parameter, not per symbol standing for
            // one. A captured type can arrive as the parameter's own
            // symbol or as a frozen copy of it, and those are different
            // objects; giving each a slot would number one parameter
            // twice, and the position each slot installs is held against
            // the parameter, so the second would overwrite the first and
            // leave one of the two frame indices unreachable.
            if _is_captured_parameter(captures, type) then
                return
            fi

            captures.add(type, CAPTURED_TYPE_ARGUMENT(next_type_argument_index))
            next_type_argument_index = next_type_argument_index + 1
        si

        _is_captured_parameter(
            captures: Collections.MAP[Symbol,CAPTURED_TYPE_ARGUMENT],
            type: Symbol
        ) -> bool is
            let argument = cast GenericArgument?(type)

            if !argument? then
                return false
            fi

            let key = TYPE_PARAMETER_KEY.of(argument)

            for captured in captures.keys do
                if let captured_argument: GenericArgument = captured then
                    if TYPE_PARAMETER_KEY.of(captured_argument) =~ key then
                        return true
                    fi
                fi
            od

            return false
        si

        set_type_arguments() is
            if !captured_type_arguments? then
                // not needed
                return
            fi

            if let self.frame? then
                frame.set_type_arguments(get_sorted_captured_type_argument_symbols()!)
                return
            fi

            if generic_arguments.count > 0 then
                // already done
                return
            fi

            let args = get_sorted_captured_type_argument_symbols()!

            generic_arguments = args |> map(a => a.type!) |> collect()
            generic_argument_names = args |> map(a => a.name) |> collect()
        si

        get_sorted_captured_type_argument_symbols() -> Collections.List[Symbol]? =>
            if captured_type_arguments? then
                captured_type_arguments |> sort((a, b) => a.value.index - b.value.index) |> map(p => p.key) |> collect()
            else
                null
            fi

        get_sorted_captured_type_argument_types() -> Collections.List[Types.Type]? =>
            if captured_type_arguments? then
                captured_type_arguments |> sort((a, b) => a.value.index - b.value.index) |> map(p => p.key.type!) |> collect()
            else
                null
            fi

        get_type_arguments_as_specialize_map() -> Collections.Map[Symbol,Types.Type]? =>
            if captured_type_arguments? then
                Collections.MAP[Symbol,Types.Type](
                    // filter ensures key.type and key.type.freeze() are non-null
                    captured_type_arguments.keys
                        |> filter(key => let kt = key.type in kt? /\ kt.freeze()?) |>
                        map(key => Collections.KeyValuePair[Symbol,Types.Type](key, key.type!.freeze()!))
                )
            else
                null
            fi

        // Saved emitted positions per captured type-arg symbol, set on
        // entry to map_type_arguments and reinstated by
        // unmap_type_arguments. Without this save and restore, an outer
        // override (e.g. the enclosing generator's
        // install_body_emission_overrides) would be clobbered by the
        // closure's nullout in unmap and any later freeze of the
        // outer's IR would emit the wrong type-arg index.
        //
        // It is a stack because the same closure's bracket nests inside
        // itself: emitting a signature within a body already bracketed
        // for that closure enters it a second time. With one slot per
        // symbol the inner entry saves the closure's own position over
        // the outer entry's saved value, and the matching pair of unmaps
        // then clears the position instead of reinstating what was
        // installed before the outermost entry.
        _saved_emitted_positions: Collections.MAP[Symbol, Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?]]?

        map_type_arguments() is
            if !captured_type_arguments? then
                return
            fi

            let saved =
                _saved_emitted_positions ??
                Collections.MAP[Symbol, Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?]]()

            _saved_emitted_positions = saved

            for symbol_cta in captured_type_arguments! do
                let symbol = symbol_cta.key
                let cta = symbol_cta.value

                let prior_positions: Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?] mut

                if !saved.try_get_value(symbol, prior_positions ref) then
                    prior_positions = Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?]()
                    saved[symbol] = prior_positions
                fi

                prior_positions.add(symbol.current_emitted_position)

                // A closure with a frame reaches the argument as one of
                // the frame class's own; without one it stays on the
                // method. Which it is can still change after this point,
                // so the answer is deferred rather than decided here.
                symbol.set_emitted_position(
                    () => TYPE_PARAMETER_POSITION(frame?, cta.index))
            od
        si

        unmap_type_arguments() is
            if !captured_type_arguments? then
                return
            fi

            let saved = _saved_emitted_positions

            for symbol_cta in captured_type_arguments do
                let symbol = symbol_cta.key

                let prior_positions: Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?] mut

                if
                    saved? /\
                    saved.try_get_value(symbol, prior_positions ref) /\
                    prior_positions.count > 0
                then
                    let last = prior_positions.count - 1

                    symbol.set_emitted_position(prior_positions[last])
                    prior_positions.remove_at(last)
                else
                    symbol.set_emitted_position(null)
                fi
            od
        si

        load(location: LOCATION, loader: SYMBOL_LOADER) -> Value => throw System.NotImplementedException("abstract")
        load_closure(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            try
                return _load_closure(location, loader)
            catch e: System.Exception
                IoC.CONTAINER.instance.logger.exception(location, e, "exception loading closure")

                return IR.Values.DUMMY(Types.ERROR(), location)
            yrt
        si

        _get_actual_arguments(loader: SYMBOL_LOADER) -> Collections.LIST[Value] is
            let actual_arguments = Collections.LIST[Value]()

            let capture_type_argument = (t: Types.Type) is
                if t.is_type_variable then
                    add_type_argument_reference(t.symbol)
                fi
            si

            let enclosing: Closure? mut = null

            for c in captured_values! do
                if !c? then
                    // The "captured self" passed to the closure's
                    // frame constructor. Same construction-site
                    // distinction as `_load_delegate`: inside a
                    // generator's MoveNext, route through the state-
                    // machine frame's `_outer_self` so the frame ctor
                    // receives the user's instance and not the state
                    // machine.
                    let context = IoC.CONTAINER.instance.symbol_table.current_instance_context
                    let outer_self: Value? mut = null
                    if context? then
                        outer_self = _try_load_self_for_construction_via_outer_self(context)
                    fi
                    if !outer_self? then
                        outer_self = loader.load_outer_self(location)
                    fi

                    actual_arguments.add(outer_self)

                    // Guard: a forward-reference capture (e.g.
                    // mutual recursion between two let-bound
                    // lambdas) leaves the capture's type null
                    // during the first walk. Skipping the type-var
                    // discovery here is correct — the outer
                    // function's body retry will re-walk the
                    // closure with the resolved type. NRE-ing here
                    // would mask the underlying "variable is not
                    // defined here" diagnostic.
                    if outer_self.type? then
                        outer_self.type.walk(capture_type_argument)
                    fi
                elif isa Closure(c) then
                    let outer = c

                    if !enclosing? then
                        enclosing = _find_enclosing_closure()
                    fi

                    let value = enclosing!.load_outer_recurse_value(outer, location, loader)

                    actual_arguments.add(value)

                    if value.type? then
                        value.type.walk(capture_type_argument)
                    fi
                else
                    let outer_captured_value =
                        c.load_outer(
                            location,
                            null,
                            loader
                        )

                    actual_arguments.add(outer_captured_value)

                    if outer_captured_value.type? then
                        outer_captured_value.type.walk(capture_type_argument)
                    fi
                fi
            od

            return actual_arguments
        si

        // A closure emitted on the enclosing class reaches that class's
        // type parameters as `!N` through the instance, which is why
        // RECORD_TYPE_ARGUMENT_USES leaves them uncaptured. A closure
        // with captured values is emitted on a frame instead, and the
        // frame is a class of its own with no parameters of the
        // enclosing one, so whatever its signature names it must carry.
        // Whether there is a frame is not known when that pass runs.
        capture_signature_type_arguments() is
            let capture = (t: Types.Type) is
                if t.is_type_variable then
                    add_type_argument_reference(t.symbol)
                fi
            si

            for argument in arguments do
                argument.walk(capture)
            od

            if let self.return_type? then
                return_type.walk(capture)
            fi
        si

        _load_closure(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            let closure_type = type

            if !closure_type? then
                return IR.Values.DUMMY(Types.ERROR(), LOCATION.internal)
            fi

            if closure_type.is_error then
                return IR.Values.DUMMY(closure_type, LOCATION.internal)
            fi

            if is_delegate then
                return loader.load_instance_anonymous_function(self, constructed_delegate_type)
            fi

            let actual_arguments = _get_actual_arguments(loader)

            capture_signature_type_arguments()

            if captured_type_arguments? then
                return _load_closure_generic(actual_arguments, loader)
            else
                return _load_closure_non_generic(actual_arguments, loader)
            fi
        si

        _load_closure_generic(actual_arguments: Collections.LIST[Value], loader: SYMBOL_LOADER) -> Value is
            // See _load_closure_non_generic for the failed-speculation
            // try-catch rationale.
            try
                return _load_closure_generic_body(actual_arguments, loader)
            catch ex: System.Exception
                IoC.CONTAINER.instance.logger.mark_consumed_any()
                return IR.Values.DUMMY(self.type!, location)
            yrt
        si

        _load_closure_generic_body(actual_arguments: Collections.LIST[Value], loader: SYMBOL_LOADER) -> Value is
            let frame = self.frame!

            let block = IR.Values.BLOCK(constructed_delegate_type)

            owner = frame

            set_type_arguments()

            // we want these type arguments to remain in the current context.
            // Frozen forms are filtered for non-null so we hand a real
            // List[Type] to get_create_instance — a captured generic with
            // no resolved freeze would point at an unresolved slot.
            let frozen_argument_types = get_sorted_captured_type_argument_types()!
                |> map(t => t.freeze()) |>
                  filter(f => f?) |>
                  map(f => f!) |>
                  collect()

            // but the formal arguments of the frame class constructor need to be in the frame's context
            map_type_arguments()
            let frame_instance = frame.get_create_instance(actual_arguments, frozen_argument_types)
            unmap_type_arguments()

            let frame_instance_copier = frame_instance!.get_temp_copier(block, "frame-instance")

            owner = frame_instance.type!.symbol

            map_type_arguments()
            unmap_type_arguments()

            let result = IR.Values.MAKE_CLOSURE(constructed_delegate_type, self, frame_instance_copier())

            let result_copier = result.get_temp_copier(block, "closure")

            let rec_member_symbol = owner!.find_member("$recurse")

            if rec_member_symbol? /\ !frame_instance.type!.is_error then
                let ff = frame_instance_copier()
                let rr = result_copier()
                map_type_arguments()
                block.add(rec_member_symbol.store(location, ff, rr, loader, true))
                unmap_type_arguments()
            fi

            block.add(result_copier())
            block.close()
            return block
        si

        _load_closure_non_generic(actual_arguments: Collections.LIST[Value], loader: SYMBOL_LOADER) -> Value is
            // Bail early when any captured value has an error or
            // unresolved type. Trying to construct the frame
            // instance with ERROR-typed captures cascades into IL
            // gen_type throws further down the path.
            for a in actual_arguments do
                if !a.type? \/ a.type.is_error then
                    return IR.Values.DUMMY(Types.ERROR(), location)
                fi
            od

            // The iterative-inference body-retry loop may reach
            // closure loading during an early iter where the FRAME's
            // declare_constructor defensive-defaulted a not-yet-typed
            // field to Types.ERROR — gen_type throws on that.
            // Treat the exception as failed speculation: return a
            // DUMMY of the closure's own type so downstream paths
            // see a placeholder closure rather than a poison value,
            // and mark_consumed_any so the body-retry loop iterates
            // again from improved types.
            try
                return _load_closure_non_generic_body(actual_arguments, loader)
            catch ex: System.Exception
                IoC.CONTAINER.instance.logger.mark_consumed_any()
                return IR.Values.DUMMY(self.type!, location)
            yrt
        si

        _load_closure_non_generic_body(actual_arguments: Collections.LIST[Value], loader: SYMBOL_LOADER) -> Value is
            let frame = self.frame!

            let block = IR.Values.BLOCK(constructed_delegate_type)

            owner = frame

            let frame_instance = frame.get_create_instance(actual_arguments, null)
            let frame_instance_copier = frame_instance!.get_temp_copier(block, "frame-instance")

            owner = frame_instance.type!.symbol

            let result = IR.Values.MAKE_CLOSURE(constructed_delegate_type, self, frame_instance_copier())

            let result_copier = result.get_temp_copier(block, "closure")

            let rec_member_symbol = frame.find_member("$recurse")

            if rec_member_symbol? /\ !frame_instance.type!.is_error then
                block.add(rec_member_symbol.store(location, frame_instance_copier(), result_copier(), loader, true))
            fi

            block.add(result_copier())
            block.close()
            return block
        si

        // The delegate of a closure that takes no frame, built closed over
        // `target` as its first argument: the method is static and the
        // delegate's call shape is the method's less that parameter, which
        // is the shape the runtime allows for a reference first argument.
        // Built afresh at each use, since the target is a value.
        load_closed_over(location: LOCATION, target: Value, delegate_type: Types.Type) -> Value is
            if captured_type_arguments? then
                set_type_arguments()

                let args_map = get_type_arguments_as_specialize_map()!

                map_type_arguments()

                let specialized = specialize_function(args_map, null)
                let delegate = IR.Values.MAKE_CLOSURE(delegate_type, specialized, target)

                unmap_type_arguments()

                return delegate
            fi

            return IR.Values.MAKE_CLOSURE(delegate_type, self, target)
        si

        _load_lambda() -> Value is
            let closure_type = type

            if !closure_type? then
                return IR.Values.DUMMY(Types.ERROR(), LOCATION.internal)
            fi

            if closure_type.is_error then
                return IR.Values.DUMMY(closure_type, LOCATION.internal)
            fi

            if captured_type_arguments? then
                return _load_lambda_generic()
            else
                return _load_lambda_non_generic()
            fi
        si

        _load_lambda_generic() -> Value is
            set_type_arguments()

            // Generic lambdas always capture type arguments, so the
            // specialize map is present on this path.
            let args_map = get_type_arguments_as_specialize_map()!

            map_type_arguments()

            let specialized_lambda = specialize_function(args_map, null)

            let delegate = IR.Values.MAKE_CLOSURE(delegate_target_type ?? specialized_lambda.type!, specialized_lambda, IR.Values.NULL(Types.NULL()))

            unmap_type_arguments()

            return delegate
        si

        _load_lambda_non_generic() -> Value is
            let delegate = IR.Values.MAKE_CLOSURE(constructed_delegate_type, self, IR.Values.NULL(Types.NULL()))

            return memoize_delegate(delegate)
        si

        _load_delegate(loader: SYMBOL_LOADER) -> Value is
            let closure_type = type

            if !closure_type? then
                return IR.Values.DUMMY(Types.ERROR(), LOCATION.internal)
            fi

            if closure_type.is_error then
                return IR.Values.DUMMY(closure_type, LOCATION.internal)
            fi

            // A delegate is converted from a literal that captured no
            // type arguments, but the walk that follows the conversion
            // can still settle a parameter type naming one. Such a
            // delegate is emitted as a generic method and reached
            // through an instantiation, as a frameless literal is.
            if captured_type_arguments? then
                return _load_delegate_generic(loader)
            fi

            return IR.Values.MAKE_CLOSURE(constructed_delegate_type, self, _load_delegate_target(loader))
        si

        // Delegate target: the receiver the runtime binds to the
        // delegate. Inside a generator's MoveNext, `ldarg.0` is
        // the state machine, so a plain `loader.load_self` would
        // bind the delegate to it rather than the user's
        // instance. Route through the state-machine frame's
        // `_outer_self` field at construction-time when there's
        // an enclosing generator; otherwise fall back to the
        // ordinary load_self path.
        _load_delegate_target(loader: SYMBOL_LOADER) -> Value is
            let context = IoC.CONTAINER.instance.symbol_table.current_instance_context
            let self_pointer: Value? mut = null
            if context? then
                self_pointer = _try_load_self_for_construction_via_outer_self(context)
            fi
            if !self_pointer? then
                self_pointer = loader.load_self(LOCATION.internal)
            fi

            // Binding the target loads the receiver at the construction
            // site, which sits in the enclosing literal's body when this
            // delegate is nested inside another literal.
            note_enclosing_body_loads_self()

            return self_pointer
        si

        // The delegate's own method carries the type parameters its
        // signature names, and the construction site reaches it through
        // an instantiation of them. Mirrors the frameless literal path;
        // a generic delegate is never memoised, since the cache field
        // would have to be one per instantiation.
        _load_delegate_generic(loader: SYMBOL_LOADER) -> Value is
            let self_pointer = _load_delegate_target(loader)

            set_type_arguments()

            let args_map = get_type_arguments_as_specialize_map()!

            map_type_arguments()

            let specialized = specialize_function(args_map, null)

            let delegate =
                IR.Values.MAKE_CLOSURE(
                    delegate_target_type ?? specialized.type!,
                    specialized,
                    self_pointer
                )

            unmap_type_arguments()

            return delegate
        si

        load_outer_self(location: Source.LOCATION, loader: SYMBOL_LOADER) -> Value? is
            let symbol_table = IoC.CONTAINER.instance.symbol_table
            let context = symbol_table.current_instance_context

            if is_delegate then
                note_enclosing_body_loads_self()

                return IR.Values.Load.REFERENCE_SELF(context!, context.type)
            fi

            let is_captured = false

            let stack = symbol_table.stack

            let index mut = stack.count - 1
            let seen_self mut = false

            while index >= 0 do
                let scope = stack[index]

                if scope.is_namespace then
                    break
                fi

                if seen_self /\ scope.is_capture_context then
                    if scope.is_closure then
                        let c = cast Closure?(scope)!

                        // FIXME: may not be needed - load_self() should capture self:
                        c.find_or_add_capture_self()

                        return c.load_self(location, loader)
                    fi
                fi

                if scope == self then
                    seen_self = true
                fi

                index = index - 1
            od

            if !is_captured then
                // load self normally:
                return IR.Values.Load.REFERENCE_SELF(context!, context.type)
            fi
            return null
        si

        load_self(location: Source.LOCATION, loader: SYMBOL_LOADER) -> Value is
            if is_delegate then
                let context = IoC.CONTAINER.instance.symbol_table.current_instance_context!

                note_enclosing_body_loads_self()

                // A delegate is emitted as a method on the enclosing type,
                // so its receiver is normally `ldarg.0`. For an async
                // literal the body lives in the state machine's MoveNext,
                // where `ldarg.0` is the state machine — the receiver is
                // reached through its `$outer_self` field instead. Only the
                // body is inside MoveNext: the load that binds the
                // delegate's target sits in the enclosing method, where
                // `ldarg.0` is the receiver as usual.
                if _walking_literal_body then
                    if let redirected = _state_machine_outer_self_load(context) then
                        return redirected
                    fi
                fi

                return IR.Values.Load.REFERENCE_SELF(context, context.type)
            fi

            let `field = find_or_add_capture_self()

            return loader.load_instance_variable(location, _capture_frame_self_load(), `field)
        si

        // At a closure-construction emission site that ends up inside
        // an enclosing function's MoveNext, `ldarg.0` refers to that
        // function's state machine — so the closure's delegate target
        // / captured-self value can't be loaded via REFERENCE_SELF
        // (which would emit `ldarg.0` of the state machine). Instead
        // load through the state-machine frame's `_outer_self` field,
        // which the outer method populates with the user's instance at
        // .ctor time.
        //
        // Walks outward from this closure to find the closest
        // enclosing Function. If that function compiles into a state
        // machine whose frame carries `_outer_self`, returns the
        // matching `OUTER_SELF` IR Value; otherwise returns null and
        // the caller falls back to a plain REFERENCE_SELF.
        //
        // Called only at construction sites (`_load_delegate`,
        // `_get_actual_arguments`), which is what makes the *enclosing*
        // function's state machine the right one to look for. A
        // self-load in the closure's own body wants its own state
        // machine instead, and `load_self` handles that separately off
        // `_walking_literal_body`.
        _try_load_self_for_construction_via_outer_self(context: Symbol) -> Value? is
            let stack = IoC.CONTAINER.instance.symbol_table.stack
            let index mut = stack.count - 1

            while index >= 0 do
                let scope = stack[index]

                if scope == self then
                    index = index - 1
                    continue
                fi

                if let function: Function = scope then
                    if let outer_self_field = _enclosing_state_machine_outer_self_field(function) then
                        return IR.Values.Load.OUTER_SELF(context, context.type, outer_self_field)
                    fi

                    return null
                fi

                index = index - 1
            od

            return null
        si

        // The `$outer_self` field of whichever state machine `function`
        // compiles into — generator or async. Null when it compiles into
        // neither, or when the frame carries no outer self (statics and
        // globals have none). declare() materialises the field; it is lazy
        // and idempotent, and required because the frame property only
        // constructs the bare FRAME object.
        _enclosing_state_machine_outer_self_field(function: Function) -> Field? is
            if let sm = state_machine_for(function) then
                if let frame = sm.frame then
                    frame.declare()

                    return frame.outer_self_field
                fi
            elif let async_sm = async_state_machine_for(function) then
                if let frame = async_sm.frame then
                    frame.declare()

                    return frame.outer_self_field
                fi
            fi

            return null
        si

        load_outer_captured_value(location: LOCATION, symbol: Variable, loader: SYMBOL_LOADER) -> Value? is
            let is_captured = false

            let stack = IoC.CONTAINER.instance.symbol_table.stack

            let index mut = stack.count - 1
            let seen_self mut = false

            while index >= 0 do
                let scope = stack[index]

                if seen_self /\ scope.is_capture_context then
                    if symbol.owner == scope then
                        // FIXME: use the symbol loader
                        if isa LOCAL_ARGUMENT(symbol) then
                            return IR.Values.Load.LOCAL_ARGUMENT(symbol)
                        else
                            return IR.Values.Load.LOCAL_VARIABLE(symbol)
                        fi
                    elif scope.is_closure then
                        let c = cast Closure?(scope)!

                        // A literal compiled inline has no frame to relay
                        // the value through, so the walk continues past it
                        // to whatever encloses it. Capturing into it would
                        // record a field on a frame nothing constructs.
                        if !c.is_inlined then
                            // FIXME: probably redundant
                            c.find_or_add_capture(symbol)

                            c.load_captured_value(location, symbol, loader)

                            let result = c.load_captured_value(location, symbol, loader)

                            return result
                        fi
                    fi
                fi

                if scope == self then
                    seen_self = true
                fi

                index = index - 1
            od
            return null
        si

        load_recurse(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            let recurse = find_or_add_recurse()

            return recurse.load(location, _capture_frame_self_load(), loader)
        si

        // Closure-body store into an outer-scope captured local.
        // Only legal when the captured local is boxed — outer
        // scope and closure share a heap cell, so writing via
        // `.value` on the captured box updates the cell visible
        // to the outer scope. Unboxed captures are still
        // rejected upstream by the symbol-loader diagnostic.
        store_captured_value(location: LOCATION, symbol: Variable, value: Value, loader: SYMBOL_LOADER) -> Value is
            symbol.is_captured = true

            let `field = find_or_add_capture(symbol)

            let frame_field_load =
                loader.load_instance_variable(LOCATION.internal, _capture_frame_self_load(), `field)

            if symbol.is_boxed then
                let value_member = loader.resolve_box_value_member(symbol)

                if value_member? then
                    return value_member.store(LOCATION.internal, frame_field_load, value, loader, false)
                fi
            fi

            // Fall back to a frame-field store for the unboxed
            // case — should not be reached in practice because
            // the upstream diagnostic blocks unboxed captured
            // assignment, but the defensive path keeps us out of
            // NRE territory if it ever does.
            return loader.store_instance_variable(LOCATION.internal, _capture_frame_self_load(), `field, value)
        si

        // A `T ref` parameter's slot lives on the enclosing method's
        // stack and dies when it returns, so a frame field cannot hold
        // it: the emitted ctor would store the byref through a raw
        // pointer whose pointee is gone by the time the closure runs.
        captures_reference(symbol: Variable) -> bool static is
            if let symbol_type = symbol.type then
                return isa Types.REFERENCE(symbol_type)
            fi

            return false
        si

        load_captured_value(location: LOCATION, symbol: Variable, loader: SYMBOL_LOADER) -> Value is
            if captures_reference(symbol) then
                IoC.CONTAINER.instance.logger.error(
                    location,
                    "a function literal cannot capture a ref parameter, copy the value into a local variable first")
            fi

            // Capture-before-define is detected by LOCAL_VARIABLE.load
            // (`variable.ghul`) via its own check_is_defined call;
            // duplicating the check here fired the same diagnostic
            // twice for the captured-load path. The capture field is
            // built with whatever type the variable has at this
            // point (often null/ERROR), which without the upstream
            // check would crash Type.gen_type at IL emission — but
            // the upstream check is the only place we need.
            symbol.is_captured = true

            let `field = find_or_add_capture(symbol)

            // Returns the raw frame field — for boxed captures
            // this is the BOX[T] reference. The user-code-side
            // unwrap to `.value` happens in
            // `SYMBOL_LOADER.load_local_variable` after this
            // returns, so that inter-frame capture transfers
            // (via `load_outer_captured_value`) keep passing the
            // box reference between frames untouched.
            return loader.load_instance_variable(LOCATION.internal, _capture_frame_self_load(), `field)
        si

        // Load the captures-frame `this` for capture access. Normally
        // REFERENCE_SELF (`ldarg.0` of the frame's type). For an
        // ASYNC_CLOSURE compiled down the state-machine path, the
        // body lives in the SM's MoveNext where `ldarg.0` is the SM
        // instance — the captures-frame is reached via the SM's
        // `_outer_self` field. Mirror of INSTANCE_ASYNC_METHOD's
        // load_self.
        _capture_frame_self_load() -> Value is
            let frame = self.frame!

            return _state_machine_outer_self_load(frame) ?? IR.Values.Load.REFERENCE_SELF(frame, frame.type)
        si

        // The `$outer_self` load that stands in for `ldarg.0` inside this
        // literal's own MoveNext, where `ldarg.0` is the state machine
        // rather than whatever the body means by self. `context` is the
        // symbol the loaded value is typed against — the captures frame
        // for a framed literal, the enclosing instance for a delegate.
        // Null when this literal does not compile into a state machine,
        // leaving the caller to emit an ordinary self reference.
        //
        // That is an async literal or a generator literal: either one's
        // body is inside its own MoveNext.
        _state_machine_outer_self_load(context: Symbol) -> Value? is
            if let outer_self_field = _enclosing_state_machine_outer_self_field(self) then
                return IR.Values.Load.OUTER_SELF(context, context.type, outer_self_field)
            fi

            return null
        si

        get_il_owner() -> Scope is
            if frame? \/ is_delegate then
                return owner!
            fi

            let temp_owner = owner

            let classy_owner = cast Classy?(owner)

            if classy_owner? /\ classy_owner.owner? then
                return classy_owner.owner
            fi

            // owner may be incorrect
            debug_always("suspect closure owner: {owner}")

            return owner!
        si

        // Whether the method emitted for this closure takes a receiver,
        // which is not the same question as `is_instance`: a closure is
        // not an instance member of anything the language can see, while
        // the method emitted for one whose captures live on a frame does
        // take that frame, and reaches the captures through it.
        //
        // Its flags and its calling convention both turn on this, and
        // they have to agree.
        is_emitted_with_receiver: bool => !is_anon_func

        to_string() -> string => "[closure {name}]"
    si

    // FIXME: pull common code across these Closure subclasses up
    // into Closure
    class INSTANCE_CLOSURE: Closure is
        is_instance: bool => true

        could_be_delegate: bool =>
            let captured_values = self.captured_values in
            !captured_values? \/ (is_self_captured /\ captured_values.count == 1) /\ !is_recursive /\ _can_carry_captured_type_arguments

        // A delegate's method is emitted on the enclosing class, which
        // supplies that class's own type parameters and nothing else, so
        // the only ones the method can declare for itself are an
        // enclosing generic method's. A trait's parameter is neither -
        // the method is not emitted on the trait - so a literal that
        // captured one keeps its frame, which declares every parameter
        // its signature names.
        _can_carry_captured_type_arguments: bool is
            let captures = captured_type_arguments

            if !captures? then
                return true
            fi

            for parameter in captures.keys do
                if
                    !isa FUNCTION_GENERIC_ARGUMENT(parameter) /\
                    !is_type_argument_carried_by_emitting_class(parameter)
                then
                    return false
                fi
            od

            return true
        si

        init(location: LOCATION, owner: Scope, name: string, enclosing_scope: Scope, is_recursive: bool) is
            super.init(location, owner, name, enclosing_scope, is_recursive)
        si

        declare_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.INSTANCE_CLOSURE(location, owner, name, enclosing, is_recursive))

        declare_async_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.INSTANCE_ASYNC_CLOSURE(location, owner, name, enclosing, is_recursive))

        declare_generator_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.INSTANCE_GENERATOR_CLOSURE(location, owner, name, enclosing, is_recursive))

        load(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            if _is_cached_on_frame_load then
                return _load_cached_on_frame(location, loader)
            fi

            if frame? then
                return super.load_closure(location, loader)
            fi

            if is_delegate then
                return _load_delegate(loader)
            fi

            return _load_lambda()
        si

        to_string() -> string => "[instance closure {name}]"
    si

    class STATIC_CLOSURE: Closure is
        init(location: LOCATION, owner: Scope, name: string, enclosing_scope: Scope, is_recursive: bool) is
            super.init(location, owner, name, enclosing_scope, is_recursive)
        si

        declare_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.STATIC_CLOSURE(location, owner, name, enclosing, is_recursive))

        declare_async_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.STATIC_ASYNC_CLOSURE(location, owner, name, enclosing, is_recursive))

        declare_generator_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.STATIC_GENERATOR_CLOSURE(location, owner, name, enclosing, is_recursive))

        load(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            if _is_cached_on_frame_load then
                return _load_cached_on_frame(location, loader)
            fi

            if frame? then
                return super.load_closure(location, loader)
            fi

            return _load_lambda()
        si

        to_string() -> string => "[static closure {name}]"
    si

    class GLOBAL_CLOSURE: Closure is
        init(location: LOCATION, owner: Scope, name: string, enclosing_scope: Scope, is_recursive: bool) is
            super.init(location, owner, name, enclosing_scope, is_recursive)
        si

        declare_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.GLOBAL_CLOSURE(location, owner, name, enclosing, is_recursive))

        declare_async_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.GLOBAL_ASYNC_CLOSURE(location, owner, name, enclosing, is_recursive))

        declare_generator_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.GLOBAL_GENERATOR_CLOSURE(location, owner, name, enclosing, is_recursive))

        load(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            let closure_type = type

            if !closure_type? then
                return IR.Values.DUMMY(Types.ERROR(), LOCATION.internal)
            fi

            if closure_type.is_error then
                return IR.Values.DUMMY(closure_type, LOCATION.internal)
            fi

            if _is_cached_on_frame_load then
                return _load_cached_on_frame(location, loader)
            fi

            if frame? then
                return super.load_closure(location, loader)
            fi

            set_type_arguments()

            return memoize_delegate(loader.load_global_anonymous_function(self, constructed_delegate_type))
        si

        to_string() -> string => "[global closure {name}]"
    si

    // TODO: this could be replaced with plain 'int'
    struct CAPTURED_TYPE_ARGUMENT is
        index: int

        init(index: int) is
            self.index = index
        si
    si
si
