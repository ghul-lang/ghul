namespace Semantic.Symbols is
    use IO.Std

    use System.Text.StringBuilder

    use IoC
    use Source

    use Types.Type

    // Helpers shared by generator and async state machines.
    // MoveNext has no method-level type parameters, so type-parameter
    // references inside the body must render as `!N` (class-level on
    // the frame) rather than `!!N`. Order — enclosing class's T's
    // first, function's own next — must match the frame's
    // `declare_captured_type_params` so indices align.
    class STATE_MACHINE_TYPE_PARAMS is
        // The type parameters the frame declares, in the order its
        // indices are numbered. A closure declares whatever its captured
        // values name and nothing else, since that is the set its frame
        // is built from and an enclosing class supplies its own through
        // the receiver; a closure that has captured nothing yet declares
        // nothing, rather than falling back to a set it will never use.
        // Anything that is not a closure reaches its enclosing class's
        // parameters and carries its own after them. One answer, so the
        // frame's parameter list, the types its construction site names
        // and the positions the body renders cannot disagree about what
        // they are describing.
        captured_parameters(function: Function?) -> Symbol[] static is
            let result = Collections.LIST[Symbol]()

            if !function? then
                return result
            fi

            if let closure: Closure = function then
                if let captured = closure.get_sorted_captured_type_argument_symbols() then
                    for parameter in captured do
                        result.add(parameter)
                    od
                fi

                return result
            fi

            if let owner_classy: Classy = function.owner /\ owner_classy.is_generic then
                for name in owner_classy.argument_names do
                    if let argument = owner_classy.find_direct(name) then
                        result.add(argument)
                    fi
                od
            fi

            if function.is_generic then
                for name in function.generic_argument_names do
                    if let argument = function.find_direct(name) then
                        result.add(argument)
                    fi
                od
            fi

            return result
        si

        walk_install(function: Function?, install: bool) static is
            let parameters = captured_parameters(function)

            for i in 0..parameters.count do
                _set_or_clear_override(parameters[i], install, i)
            od
        si

        construction_type_arguments(function: Function?) -> Type[]? static is
            let result = Collections.LIST[Type]()

            for parameter in captured_parameters(function) do
                if let typed: Types.Typed = parameter then
                    result.add(typed.type!)
                fi
            od

            if result.count == 0 then
                return null
            fi

            return result
        si

        // One parameter can be overridden by more than one state
        // machine at a time: a literal that awaits, inside a function
        // that awaits, captures the same parameter, and the inner
        // machine's body is emitted in the middle of the outer's. So
        // an override is pushed and popped rather than set and
        // cleared - clearing would leave the outer machine rendering
        // the parameter at its own declared position, which inside
        // MoveNext is a position that does not exist.
        _saved_positions: Collections.MAP[Symbol, Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?]] static

        init() static is
            _saved_positions = Collections.MAP[Symbol, Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?]]()
        si

        _set_or_clear_override(arg: Symbol, install: bool, index: int) static is
            if install then
                let captured_index = index

                if !_saved_positions.contains_key(arg) then
                    _saved_positions[arg] = Collections.LIST[(() -> TYPE_PARAMETER_POSITION)?]()
                fi

                _saved_positions[arg].add(arg.current_emitted_position)

                // MoveNext has no type parameters of its own, so every
                // one the body reaches is the frame's.
                arg.set_emitted_position(
                    () => TYPE_PARAMETER_POSITION(true, captured_index))
            else
                if _saved_positions.contains_key(arg) then
                    let saved = _saved_positions[arg]

                    if saved.count > 0 then
                        arg.set_emitted_position(saved[saved.count - 1])
                        saved.remove_at(saved.count - 1)

                        return
                    fi
                fi

                arg.set_emitted_position(null)
            fi
        si
    si
si
