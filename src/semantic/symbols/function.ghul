namespace Semantic.Symbols is
    use IO.Std

    use System.Exception
    use System.NotImplementedException
    use System.Text.StringBuilder

    use Collections.Iterable

    use IoC
    use Logging
    use Source

    use IR.Values.Value

    use Types.Type

    use Ghul.Pipes

    class Function: ScopedWithEnclosingScope, Types.Typed abstract is
        // Whether the method emitted for this function takes a receiver.
        // Usually the same question as `is_instance`, but a closure
        // answers the two differently: it is not an instance member of
        // anything the language can see, while the method emitted for it
        // does take the frame holding its captures. Everything about the
        // emitted method — its flags, its signature's calling
        // convention, and the slot each argument occupies — has to agree
        // on this, and disagreeing produces a static method whose body
        // reads argument 0 as a receiver.
        is_emitted_with_receiver: bool => is_instance

        _arguments: Collections.List[Type]

        _declaring_arguments: bool
        _override_class: METHOD_OVERRIDE_CLASS?

        override_class: METHOD_OVERRIDE_CLASS is
            if !_override_class? then
                // arguments is empty when resolve-explicit-variable-types
                // never visited this function (e.g. a partially-recovered
                // parse left the symbol orphaned from current_function),
                // giving that case a zero-arg override class — partial
                // symbols don't meaningfully participate in override
                // resolution anyway.
                _override_class = METHOD_OVERRIDE_CLASS(arguments, generic_arguments)
            fi

            return _override_class
        si

        _overriders: Collections.MutableList[Symbol]?
        _overridees: Collections.MutableList[Symbol]?

        // Whether a call to this function is trusted not to store to
        // any pre-existing heap location, without the body being seen:
        // declared `pure` — including on a body-less trait member the
        // analysis never walks — a curated store-free import, or a
        // synthesized backing-field read. Answerable at any point in
        // the build, and never stale, because every contributor is
        // settled by declaration shape rather than inferred from a
        // body. What was actually proven is EFFECTS.is_store_free,
        // which is only answerable once expressions are compiled, and
        // which takes the union with this.
        is_store_free: bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).is_store_free
            fi

            return _is_declared_pure \/ _is_trusted_import \/ _is_trusted_backing_read \/ _is_unreaching_static_import
        si

        // Set when this function was synthesized as the read accessor
        // of an auto property: its body is a read of the backing
        // field, by construction, so it stores nothing without any
        // analysis being needed.
        _is_backing_read: bool

        mark_backing_read() is
            let rsf = root_specialized_from

            if rsf != self then
                (cast Function?(rsf)!).mark_backing_read()
                return
            fi

            _is_backing_read = true
        si

        // A backing read is only trusted at a call site when the call
        // is bound to reach it: an in-assembly overrider, or a
        // possible override outside the assembly behind an open
        // class, could stand behind the call and store.
        _is_trusted_backing_read: bool =>
            _is_backing_read /\ has_no_overriders /\ !is_openly_dispatchable

        // Whether an override outside this compilation could stand
        // behind a call to this function: an instance method of
        // anything but a closed class. Mirrors the dispatch-shadow
        // rule the store-free solvers apply.
        is_openly_dispatchable: bool is
            if isa STRUCT_METHOD(self) then
                return false
            fi

            if !isa INSTANCE_METHOD(self) then
                return false
            fi

            let owner = self.owner

            if !owner? \/ !isa Classy(owner) then
                return true
            fi

            return (cast Classy(owner)).is_open
        si

        // Written back by the store-free solve once expressions have
        // compiled: the body, and everything it can reach, was proven
        // to store nothing. Read where the answer is surfaced rather
        // than relied on — hover's pure prefix and the pure
        // function-type shape — so a stale answer in analysis mode
        // costs a momentarily wrong display, never a wrong judgement;
        // the crossing discharge and the pure-slot check read EFFECTS instead,
        // inside the round that solved it. Kept in the id-keyed
        // STORE_FREE_BITS so it survives an incremental edit that
        // replaces the symbol object under an adopted id.
        is_proven_store_free: bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).is_proven_store_free
            fi

            return is_store_free \/ STORE_FREE_BITS.is_proven_store_free(id)
        si

        set_proven_store_free(value: bool) is
            let rsf = root_specialized_from

            if rsf != self then
                (cast Function?(rsf)!).set_proven_store_free(value)
                return
            fi

            STORE_FREE_BITS.set_proven_store_free(id, value)
        si

        // Set while a literal's body compiles if it performed any
        // heap-visible operation — a crossing-recording call, a heap
        // store, or any local reassignment (a reassigned local can be
        // a captured one, which is a frame-field store; own-local
        // reassignment is conservatively included). Consulted where
        // the compiled literal takes its value's type: a clean body
        // surfaces at the pure shape. Meaningless for named
        // functions — the store-free solve covers those.
        literal_body_impure: bool public

        // A curated store-free import is trusted at query time, not
        // only when a named body's fixpoint happens to reach it as a
        // callee edge. A call in a function-literal body or a
        // string-interpolation fragment never becomes such an edge, so
        // without this an otherwise store-free import reads as
        // state-changing purely by where it was called from — the same
        // import trusted in a named body goes untrusted in a lambda.
        // Gated on has_no_overriders so a virtual entry with an
        // in-assembly override still falls to the fixpoint's
        // dispatch-shadow check rather than being trusted blind.
        _is_trusted_import: bool =>
            has_no_overriders /\ _is_whitelisted_import

        // Whitelist membership is fixed at import from the function's
        // own name and owner, so it is derived once and cached.
        _whitelisted_import_cache: bool?

        _is_whitelisted_import: bool is
            if !_whitelisted_import_cache? then
                _whitelisted_import_cache = is_reflected /\ STORE_FREE_IMPORTS.is_store_free(self)
            fi

            return _whitelisted_import_cache
        si

        // Weaker than store-free: a call to this function can write
        // its own receiver's internal state, but nothing else, and can
        // reach no user code on the way. The call transfer applies the
        // heap-store rule instead of the full kill for one of these,
        // so field facts survive it and property facts do not.
        //
        // Store-free implies it, so a caller can ask this one question
        // and get the weaker answer whenever the stronger one holds.
        // Gated on has_no_overriders for the same reason the trusted
        // store-free imports are: a virtual entry with an in-assembly
        // override could dispatch to a body that stores anything.
        writes_only_receiver_interior: bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).writes_only_receiver_interior
            fi

            return is_store_free \/ (has_no_overriders /\ _is_receiver_interior_import) \/ _is_unreaching_instance_import
        si

        // Fixed at import from the function's own name, owner and
        // parameter types, so it is derived once and cached.
        _receiver_interior_import_cache: bool?

        _is_receiver_interior_import: bool is
            if !_receiver_interior_import_cache? then
                _receiver_interior_import_cache =
                    is_reflected /\ RECEIVER_INTERIOR_IMPORTS.writes_only_receiver_interior(self)
            fi

            return _receiver_interior_import_cache
        si

        // A member of a generic owner declines alongside a generic
        // method: the owner's type parameters can carry constraints,
        // and the body can dispatch through one into code declared
        // outside the import, which neither the parameters nor the
        // dispatch stamp vouch for. `LIST[T].sort` runs the element
        // type's comparer this way.
        _owner_is_generic: bool is
            if let o: Classy = owner?.unspecialized_symbol then
                return o.is_generic
            fi

            return false
        si

        // An imported BCL static whose parameters hand it no way to
        // name code declared here or to reach storage that existed
        // before the call. It has no receiver and no overridable
        // parameter types, so whatever it writes lands only in its
        // own fresh storage or in state no ghūl member can address,
        // and a call to one is trusted store-free on the same footing
        // as the curated import lists. Generic methods and members of
        // generic owners decline: a body can dispatch through such a
        // type parameter, which a parameter-only reading cannot see.
        //
        // Restricted to `STATIC_METHOD` - a global function imported
        // from another ghūl assembly is arbitrary ghūl source, not a
        // BCL surface: it can write its own assembly's globals and
        // dispatch into this assembly through an object stored there,
        // which a parameter-only reading cannot see either. `pure` is
        // the way such a function earns this trust.
        //
        // A BCL static can still route through mutable ambient state
        // invisible to its parameters - `Console.write_line(s)`
        // dispatches through whatever `TextWriter` `Console.set_out`
        // last installed, which can be a ghūl-implemented override
        // that stores. This tier accepts that gap deliberately rather
        // than declining every string-taking static or curating one
        // away: redirecting a stream this pervasive into something
        // that mutates state a live narrowing depends on is a
        // vanishingly unrealistic thing for real code to do, and
        // guarding against it would cost the tier its main value -
        // trusting BCL statics without a curated list - for a
        // hazard no program is likely to hit.

        _unreaching_static_import_cache: bool?

        _is_unreaching_static_import: bool is
            if !_unreaching_static_import_cache? then
                _unreaching_static_import_cache =
                    is_reflected /\
                    !is_generic /\
                    !_owner_is_generic /\
                    IMPORT_ARGUMENTS.all_arguments_scalar(self) /\
                    !isa STATIC_CONSTRUCTOR(self) /\
                    isa STATIC_METHOD(self) /\
                    !(cast STATIC_METHOD?(self)!).is_static_interface_virtual
            fi

            return _unreaching_static_import_cache
        si

        // The instance counterpart: an imported method the CLR binds
        // statically (`cannot_be_overridden`), so that no override in
        // any assembly can stand behind the call, with parameters that
        // reach nothing pre-existing or user code. Everything such a
        // method can write is therefore its own receiver's interior,
        // which makes it receiver-interior by construction rather than
        // by curation. Generic methods and members of generic owners
        // decline, as they do for the static tier.
        // A delegate's members decline however their parameters read.
        // `Invoke` takes whatever the delegate's own shape takes and
        // runs arbitrary code, so a shape-only reading of it - sealed
        // owner, scalar parameters, bound statically - vouches for
        // nothing. Recognised by walking to `System.MulticastDelegate`
        // by symbol identity rather than by matching a member name.
        _owner_is_delegate: bool is
            if let owner_classy: Classy = owner?.unspecialized_symbol then
                return owner_classy.is_delegate
            fi

            return false
        si

        _unreaching_instance_import_cache: bool?

        _is_unreaching_instance_import: bool is
            if !_unreaching_instance_import_cache? then
                _unreaching_instance_import_cache =
                    is_reflected /\
                    !is_generic /\
                    !_owner_is_generic /\
                    !_owner_is_delegate /\
                    IMPORT_ARGUMENTS.all_arguments_scalar(self) /\
                    isa Method(self) /\
                    (cast Method?(self)!).cannot_be_overridden
            fi

            return _unreaching_instance_import_cache
        si

        // Whether this function is a constructor. Overridden on the
        // method that carries the `.ctor` IL name; false everywhere
        // else, so callers can ask any function without a cast.
        is_constructor: bool => false

        // Whether this is an imported .NET member that only its declaring
        // type and that type's subclasses can use. The import leaves access
        // to the runtime; completion reads this to keep such a member off
        // the list after an ordinary dot.
        is_imported_protected: bool => _is_imported_protected

        _is_imported_protected: bool

        mark_imported_protected() is
            _is_imported_protected = true
        si

        // A constructor is trusted to write no pre-existing heap slot
        // *given its receiver is fresh* — the case a `NEW` presents.
        // Only the structural tiers answer here; a constructor that
        // writes its own instance fields is proven harmless by the
        // solve instead, and the crossing its construction records is
        // discharged against EFFECTS.constructs_store_free.
        constructs_store_free: bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).constructs_store_free
            fi

            return is_store_free \/ _is_unreaching_import_construction
        si

        // An imported constructor whose parameters hand it no way to
        // name code declared here. Its receiver did not exist before
        // the call, so nothing pre-existing is reachable through it
        // either, and the two routes together are the whole of what
        // the constructor can address. That leaves construction of an
        // imported type harmless without any per-member curation,
        // which is what keeps a `Collections.MAP()` from ending every
        // fact live around it.
        //
        // A write reached through a static field an earlier call
        // populated is outside the argument, and is accepted on the
        // same footing as the equals-and-hash contract the curated
        // import lists already rest on.
        _unreaching_import_construction_cache: bool?

        _is_unreaching_import_construction: bool is
            if !_unreaching_import_construction_cache? then
                _unreaching_import_construction_cache =
                    is_reflected /\ is_constructor /\ IMPORT_ARGUMENTS.all_arguments_scalar(self)
            fi

            return _unreaching_import_construction_cache
        si

        // Declared `pure` in source: the function is trusted
        // effectively store-free without its body being provable.
        // Feeds the store-free bit unconditionally after the
        // fixpoint, and obliges every override or trait
        // implementation to be pure itself — declared or proven.
        _is_declared_pure: bool

        is_declared_pure: bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).is_declared_pure
            fi

            return _is_declared_pure
        si

        mark_declared_pure() is
            let rsf = root_specialized_from

            if rsf != self then
                (cast Function?(rsf)!).mark_declared_pure()
                return
            fi

            _is_declared_pure = true
        si

        // The read accessor of a property declared `stable`: two
        // adjacent reads with nothing between them agree on presence
        // and runtime type. Trusted, not verified — the same standing
        // as `pure` — and orthogonal to it: a memoiser is impure and
        // stable. A fact narrowed through the property counts as
        // backed even when the getter's body is not provably
        // self-stable, and every override must honour the contract.
        // Carried across assemblies by STABLE_ATTRIBUTE.
        _is_declared_stable: bool

        is_declared_stable: bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).is_declared_stable
            fi

            return _is_declared_stable
        si

        mark_declared_stable() is
            let rsf = root_specialized_from

            if rsf != self then
                (cast Function?(rsf)!).mark_declared_stable()
                return
            fi

            _is_declared_stable = true
        si

        // The operation named by an `INTRINSIC_ATTRIBUTE` on this
        // declaration, or null. Set for a source declaration only: the
        // declaration is emitted so consumers can reflect it, and a
        // separate innate is registered from it once signatures resolve.
        intrinsic_operation: string? public

        // Set on the entry point synthesised from a file's top-level
        // statements. Only this function's statements run in textual
        // order, so TOP_LEVEL_VARIABLE checks it to report a use above
        // the variable's `let`, and analysis mode routes edits to files
        // carrying it to the full rebuild.
        is_top_level_entry: bool public

        // Set by select-entry-point on the one function this assembly
        // enters at. Emission reads it rather than re-deriving the choice
        // from the name, so every candidate is ranked against the others
        // before any IL is written.
        is_entry_point: bool public

        // No more-derived override exists. In a closed-by-default,
        // wholly-compiled assembly this means the method is effectively
        // final — the only body a call can reach is this one.
        has_no_overriders: bool => !_overriders? \/ _overriders.count == 0

        span: LOCATION

        // Incremental body re-walk override: also shift the declaration
        // span when the retained interface symbol is relocated.
        set_span(span_location: LOCATION) is
            span = span_location
        si

        type: Type? public
        return_type: Type? public

        // True when this function was declared without an explicit
        // return-type annotation (so the return type starts as
        // INFERRED_RETURN_TYPE and is set by walking return statements
        // / expression bodies). Used by the compile pass to drive LUB
        // widening across multiple return statements: when a later
        // return produces a type that's neither assignable to nor
        // from the current binding, widening to the LUB is the right
        // answer for an inferred return type, but a declared return
        // type with the same shape is a genuine type error.
        return_type_was_inferred: bool public

        // Set by compile-expressions when a `return null` is reached
        // while the return type is still inferred. A null says a value
        // can be absent without saying what it holds when present, so it
        // settles nothing on its own: what it records is that whatever
        // the return settles at has to be optional, and that a body
        // whose every return is null takes its type from the slot the
        // literal goes into rather than from itself.
        returned_genuine_null: bool public

        // Set by compile-lambdas when the AST FUNCTION had
        // `contains_let_await` set by declare-symbols. When settling
        // an inferred return type from the body's value, wrap a
        // bare-T value as `Tasks.TASK[T]` so the closure's signature
        // matches its async-state-machine emission shape. Body
        // values already typed Task[?] are left untouched.
        wrap_inferred_return_as_task: bool public

        // Set by compile-lambdas when the literal's slot returns `U?` over
        // an unconstrained U. An inferred return settles as `MAYBE[T]`
        // over what the body produced, so the literal's delegate has the
        // shape the slot binds against.
        wrap_inferred_return_as_maybe: bool public

        // Set by compile-lambdas to the slot's return type when that is a
        // reference type and the literal's own return is inferred. A body
        // producing a value type settles the return here rather than at
        // what it produced, so the conversion to the slot's type is made
        // inside the literal. Reaching the slot's type by assigning the
        // delegate instead would need the return covariance a value-type
        // instantiation does not have, and nothing checks that at run
        // time. A body producing a reference type keeps its own, which is
        // the more precise type and converts by assignment soundly.
        pin_inferred_return_at: Types.Type? public

        // Set on the closure of a literal synthesised to adapt a named
        // function reference to a formal it differs from only in an
        // optional position's carrier. Such a literal exists to present
        // the formal's own shape, so a settled slot return is adopted
        // rather than inferred from the body it wraps.
        is_carrier_adapter: bool public

        // Set by compile-lambdas when the AST FUNCTION had
        // `is_void_async` set by declare-symbols — i.e., body
        // contains `await` but no value-returning `return X;`
        // statements. Read by the async state machine setup to pick
        // the non-generic Tasks.TASK over Tasks.TASK[T].
        is_void_async: bool public

        // Set by compile-lambdas when the slot an async closure goes
        // into names a generic task-like other than Task, with the
        // result argument still to be inferred from the body. The
        // inferred return type is then built from this symbol rather
        // than from Task, so `spawn[T](body: () -> COROUTINE[T])`
        // infers T from the closure's returns.
        async_task_like_template: Classy? public

        // True once the argument list has been supplied — by
        // resolve-explicit-variable-types for source functions, at import
        // for reflected ones, or at synthesis. Distinguishes a
        // not-yet-declared function from a declared zero-argument one:
        // both have an empty arguments list, but only the declared one
        // may participate in arity-based overload filtering.
        _are_arguments_declared: bool

        are_arguments_declared: bool => _are_arguments_declared

        arguments: Collections.List[Type] public => _arguments,
            = value is
                assert value |> all(a => a?) else "setting an argument to null for {name}"

                _arguments = value
                _are_arguments_declared = true
            si

        generic_arguments: Collections.List[Type] public
        generic_argument_names: Collections.List[string] public
        unspecialized_arguments: Collections.List[Type]? public

        // Parallel to `arguments`: whether each formal was declared to
        // take an argument pack spread out - `f: T.. -> U` - rather than
        // as the tuple the pack binds to. Empty for the great majority
        // of functions, which mention no pack at all.
        argument_is_pack: Collections.List[bool] public

        // Parallel to `argument_is_pack`: how many returns into the
        // formal's own type the marked function type sits. Zero is the
        // formal's own type - `f: T.. -> U` - and one is the function
        // its own return names, as `f: X -> T.. -> U` does.
        argument_pack_depth: Collections.List[int] public

        // Index of the formal declared to absorb the call's remaining
        // arguments into the pack's tuple - `v: T..` - and -1 for the
        // great majority of functions, which declare no such formal.
        spread_argument_index: int public

        // How many returns into the declared return type the marked
        // function type sits - `-> T.. -> U` is zero, `-> X -> T.. -> U`
        // is one - and -1 for the great majority of functions, whose
        // return type carries no pack marker. The declared return type
        // itself still names the tuple-in shape; a call that binds the
        // pack to a concrete tuple presents its result as the
        // corresponding N-ary function instead.
        return_pack_depth: int public
        unspecialized_return_type: Type? public

        // Parallel to generic_argument_names: kind / `init` / type-bound
        // constraints per method-level type parameter. Populated at
        // import for .NET methods, whose parameter symbols are not
        // declared into the function's scope and so can't be reached
        // via find_direct. ghūl-declared methods leave these empty and
        // carry the same information on the parameter symbol.
        generic_argument_constraint_kinds: Collections.List[TypeParameterConstraintKind] public
        generic_argument_has_constructor_constraint: Collections.List[bool] public
        generic_argument_type_bounds: Collections.List[Collections.List[Type]] public

        argument_names: Collections.List[string] public

        // Parallel to `argument_names`: the declared default of each
        // parameter, or null when the parameter has no default and so
        // cannot be omitted from a named call. A ghūl-source `= _`
        // parameter is stored as "default"; a literal default
        // (reflected methods only) is stored as its text.
        argument_defaults: Collections.List[string?] public

        // Parallel to `argument_names`: per-parameter by-ref direction,
        // derived from reflected `IsIn`/`IsOut` and populated only for
        // reflected methods that have a non-plain by-ref slot. Null
        // elsewhere, where a by-ref parameter defaults to plain `ref`
        // — both read and written. `reads` gates the must-be-assigned-
        // before check; `writes` gates definite assignment of the
        // argument. Held on the unspecialized function so specializations
        // observe them through `root_specialized_from`.
        _argument_reads: Collections.List[bool]?
        _argument_writes: Collections.List[bool]?

        set_argument_directions(reads: Collections.List[bool], writes: Collections.List[bool]) is
            let rsf = root_specialized_from

            if rsf != self then
                (cast Function?(rsf)!).set_argument_directions(reads, writes)
                return
            fi

            _argument_reads = reads
            _argument_writes = writes
        si

        // Whether the callee reads the incoming value of argument `i`.
        // True for every by-ref slot except a pure `out`, and the
        // conservative default when no reflected direction is recorded.
        argument_reads(i: int) -> bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).argument_reads(i)
            fi

            if _argument_reads? /\ i < _argument_reads.count then
                return _argument_reads[i]
            fi

            return true
        si

        // Whether the callee writes argument `i`, so passing it by `ref`
        // definitely assigns the target. True for every by-ref slot
        // except a pure `in`, and the conservative default.
        argument_writes(i: int) -> bool is
            let rsf = root_specialized_from

            if rsf != self then
                return (cast Function?(rsf)!).argument_writes(i)
            fi

            if _argument_writes? /\ i < _argument_writes.count then
                return _argument_writes[i]
            fi

            return true
        si

        symbol_kind: SymbolKind => SymbolKind.FUNCTION
        completion_kind: CompletionKind => CompletionKind.FUNCTION

        is_function: bool => true
        is_generic: bool public

        // Excluded as a candidate when a binary operator expression
        // resolves. Set on a reflected operator-named member of a type
        // whose operator is innate — `int`'s `<>` from
        // `IComparable[int].CompareTo` — so `a < b` keeps lowering to
        // the comparison opcode while the member remains reachable
        // every other way: it satisfies its trait, resolves by name,
        // and converts to a delegate.
        is_hidden_from_operator_resolution: bool public
        is_abstract: bool => false

        // Whether the source declared this method without a body. A
        // `DllImport` needs one that was: the call it stands for is the
        // library's, so a body of its own would be dead code.
        is_declared_without_body: bool public

        // What this method's `DllImport` says, for a method declared
        // with no body that calls into a shared library. Absent on
        // every ordinary method.
        pinvoke: Semantic.PINVOKE_IMPORT? public

        // Only a body-less class method that overrides an implemented
        // one carries a throwing body; every other function has one of
        // its own, so this asks nothing of them.
        throws_unimplemented: bool => false

        mark_throws_unimplemented() is si

        // A synthesized `reset` a type never declared: its body is a
        // throw rather than anything the source asked for.
        throws_not_supported: bool => false

        mark_throws_not_supported() is si
        is_virtual: bool => false
        is_default_trait_method: bool => false
        is_capture_context: bool => true
        is_workspace_visible: bool => !name.starts_with('_')
        is_recursive: bool => false // only applicable if a closure

        // An indexer's accessors carry the CLR-required names `get_Item`
        // and `set_Item`, which are not spellable in ghūl source. Rendered
        // as a plain call they read as a member the language does not
        // have, so they take the declaration's own shape instead - the
        // same shape `to_string` gives them, with short type descriptions.
        short_description: string =>
            if is_indexer_accessor then
                render_indexer_shape(
                    get_short_argument_description(0),
                    indexer_value_type!.short_description
                )
            else
                "{name}{generic_argument_descriptions}({short_argument_descriptions}) -> {_return_type_description(true)}"
            fi

        search_description: string => short_description

        // Prefixes the description's trailing kind comment when the
        // function is proven store-free — diagnostic surfacing only,
        // deliberately inside the comment so it does not read as
        // source syntax.
        pure_prefix: string => if is_proven_store_free then "pure " else "" fi

        argument_descriptions: string =>
            (0..arguments.count) |> map(i => get_argument_description(i)) |> join() ?? ""

        short_argument_descriptions: string =>
            (0..arguments.count) |> map(i => get_short_argument_description(i)) |> join() ?? ""

        generic_argument_descriptions: string is
            if generic_arguments.count == 0 then
                return ""
            fi

            let result = System.Text.StringBuilder()

            result.append('[')

            let seen_any mut = false

            for i in 0..generic_arguments.count do
                if seen_any then
                    result.append(',')
                fi

                result.append(generic_arguments[i])

                // The `..` bound belongs to the declaration, so it is
                // written here rather than by the type's own rendering,
                // which also answers wherever the parameter is used.
                if generic_arguments[i].symbol.is_argument_pack then
                    result.append("..")
                fi

                seen_any = true
            od

            result.append(']')

            return result.to_string()
        si

        // Sets the `..` on each type parameter a pack marker names. A
        // reflected function carries its markers on formals and return
        // only; the declaration's own `[T..]` is what they name, rebuilt
        // here from them.
        mark_pack_type_parameters() is
            for i in 0..arguments.count do
                if i < argument_is_pack.count /\ argument_is_pack[i] then
                    let depth = if i < argument_pack_depth.count then argument_pack_depth[i] else 0 fi

                    _mark_pack_slot(Semantic.ARGUMENT_PACK.marked_slot(arguments[i], depth))
                elif i == spread_argument_index then
                    _mark_pack_parameter(arguments[i])
                fi
            od

            if return_pack_depth >= 0 then
                _mark_pack_slot(Semantic.ARGUMENT_PACK.marked_slot(return_type, return_pack_depth))
            fi
        si

        _mark_pack_slot(slot: Type?) is
            if slot? then
                _mark_pack_parameter(slot.arguments[0])
            fi
        si

        _mark_pack_parameter(type: Type?) is
            if type? /\ type.is_function_generic_argument then
                type.symbol.set_is_argument_pack(true)
            fi
        si

        // Shared body for the concrete Function kinds. Reproduces the
        // signature shape `{qname}{[gen,args]}({name}: {type}, …)` +
        // optional ` -> {return_type}` — no trailing classifier; that
        // lives on `describe_kind`. The `(...)` argument list is a
        // WRAPPABLE so the DOC hover renderer can break it across
        // lines; the generic `[]` bracket is not wrappable.
        _describe_function(
            context: DESCRIBE_CONTEXT,
            include_return_type: bool
        ) -> SignaturePart is
            let parts = Collections.LIST[SignaturePart]()
            parts.add(PARTS.name(self))
            parts.add(_describe_generic_arguments())
            parts.add(_describe_arguments(context))
            if include_return_type /\ return_type? then
                parts.add(PARTS.literal(" -> "))
                parts.add(_describe_return_type())
            fi
            return SignaturePart.SEQUENCE(parts)
        si

        _describe_generic_arguments() -> SignaturePart is
            if generic_arguments.count == 0 then
                return PARTS.nil()
            fi
            let items = Collections.LIST[SignaturePart]()
            for t in generic_arguments do
                // The `..` marker belongs to the declaration, so it is
                // written here rather than by the type's own rendering,
                // which also answers wherever the parameter is used.
                if t.symbol.is_argument_pack then
                    items.add(PARTS.sequence([PARTS.type_ref(t), PARTS.literal("..")]))
                else
                    items.add(PARTS.type_ref(t))
                fi
            od
            return SignaturePart.WRAPPABLE("[", ",", true, "]", items)
        si

        _describe_arguments(context: DESCRIBE_CONTEXT) -> SignaturePart is
            let items = Collections.LIST[SignaturePart]()
            for i in 0..arguments.count do
                items.add(PARTS.sequence([
                    PARTS.literal("{argument_names[i]}: "),
                    _describe_argument_type(i)
                ]))
            od
            return SignaturePart.WRAPPABLE("(", ",", false, ")", items)
        si

        // A formal declared to take an argument pack spread out is
        // written `f: T.. -> U`, and the marker sits on the parameter of
        // its own function type - which the type's own rendering knows
        // nothing about, so the two halves are written out here.
        _describe_argument_type(index: int) -> SignaturePart is
            if !get_argument_is_pack(index) then
                return PARTS.type_ref(arguments[index])
            fi

            return _describe_pack_marked_type(arguments[index], get_argument_pack_depth(index))
        si

        // A return type that carries the marker reads the same way.
        _describe_return_type() -> SignaturePart is
            if return_pack_depth < 0 then
                return PARTS.type_ref(return_type!)
            fi

            return _describe_pack_marked_type(return_type!, return_pack_depth)
        si

        _describe_pack_marked_type(type: Type, depth: int) -> SignaturePart is
            let slot = Semantic.ARGUMENT_PACK.marked_slot(type, depth)

            if !slot? then
                return PARTS.type_ref(type)
            fi

            let parts = Collections.LIST[SignaturePart]()

            // The hops the marker sits behind read as they always do;
            // only the one it was written on carries the marker.
            let hop mut = type

            for _ in 0..depth do
                parts.add(_describe_function_parameters(hop))
                parts.add(PARTS.literal(" -> "))

                hop = hop.arguments[hop.arguments.count - 1]
            od

            // The pack is the last parameter; any before it are the
            // function type's own, and the list is parenthesised as it is
            // written.
            let fixed = Semantic.ARGUMENT_PACK.fixed_count(slot)

            if fixed > 0 then
                parts.add(PARTS.literal("("))

                for i in 0..fixed do
                    parts.add(PARTS.type_ref(slot.arguments[i]))
                    parts.add(PARTS.literal(", "))
                od
            fi

            parts.add(PARTS.type_ref(slot.arguments[fixed]))
            parts.add(PARTS.literal(if fixed > 0 then "..) -> " else ".. -> " fi))

            if slot.is_action then
                parts.add(PARTS.literal("void"))
            else
                parts.add(PARTS.type_ref(slot.arguments[fixed + 1]))
            fi

            if slot.is_pure_function then
                parts.add(PARTS.literal(" pure"))
            fi

            return SignaturePart.SEQUENCE(parts)
        si

        // The parameter half of a function type, parenthesised wherever
        // it is not the single parameter that needs no parentheses.
        _describe_function_parameters(type: Type) -> SignaturePart is
            let count =
                if type.is_action then
                    type.arguments.count
                else
                    type.arguments.count - 1
                fi

            let items = Collections.LIST[SignaturePart]()

            for i in 0..count do
                items.add(PARTS.type_ref(type.arguments[i]))
            od

            if count == 1 then
                return items[0]
            fi

            return SignaturePart.WRAPPABLE("(", ",", false, ")", items)
        si

        overriders: Collections.Iterable[Symbol]? => _overriders
        overridees: Collections.Iterable[Symbol]? => _overridees

        has_overridees: bool => _overridees? /\ _overridees.count > 0

        // Attribute pragmas resolved onto a parameter (`@Foo() name: T`).
        // A parameter's own symbol is a member of its owning function's
        // scope regardless of function kind, so this reaches it the
        // same way for a named function, a delegate/anon-func closure,
        // or a frame-boxed capturing closure.
        // argument_defaults is supplied by whichever route declared the
        // function - reflection for an imported one, resolve-explicit-
        // types for one written in source.
        @suppress("field-definite-assignment")
        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, owner, name, enclosing_scope)

            self.span = span

            _arguments = Collections.LIST[Type](0)
            argument_names = Collections.LIST[string](0)
            generic_arguments = Collections.LIST[Type](0)
            generic_argument_names = Collections.LIST[string](0)
            generic_argument_constraint_kinds = Collections.LIST[TypeParameterConstraintKind](0)
            generic_argument_has_constructor_constraint = Collections.LIST[bool](0)
            argument_is_pack = Collections.LIST[bool](0)
            argument_pack_depth = Collections.LIST[int](0)
            spread_argument_index = -1
            return_pack_depth = -1
            generic_argument_type_bounds = Collections.LIST[Collections.LIST[Type]](0)

            if name =~ "init" then
                il_name_override = ".ctor"
            elif name =~ "=~" /\ isa Classy(owner) then
                // A type's `=~` maps to .NET `Equals` for interop. A global
                // `=~` operator keeps its own name, or it comes back from
                // reflection as `equals` and no longer resolves.
                il_name_override = "Equals"
            fi

            type = Types.NAMED(self)
        si

        set_arguments(argument_names: Collections.List[string], argument_types: Collections.List[Type]) is
            self.arguments = argument_types

            assert argument_names |> all(a => a?) else "setting an argument name to null for {name} (B)"

            self.argument_names = argument_names
        si

        add_overrider(overrider: Symbol mut) is
            let rsf = root_specialized_from
            if rsf != self then
                rsf.add_overrider(overrider)
                return
            fi

            let overriders mut = _overriders

            if !overriders? then
                overriders = Collections.LIST[Symbol]()
                _overriders = overriders
            fi

            overrider = overrider.root_specialized_from

            if overriders.contains(overrider) then
                return
            fi

            overriders.add(overrider)

            if let journal = INHERITANCE_JOURNAL.current then
                journal.record(InheritanceOp.FUNCTION_OVERRIDER_ADDED(self, overrider))
            fi
        si

        remove_overrider(overrider: Symbol) is
            let rsf = root_specialized_from
            if rsf != self then
                rsf.remove_overrider(overrider)
                return
            fi

            let overriders = _overriders

            if overriders? then
                overriders.remove(overrider.root_specialized_from)
            fi
        si

        add_overridee(overridee: Symbol mut) is
            let rsf = root_specialized_from
            if rsf != self then
                rsf.add_overridee(overridee)
                return
            fi

            let overridees mut = _overridees

            if !overridees? then
                overridees = Collections.LIST[Symbol]()
                _overridees = overridees
            fi

            overridee = overridee.root_specialized_from

            if overridees.contains(overridee) then
                return
            fi

            overridees.add(overridee)

            if let journal = INHERITANCE_JOURNAL.current then
                journal.record(InheritanceOp.FUNCTION_OVERRIDEE_ADDED(self, overridee))
            fi
        si

        remove_overridee(overridee: Symbol) is
            let rsf = root_specialized_from
            if rsf != self then
                rsf.remove_overridee(overridee)
                return
            fi

            let overridees = _overridees

            if overridees? then
                overridees.remove(overridee.root_specialized_from)
            fi
        si

        load_self(location: LOCATION, loader: SYMBOL_LOADER) -> Value is
            IoC.CONTAINER.instance.logger.error(location, "cannot access instance member from non-instance context")

            return IR.Values.DUMMY(Types.ERROR(), location)
        si

        load_outer_self(location: LOCATION, loader: SYMBOL_LOADER) -> Value? is
            IoC.CONTAINER.instance.logger.error(location, "cannot access instance member from non-instance context")

            return IR.Values.DUMMY(Types.ERROR(), location)
        si

        load_captured_value(location: LOCATION, symbol: Variable, loader: SYMBOL_LOADER) -> Value => throw NotImplementedException("{get_type()} cannot load captured value: {symbol} from: {location}")
        load_outer_captured_value(location: LOCATION, symbol: Variable, loader: SYMBOL_LOADER) -> Value? => throw NotImplementedException("{get_type()} cannot load outer captured value: {symbol} from: {location}")
        store_captured_value(location: LOCATION, symbol: Variable, value: Value, loader: SYMBOL_LOADER) -> Value => throw NotImplementedException("{get_type()} cannot store captured value: {symbol} from: {location}")
        start_declaring_arguments() is
            _declaring_arguments = true
        si

        end_declaring_arguments() is
            _declaring_arguments = false
        si

        /*
        given a set of actual function argument types, try to infer actual generic argument types by pattern matching formal
        argument types (which may contain formal generic argument types) against correspinding actual arguments. Arguments
        could be unknown (!!! or ***), which match anything and do not contradict any type inferences we make.

        map[T,U](from: Iterable[T], mapper: T -> U) -> Iterable[U]
        map([1, 2, 3, 4, 5], x => x + 1)

        - the type of [1, 2, ... ] is known to be int[]
        - prior type inference should figure out the return type of x => x + 1 must be int (because the only overload
        resolution possible for !!! + 1 is int + int -> int) so we'll be called with actual argument types of int[]
        and !!! -> int that need to be matched against Iterable[T] and T -> U

        - int[] implements Iterable[int] which pattern matches Iterable[T], allowing us to infer that T should be int
        - !!! -> int pattern matches T -> U. !!! doesn't contradict a type of int for T, and int implies a type of int for U

        so we can return a type map of T = int, U = int
        */
        // When LUB widening fired during bind (siblings case), the bound
        // type may be wider than any individual arg-derived candidate.
        // Re-verify each actual arg still conforms to its parameter type
        // with the bound type-args substituted in. Without this check a
        // call like structured[T](T, Iterable[T]) with (int, string)
        // (or the constructor analogue Box[T] with init(item: T, bag:
        // Iterable[T]) called as Box(1, "hello")) would bind
        // T = LUB(int, char) = ValueType and silently accept, even
        // though `string` is Iterable[char] which (without ghūl's
        // variance handling marking Iterable covariant) is not
        // Iterable[ValueType] — yielding an InvalidProgramException
        // at JIT for the constructor path, or a runtime cast failure.
        //
        // Only run when LUB actually fired — pairwise widening is
        // monotonic in the wider direction and doesn't need re-checking,
        // and skipping the check on the happy path avoids triggering
        // premature type evaluation on args that aren't yet ready
        // (e.g. function literals being passed to higher-order calls).
        check_lub_conformance(results: Types.GENERIC_ARGUMENT_BIND_RESULTS, args: Collections.List[Type]) -> bool is
            if !results.is_bound \/ !results.used_lub then
                return true
            fi

            let type_map = results.map
            for i in 0..args.count do
                let specialized_param = arguments[i].specialize(type_map)
                if !specialized_param.is_assignable_from(args[i]) then
                    return false
                fi
            od

            return true
        si

        try_bind_generic_arguments(location: Source.LOCATION, args: Collections.List[Type]) -> Types.GENERIC_ARGUMENT_BIND_RESULTS? is
            // This method binds the *function's* own generic args
            // (use try_bind_owner_generic_arguments for the owning
            // class's). When the function isn't generic there is
            // nothing here to bind — return null. Without this guard
            // a non-generic instance method on a generic class
            // (e.g. `Box[T].set(value: T)` called on `Box[?]`) would
            // proceed to call check_complete with a null
            // generic_arguments and NRE inside check_complete.
            if !is_generic then
                return null
            fi

            assert args.count == arguments.count else "expected to bind {arguments.count} arguments in {self} but only {args} supplied"

            let results = Types.GENERIC_ARGUMENT_BIND_RESULTS(_bindable_type_arguments())

            let all_ok = true

            for i in 0..args.count do
                if !arguments[i].bind_type_variables(args[i], results) then
                    return null
                fi
            od

            results.check_complete(location, generic_arguments)

            if !results.is_bound then
                // A wild optional parameter (`T?`) matched a bare null
                // actual, which accepts without pinning the type variable.
                // Default any such never-pinned variable to object so the
                // selected overload is fully specialized; otherwise it
                // would emit with a free type parameter (`!!N`) and fail to
                // load at run time.
                results.default_null_only_unbound(
                    generic_arguments,
                    IoC.CONTAINER.instance.innate_symbol_lookup.get_object_type()
                )

                results.check_complete(location, generic_arguments)
            fi

            if !check_lub_conformance(results, args) then
                return null
            fi

            // Bound actuals must not carry a method-level type
            // parameter that belongs to a different function: its
            // `!!N` index is only meaningful inside that function,
            // and emitting it at this call site produces an
            // unloadable assembly. The caller's own type parameters
            // are allowed — their indices are valid in the enclosing
            // method.
            let caller = IoC.CONTAINER.instance.symbol_table.current_function

            if results.contains_function_generic_argument_foreign_to(caller) then
                return null
            fi

            return results
        si

        // The type arguments a call to this function may pin: its own,
        // plus the declaring type's when those are still open. A static
        // generic method reached through its declaring class can have
        // both inferred from one argument list; reached through a
        // constructed type the declaring half is already supplied, and
        // the only type variables left in the formals belong to whoever
        // wrote the call.
        _bindable_type_arguments() -> Collections.List[Types.Type] is
            let result = Collections.LIST[Types.Type](generic_arguments)

            if let owner_classy = cast Classy?(owner) then
                for name in owner_classy.argument_names do
                    if let argument = owner_classy.find_direct(name) /\ argument.type? then
                        result.add(argument.type!)
                    fi
                od
            fi

            return result
        si

        try_bind_owner_generic_arguments(location: Source.LOCATION, args: Collections.List[Type]) -> Types.GENERIC_ARGUMENT_BIND_RESULTS? is
            let owner_classy = cast Classy?(owner)

            if !owner_classy? \/ !owner_classy.is_generic then
                return null
            fi

            let results = Types.GENERIC_ARGUMENT_BIND_RESULTS()

            for i in 0..args.count do
                if !arguments[i].bind_type_variables(args[i], results) then
                    return null
                fi
            od

            // An owner type argument that no formal mentions cannot be
            // bound by pairing formals with actuals, but an actual whose
            // bound instantiates the owner has already pinned it.
            OWNER_INSTANTIATION_BINDER.bind_unbound_from_actual_instantiations(owner_classy, args, results)

            results.check_complete(location, owner_classy.arguments)

            if !check_lub_conformance(results, args) then
                return null
            fi

            let caller = IoC.CONTAINER.instance.symbol_table.current_function

            if results.contains_function_generic_argument_foreign_to(caller) then
                return null
            fi

            return results
        si

        specialize_function(type_map: Collections.Map[Symbol,Type], owner: GENERIC?) -> Function is
            let result = cast Function?(memberwise_clone())!

            result.specialized_from = self
            result._override_class = null

            if !return_type? then
                IoC.CONTAINER.instance.logger.poison(self.location, "specialized with null return type")
            else
                result.return_type = return_type.specialize(type_map)
            fi

            if unspecialized_arguments? then
                result.unspecialized_arguments = unspecialized_arguments
            else
                result.unspecialized_arguments = arguments
            fi

            // Which formals take a pack spread out is a property of the
            // declaration, so it survives specialisation - by which point
            // the parameter itself has become the tuple it bound to.
            result.argument_is_pack = argument_is_pack
            result.argument_pack_depth = argument_pack_depth
            result.spread_argument_index = spread_argument_index
            result.return_pack_depth = return_pack_depth

            if unspecialized_return_type? then
                result.unspecialized_return_type = unspecialized_return_type
            else
                result.unspecialized_return_type = return_type
            fi

            // Pre-sized empty, filled by add: a LIST(arguments) copy would
            // duplicate every element only for the loop to replace them.
            let ra = Collections.LIST[Type](arguments.count)

            result.arguments = ra

            for a in arguments do
                ra.add(a.specialize(type_map))
            od

            if generic_arguments.count > 0 then
                let specialized_arguments = Collections.LIST[Type](generic_arguments.count)

                for ga in generic_arguments do
                    specialized_arguments.add(ga.specialize(type_map))
                od

                result.generic_arguments = specialized_arguments
            fi

            // owner is absent for owner-less functions
            @suppress("presence-test-non-optional")
            if owner? then
                if result.owner == owner.unspecialized_symbol then
                    result.owner = owner
                elif result.owner != owner then
                    result.owner = result.owner!.type!.specialize(owner.type_map).symbol
                else
                    Std.error.write_line("{result} is already owned by {owner}")
                fi
            fi

            return result
        si

        specialize(type_map: Collections.Map[Symbol,Type], owner: GENERIC) -> Symbol =>
            specialize_function(type_map, owner)

        get_argument_constraint_kind(index: int) -> TypeParameterConstraintKind is
            if index >= 0 /\ index < generic_argument_constraint_kinds.count then
                return generic_argument_constraint_kinds[index]
            fi

            if index >= 0 /\ index < generic_argument_names.count then
                let argument = find_direct(generic_argument_names[index])

                if argument? then
                    return argument.constraint_kind
                fi
            fi

            return TypeParameterConstraintKind.NONE
        si

        // Whether the formal at `index` takes an argument pack spread
        // out. False for every function that declares no pack.
        get_argument_is_pack(index: int) -> bool =>
            index >= 0 /\ index < argument_is_pack.count /\ argument_is_pack[index]

        // How many returns into the formal at `index` the pack marker
        // sits. Zero wherever the depth was never recorded, which is
        // the formal's own type and what every pack meant before the
        // marker could be written deeper.
        get_argument_pack_depth(index: int) -> int =>
            if index >= 0 /\ index < argument_pack_depth.count then
                argument_pack_depth[index]
            else
                0
            fi

        // Whether this function absorbs a call's remaining arguments
        // into a pack's tuple.
        has_spread_argument: bool => spread_argument_index >= 0

        get_argument_has_constructor_constraint(index: int) -> bool is
            if index >= 0 /\ index < generic_argument_has_constructor_constraint.count then
                return generic_argument_has_constructor_constraint[index]
            fi

            if index >= 0 /\ index < generic_argument_names.count then
                let argument = find_direct(generic_argument_names[index])

                if argument? then
                    return argument.has_constructor_constraint
                fi
            fi

            return false
        si

        // The bounds (`[T: A /\ B]`) of the method-level type parameter at
        // `index`, empty when unbounded. Imported methods carry them in
        // `generic_argument_type_bounds`; ghūl-declared methods carry them
        // on the parameter symbol as its ancestors, with the meaningless
        // `object` default bound dropped.
        get_argument_type_bounds(index: int) -> Collections.List[Type] is
            if index >= 0 /\ index < generic_argument_type_bounds.count then
                return generic_argument_type_bounds[index]
            fi

            if index >= 0 /\ index < generic_argument_names.count then
                let argument = find_direct(generic_argument_names[index])

                if argument? /\ argument.is_type_variable then
                    let result = Collections.LIST[Type](0)

                    for ancestor in argument.ancestors do
                        if !ancestor.is_object then
                            result.add(ancestor)
                        fi
                    od

                    return result
                fi
            fi

            return Collections.LIST[Type](0)
        si

        try_specialize(
            location: LOCATION,
            logger: Logger,
            actual_type_arguments: Collections.List[Type]
        ) -> Symbol? is
            if !is_generic then
                logger.error(location, "cannot explicitly specialize non-generic type")
                return null
            elif actual_type_arguments.count != generic_argument_names.count then
                logger.error(location, "expected {generic_argument_names.count} explicit generic type arguments")
                return null
            fi

            GENERIC_CONSTRAINT_CHECKER().check_arguments(
                location,
                logger,
                self,
                generic_argument_names,
                actual_type_arguments
            )

            return specialize(actual_type_arguments)
        si

        // The declared type parameter at `index`. A function's own
        // formals are written in terms of these symbols, so a
        // substitution map has to be keyed on them. A reflected generic
        // method declares none into its scope and carries them
        // positionally instead, where the mapped type's symbol is the
        // same one its formals mention.
        _type_parameter_at(index: int) -> GenericArgument? is
            if index < 0 \/ index >= generic_argument_names.count then
                return null
            fi

            if let declared = find_direct(generic_argument_names[index]) then
                return cast GenericArgument?(declared)
            fi

            if index < generic_arguments.count then
                return cast GenericArgument?(generic_arguments[index].symbol)
            fi

            return null
        si

        specialize(actual_type_arguments: Collections.List[Type]) -> Symbol is
            assert is_generic else "trying to specialize non generic function {qualified_name}"

            let type_map = Collections.MAP[Symbol,Type]()

            for (index, value) in actual_type_arguments |> index() do
                let parameter = _type_parameter_at(index)

                assert parameter? else
                    "function '{qualified_name}' has no type parameter at {index}"

                type_map[parameter] = value
            od

            let result = specialize_function(type_map, null)

            if result.is_generic then
                result.is_generic = false
            fi

            return result
        si

        set_void_return_type() is
            return_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_void_type()
        si

        set_return_type(rt: Type?) is
            return_type = rt

            if rt? /\ are_arguments_declared then
                if arguments.count > Lookups.INNATE_TYPE_LIMITS.MAX_FUNCTION_PARAMETERS then
                    IoC.CONTAINER.instance.logger.error(
                        location,
                        "a function literal cannot have more than {Lookups.INNATE_TYPE_LIMITS.MAX_FUNCTION_PARAMETERS} parameters")

                    type = Types.ERROR()
                else
                    type = IoC.CONTAINER.instance.innate_symbol_lookup.get_function_type(
                        arguments |> cat([rt]) |> collect_mutable()
                    )
                fi
            else
                type = Types.ERROR()
            fi

            type_updated(type!)
        si

        type_updated(type: Type) is
            // override me
        si

        get_full_type(innate_symbol_lookup: Lookups.InnateSymbolLookup) -> Types.Type is
            if arguments.count > Lookups.INNATE_TYPE_LIMITS.MAX_FUNCTION_PARAMETERS then
                IoC.CONTAINER.instance.logger.error(
                    location,
                    "a function with more than {Lookups.INNATE_TYPE_LIMITS.MAX_FUNCTION_PARAMETERS} parameters cannot be used as a value")

                return Types.ERROR()
            fi

            let types = Collections.LIST[Type](arguments.count + 1)

            types.add_range(arguments)
            types.add(return_type!)

            // A store-free function referred to as a value is a value
            // of the pure shape of its type — the property belongs to
            // the function, not to the slot it is being read into.
            return innate_symbol_lookup.get_function_type(types, is_proven_store_free)
        si

        try_override(into: Classy, function: Function, logger: Logger) is
            logger.error(location, "cannot override {function}", function.location, "declared here")
        si

        try_instance_override_me(into: Classy, function: Function, logger: Logger) is
            logger.error(function.location, "cannot be overridden by {function}", location, "overridden declaration")
        si

        try_struct_override_me(into: Classy, function: Function, logger: Logger) is
            logger.error(function.location, "cannot be overridden by {function}", location, "overridden declaration")
        si

        try_abstract_override_me(into: Classy, function: Function, logger: Logger) is
            logger.error(function.location, "cannot be overridden by {function}", location, "overridden declaration")
        si

        // What every cell does once it has decided the declaration in
        // front of it really is an override of this member: check what
        // an implementation is held to, and record the relation both
        // ways so everything downstream - the contracts, the editor,
        // the covariant-return slot - can see it.
        record_implementing_override(into: Classy, overrider: Function, logger: Logger) is
            let return_type_matches = overrider.ensure_return_type_matches(into, self, false, logger)

            overrider.ensure_arguments_accept_optionals(into, self, false, logger)

            let il_name_matches = overrider.ensure_il_name_matches(into, self, "implement", logger)

            overrider.add_overridee(self)
            self.add_overrider(overrider)
        si

        inheritance_warn(logger: Logger, into: Classy, code: string, message: string) is
            if owner == into then
                logger.warn(location, code, message)
            else
                logger.warn(into.location, code, "{self} {message}")
            fi
        si

        inheritance_error(logger: Logger, into: Classy, message: string) is
            if owner == into then
                logger.error(location, message)
            else
                logger.error(into.location, "{self} {message}")
            fi
        si

        // Whether this function's return type is a narrower reference type
        // than the one it overrides or implements. Such a member takes the
        // overridden slot even though its emitted signature differs, so a
        // caller holding the declaring type reaches it. Only references
        // qualify: a value type differs in representation from the type it
        // narrows, so no one method can answer both signatures.
        has_covariant_return_over(overridee: Function) -> bool is
            let own = return_type
            let overridden = _return_type_of(overridee)

            if !own? \/ !overridden? then
                return false
            fi

            if own.matches(overridden) then
                return false
            fi

            if
                own.is_value_type \/ overridden.is_value_type \/
                own.is_type_variable \/ overridden.is_type_variable
            then
                return false
            fi

            return overridden.is_assignable_from(own)
        si

        // What `overridee` returns, read in this function's own type
        // parameters: two declarations of one generic method name the
        // same position by different symbols.
        _return_type_of(overridee: Function) -> Types.Type? is
            if let overridden = overridee.return_type then
                return
                    GENERIC_PARAMETER_ALIGNMENT.rewrite(
                        overridden, generic_arguments, overridee.generic_arguments)
            fi

            return null
        si

        ensure_return_type_matches(into: Classy, overridee: Function, want_override: bool, logger: Logger) -> bool is
            if !into.is_reflected then
                if
                    !return_type!.matches(_return_type_of(overridee)!) /\
                    !has_covariant_return_over(overridee)
                then
                    inheritance_error(logger, into, "does not {override_verb(want_override)} {overridee} due to different return type {return_type}")

                    return false
                fi

                // Optionality is not part of the emitted signature, so a
                // method whose return type differs from its overridee's
                // only in optionality overrides it at run time regardless.
                // Widening the return to optional would let null reach
                // callers typed by the overridee. Internal functions are
                // property accessors, reported at the property level;
                // reflected overriders are imported declarations the user
                // cannot change, so they are not reported at all.
                if !is_internal /\ !is_reflected /\ return_type!.is_optional /\ !overridee.return_type!.is_optional then
                    inheritance_error(logger, into, "cannot {override_verb(want_override)} {overridee} with optional return type {return_type}")
                fi
            fi

            return true
        si

        // Arguments compare optionality-blind for override matching, so an
        // overriding method can redeclare an optional argument as
        // non-optional - but it still receives callers' optional values
        // through the overridden signature, so that narrowing is unsound.
        ensure_arguments_accept_optionals(into: Classy, overridee: Function, want_override: bool, logger: Logger) is
            if into.is_reflected \/ is_reflected \/ is_internal \/ arguments.count != overridee.arguments.count then
                return
            fi

            // The equality and order operators are exempt: an absent
            // operand is answered by the null checks the operator's
            // own lowering writes around the call, so a body declared
            // non-optional is only handed present values however the
            // overridden member spells its parameter. That makes the
            // non-optional spelling honest for an implementation, and
            // lets one implementation shape satisfy Ghul.Equatable
            // and Ghul.Comparable however their type argument renders.
            if name =~ "=~" \/ name =~ "<>" then
                return
            fi

            for i in 0..arguments.count do
                // An optional type variable is exempt: an unconstrained
                // type parameter cannot be spelled optional in source, so
                // the signature this would demand is unwritable. Reflected
                // generic interfaces declare such arguments routinely
                // (IComparer, IEqualityComparer).
                if
                    overridee.arguments[i].is_optional /\
                    !overridee.arguments[i].is_type_variable /\
                    !arguments[i].is_optional
                then
                    inheritance_error(logger, into, "cannot {override_verb(want_override)} {overridee}: argument {i + 1} must be optional")
                fi
            od
        si

        override_verb(want_override: bool) -> string static =>
            if want_override then "override" else "implement" fi

        ensure_il_name_matches(into: Classy, overridee: Function, override_type: string, logger: Logger) -> bool is
            if il_name !~ overridee.il_name then
                if il_name_override? then
                    logger.warn(
                        location,
                        "override-mismatch-il-name",
                        "does not {override_type} {overridee} due to inconsistent IL names ({il_name} vs {overridee.il_name})",
                        overridee.location,
                        "overridden member declared here")
                    return false
                else
                    il_name_override = overridee.il_name

                    if let journal = INHERITANCE_JOURNAL.current then
                        journal.record(InheritanceOp.IL_NAME_SET(self))
                    fi
                fi
            fi

            return true
        si

        declare_type(location: LOCATION, name: string, index: int, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = FUNCTION_GENERIC_ARGUMENT(location, self, name, index)

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_closure_symbol(location: LOCATION, result: Closure) -> Symbol is
            declare(location, result, null)

            return result
        si

        declare_variable(location: LOCATION, name: string, is_static: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result: Variable =
                if _declaring_arguments then
                    Symbols.LOCAL_ARGUMENT(location, self, name)
                else
                    Symbols.LOCAL_VARIABLE(location, self, name)
                fi

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_function(location: LOCATION, span: LOCATION, name: string, is_static: bool, is_private: bool, has_body: bool, is_property_accessor: bool, enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.GLOBAL_FUNCTION(location, span, self, name, enclosing)

            declare_function_group(location, result, symbol_definition_listener)

            return result
        si

        get_argument_description(index: int) -> string is
            let result = System.Text.StringBuilder()

            result
                .append(argument_names[index])
                .append(": ")
                .append(_argument_type_description(index, false))

            return result.to_string()
        si

        // A formal declared to take an argument pack spread out is
        // written `f: T.. -> U`, and the marker sits on the parameter of
        // its own function type - which the type's own rendering knows
        // nothing about, so the two halves are written out here.
        _argument_type_description(index: int, short: bool) -> string is
            let type = arguments[index]

            if !get_argument_is_pack(index) then
                return if short then type.short_description else "{type}" fi
            fi

            return _pack_marked_type_description(type, get_argument_pack_depth(index), short)
        si

        _return_type_description(short: bool) -> string is
            let type = return_type!

            if return_pack_depth < 0 then
                return if short then type.short_description else "{type}" fi
            fi

            return _pack_marked_type_description(type, return_pack_depth, short)
        si

        _pack_marked_type_description(type: Type, depth: int, short: bool) -> string is
            let slot = Semantic.ARGUMENT_PACK.marked_slot(type, depth)

            if !slot? then
                return if short then type.short_description else "{type}" fi
            fi

            let result = System.Text.StringBuilder()

            let hop mut = type

            for _ in 0..depth do
                result.append(_function_parameters_description(hop, short)).append(" -> ")

                hop = hop.arguments[hop.arguments.count - 1]
            od

            // The pack is the last parameter; any before it are the
            // formal's own, and the list is parenthesised as it is written.
            let fixed = Semantic.ARGUMENT_PACK.fixed_count(slot)

            let parameter = slot.arguments[fixed]

            let returns =
                if slot.is_action then
                    "void"
                elif short then
                    slot.arguments[fixed + 1].short_description
                else
                    "{slot.arguments[fixed + 1]}"
                fi

            let purity = if slot.is_pure_function then " pure" else "" fi

            if fixed > 0 then
                result.append("(")

                for i in 0..fixed do
                    let leading = slot.arguments[i]

                    result.append(if short then leading.short_description else "{leading}" fi).append(", ")
                od
            fi

            result.append(if short then parameter.short_description else "{parameter}" fi)
            result.append("..")

            if fixed > 0 then
                result.append(")")
            fi

            result.append(" -> ").append(returns).append(purity)

            return result.to_string()
        si

        _function_parameters_description(type: Type, short: bool) -> string is
            let count =
                if type.is_action then
                    type.arguments.count
                else
                    type.arguments.count - 1
                fi

            let result = System.Text.StringBuilder()

            if count != 1 then
                result.append("(")
            fi

            for i in 0..count do
                if i > 0 then
                    result.append(", ")
                fi

                let argument = type.arguments[i]

                result.append(if short then argument.short_description else "{argument}" fi)
            od

            if count != 1 then
                result.append(")")
            fi

            return result.to_string()
        si

        get_short_argument_description(index: int) -> string is
            let result = System.Text.StringBuilder()

            result
                .append(argument_names[index])
                .append(": ")
                .append(_argument_type_description(index, true))

            return result.to_string()
        si

        is_indexer_accessor: bool => INDEXER_NAMES.is_canonical(name)

        // The element type an indexer reads or writes: the return type of
        // the read accessor, and the value parameter of the write one,
        // whose own return type is void.
        indexer_value_type: Type? =>
            if name =~ INDEXER_NAMES.assign then
                if arguments.count > 1 then arguments[1] else null fi
            else
                return_type
            fi

        // `OWNER[index: I]: E`, with `= value` on the write accessor. The
        // caller supplies both renderings so the long and short forms
        // differ only in how their types are described.
        render_indexer_shape(index_description: string, value_description: string) -> string is
            let result = "{_display_owner_name}[{index_description}]: {value_description}"

            if name =~ INDEXER_NAMES.assign /\ argument_names.count > 1 then
                return "{result} = {argument_names[1]}"
            fi

            return result
        si

        _display_owner_name: string is
            let o = owner

            if isa Symbol(o) then
                return IoC.CONTAINER.instance.name_display.name_for(o)
            fi

            return o!.qualified_name
        si

        to_string() -> string is
            let result = System.Text.StringBuilder()

            try
                if name.starts_with("$get_") then
                    result
                        .append(_display_owner_name)
                        .append(".")
                        .append(name.substring(5))
                        .append(": ")
                        .append(return_type)
                elif name.starts_with("$set_") then
                    result
                        .append(_display_owner_name)
                        .append(".")
                        .append(name.substring(5))
                        .append(": ")
                        .append(return_type)
                        .append(" = ")
                        .append(argument_names[0])
                elif is_indexer_accessor then
                    result
                        .append(
                            render_indexer_shape(
                                "{argument_names[0]}: {arguments[0]}",
                                "{indexer_value_type}"
                            )
                        )
                else
                    result
                        .append(IoC.CONTAINER.instance.name_display.name_for(self))
                        .append(generic_argument_descriptions)
                        .append("(")
                        .append(short_argument_descriptions)
                        .append(") -> ")
                        .append(_return_type_description(false))
                fi

                return result.to_string()
            catch ex: Exception
                return "[garbled function: {result}]"
            yrt
        si

        gen_entrypoint(context: IR.CONTEXT) is
            if !is_entry_point then
                return
            fi

            context.seen_entrypoint = true

            // The entry point is marked by handle once the method's row
            // is written, so this records the function rather than
            // emitting anything here.
            context.srm_assembly_emitter.entry_point_function = self
        si

        gen_body_header(context: IR.CONTEXT) is
        si

    si

    class GLOBAL_FUNCTION: Function is
        is_public_readable: bool => !emit_assembly

        describe(context: DESCRIBE_CONTEXT) -> SignaturePart =>
            _describe_function(context, true)

        describe_kind(context: DESCRIBE_CONTEXT) -> string? =>
            "{pure_prefix}global function"

        // Set by the .NET importer when the symbol is read back from a
        // referenced assembly: the carrier class the method is a static
        // member of, which a call site's methodref hangs off. A namespace
        // can have several carriers, so the carrier is recorded rather
        // than derived from the namespace.
        il_carrier: Classy? public

        // Set for an underscore-prefixed global (or the accessor of an
        // underscore-prefixed global property) under the private/protected
        // policy: emit assembly rather than public so it is hidden from other
        // assemblies while staying reachable within this one. Globals live on
        // the synthetic $globals class, so declaring-class-private is
        // meaningless for them; assembly-internal is the whole effect.
        emit_assembly: bool public

        init(location: LOCATION, span: LOCATION, owner: Scope, name: string, enclosing_scope: Scope) is
            super.init(location, span, owner, name, enclosing_scope)
        si

        declare_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.GLOBAL_CLOSURE(location, owner, name, enclosing, is_recursive))

        declare_async_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.GLOBAL_ASYNC_CLOSURE(location, owner, name, enclosing, is_recursive))


        declare_generator_closure(location: LOCATION, name: string, owner: Scope, enclosing: Scope, is_recursive: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol =>
            declare_closure_symbol(location, Symbols.GLOBAL_GENERATOR_CLOSURE(location, owner, name, enclosing, is_recursive))

        load(location: LOCATION, from: IR.Values.Value?, loader: SYMBOL_LOADER) -> IR.Values.Value is
            if from? /\ from.is_consumable then
                IoC.CONTAINER.instance.logger.poison(location, "global function load shouldn't have a left expression")
            fi

            return loader.load_global_function(self)
        si

        call(location: Source.LOCATION, from: IR.Values.Value?, arguments: Collections.List[IR.Values.Value], type: Type?, caller: FUNCTION_CALLER) -> IR.Values.Value is
            if from? /\ from.is_consumable then
                IoC.CONTAINER.instance.logger.poison(location, "global function call shouldn't have a left expression")
            fi

            return caller.call_global_function(self, arguments, self.arguments, type)
        si

        // Method definition lives inside `.class 'NS'.'$globals' { ... }` block,
        // so the .method header has no qualifier — base (empty) gen_owner_name
        // is what we want.
        // FIXME: should storage class be split out of here:
        gen_body_header(context: IR.CONTEXT) is
            gen_entrypoint(context)
        si
    si
si
