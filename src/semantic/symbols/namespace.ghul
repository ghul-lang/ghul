namespace Semantic.Symbols is
    use System.Text.StringBuilder

    use Logging
    use Source

    use IR.Values.Value

    use Types.Type

    // FIXME: doesn't really have a type, not sure how to represent this:
    class NAMESPACE: ScopedWithEnclosingScope, NamespaceContext, Types.Typed is
        qualified_name: string

        type: Type

        short_description: string => "namespace {name}"

        describe(context: DESCRIBE_CONTEXT) -> SignaturePart is
            let qn mut = qualified_name
            if qn.starts_with('.') then
                qn = qn.substring(1)
            fi
            return PARTS.literal("namespace {qn}")
        si

        symbol_kind: SymbolKind => SymbolKind.NAMESPACE
        completion_kind: CompletionKind => CompletionKind.MODULE

        is_namespace: bool => true
        is_classy: bool => false
        is_internal: bool => false
        is_compiler_generated: bool

        // Whether every compilation imports this namespace without asking,
        // which is true of `Ghul.Intrinsics` alone. A name it holds resolves
        // bare from anywhere, so qualifying one distinguishes nothing and
        // only costs the width a signature has to wrap at. Marked by
        // whatever resolves the namespace, so nothing has to recognise it
        // by what it is called.
        is_implicitly_imported: bool

        mark_implicitly_imported() is
            is_implicitly_imported = true
        si

        init(
            location: LOCATION,
            name: string,
            enclosing_scope: Scope?,
            qualified_name: string,
            is_compiler_generated: bool
        ) is
            super.init(location, self, name, enclosing_scope)

            self.qualified_name = qualified_name
            self.is_compiler_generated = is_compiler_generated

            type = Types.NAMED(self)
        si

        qualify(name: string) -> string is
            if is_compiler_generated then
                return name
            fi

            let q = qualified_name

            if q.length > 1 then
                return "{qualified_name.substring(1)}.{name}"
            fi

            return name
        si

        find_direct(name: string) -> Symbol? is
            let declared = super.find_direct(name)

            // A declaration of any other kind hides whatever an imported
            // assembly contributes under the name; a function joins the
            // imported overloads, as one declared in another file of this
            // compilation would.
            if declared? /\ !isa Function(declared) /\ !isa FUNCTION_GROUP(declared) then
                return declared
            fi

            let imported = _find_imported(name)

            if !declared? /\ !imported? then
                return _find_old_name(name)
            elif !declared? then
                return imported
            elif !imported? then
                return declared
            fi

            return DotNet.GLOBAL_OVERLOAD_MERGE.merge([declared, imported])
        si

        // Where the core library declares the core types in source, an
        // old name such as `System.Exception` is the type it declares
        // under its ghūl name, and a namespace an old name lies in, such
        // as `System`, is a namespace, as the reflected ones are on .NET.
        _find_old_name(name: string) -> Symbol? is
            let container = IoC.CONTAINER.instance

            if container.build_flags.target != Compiler.Target.WASM then
                return null
            fi

            let qn = qualified_name.trim_start(['.'])
            let full_name = if qn.length == 0 then name else "{qn}.{name}" fi

            if let renamed = CORE_TYPE_ALIASES.renamed_in_source(full_name) then
                for home in CORE_TYPE_ALIASES.homes(renamed) do
                    let dot = home.last_index_of('.')

                    if let owner = container.namespaces.try_find_namespace(".{home.substring(0, dot)}") then
                        if let found = owner.find_direct(home.substring(dot + 1)) then
                            return found
                        fi
                    fi
                od

                return null
            fi

            if CORE_TYPE_ALIASES.is_namespace_in_source(full_name) then
                return container.namespaces.find_or_add_namespace(name, ".{full_name}", false)
            fi

            return null
        si

        _find_imported(name: string) -> Symbol? is
            let dotnet_symbol_table = IoC.CONTAINER.instance.dotnet_symbol_table.value

            let qn mut = qualified_name

            if qn =~ "." \/ qn.length == 0 then
                return null
            fi

            if qn.starts_with(".") then
                qn = qn.substring(1)
            fi

            if DotNet.HIDDEN_SYMBOLS.is_hidden_namespace(qn) then
                return null
            fi

            let direct = dotnet_symbol_table.get_symbol("{qn}.{name}")

            if direct? then
                return direct
            fi

            // Globals from a referenced assembly live as static members of
            // a synthetic `$globals` IL class. The .NET importer
            // materialises each one as a GLOBAL_FUNCTION / GLOBAL_VARIABLE /
            // GLOBAL_PROPERTY whose owner is *this* NAMESPACE - matching
            // how source-side globals are declared - but stashes them on
            // the Classy because that lookup-table outlives this
            // NAMESPACE's clear-between-compiles lifecycle. Resolving the
            // carrier name materialises every carrier the namespace has;
            // the member lookup then searches them all.
            let _ = dotnet_symbol_table.get_symbol("{qn}.{DotNet.GLOBALS_CARRIER.name}")

            return dotnet_symbol_table.find_global_member(qn, name)
        si

        // Mirrors `find_direct`: the declared symbols, and then the globals
        // an imported assembly contributes through this namespace's
        // `$globals` carriers. Without the second half a `use` of the
        // namespace makes every one of those names resolve unqualified
        // while offering none of them.
        find_direct_matches(prefix: string, matches: Collections.MutableMap[string, Symbols.Symbol]) is
            super.find_direct_matches(prefix, matches)

            let qn mut = qualified_name

            if qn =~ "." \/ qn.length == 0 then
                return
            fi

            if qn.starts_with(".") then
                qn = qn.substring(1)
            fi

            if DotNet.HIDDEN_SYMBOLS.is_hidden_namespace(qn) then
                return
            fi

            IoC.CONTAINER.instance.dotnet_symbol_table.value.find_global_member_matches(qn, prefix, matches)
        si

        find_member(name: string) -> Symbol?
            => find_direct(name)

        find_member_matches(prefix: string, matches: Collections.MutableMap[string, Symbols.Symbol]) is
            find_direct_matches(prefix, matches)

            let qn mut = qualified_name

            let namespaces = IoC.CONTAINER.instance.namespaces
            let dotnet_symbol_table = IoC.CONTAINER.instance.dotnet_symbol_table.value

            if qn =~ "." \/ qn.length == 0 then
                // FIXME: don't think this is ever hit:
                namespaces.find_root_matches(matches)
                dotnet_symbol_table.find_root_matches(matches)

                return
            fi

            if qn.starts_with(".") then
                qn = qn.substring(1)
            fi

            namespaces.find_namespace_matches(qn, matches)

            dotnet_symbol_table.find_member_matches(qn, matches)

            DotNet.HIDDEN_SYMBOLS.prune_hidden(qn, matches)
        si

        declare_namespace(location: LOCATION, name: string, `namespace: Symbols.NAMESPACE, symbol_definition_listener: SymbolDefinitionListener?) is
            declare(location, `namespace, symbol_definition_listener)
        si

        declare_class(location: LOCATION, span: LOCATION, name: string, arguments: Collections.List[string], enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.CLASS(location, span, self, name, arguments, enclosing)

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_trait(location: LOCATION, span: LOCATION, name: string, arguments: Collections.List[string], enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.TRAIT(location, span, self, name, arguments, enclosing)

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_struct(location: LOCATION, span: LOCATION, name: string, arguments: Collections.List[string], enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.STRUCT(location, span, self, name, arguments, enclosing)

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_union(location: LOCATION, span: LOCATION, name: string, arguments: Collections.List[string], enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.UNION(location, span, self, name, arguments, enclosing)

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_enum(location: LOCATION, span: LOCATION, name: string, enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.ENUM_STRUCT(location, span, self, name, self)

            declare(location, result, symbol_definition_listener)

            ENUM_ORDER_OPERATOR.register(result)
            ENUM_EQUALITY_OPERATOR.register(result)

            // The bitwise operators are registered later, once a
            // `@System.Flags()` pragma (if any) is known — see
            // RESOLVE_TYPE_EXPRESSIONS._maybe_register_enum_bitwise_operators.

            return result
        si

        declare_innate(location: LOCATION, name: string, innate_name: string, enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.INNATE_FUNCTION(location, self, name, enclosing, innate_name)

            declare_function_group(location, result, symbol_definition_listener)

            return result
        si

        declare_function(location: LOCATION, span: LOCATION, name: string, is_static: bool, is_private: bool, has_body: bool, is_property_accessor: bool, enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.GLOBAL_FUNCTION(location, span, self, name, enclosing)

            if is_private /\ IoC.CONTAINER.instance.build_flags.underscore_access != Compiler.UnderscoreAccess.LEGACY then
                result.emit_assembly = true
            fi

            declare_function_group(location, result, symbol_definition_listener)

            return result
        si

        declare_generator_function(location: LOCATION, span: LOCATION, name: string, is_static: bool, is_private: bool, has_body: bool, enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.GLOBAL_GENERATOR_FUNCTION(location, span, self, name, enclosing)

            declare_function_group(location, result, symbol_definition_listener)

            return result
        si

        declare_async_function(location: LOCATION, span: LOCATION, name: string, is_static: bool, is_private: bool, has_body: bool, enclosing: Scope, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.GLOBAL_ASYNC_FUNCTION(location, span, self, name, enclosing)

            declare_function_group(location, result, symbol_definition_listener)

            return result
        si

        declare_variable(location: LOCATION, name: string, is_static: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.GLOBAL_VARIABLE(location, self, name)

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_top_level_variable(location: LOCATION, name: string, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.TOP_LEVEL_VARIABLE(location, self, name)

            declare(location, result, symbol_definition_listener)

            return result
        si

        declare_property(location: LOCATION, span: LOCATION, name: string, is_static: bool, is_private: bool, is_assignable: bool, symbol_definition_listener: SymbolDefinitionListener?) -> Symbol is
            let result = Symbols.GLOBAL_PROPERTY(location, span, self, name, is_assignable)

            declare(location, result, symbol_definition_listener)

            return result
        si

        load(location: LOCATION, from: Value?, loader: SYMBOL_LOADER) -> Value => loader.load_namespace(self)
        // Synthetic public sealed-abstract host for this namespace's globals.
        // Importer recognises by trailing simple name `$globals`.
    si
si
