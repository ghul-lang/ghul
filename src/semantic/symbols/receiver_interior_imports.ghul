namespace Semantic.Symbols is
    // Imported functions that do write the heap, but write only their
    // own receiver's internal state, and run no user code while doing
    // it. A call to one is weaker than store-free and stronger than an
    // arbitrary call: it can change what a getter reading the receiver
    // returns, so property facts and getter-bearing paths die, but it
    // cannot change what any field holds, so field facts survive.
    //
    // The soundness argument, in two halves:
    //
    //   - Field facts survive because the state these members mutate
    //     is a BCL type's private storage. It is not addressable as a
    //     ghūl member at all, so no field fact can be about it, and a
    //     store into it cannot be a store into any ghūl field.
    //   - Property facts die because a ghūl getter can read the
    //     mutated collection — `count: int => _items.count` returns
    //     something different after `_items.add(x)`.
    //
    // The third half is what keeps the first two true: a member listed
    // here must not be able to re-enter user code, because user code
    // can store anything. That rules out every overload taking a
    // delegate or a comparer, the lookup and removal members that
    // consult a key type's equals and hash members, the members taking
    // an arbitrary sequence, and `object`-taking formatting overloads
    // that call `to_string` on their argument.
    //
    // Curation is by name, as in STORE_FREE_IMPORTS, so an entry
    // covers every overload of that name. Where a name has both safe
    // and unsafe overloads it goes in `scalar_argument_entries`
    // instead, which additionally requires every parameter to be a
    // scalar, a string or an enum — none of which can dispatch
    // anywhere under caller control: an enum cannot be inherited any
    // more than a sealed string can be overridden. That test is
    // IMPORT_ARGUMENTS, and it is still selective where it declines:
    // a `TimeSpan` and a tuple are value types whose interiors hold
    // references, and both decline.
    class RECEIVER_INTERIOR_IMPORTS is
        _entries: Collections.SET[string]? static

        // Entries safe whatever their arguments are: the receiver
        // stores the argument and never calls anything on it.
        entries() -> Collections.SET[string] static is
            if !_entries? then
                let result = Collections.SET[string]()

                // LIST: the non-virtual mutators that write the
                // backing array and the size, and call nothing on the
                // element. `remove`, `contains` and `index_of` are
                // excluded — they run the element type's equality
                // through the default comparer. `add_range`,
                // `insert_range` and `sort` are excluded — they
                // enumerate a caller-supplied sequence or run a
                // caller-supplied comparer.
                result.add("Collections.LIST.add")
                result.add("Collections.LIST.insert")
                result.add("Collections.LIST.remove_at")
                result.add("Collections.LIST.clear")
                result.add("Collections.LIST.set_Item")

                // Ghul.BOX: the value setter writes the box's own
                // backing field and calls nothing on the argument. It
                // is the store half of the captured-local plumbing the
                // read half of which is curated in STORE_FREE_IMPORTS.
                result.add("Ghul.BOX.$$set_value")
                result.add("Ghul.BOX.set_value")

                // STACK: push writes the backing array and the size,
                // pop and clear write the size and null out the slot.
                // None of them touches the element.
                result.add("Collections.STACK.push")
                result.add("Collections.STACK.pop")
                result.add("Collections.STACK.clear")

                _entries = result
            fi

            return _entries
        si

        _scalar_argument_entries: Collections.SET[string]? static

        // Entries trusted only when every parameter is a scalar or a
        // string, as IMPORT_ARGUMENTS decides it — which admits less
        // than every value type; see the class comment above. The
        // names below have overloads that do reach user
        // code — `StringBuilder.append(object)` calls `to_string` on
        // its argument — and the parameter check is what separates
        // them from the safe overloads of the same name.
        scalar_argument_entries() -> Collections.SET[string] static is
            if !_scalar_argument_entries? then
                let result = Collections.SET[string]()

                // StringBuilder is sealed, so each of these dispatches
                // to exactly one body, and each writes only the
                // builder's own chunk storage.
                result.add("Text.STRING_BUILDER.append")
                result.add("Text.STRING_BUILDER.append_line")
                result.add("Text.STRING_BUILDER.insert")
                result.add("Text.STRING_BUILDER.remove")
                result.add("Text.STRING_BUILDER.clear")

                _scalar_argument_entries = result
            fi

            return _scalar_argument_entries
        si

        writes_only_receiver_interior(function: Function?) -> bool static is
            if !function? \/ !function.is_reflected then
                return false
            fi

            let owner = function.owner

            if !owner? then
                return false
            fi

            let key = "{owner.qualified_name}.{function.name}"

            if entries().contains(key) then
                return true
            fi

            return scalar_argument_entries().contains(key) /\ IMPORT_ARGUMENTS.all_arguments_scalar(function)
        si
    si
si
