namespace Semantic.Symbols is
    // The types every target provides itself, which a backend
    // represents in its own way rather than by declaration.
    enum BuiltInType is
        VOID,
        BOOL,
        CHAR,
        BYTE,
        UBYTE,
        SHORT,
        USHORT,
        INT,
        UINT,
        LONG,
        ULONG,
        WORD,
        UWORD,
        SINGLE,
        DOUBLE
    si
si
