namespace Semantic is
    use IO.Std

    use Text.StringBuilder

    use Collections.Iterable
    use Collections.Iterator
    use Collections.List
    use Collections.LIST
    use Collections.MAP
    use Collections.SET

    use Symbols.Function

    use Types.Type

    use Ghul.Pipes

    class METHOD_OVERRIDE_CLASS is
        arguments: Type[]
        // Number of generic arguments. Functions only override / count as
        // duplicates of siblings with the same generic-argument count;
        // `foo()` and `foo[T]()` are distinct sibling functions, not one
        // overriding the other and not a duplicate.
        generic_arguments_count: int

        // The method's own type parameters, in declaration order. Two
        // declarations of the same generic method have parameters that
        // are different symbols, so one side's arguments are read in
        // the other's terms before they are compared.
        generic_arguments: Type[]

        init(arguments: Type[]) is
            init(arguments, LIST[Type]())
        si

        init(arguments: Type[], generic_arguments: Type[]) is
            assert arguments |> all(a => a?) else "override class arguments list contains null elements"

            self.arguments = arguments
            self.generic_arguments = generic_arguments
            self.generic_arguments_count = generic_arguments.count
        si

        // Declared: the loop over each argument's `matches` is
        // genuinely store-free, but the store-free walk disqualifies
        // any function containing a `for` loop unconditionally rather
        // than reasoning about the loop body.
        =~(other: METHOD_OVERRIDE_CLASS) -> bool pure is
            if other.generic_arguments_count != generic_arguments_count then
                return false
            fi

            if other.arguments.count != arguments.count then
                return false
            fi

            let theirs = _in_our_terms(other)

            for i in 0..arguments.count do
                if !arguments[i].matches(theirs[i]) then
                    return false
                fi
            od

            return true
        si

        // The positions at which `other`'s arguments differ from ours only
        // in the result of a function type, every parameter of it matching,
        // where every other argument matches; null where any argument
        // differs in more than that.
        //
        // Where the two declare different numbers of type parameters, as
        // `f[T.., N](selector: T.. -> N)` beside `f[T..](selector: T.. -> bool)`
        // do, their parameters are paired by the order each first appears
        // in the arguments, so a type parameter one side has and the other
        // doesn't is left unpaired and matches nothing of ours.
        function_results_differing_from(other: METHOD_OVERRIDE_CLASS) -> SET[int]? is
            if other.arguments.count != arguments.count then
                return null
            fi

            let theirs =
                if other.generic_arguments_count == generic_arguments_count then
                    _in_our_terms(other)
                else
                    _in_our_terms_by_occurrence(other)
                fi
            let result = SET[int]()

            for i in 0..arguments.count do
                let ours = arguments[i]

                if ours.matches(theirs[i]) then
                    continue
                fi

                if !_differs_only_in_result(ours, theirs[i]) then
                    return null
                fi

                result.add(i)
            od

            return result
        si

        _differs_only_in_result(ours: Type, theirs: Type) -> bool is
            if
                !ours.is_function \/ !theirs.is_function \/
                ours.is_action \/ theirs.is_action \/
                ours.is_pure_function != theirs.is_pure_function \/
                ours.arguments.count != theirs.arguments.count
            then
                return false
            fi

            for p in 0..ours.arguments.count - 1 do
                if !ours.arguments[p].matches(theirs.arguments[p]) then
                    return false
                fi
            od

            return true
        si

        // `other`'s arguments with each of its type parameters replaced by
        // the one of ours that first appears at the same place in the order
        // of first appearance; any left over on either side stays as it is.
        _in_our_terms_by_occurrence(other: METHOD_OVERRIDE_CLASS) -> Type[] is
            let ours = _first_appearances(arguments, generic_arguments)
            let theirs = _first_appearances(other.arguments, other.generic_arguments)
            let substitution = MAP[Symbols.Symbol, Type]()

            for i in 0..ours.count do
                if i < theirs.count then
                    substitution[theirs[i].symbol] = ours[i]
                fi
            od

            return other.arguments |> map(t => t.specialize(substitution)) |> Ghul.Intrinsics.ARRAY()
        si

        // `parameters` in the order each first appears in `types`, read
        // left to right and into each type's arguments; those that never
        // appear are left out.
        _first_appearances(types: Type[], parameters: Type[]) -> LIST[Type] static is
            let result = LIST[Type]()

            visit(type: Type) is
                for p in parameters do
                    if type.symbol == p.symbol /\ !(result |> any(r => r.symbol == p.symbol)) then
                        result.add(p)
                    fi
                od

                for a in type.arguments do
                    visit(a)
                od
            si

            for t in types do
                visit(t)
            od

            return result
        si

        // `other`'s arguments with its own type parameters replaced by
        // ours at the same position, so `describe[T](tag: T)` declared
        // twice compares equal although each `T` is its own symbol.
        _in_our_terms(other: METHOD_OVERRIDE_CLASS) -> Type[] pure =>
            Symbols.GENERIC_PARAMETER_ALIGNMENT.rewrite_all(
                other.arguments, generic_arguments, other.generic_arguments)

        equals(other: object?) -> bool is
            if !other? then
                return false
            fi

            if !isa METHOD_OVERRIDE_CLASS(other) then
                return false
            fi

            return self =~ other
        si

        get_hash_code() -> int is
            let result mut = generic_arguments_count

            // A generic method's argument types mention its own type
            // parameters, which are a different symbol in every
            // declaration, so only the shape can contribute: two that
            // compare equal have to hash equal.
            if generic_arguments_count > 0 then
                return result + arguments.count
            fi

            for a in arguments do
                result = result + a.get_hash_code()
            od

            return result
        si

        to_string() -> string => "({arguments |> join(", ")})"
    si
si
