namespace Semantic.Symbols is
    // Types the language renamed, each with the name it had before. Either
    // name finds the type where a namespace declares or imports only the
    // other, so source written against the old name still compiles, and so
    // does a library declaring the type under either.
    class FORMER_NAMES is
        _pairs: (namespace_name: string, former: string, current: string)[] static =>
            [
                ("Tasks", "TASK", "Future"),
                ("Tasks", "TaskCompletionSource", "Completer")
            ]

        // The other name of the type `namespace_name` would hold as `name`,
        // or null where it was never renamed.
        //
        // - namespace_name: the namespace's qualified name, without a leading dot
        // - name: the name looked up
        other_name(namespace_name: string, name: string) -> string? static is
            for (ns, former, current) in _pairs do
                if ns =~ namespace_name then
                    if name =~ former then
                        return current
                    elif name =~ current then
                        return former
                    fi
                fi
            od

            return null
        si

        // Whether `name` is the former name of a type in `namespace_name`.
        is_former_name(namespace_name: string, name: string) -> bool static is
            for (ns, former, _) in _pairs do
                if ns =~ namespace_name /\ name =~ former then
                    return true
                fi
            od

            return false
        si
    si
si
