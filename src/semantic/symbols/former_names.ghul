namespace Semantic.Symbols is
    use Collections.LIST
    use Collections.MAP

    // Types and functions the language moved or renamed. Each group lists
    // the places one thing has been known by: a namespace that declares or
    // imports the thing at any one of them finds it from every other, so
    // source written against an old place still compiles, and so does a
    // library declaring the thing at any of them.
    class FORMER_NAMES is
        _places: MAP[string, MAP[string, LIST[Place]]] static

        _none: LIST[Place] static

        init() static is
            _places = MAP[string, MAP[string, LIST[Place]]]()
            _none = LIST[Place]()

            _add([Place(".Concurrency", "Future"), Place(".Tasks", "Future"), Place(".Tasks", "TASK")])
            _add([Place(".Concurrency", "Completer"), Place(".Tasks", "Completer"), Place(".Tasks", "TaskCompletionSource")])
            _add([Place(".Concurrency", "TASK_BUILDER"), Place(".Tasks", "TASK_BUILDER")])

            for name in [
                "run", "sleep", "pause", "start",
                "Thread", "Mutex", "Semaphore", "Channel",
                "AtomicBool", "AtomicInt", "AtomicLong", "Atomic"
            ] do
                _add([Place(".Concurrency", name), Place(".Ghul.Threads", name)])
            od
        si

        // The other places a namespace's `name` was known by, or none where
        // it was never moved or renamed.
        //
        // - namespace_name: the qualified name the namespace is keyed under
        // - name: the name looked up
        other_places(namespace_name: string, name: string) -> LIST[Place] static is
            if _places.contains_key(namespace_name) then
                let names = _places[namespace_name]

                if names.contains_key(name) then
                    return names[name]
                fi
            fi

            return _none
        si

        _add(group: Place[]) static is
            for place in group do
                if !_places.contains_key(place.namespace_name) then
                    _places[place.namespace_name] = MAP[string, LIST[Place]]()
                fi

                let names = _places[place.namespace_name]

                if !names.contains_key(place.name) then
                    names[place.name] = LIST[Place]()
                fi

                for other in group do
                    if !(other.namespace_name =~ place.namespace_name /\ other.name =~ place.name) then
                        names[place.name].add(other)
                    fi
                od
            od
        si
    si

    // A name in a namespace, the namespace keyed under its qualified name.
    struct Place(namespace_name: string public, name: string public)
si
