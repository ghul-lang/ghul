namespace Semantic.Symbols is
    use Collections.LIST
    use Collections.MAP
    use Ghul.Pipes.any

    // Types and functions that have more than one place or spelling. Each
    // group lists every place one thing is known by: a lookup in any place
    // of a group also finds what a library declares at any other, so source
    // written for either spelling compiles against a library using either.
    class FORMER_NAMES is
        _places: MAP[string, MAP[string, LIST[Place]]] static

        _none: LIST[Place] static

        _namespaces: MAP[string, string] static

        init() static is
            _places = MAP[string, MAP[string, LIST[Place]]]()
            _none = LIST[Place]()
            _namespaces = MAP[string, string]()

            // Nothing has a former name at present. A type or function that
            // moves keeps its old place resolving with a group listing every
            // place it is known by, the current one first:
            //
            //     _add([Place(".New", "Thing"), Place(".Old", "Thing")])
            //
            // and a namespace whose members all moved, so that a `use` of it
            // still reaches them, with:
            //
            //     _namespaces["Old"] = "New"
        si

        // Tests only: records `group` as init() records a moved name.
        add_for_testing(group: Place[]) static => _add(group)

        // Tests only: records that the members of namespace `name` moved to
        // `moved_to`.
        add_moved_namespace_for_testing(name: string, moved_to: string) static is
            _namespaces[name] = moved_to
        si

        // The other places a namespace's `name` is known by, or none where
        // it has only the one.
        //
        // - namespace_name: the qualified name the namespace is keyed under
        // - name: the name looked up
        other_places(namespace_name: string, name: string) -> LIST[Place] static is
            if _places.contains_key(namespace_name) then
                let names = _places[namespace_name]

                if names.contains_key(name) then
                    return names[name]
                fi
            fi

            return _none
        si

        // The namespace that holds the members of a namespace that declares
        // none, written as source names it, or null where there is none.
        //
        // - name: the namespace as a `use` spells it
        moved_namespace(name: string) -> string? static is
            if _namespaces.contains_key(name) then
                return _namespaces[name]
            fi

            return null
        si

        _add(group: Place[]) static is
            for place in group do
                if !_places.contains_key(place.namespace_name) then
                    _places[place.namespace_name] = MAP[string, LIST[Place]]()
                fi

                let names = _places[place.namespace_name]

                if !names.contains_key(place.name) then
                    names[place.name] = LIST[Place]()
                fi

                let others = names[place.name]

                for other in group do
                    if !_same(other, place) /\ !(others |> any(o => _same(o, other))) then
                        others.add(other)
                    fi
                od
            od
        si

        _same(a: Place, b: Place) -> bool static => a.namespace_name =~ b.namespace_name /\ a.name =~ b.name
    si

    // A name in a namespace, the namespace keyed under its qualified name.
    struct Place(namespace_name: string public, name: string public)
si
