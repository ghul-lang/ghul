namespace Semantic.Symbols is
    use Types.Type

    // What a generated partial application thunk does. A thunk stands
    // for a call written with `*` for some of its arguments: it takes
    // one parameter per `*`, reads the arguments that were written out
    // from the value it was closed over, and makes the call. It has no
    // source: its body is this description, and is emitted from it.
    //
    // `call` is the call as compiled, with each `*` argument a load of
    // the thunk's parameter for it and each other argument a load of
    // the local in `fixed_locals` at the same position. The thunk is
    // closed over the values those locals hold: the one value itself
    // where there is one, boxed where it is a value type, and a boxed
    // tuple of them where there are more. With nothing fixed the thunk
    // is closed over nothing.
    class PARTIAL_THUNK is
        call: IR.Values.Value

        fixed_locals: IR.LOCAL[]

        fixed_types: Type[]

        // Whether the closed-over value arrives as an `object` to be
        // cast back, rather than as the one fixed value at its own type.
        fixed_is_boxed: bool

        init(call: IR.Values.Value, fixed_locals: IR.LOCAL[], fixed_types: Type[], fixed_is_boxed: bool) is
            self.call = call
            self.fixed_locals = fixed_locals
            self.fixed_types = fixed_types
            self.fixed_is_boxed = fixed_is_boxed
        si

        // The name of the parameter the closed-over value arrives in.
        FIXED_PARAMETER: string static => "$partial_fixed"

        // The name of the parameter standing for the `*` at `index`.
        parameter_name(index: int) -> string static => "$partial_{index}"

        takes_fixed: bool => fixed_locals.count > 0
    si
si
