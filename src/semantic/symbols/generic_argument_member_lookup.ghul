namespace Semantic.Symbols is
    use Types.Type

    // Resolves a member against each of a type variable's bounds and merges
    // what comes back, so a parameter declared `[T: A /\ B]` exposes the
    // members of both.
    //
    // Resolution over per-bound results:
    //
    //   - 0 results        → null
    //   - 1 result         → that result
    //   - all FUNCTION_GROUPs → folded with merged_over, which keeps every
    //     distinct signature and drops same-signature repeats. Shared
    //     ancestry is the common repeat (`IComparisonOperators` extends
    //     `IEqualityOperators`, so two bounds often contribute the same
    //     inherited member twice), and a genuine same-signature clash
    //     between unrelated bounds resolves to the first bound's member.
    //   - mixed kinds      → the first bound's result wins, the same
    //                        pragmatic fallback INTERSECTION.find_member
    //                        applies to a multi-trait clash.
    class GENERIC_ARGUMENT_MEMBER_LOOKUP(_bounds: Type[]) is
        find_member(name: string) -> Symbol? is
            let first: Symbol? mut = null
            let merged_group: FUNCTION_GROUP? mut = null
            let count mut = 0
            let all_groups mut = true

            for bound in _bounds do
                let result = bound.find_member(name)

                if !result? then
                    continue
                fi

                count = count + 1

                if !first? then
                    first = result
                fi

                if isa FUNCTION_GROUP(result) then
                    merged_group =
                        if let prior = merged_group then
                            prior.merged_over(result)
                        else
                            result
                        fi
                else
                    all_groups = false
                fi
            od

            if count == 0 then
                return null
            fi

            if count == 1 then
                return first
            fi

            if all_groups then
                return merged_group
            fi

            return first
        si
    si
si
