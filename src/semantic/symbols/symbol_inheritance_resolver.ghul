namespace Semantic is
    use IO.Std

    use Collections.Iterable
    use Collections.Iterator

    use Collections.SET

    use Pair = Collections.KeyValuePair

    use Symbols.Symbol
    use Symbols.Classy
    use Symbols.Function
    use Symbols.FUNCTION_GROUP

    use Types.Type

    use Logging

    use Ghul.Pipes

    // TODO this really needs cleaning up. Could use double dispatch between the overrider and the overridee
    // for non-method symbols to determine what to do, which might simplify it a bit
    class SYMBOL_INHERITANCE_RESOLVER is

        // One "declared here" related location per symbol - the prose of
        // these diagnostics lists the colliding declarations already; the
        // related locations make each of them a jump target.
        _declared_here(symbols: Iterable[Symbol]) -> Collections.LIST[RELATED_LOCATION] is
            let related = Collections.LIST[RELATED_LOCATION]()

            for symbol in symbols do
                related.add(RELATED_LOCATION(symbol.location, "declared here"))
            od

            return related
        si
        into: Classy

        init(into: Classy) is
            self.into = into
        si

        pull_down_super_symbols_into() is
            let logger = IoC.CONTAINER.instance.logger

            let members = into.get_all_direct_ancestor_members()

            let overridees = get_overridees_map(members)

            for p in overridees do
                let overridee_name = p.key
                let overridee_map = p.value

                pull_down_for_name(overridee_name, overridee_map, logger)
            od
        si

        pull_down_for_name(overridee_name: string, overridee_map: METHOD_OVERRIDE_MAP, logger: Logging.Logger) is
            let overriders = get_overriders_map_for(overridee_name)

            let overrider_other_symbol = overriders.first_symbol

            let overridee_other_symbols = overridee_map.symbols

            if overridee_map.contains_any_methods then
                for overridee_list in overridee_map do
                    let overrider_list = overriders[overridee_list.override_class]

                    try_inherit_including_methods(
                        overridee_name,
                        overrider_list,
                        overrider_other_symbol,
                        overridee_list,
                        overridee_other_symbols,
                        logger
                    )
                od

                warn_likely_override_mismatch(overridee_map, overriders, logger)
            elif overridee_map.contains_any_symbols /\ !overriders.contains_any_methods then
                try_inherit_non_methods(
                    overridee_name,
                    overrider_other_symbol,
                    overridee_other_symbols,
                    logger
                )
            fi
        si

        // When the derived class declares a method by a name that
        // also exists in an ancestor but with a different signature,
        // ghūl treats it as an overload — even when the derived's
        // argument types are narrower (`LIST[T]` vs `T[]`,
        // `Cat` vs `Animal`) and the user almost certainly meant
        // to override. There is no `override` keyword to make the
        // intent explicit, so the only way to surface this is a
        // heuristic on the inheritance walk.
        //
        // Heuristic: for each ancestor signature with no exact
        // overrider, check whether any same-named method in the
        // current class has the same arity and arg types that are
        // all subtypes of the ancestor's (with at least one strict
        // narrowing). If so, warn — the user probably intended an
        // override.
        warn_likely_override_mismatch(
            overridees: METHOD_OVERRIDE_MAP,
            overriders: METHOD_OVERRIDE_MAP,
            logger: Logging.Logger
        ) is
            if IoC.CONTAINER.instance.build_flags.no_warn_likely_override_mismatch then
                return
            fi

            if into.is_reflected then
                return
            fi

            for overridee_set in overridees do
                // Skip when an exact overrider exists — try_override
                // has already handled this signature.
                if overriders[overridee_set.override_class]? then
                    continue
                fi

                for overridee in overridee_set.iterable do
                    if overridee.is_internal \/ overridee.is_reflected then
                        continue
                    fi

                    for overrider_set in overriders do
                        // Skip when this overrider exactly overrides some
                        // *other* same-named base signature. In the visitor
                        // double-dispatch pattern the base declares both a
                        // catch-all `visit(Node)` and a per-subtype
                        // `visit(SpecificNode)`; a subclass's
                        // `visit(SpecificNode)` cleanly overrides the
                        // specific one and only looks like a narrowing
                        // mistake against the catch-all.
                        if overridees[overrider_set.override_class]? then
                            continue
                        fi

                        for overrider in overrider_set.iterable |> filter(f => f.owner == into /\ !f.is_internal) do
                            if is_likely_intended_override(overrider, overridee) then
                                logger.warn(
                                    overrider.location,
                                    "likely-override-mismatch",
                                    "{overrider} hides {overridee} due to narrower argument types",
                                    overridee.location,
                                    "hidden member declared here")
                            fi
                        od
                    od
                od
            od
        si

        // Same arity, every argument's type is a subtype of the
        // overridee's, with at least one strict narrowing. Generic-
        // type-arguments aren't compared — the heuristic stays
        // conservative; method-level generics are rare enough that
        // we don't try to be clever about them.
        is_likely_intended_override(overrider: Function, overridee: Function) -> bool is
            if overrider.arguments.count != overridee.arguments.count then
                return false
            fi

            let saw_narrowing mut = false

            for i in 0..overrider.arguments.count do
                let rider_arg = overrider.arguments[i]
                let ridee_arg = overridee.arguments[i]

                if rider_arg.matches(ridee_arg) then
                    continue
                fi

                // rider_arg is a subtype of ridee_arg iff ridee_arg
                // can be assigned from rider_arg — MATCH.ASSIGNABLE
                // means "self is assignable from other" (per
                // `feedback_dedup_use_equals_hash`).
                let match = ridee_arg.compare(rider_arg)

                if match != Types.MATCH.SAME /\ match != Types.MATCH.ASSIGNABLE then
                    return false
                fi

                if match == Types.MATCH.ASSIGNABLE then
                    saw_narrowing = true
                fi
            od

            return saw_narrowing
        si


        get_overridees_map(members: Collections.LIST[Symbol]) -> Collections.Map[string, METHOD_OVERRIDE_MAP] is
            let overridees = Collections.MAP[string,METHOD_OVERRIDE_MAP]()

            for symbol in members do
                let overridees_with_this_name: METHOD_OVERRIDE_MAP mut
                let symbol_name = symbol.name

                if !overridees.try_get_value(symbol_name, overridees_with_this_name ref) then
                    overridees_with_this_name = METHOD_OVERRIDE_MAP(symbol_name)
                    overridees[symbol_name] = overridees_with_this_name
                fi

                overridees_with_this_name.add(symbol)
            od

            return overridees
        si

        try_inherit_including_methods(
            name: string,
            overriders: METHOD_OVERRIDE_SET?,
            other_overrider_symbol: Symbol?,
            overridees: METHOD_OVERRIDE_SET,
            other_overridee_symbols: Iterable[Symbol],
            logger: Logging.Logger
        )
        is
            let is_reflected = into.is_reflected
            let other_overridee_symbols_count = other_overridee_symbols |> count()
            let overriding_method: Function? mut = null

            if overriders? then
                overriding_method = overriders.get_overrider(into)
            fi

            if overriding_method? then
                try_override_methods(overriding_method, overridees, other_overridee_symbols, is_reflected, logger)
            elif other_overrider_symbol? then
                handle_non_method_overrider(other_overrider_symbol, overridees, other_overridee_symbols, is_reflected, logger)
            elif other_overridee_symbols_count == 1 /\ overridees.count != 0 then
                into.add_member(other_overridee_symbols |> only())
            elif other_overridee_symbols_count > 0 then
                handle_multiple_symbols_with_same_name(overridees, other_overridee_symbols, into, logger)
            else
                handle_inherit_nothing_to_override(overridees, other_overridee_symbols, into, logger)
            fi
        si

        try_override_methods(
            overriding_method: Function,
            overridees: METHOD_OVERRIDE_SET,
            other_overridee_symbols: Iterable[Symbol],
            is_reflected: bool,
            logger: Logging.Logger
        )
        is
            for f in overridees.iterable do
                overriding_method.try_override(into, f, logger)
            od

            if !is_reflected then
                for os in other_overridee_symbols do
                    logger.warn(overriding_method.location, "hides-inherited", "hides {os} (case A)", os.location, "hidden declaration")
                od
            fi
        si

        handle_non_method_overrider(
            other_overrider_symbol: Symbol,
            overridees: METHOD_OVERRIDE_SET,
            other_overridee_symbols: Iterable[Symbol],
            is_reflected: bool,
            logger: Logging.Logger
        )
        is
            if !is_reflected then
                for f in overridees.iterable do
                    logger.warn(other_overrider_symbol.location, "hides-inherited", "hides {f} (case B)", f.location, "hidden declaration")
                od

                for os in other_overridee_symbols do
                    logger.warn(other_overrider_symbol.location, "hides-inherited", "hides {os} (case C)", os.location, "hidden declaration")
                od
            fi
        si

        handle_multiple_symbols_with_same_name(
            overridees: METHOD_OVERRIDE_SET,
            other_overridee_symbols: Iterable[Symbol],
            into: Classy,
            logger: Logging.Logger
        )
        is
            let all_symbols = Collections.LIST[Symbol]()

            all_symbols.add_range(
                overridees.iterable |>
                    map(function -> Symbol => function)
            )

            all_symbols.add_range(other_overridee_symbols)

            logger.error(
                into.location,
                "cannot inherit multiple symbols with the same name: {all_symbols |> sort_by(symbol => symbol.short_description) |> join()}",
                _declared_here(all_symbols)
            )
        si

        handle_inherit_nothing_to_override(
            overridees: METHOD_OVERRIDE_SET,
            other_overridee_symbols: Iterable[Symbol],
            into: Classy,
            logger: Logging.Logger
        )
        is
            let other_overridee_symbols_count = other_overridee_symbols|> count()

            if overridees.count == 1 then
                let first = overridees.iterable |> only()
                first.try_pull_down_into(into, other_overridee_symbols, logger)
            elif overridees.count == 0 then
                if other_overridee_symbols_count == 0 then
                    // nothing to do
                elif other_overridee_symbols_count == 1 then
                    let first = other_overridee_symbols |> only()
                    first.try_pull_down_into(into, other_overridee_symbols, logger)
                else
                    for os in other_overridee_symbols do
                        os.try_pull_down_into(into, other_overridee_symbols, logger)
                    od

                    logger.error(
                        into.location,
                        "cannot inherit multiple symbols with the same name: {
                            overridees.iterable |>
                                map(f => f.to_string()) |>
                                sort() |>
                                join()
                        }",
                        _declared_here(other_overridee_symbols)
                    )
                fi
            else
                handle_inherit_multiple_methods(overridees, into, logger)
            fi
        si

        handle_inherit_multiple_methods(
            overridees: METHOD_OVERRIDE_SET,
            into: Classy,
            logger: Logging.Logger
        )
        is
            let concrete: Function? mut = null
            let abstract_method: Function? mut = null

            let seen_multiple_concrete mut = false
            let seen_multiple_abstract mut = false

            for f in overridees.iterable do
                if f.is_abstract then
                    if abstract_method? then
                        seen_multiple_abstract = true
                    else
                        abstract_method = f
                    fi
                elif f.is_instance then
                    if concrete? /\ f != concrete then
                        seen_multiple_concrete = true
                    else
                        concrete = f
                    fi
                fi
            od

            if
                seen_multiple_concrete /\
                overridees.iterable |>
                    any(function => function.is_instance /\ !function.is_reflected)
            then
                let concretes =
                    overridees.iterable |>
                        filter(function => function.is_instance)

                logger
                    .error(
                        into.location,
                        "cannot inherit multiple concrete methods: {
                            concretes |>
                                map(f => f.to_string()) |>
                                sort() |>
                                join()
                        }",
                        _declared_here(concretes)
                    )

            elif concrete? then
                into.add_member(concrete)

                for f in overridees.iterable do
                    if f != concrete then
                        concrete.try_override(into, f, logger)
                    fi
                od

            elif seen_multiple_abstract /\ !into.location.is_internal then
                // METHOD_OVERRIDE_SET groups by argument signature. The
                // return types may also align: identical (a single virtual
                // slot) or form a subtype chain (C# 9-style covariant
                // returns on re-declared interface methods — e.g. EF Core's
                // IReadOnlyAnnotatable / IAnnotatable / IConventionAnnotatable
                // chain). In either case one most-derived abstract subsumes
                // the others; pull it down so a single implementation
                // satisfies every inherited slot via .NET's implicit
                // interface implementation.
                let most_derived = most_derived_abstract(overridees)

                if most_derived? then
                    most_derived.try_pull_down_into(into, Collections.LIST[Symbol](), logger)

                    for f in overridees.iterable do
                        if f != most_derived then
                            into.add_merged_slot(f.root_specialized_from, most_derived.root_specialized_from)
                        fi
                    od
                else
                    let abstracts =
                        overridees.iterable |>
                            filter(function => function.is_abstract)

                    logger.error(
                        into.location,
                        "cannot inherit multiple abstract methods: {
                            abstracts |>
                                map(f => f.to_string()) |>
                                sort() |>
                                join()
                        }",
                        _declared_here(abstracts)
                    )
                fi

            elif abstract_method? then
                into.add_member(abstract_method)
            fi
        si

        // If the inherited abstracts share name+args (guaranteed by
        // METHOD_OVERRIDE_SET grouping) AND their return types form a
        // single subtype chain — identical types being the degenerate
        // one-link case — returns the most-derived abstract. Returns
        // null when the return types are unrelated (not in a chain),
        // which is the genuine error case.
        most_derived_abstract(overridees: METHOD_OVERRIDE_SET) -> Function? is
            let abstracts = Collections.LIST[Function]()

            for f in overridees.iterable do
                if f.is_abstract then
                    abstracts.add(f)
                fi
            od

            let most_derived =
                MOST_DERIVED_TYPE_SELECTOR()
                    .select(abstracts |> map(f -> Type? => f.return_type))

            if most_derived < 0 then
                return null
            fi

            return abstracts[most_derived]
        si

        try_inherit_non_methods(
            name: string,
            overrider_symbol: Symbol?,
            overridee_symbols: Iterable[Symbol],
            logger: Logging.Logger
        )
        is
            if overrider_symbol? then
                if isa Symbols.Property(overrider_symbol) then
                    handle_property_overrider(
                        overrider_symbol, overridee_symbols, logger)
                else
                    handle_non_property_overrider(overrider_symbol, overridee_symbols, logger)
                fi

                return
            fi

            let count = overridee_symbols |> count()

            if count == 1 then
                let first = overridee_symbols |> only()

                into.add_member(first)
            elif count > 1 then
                handle_multiple_overridee_symbols(overridee_symbols, logger)
            fi
        si

        handle_property_overrider(
            overrider_symbol: Symbols.Property,
            overridee_symbols: Iterable[Symbol],
            logger: Logging.Logger
        )
        is
            for overridee in overridee_symbols do
                if isa Symbols.Property(overridee) then
                    handle_property_overridee(
                        overrider_symbol, overridee, logger)
                elif !(isa Symbols.Variable(overridee)) then
                    logger.warn(overrider_symbol.location, "hides-inherited", "{overrider_symbol} hides non-property {overridee}", overridee.location, "hidden declaration")
                fi
            od
        si

        handle_property_overridee(
            overrider_symbol: Symbols.Property,
            overridee: Symbols.Property,
            logger: Logging.Logger
        )
        is
            let overridee_type = overridee.type
            let overrider_type = overrider_symbol.type

            if !overridee_type? \/ !overrider_type? then
                return
            fi

            if !overridee_type.is_assignable_from(overrider_type) then
                // Optionality is not part of the emitted accessor
                // signature, so a property differing from its overridee
                // only in optionality overrides it at run time no matter
                // what is decided here. Widening to optional would let
                // null reach readers typed by the overridee, so it cannot
                // be allowed to stand; genuinely different types really
                // do hide, and keep the warning.
                if !overrider_symbol.is_reflected /\ overrider_type.matches(overridee_type) /\ overrider_type.is_optional /\ !overridee_type.is_optional then
                    logger.error(overrider_symbol.location, "cannot override {overridee} with optional type {overrider_type}", overridee.location, "overridden declaration")
                elif overrider_symbol.is_reflected then
                    // Imported declarations model optionality more loosely
                    // than ghūl does, so a redeclaration that only widens
                    // to optional reads here as a type mismatch. It still
                    // hides, but there is nothing to report about it.
                    return
                elif overridee.is_instance /\ overrider_symbol.is_instance then
                    logger.warn(overrider_symbol.location, "override-mismatch-type", "{overrider_symbol} does not override {overridee} due to non-assignable type ({overrider_symbol.type} vs {overridee.type})", overridee.location, "declared here")
                    return
                else
                    logger.warn(overrider_symbol.location, "hides-inherited", "{overrider_symbol} hides {overridee}", overridee.location, "hidden declaration")
                    return
                fi
            elif
                !overrider_symbol.is_reflected /\
                overridee.is_assignable /\
                overrider_type.matches(overridee_type) /\
                !overrider_type.is_optional /\ overridee_type.is_optional
            then
                // Tightening an assignable property to non-optional is
                // unsound in the assign direction: writers typed by the
                // overridee can still store an absent value.
                logger.error(overrider_symbol.location, "cannot override assignable {overridee} with non-optional type {overrider_type}", overridee.location, "overridden declaration")
            fi

            let overrides mut = true

            if overridee.is_assignable then
                let overridee_assign_is_default_trait =
                    overridee.assign_function? /\ overridee.assign_function.is_default_trait_method

                if overridee.is_private then
                    if !overrider_symbol.is_assignable then
                        logger.warn(overrider_symbol.location, "override-missing-assign-accessor", "does not override assign accessor for {overridee}", overridee.location, "assign accessor declared here")
                    fi
                else
                    if !overrider_symbol.is_assignable /\ !overrider_symbol.is_reflected then
                        if overridee_assign_is_default_trait then
                            // Inherit the trait's default assign accessor when the
                            // overrider only redeclares the read half.
                            overrider_symbol.assign_function = overridee.assign_function
                            overrider_symbol.is_assignable = true

                            if let journal = Symbols.INHERITANCE_JOURNAL.current then
                                journal.record(Symbols.InheritanceOp.PROPERTY_ASSIGN_INHERITED(overrider_symbol))
                            fi
                        else
                            logger.error(overrider_symbol.location, "does not override public assign accessor for {overridee}", overridee.location, "assign accessor declared here")
                        fi
                    elif overrider_symbol.is_private then
                        logger.error(overrider_symbol.location, "hides public assign accessor for {overridee}", overridee.location, "assign accessor declared here")
                    fi
                fi
            fi

            if overrider_symbol.il_name_override? then
                if overridee.il_name_override? /\ overrider_symbol.il_name_override !~ overridee.il_name_override then
                    logger.warn(overrider_symbol.location, "override-mismatch-il-name", "{overrider_symbol} does not override {overridee} due to different IL name ({overrider_symbol.il_name_override} vs {overridee.il_name_override})", overridee.location, "declared here")
                    overrides = false
                fi
            else
                overrider_symbol.il_name_override = overridee.il_name_override

                if overrider_symbol.il_name_override? then
                    if let journal = Symbols.INHERITANCE_JOURNAL.current then
                        journal.record(Symbols.InheritanceOp.IL_NAME_SET(overrider_symbol))
                    fi
                fi
            fi

            if overrides then
                overrider_symbol.add_overridee(overridee)
                overridee.add_overrider(overrider_symbol)

                let read_is_default = overridee.read_function? /\ overridee.read_function.is_default_trait_method
                let assign_is_default = overridee.assign_function? /\ overridee.assign_function.is_default_trait_method

                if let overridee_owner = cast Symbols.Classy?(overridee.owner) /\ (read_is_default \/ assign_is_default) then
                    Symbols.INEFFECTIVE_TRAIT_OVERRIDE_CHECKER()
                        .check(
                            into,
                            overrider_symbol.location,
                            overrider_symbol.to_string(),
                            overridee,
                            overridee.name,
                            overridee_owner,
                            logger
                        )
                fi
            fi
        si

        handle_non_property_overrider(
            overrider_symbol: Symbol,
            overridee_symbols: Iterable[Symbol],
            logger: Logging.Logger
        )
        is
            if overrider_symbol.can_hide_inherited then
                // we don't care if this particular symbol hides an inherited symbol
                return
            fi

            for overridee in overridee_symbols do
                if !(isa Symbols.Variable(overridee)) /\ !overridee.can_hide_inherited then
                    logger.info(overrider_symbol.location, "overrider {overrider_symbol.get_type()} hides overridee {overridee.get_type()}")
                    logger.warn(
                        overrider_symbol.location,
                        "hides-inherited",
                        "{overrider_symbol} hides (case 3): {overridee_symbols |> join(", ")}",
                        overridee.location,
                        "hidden declaration")
                fi
            od
        si

        handle_multiple_overridee_symbols(
            overridee_symbols: Iterable[Symbol],
            logger: Logging.Logger
        )
        is
            let symbols = overridee_symbols |> collect_mutable()

            let properties = Collections.LIST[Symbol]()
            let any_non_properties mut = false

            for s in symbols do
                if isa Symbols.Property(s) then
                    properties.add(s)
                else
                    any_non_properties = true
                    break
                fi
            od

            // Same reasoning as the abstract-method case: an interface
            // hierarchy that redeclares a property covariantly reaches an
            // implementing type once per level, and the most derived
            // declaration subsumes the rest.
            let most_derived =
                if any_non_properties then
                    -1
                else
                    MOST_DERIVED_TYPE_SELECTOR().select(properties |> map(s -> Type? => s.type))
                fi

            let inconsistent_types = !any_non_properties /\ most_derived < 0

            let property: Symbol? mut = null

            if most_derived >= 0 then
                property = properties[most_derived]
            fi

            if any_non_properties then
                logger.error(
                    into.location,
                    "cannot inherit multiple symbols with the same name {
                    symbols |>
                        map(s => s.to_string()) |>
                        sort() |>
                        join()
                    }"
                )
            elif inconsistent_types then
                logger.error(
                    into.location,
                    "cannot inherit multiple properties with the same name but different types {
                        symbols |>
                            map(s => s.to_string()) |>
                            sort() |>
                            join()
                    }"
                )
            elif property? then
                into.add_member(property)
            else
                logger.error(
                    into.location,
                    "did nothing with multiple parent symbols {
                        symbols |>
                            map(s => s.to_string()) |>
                            sort() |>
                            join()
                    }"
                )
            fi
        si

        get_overriders_map_for(overridee_name: string) -> METHOD_OVERRIDE_MAP is
            let symbol = into.find_direct(overridee_name)

            if !symbol? then
                return METHOD_OVERRIDE_MAP.empty
            fi

            let result = METHOD_OVERRIDE_MAP(overridee_name)

            if isa FUNCTION_GROUP(symbol) then
                for f in symbol.functions do
                    result.add(f)
                od
            elif !symbol.is_type_variable then
                result.add(symbol)
            fi

            return result
        si
    si
si
