namespace Semantic.Lookups is
    use Types.Type
    use Types.NAMED

    // The magic types the compiler needs by name (the array, pointer
    // and reference shapes, the scalar types, the function and tuple
    // shapes), resolved out of the `Ghul.Intrinsics` namespace of the
    // loaded runtime.
    class GHUL_INNATE_TYPE_LOOKUP(_symbol_table: SYMBOL_TABLE) is
        // Innates found in source rather than reflected, held for the life
        // of the process so a rebuild can't replace them.
        //
        // Reflected symbols are cached in `DotNet.SYMBOL_STORE`, which is
        // never cleared, so a reflected member's signature keeps whichever
        // innate types were current when it materialized. Every project
        // that references the runtime reaches reflected innates too, so
        // both sides hold the same symbols however often the source symbol
        // table is rebuilt. The assembly that *declares* the innates has no
        // such assembly to reach and resolves them out of its own source,
        // which a rebuild discards and re-declares - leaving every retained
        // reflected signature pointing at innates nothing else uses any
        // more. The two then render alike and compare unequal: `cannot
        // return value of type T[] where T[] expected` on a reflected call
        // returning an array, and a failed overload match on any reflected
        // `out` parameter.
        //
        // Only the source ones are held, on `is_reflected` rather than on
        // which scope the name was found in - the declaring assembly emits
        // them under a staging namespace, so that is where a reflected copy
        // surfaces too. A reflected innate is already stable, and holding
        // one keeps a symbol whose owning namespace the next rebuild
        // replaces.
        //
        // And only the shapes below, which are reached from here and never
        // spelled in source, so nothing else can hold a competing view of
        // them. A scalar is spelled all over the source that declares it,
        // where it resolves against the current symbol table - hold one and
        // a declared `x: int` stops matching an integer literal, which is
        // this same failure with the sides swapped.
        HELD_SHAPES: Collections.SET[string] static

        FUSION_COMBINATOR_ROLES: Collections.LIST[string] static
        EARLY_EXIT_NAMES: Collections.LIST[string] static
        WHOLE_READ_NAMES: Collections.LIST[string] static

        _source_declared: Collections.MAP[string, Semantic.Symbols.Symbol]

        _fusion_functions: Collections.MAP[Semantic.Symbols.Symbol, string]?
        _fusion_functions_pipes: Scope?

        _unbounded_sources: Collections.SET[Semantic.Symbols.Symbol]?
        _unbounded_sources_pipes: Scope?

        _source_reads: Collections.MAP[Semantic.Symbols.Symbol, bool]?
        _source_reads_pipes: Scope?

        init() static is
            HELD_SHAPES = Collections.SET[string](["ARRAY", "POINTER", "REFERENCE"])
            EARLY_EXIT_NAMES = Collections.LIST[string]([
                "first", "first_map", "first_or_throw", "first_map_or_throw",
                "find", "find_map", "find_or_throw", "find_map_or_throw",
                "any", "all", "only", "take", "take_while"
            ])
            WHOLE_READ_NAMES = Collections.LIST[string]([
                "sort", "sort_descending", "sort_by", "sort_by_descending",
                "reverse", "group", "group_by", "transpose", "permutations"
            ])
            FUSION_COMBINATOR_ROLES = Collections.LIST[string]([
                "map", "filter", "take", "skip", "memo", "index",
                "count", "any", "all", "each", "reduce", "find", "first", "collect_list", "collect_mutable",
                "collect", "collect_array", "sum", "sum_by", "join"
            ])
        si

        init(..) is
            _source_declared = Collections.MAP[string, Semantic.Symbols.Symbol]()
        si

        // The runtime's ordinary `Ghul` namespace, home of the library
        // types the lookup consults directly - `Ghul.Pipes` fusion and
        // slice/join combinators.
        namespace_scope: Scope => cast Scope(_symbol_table.global_scope.find_direct("Ghul")!)

        // `Ghul.Intrinsics`, the namespace every compilation imports as
        // its ambient set. The magic types materialize here under the
        // type map's placement, and the intrinsic operators are
        // registered into it from the assembly's staging namespace.
        // Absent while the namespace symbols are still being declared:
        // declaring a sibling namespace under `Ghul` checks whether the
        // name is already a reflected global, which materializes the
        // `Ghul` globals carrier, whose members reach here for the array
        // shape before the creator has got as far as `Intrinsics`.
        intrinsics_scope: Scope? is
            if let ghul = cast Scope?(_symbol_table.global_scope.find_direct("Ghul")) then
                let intrinsics = cast Scope?(ghul.find_direct("Intrinsics"))

                // Resolving it here is what establishes which namespace is
                // the ambient one, so the mark rendering reads is set from
                // the symbol rather than from anything's name.
                if let marked: Semantic.Symbols.NAMESPACE = intrinsics then
                    marked.mark_implicitly_imported()
                fi

                return intrinsics
            fi

            return null
        si

        // `Ghul.Pipes.slice`, which an index by a `System.Range` lowers to.
        slice_functions: Semantic.Symbols.FUNCTION_GROUP? is
            if let pipes = cast Scope?(namespace_scope.find_direct("Pipes")) then
                return cast Semantic.Symbols.FUNCTION_GROUP?(pipes.find_direct("slice"))
            fi

            return null
        si

        // `Ghul.Pipes.join`, which a generator frame's ToString calls to
        // stringify itself the way the Pipe trait's own default does.
        join_functions: Semantic.Symbols.FUNCTION_GROUP? is
            if let pipes = cast Scope?(namespace_scope.find_direct("Pipes")) then
                return cast Semantic.Symbols.FUNCTION_GROUP?(pipes.find_direct("join"))
            fi

            return null
        si

        // `Ghul.Intrinsics.$`, which an interpolated value its type gives
        // no text of its own is rendered through.
        display_functions: Semantic.Symbols.FUNCTION_GROUP? is
            if let intrinsics = intrinsics_scope then
                return cast Semantic.Symbols.FUNCTION_GROUP?(intrinsics.find_direct("$"))
            fi

            return null
        si

        // `Ghul.Pipes.render_elements`, which a generator frame's ToString
        // calls where the runtime has it.
        render_elements_functions: Semantic.Symbols.FUNCTION_GROUP? is
            if let pipes = cast Scope?(namespace_scope.find_direct("Pipes")) then
                return cast Semantic.Symbols.FUNCTION_GROUP?(pipes.find_direct("render_elements"))
            fi

            return null
        si

        // The `Ghul.Pipes` combinators pipe fusion recognises, keyed by
        // the resolved root Function with the combinator's fusion role
        // as the value - the one place a runtime rename changes what
        // fuses. Keys go through `root_specialized_from` so a call that
        // resolved to a specialization matches its declaration. Empty
        // when the runtime namespace is absent, leaving fusion declining
        // to fire.
        //
        // Held against the `Ghul.Pipes` namespace symbol it was resolved
        // from. Reflected symbols are stable for the process, but the
        // compilation that declares the combinators re-declares them per
        // rebuild, and a map held across one would compare against
        // symbols from a symbol table that no longer exists and quietly
        // match nothing. A rebuild replaces the namespace symbol too, so
        // the map is rebuilt exactly when that symbol is no longer the
        // one it was resolved from.
        fusion_functions: Collections.MAP[Semantic.Symbols.Symbol, string] is
            let pipes = cast Scope?(namespace_scope.find_direct("Pipes"))

            if _fusion_functions? /\ _fusion_functions_pipes == pipes then
                return _fusion_functions
            fi

            let result = Collections.MAP[Semantic.Symbols.Symbol, string]()

            if pipes? then
                for name in FUSION_COMBINATOR_ROLES do
                    let found = pipes.find_direct(name)

                    if let group: Semantic.Symbols.FUNCTION_GROUP = found then
                        for f in group.functions do
                            result[f.root_specialized_from] = name
                        od
                    elif let f: Semantic.Symbols.Function = found then
                        result[f.root_specialized_from] = name
                    fi
                od
            fi

            _fusion_functions = result
            _fusion_functions_pipes = pipes

            return result
        si

        // The `Ghul.Pipes` sources that never end: every `from`, and the
        // `repeat` that takes no count. Keyed and held the way
        // fusion_functions is, and empty when the runtime namespace is
        // absent.
        unbounded_sources: Collections.SET[Semantic.Symbols.Symbol] is
            let pipes = cast Scope?(namespace_scope.find_direct("Pipes"))

            if _unbounded_sources? /\ _unbounded_sources_pipes == pipes then
                return _unbounded_sources
            fi

            let result = Collections.SET[Semantic.Symbols.Symbol]()

            if pipes? then
                if let group: Semantic.Symbols.FUNCTION_GROUP = pipes.find_direct("from") then
                    for f in group.functions do
                        result.add(f.root_specialized_from)
                    od
                fi

                if let group: Semantic.Symbols.FUNCTION_GROUP = pipes.find_direct("repeat") then
                    for f in group.functions do
                        if f.argument_names.count == 1 then
                            result.add(f.root_specialized_from)
                        fi
                    od
                fi
            fi

            _unbounded_sources = result
            _unbounded_sources_pipes = pipes

            return result
        si

        // How far the `Ghul.Pipes` functions that read their source other
        // than one element at a time read it: true for those that can stop
        // before it ends (the terminals that answer from a prefix, and the
        // stages that pass only a prefix on), false for the stages that
        // read all of it before passing anything on. Keyed and held the
        // way unbounded_sources is.
        source_reads: Collections.MAP[Semantic.Symbols.Symbol, bool] is
            let pipes = cast Scope?(namespace_scope.find_direct("Pipes"))

            if _source_reads? /\ _source_reads_pipes == pipes then
                return _source_reads
            fi

            let result = Collections.MAP[Semantic.Symbols.Symbol, bool]()

            if pipes? then
                for (names, stops_early) in [(EARLY_EXIT_NAMES, true), (WHOLE_READ_NAMES, false)] do
                    for name in names do
                        if let group: Semantic.Symbols.FUNCTION_GROUP = pipes.find_direct(name) then
                            for f in group.functions do
                                result[f.root_specialized_from] = stops_early
                            od
                        fi
                    od
                od
            fi

            _source_reads = result
            _source_reads_pipes = pipes

            return result
        si

        // Whether `function` is one of the `Ghul.Pipes` functions.
        is_pipes_function(function: Semantic.Symbols.Function) -> bool is
            let pipes = cast Scope?(namespace_scope.find_direct("Pipes"))
            let root = function.root_specialized_from

            if let group: Semantic.Symbols.FUNCTION_GROUP = pipes?.find_direct(root.name) then
                return group.functions |> Ghul.Pipes.any(f => f.root_specialized_from == root)
            fi

            return false
        si

        get_type(
            name: string,
            create: (
                Source.LOCATION,
                Semantic.Symbols.Classy
            ) -> Type
        ) -> Type =>
            create(
                Source.LOCATION.internal,
                get_class(name)
            )

        get_type(
            name: string,
            type: Types.Type,
            create: (
                Source.LOCATION,
                Semantic.Symbols.Classy,
                Collections.List[Types.Type]
            ) -> Type
        ) -> Type
            => get_type(name, Collections.LIST[Types.Type]([type]), -1, create)

        get_type(
            name: string,
            types: Collections.List[Types.Type],
            create: (
                Source.LOCATION,
                Semantic.Symbols.Classy,
                Collections.List[Types.Type]
            ) -> Type
        ) -> Type
            => get_type(name, types, 0, create)

        get_type(
            name: string mut,
            types: Collections.List[Types.Type],
            exclude_count: int,
            create: (
                Source.LOCATION,
                Semantic.Symbols.Classy,
                Collections.List[Types.Type]
            ) -> Type
        ) -> Type
        is
            if types.count > 0 then
                if exclude_count >= 0 then
                    name = "{name}_{types.count - exclude_count}"
                fi

                let symbol = get_class(name)

                let result = create(
                    Source.LOCATION.internal,
                    symbol,
                    types
                )

                return result
            else
                return get_type("{name}_0")
            fi
        si

        get_type(name: string) -> Type
            => NAMED(get_class(name))

        get_class(name: string) -> Semantic.Symbols.Classy
            => cast Semantic.Symbols.Classy?(get_symbol(name))!

        get_symbol(name: string) -> Semantic.Symbols.Symbol is
            let held: Semantic.Symbols.Symbol mut

            if _source_declared.try_get_value(name, held ref) then
                return held
            fi

            let result: Semantic.Symbols.Symbol? mut = null

            if let scope = intrinsics_scope then
                result = scope.find_direct(name)

                // The compilation that declares the innate shapes writes them
                // in a nested `Staging` namespace, so it can declare them and
                // still be built by a compiler that reflects them. They are
                // only ever reached from here, never spelled in source, so a
                // fallback is enough - they need no name in `Ghul.Intrinsics`.
                if !result? then
                    if let nested = cast Scope?(scope.find_direct("Staging")) then
                        result = nested.find_direct(name)
                    fi
                fi
            else
                // Before the namespace symbol exists only a reflected innate
                // can be wanted, and by-name lookup is what the symbol's own
                // `find_direct` would reach for it.
                result = IoC.CONTAINER.instance.dotnet_symbol_table.value.get_symbol("Ghul.Intrinsics.{name}")
            fi

            assert result?
                else "could not find innate symbol {name}"

            if HELD_SHAPES.contains(name) /\ !result.is_reflected then
                _source_declared.add(name, result)
            fi

            return result
        si

        get_enum_type(type: Types.Type) -> Type =>
            get_type(
                "ENUM",
                type,
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy,
                    types: Collections.List[Types.Type]
                ) =>
                    Semantic.Types.ENUM(location, symbol, types)
            )

        get_tuple_type(
            types: Collections.List[Types.Type],
            names: Collections.List[string?]?
        ) -> Type =>
            get_type(
                "TUPLE",
                types,
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy,
                    types: Collections.List[Types.Type]
                ) =>
                    Semantic.Types.TUPLE(location, symbol, types, names)
            )

        get_function_type(types: Collections.List[Types.Type]) -> Type is
            if types[types.count - 1].symbol != get_void_type().symbol then
                return get_type(
                    "FUNCTION",
                    types,
                    1,
                    (
                        location: Source.LOCATION,
                        symbol: Semantic.Symbols.Classy,
                        types: Collections.List[Types.Type]
                    ) =>
                        Semantic.Types.FUNCTION(location, symbol, types)
                )
            elif types.count == 1 then
                let result = get_type(
                    "ACTION_0",
                    (
                        location: Source.LOCATION,
                        symbol: Semantic.Symbols.Classy
                    ) =>
                        Semantic.Types.ACTION_0(symbol)
                )

                return result
            else
                let action_types = Collections.LIST[Types.Type](types.count - 1)

                for i in 0..types.count - 1 do
                    action_types.add(types[i])
                od

                let result = get_type(
                    "ACTION",
                    action_types,
                    0,
                    (
                        location: Source.LOCATION,
                        symbol: Semantic.Symbols.Classy,
                        types: Collections.List[Types.Type]
                    ) =>
                        Semantic.Types.FUNCTION(location, symbol, types)
                )

                return result
            fi
        si

        get_function_type(types: Collections.List[Types.Type], is_pure: bool) -> Type is
            if !is_pure then
                return get_function_type(types)
            fi

            if types[types.count - 1].symbol != get_void_type().symbol then
                return get_type(
                    "FUNCTION",
                    types,
                    1,
                    (
                        location: Source.LOCATION,
                        symbol: Semantic.Symbols.Classy,
                        types: Collections.List[Types.Type]
                    ) =>
                        Semantic.Types.PURE_FUNCTION(location, symbol, types)
                )
            elif types.count == 1 then
                // no pure shape for the zero-argument void form —
                // dropping the marker is conservative
                return get_function_type(types)
            else
                let action_types = Collections.LIST[Types.Type](types.count - 1)

                for i in 0..types.count - 1 do
                    action_types.add(types[i])
                od

                return get_type(
                    "ACTION",
                    action_types,
                    0,
                    (
                        location: Source.LOCATION,
                        symbol: Semantic.Symbols.Classy,
                        types: Collections.List[Types.Type]
                    ) =>
                        Semantic.Types.PURE_FUNCTION(location, symbol, types)
                )
            fi
        si

        get_array_type(type: Types.Type) -> Type =>
            get_type(
                "ARRAY",
                type,
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy,
                    types: Collections.List[Types.Type]
                ) =>
                    Semantic.Types.ARRAY(location, symbol, types)
            )

        get_pointer_type(type: Types.Type) -> Type =>
            get_type(
                "POINTER",
                type,
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy,
                    types: Collections.List[Types.Type]
                ) =>
                    Semantic.Types.POINTER(location, symbol, types)
            )

        get_reference_type(type: Types.Type) -> Type =>
            get_type(
                "REFERENCE",
                type,
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy,
                    types: Collections.List[Types.Type]
                ) =>
                    Semantic.Types.REFERENCE(location, symbol, types)
            )

        get_bool_type() -> Type =>
            get_type(
                "bool",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) =>
                    NAMED(symbol)
            )


        get_char_type() -> Type =>
            get_type(
                "char",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) =>
                    NAMED(symbol)
            )

        get_byte_type() -> Type =>
            get_type(
                "byte",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_ubyte_type() -> Type =>
            get_type(
                "ubyte",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_short_type() -> Type =>
            get_type(
                "short",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_ushort_type() -> Type =>
            get_type(
                "ushort",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_int_type() -> Type =>
            get_type(
                "int",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_uint_type() -> Type =>
            get_type(
                "uint",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_long_type() -> Type =>
            get_type(
                "long",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_ulong_type() -> Type =>
            get_type(
                "ulong",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_word_type() -> Type =>
            get_type(
                "word",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_uword_type() -> Type =>
            get_type(
                "uword",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_single_type() -> Type =>
            get_type(
                "single",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_double_type() -> Type =>
            get_type(
                "double",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_decimal_type() -> Type =>
            get_type(
                "decimal",
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy
                ) => NAMED(symbol)
            )

        get_void_type() -> Type =>
            get_type("void")

        get_box_type(type: Types.Type) -> Type =>
            get_type(
                "BOX",
                type,
                (
                    location: Source.LOCATION,
                    symbol: Semantic.Symbols.Classy,
                    types: Collections.List[Types.Type]
                ) =>
                    Semantic.Types.GENERIC(location, symbol, types)
            )
    si
si
