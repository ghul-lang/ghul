namespace Semantic.Lookups is
    use IO.Std
    use TYPE = System.Type
    use Symbol = Symbols.Symbol
    use Type = Types.Type

    // Open so the unit-test assembly can stand in for it. Nothing
    // outside this compilation implements it otherwise.
    trait InnateSymbolLookup open is
        get_enum_type() -> Type
        get_tuple_type(types: Collections.List[Type], names: Collections.List[string?]?) -> Type
        get_function_type(types: Collections.List[Type]) -> Type

        // As above; `is_pure` true builds the `pure`-marked shape
        // (see Types.PURE_FUNCTION). The zero-argument void form has
        // no pure shape yet and falls back to the plain one.
        get_function_type(types: Collections.List[Type], is_pure: bool) -> Type

        get_array_type(type: Type) -> Type

        // The value-type `T?` — NULLABLE[type] (System.Nullable[type]).
        get_optional_type(type: Type) -> Type

        // The unconstrained-T `T?` — `Ghul.MAYBE[type]`, the
        // runtime struct that carries either an absent or a present
        // value of `type`. Null when the runtime is unavailable
        // (compiling `ghul-runtime` itself), mirroring
        // `get_unspecialized_pipe_type`: the caller
        // reports a clearer error than the generic
        // `Ghul.MAYBE not found` would.
        get_maybe_type(type: Type) -> Type?

        // `System.Collections.Generic.EqualityComparer[type]`, the
        // comparer a value-equality test over a bare type parameter
        // goes through. Null when the type cannot be resolved, leaving
        // the caller to report the ordinary no-operator error.
        get_equality_comparer_type(type: Type) -> Type?

        // `Collections.LIST[type]`, or null where it cannot be reached.
        get_list_type(type: Type) -> Type?

        get_pointer_type(type: Type) -> Type

        get_reference_type(type: Type) -> Type

        get_bool_type() -> Type

        get_char_type() -> Type

        get_byte_type() -> Type

        get_ubyte_type() -> Type

        get_short_type() -> Type

        get_ushort_type() -> Type

        get_int_type() -> Type

        get_uint_type() -> Type

        get_long_type() -> Type

        get_ulong_type() -> Type

        get_word_type() -> Type

        get_uword_type() -> Type

        get_single_type() -> Type

        get_double_type() -> Type

        get_decimal_type() -> Type

        get_bigint_type() -> Type

        get_void_type() -> Type

        get_object_type() -> Type

        get_value_type() -> Type

        get_string_type() -> Type

        get_exception_type() -> Type

        // The two failure kinds a user-defined conversion can report, so
        // a `cast T?(...)` over one can answer absence for both.
        get_invalid_cast_exception_type() -> Type

        get_overflow_exception_type() -> Type

        get_type_type() -> Type

        get_unspecialized_iterable_type() -> Type
        get_unspecialized_list_type() -> Type

        // Collections.LIST, the mutable list, before any type argument
        // is supplied. A fused collect fills one specialized over the
        // chain's element type.
        get_unspecialized_mutable_list_type() -> Type

        // The two range types, or absent where there is no ghul-runtime
        // assembly to find them in - which is every compilation of the
        // runtime itself, where they are source symbols in the project.
        // get_int_range_type and get_int_range_inclusive_type above throw
        // there; a caller that only wants to recognise a range, and can
        // do without, asks for these.
        get_int_range_types() -> (exclusive: Type, inclusive: Type)?

        get_unspecialized_iterator_type() -> Type

        // `Ghul.Pipes.Pipe[T]` — the required return type of a
        // generator function. Optional because the runtime assembly
        // is not loadable while the compiler is building it. Null
        // means "Pipe is unavailable in this compilation" and callers
        // fall back to the bare Iterable[T] / Iterator[T] element
        // extraction.
        get_unspecialized_pipe_type() -> Type?

        // Async-related types are optional for the same reason. Each
        // call site null-checks before using the result; the function path
        // returns null up the chain to mean "absent, classify this
        // function as non-async / skip the state-machine emission".
        get_unspecialized_task_type() -> Type?

        get_interpolated_string_handler_type() -> Type

        get_idisposable_type() -> Type

        // `System.MulticastDelegate` — the ancestry test that
        // recognises a .NET delegate type. Null when the type cannot
        // be resolved, in which case nothing is a named delegate.
        get_multicast_delegate_type() -> Type?

        // Ghul.BOX[T] — the single-field mutable cell used to
        // share mutation between a closure body and its enclosing
        // scope. The compiler's `mark-boxed-locals` pass marks
        // captured-and-reassigned locals; emission queries this
        // for the slot type and frame field type.
        get_box_type(type: Type) -> Type

        // `System.Range`, and the `Ghul.SLICE[E]` that backs the
        // injected `[System.Range]` indexer.
        get_range_type() -> Type

        // `Ghul.INT_RANGE` and `Ghul.INT_RANGE_INCLUSIVE`, the types `..`
        // and `::` produce.
        get_int_range_type() -> Type
        get_int_range_inclusive_type() -> Type

        // `Ghul.Pipes.slice`, which an index by a range lowers to.
        get_slice_functions() -> Symbols.FUNCTION_GROUP?

        // `Ghul.Pipes.join`, which a generator frame's ToString calls
        // to stringify itself the way the Pipe trait's own default does.
        get_join_functions() -> Symbols.FUNCTION_GROUP?

        // The runtime's `$`, which renders a value as text. Absent from a
        // runtime older than the one that introduced it.
        get_display_functions() -> Symbols.FUNCTION_GROUP?

        // `Ghul.Pipes.render_elements`, which renders a sequence as its
        // elements in brackets. Absent from a runtime older than the one
        // that introduced it.
        get_render_elements_functions() -> Symbols.FUNCTION_GROUP?

        // The `Ghul.Pipes` combinators pipe fusion recognises, keyed by
        // the resolved root Function with the combinator's fusion role
        // as the value. Empty when the runtime is unavailable, leaving
        // fusion declining to fire.
        get_pipes_fusion_functions() -> Collections.MAP[Symbols.Symbol, string]

        // The `Ghul.Pipes` functions whose result never ends.
        get_pipes_unbounded_sources() -> Collections.SET[Symbols.Symbol]

        // Whether `function` is one of the `Ghul.Pipes` functions.
        is_pipes_function(function: Symbols.Function) -> bool

        // Whether `function` is a `Ghul.Pipes` function that can stop
        // reading its source before the source ends.
        stops_early(function: Symbols.Function) -> bool

        // Whether `function` is a `Ghul.Pipes` stage that reads all of its
        // source before passing anything on.
        reads_whole_source(function: Symbols.Function) -> bool

        // Whether a call to `function` returns a sequence that holds a
        // resource until it is disposed.
        holds_resource(function: Symbols.Function) -> bool

        // System.Threading.Tasks.Task[T] specialised over `type`.
        // compile-lambdas uses it to build the inferred return-type
        // placeholder for `Expressions.FUNCTION`s whose body
        // contains a `let await` (so the synthesised continuation
        // lambdas inherit a `Tasks.TASK[?]` context for the
        // existing `T → TASK[T]` auto-wrap to fire).
        get_task_type(type: Type) -> Type?

        // The non-generic `System.Threading.Tasks.Task` — used as
        // the inferred return type of an async lambda that has
        // no value-returning `return X;` statements (every
        // `return;` is bare and end-of-body fallthrough produces
        // a completed Task). Distinct from
        // `get_unspecialized_task_type` which returns the open
        // generic `Task`1` used to recognise constructed
        // `Task[T]` shapes.
        get_void_task_type() -> Type?

        // `System.Runtime.CompilerServices.AsyncTaskMethodBuilder<T>` —
        // the builder field type on a value-async state machine.
        // The state machine's outer method creates the builder via
        // `AsyncTaskMethodBuilder<T>.Create()`, calls `Start(ref this)`
        // to begin MoveNext, then returns `.Task`. Each value-async
        // function reaches here with its result type so the builder
        // is instantiated correctly.
        get_async_task_method_builder_type(type: Type) -> Type?

        // The non-generic `System.Runtime.CompilerServices.AsyncTaskMethodBuilder`
        // for void-async (return type is the non-generic `Tasks.TASK`).
        get_async_task_method_builder_void_type() -> Type?

        // `System.Runtime.CompilerServices.IAsyncStateMachine` —
        // the interface the async frame implements (MoveNext +
        // SetStateMachine).
        get_async_state_machine_interface_type() -> Type?

        // `System.Runtime.CompilerServices.INotifyCompletion` and
        // `ICriticalNotifyCompletion` — an awaiter implements one of
        // them, and which one decides how the continuation is
        // registered with the builder.
        get_notify_completion_type() -> Type?

        get_critical_notify_completion_type() -> Type?

        // Gives the built-ins a last chance to take ancestry from what
        // the compilation declares, once the library's types exist.
        // The reflected lookup needs nothing: its built-ins carry
        // their ancestry from the assemblies they came from.
        wire_declared_ancestry() is si

    si
si
