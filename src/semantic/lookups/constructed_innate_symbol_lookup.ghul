namespace Semantic.Lookups is
    use Source.LOCATION

    use Collections.LIST
    use Collections.List

    use Types

    // The built-in types as symbols constructed in code, for a target
    // that loads no assemblies. The scalars, `object`, `string` and the
    // generic families the language itself defines are declared into
    // `Ghul.Intrinsics` — the namespace every compilation imports — so
    // ordinary name resolution finds them with no resolver changes.
    // Their members are not constructed here: the core library supplies
    // those, and the find-only types (`Exception`, `Iterable`, the task
    // types) are looked up in what the compilation declares, answering
    // absent when the library has not declared them yet.
    class CONSTRUCTED_INNATE_SYMBOL_LOOKUP(
        _symbol_table: Semantic.SYMBOL_TABLE,
        _namespaces: Semantic.NAMESPACES,
        _source: GHUL_INNATE_TYPE_LOOKUP,
        _logger: Logging.Logger
    ): InnateSymbolLookup is
        _object_type: Type
        _string_type: Type
        _bigint_type: Type
        _value_type: Type
        _enum_type: Type
        _nullable: Semantic.Symbols.Classy
        _iterator: Semantic.Symbols.Classy
        _array: Semantic.Symbols.Classy
        _is_array_wired: bool
        _wired_list_ancestor: Type?

        // What construction declared into `Ghul.Intrinsics`, and the
        // members each of those started with, so that a rebuild can put
        // back exactly that.
        _built_ins: LIST[Semantic.Symbols.Symbol]
        _built_in_members: LIST[(scope: Semantic.Symbols.Scoped, names: Collections.SET[string])]
        _reported_missing: Collections.SET[string]

        init(..) is
            _reported_missing = Collections.SET[string]()

            let intrinsics = _intrinsics_namespace()

            // The two roots come first: every other built-in takes one of
            // them as its implicit ancestor, as a source-declared type of
            // the same kind does - a class or trait `object`, a struct
            // `ValueType` - and type parameters take `object`.
            let object_class =
                cast Semantic.Symbols.CLASS?(
                    intrinsics.declare_class(
                        LOCATION.internal,
                        LOCATION.internal,
                        "object",
                        LIST[string](),
                        intrinsics,
                        null))!

            // The roots are open, as the reflected System.Object,
            // System.ValueType and System.Enum are: a type that derives from
            // one is not an alternative of a closed set, and inference never
            // widens a value to one. The value-type root is marked as the
            // reflected one is, so a join never settles on it either.
            object_class.mark_is_object()
            object_class.mark_open()
            _object_type = Types.NAMED(object_class)

            // The value-type base is constructed rather than declared:
            // no program names it, and the compiler needs it before any
            // source could have declared it.
            let value_type_class =
                Symbols.CLASS(
                    LOCATION.internal,
                    LOCATION.internal,
                    intrinsics,
                    "ValueType",
                    LIST[string](),
                    intrinsics)

            value_type_class.mark_is_root_value_type()
            value_type_class.mark_open()
            value_type_class.push_ancestor(_object_type)
            _value_type = Types.NAMED(value_type_class)

            // The enum base is constructed the same way, for the same
            // reasons: every enum takes it as an ancestor, and every cast
            // asks for it.
            let enum_class =
                Symbols.CLASS(
                    LOCATION.internal,
                    LOCATION.internal,
                    intrinsics,
                    "Enum",
                    LIST[string](),
                    intrinsics)

            enum_class.mark_open()
            enum_class.push_ancestor(_value_type)
            _enum_type = Types.NAMED(enum_class)

            let scalars = _declare_scalars(intrinsics)
            _declare_families(intrinsics)

            _string_type = Types.NAMED(_declare_class(intrinsics, "string"))
            let bigint_struct = _declare_struct(intrinsics, "bigint", null)

            _bigint_type = Types.NAMED(bigint_struct)

            // A scalar is constructed from a bigint too, converting as `cast`
            // does through the conversion the core library declares.
            _declare_scalar_conversions(scalars.structs, LIST[Semantic.Symbols.STRUCT]([bigint_struct]), scalars.void_type)

            // `T?` over a value type has no user-spellable name, so the
            // carrier is constructed against the namespace without being
            // declared into it: reachable from here, invisible to name
            // resolution.
            _nullable =
                cast Semantic.Symbols.Classy?(
                    Symbols.STRUCT(
                        LOCATION.internal,
                        LOCATION.internal,
                        intrinsics,
                        "NULLABLE",
                        LIST[string](["T"]),
                        intrinsics))!

            _nullable.push_ancestor(_value_type)

            // The two members every value-type optional is read through: a
            // presence test reads `has_value`, and a narrowed read projects
            // the payload through `value`. Each lowers to an operation on
            // the carrier rather than to a call.
            _declare_innate_property(_nullable, "value", _nullable.type_parameter_at(0)!.type!, "nullable.value")
            _declare_innate_property(_nullable, "has_value", get_bool_type(), "nullable.has_value")

            // The iterator type, where the compilation declares no
            // `Collections.Iterator`: constructed, undeclared, and so on no
            // type's ancestry, so nothing implements it.
            _iterator =
                cast Semantic.Symbols.Classy?(
                    Symbols.TRAIT(
                        LOCATION.internal,
                        LOCATION.internal,
                        intrinsics,
                        "Iterator",
                        LIST[string](["T"]),
                        intrinsics))!

            _built_ins = LIST[Semantic.Symbols.Symbol](intrinsics.symbols)
            _built_in_members = LIST[(scope: Semantic.Symbols.Scoped, names: Collections.SET[string])]()

            for symbol in _built_ins do
                if let scoped: Semantic.Symbols.Scoped = symbol then
                    let names = Collections.SET[string]()

                    for member in scoped.symbols do
                        names.add(member.name)
                    od

                    _built_in_members.add((scoped, names))
                fi
            od
        si

        // `Ghul.Intrinsics` is materialised before any pass runs on
        // every target, so it exists by the time the first lookup
        // constructs: the built-in types are declared into it, and the
        // ambient `use` every namespace block gets finds them.
        _intrinsics_namespace() -> Semantic.Symbols.NAMESPACE is
            let intrinsics = _namespaces.try_find_namespace(".Ghul.Intrinsics")

            assert intrinsics?
                else "Ghul.Intrinsics should be materialised before the constructed lookup builds"

            return intrinsics!
        si

        // Declares the scalar types, and answers them and void for the
        // conversions declared from types constructed later.
        _declare_scalars(intrinsics: Semantic.Symbols.NAMESPACE) -> (structs: List[Semantic.Symbols.STRUCT], void_type: Type) is
            // A VOID_STRUCT, as the reflected void is, since that is what
            // answers is_void.
            let void_struct =
                Symbols.VOID_STRUCT(
                    LOCATION.internal, LOCATION.internal, intrinsics, "void", LIST[string](), intrinsics)

            void_struct.built_in_type = Symbols.BuiltInType.VOID
            void_struct.push_ancestor(_value_type)

            intrinsics.declare(LOCATION.internal, void_struct, null)

            _declare_struct(intrinsics, "bool", Symbols.BuiltInType.BOOL)

            let scalars = LIST[Semantic.Symbols.STRUCT]([
                _declare_struct(intrinsics, "char", Symbols.BuiltInType.CHAR),
                _declare_struct(intrinsics, "byte", Symbols.BuiltInType.BYTE),
                _declare_struct(intrinsics, "ubyte", Symbols.BuiltInType.UBYTE),
                _declare_struct(intrinsics, "short", Symbols.BuiltInType.SHORT),
                _declare_struct(intrinsics, "ushort", Symbols.BuiltInType.USHORT),
                _declare_struct(intrinsics, "int", Symbols.BuiltInType.INT),
                _declare_struct(intrinsics, "uint", Symbols.BuiltInType.UINT),
                _declare_struct(intrinsics, "long", Symbols.BuiltInType.LONG),
                _declare_struct(intrinsics, "ulong", Symbols.BuiltInType.ULONG),
                _declare_struct(intrinsics, "word", Symbols.BuiltInType.WORD),
                _declare_struct(intrinsics, "uword", Symbols.BuiltInType.UWORD),
                _declare_struct(intrinsics, "single", Symbols.BuiltInType.SINGLE),
                _declare_struct(intrinsics, "double", Symbols.BuiltInType.DOUBLE)
            ])

            _declare_struct(intrinsics, "decimal", null)

            let void_type = Types.NAMED(void_struct)

            _declare_scalar_conversions(scalars, scalars, void_type)

            return (structs = scalars, void_type = void_type)
        si

        // A scalar type is constructed from any other scalar, converting the
        // way `cast` does: `double(n)` is `cast double(n)`. The .NET target
        // gives the reflected scalar types the same constructors.
        _declare_scalar_conversions(owners: List[Semantic.Symbols.STRUCT], sources: List[Semantic.Symbols.STRUCT], void_type: Type) is
            for owner in owners do
                for source in sources do
                    let result = Symbols.STRUCT_METHOD(LOCATION.internal, LOCATION.internal, owner, "init", owner)

                    result.argument_names = LIST[string](["value"])
                    result.arguments = LIST[Type]([Types.NAMED(source)])
                    result.return_type = void_type
                    result.is_scalar_conversion = true
                    result.mark_declared_pure()
                    result.mark_synthesized()

                    owner.add_member(result)
                od
            od
        si

        _declare_families(intrinsics: Semantic.Symbols.NAMESPACE) is
            for i in 1::8 do
                _declare_with_arity(intrinsics, "TUPLE_{i}", i, true)
            od

            for i in 0::16 do
                _declare_with_arity(intrinsics, "FUNCTION_{i}", i + 1, false)
            od

            for i in 0::16 do
                _declare_with_arity(intrinsics, "ACTION_{i}", i, false)
            od

            // The three shapes the runtime's own intrinsics declare in
            // source; under this target nothing declares them, so the
            // carrier symbols are constructed here for the lookups
            // below to specialise.
            // The array family is a class here: the core library gives it
            // members with bodies, so a value of it is dispatched through
            // a trait it implements as any class's is.
            _array =
                cast Semantic.Symbols.Classy?(
                    intrinsics.declare_class(
                        LOCATION.internal,
                        LOCATION.internal,
                        "ARRAY",
                        LIST[string](["E"]),
                        intrinsics,
                        null))!

            _array.push_ancestor(_object_type)
            _declare_type_arguments(_array, LIST[string](["E"]))

            _declare_with_arity(intrinsics, "REFERENCE", 1, true)
            _declare_with_arity(intrinsics, "POINTER", 1, true)
        si

        _type_argument_names(arity: int) -> List[string] is
            let result = LIST[string](arity)

            for i in 1::arity do
                result.add("T{i}")
            od

            return result
        si

        _declare_with_arity(intrinsics: Semantic.Symbols.NAMESPACE, name: string, arity: int, want_struct: bool) is
            let arguments = _type_argument_names(arity)

            let declared =
                if want_struct then
                    intrinsics.declare_struct(
                        LOCATION.internal, LOCATION.internal, name, arguments, intrinsics, null)
                else
                    intrinsics.declare_class(
                        LOCATION.internal, LOCATION.internal, name, arguments, intrinsics, null)
                fi

            let family = cast Semantic.Symbols.Classy?(declared)!

            family.push_ancestor(if want_struct then _value_type else _object_type fi)

            _declare_type_arguments(family, arguments)
        si

        // A source-declared type's parameters are declared into its own
        // scope, which is what makes them visible inside a `partial`
        // block that reopens it, and take `object` as their implicit
        // ancestor, which is what makes them assignable to it. The
        // constructed families are reopened the same way by the core
        // library, so their parameters need the same declaration.
        _declare_type_arguments(type: Semantic.Symbols.Classy?, arguments: List[string]) is
            if !type? then
                return
            fi

            let ancestors = LIST[Type]()
            ancestors.add(_object_type)
            let index mut = 0

            for name in arguments do
                let argument = type.declare_type(LOCATION.internal, name, index, null)
                argument.set_ancestor_types(ancestors)
                index = index + 1
            od
        si

        _declare_struct(
            intrinsics: Semantic.Symbols.NAMESPACE,
            name: string,
            built_in: Symbols.BuiltInType?) -> Semantic.Symbols.STRUCT is
            let result =
                cast Semantic.Symbols.STRUCT?(
                    intrinsics.declare_struct(
                        LOCATION.internal,
                        LOCATION.internal,
                        name,
                        LIST[string](),
                        intrinsics,
                        null))!

            if let marker = built_in then
                result.built_in_type = marker
            fi

            result.push_ancestor(_value_type)

            return result
        si

        _declare_class(intrinsics: Semantic.Symbols.NAMESPACE, name: string) -> Semantic.Symbols.CLASS is
            let result =
                cast Semantic.Symbols.CLASS?(
                    intrinsics.declare_class(
                        LOCATION.internal,
                        LOCATION.internal,
                        name,
                        LIST[string](),
                        intrinsics,
                        null))!

            result.push_ancestor(_object_type)

            return result
        si

        // The types this compilation declares, searched by qualified
        // name. A find-only type the library has not declared yet
        // answers absent, which is what lets the library start as
        // stubs.
        _find_declared(qualified_name: string) -> Type? is
            let parts = LIST[string]()

            for part in _split(qualified_name, '.') do
                parts.add(part)
            od

            let scope: Semantic.Scope? mut = _symbol_table.global_scope

            while parts.count > 0 /\ scope? do
                let name = parts[0]
                parts.remove_at(0)

                let found = scope.find_direct(name)

                if !found? then
                    return null
                fi

                scope = cast Semantic.Scope?(found)
            od

            if let reached = scope then
                if let symbol = cast Semantic.Symbols.Classy?(reached) then
                    return Types.NAMED(symbol)
                fi
            fi

            return null
        si

        _split(text: string, separator: char) -> List[string] is
            let result = LIST[string]()

            let current = System.Text.StringBuilder()

            for c in text do
                if c == separator then
                    result.add("{current}")
                    current.clear()
                else
                    current.append(c)
                fi
            od

            result.add("{current}")

            return result
        si

        // A read-only instance property on `owner` whose getter lowers to
        // `operation` rather than to a call.
        _declare_innate_property(owner: Semantic.Symbols.Classy, name: string, type: Type, operation: string) is
            let property = cast Semantic.Symbols.Property(
                owner.declare_property(LOCATION.internal, LOCATION.internal, name, false, false, false, null))

            let getter = Semantic.Symbols.INNATE_METHOD(LOCATION.internal, owner, name, owner, operation)

            getter.arguments = LIST[Type]()
            getter.argument_names = LIST[string]()
            getter.return_type = type
            getter.mark_declared_pure()

            property.set_type(type)
            property.read_function = getter
        si

        // A type the language needs and the core library has not declared.
        // The fault is in the library rather than the source being compiled,
        // so it is reported once and every use carries on with the error type.
        _required(what: string) -> Type is
            if _reported_missing.add(what) then
                _logger.environment_error(LOCATION.internal, "the core library does not declare {what}")
            fi

            return Types.ERROR()
        si

        get_enum_type() -> Type => _enum_type
        get_tuple_type(types: List[Type], names: List[string?]?) -> Type => _source.get_tuple_type(types, names)
        get_function_type(types: List[Type]) -> Type => _source.get_function_type(types)
        get_function_type(types: List[Type], is_pure: bool) -> Type => _source.get_function_type(types, is_pure)
        get_array_type(type: Type) -> Type => _source.get_array_type(type)
        get_optional_type(type: Type) -> Type => Types.NULLABLE(LOCATION.internal, _nullable, LIST[Type]([type]))

        get_maybe_type(type: Type) -> Type? is
            if let maybe = _find_declared("Ghul.MAYBE") then
                if let classy = cast Semantic.Symbols.Classy?(maybe.symbol) then
                    return Types.GENERIC(LOCATION.internal, classy, LIST[Type]([type]))
                fi
            fi

            return null
        si

        get_equality_comparer_type(type: Type) -> Type? => null

        compares_by_instantiation: bool => true
        get_list_type(type: Type) -> Type? is
            if let list = _find_declared("Collections.LIST") then
                if let classy = cast Semantic.Symbols.Classy?(list.symbol) then
                    return Types.GENERIC(LOCATION.internal, classy, LIST[Type]([type]))
                fi
            fi

            return null
        si

        get_pointer_type(type: Type) -> Type => _source.get_pointer_type(type)
        get_reference_type(type: Type) -> Type => _source.get_reference_type(type)

        get_bool_type() -> Type => _source.get_bool_type()
        get_char_type() -> Type => _source.get_char_type()
        get_byte_type() -> Type => _source.get_byte_type()
        get_ubyte_type() -> Type => _source.get_ubyte_type()
        get_short_type() -> Type => _source.get_short_type()
        get_ushort_type() -> Type => _source.get_ushort_type()
        get_int_type() -> Type => _source.get_int_type()
        get_uint_type() -> Type => _source.get_uint_type()
        get_long_type() -> Type => _source.get_long_type()
        get_ulong_type() -> Type => _source.get_ulong_type()
        get_word_type() -> Type => _source.get_word_type()
        get_uword_type() -> Type => _source.get_uword_type()
        get_single_type() -> Type => _source.get_single_type()
        get_double_type() -> Type => _source.get_double_type()
        get_decimal_type() -> Type => _source.get_decimal_type()
        get_bigint_type() -> Type => _bigint_type
        get_void_type() -> Type => _source.get_void_type()
        get_object_type() -> Type => _object_type
        get_value_type() -> Type => _value_type
        get_string_type() -> Type => _string_type

        get_exception_type() -> Type is
            if let found = _find_declared("Ghul.Exception") then
                return found
            fi

            return _required("Ghul.Exception")
        si

        find_exception_type() -> Type? => _find_declared("Ghul.Exception")

        get_invalid_cast_exception_type() -> Type is
            if let found = _find_declared("Ghul.InvalidCastException") then
                return found
            fi

            return _required("Ghul.InvalidCastException")
        si

        get_overflow_exception_type() -> Type is
            if let found = _find_declared("Ghul.OverflowException") then
                return found
            fi

            return _required("Ghul.OverflowException")
        si

        get_type_type() -> Type is
            if let found = _find_declared("Ghul.Type") then
                return found
            fi

            return _required("Ghul.Type")
        si

        get_unspecialized_iterable_type() -> Type is
            if let found = _find_declared("Collections.Iterable") then
                return found
            fi

            return _required("Collections.Iterable")
        si

        get_unspecialized_list_type() -> Type is
            if let found = _find_declared("Collections.List") then
                return found
            fi

            return _required("Collections.List")
        si

        get_unspecialized_mutable_list_type() -> Type is
            if let found = _find_declared("Collections.LIST") then
                return found
            fi

            return _required("Collections.LIST")
        si

        // The runtime declares the array family as
        // `trait ARRAY[E]: Collections.List[E]`, so an array is a List
        // and an Iterable of its element. Under this target the core
        // library declares List, so the constructed family takes that
        // ancestor from the compilation once its declarations exist. A
        // compilation that declares no List leaves arrays without one.
        wire_declared_ancestry() is
            if _is_array_wired then
                return
            fi

            let list = cast Semantic.Symbols.Classy?(
                cast Types.NAMED?(_find_declared("Collections.List"))?.symbol)

            if !list? then
                return
            fi

            let element = _array.type_parameter_at(0)?.type

            if !element? then
                return
            fi

            let arguments = LIST[Type]()
            arguments.add(element)

            let ancestor = Types.GENERIC(LOCATION.internal, list, arguments)

            _array.add_ancestor(ancestor)
            _wired_list_ancestor = ancestor
            _is_array_wired = true
        si

        // Puts the built-ins back as construction left them: what the
        // last build pulled down into them, what its partial blocks added
        // and the List it wired arrays to all belong to symbols the
        // rebuild has abandoned.
        redeclare_built_ins() is
            for (scope, names) in _built_in_members do
                if let classy: Semantic.Symbols.Classy = scope then
                    classy.reset_pulled_down_symbols()
                fi

                for member in LIST[Semantic.Symbols.Symbol](scope.symbols) do
                    if !names.contains(member.name) then
                        scope.remove_direct(member.name)
                    fi
                od
            od

            if let wired = _wired_list_ancestor then
                _array.remove_ancestor(wired)
                _wired_list_ancestor = null
                _is_array_wired = false
            fi

            let intrinsics = _intrinsics_namespace()

            for symbol in _built_ins do
                intrinsics.put_direct(symbol.name, symbol)
            od
        si

        get_int_range_types() -> (exclusive: Type, inclusive: Type)? is
            let exclusive = _find_declared("Ghul.INT_RANGE")
            let inclusive = _find_declared("Ghul.INT_RANGE_INCLUSIVE")

            if exclusive? /\ inclusive? then
                return (exclusive, inclusive)
            fi

            return null
        si

        get_unspecialized_iterator_type() -> Type =>
            _find_declared("Collections.Iterator") ?? Types.NAMED(_iterator)
        get_unspecialized_pipe_type() -> Type? => _find_declared("Ghul.Pipes.Pipe")
        get_unspecialized_task_type() -> Type? => null

        // The core library declares the builder in `Text`, as .NET names
        // it, or in an earlier home where it predates the move.
        get_interpolated_string_handler_type() -> Type is
            for home in CORE_TYPE_ALIASES.homes("Text.STRING_BUILDER") do
                if let found = _find_declared(home) then
                    return found
                fi
            od

            return _required("the interpolated string handler")
        si

        get_idisposable_type() -> Type is
            if let found = _find_declared("Ghul.Disposable") then
                return found
            fi

            return _required("Ghul.Disposable")
        si

        get_multicast_delegate_type() -> Type? => null

        get_box_type(type: Type) -> Type is
            if let box = _find_declared("Ghul.BOX") then
                if let classy = cast Semantic.Symbols.Classy?(box.symbol) then
                    return Types.GENERIC(LOCATION.internal, classy, LIST[Type]([type]))
                fi
            fi

            return _required("Ghul.BOX")
        si

        get_range_type() -> Type is
            if let found = _find_declared("System.Range") then
                return found
            fi

            return _required("System.Range")
        si

        get_int_range_type() -> Type is
            if let found = _find_declared("Ghul.INT_RANGE") then
                return found
            fi

            return _required("Ghul.INT_RANGE")
        si

        get_int_range_inclusive_type() -> Type is
            if let found = _find_declared("Ghul.INT_RANGE_INCLUSIVE") then
                return found
            fi

            return _required("Ghul.INT_RANGE_INCLUSIVE")
        si

        get_slice_functions() -> Semantic.Symbols.FUNCTION_GROUP? => _source.slice_functions
        get_join_functions() -> Semantic.Symbols.FUNCTION_GROUP? => _source.join_functions
        get_display_functions() -> Semantic.Symbols.FUNCTION_GROUP? => _source.display_functions
        get_render_elements_functions() -> Semantic.Symbols.FUNCTION_GROUP? => _source.render_elements_functions
        get_pipes_fusion_functions() -> Collections.MAP[Semantic.Symbols.Symbol, string] => _source.fusion_functions
        get_pipes_unbounded_sources() -> Collections.SET[Semantic.Symbols.Symbol] => _source.unbounded_sources

        is_pipes_function(function: Semantic.Symbols.Function) -> bool => _source.is_pipes_function(function)
        stops_early(function: Semantic.Symbols.Function) -> bool => false
        reads_whole_source(function: Semantic.Symbols.Function) -> bool => false
        holds_resource(function: Semantic.Symbols.Function) -> bool => false

        get_task_type(type: Type) -> Type? => null
        get_void_task_type() -> Type? => null
        get_async_task_method_builder_type(type: Type) -> Type? => null
        get_async_task_method_builder_void_type() -> Type? => null
        get_async_state_machine_interface_type() -> Type? => null
        get_notify_completion_type() -> Type? => null
        get_critical_notify_completion_type() -> Type? => null
    si
si
