namespace Semantic is
    use Types.Type

    // What a list literal's elements are expected to be where the literal
    // is expected to be a sequence type: what iterating that type yields.
    // That is the row, `T[]`, of a `T[,]`, which is a `List[T[]]`, rather
    // than its type argument. A type that isn't a sequence answers its
    // element type, as a reference or optional does, and so does any type
    // where there is no `lookup` to find the sequence trait with.
    class SEQUENCE_ELEMENT is
        of(type: Type, lookup: Lookups.InnateSymbolLookup?) -> Type? static is
            if let iterable = lookup?.find_unspecialized_iterable_type() then
                let iterable_trait = iterable.symbol?.root_unspecialized_symbol

                if iterable_trait? /\ type.symbol?.root_unspecialized_symbol != iterable_trait then
                    if let ancestor = type.find_ancestor(iterable) /\ ancestor.arguments.count == 1 then
                        return ancestor.arguments[0]
                    fi
                fi
            fi

            return type.get_element_type()
        si
    si
si
