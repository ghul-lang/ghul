@@IF.dotnet()

namespace Semantic.DotNet is
    use TYPE = System.Type

    use Collections.Iterable
    use Collections.List
    use Collections.MAP
    use Collections.LIST

    trait TypeSource is
        on_start(callback: () -> void)

        // assume assembly is System.Runtime:
        get_type(type_name: string) -> TYPE

        // use assembly_name if non-null, otherwise assume assembly is System.Runtime:
        get_type(assembly_name: string?, type_name: string) -> TYPE

        // assume assembly is System.Runtime:
        get_types(type_names: Iterable[string]) -> TYPE[]

        // use assembly_name if non-null, otherwise assume assembly is System.Runtime:
        get_types(assembly_and_type_names: Iterable[(assembly_name: string, type_name: string)]) -> TYPE[]

        // The nullability bytes for each interface `declaring_type`
        // implements directly, keyed by `INTERFACE_NULLABILITY.key_for`'s
        // reduction of the interface's own `Type` — see that class for
        // why this can't be answered through ordinary reflection. Empty
        // when there's nothing to say.
        interface_nullability_bytes(declaring_type: TYPE) -> MAP[TYPE,LIST[int]]
    si
si
