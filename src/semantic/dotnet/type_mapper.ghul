@@IF.dotnet()

namespace Semantic.DotNet is
    use IO.Std

    use TYPE = Ghul.Type
    use System.Reflection

    use Collections.LIST
    use Collections.MAP

    use Logging

    use Types.Type
    use Types.NAMED
    use Types.ERROR

    class TypeCreator(_mapper: TYPE_MAPPER) is
        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type
    si

    class GENERIC_TYPE_CREATOR(mapper: TYPE_MAPPER): TypeCreator is
        super(mapper)

        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type is
            let result: Type mut

            if type.is_generic_type_definition then
                result = GENERIC_TYPE_WRAPPER(symbol_table, _mapper, type)

                return result
            elif type.is_generic_type then
                result = GENERIC_TYPE_WRAPPER(symbol_table, _mapper, type)

                return result
            fi

            throw Ghul.InvalidOperationException("don't know how to create type: {type}")
        si
    si

    class ACTION_0_TYPE_CREATOR: TypeCreator is
        init(mapper: TYPE_MAPPER) is
            super.init(mapper)
        si

        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type =>
            ACTION_0_TYPE_WRAPPER(symbol_table, type)
    si

    class ACTION_TYPE_CREATOR: TypeCreator is
        init(mapper: TYPE_MAPPER) is
            super.init(mapper)
        si

        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type =>
             ACTION_TYPE_WRAPPER(symbol_table, _mapper, type)
    si

    class FUNCTION_TYPE_CREATOR: TypeCreator is
        init(mapper: TYPE_MAPPER) is
            super.init(mapper)
        si

        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type =>
            FUNCTION_TYPE_WRAPPER(symbol_table, _mapper, type)
    si

    class TUPLE_TYPE_CREATOR: TypeCreator is
        init(mapper: TYPE_MAPPER) is
            super.init(mapper)
        si

        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type =>
            TUPLE_TYPE_WRAPPER(symbol_table, _mapper, type, null)
    si

    class NULLABLE_TYPE_CREATOR: TypeCreator is
        init(mapper: TYPE_MAPPER) is
            super.init(mapper)
        si

        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type =>
            NULLABLE_TYPE_WRAPPER(symbol_table, _mapper, type)
    si

    class MAYBE_TYPE_CREATOR: TypeCreator is
        init(mapper: TYPE_MAPPER) is
            super.init(mapper)
        si

        create(symbol_table: SYMBOL_TABLE, type: TYPE) -> Type =>
            MAYBE_TYPE_WRAPPER(symbol_table, _mapper, type)
    si

    class TYPE_MAPPER is
        _symbol_table: Ghul.Lazy[SYMBOL_TABLE]
        _innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        _type_name_map: TYPE_NAME_MAP

        _generic_type_creator: TypeCreator
        _type_creators: MAP[TYPE,TypeCreator]

        _type_source: TypeSource

        // we don't need to intern types for correctness, but expecting to encounter a lot of references
        // to identical types, so interning them will result in lower memory usage and fewer calls into the
        // symbol table/symbol cache to materialize the associated ghul symbols
        _type_cache: MAP[TYPE,Type]

        init(
            symbol_table: Ghul.Lazy[SYMBOL_TABLE],
            innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup,
            type_name_map: TYPE_NAME_MAP,
            type_source: TypeSource
        ) is
            _symbol_table = symbol_table
            _innate_symbol_lookup = innate_symbol_lookup
            _type_name_map = type_name_map

            _type_source = type_source

            _type_cache = MAP()

            _generic_type_creator = GENERIC_TYPE_CREATOR(self)

            _type_creators = MAP()

            _type_source.on_start(() -> void is start(); si)
        si

        start() is
            let action_0_type_creator = ACTION_0_TYPE_CREATOR(self)
            let action_type_creator = ACTION_TYPE_CREATOR(self)
            let function_type_creator = FUNCTION_TYPE_CREATOR(self)
            let tuple_type_creator = TUPLE_TYPE_CREATOR(self)

            _type_creators.add(_type_source.get_type("System.Nullable`1"), NULLABLE_TYPE_CREATOR(self))

            // Registration is best-effort — when the compiler is
            // building ghul-runtime itself, the `ghul-runtime`
            // assembly is not in the loaded-assembly map, so the
            // lookup throws. In that case there are no reflected
            // MAYBE instances anyway, so the creator is never
            // consulted; leaving it unregistered is correct.
            try
                _type_creators.add(_type_source.get_type("ghul-runtime", "Ghul.MAYBE"), MAYBE_TYPE_CREATOR(self))
            catch ex: Ghul.Exception
            yrt

            _type_creators.add(_type_source.get_type("System.Action"), action_0_type_creator)

            for i in 1::16 do
                _type_creators.add(_type_source.get_type("System.Action`{i}"), action_type_creator)
            od

            for i in 1::17 do
                _type_creators.add(_type_source.get_type("System.Func`{i}"), function_type_creator)
            od

            // ghūl tuples are System.ValueTuple — the value type ghūl
            // emits and whose layout its tuple IL assumes. A reflected
            // System.Tuple (the legacy reference-type tuple) is left to
            // map as an ordinary generic class; treating it as a ghūl
            // tuple would emit value-tuple IL against a reference type.
            for i in 1::7 do
                _type_creators.add(_type_source.get_type("System.ValueTuple`{i}"), tuple_type_creator)
            od
        si

        get_type(type: TYPE?) -> Type is
            let result: Type mut
            let unsafe_constraints mut = false

            if !type? then
                Std.error.write_line("warning: materializing null type")
                return Types.NONE.instance
            fi

            if _type_cache.try_get_value(type, result ref) then
                return result
            fi

            if type.is_generic_method_parameter then
                // A reflected type parameter has no owning scope in the
                // symbol table: an empty block scope qualifies it to its
                // bare name, which is what it renders as either way.
                let symbol = Symbols.FUNCTION_GENERIC_ARGUMENT(Source.LOCATION.internal, Semantic.BLOCK_SCOPE(), type.name, type.generic_parameter_position)

                symbol.set_constraint_kind(generic_parameter_constraint_kind(type))

                result = symbol.type!
                _type_cache.add(type, result)

                return result
            elif type.is_generic_type_parameter then
                // Prefer the declaring type's own cached parameter: an
                // imported member's formal and a substitution map built
                // from the owner must carry the same symbol, and type
                // substitution matches on symbol identity rather than
                // on the parameter's name. The fallback mints a
                // detached parameter when the declaring type is not
                // (yet) in the symbol table.
                if type.declaring_type? then
                    let declaring = type.declaring_type!

                    let owner_scoped = _symbol_table.value.get_symbol(declaring)

                    if let owner_classy = cast Symbols.Classy?(owner_scoped) then
                        let declared
                            = cast Symbols.GenericArgument?(
                                owner_classy.type_parameter_at(type.generic_parameter_position))


                        if declared? then
                            declared.set_constraint_kind(generic_parameter_constraint_kind(type))

                            result = declared.type!
                            _type_cache.add(type, result)

                            return result
                        fi
                    fi
                fi

                let symbol = Symbols.CLASSY_GENERIC_ARGUMENT(Source.LOCATION.internal, Semantic.BLOCK_SCOPE(), type.name, type.generic_parameter_position)

                symbol.set_constraint_kind(generic_parameter_constraint_kind(type))

                result = symbol.type!
                _type_cache.add(type, result)

                return result
            fi

            if type.is_generic_type_definition \/ type.is_generic_type then
                let b = type.get_generic_type_definition()

                let creator: TypeCreator mut

                if !_type_creators.try_get_value(b, creator ref) then
                    creator = _generic_type_creator
                fi

                result = creator.create(_symbol_table.value, type)

                _type_cache.add(type, result)

                return result
            fi

            if type.is_array then
                let element_type = get_element_type(type)

                return _innate_symbol_lookup.get_array_type(element_type)
            elif type.is_by_ref then
                let element_type = get_element_type(type)

                return _innate_symbol_lookup.get_reference_type(element_type)
            elif type.is_pointer then
                let element_type = get_element_type(type)

                return _innate_symbol_lookup.get_pointer_type(element_type)
            elif type.is_by_ref_like then
                unsafe_constraints = true
            fi

            let creator: TypeCreator mut

            if _type_creators.try_get_value(type, creator ref) then
                return creator.create(_symbol_table.value, type)
            fi

            if !type.full_name? then
                Std.error.write_line("TM get type: type has no full name: {type}")
                return Types.NONE.instance
            fi

            result = TYPE_WRAPPER(_symbol_table.value, type)

            _type_cache.add(type, result)

            if unsafe_constraints then
                // not exactly but at least we'll get some kind of warning
                result.symbol.is_unsafe_constraints = true
            fi

            return result
        si

        map_type_argument_variance(type: TYPE) -> Types.TypeVariance =>
            if type.generic_parameter_attributes.has_flag(System.Reflection.GenericParameterAttributes.COVARIANT) then
                Types.TypeVariance.COVARIANT
            elif type.generic_parameter_attributes.has_flag(System.Reflection.GenericParameterAttributes.CONTRAVARIANT) then
                Types.TypeVariance.CONTRAVARIANT
            else
                Types.TypeVariance.INVARIANT
            fi

        // Maps a .NET generic parameter's `class` / `struct` constraint
        // attributes to a ghūl kind constraint.
        generic_parameter_constraint_kind(type: TYPE) -> Symbols.TypeParameterConstraintKind is
            let attributes = type.generic_parameter_attributes

            if attributes.has_flag(System.Reflection.GenericParameterAttributes.REFERENCE_TYPE_CONSTRAINT) then
                return Symbols.TypeParameterConstraintKind.REFERENCE
            elif attributes.has_flag(System.Reflection.GenericParameterAttributes.NOT_NULLABLE_VALUE_TYPE_CONSTRAINT) then
                return Symbols.TypeParameterConstraintKind.VALUE
            fi

            return Symbols.TypeParameterConstraintKind.NONE
        si

        // True when a .NET generic parameter declares a parameterless-
        // constructor (`new()`) constraint.
        generic_parameter_has_constructor_constraint(type: TYPE) -> bool =>
            type.generic_parameter_attributes.has_flag(
                System.Reflection.GenericParameterAttributes.DEFAULT_CONSTRUCTOR_CONSTRAINT
            )

        get_element_type(type: TYPE) -> Type =>
            let element_type = type.get_element_type() in
            if !element_type? then
                Std.error.write_line("warning: structured .NET type {type} has null element type: treating as Types.NONE")
                Types.NONE.instance
            else
                get_type(element_type)
            fi
    si
si
