@@IF.dotnet()

namespace Semantic.DotNet is
    use IO.Std

    use TYPE = System.Type
    use Collections.List

    use Source.LOCATION

    use Types.Type

    class TUPLE_TYPE_WRAPPER: GENERIC_TYPE_WRAPPER is
        names: Collections.List[string?]?
        is_value_tuple: bool => true

        tuple_element_names: Collections.List[string?]? => names

        apply_tuple_element_names(new_names: Collections.List[string?]) -> Type =>
            // HYBRID_TUPLE_TYPE_WRAPPER expects the generic type
            // definition (ValueTuple`N), not the constructed type.
            HYBRID_TUPLE_TYPE_WRAPPER(_symbol_table, _dotnet_type.get_generic_type_definition(), arguments, Types.TUPLE.take_element_names(new_names, arguments.count)!)

        short_description: string => Types.TUPLE.get_short_description(self, names)

        init(symbol_table: SYMBOL_TABLE, type_mapper: TYPE_MAPPER, dotnet_type: TYPE, names: Collections.List[string?]?) is
            super.init(symbol_table, type_mapper, dotnet_type)
            self.names = names
        si

        create(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Collections.List[Type]
        ) -> Types.GENERIC => Types.TUPLE(location, symbol, arguments, names)

        create_symbol(unspecialized: Symbols.Classy, arguments: List[Types.Type]) -> Symbols.GENERIC =>
            Symbols.TUPLE(Source.LOCATION.internal, unspecialized, arguments, names)

        to_string() -> string => Types.TUPLE.get_short_description(self, names, true)
    si

    class HYBRID_TUPLE_TYPE_WRAPPER: HYBRID_GENERIC_TYPE_WRAPPER is
        names: Collections.List[string?]?
        projected_names: Collections.List[bool]?
        is_value_tuple: bool => true

        is_projected_element_name(index: int) -> bool =>
            if let projected = projected_names /\ index < projected.count then
                projected[index]
            else
                false
            fi

        with_projected_names(projected: Collections.List[bool]) -> Type is
            let result = HYBRID_TUPLE_TYPE_WRAPPER(_symbol_table, _dotnet_type.get_generic_type_definition(), arguments, names)

            result.projected_names = projected

            return result
        si

        tuple_element_names: Collections.List[string?]? => names

        apply_tuple_element_names(new_names: Collections.List[string?]) -> Type =>
            // HYBRID_TUPLE_TYPE_WRAPPER expects the generic type
            // definition (ValueTuple`N), not the constructed type.
            HYBRID_TUPLE_TYPE_WRAPPER(_symbol_table, _dotnet_type.get_generic_type_definition(), arguments, Types.TUPLE.take_element_names(new_names, arguments.count)!)

        short_description: string => Types.TUPLE.get_short_description(self, names)

        init(symbol_table: SYMBOL_TABLE, dotnet_type: TYPE, arguments: List[Type], names: Collections.List[string?]?) is
            super.init(symbol_table, dotnet_type, arguments)
            self.names = names
        si

        create(
            location: LOCATION,
            symbol: Symbols.Classy,
            arguments: Collections.List[Type]
        ) -> Types.GENERIC =>
            let tuple = Types.TUPLE(location, symbol, arguments, names) in
            if let projected = projected_names then
                cast Types.GENERIC(tuple.with_projected_names(projected))
            else
                tuple
            fi

        create_symbol(unspecialized: Symbols.Classy, arguments: List[Types.Type]) -> Symbols.GENERIC =>
            Symbols.TUPLE(Source.LOCATION.internal, unspecialized, arguments, names)

        to_string() -> string => Types.TUPLE.get_short_description(self, names, true)
    si
si
