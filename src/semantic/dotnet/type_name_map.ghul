namespace Semantic.DotNet is
    use TYPE = System.Type

    use System.Reflection
    use System.Text.StringBuilder

    use IO.Std

    use Collections.Iterable
    use Collections.Map
    use Collections.MutableMap
    use Collections.SET
    use Collections.LIST
    use Collections.MAP

    // The type source is handed over at start, since the mappings are
    // registered against it rather than looked up on construction.
    @suppress("field-definite-assignment")
    class TYPE_NAME_MAP(
        _build_flags: Compiler.GLOBAL_BUILD_FLAGS,
        _type_details_lookup: TYPE_DETAILS_LOOKUP
    ) is
        _type_source: TypeSource

        _is_started: bool

        _type_details_by_dotnet_type: MutableMap[TYPE,TYPE_DETAILS]

        _namespace_details_by_dotnet_namespace: MutableMap[string,NAMESPACE_DETAILS]
        _namespace_details_by_ghul_name: MutableMap[string,NAMESPACE_DETAILS]

        _is_ghul_compiled_by_assembly: MutableMap[Assembly,bool]

        init(..) is
            _type_details_by_dotnet_type = MAP[TYPE,TYPE_DETAILS]()

            _namespace_details_by_dotnet_namespace = MAP[string,NAMESPACE_DETAILS]()
            _namespace_details_by_ghul_name = MAP[string,NAMESPACE_DETAILS]()

            _is_ghul_compiled_by_assembly = MAP[Assembly,bool]()
        si

        start(type_source: TypeSource) is
            if _is_started then
                return
            fi

            _type_source = type_source

            // Mappings: ghul name -> .NET type, and which built-in type it is

            map_namespace("Collections", "System.Collections.Generic", null)
            map_namespace("DotNet.NonGeneric.Collections", "System.Collections", null)
            map_namespace("IO", "System.IO", null)
            map_namespace("Tasks", "System.Threading.Tasks", null)

            map_built_in_type("System.Void", "Ghul.Intrinsics", "void", Symbols.BuiltInType.VOID, "System.Runtime")
            map_built_in_type("System.Boolean", "Ghul.Intrinsics", "bool", Symbols.BuiltInType.BOOL, "System.Runtime")
            map_built_in_type("System.Char", "Ghul.Intrinsics", "char", Symbols.BuiltInType.CHAR, "System.Runtime")
            map_built_in_type("System.Byte", "Ghul.Intrinsics", "ubyte", Symbols.BuiltInType.UINT8, "System.Runtime")
            map_built_in_type("System.SByte", "Ghul.Intrinsics", "byte", Symbols.BuiltInType.INT8, "System.Runtime")
            map_built_in_type("System.UInt16", "Ghul.Intrinsics", "ushort", Symbols.BuiltInType.UINT16, "System.Runtime")
            map_built_in_type("System.Int16", "Ghul.Intrinsics", "short", Symbols.BuiltInType.INT16, "System.Runtime")
            map_built_in_type("System.UInt32", "Ghul.Intrinsics", "uint", Symbols.BuiltInType.UINT32, "System.Runtime")
            map_built_in_type("System.Int32", "Ghul.Intrinsics", "int", Symbols.BuiltInType.INT32, "System.Runtime")
            map_built_in_type("System.UInt64", "Ghul.Intrinsics", "ulong", Symbols.BuiltInType.UINT64, "System.Runtime")
            map_built_in_type("System.Int64", "Ghul.Intrinsics", "long", Symbols.BuiltInType.INT64, "System.Runtime")
            map_built_in_type("System.UIntPtr", "Ghul.Intrinsics", "uword", Symbols.BuiltInType.UINT_NATIVE, "System.Runtime")
            map_built_in_type("System.IntPtr", "Ghul.Intrinsics", "word", Symbols.BuiltInType.INT_NATIVE, "System.Runtime")
            map_built_in_type("System.Single", "Ghul.Intrinsics", "single", Symbols.BuiltInType.FLOAT32, "System.Runtime")
            map_built_in_type("System.Double", "Ghul.Intrinsics", "double", Symbols.BuiltInType.FLOAT64, "System.Runtime")
            map_type("System.Decimal", "Ghul.Intrinsics", "decimal", null, "System.Runtime")

            // BigInteger is a built-in name rather than a built-in type:
            // it gets no innate operators, and resolves its arithmetic
            // through its own reflected static operators like any other
            // .NET type. Mapping it here is what makes `bigint` the name
            // a literal's type is rendered under, and what the `n`
            // literal suffix resolves against.
            map_type("System.Numerics.BigInteger", "Ghul.Intrinsics", "bigint", null, "System.Runtime.Numerics")

            map_type("System.Object", "Ghul.Intrinsics", "object", null, "System.Runtime")
            map_type("System.String", "Ghul.Intrinsics", "string", null, "System.Runtime")

            // System.Nullable`1 is the IL representation of `T?` for
            // value types — it has no user-spellable ghūl name. Users
            // write `T?`; the type-expression parser produces the NULLABLE
            // instance directly via the innate-symbol lookup. Compare
            // with arrays / pointers / references — also internal-only
            // generic types, also lacking a `type_name_map` entry.

            // Every Func/Action arity in System.Runtime must be remapped:
            // an unmapped one registers under `System` with its
            // arity-stripped name, and becomes the only resolvable arity
            // of a name nothing should resolve at all
            for i in 1::17 do
                map_type("System.Func`{i}", "Ghul.Intrinsics", "FUNCTION_{i - 1}")
            od

            map_type("System.Action", "Ghul.Intrinsics", "ACTION_0")

            for i in 1::16 do
                map_type("System.Action`{i}", "Ghul.Intrinsics", "ACTION_{i}")
            od

            for i in 1::8 do
                map_type("System.ValueTuple`{i}", "Ghul.Intrinsics", "TUPLE_{i}")
            od

            map_type("System.IDisposable", "Ghul", "Disposable")

            map_type("System.IComparable`1", "Ghul", "Comparable")
            map_type("System.IComparable", "Ghul", "Comparable")
            map_type("System.IEquatable`1", "Ghul", "Equatable")

            map_type("System.Type", "System", "Type")
            map_type("System.Console", "IO", "Std", "System.Console", "System.Console")

            map_type("System.Collections.IEnumerable", "Collections", "NonGenericIterable")

            map_type("System.Collections.Generic.IReadOnlyCollection`1", "Collections", "Bag")
            map_type("System.Collections.Generic.ICollection`1", "Collections", "MutableBag")
            map_type("System.Collections.IEnumerator", "Collections", "MoveNext")
            map_type("System.Collections.Generic.IEnumerable`1", "Collections", "Iterable")
            map_type("System.Collections.Generic.IEnumerator`1", "Collections", "Iterator")

            map_type("System.Collections.Generic.List`1", "Collections", "LIST", "System.Collections.Generic.List`1", "System.Collections")
            map_type("System.Collections.Generic.IList`1", "Collections", "MutableList")
            map_type("System.Collections.Generic.IReadOnlyList`1", "Collections", "List")

            map_type("System.Collections.Generic.Dictionary`2", "Collections", "MAP", "System.Collections.Generic.Dictionary`2", "System.Collections")
            map_type("System.Collections.Generic.IDictionary`2", "Collections", "MutableMap")
            map_type("System.Collections.Generic.IReadOnlyDictionary`2", "Collections", "Map")

            map_type("System.Collections.Generic.HashSet`1", "Collections", "SET", "System.Collections.Generic.HashSet`1", "System.Collections")
            map_type("System.Collections.Generic.ISet`1", "Collections", "MutableSet")
            map_type("System.Collections.Generic.IReadOnlySet`1", "Collections", "Set")
            map_type("System.Collections.Generic.Stack`1", "Collections", "STACK", "System.Collections.Generic.Stack`1", "System.Collections")

            map_type("System.Threading.Tasks.Task", "Tasks", "TASK")
            map_type("System.Threading.Tasks.Task`1", "Tasks", "TASK")

            _is_started = true
        si

        map_type(dotnet_type_name: string, namespace_name: string, type_name: string) is
            map_type(dotnet_type_name, namespace_name, type_name, null, null)
        si

        map_type(dotnet_type_name: string, namespace_name: string, type_name: string, il_name: string?, assembly_name: string?) is
            _add(TYPE_DETAILS(_type_source.get_type(assembly_name, dotnet_type_name), namespace_name, type_name, il_name, assembly_name))
        si

        map_built_in_type(dotnet_type_name: string, namespace_name: string, type_name: string, built_in_type: Symbols.BuiltInType, assembly_name: string) is
            let type_details = TYPE_DETAILS(_type_source.get_type(assembly_name, dotnet_type_name), namespace_name, type_name, null, assembly_name)

            type_details.built_in_type = built_in_type

            _add(type_details)
        si

        _add(type_details: TYPE_DETAILS) is
            _type_details_by_dotnet_type.add(type_details.dotnet_type, type_details)

            _type_details_lookup.add_type(type_details)
        si

        map_namespace(ghul_namespace_name: string, dotnet_namespace_name: string, dotnet_assembly: string?) is
            let namespace_details = NAMESPACE_DETAILS(ghul_namespace_name, dotnet_namespace_name, dotnet_assembly)

            _namespace_details_by_dotnet_namespace.add(dotnet_namespace_name, namespace_details)

            _namespace_details_by_ghul_name.add(ghul_namespace_name, namespace_details)
        si

        get_type_details(type: TYPE) -> TYPE_DETAILS? is
            let result: TYPE_DETAILS mut
            _type_details_by_dotnet_type.try_get_value(type, result ref)

            return result
        si

        get_namespace_details(type: TYPE) -> NAMESPACE_DETAILS? is
            let ns = type.`namespace

            if !ns? then
                return null
            fi

            let result: NAMESPACE_DETAILS mut

            _namespace_details_by_dotnet_namespace.try_get_value(ns, result ref)

            return result
        si

        get_namespace_details(ghul_namespace_name: string) -> NAMESPACE_DETAILS? is
            let result: NAMESPACE_DETAILS mut
            _namespace_details_by_ghul_name.try_get_value(ghul_namespace_name, result ref)

            return result
        si

        // The declaring type decides the naming convention, not the type
        // whose member set is being walked: an inherited member of a
        // ghūl-compiled type still belongs to the assembly that declared
        // it — `object.get_type` arrives from an ordinary .NET assembly
        // and needs de-camelling wherever it is met.
        get_member_name(owner_ghul_name: string, member_dotnet_name: string, is_private: bool, is_special_name: bool, declaring_type: TYPE) -> string is
            let result: string mut

            result = if is_ghul_compiled(declaring_type) then member_dotnet_name else de_camel(member_dotnet_name) fi

            // A ghūl-compiled special name already carries its $, since
            // it is emitted under the name the source declares it by.
            if is_special_name then
                if !result.starts_with('$') then
                    result = "${result}"
                fi
            elif is_private then
                result = "_{result}"
            fi

            return result
        si

        get_constant_name(owner_ghul_name: string, member_dotnet_name: string, is_private: bool, declaring_type: TYPE) -> string is
            let result: string mut

            result = if is_ghul_compiled(declaring_type) then member_dotnet_name else de_camel(member_dotnet_name).to_upper_invariant() fi

            if is_private then
                result = "_{result}"
            fi

            return result
        si

        // A ghūl-declared member name is already spelled the way ghūl
        // spells it, so de-camelling it would be wrong — most visibly
        // for an UPPER_SNAKE static, which de-camelling turns into
        // snake_case. The compiler marks every assembly it builds with
        // `GHUL_COMPILED_ATTRIBUTE` so this can tell
        // the two apart; the check is cached per assembly since it is
        // consulted for every member.
        is_ghul_compiled(type: TYPE) -> bool is
            let assembly = type.assembly
            let result: bool mut

            if _is_ghul_compiled_by_assembly.try_get_value(assembly, result ref) then
                return result
            fi

            result = _has_ghul_compiled_attribute(assembly)

            _is_ghul_compiled_by_assembly.add(assembly, result)

            return result
        si

        _has_ghul_compiled_attribute(assembly: Assembly) -> bool is
            try
                for attr in assembly.get_custom_attributes_data() do
                    if attr.attribute_type.full_name =~ "Ghul.Internal.GHUL_COMPILED_ATTRIBUTE" then
                        return true
                    fi
                od
            catch ex: System.Exception
                // Some reflected assemblies fail to enumerate their
                // custom attributes (e.g. with missing referenced
                // assemblies). Treating the absence as an absent marker
                // is safe — the worst case is the de-camelling behaviour
                // kicking in for that assembly.
            yrt

            return false
        si

        de_camel(name: string) -> string static is
            // A name made entirely of operator characters is an operator, and
            // is already spelled the way source spells it. De-camelling would
            // strip any `$` it contains, which either empties the name or
            // silently turns it into a different operator.
            if Lexical.TOKENIZER.is_operator_name(name) then
                return name
            fi

            let buffer = StringBuilder()
            let seen_any_lower_case mut = false

            // Case is read and written invariantly: a culture-sensitive
            // mapping would give a member a different ghul name
            // depending on the machine that compiled against it.
            for c in name do
                if char.is_upper(c) then
                    if seen_any_lower_case /\ buffer[buffer.length -1] != '_' then
                        buffer.append('_')
                    fi

                    buffer.append(char.to_lower_invariant(c))
                elif c != '$' then
                    if char.is_lower(c) then
                        seen_any_lower_case = true
                    fi

                    buffer.append(c)
                fi
            od

            let result = buffer.to_string()

            return result
        si
    si
si
