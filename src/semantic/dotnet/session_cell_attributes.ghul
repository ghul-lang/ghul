namespace Semantic.DotNet is
    // The attribute a REPL cell's assembly carries, for each earlier cell
    // it references, so the runtime gives it the access the compiler
    // already allows. The CIL backend writes it.
    class SESSION_CELL_ATTRIBUTES is
        ACCESS_ATTRIBUTE_NAME: string static => "System.Runtime.CompilerServices.IgnoresAccessChecksToAttribute"
    si
si
