namespace Semantic.DotNet is
    use TYPE = System.Type

    use System.Reflection.Assembly
    use System.Reflection.ConstructorInfo
    use System.Reflection.MethodInfo
    use System.Reflection.FieldInfo
    use System.Reflection.PropertyInfo
    use System.Reflection.MemberInfo
    use System.Reflection.ParameterInfo

    use System.Reflection.BindingFlags
    use System.Reflection.MemberTypes

    use System.Reflection.GenericParameterAttributes

    use Collections.List
    use Collections.MutableList
    use Collections.LIST
    use Collections.SET
    use Collections.MAP

    use Ghul.Pipes

    use Types.Type

    use Logging

    // The reflected types these hold cannot be looked up until the
    // type source has started, so start does it and the constructor
    // only registers the callback.
    @suppress("field-definite-assignment")
    class SYMBOL_FACTORY(
        _namespaces: NAMESPACES,
        _type_name_map: TYPE_NAME_MAP,
        _type_mapper: TYPE_MAPPER,
        _type_source: TypeSource,
        _type_details_lookup: TYPE_DETAILS_LOOKUP,
        logger: Logging.Logger private
    ) is
        _assembly_names: MAP[Assembly,string]

        _symbol_table: SYMBOL_TABLE

        _void_type: TYPE
        _object_type: TYPE
        _value_type: TYPE
        _array_type: TYPE
        _multicast_delegate_type: TYPE
        _bool_type: TYPE
        _int_type: TYPE
        _equatable_open_type: TYPE
        _comparable_open_type: TYPE
        _tuple_types: List[TYPE]

        // The types whose `<>` / `=~` is an intrinsic lowering to
        // opcodes (`compare.order` and friends in the runtime's
        // intrinsics). Their reflected interface members are hidden
        // from binary-operator resolution so `a < b` keeps the opcode
        // and its semantics — on `single`, `CompareTo` is a total
        // order that sorts NaN below everything, where the opcode is
        // the IEEE comparison. All are sealed, so the hidden member
        // can have no sibling overloads to shadow.
        //
        // `string` has an innate `=~` but no innate order, so it is in
        // the equality set only, and ordering one reaches
        // `System.String.CompareTo`. That comparison is culture-
        // sensitive: `"a" < "B"` answers true under a typical current
        // culture and false under invariant globalization, so a string
        // ordering is not machine-independent the way a scalar's is.
        _innate_order_type_names: SET[string]
        _innate_equality_type_names: SET[string]

        // The scalar types whose arithmetic, bitwise and shift operators
        // are the intrinsics. Held as the reflected types themselves, so
        // membership is identity rather than a rendered name.
        _intrinsic_operator_types: SET[TYPE]

        _ambiguous_method_checker: AMBIGUOUS_METHOD_CHECKER

        init(..) is
            _assembly_names = MAP[Assembly,string]()
            _ambiguous_method_checker = AMBIGUOUS_METHOD_CHECKER(logger)

            _type_source.on_start(() -> void is start(); si)
        si

        start() is
            _void_type = _type_source.get_type("System.Void")
            _object_type = _type_source.get_type("System.Object")
            _value_type = _type_source.get_type("System.ValueType")
            _array_type = _type_source.get_type("System.Array")
            _multicast_delegate_type = _type_source.get_type("System.MulticastDelegate")
            _bool_type = _type_source.get_type("System.Boolean")
            _int_type = _type_source.get_type("System.Int32")
            _equatable_open_type = _type_source.get_type("System.IEquatable`1")
            _comparable_open_type = _type_source.get_type("System.IComparable`1")

            _innate_order_type_names = SET([
                "System.Char",
                "System.SByte", "System.Byte",
                "System.Int16", "System.UInt16",
                "System.Int32", "System.UInt32",
                "System.Int64", "System.UInt64",
                "System.IntPtr", "System.UIntPtr",
                "System.Single", "System.Double",
                "System.Decimal"
            ])

            _innate_equality_type_names = SET([
                "System.String"
            ])

            _intrinsic_operator_types = SET(_type_source.get_types([
                "System.Char",
                "System.SByte", "System.Byte",
                "System.Int16", "System.UInt16",
                "System.Int32", "System.UInt32",
                "System.Int64", "System.UInt64",
                "System.IntPtr", "System.UIntPtr",
                "System.Single", "System.Double",
                "System.Decimal"
            ]))

            _tuple_types = _type_source.get_types([
                "System.ValueTuple`1",
                "System.ValueTuple`2",
                "System.ValueTuple`3",
                "System.ValueTuple`4",
                "System.ValueTuple`5",
                "System.ValueTuple`6",
                "System.ValueTuple`7"
            ])

            // TODO handle more than 7-tuple types by
            // nesting them
        si

        set_symbol_table(symbol_table: SYMBOL_TABLE) is
            _symbol_table = symbol_table
        si

        // A reference set that cannot supply everything a type's members name
        // is a fact about the command line, so it is reported rather than
        // thrown: the caller keeps the partly-populated symbol, and the error
        // stops the build before generate-il can meet whatever the missing
        // members left behind.
        report_materialization_failure(dotnet_type: TYPE, ex: System.Exception) is
            _logger.environment_error(
                Source.LOCATION.reflected,
                "cannot load {dotnet_type}: {without_loader_advice(ex.message)}")
        si

        // The reflection layer's own remediation - load the assembly with
        // `LoadFromAssemblyPath`, or supply a resolver - addresses whoever
        // called it, which here is the compiler rather than the person reading
        // the diagnostic. The sentence before it names the assembly, which is
        // what they need. Dropping the advice is cosmetic on both sides: an
        // unrecognised message is reported whole.
        without_loader_advice(message: string) -> string is
            let advice = message.index_of("Either explicitly load")

            if advice < 0 then
                return message
            fi

            return message.substring(0, advice).trim_end()
        si

        create_symbol(type_details: TYPE_DETAILS) -> Symbols.Scoped? is
            try
                let dotnet_type = type_details.dotnet_type

                if dotnet_type.is_class \/ dotnet_type.is_value_type \/ dotnet_type.is_interface \/ dotnet_type.is_enum then
                    return create_class(type_details)
                fi
            catch ex: System.Exception
                debug_always("create symbol failed: {type_details} exception: {ex}")

                throw ex
            yrt

            return null
        si

        create_class(type_details: TYPE_DETAILS) -> Symbols.Scoped is
            let dotnet_type = type_details.dotnet_type
            let ghul_type_name = type_details.ghul_type_name
            let assembly_name = type_details.assembly_name!
            let il_name mut = type_details.il_name

            let owner = EMPTY_SCOPE(type_details.ghul_namespace)

            let arguments = LIST()
            let argument_variances = LIST()
            let argument_constraint_kinds = LIST()
            let argument_has_constructor_constraint = LIST()
            let argument_type_bounds = Collections.LIST[Collections.List[Semantic.Types.Type]]()

            if dotnet_type.is_generic_type /\ dotnet_type.contains_generic_parameters then
                let argument_types = dotnet_type.get_generic_arguments()

                for a in argument_types do
                    if a.is_generic_type_parameter then
                        arguments.add(a.name)
                        argument_variances.add(_type_mapper.map_type_argument_variance(a))
                        argument_constraint_kinds.add(_type_mapper.generic_parameter_constraint_kind(a))
                        argument_has_constructor_constraint.add(_type_mapper.generic_parameter_has_constructor_constraint(a))
                        argument_type_bounds.add(type_bounds(a))
                    fi
                od
            fi

            let result: Symbols.Classy mut

            if dotnet_type.is_enum then
                let enum_struct =
                    Symbols.ENUM_STRUCT(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, ghul_type_name, owner)

                enum_struct.mark_overrides_resolved()

                enum_struct.underlying_type = _type_mapper.get_type(dotnet_type.get_enum_underlying_type())

                Symbols.ENUM_ORDER_OPERATOR.register(enum_struct)
                Symbols.ENUM_EQUALITY_OPERATOR.register(enum_struct)

                if type_details.has_flags_attribute then
                    Symbols.ENUM_AND_OPERATOR.register(enum_struct)
                    Symbols.ENUM_OR_OPERATOR.register(enum_struct)
                    Symbols.ENUM_XOR_OPERATOR.register(enum_struct)
                    Symbols.ENUM_NOT_OPERATOR.register(enum_struct)
                fi

                result = enum_struct
            elif dotnet_type.is_class /\ has_union_attribute(dotnet_type) then
                result = Symbols.UNION(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, ghul_type_name, arguments, owner)
                result.mark_overrides_resolved()
            elif dotnet_type.is_class /\ has_variant_attribute(dotnet_type) then
                result = Symbols.VARIANT(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, ghul_type_name, arguments, owner)
                result.mark_overrides_resolved()
            elif dotnet_type.is_class then
                let result_class = Symbols.CLASS(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, ghul_type_name, arguments, owner)

                if dotnet_type == _object_type then
                    result_class.mark_is_object()
                elif dotnet_type == _value_type then
                    result_class.mark_is_root_value_type()
                elif dotnet_type == _array_type then
                    result_class.mark_is_root_array_type()
                fi

                if has_closed_attribute(dotnet_type) then
                    result_class.mark_closed()
                fi

                if _inherits_multicast_delegate(dotnet_type) then
                    result_class.mark_delegate()
                fi

                if dotnet_type.is_abstract then
                    result_class.mark_abstract()
                fi

                result = result_class
                result.mark_overrides_resolved()
            elif dotnet_type.is_value_type then
                if dotnet_type == _void_type then
                    result = Symbols.VOID_STRUCT(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, ghul_type_name, arguments, owner)
                else
                    result = Symbols.STRUCT(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, ghul_type_name, arguments, owner)
                fi

                result.built_in_type = type_details.built_in_type

                result.mark_overrides_resolved()
            elif dotnet_type.is_interface then
                let result_trait = Symbols.TRAIT(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, ghul_type_name, arguments, owner)

                if has_closed_attribute(dotnet_type) then
                    result_trait.mark_closed()
                fi

                result = result_trait
            else
                throw System.Exception("unhandled reflected kind for {dotnet_type}")
            fi

            // The attribute check alone misses a type imported from an
            // assembly built before this change - ghul-runtime itself
            // included. A type name is never operator syntax, so a
            // leading `$` on a reflected type is an unambiguous legacy
            // signal, the same reasoning add_field's fallback uses.
            if
                type_details.is_globals_carrier \/
                _has_compiler_generated_attribute(dotnet_type.get_custom_attributes_data()) \/
                ghul_type_name.starts_with('$')
            then
                result.mark_synthesized()
            fi

            result.set_doc(_doc_attribute(dotnet_type.get_custom_attributes_data()))
            result.set_deprecation(_obsolete_attribute(dotnet_type.get_custom_attributes_data()))

            if argument_variances.count > 0 then
                result.argument_variances = argument_variances
            fi

            if argument_constraint_kinds.count > 0 then
                result.argument_constraint_kinds = argument_constraint_kinds
            fi

            if argument_has_constructor_constraint.count > 0 then
                result.argument_has_constructor_constraint = argument_has_constructor_constraint
            fi

            if argument_type_bounds.count > 0 /\ argument_type_bounds |> any(l => l.count > 0) then
                result.argument_type_bounds = argument_type_bounds
            fi

            result.il_assembly_name = assembly_name

            if let builder = type_details.async_builder_type then
                if let classy_result: Symbols.Classy = result then
                    classy_result.async_builder = _type_mapper.get_type(builder)
                fi
            fi

            if !il_name? then
                il_name = get_il_name(dotnet_type)
            fi

            result.il_name_override = il_name
            result.dotnet_full_name = dotnet_type.full_name

            return result
        si

        add_ancestors(symbol: Symbols.Scoped, type: TYPE) is
            if !isa Symbols.Classy(symbol) then
                return
            fi

            let result = symbol

            if type.base_type? then
                result.add_ancestor(_type_mapper.get_type(type.base_type!))
            elif type.is_interface then
                result.add_ancestor(_type_mapper.get_type(_type_source.get_type("System.Object")))
            fi

            // A trait `type` implements directly can carry a reference-`?`
            // type argument that ordinary reflection has no way to
            // surface (see INTERFACE_NULLABILITY) — recover it from the
            // assembly's raw metadata and apply it to the mapped type
            // before it becomes an ancestor. Empty for a trait `type`
            // only inherits via a base class, or one with nothing
            // optional in its arguments; either way the mapped type is
            // used as-is.
            let nullable_by_key = _type_source.interface_nullability_bytes(type)

            for i in type.get_interfaces() do
                let mapped mut = _type_mapper.get_type(i)

                let bytes: LIST[int] mut

                if nullable_by_key.try_get_value(Semantic.DotNet.INTERFACE_NULLABILITY.key_for(i), bytes ref) then
                    mapped = Semantic.DotNet.NULLABILITY.apply_bytes(mapped, bytes) ?? mapped
                fi

                result.add_ancestor(mapped)
            od
        si

        // Reflected interfaces are the one kind that isn't marked
        // overrides-resolved on creation, so this is where their
        // inherited members get pulled down. It has to run after
        // `add_members`: a .NET interface that redeclares an inherited
        // member covariantly (`new IDerived? BaseType { get; }`) only
        // has its own declaration to override with once that
        // declaration is in scope. Pull down first and the inherited
        // declaration wins, hiding the derived one and turning a
        // resolved redeclaration into an inheritance clash.
        resolve_overrides(symbol: Symbols.Scoped) is
            if !isa Symbols.Classy(symbol) then
                return
            fi

            let result = symbol

            IoC.CONTAINER.instance.symbol_table.enter_scope(result)
            result.pull_down_super_symbols()
            IoC.CONTAINER.instance.symbol_table.leave_scope(result)
        si

        mask_gpa(a: GenericParameterAttributes, b: GenericParameterAttributes) -> GenericParameterAttributes =>
            cast GenericParameterAttributes(cast int(a) & cast int(b))

        // Every ghūl-mapped .NET type bound on this parameter (`where T :
        // IA, IB`), empty when the parameter is unbounded or only carries
        // the redundant `System.ValueType` companion of a `struct` flag.
        type_bounds(t: TYPE) -> Collections.List[Semantic.Types.Type] is
            let result = Collections.LIST[Semantic.Types.Type]()
            let constraint_attributes = mask_gpa(t.generic_parameter_attributes, GenericParameterAttributes.SPECIAL_CONSTRAINT_MASK)
            let struct_constrained =
                constraint_attributes.has_flag(GenericParameterAttributes.NOT_NULLABLE_VALUE_TYPE_CONSTRAINT)

            for c in t.get_generic_parameter_constraints() do
                if !(struct_constrained /\ c.full_name? /\ c.full_name =~ "System.ValueType") then
                    result.add(_type_mapper.get_type(c))
                fi
            od

            return result
        si

        // Static members of the `$globals` synthetic class are global
        // functions / variables / properties in the source language. Detect
        // the host so the importer can produce GLOBAL_FUNCTION /
        // GLOBAL_VARIABLE / GLOBAL_PROPERTY symbols rather than the
        // static-on-a-class kinds. Their owner becomes the enclosing
        // NAMESPACE (mirroring source-side `declare_function`) so qualified
        // names skip the synthetic `$globals` segment and IL emission goes
        // through the existing `gen_globals_class_reference` path.
        _globals_owner_namespace(owner: Symbols.Symbol) -> Symbols.NAMESPACE? is
            if !(owner.name =~ "$globals") \/ !isa Symbols.Classy(owner) then
                return null
            fi

            let classy_owner = owner.owner

            if !classy_owner? then
                return null
            fi

            return _namespaces.try_find_namespace(".{classy_owner.name}")
        si

        add_members(result: Symbols.Scoped, type: TYPE) is
            let properties = MAP()
            let indexers = SET()
            let indexer_accessors = SET()
            let methods = LIST()

            for p in type.get_properties() do
                add_property(result, type, properties, indexers, indexer_accessors, p)
            od

            for t in type.get_members(cast BindingFlags(64 + 4 + 32 + 16 + 8)) do
                add_member(result, type, properties, indexers, indexer_accessors, methods, t)
            od

            if methods.count > 0 then
                _ambiguous_method_checker.check(result, methods)

                for m in methods do
                    // An intrinsic operator is registered on the types of
                    // its operands rather than on the carrier that declared
                    // it.
                    if let home: Symbols.Classy = m.function.owner /\ isa Symbols.INNATE_FUNCTION(m.function) then
                        home.add_member(m.function)

                        for other in Symbols.TYPE_HOMED_OPERATORS.homes(m.function) do
                            if other != home then
                                other.add_member(m.function)
                            fi
                        od
                    else
                        result.add_member(m.function)
                    fi
                od
            fi

            inherit_default_trait_members(result, type)

            _add_constructor_intrinsics(result, type)
            _add_scalar_conversions(result, type)
        si

        // The language's scalar types: the value types it names in
        // Ghul.Intrinsics, other than bool and void, which convert between
        // one another with `cast`.
        _is_scalar(type: TYPE) -> bool =>
            type.is_value_type /\ !type.is_enum /\ !type.is_generic_type /\
            type != _bool_type /\ type != _void_type /\
            (_type_details_lookup.get_type_details_by_dotnet_type(type)?.ghul_namespace =~ "Ghul.Intrinsics")

        _scalar_types() -> Collections.List[TYPE] is
            let result = LIST[TYPE]()

            if let details = _type_details_lookup.get_all_type_details_in_ghul_namespace("Ghul.Intrinsics") then
                for detail in details do
                    if _is_scalar(detail.dotnet_type) then
                        result.add(detail.dotnet_type)
                    fi
                od
            fi

            return result
        si

        // A scalar type is constructed from any other scalar, converting the
        // way `cast` does: `double(n)` is `cast double(n)`. Where .NET
        // already gives the type a constructor from that source, as decimal
        // and BigInteger do for the wider numeric types, that constructor
        // stays and none is added beside it.
        _add_scalar_conversions(owner: Symbols.Scoped, type: TYPE) is
            if !_is_scalar(type) then
                return
            fi

            let scalars = _scalar_types()

            let location = Source.LOCATION.reflected

            for source in SCALAR_CONVERSION_SOURCES.needing_constructor(type, scalars) do
                let result = Symbols.STRUCT_METHOD(location, location, owner, "init", owner)

                result.argument_names = LIST[string](["value"])
                result.arguments = LIST[Type]([_type_mapper.get_type(source)])
                result.return_type = _type_mapper.get_type(_void_type)
                result.is_scalar_conversion = true
                result.mark_declared_pure()
                result.mark_synthesized()

                owner.add_member(result)
            od
        si

        // Copy any concrete (`is_default_trait_method`) method from
        // a trait the class implements into the class itself, unless
        // the class declares a method with the same signature.
        //
        // Why this is its own pass: `mark_overrides_resolved()` runs
        // on reflected concrete classes in `create_class` so the
        // full `SYMBOL_INHERITANCE_RESOLVER` skips them — its
        // override-clash and abstract-method checks would otherwise
        // fire on .NET-side diamonds (`IList` × `IReadOnlyList`,
        // `MemberInfo.Module`, …) that the assembly's IL has already
        // resolved via explicit interface implementation but that
        // ghul's reflection layer can't see. Pulling down just the
        // trait defaults keeps the assumption-of-trust for
        // overrides while still making `find_member("filter")` work
        // on a reflected class that inherits `filter` from `Pipe[T]`.
        inherit_default_trait_members(result: Symbols.Scoped, type: TYPE) is
            if !isa Symbols.Classy(result) then
                return
            fi

            let classy = result

            for i in 0..classy.ancestors.count do
                let scope = classy.get_ancestor(i)?.scope

                if !scope? then
                    continue
                fi

                for member in scope.symbols do
                    inherit_default_trait_member(classy, member)
                od
            od
        si

        inherit_default_trait_member(into: Symbols.Classy, member: Symbols.Symbol) is
            if isa Symbols.FUNCTION_GROUP(member) then
                let group = member

                for function in group.functions do
                    if function.is_default_trait_method /\ !declares_override_of(into, function) then
                        into.add_member(function)
                    fi
                od
            elif isa Symbols.Function(member) then
                let function = member

                if function.is_default_trait_method /\ !declares_override_of(into, function) then
                    into.add_member(function)
                fi
            elif let property: Symbols.Property = member then
                // A property with a default body is inherited the same way,
                // unless the class declares one of that name itself.
                if let getter = property.read_function /\ getter.is_default_trait_method /\ !into.find_direct(property.name)? then
                    into.add_member(property)
                fi
            fi
        si

        // Whether the class itself declares a method with the default
        // method's signature: that method is the class's implementation
        // of it, so the default is not inherited beside it as a second
        // candidate for the same call.
        declares_override_of(into: Symbols.Classy, default_method: Symbols.Function) -> bool static is
            let existing = into.find_direct(default_method.name)

            if let group: Symbols.FUNCTION_GROUP = existing then
                return group.functions |> any(f => _overrides(into, f, default_method))
            elif let single: Symbols.Function = existing then
                return _overrides(into, single, default_method)
            fi

            return false
        si

        _overrides(into: Symbols.Classy, candidate: Symbols.Function, default_method: Symbols.Function) -> bool static =>
            candidate != default_method /\
            candidate.owner == into /\
            candidate.override_class =~ default_method.override_class

        add_member(
            owner: Symbols.Scoped,
            type: TYPE,
            properties: MAP[System.Reflection.MethodInfo,PROPERTY_DETAILS],
            indexers: SET[System.Reflection.MethodInfo],
            indexer_accessors: SET[System.Reflection.MethodInfo],
            methods: LIST[(function: Symbols.Function, method_info: MethodInfo)],
            member: MemberInfo
        ) -> Symbols.Symbol?
        is
            let member_type = member.member_type

            if member_type == MemberTypes.CONSTRUCTOR then
                add_constructor(owner, cast ConstructorInfo?(member)!)
            elif member_type == MemberTypes.FIELD then
                add_field(owner, type, cast FieldInfo?(member)!)
            elif member_type == MemberTypes.METHOD then
                add_method(owner, type, properties, indexers, indexer_accessors, methods, cast MethodInfo?(member)!)
            fi
            return null
        si

        add_constructor(owner: Symbols.Scoped, method: ConstructorInfo) is
            let result: Symbols.Function mut
            let location = Source.LOCATION.reflected

            if !method.is_public /\ !_is_session_member(method) then
                return
            fi

            if method.is_static then
                result = Symbols.STATIC_METHOD(location, location, owner, "init", owner)
            elif owner.is_value_type then
                result = Symbols.STRUCT_METHOD(location, location, owner, "init", owner)
            elif method.is_abstract then
                result = Symbols.ABSTRACT_METHOD(location, location, owner, "init", owner)
            else
                result = Symbols.INSTANCE_METHOD(location, location, owner, "init", owner)
            fi

            result.il_name_override = method.name

            let argument_names = LIST()
            let argument_types = LIST()
            let argument_defaults = Collections.LIST[string?]()
            let argument_reads = Collections.LIST[bool]()
            let argument_writes = Collections.LIST[bool]()
            let argument_is_pack = Collections.LIST[bool]()
            let argument_pack_depth = Collections.LIST[int]()
            let spread_argument_index mut = -1
            let has_direction_override mut = false

            for a in method.get_parameters() do
                argument_names.add(a.name ?? "")
                let arg_attributes = a.get_custom_attributes_data()

                let pack_depth = _argument_pack_depth(arg_attributes)

                argument_is_pack.add(pack_depth >= 0)
                argument_pack_depth.add(if pack_depth >= 0 then pack_depth else 0 fi)

                if _has_attribute_named(arg_attributes, ARGUMENT_SPREAD_ATTRIBUTE_NAME) then
                    spread_argument_index = argument_names.count - 1
                fi

                argument_types.add(
                    NULLABILITY.resolve(
                        _with_tuple_element_names(_type_mapper.get_type(a.parameter_type), arg_attributes),
                        arg_attributes,
                        method,
                        a.parameter_type
                    )!
                )
                argument_defaults.add(_default_for_parameter(a))
                argument_reads.add(!(a.is_out /\ !a.is_in))
                argument_writes.add(!(a.is_in /\ !a.is_out))
                if a.is_out \/ a.is_in then
                    has_direction_override = true
                fi
            od

            result.argument_is_pack = argument_is_pack
            result.argument_pack_depth = argument_pack_depth
            result.spread_argument_index = spread_argument_index

            let return_pack_depth = _pack_depth(method.get_custom_attributes_data(), RETURN_PACK_ATTRIBUTE_NAME)

            if return_pack_depth >= 0 then
                result.return_pack_depth = return_pack_depth
            fi
            result.argument_names = argument_names
            result.arguments = argument_types
            result.argument_defaults = argument_defaults

            if has_direction_override then
                result.set_argument_directions(argument_reads, argument_writes)
            fi

            result.return_type = _type_mapper.get_type(_void_type)
            result.mark_pack_type_parameters()

            // A public parameterless constructor — what a `new()`
            // type-parameter constraint requires of a type argument.
            if argument_types.count == 0 /\ isa Symbols.Classy(owner) then
                (cast Symbols.Classy(owner)).has_parameterless_constructor = true
            fi

            owner.add_member(result)
        si

        add_field(owner: Symbols.Scoped, type: TYPE, `field: FieldInfo) is
            if !`field.is_public /\ !_is_session_member(`field) then
                return
            fi

            if type.is_enum /\ !`field.is_special_name then
                let raw_value = `field.get_raw_constant_value()
                let enum_member =
                    Symbols.ENUM_STRUCT_MEMBER(
                        Source.LOCATION.reflected,
                        cast Symbols.ENUM_STRUCT?(owner)!,
                        _type_name_map.get_constant_name(owner.qualified_name, `field.name, false, `field.declaring_type ?? type),
                        if raw_value? then raw_value.to_string() ?? "" else "" fi
                    )

                enum_member.set_doc(_doc_attribute(`field.get_custom_attributes_data()))
                enum_member.set_deprecation(_obsolete_attribute(`field.get_custom_attributes_data()))

                owner.add_member(enum_member)

                return
            fi

            let result: Symbols.Field mut
            let location = Source.LOCATION.reflected

            let field_name = `field.name

            let name: string? mut = null

            if field_name.length == 5 /\ `field.name.starts_with("Item") /\ type.is_generic_type then
                let unspecialized_type = type.get_generic_type_definition()

                let is_tuple mut = false

                for t in _tuple_types do
                    if unspecialized_type == t then
                        is_tuple = true
                        break
                    fi
                od

                if is_tuple then
                    name = "{(cast int(field_name[field_name.length-1]) - 49)}"
                fi
            fi

            if !name? then
                name = _type_name_map.get_member_name(owner.qualified_name, `field.name, false, false, `field.declaring_type ?? type)
            fi

            // For inherited fields, the declaring symbol must point at the base
            // class, not the derived class — otherwise the IL fieldref says
            // "Foo::SubjectField" instead of "FooBase`2<...>::SubjectField" and
            // the runtime can't find the field.
            let declaring_symbol: Symbols.Symbol mut = owner
            let dt = `field.declaring_type
            if dt? /\ dt != type then
                declaring_symbol = _type_mapper.get_type(dt).symbol
            fi

            if `field.is_static then
                let globals_namespace = _globals_owner_namespace(owner)
                let constant = REFLECTED_CONSTANTS.value_of(`field)

                if globals_namespace? then
                    let global = Symbols.GLOBAL_VARIABLE(location, globals_namespace, name)
                    global.il_carrier = cast Symbols.Classy?(owner)!
                    result = global
                elif isa ReflectedConstant.ABSENT(constant) then
                    result = Symbols.CONSTANT_FIELD(location, declaring_symbol, name, null)
                elif let value: ReflectedConstant.VALUE = constant then
                    result = Symbols.CONSTANT_FIELD(location, declaring_symbol, name, value.text)
                else
                    result = Symbols.STATIC_FIELD(location, declaring_symbol, name)
                fi
            elif type.is_value_type then
                result = Symbols.STRUCT_FIELD(location, declaring_symbol, name)
            else
                result = Symbols.INSTANCE_FIELD(location, declaring_symbol, name)
            fi

            result.il_name_override = `field.name

            let field_attributes = `field.get_custom_attributes_data()

            // The attribute check alone misses a field imported from an
            // assembly built by a compiler that predates it. A field name
            // is never operator syntax - only a function can be named with
            // one - so a leading `$` on a field carries no ambiguity and is
            // a safe legacy fallback, the same shape as
            // GLOBALS_CARRIER.is_carrier's attribute-or-name check.
            if _has_compiler_generated_attribute(field_attributes) \/ name.starts_with('$') then
                result.mark_synthesized()
            fi

            result.set_doc(_doc_attribute(field_attributes))
            result.set_deprecation(_obsolete_attribute(field_attributes))

            result.set_type(
                NULLABILITY.resolve(
                    _with_tuple_element_names(_type_mapper.get_type(`field.field_type), field_attributes),
                    field_attributes,
                    `field,
                    `field.field_type
                )!
            )

            // Same problem as add_method: inherited fields on a constructed
            // generic base have their declared type returned by reflection in
            // *substituted* form. Recover the open form via the open base type
            // and stash it as unspecialized_type; gen_reference prefers it.
            if dt? /\ dt != type /\ dt.is_generic_type /\ !dt.is_generic_type_definition then
                let open_type = dt.get_generic_type_definition()
                let open_field: FieldInfo? mut = null

                for m in open_type.get_members(cast BindingFlags(2 + 4 + 8 + 16 + 32)) do
                    if m.member_type == MemberTypes.FIELD then
                        let candidate = cast FieldInfo?(m)!
                        if candidate.metadata_token == `field.metadata_token then
                            open_field = candidate
                            break
                        fi
                    fi
                od

                if open_field? then
                    result.unspecialized_type = _type_mapper.get_type(open_field.field_type)
                fi
            fi

            owner.add_member(result)
        si

        // `family` and `famorassem` are deliberately absent: a subclass in
        // another assembly is entitled to a protected member.
        _is_reachable_from_other_assembly(method: MethodInfo) -> bool =>
            !(method.is_private \/ method.is_assembly \/ method.is_family_and_assembly) \/
            _is_session_member(method)

        // A member an earlier cell of the session declared, other than one
        // the compiler generated for it: the session is one assembly, so
        // its assembly-private members are as visible as they would be in
        // one file, and the ordinary access rules decide who may use them.
        _is_session_member(member: System.Reflection.MemberInfo) -> bool is
            let declaring = member.declaring_type

            return
                declaring? /\ !member.name.contains('$') /\
                IoC.CONTAINER.instance.assemblies.can_reach_privates_of(declaring.assembly)
        si

        // The name of the type's indexer property, as named by
        // `DefaultMemberAttribute`. A type with no marker cannot have
        // an indexer, but the name an indexer would take is still the
        // right answer for the accessor-naming comparison.
        _default_member_name(type: TYPE) -> string is
            for attr in type.get_custom_attributes_data() do
                if attr.attribute_type.full_name =~ "System.Reflection.DefaultMemberAttribute" then
                    for argument in attr.constructor_arguments do
                        let name = cast string?(argument.value)

                        if name? then
                            return name
                        fi
                    od
                fi
            od

            return Symbols.INDEXER_NAMES.property_name
        si

        add_property(
            owner: Symbols.Scoped,
            type: TYPE,
            properties: MAP[System.Reflection.MethodInfo,PROPERTY_DETAILS],
            indexers: SET[System.Reflection.MethodInfo],
            indexer_accessors: SET[System.Reflection.MethodInfo],
            property: PropertyInfo
        ) is
            let index_parameters = property.get_index_parameters()

            if index_parameters.count > 0 then
                // An indexed property is *the* indexer when the declaring
                // type nominates it. A type can carry others that indexing
                // must not reach — but one already named `Item` was
                // reachable before the nomination was consulted, so it
                // stays reachable whether or not it is the nominated one.
                let is_indexer =
                    property.name =~ _default_member_name(property.declaring_type ?? type) \/
                    property.name =~ Symbols.INDEXER_NAMES.property_name

                let getter = property.get_get_method()
                if getter? then
                    indexers.add(getter)

                    if is_indexer then
                        indexer_accessors.add(getter)
                    fi
                fi

                let setter = property.get_set_method()
                if setter? then
                    indexers.add(setter)

                    if is_indexer then
                        indexer_accessors.add(setter)
                    fi
                fi

                return
            fi

            if property.name =~ "Current" then
                if property.declaring_type == _type_source.get_type("System.Collections.IEnumerator") then
                    return
                fi
            fi

            let result: Symbols.Property mut
            let name =
                _ghul_name_override(property) ??
                _type_name_map.get_member_name(owner.qualified_name, property.name, false, property.is_special_name, property.declaring_type ?? type)

            let getter = property.get_method
            let setter = property.set_method

            if setter? /\ !getter? then
                return
            fi

            let is_static mut = false

            if getter? /\ getter.is_static then
                is_static = true
            elif setter? /\ setter.is_static then
                is_static = true
            fi

            if is_static then
                let globals_namespace = _globals_owner_namespace(owner)
                if globals_namespace? then
                    result = Symbols.GLOBAL_PROPERTY(Source.LOCATION.reflected, Source.LOCATION.reflected, globals_namespace, name, setter?)
                else
                    result = Symbols.STATIC_PROPERTY(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, name, setter?, false)
                fi
            else
                result = Symbols.INSTANCE_PROPERTY(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, name, setter?, false)
            fi

            result.set_type(
                _with_property_tuple_element_names(
                    NULLABILITY.resolve(
                        _type_mapper.get_type(property.property_type),
                        property.get_custom_attributes_data(),
                        property,
                        property.property_type
                    )!,
                    property
                )
            )
            result.il_name_override = property.name

            result.set_doc(_doc_attribute(property.get_custom_attributes_data()))
            result.set_deprecation(_obsolete_attribute(property.get_custom_attributes_data()))

            // Not CompilerGeneratedAttribute here: the C# compiler puts it
            // on a record's public surface too (EqualityContract is
            // protected, but a member reachable through inheritance still
            // has to stay visible where it's reachable at all), so it
            // does not distinguish hidden from ordinary API the way it
            // does for a field or a type. is_special_name is the CLR's
            // own narrower signal for a property that is not ordinary
            // API.
            if property.is_special_name then
                result.mark_synthesized()
            fi

            owner.add_member(result)

            let property_details = PROPERTY_DETAILS(result, property.get_get_method(), property.get_set_method())

            if getter? then
                properties[getter] = property_details
            fi

            if setter? then
                properties[setter] = property_details
            fi
        si

        add_method(
            owner: Symbols.Scoped,
            type: TYPE,
            properties: MAP[System.Reflection.MethodInfo,PROPERTY_DETAILS],
            indexers: SET[System.Reflection.MethodInfo],
            indexer_accessors: SET[System.Reflection.MethodInfo],
            methods: LIST[(function: Symbols.Function, method_info: MethodInfo)],
            method: MethodInfo
        ) is
            add_method(owner, type, properties, indexers, indexer_accessors, methods, method, null)
        si

        // `force_name`, when non-null, supplies the ghūl name instead of
        // deriving one from the method. Used to surface a single
        // reflected method under a second name: the derivation is
        // skipped so the alias cannot re-trigger the side effects some
        // of its branches carry.
        //
        // An alias of an abstract interface member is built as a
        // default trait method rather than an abstract one. Only the
        // primary name carries the obligation to implement, so a type
        // satisfies the interface by supplying that one member, while
        // both names remain callable.
        add_method(
            owner: Symbols.Scoped,
            type: TYPE,
            properties: MAP[System.Reflection.MethodInfo,PROPERTY_DETAILS],
            indexers: SET[System.Reflection.MethodInfo],
            indexer_accessors: SET[System.Reflection.MethodInfo],
            methods: LIST[(function: Symbols.Function, method_info: MethodInfo)],
            method: MethodInfo,
            force_name: string?
        ) is
            if !_is_reachable_from_other_assembly(method) then
                return
            fi

            let result: Symbols.Function mut
            let location = Source.LOCATION.reflected

            let name: string mut
            let hide_from_operator_resolution mut = false

            // Set when this method is declared under a name the compiler
            // itself picked ($get_iterator below) rather than one the
            // reflected metadata names it, so it never appears as a
            // second, ordinarily-callable member of the reflected type.
            let is_synthesized_name mut = false

            // Set when the method is also to be reached under its
            // ordinary de-camelled name, alongside the operator
            // spelling picked below.
            let alias_name: string? mut = null

            let property_details: PROPERTY_DETAILS mut

            if force_name? then
                name = force_name
            elif properties.try_get_value(method, property_details ref) then
                name =
                    _ghul_name_override(method) ??
                    _type_name_map.get_member_name(owner.qualified_name, method.name, method.is_private, true, method.declaring_type ?? type)
                is_synthesized_name = true
            elif indexer_accessors.contains(method) then
                // Declared only under the indexer names, whatever
                // metadata calls the accessor. An indexer is reached by
                // indexing and by nothing else, so the metadata spelling
                // is deliberately not surfaced as a second member.
                name = Symbols.INDEXER_NAMES.accessor(method.name)
            elif method.name =~ "Equals" /\ _is_self_relational_interface_target(type, method, _equatable_open_type, _bool_type) then
                name = "=~"
                alias_name = _plain_member_name(owner, type, indexers, method)
                hide_from_operator_resolution = type.full_name? /\ _innate_equality_type_names.contains(type.full_name)
            elif method.name =~ "CompareTo" /\ _is_self_relational_interface_target(type, method, _comparable_open_type, _int_type) then
                name = "<>"
                alias_name = _plain_member_name(owner, type, indexers, method)
                hide_from_operator_resolution = type.full_name? /\ _innate_order_type_names.contains(type.full_name)
            elif method.name =~ "get_Current" /\ method.declaring_type == _type_source.get_type("System.Collections.IEnumerator") then
                return
            elif method.name =~ "GetEnumerator" then
                if method.declaring_type == _type_source.get_type("System.Collections.IEnumerable") then
                    return
                fi

                name = "$get_iterator"
                is_synthesized_name = true

                let iterator_property = Symbols.INSTANCE_PROPERTY(Source.LOCATION.reflected, Source.LOCATION.reflected, owner, "iterator", false, false)
                iterator_property.set_type(_type_mapper.get_type(method.return_type))

                owner.add_member(iterator_property)

                property_details = PROPERTY_DETAILS(iterator_property, method, null)
            elif
                method.is_static /\
                let mdt0 = method.declaring_type in mdt0? /\
                _generic_math_operator_name(method.name)? /\
                (
                    (method.is_virtual /\ mdt0.is_interface) \/
                    _declares_own_operators(mdt0)
                )
            then
                name = _generic_math_operator_name(method.name)!
            else
                name = _plain_member_name(owner, type, indexers, method)

                // A .NET special name - an operator, an event accessor -
                // is reached through its dedicated syntax, never under
                // any name, whatever assembly declared it. The flag on
                // the row is the upstream fact; the $ spelling
                // get_member_name derives from it is presentation.
                //
                // The test repeats the two carve-outs _plain_member_name
                // applies, so the verdict and the name stay in step: an
                // indexer accessor is named under its indexer names, and
                // a ghūl name override replaces the derived spelling
                // outright - either way there is no $ to hide.
                if
                    method.is_special_name /\
                    !indexers.contains(method) /\
                    !_ghul_name_override(method)?
                then
                    is_synthesized_name = true
                fi
            fi

            let declaring_symbol: Symbols.Symbol mut = owner

            let mdt = method.declaring_type
            if mdt? /\ mdt != type then
                declaring_symbol = _type_mapper.get_type(mdt).symbol
            fi

            let intrinsic_operation = _intrinsic_operation(method.get_custom_attributes_data())

            // A constructor intrinsic is an ordinary method: it is reached
            // as a constructor of the type it returns, and called as itself.
            if intrinsic_operation? /\ !intrinsic_operation.starts_with("constructor.") then
                let globals_namespace = if method.is_static then _globals_owner_namespace(owner) else null fi

                if globals_namespace? then
                    // Innate calls lower to opcodes inline and never emit a
                    // methodref, so an innate function needs no il_assembly_name.
                    let home = _intrinsic_home(name, method)

                    if home? then
                        result = Symbols.INNATE_FUNCTION(location, home, name, home, intrinsic_operation)
                    else
                        result = Symbols.INNATE_FUNCTION(location, globals_namespace, name, globals_namespace, intrinsic_operation)
                    fi
                else
                    result = Symbols.INNATE_METHOD(location, declaring_symbol, name, owner, intrinsic_operation)
                fi
            elif method.is_static then
                let globals_namespace = _globals_owner_namespace(owner)
                if globals_namespace? then
                    let global = Symbols.GLOBAL_FUNCTION(location, location, globals_namespace, name, globals_namespace)
                    global.il_carrier = cast Symbols.Classy?(owner)!
                    result = global
                else
                    let static_method = Symbols.STATIC_METHOD(location, location, declaring_symbol, name, owner)

                    // A static virtual/abstract interface member -
                    // .NET's generic-math feature. Reachable through a
                    // bound type parameter, which needs the
                    // `constrained.` call shape; an ordinary reflected
                    // static method never is.
                    static_method.is_static_interface_virtual = method.is_virtual /\ mdt? /\ mdt.is_interface

                    static_method.cannot_be_overridden = !static_method.is_static_interface_virtual

                    result = static_method
                fi
            elif mdt? /\ mdt.is_value_type then
                result = Symbols.STRUCT_METHOD(location, location, declaring_symbol, name, owner)

                result.cannot_be_overridden = true
            elif method.is_abstract /\ !force_name? then
                result = Symbols.ABSTRACT_METHOD(location, location, declaring_symbol, name, owner)
            elif mdt? /\ mdt.is_interface then
                result = Symbols.DEFAULT_TRAIT_METHOD(location, location, declaring_symbol, name, owner)
            else
                result = Symbols.INSTANCE_METHOD(location, location, declaring_symbol, name, owner)

                // A non-virtual or final CLR method binds to exactly
                // one body, and so does any method of a sealed owner:
                // no subclass exists to override it in.
                result.cannot_be_overridden =
                    !method.is_virtual \/ method.is_final \/ (mdt? /\ mdt.is_sealed)
            fi

            if method.is_generic_method then
                result.is_generic = true

                let generic_argument_names = LIST()
                let generic_arguments = LIST()
                let generic_argument_constraint_kinds = Collections.LIST[Symbols.TypeParameterConstraintKind]()
                let generic_argument_has_constructor_constraint = Collections.LIST[bool]()
                let generic_argument_type_bounds = Collections.LIST[Collections.List[Semantic.Types.Type]]()

                let ga = method.get_generic_arguments()

                for p in ga do
                    generic_argument_names.add(p.name)
                    generic_arguments.add(_type_mapper.get_type(p))
                    generic_argument_constraint_kinds.add(_type_mapper.generic_parameter_constraint_kind(p))
                    generic_argument_has_constructor_constraint.add(_type_mapper.generic_parameter_has_constructor_constraint(p))
                    generic_argument_type_bounds.add(type_bounds(p))
                od

                result.generic_argument_names = generic_argument_names
                result.generic_arguments = generic_arguments
                result.generic_argument_constraint_kinds = generic_argument_constraint_kinds
                result.generic_argument_has_constructor_constraint = generic_argument_has_constructor_constraint

                if generic_argument_type_bounds.count > 0 /\ generic_argument_type_bounds |> any(l => l.count > 0) then
                    result.generic_argument_type_bounds = generic_argument_type_bounds
                fi
            fi

            result.il_name_override = method.name
            result.is_hidden_from_operator_resolution = hide_from_operator_resolution

            // Not CompilerGeneratedAttribute on a foreign assembly: the C#
            // compiler puts it on a record's ToString, Equals, GetHashCode,
            // Deconstruct and equality operators too - ordinary callable
            // API, not hidden members - so unlike a field or a type it does
            // not distinguish the two there. On a ghūl-compiled assembly it
            // is authoritative: the emitter marks what it synthesises -
            // property accessors, lambda bodies compiled onto their
            // enclosing type as $anon members, state-machine frame members,
            // the Object.Equals bridge - and marks nothing a user wrote,
            // since an authored member is either public and unmarked or
            // invisible past the assembly boundary. Reading it recognises
            // those shapes whatever name they travel under, and leaves an
            // author's own `$` spelling alone.
            if
                is_synthesized_name \/
                (
                    _type_name_map.is_ghul_compiled(method.declaring_type ?? type) /\
                    _has_compiler_generated_attribute(method.get_custom_attributes_data())
                )
            then
                result.mark_synthesized()
            fi

            if method.is_family \/ method.is_family_or_assembly then
                result.mark_imported_protected()
            fi

            if _has_pure_attribute(method.get_custom_attributes_data()) then
                // the marker carries the declared-pure contract: the
                // function is trusted store-free, and local overrides
                // are held to the pure-override contract here in the
                // overriding assembly
                result.mark_declared_pure()
            fi

            if _has_stable_attribute(method.get_custom_attributes_data()) then
                // the marker carries the declared-stable contract of
                // the property this accessor reads: facts narrowed
                // through it count as backed, and local overrides are
                // held to the stable-override contract here in the
                // overriding assembly
                result.mark_declared_stable()
            fi

            result.set_doc(_doc_attribute(method.get_custom_attributes_data()))
            result.set_deprecation(_obsolete_attribute(method.get_custom_attributes_data()))

            let argument_names = LIST()
            let argument_types = LIST()
            let argument_defaults = Collections.LIST[string?]()
            let argument_reads = Collections.LIST[bool]()
            let argument_writes = Collections.LIST[bool]()
            let argument_is_pack = Collections.LIST[bool]()
            let argument_pack_depth = Collections.LIST[int]()
            let spread_argument_index mut = -1
            let has_direction_override mut = false

            for a in method.get_parameters() do
                argument_names.add(a.name ?? "")
                let arg_attributes = a.get_custom_attributes_data()

                let pack_depth = _argument_pack_depth(arg_attributes)

                argument_is_pack.add(pack_depth >= 0)
                argument_pack_depth.add(if pack_depth >= 0 then pack_depth else 0 fi)

                if _has_attribute_named(arg_attributes, ARGUMENT_SPREAD_ATTRIBUTE_NAME) then
                    spread_argument_index = argument_names.count - 1
                fi

                argument_types.add(
                    _with_pure_function(
                        NULLABILITY.resolve(
                            _with_tuple_element_names(_type_mapper.get_type(a.parameter_type), arg_attributes),
                            arg_attributes,
                            method,
                            a.parameter_type
                        )!,
                        arg_attributes
                    )
                )
                argument_defaults.add(_default_for_parameter(a))
                argument_reads.add(!(a.is_out /\ !a.is_in))
                argument_writes.add(!(a.is_in /\ !a.is_out))
                if a.is_out \/ a.is_in then
                    has_direction_override = true
                fi
            od

            result.argument_is_pack = argument_is_pack
            result.argument_pack_depth = argument_pack_depth
            result.spread_argument_index = spread_argument_index

            let return_pack_depth = _pack_depth(method.get_custom_attributes_data(), RETURN_PACK_ATTRIBUTE_NAME)

            if return_pack_depth >= 0 then
                result.return_pack_depth = return_pack_depth
            fi
            result.argument_names = argument_names
            result.arguments = argument_types
            result.argument_defaults = argument_defaults

            if has_direction_override then
                result.set_argument_directions(argument_reads, argument_writes)
            fi

            let return_attributes = method.return_parameter.get_custom_attributes_data()
            result.return_type =
                _with_pure_function(
                    NULLABILITY.resolve(
                        _with_tuple_element_names(
                            _type_mapper.get_type(method.return_type),
                            return_attributes
                        ),
                        return_attributes,
                        method,
                        method.return_type
                    )!,
                    return_attributes
                )

            result.mark_pack_type_parameters()

            // When inheriting a method from a constructed-generic base in another
            // assembly, reflection returns parameter and return types in their
            // *substituted* form (e.g. !0 surfaces as System.Object when the base
            // is FooBase<object,...>). The CLR requires the methodref signature
            // to use the open-generic form (!0, !!0). Recover the open form via
            // the open base type and stash it as unspecialized_*; the IL emitter
            // already prefers unspecialized_* when present.
            let dt = method.declaring_type
            if dt? /\ dt != type /\ dt.is_generic_type /\ !dt.is_generic_type_definition then
                let open_type = dt.get_generic_type_definition()
                let open_method: MethodInfo? mut = null

                for m in open_type.get_members(cast BindingFlags(2 + 4 + 8 + 16 + 32)) do
                    if m.member_type == MemberTypes.METHOD then
                        let candidate = cast MethodInfo?(m)!
                        if candidate.metadata_token == method.metadata_token then
                            open_method = candidate
                            break
                        fi
                    fi
                od

                if open_method? then
                    let unspec_arg_types = LIST()
                    for a in open_method.get_parameters() do
                        unspec_arg_types.add(_type_mapper.get_type(a.parameter_type))
                    od
                    result.unspecialized_arguments = unspec_arg_types
                    result.unspecialized_return_type = _type_mapper.get_type(open_method.return_type)
                fi
            fi

            // property_details is only set for a property accessor method:
            // most of the branches above never touch it, so it reaches here
            // unassigned on every other path.
            @suppress("presence-test-non-optional", "definite-assignment")
            if property_details? then
                let accessor_method_name = method.name

                if method.equals(property_details.dotnet_get_method) then
                    property_details.ghul_property.read_function = result
                    property_details.ghul_property.read_function_il_name_override = method.name
                elif method.equals(property_details.dotnet_set_method) then
                    property_details.ghul_property.assign_function = result
                    property_details.ghul_property.assign_function_il_name_override = method.name
                fi
            fi

            methods.add((result, method))

            // `IEquatable[T].Equals` and `IComparable[T].CompareTo` are
            // reached as the operators `=~` and `<>`, and also under the
            // ordinary de-camelled name, so a call spelled `equals` or
            // `compare_to` resolves as well. Both symbols carry the same
            // `il_name_override`, so either spelling emits a call to the
            // one underlying method.
            if alias_name? then
                add_method(owner, type, properties, indexers, indexer_accessors, methods, method, alias_name)
            fi
        si

        // The type an intrinsic operator is registered on: the type of its
        // first operand, for the operators a type declares for itself.
        // Null for every other intrinsic, which stays global.
        _intrinsic_home(name: string, method: MethodInfo) -> Symbols.Classy? is
            if !Symbols.TYPE_HOMED_OPERATORS.contains(name) then
                return null
            fi

            let parameters = method.get_parameters()

            if parameters.count == 0 then
                return null
            fi

            if let first: Semantic.Types.NAMED = _type_mapper.get_type(parameters[0].parameter_type) then
                return cast Symbols.Classy?(first.symbol)
            fi

            return null
        si

        // Whether a type's public static operator methods import under
        // their operator spelling. The scalar types do not: their
        // operators are the intrinsics, and a reflected `op_Addition` on
        // `System.Decimal` or `System.IntPtr` would be a second candidate
        // for the same operands.
        _declares_own_operators(type: TYPE) -> bool =>
            !type.is_interface /\ !_intrinsic_operator_types.contains(type)

        // The ghūl spelling of a CLR operator-method name, or null for a
        // method that is not one. Consulted for a static virtual interface
        // member and for a public static operator on an ordinary type; a
        // scalar type's reflected operator keeps its mangled name, since
        // the intrinsic is that type's operator.
        //
        // The arithmetic, bitwise and shift operators. The comparison and
        // equality operators are deliberately absent: ghūl derives those
        // from `<>` and `=~`, and a bound that supplies these operators
        // supplies those too, so importing `op_LessThan` as `<` would
        // give the same expression a second, unrelated route to a
        // different member.
        _generic_math_operator_name(dotnet_name: string) -> string? =>
            case dotnet_name
            when "op_Addition" then "+"
            when "op_Subtraction" then "-"
            when "op_Multiply" then "*"
            when "op_Division" then "/"
            when "op_Modulus" then "%"
            when "op_UnaryNegation" then "-"
            when "op_BitwiseAnd" then "&"
            when "op_BitwiseOr" then "|"
            when "op_ExclusiveOr" then "^"
            when "op_OnesComplement" then "\\"
            when "op_LeftShift" then "<<"
            when "op_RightShift" then ">>"
            when "op_UnsignedRightShift" then ">>>"
            else null
            esac

        _plain_member_name(
            owner: Symbols.Scoped,
            type: TYPE,
            indexers: SET[System.Reflection.MethodInfo],
            method: MethodInfo
        ) -> string =>
            _ghul_name_override(method) ??
            _type_name_map.get_member_name(
                owner.qualified_name,
                method.name,
                method.is_private,
                method.is_special_name /\ !indexers.contains(method),
                method.declaring_type ?? type
            )

        get_assembly_name(type: TYPE) -> string is
            let assembly = type.assembly

            let result: string mut

            if _assembly_names.try_get_value(assembly, result ref) then
                return result
            fi

            result = assembly.get_name().name ?? ""

            _assembly_names.add(assembly, result)

            return result
        si

        // C# records TupleElementNamesAttribute on the property itself;
        // a ghūl assembly built before the property carried it holds
        // the names only on the getter's `.param [0]`, which reflects
        // as the return parameter rather than as a method attribute.
        // Every reflected property reaches here, so neither carrier is
        // read until the type is known to be a tuple.
        _with_property_tuple_element_names(
            type: Types.Type,
            property: PropertyInfo
        ) -> Types.Type is
            let names =
                TUPLE_ELEMENT_NAMES.read(property.get_custom_attributes_data()) ??
                (if let getter = property.get_get_method() then
                     TUPLE_ELEMENT_NAMES.read(getter.return_parameter.get_custom_attributes_data())
                 else
                     null
                 fi)

            if let found = names then
                return TUPLE_ELEMENT_NAMES.apply(type, found)
            fi

            return type
        si

        // If `attributes` carry a TupleElementNamesAttribute, return
        // `type` with the recovered names put back on every tuple in it,
        // however deep; otherwise return `type` unchanged. The reflected
        // ValueTuple type itself has no names.
        _with_tuple_element_names(
            type: Types.Type,
            attributes: Collections.Iterable[System.Reflection.CustomAttributeData]
        ) -> Types.Type is
            let names = TUPLE_ELEMENT_NAMES.read(attributes)

            if !names? then
                return type
            fi

            return TUPLE_ELEMENT_NAMES.apply(type, names)
        si

        // The name `GHUL_NAME_ATTRIBUTE` carries, when a member is
        // marked with one — an override or interface implementation
        // whose IL name the base or interface fixed, so the IL name
        // itself cannot be de-camelled back to the ghūl name the way
        // an ordinary member's can. Read in preference to any name
        // computed from the IL name.
        _ghul_name_override(member: MemberInfo) -> string? is
            try
                for attr in member.get_custom_attributes_data() do
                    if attr.attribute_type.full_name =~ "Ghul.Internal.GHUL_NAME_ATTRIBUTE" then
                        return cast string?(attr.constructor_arguments[0].value)
                    fi
                od
            catch ex: System.Exception
            yrt

            return null
        si

        has_union_attribute(type: TYPE) -> bool is
            try
                for attr in type.get_custom_attributes_data() do
                    let attr_type = attr.attribute_type

                    if attr_type.full_name =~ "Ghul.Internal.UNION_ATTRIBUTE" then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        has_variant_attribute(type: TYPE) -> bool is
            try
                for attr in type.get_custom_attributes_data() do
                    let attr_type = attr.attribute_type

                    if attr_type.full_name =~ "Ghul.Internal.VARIANT_ATTRIBUTE" then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        has_default_variant_attribute(type: TYPE) -> bool is
            try
                for attr in type.get_custom_attributes_data() do
                    let attr_type = attr.attribute_type

                    if attr_type.full_name =~ "Ghul.Internal.DEFAULT_VARIANT_ATTRIBUTE" then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        // Resolving an attribute's type reaches for the assembly that
        // declares it, so a marker this compiler emits against a runtime
        // too old to declare it throws rather than answering. Treated as
        // absent: the slot then reads the way it did before the marker
        // existed.
        ARGUMENT_PACK_ATTRIBUTE_NAME: string static =>
            "Ghul.Internal.ARGUMENT_PACK_ATTRIBUTE"

        RETURN_PACK_ATTRIBUTE_NAME: string static =>
            "Ghul.Internal.RETURN_PACK_ATTRIBUTE"

        ARGUMENT_SPREAD_ATTRIBUTE_NAME: string static =>
            "Ghul.Internal.ARGUMENT_SPREAD_ATTRIBUTE"

        // How deep in the parameter's own type the argument-pack marker
        // sits, and negative when the parameter carries no marker at
        // all. The argumentless form of the attribute is depth zero -
        // the parameter's own function type - which is what an assembly
        // built before the marker could be written deeper records.
        _argument_pack_depth(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> int =>
            _pack_depth(attributes, ARGUMENT_PACK_ATTRIBUTE_NAME)

        _pack_depth(
            attributes: Collections.Iterable[System.Reflection.CustomAttributeData],
            attribute_name: string
        ) -> int is
            try
                for attr in attributes do
                    if attr.attribute_type.full_name =~ attribute_name then
                        for argument in attr.constructor_arguments do
                            if let depth = cast int?(argument.value) then
                                return depth
                            fi
                        od

                        return 0
                    fi
                od
            catch ex: System.Exception
            yrt

            return -1
        si

        _has_attribute_named(attributes: Collections.Iterable[System.Reflection.CustomAttributeData], name: string) -> bool is
            try
                for attr in attributes do
                    if attr.attribute_type.full_name =~ name then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        _has_pure_attribute(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> bool is
            try
                for attr in attributes do
                    let attr_type = attr.attribute_type

                    if attr_type.full_name =~ "Ghul.Internal.PURE_ATTRIBUTE" then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        // What a System.ObsoleteAttribute on a member says: its message, if it
        // has one, and whether a use is an error. Null when there is none.
        _obsolete_attribute(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> Semantic.DEPRECATION? is
            try
                for attr in attributes do
                    if attr.attribute_type.full_name =~ "System.ObsoleteAttribute" then
                        let arguments = attr.constructor_arguments

                        let message =
                            if arguments.count > 0 then cast string?(arguments[0].value) else null fi

                        let is_error =
                            if arguments.count > 1 then
                                if let flag: bool = arguments[1].value then flag else false fi
                            else
                                false
                            fi

                        return Semantic.DEPRECATION(message, is_error)
                    fi
                od
            catch ex: System.Exception
            yrt

            return null
        si

        // The text of a `///` doc comment the declaring assembly carried
        // across, or null.
        _doc_attribute(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> string? is
            try
                for attr in attributes do
                    if
                        attr.attribute_type.full_name =~ "Ghul.Internal.DOC_ATTRIBUTE" /\
                        attr.constructor_arguments.count == 1
                    then
                        return cast string?(attr.constructor_arguments[0].value)
                    fi
                od
            catch ex: System.Exception
            yrt

            return null
        si

        _has_stable_attribute(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> bool is
            try
                for attr in attributes do
                    let attr_type = attr.attribute_type

                    if attr_type.full_name =~ "Ghul.Internal.STABLE_ATTRIBUTE" then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        // The BCL's own marker for a synthesised member or type — see
        // SRM_STRUCTURE_WALK.COMPILER_GENERATED_ATTRIBUTE_NAME for the
        // emission side. Reading it back means an importing compilation
        // recognises a synthesised symbol without testing its name,
        // whether the assembly it came from is ghūl-compiled or not —
        // a C#-compiled record's synthesised members carry it too.
        _has_compiler_generated_attribute(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> bool is
            try
                for attr in attributes do
                    let attr_type = attr.attribute_type

                    if attr_type.full_name =~ "System.Runtime.CompilerServices.CompilerGeneratedAttribute" then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        // True when `method` is `type`'s implementation of the
        // self-instantiated generic interface named by `open_interface_name`
        // (`System.IEquatable\`1` or `System.IComparable\`1`) — i.e. `type`
        // implements `IEquatable[type]`/`IComparable[type]`, not some other
        // instantiation, and `method` is that interface member rather than
        // an unrelated same-named overload (`object.Equals`, the
        // non-generic `IComparable.CompareTo(object)`).
        //
        // `Type.GetInterfaceMap` would answer this directly but throws
        // `NotSupportedException` under the `MetadataLoadContext` this
        // reflection runs in (import assemblies are loaded for metadata
        // only, never executed), so this matches by signature instead:
        // `IEquatable[T].Equals`/`IComparable[T].CompareTo` are always
        // exactly `(T) -> bool`/`(T) -> int`, and no other member can
        // satisfy that interface with a different parameter type. The one
        // gap this leaves is a type that implements the interface
        // *explicitly* (`bool IEquatable<Box>.Equals(Box other)`) — that
        // member doesn't surface under its simple name in `GetMethods()`
        // at all, with or without `GetInterfaceMap`, so it's an existing
        // reflection-layer limitation rather than one this check adds.
        _is_self_relational_interface_target(type: TYPE, method: MethodInfo, open_interface: TYPE, expected_return_type: TYPE) -> bool is
            if method.return_type != expected_return_type then
                return false
            fi

            let parameters = method.get_parameters()

            if parameters.count != 1 then
                return false
            fi

            // `IEquatable[T].=~`/`IComparable[T].<>` on the trait's own
            // declaration: `type` is the open interface itself (reflecting
            // `Ghul.Equatable[T]`'s member list, not a concrete
            // implementer), and the parameter is its own type parameter.
            if type == open_interface then
                return parameters[0].parameter_type == open_interface.get_generic_arguments()[0]
            fi

            // An implementer: `type` closed-implements `IEquatable[type]`
            // and the parameter is `type` itself.
            let closed_interface = open_interface.make_generic_type([type])

            return type.get_interfaces() |> any(i => i == closed_interface) /\
                parameters[0].parameter_type == type
        si

        // The intrinsic operation name (e.g. "arithmetic.add") carried by
        // a method's INTRINSIC_ATTRIBUTE, or null if it carries none. An
        // imported method bearing the marker is reconstructed as an innate
        // function whose calls lower to IL opcodes, matching a source-
        // declared intrinsic.
        _intrinsic_operation(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> string? =>
            INTRINSIC_OPERATION.of(attributes)

        // The constructors the runtime supplies for a type that has none of
        // its own for the argument, as `init` overloads calling the runtime
        // method in place of a newobj. Their parameters are the method's,
        // with its type parameters read as the type's own where the type has
        // them, and otherwise kept as the constructor's own, inferred from
        // the arguments.
        _add_constructor_intrinsics(owner: Symbols.Scoped, type: TYPE) is
            let methods =
                if _intrinsic_operation(type.get_custom_attributes_data()) =~ "type.array" then
                    _type_details_lookup.array_constructor_intrinsics
                else
                    _type_details_lookup.constructor_intrinsics_for(type)
                fi

            for method in methods do
                let target = _find_reflected_function(method)

                if !target? then
                    continue
                fi

                let shaped =
                    if method.is_generic_method_definition /\ type.is_generic_type_definition then
                        method.make_generic_method(type.get_generic_arguments())
                    else
                        method
                    fi

                let location = Source.LOCATION.reflected
                let result = Symbols.INSTANCE_METHOD(location, location, owner, "init", owner)

                let argument_names = LIST[string]()
                let argument_types = LIST[Type]()

                for parameter in shaped.get_parameters() do
                    argument_names.add(parameter.name ?? "")
                    argument_types.add(_type_mapper.get_type(parameter.parameter_type))
                od

                result.argument_names = argument_names
                result.arguments = argument_types
                result.return_type = _type_mapper.get_type(_void_type)
                result.constructor_target = target

                if target.is_declared_pure then
                    result.mark_declared_pure()
                fi

                if shaped.is_generic_method_definition then
                    let generic_argument_names = LIST[string]()
                    let generic_arguments = LIST[Type]()

                    for parameter in shaped.get_generic_arguments() do
                        generic_argument_names.add(parameter.name)
                        generic_arguments.add(_type_mapper.get_type(parameter))
                    od

                    result.is_generic = true
                    result.generic_argument_names = generic_argument_names
                    result.generic_arguments = generic_arguments
                fi
                result.mark_synthesized()

                owner.add_member(result)
            od
        si

        _find_reflected_function(method: System.Reflection.MethodInfo) -> Symbols.Function? is
            let carrier_type = method.declaring_type

            if !carrier_type? then
                return null
            fi

            let carrier = cast Symbols.Scoped?(_symbol_table.get_symbol(carrier_type))

            if !carrier? then
                return null
            fi

            let group = cast Symbols.FUNCTION_GROUP?(carrier.find_direct(method.name))

            if !group? then
                return null
            fi

            let parameter_count = method.get_parameters().count

            for function in group.functions do
                if function.arguments.count == parameter_count then
                    return function
                fi
            od

            return null
        si

        // A parameter or return slot carrying the purity marker has a
        // pure top-level function type: rebuild the mapped type in
        // its pure shape. Slots whose mapped type is not a function
        // type (or is the zero-argument void form, which has no pure
        // shape) keep the plain type — conservative on both sides.
        _with_pure_function(type: Types.Type, attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> Types.Type is
            if !type.is_function \/ !isa Types.GENERIC(type) \/ !_has_pure_attribute(attributes) then
                return type
            fi

            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let types = Collections.LIST[Types.Type]()

            for a in (cast Types.GENERIC(type)).arguments do
                types.add(a)
            od

            if type.is_action then
                types.add(lookup.get_void_type())
            fi

            return lookup.get_function_type(types, true)
        si

        // A delegate type, found by walking the base chain to
        // System.MulticastDelegate and comparing reflected types by
        // identity. What a delegate member does is whatever its target
        // does, so nothing about its shape can vouch for it.
        _inherits_multicast_delegate(type: TYPE) -> bool is
            let current mut = type.base_type

            while current? do
                if current == _multicast_delegate_type then
                    return true
                fi

                current = current.base_type
            od

            return false
        si

        has_closed_attribute(type: TYPE) -> bool is
            try
                for attr in type.get_custom_attributes_data() do
                    let attr_type = attr.attribute_type

                    if attr_type.full_name =~ "Ghul.Internal.CLOSED_ATTRIBUTE" then
                        return true
                    fi
                od
            catch ex: System.Exception
            yrt

            return false
        si

        // Cross-assembly variant materialization: when reflecting a
        // union from another assembly, the variant classes are
        // sibling top-level types whose `Namespace` equals the
        // union's full name (assemblies.ghul: import_type queues
        // them into TYPE_DETAILS_LOOKUP by union full name instead
        // of registering them as top-level). When the union's
        // symbol is created and its members populated, call this
        // to also materialize the variants as members of the union.
        materialize_variants(union_symbol: Symbols.UNION, union_type: TYPE) is
            let union_full_name = union_type.full_name

            if !union_full_name? then
                return
            fi

            let variants = _type_details_lookup.get_variants_for_union(union_full_name)

            if !variants? then
                return
            fi

            for variant_type in variants do
                materialize_variant(union_symbol, variant_type)
            od
        si

        materialize_variant(union_symbol: Symbols.UNION, variant_type: TYPE) is
            let variant_name = variant_type.name
            let assembly_name = get_assembly_name(variant_type)

            let arguments = LIST()
            let argument_variances = LIST()

            if variant_type.is_generic_type /\ variant_type.contains_generic_parameters then
                for a in variant_type.get_generic_arguments() do
                    if a.is_generic_type_parameter then
                        arguments.add(a.name)
                        argument_variances.add(_type_mapper.map_type_argument_variance(a))
                    fi
                od
            fi

            let variant_symbol =
                Symbols.VARIANT(
                    Source.LOCATION.reflected,
                    Source.LOCATION.reflected,
                    union_symbol,
                    variant_name,
                    arguments,
                    union_symbol
                )

            variant_symbol.mark_overrides_resolved()

            if argument_variances.count > 0 then
                variant_symbol.argument_variances = argument_variances
            fi

            variant_symbol.il_assembly_name = assembly_name
            variant_symbol.il_name_override = get_il_name(variant_type)
            variant_symbol.dotnet_full_name = variant_type.full_name

            // Register the variant in the lookup so subsequent
            // dotnet-type-keyed lookups (`get_symbol(type)`) and
            // resolution paths can find it.
            let variant_td =
                TYPE_DETAILS(
                    variant_type,
                    union_symbol.qualified_name,
                    variant_name,
                    variant_symbol.il_name_override,
                    assembly_name
                )

            union_symbol.add_member(variant_symbol)

            add_ancestors(variant_symbol, variant_type)
            add_members(variant_symbol, variant_type)
            resolve_overrides(variant_symbol)

            // Populate the variant's `_field_names` list from the
            // .NET instance-field declaration order so positional
            // destructuring (`let (v, r) = step`) works the same
            // way it does for an intra-assembly variant. Source-
            // defined variants get this filled by
            // `declare_variable`; reflected variants need to do it
            // explicitly here.
            for `field in variant_type.get_fields() do
                if !`field.is_static /\ `field.is_public then
                    variant_symbol.register_reflected_field_name(`field.name)
                fi
            od

            // Wire the parent union's `default_variant` pointer to
            // the marked variant so cross-asm `u?` / `u!` lowers to
            // isa/cast against this variant — matching what source-
            // defined unions get from declare_members.
            if has_default_variant_attribute(variant_type) then
                variant_symbol.is_default = true
                union_symbol.default_variant = variant_symbol
            fi
        si

        // The CLR-side full name, with the nested-type separator the
        // metadata reader expects: reflection spells a nested type
        // `Outer+Inner`, and a type reference names it `Outer/Inner`.
        get_il_name(type: TYPE) -> string is
            let full_name: string? = type.full_name

            assert full_name? else "get il name type has no full name: {type}"

            return full_name.replace("+", "/")
        si

        // Reflect the .NET-declared default value of a parameter into
        // the string form that `Function.argument_defaults` expects.
        // - null ⇒ no default ⇒ parameter is not omittable.
        // - "default" ⇒ omittable, fill with `IR.Values.DEFAULT` (the
        //   .NET parameter is a reference type with `= null`, or a
        //   `Nullable<T>` with no constant value).
        // - any other string ⇒ a constant literal, formatted with
        //   invariant culture so the emission side can read it back
        //   independent of host locale.
        //
        // Conservative gate: only primitive numeric types, bool, char,
        // string, and enums are stored. Anything else (decimal,
        // struct, …) returns null so the parameter is treated as not
        // omittable rather than silently filled with a zero default.
        _default_for_parameter(a: ParameterInfo) -> string? is
            if !a.has_default_value then
                return null
            fi

            let raw = a.raw_default_value

            // This channel does spell an absent value as a word, because
            // ghūl's own `= _` reaches it that way and a parameter
            // default is read back by the same conversion.
            if !raw? then
                return "default"
            fi

            return REFLECTED_CONSTANTS.text_of(raw, a.parameter_type)
        si
    si
si
