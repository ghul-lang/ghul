namespace Semantic.DotNet is
    use TYPE = System.Type;    use IO.Std

    use Collections.Iterable

    use Collections.MutableList
    use Collections.LIST

    use Collections.MutableMap
    use Collections.MAP

    use Collections.SET

    class TYPE_DETAILS_LOOKUP is
        // lookups from .NET types will use this route which maps 1:1
        _type_details_by_dotnet_type: MutableMap[TYPE, TYPE_DETAILS]

        // lookups from ghūl - requires a linear seach but:
        // 1) we will often want all the names in a namespace, for completion suggestsions
        // 2) the result of other look-ups wll be cached
        _type_details_by_ghul_namespace: MutableMap[string, MutableList[TYPE_DETAILS]]

        // Variant types reflected from `union` declarations in other
        // assemblies are NOT added under their .NET `Namespace`
        // (which equals the union's full name and would otherwise
        // collide with the union class on namespace creation). They
        // are queued here keyed by the union's full .NET name so the
        // union's symbol can materialize them as nested members at
        // creation time.
        _variants_by_union_full_name: MutableMap[string, MutableList[TYPE]]

        // Namespaces holding at least one globals carrier. Name resolution
        // misses often, so the namespaces with no carrier at all - almost all
        // of them - have to answer without walking their type details.
        _namespaces_with_globals_carrier: SET[string]

        // Runtime methods marked as `constructor.` intrinsics, keyed by the
        // generic definition of the type each returns, and those returning
        // an array, which the language's own ARRAY type answers for.
        _constructor_intrinsics: MutableMap[TYPE, MutableList[System.Reflection.MethodInfo]]
        _array_constructor_intrinsics: MutableList[System.Reflection.MethodInfo]

        // Old names of renamed types, which resolve to the type under its
        // new name.
        aliases: TYPE_NAME_ALIASES

        ghul_namespaces: Iterable[string] => _type_details_by_ghul_namespace.keys

        has_globals_carrier(namespace_name: string) -> bool =>
            _namespaces_with_globals_carrier.contains(namespace_name)

        init() is
            _type_details_by_dotnet_type = MAP[TYPE, TYPE_DETAILS]()
            _type_details_by_ghul_namespace = MAP[string, MutableList[TYPE_DETAILS]]()
            _variants_by_union_full_name = MAP[string, MutableList[TYPE]]()
            _namespaces_with_globals_carrier = SET[string]()
            _constructor_intrinsics = MAP[TYPE, MutableList[System.Reflection.MethodInfo]]()
            _array_constructor_intrinsics = LIST[System.Reflection.MethodInfo]()
            aliases = TYPE_NAME_ALIASES()
        si

        register_constructor_intrinsic(method: System.Reflection.MethodInfo) is
            let result_type = method.return_type

            if result_type.is_array then
                _array_constructor_intrinsics.add(method)
                return
            fi

            let key = if result_type.is_generic_type then result_type.get_generic_type_definition() else result_type fi
            let list: MutableList[System.Reflection.MethodInfo] mut

            if !_constructor_intrinsics.try_get_value(key, list ref) then
                list = LIST[System.Reflection.MethodInfo]()

                _constructor_intrinsics.add(key, list)
            fi

            list.add(method)
        si

        constructor_intrinsics_for(type: TYPE) -> Iterable[System.Reflection.MethodInfo] is
            let result: MutableList[System.Reflection.MethodInfo] mut

            if _constructor_intrinsics.try_get_value(type, result ref) then
                return result
            fi

            return LIST[System.Reflection.MethodInfo]()
        si

        array_constructor_intrinsics: Iterable[System.Reflection.MethodInfo] => _array_constructor_intrinsics

        register_variant(union_full_name: string, variant_type: TYPE) is
            let list: MutableList[TYPE] mut

            if !_variants_by_union_full_name.try_get_value(union_full_name, list ref) then
                list = LIST[TYPE]()

                _variants_by_union_full_name.add(union_full_name, list)
            fi

            list.add(variant_type)
        si

        get_variants_for_union(union_full_name: string) -> Iterable[TYPE]? is
            let result: MutableList[TYPE] mut

            _variants_by_union_full_name.try_get_value(union_full_name, result ref)

            return result
        si

        find_all_root_namespaces() -> Iterable[string] is
            let result = SET()

            for ns in _type_details_by_ghul_namespace.keys do
                let parts = ns.split(['.'])

                result.add(parts[0])
            od

            return result
        si

        find_all_namespaces_under(prefix: string) -> Iterable[string] is
            let result = SET()

            let search_for = "{prefix}."
            let prefix_length = search_for.length

            for ns in _type_details_by_ghul_namespace.keys do
                if ns.starts_with(prefix) then
                    if ns.length > prefix_length then
                        let parts = ns.substring(prefix_length).split(['.'])

                        result.add(parts[0])
                    fi
                fi
            od

            return result
        si

        contains_type(type: TYPE) -> bool => _type_details_by_dotnet_type.contains_key(type)

        add_type(type_details: TYPE_DETAILS) is
            // assert type_details.is_complete else "incomplete type details: {type_details}";

            let dotnet_type = type_details.dotnet_type

            if _type_details_by_dotnet_type.contains_key(dotnet_type) then
                return
            fi

            _type_details_by_dotnet_type.add(dotnet_type, type_details)

            let ghul_namespace = type_details.ghul_namespace

            if type_details.is_globals_carrier then
                _namespaces_with_globals_carrier.add(ghul_namespace)
            fi

            let list: MutableList[TYPE_DETAILS] mut

            if !_type_details_by_ghul_namespace.try_get_value(ghul_namespace, list ref) then
                list = LIST[TYPE_DETAILS]()

                _type_details_by_ghul_namespace.add(ghul_namespace, list)
            fi

            let is_found mut = false
            for d in list do
                if d.dotnet_type == dotnet_type then
                    is_found = true
                    break
                fi
            od

            if !is_found then
                list.add(type_details)
            fi
        si

        get_type_details_by_dotnet_type(type: TYPE) -> TYPE_DETAILS? is
            let result: TYPE_DETAILS mut

            _type_details_by_dotnet_type.try_get_value(type, result ref)

            return result
        si

        get_all_type_details_in_ghul_namespace(namespace_name: string?) -> Iterable[TYPE_DETAILS]? is
            if !namespace_name? then
                return null
            fi

            let result: MutableList[TYPE_DETAILS] mut

            _type_details_by_ghul_namespace.try_get_value(namespace_name, result ref)

            return result
        si

        get_type_details_by_ghul_namespace_and_symbol_name(namespace_name: string, name: string) -> TYPE_DETAILS? is
            let search_list = get_all_type_details_in_ghul_namespace(namespace_name)

            if !search_list? then
                return null
            fi

            for details in search_list do
                if details.matches(namespace_name, name) then
                    return details
                fi
            od
            return null
        si

        // Returns every TYPE_DETAILS in the namespace whose ghul-visible
        // name matches. After the import side strips the `\`N` suffix,
        // multiple .NET types (e.g. `Lazy\`1` and `Lazy\`2`) can share a
        // ghul name; the lookup needs to surface them all so
        // `symbol_table.get_symbol` can assemble a TYPE_GROUP at
        // materialize-time.
        find_all_type_details_by_ghul_namespace_and_symbol_name(namespace_name: string, name: string) -> Collections.LIST[TYPE_DETAILS] is
            let result = Collections.LIST[TYPE_DETAILS]()
            let search_list = get_all_type_details_in_ghul_namespace(namespace_name)

            if !search_list? then
                return result
            fi

            for details in search_list do
                if details.matches(namespace_name, name) then
                    result.add(details)
                fi
            od

            return result
        si
    si
si
