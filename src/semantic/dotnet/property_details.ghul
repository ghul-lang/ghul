@@IF.dotnet()

namespace Semantic.DotNet is
    class PROPERTY_DETAILS(
        ghul_property: Symbols.Property,
        dotnet_get_method: System.Reflection.MethodInfo?,
        dotnet_set_method: System.Reflection.MethodInfo?
    ) is
        // A second property over the same accessors, declared where the
        // rename table keeps a member's old name beside its new one.
        alias_property: Symbols.Property? public

        // The properties the accessors are bound to.
        properties: Collections.LIST[Symbols.Property] is
            let result = Collections.LIST[Symbols.Property]()

            result.add(ghul_property)

            if let alias = alias_property then
                result.add(alias)
            fi

            return result
        si

        to_string() -> string => (
            let result mut = "property details "

            result = "{result}property: {ghul_property} {ghul_property.get_hash_code()}"

            if let self.dotnet_get_method? then
                result = "{result}get: {dotnet_get_method} {dotnet_get_method.get_hash_code()}"
            fi

            if let self.dotnet_set_method? then
                result = "{result}set: {dotnet_set_method} {dotnet_set_method.get_hash_code()}"
            fi

            result
        )
    si
si
