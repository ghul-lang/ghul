namespace Semantic.DotNet is
    // The operation name, such as "arithmetic.add", that a reflected
    // member's INTRINSIC_ATTRIBUTE carries.
    class INTRINSIC_OPERATION is
        of(attributes: Collections.Iterable[System.Reflection.CustomAttributeData]) -> string? static is
            try
                for attr in attributes do
                    if attr.attribute_type.full_name =~ "Ghul.Internal.INTRINSIC_ATTRIBUTE" then
                        for argument in attr.constructor_arguments do
                            return cast string?(argument.value)
                        od
                    fi
                od
            catch ex: System.Exception
            yrt

            return null
        si
    si
si
