namespace Semantic.DotNet is
    // Names a reflected type used to have, kept so that source written
    // against the old name still compiles. Each maps the old qualified
    // name to the type's own qualified name, which is the one it is
    // registered and printed under: the old name is a second spelling of
    // the one symbol rather than a second symbol.
    class TYPE_NAME_ALIASES is
        _new_name_by_old_name: Collections.MAP[string, string]

        init() is
            _new_name_by_old_name = Collections.MAP[string, string]()
        si

        add(old_name: string, new_name: string) is
            assert old_name !~ new_name else "a type name cannot be an alias of itself: {old_name}"
            assert !_new_name_by_old_name.contains_key(new_name) else "an alias cannot name another alias: {new_name}"
            assert !_new_name_by_old_name.contains_value(old_name) else "an alias cannot rename a type's own name: {old_name}"

            _new_name_by_old_name.add(old_name, new_name)
        si

        // The name a type is registered under, where `name` is an old
        // name for it, and otherwise null.
        renamed(name: string) -> string? is
            let result: string mut

            if _new_name_by_old_name.try_get_value(name, result ref) then
                return result
            fi

            return null
        si
    si
si
