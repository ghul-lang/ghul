namespace Semantic.DotNet is
    use TYPE = System.Type

    // Which scalar sources a scalar type needs a conversion constructor for:
    // every one it does not already have a public constructor from. decimal
    // and BigInteger bring their own from the wider numeric types, and those
    // stay rather than being shadowed by a second overload of the same shape.
    class SCALAR_CONVERSION_SOURCES is
        needing_constructor(target: TYPE, scalars: Collections.Iterable[TYPE]) -> Collections.List[TYPE] static is
            let result = Collections.LIST[TYPE]()

            for source in scalars do
                if !_has_constructor_from(target, source) then
                    result.add(source)
                fi
            od

            return result
        si

        _has_constructor_from(target: TYPE, source: TYPE) -> bool static is
            for constructor in target.get_constructors() do
                let parameters = constructor.get_parameters()

                if constructor.is_public /\ parameters.count == 1 /\ parameters[0].parameter_type == source then
                    return true
                fi
            od

            return false
        si
    si
si
