@@IF.dotnet()

namespace Semantic.DotNet is
    use Semantic.Types.Type

    // The type name a custom-attribute blob carries for a typeof
    // argument: the grammar Type.GetType parses when the attribute is
    // materialised at run time. Blobs are token-free, so this name is
    // how the reader finds the type - a dotted name with nesting joined
    // by '+', a generic instantiation as Name[[argument],[argument]]
    // with each argument assembly-qualified, an array as element[], and
    // ', Assembly' qualifying the whole. A type declared in the
    // assembly being built is left unqualified, which tells the reader
    // to look in the assembly the attribute came from.
    //
    // try_serialize answers null for a type the grammar cannot carry -
    // a type parameter, a pointer, a reference. The attribute resolver
    // consults the same answer to reject such an argument with a
    // diagnostic, so the encoder is never reached with one: whatever
    // this cannot spell is refused before it can become a blob no
    // reader could resolve.
    class REFLECTION_TYPE_NAME is
        try_serialize(type: Type) -> string? static is
            let body = _try_body(type)

            if !body? then
                return null
            fi

            let assembly_name = _assembly_of(type)

            if assembly_name? /\ assembly_name.length > 0 then
                return "{body}, {assembly_name}"
            fi

            return body
        si

        _try_body(type: Type) -> string? static is
            // An array's element carries the name; the brackets follow
            // it, inside any assembly qualifier for the whole.
            if let array: Semantic.Types.ARRAY = type then
                let element = _try_body(array.arguments[0])

                if !element? then
                    return null
                fi

                return "{element}[]"
            fi

            if let generic: Semantic.Symbols.GENERIC = type.symbol then
                return _try_generic_body(generic)
            fi

            if let classy: Semantic.Symbols.Classy = type.symbol then
                // An imported type keeps the name reflection reported
                // for it; a declared type gets the name it is emitted
                // under.
                return classy.dotnet_full_name ?? classy.il_qualified_name
            fi

            return null
        si

        _try_generic_body(generic: Semantic.Symbols.GENERIC) -> string? static is
            let open_symbol = generic.symbol
            let open_body = open_symbol.dotnet_full_name ?? open_symbol.il_qualified_name

            if generic.arguments.count == 0 then
                return open_body
            fi

            let result = Text.STRING_BUILDER()

            result
                .append(open_body)
                .append('[')

            let seen_any mut = false

            for argument in generic.arguments do
                // Each argument is a full assembly-qualified name of
                // its own, bracketed so its commas cannot be read as
                // the enclosing list's.
                let serialized = try_serialize(argument)

                if !serialized? then
                    return null
                fi

                if seen_any then
                    result.append(',')
                fi

                result
                    .append('[')
                    .append(serialized)
                    .append(']')

                seen_any = true
            od

            result.append(']')

            return result.to_string()
        si

        _assembly_of(type: Type) -> string? static is
            if let array: Semantic.Types.ARRAY = type then
                return _assembly_of(array.arguments[0])
            fi

            if let generic: Semantic.Symbols.GENERIC = type.symbol then
                return generic.symbol.il_assembly_name
            fi

            return cast Semantic.Symbols.Classy?(type.symbol)?.il_assembly_name
        si
    si
si
