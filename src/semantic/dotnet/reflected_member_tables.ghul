@@IF.dotnet()

namespace Semantic.DotNet is
    use Collections.MAP
    use Ghul.Pipes

    // The ghūl name a reflected member is surfaced under instead of its
    // de-camelled one, and whether the de-camelled name stays reachable
    // as a second name.
    class REFLECTED_MEMBER_RENAME(name: string public, keeps_old_name: bool public)

    // Three compiler tables over reflected members, keyed on the declaring
    // type's metadata name (a generic type by its definition, as
    // `System.Collections.Generic.List`1`) and the member's metadata name.
    // A key names every overload of the member at once, so a rename or a
    // deprecation applies to the whole group, never to one overload.
    //
    // - renames: a member reached under a better ghūl name, the old one
    //   optionally kept beside it while callers move;
    // - deprecations: a member that warns `[deprecated]` at each use,
    //   naming what to write instead;
    // - hides: a member that is not imported at all where a member the
    //   runtime adds to the same type under the replacement name is
    //   present, so the two never share a name. Where the replacement is
    //   absent the member is imported as usual.
    //
    // A fourth table, keyed on the type alone, names the types whose
    // binary arithmetic operators are imported only where both operands
    // are the type itself, as the language's own arithmetic is. .NET gives
    // Complex `+`, `-`, `*` and `/` overloads that take a double on either
    // side; with them in the candidate set an operand whose type is still
    // being inferred has several operators to match instead of one.
    class REFLECTED_MEMBER_TABLES is
        _renames: MAP[(string, string), REFLECTED_MEMBER_RENAME] static
        _deprecations: MAP[(string, string), string] static
        _hides: MAP[(string, string), string] static
        _same_type_arithmetic: Collections.SET[string] static
        _arithmetic_operators: Collections.SET[string] static

        init() static is
            _renames = MAP[(string, string), REFLECTED_MEMBER_RENAME]()

            _renames[("System.Double", "IsNaN")] = REFLECTED_MEMBER_RENAME("is_nan", true)
            _renames[("System.Single", "IsNaN")] = REFLECTED_MEMBER_RENAME("is_nan", true)
            _renames[("System.String", "Length")] = REFLECTED_MEMBER_RENAME("count", true)

            // The locale names: .NET's "culture" is a locale here, and the word
            // goes from member names wherever the rest still says what it is.
            let locale_info = "System.Globalization.CultureInfo"

            _renames[(locale_info, "InvariantCulture")] = REFLECTED_MEMBER_RENAME("invariant", true)
            _renames[(locale_info, "CurrentCulture")] = REFLECTED_MEMBER_RENAME("current", true)
            _renames[(locale_info, "CurrentUICulture")] = REFLECTED_MEMBER_RENAME("current_ui", true)
            _renames[(locale_info, "InstalledUICulture")] = REFLECTED_MEMBER_RENAME("installed_ui", true)
            _renames[(locale_info, "DefaultThreadCurrentCulture")] = REFLECTED_MEMBER_RENAME("default_thread_current", true)
            _renames[(locale_info, "DefaultThreadCurrentUICulture")] = REFLECTED_MEMBER_RENAME("default_thread_current_ui", true)
            _renames[(locale_info, "CreateSpecificCulture")] = REFLECTED_MEMBER_RENAME("create_specific", true)
            _renames[(locale_info, "GetCultureInfo")] = REFLECTED_MEMBER_RENAME("get", true)
            _renames[(locale_info, "GetCultureInfoByIetfLanguageTag")] = REFLECTED_MEMBER_RENAME("get_by_ietf_language_tag", true)
            _renames[(locale_info, "GetCultures")] = REFLECTED_MEMBER_RENAME("get_locales", true)
            _renames[(locale_info, "GetConsoleFallbackUICulture")] = REFLECTED_MEMBER_RENAME("get_console_fallback_ui", true)
            _renames[(locale_info, "IsNeutralCulture")] = REFLECTED_MEMBER_RENAME("is_neutral", true)
            _renames[(locale_info, "CultureTypes")] = REFLECTED_MEMBER_RENAME("locale_types", true)

            _renames[("System.Globalization.CultureNotFoundException", "InvalidCultureId")] = REFLECTED_MEMBER_RENAME("invalid_id", true)
            _renames[("System.Globalization.CultureNotFoundException", "InvalidCultureName")] = REFLECTED_MEMBER_RENAME("invalid_name", true)
            _renames[("System.Globalization.TextInfo", "CultureName")] = REFLECTED_MEMBER_RENAME("locale_name", true)
            _renames[("System.Reflection.AssemblyName", "CultureInfo")] = REFLECTED_MEMBER_RENAME("locale", true)
            _renames[("System.Reflection.AssemblyName", "CultureName")] = REFLECTED_MEMBER_RENAME("locale_name", true)
            _renames[("System.Reflection.AssemblyCultureAttribute", "Culture")] = REFLECTED_MEMBER_RENAME("locale", true)
            _renames[("System.Resources.MissingSatelliteAssemblyException", "CultureName")] = REFLECTED_MEMBER_RENAME("locale_name", true)
            _renames[("System.Resources.NeutralResourcesLanguageAttribute", "CultureName")] = REFLECTED_MEMBER_RENAME("locale_name", true)
            _renames[("System.Text.RegularExpressions.GeneratedRegexAttribute", "CultureName")] = REFLECTED_MEMBER_RENAME("locale_name", true)
            _renames[("System.ApplicationId", "Culture")] = REFLECTED_MEMBER_RENAME("locale", true)
            _renames[("System.FormattableString", "CurrentCulture")] = REFLECTED_MEMBER_RENAME("current", true)
            _renames[("System.StringComparer", "InvariantCulture")] = REFLECTED_MEMBER_RENAME("invariant", true)
            _renames[("System.StringComparer", "InvariantCultureIgnoreCase")] = REFLECTED_MEMBER_RENAME("invariant_ignore_case", true)
            _renames[("System.StringComparer", "CurrentCulture")] = REFLECTED_MEMBER_RENAME("current", true)
            _renames[("System.StringComparer", "CurrentCultureIgnoreCase")] = REFLECTED_MEMBER_RENAME("current_ignore_case", true)
            _renames[("System.StringComparer", "IsWellKnownCultureAwareComparer")] = REFLECTED_MEMBER_RENAME("is_well_known_locale_aware_comparer", true)
            _renames[("System.Threading.Thread", "CurrentCulture")] = REFLECTED_MEMBER_RENAME("current", true)
            _renames[("System.Threading.Thread", "CurrentUICulture")] = REFLECTED_MEMBER_RENAME("current_ui", true)

            // Enum members take their whole ghūl name from the table, and have
            // no second name.
            _renames[("System.StringComparison", "CurrentCulture")] = REFLECTED_MEMBER_RENAME("CURRENT_LOCALE", false)
            _renames[("System.StringComparison", "CurrentCultureIgnoreCase")] = REFLECTED_MEMBER_RENAME("CURRENT_LOCALE_IGNORE_CASE", false)
            _renames[("System.StringComparison", "InvariantCulture")] = REFLECTED_MEMBER_RENAME("INVARIANT_LOCALE", false)
            _renames[("System.StringComparison", "InvariantCultureIgnoreCase")] = REFLECTED_MEMBER_RENAME("INVARIANT_LOCALE_IGNORE_CASE", false)
            _renames[("System.Text.RegularExpressions.RegexOptions", "CultureInvariant")] = REFLECTED_MEMBER_RENAME("LOCALE_INVARIANT", false)
            _renames[("System.Diagnostics.Tracing.EventManifestOptions", "AllCultures")] = REFLECTED_MEMBER_RENAME("ALL_LOCALES", false)

            let locale_types = "System.Globalization.CultureTypes"

            _renames[(locale_types, "AllCultures")] = REFLECTED_MEMBER_RENAME("ALL_LOCALES", false)
            _renames[(locale_types, "FrameworkCultures")] = REFLECTED_MEMBER_RENAME("FRAMEWORK_LOCALES", false)
            _renames[(locale_types, "InstalledWin32Cultures")] = REFLECTED_MEMBER_RENAME("INSTALLED_WIN32_LOCALES", false)
            _renames[(locale_types, "NeutralCultures")] = REFLECTED_MEMBER_RENAME("NEUTRAL_LOCALES", false)
            _renames[(locale_types, "ReplacementCultures")] = REFLECTED_MEMBER_RENAME("REPLACEMENT_LOCALES", false)
            _renames[(locale_types, "SpecificCultures")] = REFLECTED_MEMBER_RENAME("SPECIFIC_LOCALES", false)
            _renames[(locale_types, "UserCustomCulture")] = REFLECTED_MEMBER_RENAME("USER_CUSTOM_LOCALE", false)
            _renames[(locale_types, "WindowsOnlyCultures")] = REFLECTED_MEMBER_RENAME("WINDOWS_ONLY_LOCALES", false)
            _renames[("System.Text.Encoding", "Unicode")] = REFLECTED_MEMBER_RENAME("utf16", false)

            _deprecations = MAP[(string, string), string]()

            let list = "System.Collections.Generic.List`1"

            _deprecations[(list, "Find")] = "use '|>' find, which returns an optional rather than a default value on a miss"
            _deprecations[(list, "Exists")] = "use '|>' any"
            _deprecations[(list, "TrueForAll")] = "use '|>' all"
            _deprecations[(list, "ForEach")] = "use '|>' each"
            _deprecations[(list, "ConvertAll")] = "use '|>' map"

            _hides = MAP[(string, string), string]()

            for (member, replacement) in [
                ("IsAscii", "is_ascii"),
                ("IsAsciiDigit", "is_ascii_digit"),
                ("IsAsciiHexDigit", "is_ascii_hex_digit"),
                ("IsAsciiHexDigitLower", "is_ascii_hex_digit_lower"),
                ("IsAsciiHexDigitUpper", "is_ascii_hex_digit_upper"),
                ("IsAsciiLetter", "is_ascii_letter"),
                ("IsAsciiLetterLower", "is_ascii_letter_lower"),
                ("IsAsciiLetterOrDigit", "is_ascii_letter_or_digit"),
                ("IsAsciiLetterUpper", "is_ascii_letter_upper"),
                ("IsControl", "is_control"),
                ("IsDigit", "is_digit"),
                ("IsHighSurrogate", "is_high_surrogate"),
                ("IsLetter", "is_letter"),
                ("IsLetterOrDigit", "is_letter_or_digit"),
                ("IsLower", "is_lower"),
                ("IsLowSurrogate", "is_low_surrogate"),
                ("IsNumber", "is_number"),
                ("IsPunctuation", "is_punctuation"),
                ("IsSeparator", "is_separator"),
                ("IsSurrogate", "is_surrogate"),
                ("IsSymbol", "is_symbol"),
                ("IsUpper", "is_upper"),
                ("IsWhiteSpace", "is_white_space"),
                ("ToLower", "to_lower"),
                ("ToUpper", "to_upper")
            ] do
                _hides[("System.Char", member)] = replacement
            od

            _same_type_arithmetic = Collections.SET[string](["System.Numerics.Complex"])
            _arithmetic_operators = Collections.SET[string](["op_Addition", "op_Subtraction", "op_Multiply", "op_Division"])
        si

        // Whether `method` is a binary arithmetic operator of a type whose
        // arithmetic takes only that type, with an operand of some other
        // type, so is not imported.
        //
        // - method: the reflected method
        is_mixed_operand_arithmetic(method: System.Reflection.MethodInfo) -> bool static is
            if !method.is_static \/ !_arithmetic_operators.contains(method.name) then
                return false
            fi

            let declaring_type = method.declaring_type

            if !declaring_type? \/ !declaring_type.full_name? \/ !_same_type_arithmetic.contains(declaring_type.full_name) then
                return false
            fi

            return method.get_parameters() |> any(p => p.parameter_type != declaring_type)
        si

        // Whether `method` is the binary arithmetic operator of such a type
        // whose signature is exactly (T, T) -> T, which a widened operand
        // may reach, as an operator the core library declares
        // @widen_operands() may be. Each overload is judged by its own
        // parameter and return types, so a mixed one is never marked.
        //
        // - method: the reflected method
        is_widened_operand_arithmetic(method: System.Reflection.MethodInfo) -> bool static is
            if !method.is_static \/ !_arithmetic_operators.contains(method.name) then
                return false
            fi

            let declaring_type = method.declaring_type

            if !declaring_type? \/ !declaring_type.full_name? \/ !_same_type_arithmetic.contains(declaring_type.full_name) then
                return false
            fi

            let parameters = method.get_parameters()

            return
                method.return_type == declaring_type /\
                parameters.count == 2 /\
                parameters[0].parameter_type == declaring_type /\
                parameters[1].parameter_type == declaring_type
        si

        // The rename for a member, or null where it keeps its de-camelled
        // name.
        //
        // - declaring_type: the type that declares the member
        // - member_name: the member's metadata name
        rename_for(declaring_type: Ghul.Type?, member_name: string) -> REFLECTED_MEMBER_RENAME? static is
            if let key = _key(declaring_type, member_name) then
                let found: REFLECTED_MEMBER_RENAME mut = _

                if _renames.try_get_value(key, found ref) then
                    return found
                fi
            fi

            return null
        si

        // The deprecation the table gives a member, or null where it gives
        // none.
        //
        // - declaring_type: the type that declares the member
        // - member_name: the member's metadata name
        deprecation_for(declaring_type: Ghul.Type?, member_name: string) -> Semantic.DEPRECATION? static is
            if let key = _key(declaring_type, member_name) then
                let found: string mut = _

                if _deprecations.try_get_value(key, found ref) then
                    return Semantic.DEPRECATION(found, false)
                fi
            fi

            return null
        si

        // The name of the member that replaces this one where the runtime
        // adds it, or null where the table hides nothing.
        //
        // - declaring_type: the type that declares the member
        // - member_name: the member's metadata name
        replacement_for(declaring_type: Ghul.Type?, member_name: string) -> string? static is
            if let key = _key(declaring_type, member_name) then
                let found: string mut = _

                if _hides.try_get_value(key, found ref) then
                    return found
                fi
            fi

            return null
        si

        // Every hide entry, as the declaring type's metadata name, the
        // member's metadata name and its replacement's name.
        hides: Collections.Iterable[(type_name: string, member_name: string, replacement: string)] static =>
            _hides |> map(e => (type_name = e.key.`0, member_name = e.key.`1, replacement = e.value))

        _key(declaring_type: Ghul.Type?, member_name: string) -> (string, string)? static is
            if !declaring_type? then
                return null
            fi

            let definition =
                if declaring_type.is_generic_type /\ !declaring_type.is_generic_type_definition then
                    declaring_type.get_generic_type_definition()
                else
                    declaring_type
                fi

            if let name = definition.full_name then
                return (name, member_name)
            fi

            return null
        si
    si
si
