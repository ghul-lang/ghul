namespace Semantic is
    use Types.Type

    // Where an expression whose result type is still a placeholder is
    // passed to a formal that is settled, the formal is what that result
    // has to be: an empty list literal handed to a `string[]` parameter
    // holds strings. The formal and the actual are walked in step, and
    // each result placeholder found in the actual is given the settled
    // type in the formal's matching position as a lower bound. Nothing
    // else is bounded: a local's placeholder takes its type from its own
    // initializer and assignments, not from a call it is passed to.
    class RESULT_ORIGIN_OFFER is
        offer(formal: Type?, actual: Type?) static is
            if !formal? \/ !actual? then
                return
            fi

            if let placeholder: Types.INFERRED_VARIABLE_TYPE = actual then
                if isa Symbols.INFERRED_RESULT_ORIGIN(placeholder.origin) /\ formal.is_settled then
                    INFERENCE_TRACE.add_lower_bound("result_origin.formal", placeholder.origin, formal)
                fi

                return
            fi

            if !actual.contains_inferred then
                return
            fi

            if let actual_generic: Types.GENERIC = actual then
                if let formal_generic: Types.GENERIC = formal then
                    if
                        formal_generic.symbol.root_unspecialized_symbol == actual_generic.symbol.root_unspecialized_symbol /\
                        formal_generic.arguments.count == actual_generic.arguments.count
                    then
                        for i in 0..actual_generic.arguments.count do
                            offer(formal_generic.arguments[i], actual_generic.arguments[i])
                        od
                    elif let ancestor = _ancestor_built_on(actual_generic, formal_generic.symbol.root_unspecialized_symbol) then
                        // An array literal handed to a `T[]` or `T{}`
                        // formal: the array's own ancestors carry the
                        // placeholder in the position the formal names.
                        offer(formal_generic, ancestor)
                    fi
                fi
            fi
        si

        _ancestor_built_on(actual: Types.GENERIC, root: Symbols.Symbol?) -> Type? static is
            if !root? then
                return null
            fi

            for i in 0..actual.ancestors.count do
                let ancestor = actual.symbol.get_ancestor(i)

                if let generic: Types.GENERIC = ancestor /\ generic.symbol.root_unspecialized_symbol == root then
                    return ancestor
                fi
            od

            return null
        si
    si
si
