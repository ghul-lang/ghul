namespace Semantic is
    /// Who owns a string a foreign function answers with.
    enum ExternResult is
        /// The function answers a type that is not a string, or a string
        /// the declaration did not take.
        NONE,

        /// The text is copied into a string and the function keeps it.
        COPY,

        /// The text is copied into a string and then released, with the C
        /// library's `free` or the function the declaration names.
        TAKE
    si

    /// What an `@extern` says: the library to call into, the name to look
    /// up in it, who owns a string it answers with, the function that
    /// releases a string it hands over, what counts as failure, after which
    /// the C library's errno is answered, and, for a variadic function, how
    /// many parameters are fixed (-1 for one that is not variadic).
    class EXTERN_IMPORT(
        module: string public,
        name: string public,
        result: ExternResult public,
        deallocator: string? public,
        failure: EXTERN_FAILURE? public,
        fixed_parameters: int public
    ) is
        /// What the foreign function itself answers, where `failure` wraps it
        /// with the errno: the T of Result[T, int].
        answered: Types.Type? public

        /// The constructors of Result[T, int]'s OK and ERROR variants.
        ok_constructor: Symbols.Function? public
        error_constructor: Symbols.Function? public

        /// Whether the foreign function is variadic, called with its
        /// parameters from `fixed_parameters` on as C passes variadic
        /// arguments.
        is_variadic: bool => fixed_parameters >= 0
    si
si

namespace Semantic is
    /// How a foreign function declared with `errno =` signals failure.
    enum ExternFailureKind is
        /// The function failed when it answered `value`.
        EQUALS,

        /// The function failed when it answered a negative number.
        NEGATIVE,

        /// The function failed when it set errno: errno is zeroed before the
        /// call and read after it.
        SET
    si

    /// What an `@extern`'s `errno =` says counts as failure.
    class EXTERN_FAILURE(
        kind: ExternFailureKind public,
        value: long public
    ) is si
si
