namespace Semantic is
    use Types.Type

    use Collections.LIST
    use Collections.MAP

    // The element type a generator settles on when its yields decide it:
    // the join of the types they produce, as a function's return type is
    // the join of its returns.
    //
    // The first yield of a walk of the generator's body settles the
    // element type at what it yields, so the rest of the body reads a
    // type from there on, and starts that walk's record. A later yield
    // the element type does not accept widens it to the join of every
    // yield the walk has recorded. A generator's body is walked again on
    // each walk of the body around it, and each walk starts its record
    // afresh at its first yield, so a yield from an earlier walk never
    // reaches a later walk's join.
    class GENERATOR_YIELD_JOIN is
        _yields: MAP[Symbols.Symbol, LIST[Type]]

        init() is
            super.init()

            _yields = MAP[Symbols.Symbol, LIST[Type]]()
        si

        // Starts a walk's record for `generator` at its first yield,
        // which settles the element type at `yielded`.
        first(generator: Symbols.Symbol, yielded: Type) is
            _yields[generator] = LIST[Type]([yielded])
        si

        // Records a later yield on this walk of `generator`, and answers
        // the element type it widens `element` to: the join of every
        // yield the walk has recorded, or null when `element` already
        // accepts `yielded`, when the walk has no first yield on record,
        // or when the yields have no join.
        widened(generator: Symbols.Symbol, element: Type, yielded: Type) -> Type? is
            let yields: LIST[Type] mut

            if !_yields.try_get_value(generator, yields ref) then
                return null
            fi

            yields.add(yielded)

            if element.is_assignable_from(yielded) then
                return null
            fi

            let lub = LEAST_UPPER_BOUND_MAP()

            for t in yields do
                lub.add(t)
            od

            return lub.get_result()
        si
    si
si
