namespace Semantic is
    use Source.LOCATION

    use Collections.LIST
    use Collections.MAP

    // One origin per expression whose result type the body's walks have
    // to settle, kept for as long as that body is being compiled. The
    // walks of a body revisit the same expression, and the bounds each
    // walk records have to land on the same origin for the next walk to
    // read them, so an expression is its own key. A body compiled during
    // another's walk has an origin table of its own.
    class RESULT_ORIGINS is
        _bodies: LIST[MAP[object, Symbols.INFERRED_RESULT_ORIGIN]] static

        init() static is
            _bodies = LIST[MAP[object, Symbols.INFERRED_RESULT_ORIGIN]]()
        si

        begin_body() static is
            _bodies.add(MAP[object, Symbols.INFERRED_RESULT_ORIGIN]())
        si

        end_body() static is
            if _bodies.count > 0 then
                _bodies.remove_at(_bodies.count - 1)
            fi
        si

        // The origin standing for `node`'s result in the body being
        // compiled, made on first request. Outside any body there are no
        // walks to settle an origin, so there is none to give.
        origin_for(node: object, location: LOCATION, owner: Scope, name: string) -> Symbols.INFERRED_RESULT_ORIGIN? static is
            if _bodies.count == 0 then
                return null
            fi

            let origins = _bodies[_bodies.count - 1]

            if origins.contains_key(node) then
                return origins[node]
            fi

            let result = Symbols.INFERRED_RESULT_ORIGIN(location, owner, name)

            origins[node] = result

            return result
        si
    si
si
