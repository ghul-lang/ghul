namespace Semantic is
    use Ghul.Pipes

    // When a non-generic overload may win a call it ties on with a
    // specialized generic one. It may only when it is at least as
    // specific: each of its formals converts to the generic's formal in
    // the same position. A legacy overload taking a catch-all type
    // (`object`, `object[]`) is less specific than the generic, so it
    // doesn't capture a call the generic serves more precisely.
    class NON_GENERIC_PREFERENCE is
        // Whether some specialized generic among `candidates` takes a
        // formal that `candidate`'s formal in the same position doesn't
        // convert to.
        is_less_specific_than_a_generic(
            candidate: Symbols.Function,
            candidates: Symbols.Function[]
        ) -> bool static =>
            candidates |> any(g => g.specialized_from? /\ !converts_to(candidate, g))

        // Whether each of `from`'s formals converts to `to`'s formal in
        // the same position.
        converts_to(from: Symbols.Function, to: Symbols.Function) -> bool static is
            if from.arguments.count != to.arguments.count then
                return false
            fi

            for i in 0..from.arguments.count do
                let match = to.arguments[i].compare(from.arguments[i])

                if match != Types.MATCH.SAME /\ match != Types.MATCH.ASSIGNABLE then
                    return false
                fi
            od

            return true
        si
    si
si
