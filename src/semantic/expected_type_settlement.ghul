namespace Semantic is
    use Types.Type

    // Whether an expected type is settled enough to type a construct by.
    // One still holding a placeholder, such as `(T, int)?` from the slot
    // of a call still inferring T, names the shape the construct has to
    // fit but not the type it is: typing the construct by it would commit
    // the placeholder, and the call could no longer learn T from the
    // construct. Such a construct is typed from its own parts instead, as
    // with no expected type, and the walk after the call has bound T
    // types it by the then settled expected type.
    class EXPECTED_TYPE_SETTLEMENT is
        // Whether a construct joining arms, such as an `if`, has to join
        // them itself: there is no expected type, or the expected type
        // still holds a placeholder.
        //
        // - expected: the expected type, or null where there is none
        joins_own_arms(expected: Type?) -> bool static =>
            !expected? \/ !expected.is_settled

        // Whether a `null` takes the expected type as the empty value of
        // a value-type optional, rather than staying a null that the join
        // around it or the literal's return settles.
        //
        // - expected: the expected type, or null where there is none
        null_is_empty_value_optional(expected: Type?) -> bool static =>
            expected? /\ expected.is_value_type /\ expected.is_optional /\ expected.is_settled
    si
si
