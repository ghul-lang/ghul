namespace Semantic is
    use Types.Type

    class SEQUENCE_ARGUMENT_FORMAL is
        // The type an array literal argument is to be built at in place of
        // the one its elements gave it, or null where it needs no other.
        // That is the formal it fills, when the literal as built does not
        // convert to the formal but each of its elements converts to the
        // formal's element type: `[("+", APP())]` is a (string, APP)[],
        // which is not an Iterable[(string, Op[string])] because a tuple
        // is a value type, but built at that formal each tuple converts
        // as a tuple value does anywhere else.
        //
        // - formal: the formal the literal fills, once the call's type
        //   arguments are bound
        // - actual: the type the literal was built at
        // - lookup: finds the sequence trait whose element each is compared
        //   by; without one, each is compared by its element type
        build_at(formal: Type?, actual: Type?, lookup: Lookups.InnateSymbolLookup?) -> Type? static is
            if !formal? \/ !actual? then
                return null
            fi

            if !formal.is_settled \/ formal.is_wild \/ formal.contains_function_generic_argument then
                return null
            fi

            if !actual.is_settled \/ actual.is_wild then
                return null
            fi

            if formal.is_assignable_from(actual) then
                return null
            fi

            let formal_element = SEQUENCE_ELEMENT.of(formal, lookup)
            let actual_element = SEQUENCE_ELEMENT.of(actual, lookup)

            if !formal_element? \/ !actual_element? then
                return null
            fi

            if !formal_element.is_assignable_from(actual_element) then
                return null
            fi

            return formal
        si
    si
si
