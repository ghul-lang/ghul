namespace Semantic is
    use Ghul.Pipes

    use Types.Type

    // When a tie between candidates is worth breaking by comparing
    // their formals with each other rather than with the actuals.
    class CANDIDATE_SPECIFICITY is
        // An ambiguity whose cause is an actual with no type yet - a
        // bare `_`, an untargeted `cast(..)`, an inference placeholder
        // - is not one specificity can settle: every candidate matched
        // that position vacuously, and choosing between them would
        // answer a question the call has not asked yet.
        @suppress("presence-test-non-optional")
        can_rank(arguments: Type[]) -> bool static =>
            !(arguments |>
                any(a => !a? \/ a.is_sentinel \/ a.is_error \/ a.contains_inferred))

        // Whether an actual is a placeholder for a value whose type is
        // settled by its other uses, not by the call it is passed to: a
        // type argument a construction left open, say, rather than the
        // parameter of a function literal, which the call types.
        has_actual_settled_elsewhere(arguments: Type[]) -> bool static =>
            arguments |>
                any(a =>
                    if let placeholder: Types.INFERRED_VARIABLE_TYPE = a then
                        !placeholder.is_settled /\ !OPERAND_WAIT.is_typed_by_the_call_site(placeholder)
                    else
                        false
                    fi)
    si
si
