namespace Semantic is
    use Ghul.Pipes

    use Types.Type

    // Tie-break on how exactly a candidate's formals fit the actuals.
    //
    // The resolver scores a formal carrying a free type variable as an
    // exact match before it knows what the variable will bind to, so
    // two candidates whose specialized formals fit the actuals quite
    // differently can reach the same score - `f[T](value: T)` and
    // `f[T](value: T?)` both score exact against an `int`, although
    // only the first is an exact fit once T is bound. Re-comparing the
    // specialized formals recovers the distinction the pre-binding
    // score threw away.
    //
    // Runs before CANDIDATE_SPECIFICITY, which ranks by depth in the
    // inheritance graph and so cannot separate two formals that are
    // the same type differently wrapped.
    class FORMAL_FIT_FILTER is
        // The candidates whose formals fit the actuals most closely,
        // or null when every candidate fits equally well - in which
        // case the caller carries on with the ambiguity it had.
        @suppress("presence-test-non-optional")
        pick(
            candidates: Collections.List[Symbols.Function],
            arguments: Collections.List[Type]
        ) -> Collections.List[Symbols.Function]? static is
            if candidates.count < 2 then
                return null
            fi

            if arguments |> any(a => !a? \/ a.is_sentinel \/ a.is_error \/ a.contains_inferred) then
                return null
            fi

            let best mut = -1
            let result = Collections.LIST[Symbols.Function]()

            for candidate in candidates do
                let candidate_fit = fit(candidate, arguments)

                if candidate_fit < 0 then
                    return null
                fi

                if best < 0 \/ candidate_fit < best then
                    best = candidate_fit
                    result.clear()
                fi

                if candidate_fit == best then
                    result.add(candidate)
                fi
            od

            if result.count == candidates.count then
                return null
            fi

            return result
        si

        // Whether some function-typed formal of the candidate cannot accept
        // its function-typed actual: function-type assignability, as the
        // type checker applies it, over the parts of the two that are
        // already settled. A candidate the resolver scored exact before its
        // type arguments were bound can turn out not to fit once they are,
        // as `f[T](g: T -> double)` does for a `g` known to return `int`,
        // and such a candidate is not a match. A part still carrying a type
        // variable or an unsettled inference decides nothing.
        rejects(candidate: Symbols.Function, arguments: Collections.List[Type]) -> bool static is
            if candidate.arguments.count != arguments.count then
                return false
            fi

            for i in 0..arguments.count do
                if _function_rejects(candidate.arguments[i], arguments[i]) then
                    return true
                fi
            od

            return false
        si

        @suppress("presence-test-non-optional")
        _function_rejects(formal: Type?, actual: Type?) -> bool static is
            if
                !formal? \/ !actual? \/
                !formal.is_function \/ !actual.is_function \/
                formal.is_action != actual.is_action \/
                formal.arguments.count != actual.arguments.count
            then
                return false
            fi

            // A `void` function type carries its parameters alone; any other
            // carries its result last.
            let last = if formal.is_action then formal.arguments.count else formal.arguments.count - 1 fi

            for i in 0..formal.arguments.count do
                let f = formal.arguments[i]
                let a = actual.arguments[i]

                if _function_rejects(f, a) then
                    return true
                fi

                if !_is_settled(f) \/ !_is_settled(a) then
                    continue
                fi

                if i < last then
                    // A parameter: the argument the formal passes must be
                    // one the actual takes.
                    if a.compare(f) == Types.MATCH.DIFFERENT then
                        return true
                    fi
                elif !_result_can_settle(f, a) /\ f.compare(a) == Types.MATCH.DIFFERENT then
                    return true
                fi
            od

            return false
        si

        // A function literal is typed again against the formal it is passed
        // to once the overload is chosen, and its result then settles as a
        // `void` the formal returns, or as the optional carrier the formal
        // returns, whatever the literal's own result was typed as before.
        _result_can_settle(formal: Type, actual: Type) -> bool static =>
            formal.is_void \/
            formal.is_optional \/ actual.is_optional \/
            isa Types.MAYBE(formal) \/ isa Types.MAYBE(actual)

        @suppress("presence-test-non-optional")
        _is_settled(type: Type?) -> bool static =>
            type? /\ !type.is_wild /\ !type.is_error /\ !type.is_sentinel /\ !type.contains_inferred

        // Summed match quality over the formals, lower being closer.
        // Negative when the candidate cannot be scored this way - a
        // formal still carrying a free type variable compares wild,
        // which says nothing about fit.
        @suppress("presence-test-non-optional")
        fit(candidate: Symbols.Function, arguments: Collections.List[Type]) -> int static is
            if candidate.arguments.count != arguments.count then
                return -1
            fi

            let total mut = 0

            for i in 0..arguments.count do
                let formal = candidate.arguments[i]

                if !formal? \/ formal.is_wild then
                    return -1
                fi

                let match = formal.compare(arguments[i])

                if match == Types.MATCH.WILD \/ match == Types.MATCH.DIFFERENT then
                    return -1
                fi

                total = total + cast int(match)
            od

            return total
        si
    si
si
