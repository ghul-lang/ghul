namespace Semantic is
    use Types.Type

    // The conversions a library declares as widenings: one-parameter static
    // functions marked @widening(), held by `Ghul.Internal.WIDENINGS`. A
    // widening is identified by its mark and by its parameter and return
    // types, never by its own name; an unmarked function in the holder is
    // not one. Read afresh each time: it is consulted only where an
    // operator has already failed to resolve.
    class OPERAND_WIDENINGS is
        _holder_for_testing: Symbols.Symbol?
        _has_holder_for_testing: bool

        init() is si

        // Tests only: reads its widenings from `holder` rather than from
        // the compilation.
        init(holder: Symbols.Symbol) is
            _holder_for_testing = holder
            _has_holder_for_testing = true
        si

        // The one candidate that reaches its operator with the fewest
        // widenings and whose result is narrower than every other such
        // candidate's, or null when there is none or no single one.
        choose(candidates: Collections.LIST[WIDENED_OPERATOR]) -> WIDENED_OPERATOR? is
            let fewest mut = -1

            for c in candidates do
                if fewest < 0 \/ c.widening_count < fewest then
                    fewest = c.widening_count
                fi
            od

            let least = Collections.LIST[WIDENED_OPERATOR]()

            for c in candidates do
                if c.widening_count == fewest then
                    least.add(c)
                fi
            od

            let chosen: WIDENED_OPERATOR? mut = null

            for c in least do
                let narrowest mut = true

                for other in least do
                    if other.function != c.function /\ !widens(c.function.return_type!, other.function.return_type!) then
                        narrowest = false
                    fi
                od

                if narrowest then
                    if chosen? /\ chosen.function != c.function then
                        return null
                    fi

                    if !chosen? then
                        chosen = c
                    fi
                fi
            od

            return chosen
        si

        // The widenings whose parameter is exactly `from`.
        from(from: Type) -> Collections.LIST[Symbols.Function] is
            let result = Collections.LIST[Symbols.Function]()

            for w in _all() do
                if w.arguments[0].matches(from) then
                    result.add(w)
                fi
            od

            return result
        si

        // Whether a widening from `from` to `to` is declared, which is what
        // makes `from` the narrower of the two.
        widens(from: Type, to: Type) -> bool is
            for w in _all() do
                if w.arguments[0].matches(from) /\ w.return_type!.matches(to) then
                    return true
                fi
            od

            return false
        si

        // The marked widened form of `operator`, the static operator
        // `name` that widening reached over operands of `left` and `right`,
        // where `left_widened` and `right_widened` say which operand was
        // widened to reach it. A form is a static operator of the same name
        // in the holder, marked @widened_form(), with the operator's result
        // type. An operand that was not widened keeps the operator's
        // parameter type; one that was takes a parameter its own type is,
        // or widens to through a marked widening. The form taking the
        // fewest such further widenings is the one, and none where two tie.
        widened_form(
            name: string,
            operator: Symbols.Function,
            left: Type,
            left_widened: bool,
            right: Type,
            right_widened: bool
        ) -> Symbols.Function? is
            if operator.is_instance \/ operator.arguments.count != 2 \/ !operator.return_type? then
                return null
            fi

            let forms = Collections.LIST[Symbols.Function]()

            for holder in _holders() do
                if let group: Symbols.FUNCTION_GROUP = holder.find_member(name) then
                    for f in group.functions do
                        forms.add(f)
                    od
                fi
            od

            let best: Symbols.Function? mut = null
            let best_cost mut = 0
            let tied mut = false

            for f in forms do
                if !f.is_widened_form \/ f.is_instance \/ f.arguments.count != 2 \/ !f.return_type? \/ !f.return_type.matches(operator.return_type!) then
                    continue
                fi

                let left_cost = _form_parameter_cost(f.arguments[0], operator.arguments[0], left, left_widened)
                let right_cost = _form_parameter_cost(f.arguments[1], operator.arguments[1], right, right_widened)

                if left_cost < 0 \/ right_cost < 0 then
                    continue
                fi

                let cost = left_cost + right_cost

                if !best? \/ cost < best_cost then
                    best = f
                    best_cost = cost
                    tied = false
                elif cost == best_cost then
                    tied = true
                fi
            od

            if tied then
                return null
            fi

            return best
        si

        // What the form's parameter costs an operand: 0 where it takes the
        // operand's own type, 1 where the operand widens to it, and -1 where
        // it can't take the operand.
        _form_parameter_cost(parameter: Type, operator_parameter: Type, operand: Type, widened: bool) -> int is
            if !widened then
                return if parameter.matches(operator_parameter) then 0 else -1 fi
            fi

            if parameter.matches(operator_parameter) then
                return -1
            fi

            if parameter.matches(operand) then
                return 0
            fi

            if widens(operand, parameter) then
                return 1
            fi

            return -1
        si

        _all() -> Collections.LIST[Symbols.Function] is
            let result = Collections.LIST[Symbols.Function]()

            for holder in _holders() do
                for symbol in holder.symbols do
                    if let group: Symbols.FUNCTION_GROUP = symbol then
                        for f in group.functions do
                            _add_if_widening(f, result)
                        od
                    elif let f: Symbols.Function = symbol then
                        _add_if_widening(f, result)
                    fi
                od
            od

            return result
        si

        // The holders: one declared in this compilation's source, and on
        // .NET one reflected from a referenced runtime, where name lookup
        // does not reach it. A library's own holder adds to the runtime's.
        _holders() -> Collections.LIST[Symbols.Symbol] is
            let result = Collections.LIST[Symbols.Symbol]()

            if _has_holder_for_testing then
                if let holder = _holder_for_testing then
                    result.add(holder)
                fi

                return result
            fi

            if
                let internal = IoC.CONTAINER.instance.namespaces.try_find_namespace(".Ghul.Internal"),
                holder = internal.find_member("WIDENINGS")
            then
                result.add(holder)
            fi

            @IF.dotnet()
            if let holder = IoC.CONTAINER.instance.dotnet_symbol_table.value.get_symbol("Ghul.Internal.WIDENINGS") then
                if !result.contains(holder) then
                    result.add(holder)
                fi
            fi

            return result
        si

        _add_if_widening(f: Symbols.Function, into: Collections.LIST[Symbols.Function]) is
            if f.is_widening /\ !f.is_instance /\ f.arguments.count == 1 /\ f.return_type? then
                into.add(f)
            fi
        si
    si
    // An operator reached by widening the left operand, the right one, or
    // both, with the widenings that reach it; a null widening leaves its
    // operand as written.
    class WIDENED_OPERATOR(
        function: Symbols.Function public,
        left: Symbols.Function? public,
        right: Symbols.Function? public
    ) is
        widening_count: int => (if left? then 1 else 0 fi) + (if right? then 1 else 0 fi)
    si
si
