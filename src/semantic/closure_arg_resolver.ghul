namespace Semantic is
    use Logging
    use Types.Type
    use Ghul.Pipes

    // Resolve closure argument types from the lambda's AST argument
    // expressions, mutating each argument symbol's `.type` and
    // recording any captured type-variables on the closure. Picks
    // among four resolution branches in priority order:
    //
    //   1. Symbol already carries a usable (non-inferred / non-
    //      error) type — keep it. This is set by a previous walk
    //      (overload resolution's second pass set the symbol's
    //      type from the chosen formal, or a function-level retry
    //      is re-walking the body).
    //
    //   2. Argument has a written type expression that isn't INFER
    //      — use it directly.
    //
    //   3. An implied type from the enclosing context
    //      (function.constraint.arguments) is available and
    //      "usable" — install it on the symbol. "Usable" means the
    //      type is concrete OR an in-scope type-variable. Foreign
    //      type-variables (carried over from an overload-resolution
    //      constraint where the candidate is a different generic
    //      function) are rejected — see #1210 commentary. Any
    //      in-scope type-variables embedded in the implied type are
    //      recorded via `closure.add_type_argument_reference` so IL
    //      emission generates a generic closure method with
    //      matching `!!N` slots.
    //
    //   4. Fall back to the iterative-inference path: try the
    //      argument variable's accumulated LUB. On success install
    //      that as the resolved type. On failure (still inferred /
    //      error) emit "cannot infer type here" and install a
    //      fresh INFERRED_VARIABLE_TYPE placeholder, leaving the
    //      outer body-retry loop to resolve from body operations.
    //
    // `resolve(...)` returns true when the loop completed and the
    // closure's `arguments` / `argument_names` were populated.
    // Returns false on an unexpected argument shape (anything other
    // than a `Syntax.Trees.Expressions.VARIABLE`) without writing
    // anything back to the closure.
    //
    // A parameter written as a destructure pattern carries its pattern
    // on that node's `left`. It stays one physical argument here — the
    // resolution above settles the aggregate type, and the pattern's
    // leaves take their types from it.
    class CLOSURE_ARG_RESOLVER(_logger: Logger) is
        super()

        resolve(
            arguments: Collections.List[Syntax.Trees.Expressions.Expression],
            closure: Symbols.Closure,
            implied_argument_types: Collections.List[Type]?
        ) -> bool is
            let argument_names = Collections.LIST[string]()
            let argument_types = Collections.LIST[Type]()

            if !_resolve_all(arguments, closure, implied_argument_types, argument_names, argument_types, null) then
                return false
            fi

            closure.packed_parameters = null
            closure.arguments = Collections.LIST[Type](argument_types)
            closure.argument_names = argument_names

            return true
        si

        // The same resolution for a literal written with an argument pack
        // spread out, going into a formal that takes the pack as one
        // tuple. The parameters stay the ones the literal declared, typed
        // from the tuple's elements where it has settled and as any other
        // parameter is where it has not. The closure is recorded taking
        // the tuple, so the type it has is the formal's own shape.
        resolve_packed(
            arguments: Collections.List[Syntax.Trees.Expressions.Expression],
            closure: Symbols.Closure,
            expected_tuple: Type?,
            fixed_types: Collections.List[Type]
        ) -> bool is
            let fixed = fixed_types.count
            let pack_count = arguments.count - fixed

            let group = closure.pack_group ?? Symbols.LOCAL_ARGUMENT(closure.location, closure, "$pack")

            group.is_defined = true

            closure.pack_group = group

            // What the formal says the tuple is, where it says something a
            // parameter can take. Where it does not - the tuple is another
            // function's own type parameters, or a guess that does not
            // destructure - the tuple is whatever resolving the call has
            // bound the literal's one physical parameter to so far.
            let implied =
                _elements_of(if expected_tuple? then SETTLED_PLACEHOLDER_RESOLVER.instance.resolve(expected_tuple) else null fi, pack_count, closure) ??
                _elements_of(group.try_get_inferred_type(), pack_count, closure)

            let argument_names = Collections.LIST[string]()
            let argument_types = Collections.LIST[Type]()
            let symbols = Collections.LIST[Symbols.Variable]()

            // By position: the formal's own parameters first, then the
            // pack's elements where they are known.
            let implied_types = Collections.LIST[Type]()

            for fixed_type in fixed_types do
                // A parameter of the formal's own that nothing has settled
                // yet is not a type a parameter can take. An error type in
                // its place is one no parameter takes, which leaves that
                // parameter to be inferred from the body.
                implied_types.add(if fixed_type.is_settled then fixed_type else Types.ERROR() fi)
            od

            if let known = implied then
                implied_types.add_range(known.elements)
            fi

            if !_resolve_all(arguments, closure, implied_types, argument_names, argument_types, symbols) then
                return false
            fi

            let element_types = Collections.LIST[Type]()
            let packed = Collections.LIST[Symbols.Variable]()

            for i in fixed..arguments.count do
                element_types.add(argument_types[i])
                packed.add(symbols[i])
            od

            // A parameter written with a type is filled from the element
            // at its position, so that element has to be one it accepts.
            if let known = implied then
                for i in 0..pack_count do
                    let written = element_types[i]

                    if written.is_settled /\ !written.is_assignable_from(known.elements[i]) then
                        _logger.error(
                            arguments[fixed + i].location,
                            "expected argument of type {written} but {known.elements[i]} supplied"
                        )
                    fi
                od
            fi

            let group_type: Type mut

            if let known = implied then
                group_type = known.tuple
            elif element_types |> all(t => t.is_settled) then
                // Nothing else says what the tuple is, so the parameters do.
                group_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_tuple_type(element_types, null)
            else
                // Still open: the one physical parameter stands for it, so
                // that resolving the call against the literal can bind it.
                let placeholder = Types.INFERRED_VARIABLE_TYPE(group)

                OBLIGATIONS.defer("parameter", placeholder, null)

                group_type = placeholder
            fi

            group.set_type(group_type)

            let physical_types = Collections.LIST[Type]()
            let physical_names = Collections.LIST[string]()

            for i in 0..fixed do
                physical_types.add(argument_types[i])
                physical_names.add(argument_names[i])
            od

            physical_types.add(group_type)
            physical_names.add("$pack")

            closure.packed_parameters = packed
            closure.arguments = physical_types
            closure.argument_names = physical_names

            return true
        si

        // The types `tuple` destructures into by position, where it is
        // settled, names nothing out of the literal's scope, and has
        // `count` elements. Absent otherwise.
        _elements_of(
            tuple: Type?,
            count: int,
            closure: Symbols.Closure
        ) -> (tuple: Type, elements: Collections.LIST[Type])? is
            if !tuple? \/ !tuple.is_settled \/ !_is_implied_type_usable(tuple, closure) then
                return null
            fi

            let strategy = Syntax.Process.DESTRUCTURE_RESOLVER.resolve_strategy(tuple, count)

            let elements = Collections.LIST[Type]()

            for i in 0..count do
                if strategy.is_deconstruct then
                    if let element_type = strategy.deconstruct_function!.arguments[i].get_element_type() then
                        elements.add(element_type)
                    fi
                elif i < strategy.members.count then
                    if let member = strategy.members[i], member_type = member.type then
                        elements.add(member_type)
                    fi
                fi
            od

            if elements.count != count then
                return null
            fi

            return (tuple = tuple, elements = elements)
        si

        _resolve_all(
            arguments: Collections.List[Syntax.Trees.Expressions.Expression],
            closure: Symbols.Closure,
            implied_argument_types: Collections.List[Type]?,
            argument_names: Collections.LIST[string],
            argument_types: Collections.LIST[Type],
            symbols: Collections.LIST[Symbols.Variable]?
        ) -> bool is
            for index in 0..arguments.count do
                let a = arguments[index]

                if !isa Syntax.Trees.Expressions.VARIABLE(a) then
                    // A lambda parameter group is speculated as a tuple
                    // expression and only then converted to a pattern,
                    // so a `~` leaf arrives here as a unary operator
                    // the conversion could not take, rather than as a
                    // marked leaf. Name it, since the generic message
                    // below says nothing about what is wrong.
                    if let marker_location = _find_match_marker(a) then
                        _logger.error(
                            marker_location,
                            "a match marker is only allowed in a refutable pattern (if let, while let or case-when arm)"
                        )

                        return false
                    fi

                    _logger.error(a.location, "unexpected kind of argument ({a.get_type()})")
                    return false
                fi

                let argument = a

                argument_names.add(argument.name.name)

                let symbol = cast Symbols.Variable?(closure.find_direct(argument.name.name))!

                // A parameter holds a value from the moment its literal is
                // entered, whatever pass this is and however many retries
                // its type takes to settle. Without this, `is_defined`
                // stays false for a plain (non-destructured) parameter
                // forever, and a reference to it from within its own body
                // reads as the self-referencing-`let`-initializer case to
                // `SHADOWED_CALLABLE_FINDER.find` — which
                // skips that call's sentinel-type guard and, when an
                // enclosing scope happens to declare a same-named
                // callable, spuriously falls back and captures it.
                symbol.is_defined = true

                let argument_type = _resolve_one(a, argument, symbol, index, implied_argument_types, implied_argument_types? /\ implied_argument_types.count == arguments.count, closure)

                argument_types.add(argument_type)

                if symbols? then
                    symbols.add(symbol)
                fi

                // The physical argument's type is what the pattern
                // unpacks; push it through the leaves so the body sees
                // each bound name at its element type.
                if let argument.left? then
                    _assign_destructure_element_types(left, argument_type, closure)
                fi
            od

            return true
        si

        // Marks every name a pattern binds as holding a value, for a walk
        // on which the aggregate has no members to type them from yet.
        _define_leaves(left: Syntax.Trees.Variables.VariableLeft, closure: Symbols.Closure) is
            for element in left.elements! do
                if element.is_simple_name then
                    if let symbol = cast Symbols.Variable?(closure.find_direct(element.name!.name)) then
                        symbol.define()
                    fi
                else
                    _define_leaves(element, closure)
                fi
            od
        si

        // Push a destructured parameter's aggregate type down onto the
        // names its pattern binds, so the body sees each leaf at its
        // element type. Shares DESTRUCTURE_RESOLVER with `let`
        // destructuring and with a named function's destructured
        // formal argument, so a value tuple, a `deconstruct(...)`
        // source and positional members all resolve the same way.
        _assign_destructure_element_types(
            left: Syntax.Trees.Variables.VariableLeft,
            from_type: Type?,
            closure: Symbols.Closure
        ) is
            // The aggregate may be a placeholder whose origin has since
            // settled - a pack slot pinned by a later call, say - and the
            // members to destructure are the settled tuple's.
            let aggregate = if from_type? then SETTLED_PLACEHOLDER_RESOLVER.instance.resolve(from_type) else null fi

            // One still being inferred has no members to type the leaves
            // from yet: an obligation of this walk, with the leaves defined
            // so the body can name them, and their types left to a walk on
            // which the aggregate has settled.
            if aggregate? /\ aggregate.is_inferred then
                OBLIGATIONS.defer("destructure", aggregate, left.location)
                _define_leaves(left, closure)

                return
            fi

            let elements = left.elements!

            let strategy =
                Syntax.Process.DESTRUCTURE_RESOLVER.resolve_strategy_reporting(
                    _logger, left.location, aggregate, elements.count, null
                )

            for i in 0..elements.count do
                let element = elements[i]

                let element_type =
                    if strategy.is_deconstruct then
                        strategy.deconstruct_function!.arguments[i].get_element_type()
                    else
                        let member = strategy.members[i] in
                        if member? then member.type else null fi
                    fi

                if element.is_simple_name then
                    let symbol = cast Symbols.Variable?(closure.find_direct(element.name!.name))

                    if let typed_symbol = cast Types.SettableTyped?(symbol) then
                        // The cast above only yields present when `symbol`
                        // itself was, so `symbol` is present here too.
                        symbol!.define()
                        typed_symbol.set_type(if element_type? then element_type else Types.ERROR() fi)
                    fi
                else
                    _assign_destructure_element_types(element, element_type, closure)
                fi
            od
        si

        // The location of a `~` match marker anywhere in a parameter
        // group, or absent when there is none.
        _find_match_marker(expression: Syntax.Trees.Expressions.Expression) -> Source.LOCATION? is
            if let unary: Syntax.Trees.Expressions.UNARY = expression then
                if unary.operation.name =~ "~" then
                    return unary.location
                fi

                return _find_match_marker(unary.right)
            fi

            if let tuple: Syntax.Trees.Expressions.TUPLE = expression then
                for element in tuple.elements.expressions do
                    if let found = _find_match_marker(element) then
                        return found
                    fi
                od
            fi

            return null
        si

        _resolve_one(
            a: Syntax.Trees.Expressions.Expression,
            argument: Syntax.Trees.Expressions.VARIABLE,
            symbol: Symbols.Variable,
            index: int,
            implied_argument_types: Collections.List[Type]?,
            slot_matches_arity: bool,
            closure: Symbols.Closure
        ) -> Type is
            // An untyped parameter takes the type of the slot the literal goes
            // into, even where an earlier walk settled it from how the body
            // uses it: the slot says what the literal will be called with. A
            // slot of another arity, as a pack literal has, says nothing
            // parameter by parameter.
            if
                slot_matches_arity /\
                isa Syntax.Trees.TypeExpressions.INFER(argument.type_expression) /\
                implied_argument_types? /\ index < implied_argument_types.count /\
                implied_argument_types[index].is_settled /\
                _is_implied_type_usable(implied_argument_types[index], closure)
            then
                let implied_argument_type = implied_argument_types[index]

                symbol.set_type(implied_argument_type)
                _record_method_level_type_arguments(implied_argument_type, symbol)
                return implied_argument_type
            fi

            if symbol.type? /\ symbol.type.is_settled then
                return symbol.type!
            fi

            // A type holding a placeholder whose origin has since settled
            // - a pack slot pinned by a later call, an argument bounded by
            // a call in the body - collapses to what it settled to, so the
            // closure's signature names the answer rather than the
            // placeholder that stood for it.
            if let existing = symbol.type then
                let collapsed = SETTLED_PLACEHOLDER_RESOLVER.instance.resolve(existing)

                if collapsed != existing /\ collapsed.is_settled then
                    symbol.set_type(collapsed)
                    _record_method_level_type_arguments(collapsed, symbol)

                    return collapsed
                fi
            fi

            if !isa Syntax.Trees.TypeExpressions.INFER(argument.type_expression) then
                let te_type = argument.type_expression.type
                assert te_type? else "argument type-expression has no resolved type"
                return te_type
            fi

            // The implied types come from the formal the call pushed,
            // so a literal of a different arity has nothing at this
            // index. That is a call the resolver will reject; falling
            // through to inference here keeps this walk from reading
            // off the end of the list first.
            if implied_argument_types? /\ index < implied_argument_types.count then
                let implied_argument_type = implied_argument_types[index]

                if _is_implied_type_usable(implied_argument_type, closure) then
                    symbol.set_type(implied_argument_type)
                    _record_method_level_type_arguments(implied_argument_type, symbol)
                    return implied_argument_type
                fi
            fi

            return _resolve_from_inference_or_placeholder(a, symbol)
        si

        _resolve_from_inference_or_placeholder(
            a: Syntax.Trees.Expressions.Expression,
            symbol: Symbols.Variable
        ) -> Type is
            let inferred = symbol.try_get_inferred_type()

            if inferred? /\ !inferred.is_sentinel then
                symbol.set_type(inferred)
                _record_method_level_type_arguments(inferred, symbol)

                // A shape whose parts are still to be inferred - the
                // return of a function only ever called - leaves the
                // parameter as unsettled as no type at all.
                if !inferred.is_settled then
                    OBLIGATIONS.defer("parameter", Types.INFERRED_VARIABLE_TYPE(symbol), null)
                fi

                return inferred
            fi

            // Nothing has typed the parameter yet: an obligation of this
            // walk on its placeholder, reported at the parameter by the
            // fixing step if no later walk settles it.
            let placeholder = Types.INFERRED_VARIABLE_TYPE(symbol)
            symbol.set_type(placeholder)

            OBLIGATIONS.defer("parameter", placeholder, null)

            return placeholder
        si

        // Same intent as the implied-type-path walk: when a closure
        // arg's type contains method-level type variables (T from an
        // enclosing generic method, not class-level T from a Box[T]'s
        // members) the closure has to capture them so IL emission
        // generates a generic closure method with matching `!!N`
        // slots. For the inference path the type carries no AST node,
        // so the explicit walk-and-record is the only way the
        // RECORD_TYPE_ARGUMENT_USES pass — which keys off written
        // type expressions — would otherwise miss them.
        _record_method_level_type_arguments(t: Type, symbol: Symbols.Variable) is
            if !isa Symbols.Closure(symbol.owner) then
                return
            fi

            let closure = cast Symbols.Closure(symbol.owner)

            let collected = Collections.LIST[Symbols.Symbol]()
            INFERENCE_HELPERS.collect_method_level_type_variables(t, collected)

            for u in collected do
                closure.add_type_argument_reference(u)
            od
        si

        // True when the implied type for a closure argument is safe
        // to install as the symbol's type. Concrete types are always
        // usable. Type-variable-containing types are usable only when
        // every embedded type-variable is declared by a lexical
        // ancestor of the closure — i.e. it's in scope. Foreign type
        // variables (from overload-resolution constraints carrying
        // the *candidate* function's type vars) are rejected so the
        // iterative-inference fallback runs and resolves the arg
        // from body operations.
        //
        // ERROR-bearing types are also rejected. The call-site retry
        // walks tuple actuals under the candidate's still-generic
        // formal, and partial-binding can produce an `(ERROR, ERROR)`
        // tuple substitution when an earlier walk left ERROR fragments
        // around. Installing that as the closure arg's type silently
        // turns the destructure-on-arg path into a tuple-with-ERRORs
        // destructure, which the existing path accepts without an
        // error — `g2` ends up with ERROR type, IL gen runs (no errors
        // logged), and ICEs in Type.gen_type. Rejecting the implied
        // pushes us into the placeholder-or-LUB path, which emits
        // "cannot infer type here" so IL gen short-circuits cleanly.
        _is_implied_type_usable(t: Type, closure: Symbols.Closure) -> bool is
            // A slot the call has no type for at all says nothing about
            // the parameter.
            if t.is_none then
                return false
            fi

            // ghūl closures capture locals by value, so the inner
            // lambda can't assign to a primitive local in this
            // scope. BOX[bool] gives us a mutable holder the lambda
            // can write to via property assignment.
            let any_foreign = Ghul.BOX(false)
            let any_error = Ghul.BOX(false)

            t.walk((u: Type) is
                if u.is_error then
                    any_error.value = true
                fi

                if u.is_type_variable /\ !_is_type_variable_in_scope(u.symbol, closure) then
                    any_foreign.value = true
                fi
            si)

            return !any_foreign.value /\ !any_error.value
        si

        // Look up the type variable's name from the closure's scope.
        // If `find_enclosing(name)` resolves to the same symbol,
        // the type variable is lexically in scope at the lambda.
        // For foreign type variables (the candidate function's type
        // vars in an overload-resolution constraint), the lookup
        // either returns null or returns a DIFFERENT same-named
        // symbol — either way, not-in-scope, so we return false and
        // let the iterative-inference path resolve from body
        // operations.
        _is_type_variable_in_scope(type_variable: Symbols.Symbol?, closure: Symbols.Closure?) -> bool is
            if !type_variable? \/ !closure? then
                return false
            fi

            let found = closure.find_enclosing(type_variable.name)

            return found? /\ found == type_variable
        si
    si
si
