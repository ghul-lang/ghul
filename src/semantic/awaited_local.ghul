namespace Semantic is
    use Types.Type

    // Whether a value's type is a local variable's, still being inferred
    // from what is assigned to it. A join or an assignment waits for such
    // a value. Other placeholders do not qualify: a literal's own result
    // or a call's type argument can be what the join itself is deciding,
    // and waiting for it would wait forever.
    class AWAITED_LOCAL is
        is_awaited_local(type: Type?) -> bool static =>
            if let placeholder: Types.INFERRED_VARIABLE_TYPE = type then
                isa Symbols.LOCAL_VARIABLE(placeholder.origin)
            else
                false
            fi
    si
si
