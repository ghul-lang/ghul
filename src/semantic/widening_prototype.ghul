namespace Semantic is
    // Prototype switch: whether a value moving into an explicitly typed
    // slot (an assignment, an initialisation, a return, a typed literal)
    // may widen to the slot's type.
    class WIDENING_PROTOTYPE is
        into_typed_slots: bool static =>
            !string.is_null_or_empty(System.Environment.get_environment_variable("GHUL_WIDEN_V2"))

        init() is si
    si
si
