namespace IR is
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    // Where generated code goes. Generate-il builds each body as IR
    // values and hands them here; the backend decides what they become
    // and where the result is kept.
    //
    // Bodies nest: a closure's body is begun while the body of the
    // function containing it is still open, and ending the inner body
    // goes back to the outer one. A body is finished against whatever
    // it belongs to before it is ended, and is ended whether or not it
    // was finished.
    trait Backend open is
        // Starts a module of this name and version, written as a library
        // or as an executable.
        install(module_name: string, module_version: string, want_library: bool)

        // Starts the module again, after the symbols what was generated
        // names have been abandoned.
        reset()

        // Called once before the first body is begun.
        begin_assembly()

        // Called once after the last body has ended, when nothing has
        // been reported against the build.
        end_assembly()

        add_resource(name: string, content: ubyte[])

        write(path: string)

        begin_body()

        // A body whose values name types in the terms of a member other
        // than the one the enclosing body belongs to, such as a closure
        // reading its own type parameters.
        begin_body(member: Symbol)

        write(value: Values.Value)

        finish_body(function: Function)

        finish_frame_member_body(frame: Classy, member: FrameMember)

        finish_unit_variant_initializer(variant: Classy)

        end_body()

        // Drops every body still open, after a failure that unwound
        // past the ends of the bodies it began.
        abandon_bodies()

        // Whether the variant has a single shared instance for its
        // initializer to create.
        has_unit_variant_instance(variant: Classy) -> bool

        // The function the program starts at.
        mark_entry_point(function: Function)
    si
si
