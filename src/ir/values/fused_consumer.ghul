namespace IR.Values is
    use Semantic.Types.Type

    // One map/filter stage of a fused-consumer loop. The stage's lambda
    // delegate is hoisted into a local (built once) and `apply` invokes it
    // on the current element, yielding either a bool (a `filter` stage -
    // branch to the next element when false) or the transformed element (a
    // `map` stage - stored into `output` for the next stage). The
    // delegate is called rather than inlined so a lambda that captures an
    // enclosing local (or nests another closure) keeps its normal capture
    // context.
    //
    // A stage is one shape or the other, so each constructor fills its
    // own fields and leaves the other shape's alone; `is_countdown`
    // says which are live.
    @suppress("field-definite-assignment")
    class FUSED_CONSUMER_STAGE is
        is_filter: bool public
        delegate_local: IR.LOCAL public
        delegate_init: Value public
        apply: Value public
        output: IR.LOCAL? public

        // A `take`/`skip` stage carries no delegate: the count is evaluated
        // once into `counter` and each element decrements it (the
        // loop stops pulling once a take's runs out, skip drops the element
        // while its remains). `is_countdown` marks either.
        is_take: bool public
        is_skip: bool public
        counter: IR.LOCAL public
        count_init: Value? public

        // A `take_while`/`skip_while` stage carries its predicate as a
        // filter does. take_while leaves the loop at the first element the
        // predicate rejects; skip_while drops elements while it accepts
        // them, then passes the rest through, its `skip_flag` saying which
        // side of that boundary the loop is on.
        is_take_while: bool public
        is_skip_while: bool public
        skip_flag: IR.LOCAL? public

        // An index stage carries a running counter like a countdown does,
        // but produces an output local as a map stage does: `apply` builds
        // the INDEXED_VALUE from the counter and the incoming element.
        is_index: bool public

        // An inlined map/filter stage has no delegate: `param_store`
        // writes the incoming element into the local the stage literal's
        // parameter loads as, and `apply` is the literal's body, compiled
        // to read it and any captured locals as the enclosing body's own.
        param_local: IR.LOCAL? public
        param_store: Value? public

        is_inlined: bool => param_local?

        is_countdown: bool => is_take \/ is_skip

        init(is_filter: bool, delegate_local: IR.LOCAL, delegate_init: Value, apply: Value, output: IR.LOCAL?) is
            self.is_filter = is_filter
            self.delegate_local = delegate_local
            self.delegate_init = delegate_init
            self.apply = apply
            self.output = output
        si

        init(param_local: IR.LOCAL, param_store: Value, apply: Value, is_filter: bool, output: IR.LOCAL?) is
            self.is_filter = is_filter
            self.param_local = param_local
            self.param_store = param_store
            self.apply = apply
            self.output = output
        si

        init(is_take: bool, is_skip: bool, counter: IR.LOCAL, count_init: Value) is
            self.is_take = is_take
            self.is_skip = is_skip
            self.counter = counter
            self.count_init = count_init
        si

        init(counter: IR.LOCAL, start_init: Value, output: IR.LOCAL, apply: Value) is
            self.is_index = true
            self.counter = counter
            self.count_init = start_init
            self.output = output
            self.apply = apply
        si
    si

    // A terminal Pipe consumer (`count`, `any`, `all`, `each`, `reduce`,
    // `find`, `first`, `collect_mutable`, `sum`, `product`, ...) fused with its chain: drives the
    // chain's source iterator directly, applies the map/filter stages per
    // element by calling each stage's hoisted delegate, runs the consumer's
    // per-element body, and leaves the consumer's result on the stack -
    // emitted in place of the consumer method call, so it flows through any
    // expression context (like NULL_COALESCE_VALUE).
    class FUSED_CONSUMER: Composite is
        _result_type: Type


        // Loop skeleton, pre-built against the '.fc_iter.N' iterator local.
        // `iterator_init` produces the source's own iterator (or is the
        // source itself when it is already an iterator); move_next /
        // read_current drive it.
        has_iterator: bool public
        iterator_init: Value public
        iterator: IR.LOCAL public
        move_next: Value public
        read_current: Value public

        // The element local the innermost stage reads.
        element: IR.LOCAL public

        stages: Collections.List[FUSED_CONSUMER_STAGE] public

        // The surviving element after every stage - what the consumer body
        // operates on (`collect` adds it, `find` returns it, ...).
        final_element: IR.LOCAL public

        // Consumer specifics.
        consumer_kind: string public

        // join. The result local holds the interpolation handler the
        // elements are written into and `finish` reads it back as a
        // string, so what is left is the separator, evaluated once
        // before the loop, and whether anything has been written yet.
        // A flag rather than the handler's own length, because an
        // element whose text is empty still counts as written.
        join_separator: IR.LOCAL? public
        join_separator_init: Value? public
        join_seen: IR.LOCAL? public
        join_append_separator: Value? public
        join_append_element: Value? public

        // The result local, named in compile-expressions so pre-built
        // values (a `reduce` accumulator) can reference it. It holds the
        // consumer's own type unless `result_local_type` says otherwise:
        // `collect` fills a list there and its `finish` derives the array.
        result: IR.LOCAL public
        result_local_type: Type? public

        // A consumer with a function argument (`any`/`all`/`find`/`each`
        // predicate/action, `reduce` accumulator) hoists it into a local so
        // the delegate is built once. `consumer_apply` is that argument
        // applied per element (to the final element, and for `reduce` the
        // running result too), pre-built against the hoisted local.
        consumer_arg: IR.LOCAL? public
        consumer_arg_init: Value? public
        consumer_apply: Value? public

        // A consumer's function argument inlined into the loop: no
        // delegate is built, `consumer_param_store` writes the surviving
        // element into the local the literal's parameter loads as, and
        // `consumer_apply` is the literal's body.
        consumer_param: IR.LOCAL? public
        consumer_param_store: Value? public

        // `reduce` seeds the result with its first argument; `find`/`first`
        // seed the result with an empty MAYBE; `collect` seeds it with a
        // fresh list.
        seed_init: Value? public

        // `find`/`first` wrap the surviving element in a MAYBE; `collect`
        // adds it to the result list. Pre-built against the element / result
        // locals.
        wrap_element: Value? public
        add_element: Value? public

        // min / max / min_by / max_by keep the best element so far in
        // `extremum_best` and, for the _by kinds, the key that won it in
        // `extremum_key`; `extremum_candidate` holds the current element's
        // key for the one element being handled. `extremum_seen` says any
        // element was reached at all. `extremum_better` compares the stored
        // key with the candidate, and `extremum_wrap` builds the result
        // MAYBE over the best element. All pre-built against those locals.
        extremum_best: IR.LOCAL? public
        extremum_key: IR.LOCAL? public
        extremum_candidate: IR.LOCAL? public
        extremum_seen: IR.LOCAL? public
        extremum_better: Value? public
        extremum_wrap: Value? public

        // A consumer whose result is derived from the result local after
        // the loop rather than being that local: `collect` fills a list
        // and hands back its array. Pre-built against the result local;
        // leaves the consumer's value on the stack.
        finish: Value? public

        // The source, evaluated once into a local before the iterator is
        // taken from it, where the consumer reads the source twice - for
        // its iterator and for its count. `iterator_init` and the count
        // are then pre-built over that local. Absent, `iterator_init`
        // evaluates the source itself.
        source: IR.LOCAL? public
        source_init: Value? public

        // A collect over a source whose count is known before the loop,
        // through stages that keep it, sizes its result up front. For a
        // list result the count is the capacity `seed_init` was built
        // with. For an array result `presize_array` is set,
        // `presize_count` is the count pre-built over the source local,
        // and the loop writes each element at `presize_index`
        // into an array allocated at that count, so no list is filled
        // and no copy is made.
        presize_count: Value? public
        presize_array: bool public
        presize_index: IR.LOCAL? public
        presize_element_type: Type? public

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(
            result_type: Type,
            iterator_init: Value,
            has_iterator: bool,
            iterator: IR.LOCAL,
            move_next: Value,
            read_current: Value,
            element: IR.LOCAL,
            stages: Collections.List[FUSED_CONSUMER_STAGE],
            final_element: IR.LOCAL,
            consumer_kind: string,
            result: IR.LOCAL
        ) is
            super.init()

            self._result_type = result_type
            self.iterator_init = iterator_init
            self.has_iterator = has_iterator
            self.iterator = iterator
            self.move_next = move_next
            self.read_current = read_current
            self.element = element
            self.stages = stages
            self.final_element = final_element
            self.consumer_kind = consumer_kind
            self.result = result
        si

        is_void: bool => Syntax.Process.PIPE_CONSUMER_KIND.is_void(consumer_kind)

        // One of the four kinds that keep the best element of a whole
        // read: min, max, min_by, max_by.
        _is_extremum(kind: string) -> bool =>
            kind =~ "min" \/ kind =~ "max" \/ kind =~ "min_by" \/ kind =~ "max_by"

        // The fused loop, leaving the consumer's result (nothing for a
        // void `each`).
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(_result_type)
            let int_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_int_type()

            // A source read more than once - for its iterator and for its
            // count - is evaluated once, first, and everything below reads
            // the local.
            if let local = source, init = source_init then
                expansion.store(expansion.declare(local), init)
            fi

            result.type = result_local_type ?? _result_type

            if !is_void then
                expansion.declare(result)
                _expand_result_init(expansion, result, int_type)
            fi

            // A consumer's function argument is built once into a local.
            if let local = consumer_arg, arg_init = consumer_arg_init then
                expansion.store(expansion.declare(local), arg_init)
            fi

            if let param = consumer_param then
                expansion.declare(param)
            fi

            // Each stage's lambda delegate is built once before the loop; a
            // take/skip stage instead seeds its running counter with the
            // count evaluated once; a skip_while's flag starts on the
            // dropping side of its boundary.
            for stage in stages do
                if stage.is_countdown \/ stage.is_index then
                    expansion.store(expansion.declare(stage.counter), stage.count_init!)
                elif let param = stage.param_local then
                    expansion.declare(param)
                else
                    expansion.store(expansion.declare(stage.delegate_local), stage.delegate_init)
                fi

                if let flag = stage.skip_flag then
                    expansion.store(expansion.declare(flag), Literal.NUMBER(1, int_type))
                fi
            od

            // The iterator always lives in a local - whether it came from
            // the source's iterator member or the source is itself an
            // iterator (a value-type range), move_next / current drive it
            // through the local (by address for a value-type iterator).
            expansion.store(expansion.declare(iterator), iterator_init)

            let loop = expansion.loop()

            // Leave before pulling once any take stage has spent its count,
            // so the loop pulls exactly the elements it yields and never
            // advances the source past them.
            for stage in stages do
                if stage.is_take then
                    expansion.exit_if(
                        loop,
                        IR.BRANCH.LE,
                        stage.counter.load(),
                        Literal.NUMBER(0, int_type))
                fi
            od

            expansion.exit_if(loop, IR.BRANCH.Z, move_next)
            expansion.store(expansion.declare(element), read_current)

            for stage in stages do
                if stage.is_countdown then
                    // This element spends one of the stage's count. A take's
                    // check at the top of the loop decides when to stop; a
                    // skip drops the element while its counter stays
                    // non-negative.
                    let counter = stage.counter

                    expansion.store(
                        counter,
                        ARITHMETIC(
                            IR.ArithmeticOperation.SUBTRACT,
                            counter.load(),
                            Literal.NUMBER(1, int_type),
                            int_type).unmarked())

                    if stage.is_skip then
                        expansion.continue_if(loop, IR.BRANCH.GE, counter.load(), Literal.NUMBER(0, int_type))
                    fi
                else
                    if let store = stage.param_store then
                        expansion.add(store)
                    fi

                    if stage.is_take_while then
                        expansion.exit_if(loop, IR.BRANCH.Z, stage.apply)
                    elif stage.is_skip_while then
                        // While the flag is set the predicate still holds
                        // of some prefix, and its elements are dropped;
                        // the first one it rejects clears the flag, and
                        // every element after passes untested.
                        let dropping = expansion.region()

                        expansion.exit_if(dropping, IR.BRANCH.Z, stage.skip_flag!.load())
                        expansion.continue_if(loop, IR.BRANCH.NZ, stage.apply)
                        expansion.store(stage.skip_flag!, Literal.NUMBER(0, int_type))
                        expansion.close(dropping)
                    elif stage.is_filter then
                        expansion.continue_if(loop, IR.BRANCH.Z, stage.apply)
                    else
                        expansion.store(expansion.declare(stage.output!), stage.apply)
                    fi
                fi
            od

            _expand_element_body(expansion, loop, result, int_type)

            expansion.close(loop)

            // A min / max that reached an element answers with the best
            // one wrapped; one that reached none keeps the empty MAYBE
            // the result was seeded with.
            if let seen = extremum_seen then
                let wrapped = expansion.region()

                expansion.exit_if(wrapped, IR.BRANCH.Z, seen.load())
                expansion.store(result, extremum_wrap!)
                expansion.close(wrapped)
            fi

            if let derived = finish then
                expansion.add(derived)
            elif !is_void then
                expansion.add(result.load())
            fi

            return expansion.result
        si

        // Initialise the result local before the loop.
        _expand_result_init(expansion: IR.EXPANSION, result: IR.LOCAL, int_type: Type) is
            if consumer_kind =~ "count" \/ consumer_kind =~ "any" then
                // count starts at 0; any starts false (0).
                expansion.store(result, Literal.NUMBER(0, result.type))
            elif consumer_kind =~ "all" then
                expansion.store(result, Literal.NUMBER(1, result.type))
            elif presize_array then
                // The array, allocated at the source's count, and the
                // index the loop writes at, from zero.
                expansion.store(result, NEW_ARRAY(result.type, presize_element_type!, presize_count!))
                expansion.store(expansion.declare(presize_index!), Literal.NUMBER(0, int_type))
            elif let seed = seed_init then
                // reduce (seed), find / first (empty MAYBE), collect (list),
                // join (the interpolation handler).
                expansion.store(result, seed)
            fi

            if let separator = join_separator_init, local = join_separator then
                let seen = join_seen!

                expansion.store(expansion.declare(local), separator)
                expansion.store(expansion.declare(seen), Literal.NUMBER(0, seen.type))
            fi

            if let seen = extremum_seen then
                expansion.declare(extremum_best!)

                if let key = extremum_key then
                    expansion.declare(key)
                fi

                if let candidate = extremum_candidate then
                    expansion.declare(candidate)
                fi

                expansion.store(expansion.declare(seen), Literal.NUMBER(0, seen.type))
            fi
        si

        // Per-element consumer body (after the stages have produced the
        // surviving element).
        _expand_element_body(expansion: IR.EXPANSION, loop: LOOP, result: IR.LOCAL, int_type: Type) is
            let element = final_element.load()

            if let store = consumer_param_store then
                expansion.add(store)
            fi

            if consumer_kind =~ "count" then
                expansion.store(result, _add(result.load(), Literal.NUMBER(1, result.type), result.type))
            elif consumer_kind =~ "any" then
                _expand_answer(expansion, loop, result, IR.BRANCH.Z, Literal.NUMBER(1, result.type))
            elif consumer_kind =~ "all" then
                _expand_answer(expansion, loop, result, IR.BRANCH.NZ, Literal.NUMBER(0, result.type))
            elif consumer_kind =~ "each" then
                expansion.add(consumer_apply!)
            elif consumer_kind =~ "reduce" then
                expansion.store(result, consumer_apply!)
            elif consumer_kind =~ "join" then
                // The separator goes in ahead of every element but the
                // first, then the element's own text, as the runtime's
                // append_to writes it.
                let seen = join_seen!
                let first = expansion.region()

                expansion.exit_if(first, IR.BRANCH.Z, seen.load())
                expansion.add(join_append_separator!)
                expansion.close(first)

                expansion.add(join_append_element!)
                expansion.store(seen, Literal.NUMBER(1, seen.type))
            elif consumer_kind =~ "sum_by" then
                expansion.store(result, _add(result.load(), consumer_apply!, result.type))
            elif consumer_kind =~ "sum" then
                // As the one instruction the element type's own `+` is. A
                // type whose addition is an operator method declines at
                // recognition.
                expansion.store(result, _add(result.load(), element, result.type))
            elif consumer_kind =~ "product" then
                expansion.store(
                    result,
                    ARITHMETIC(IR.ArithmeticOperation.MULTIPLY, result.load(), element, result.type).unmarked())
            elif consumer_kind =~ "find" then
                _expand_answer(expansion, loop, result, IR.BRANCH.Z, wrap_element!)
            elif consumer_kind =~ "first" then
                expansion.store(result, wrap_element!)
                expansion.exit(loop)
            elif _is_extremum(consumer_kind) then
                let seen = extremum_seen!
                let best = extremum_best!
                let candidate = extremum_candidate!

                // The key the element is judged by: the element itself
                // for min and max, or what the selector called on it
                // returns for the _by kinds - one selector call per
                // element, as the runtime's own loop makes.
                expansion.store(candidate, consumer_apply ?? element)

                // An element already reached can be taken over by a
                // better one; none has been reached yet is the seeding
                // case below. The seen flag is only set there, after
                // this test, so the two never overlap.
                let takeover = expansion.region()
                expansion.exit_if(takeover, IR.BRANCH.Z, seen.load())

                let when_better = expansion.region()
                expansion.exit_if(when_better, IR.BRANCH.Z, extremum_better!)

                expansion.store(extremum_key!, candidate.load())
                expansion.store(best, element)
                expansion.close(when_better)

                expansion.close(takeover)

                let seed = expansion.region()
                expansion.exit_if(seed, IR.BRANCH.NZ, seen.load())

                expansion.store(seen, Literal.NUMBER(1, seen.type))
                expansion.store(extremum_key!, candidate.load())
                expansion.store(best, element)
                expansion.close(seed)
            elif presize_array then
                let element_type = presize_element_type!
                let index = presize_index!

                expansion.add(
                    STORE_ARRAY_ELEMENT(
                        result.load(),
                        index.load(),
                        IoC.CONTAINER.instance.value_boxer.box_if_needed(element, element_type),
                        element_type))

                expansion.store(index, _add(index.load(), Literal.NUMBER(1, int_type), int_type))
            elif consumer_kind =~ "collect" \/ consumer_kind =~ "collect_array" \/ consumer_kind =~ "collect_set" then
                expansion.add(add_element!)
            fi
        si

        // Unless the consumer's argument answers `skip` for this element,
        // the loop stops with `answer` as the result.
        _expand_answer(expansion: IR.EXPANSION, loop: LOOP, result: IR.LOCAL, skip: IR.BRANCH, answer: Value) is
            let next = expansion.region()

            expansion.exit_if(next, skip, consumer_apply!)
            expansion.store(result, answer)
            expansion.exit(loop)
            expansion.close(next)
        si

        _add(left: Value, right: Value, type: Type) -> Value =>
            ARITHMETIC(IR.ArithmeticOperation.ADD, left, right, type).unmarked()

        to_string() -> string =>
            "fused-consumer:[{consumer_kind}]({_result_type})"
    si
si
