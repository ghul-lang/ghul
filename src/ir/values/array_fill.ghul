namespace IR.Values is
    use Semantic.Types.Type

    // A new array of `element_type` with `count` elements, on the stack.
    class NEW_ARRAY: Value is
        element_type: Type
        count: Value

        type: Type

        init(type: Type, element_type: Type, count: Value) is
            super.init()

            self.type = type
            self.element_type = element_type
            self.count = count
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "new-array:[{type}]({count})"
    si

    // `array[index] = element`, boxing the element where the array holds
    // a reference type. Leaves nothing on the stack.
    class STORE_ARRAY_ELEMENT: Value is
        array: Value
        index: Value
        element: Value
        element_type: Type

        init(array: Value, index: Value, element: Value, element_type: Type) is
            super.init()

            self.array = array
            self.index = index
            self.element = element
            self.element_type = element_type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "store-array-element:({array}[{index}] = {element})"
    si
si
