namespace IR.Values is
    use Semantic.Types.Type

    // `!` on a plain reference-typed `T?`: at IL a reference optional is
    // already just `T`, so there is nothing to unwrap — `!`'s only job
    // is to make an absent value throw here, rather than silently
    // passing null on to wherever the (now falsely non-optional) value
    // is eventually read. `GetType()` is called and discarded purely to
    // force the runtime's own null check; the JIT is free to see the
    // loaded `Type` go unused and keep only the check.
    //
    //   <inner IL>            // [..., v]
    //   dup                   // [..., v, v]
    //   callvirt GetType()    // [..., v, type] — throws NullReferenceException if v is null
    //   pop                   // [..., v]
    class REFERENCE_NULL_CHECK: Value is
        inner: Value
        _type: Type

        type: Type => _type
        is_lightweight_pure: bool => false

        init(inner: Value, result_type: Type) is
            super.init()

            self.inner = inner
            self._type = result_type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "reference-null-check:[{type}]({inner})"
    si
si
