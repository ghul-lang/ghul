namespace IR.Values is
    use Semantic.Types.Type

    // Coerce a reference-typed `T?` into the unconstrained-T optional
    // carrier `Ghul.MAYBE[T]`. A reference optional carries absence as
    // a null reference and MAYBE as a zeroed struct, so the two are
    // bridged by a null test: the present path wraps the reference
    // with MAYBE<T>::.ctor(T), the absent path yields the empty MAYBE.
    //
    // Built by VALUE_BOXER.wrap_if_needed. The value-type optional
    // sources (NULLABLE[T], another MAYBE instantiation) go through
    // NULL_COALESCE_VALUE instead, since presence there is a member
    // read off the struct's address rather than a null test.
    class WRAP_MAYBE: Composite is
        value: Value
        _maybe_type: Type
        _absent: Value

        type: Type => _maybe_type
        is_value_type: bool => true
        is_lightweight_pure: bool => false

        init(
            maybe_type: Type,
            value: Value
        ) is
            super.init()

            self._maybe_type = maybe_type
            self.value = value
            self._absent = Values.DEFAULT(maybe_type)
        si

        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)
            let source = expansion.temp("wrap_maybe", value.type!)

            expansion.store(source, value)

            let result = expansion.temp("maybe", type)

            let done = expansion.region()
            let absent = expansion.region()

            expansion.exit_if(absent, IR.BRANCH.Z, source.load())
            expansion.store(result, CONSTRUCT_MAYBE(_maybe_type, source.load()))
            expansion.exit(done)
            expansion.close(absent)

            expansion.store(result, _absent)
            expansion.close(done)

            expansion.add(result.load())

            return expansion.result
        si

        to_string() -> string =>
            "wrap-maybe:[{_maybe_type}]({value})"
    si

    // A MAYBE[T] holding `value`.
    class CONSTRUCT_MAYBE: Value is
        type: Type
        value: Value

        init(maybe_type: Type, value: Value) is
            super.init()

            self.type = maybe_type
            self.value = value
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "construct-maybe:[{type}]({value})"
    si
si
