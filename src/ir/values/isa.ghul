namespace IR.Values is
    use Semantic.Types.Type

    class ISA: Value is
        type: Type
        isa_type: Type
        value: Value

        init(
            type: Type,
            isa_type: Type,
            value: Value
        ) is
            super.init()

            self.type = type
            self.isa_type = isa_type
            self.value = value
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "isa:[{isa_type}]({value})"
    si
si
