namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class HAS_VALUE: Value, TypeTyped is
        type: Type

        value: Value

        init(
            value: Value,
            type: Type
        ) is
            super.init()

            self.value = value
            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "has-value:[{type}]({value})"
    si
si
