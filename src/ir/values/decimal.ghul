namespace IR.Values is
    use Semantic.Types.Type

    use Ghul.Pipes

    // Decimal is a built-in type the runtime implements rather than a
    // scalar a target operates on directly, so its operators are values
    // of their own, which a backend lowers to its runtime's decimal
    // support.

    // A built-in arithmetic operator applied to one decimal operand or
    // two.
    class DECIMAL_ARITHMETIC: Value is
        operation: IR.ArithmeticOperation
        operands: Collections.List[Value]
        type: Type

        // Marked before the operator rather than before the operands,
        // which mark their own positions.
        has_location: bool => false

        init(operation: IR.ArithmeticOperation, operands: Collections.List[Value], type: Type) is
            super.init()

            assert operands.count == 1 \/ operands.count == 2 else "decimal arithmetic takes one operand or two"

            self.operation = operation
            self.operands = operands
            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "decimal-arithmetic:{operation}({operands |> join(", ")})"
    si

    // A built-in comparison of two decimals, answering a bool.
    class DECIMAL_COMPARE: Value is
        comparison: IR.Comparison
        left: Value
        right: Value
        type: Type

        // Marked before the comparison rather than before the operands,
        // which mark their own positions.
        has_location: bool => false

        init(comparison: IR.Comparison, left: Value, right: Value, type: Type) is
            super.init()

            self.comparison = comparison
            self.left = left
            self.right = right
            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "decimal-compare:{comparison}({left}, {right})"
    si

    // A conversion between decimal and another numeric type.
    class DECIMAL_CONVERT: Value is
        type: Type
        value: Value

        // The type converted from, as the conversion was chosen for.
        from: Type

        init(type: Type, value: Value, from: Type) is
            super.init()

            self.type = type
            self.value = value
            self.from = from
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "decimal-convert:[{type}]({value})"
    si
si
