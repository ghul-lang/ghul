namespace IR.Values is
    use Semantic.Types.Type

    // The address of `array[index]`, for a `ref` to an array element: a
    // write through it lands in the array, where reading the element and
    // taking the address of the copy would lose it.
    class ARRAY_ELEMENT_ADDRESS: Value is
        _array: Value
        _index: Value
        _element_type: Type

        type: Type
        has_address: bool => true

        init(array: Value, index: Value, element_type: Type, type: Type) is
            super.init()

            _array = array
            _index = index
            _element_type = element_type
            self.type = type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!

            gen(_array, context)
            gen(_index, context)

            body.load_element_address(context.resolve_type_token(_element_type))
        si

        gen_address(context: IR.CONTEXT) is
            gen(context)
        si

        to_string() -> string => "array-element-address:({_array}[{_index}])"
    si
si
