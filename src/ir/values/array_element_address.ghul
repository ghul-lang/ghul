namespace IR.Values is
    use Semantic.Types.Type

    // The address of `array[index]`, for a `ref` to an array element: a
    // write through it lands in the array, where reading the element and
    // taking the address of the copy would lose it.
    class ARRAY_ELEMENT_ADDRESS: Value is
        array: Value
        index: Value
        element_type: Type

        type: Type
        has_address: bool => true

        init(array: Value, index: Value, element_type: Type, type: Type) is
            super.init()

            self.array = array
            self.index = index
            self.element_type = element_type
            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        accept_address(visitor: Visitor) is
            visitor.visit_address(self)
        si

        to_string() -> string => "array-element-address:({array}[{index}])"
    si
si
