namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    // Wraps the creation of a stateless delegate (a zero-capture,
    // ground function literal) so it is built at most once and reused.
    // The first evaluation allocates the delegate and stores it into a
    // static cache field; every later evaluation loads the cached one.
    // Behaviour matches `inner` exactly because the wrapped literal
    // captures nothing and carries no type arguments, so a single
    // instance is interchangeable everywhere it is used.
    class MEMOIZED_DELEGATE: Value, TypeTyped is
        _inner: Value
        _cache_field: Semantic.Symbols.Field
        _type: Type

        type: Type => _type

        inner: Value => _inner

        init(
            inner: Value,
            cache_field: Semantic.Symbols.Field,
            type: Type
        ) is
            super.init()

            _inner = inner
            _cache_field = cache_field
            _type = type
        si

        referenced_function: Semantic.Symbols.Function? => _inner.referenced_function

        // Stay live rather than freezing to a pre-rendered RAW: gen()
        // mints a fresh cache-hoist label per emit site, so a delegate
        // emitted from more than one place gets distinct labels instead
        // of one baked into a RAW and duplicated.
        freeze() -> Value => self

        // The cached delegate, or, the first time, the inner value,
        // cached.
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(_type)
            let result = expansion.temp("memoized", _type)

            expansion.store(result, Load.STATIC_FIELD(_cache_field))

            let cached = expansion.region()

            expansion.exit_if(cached, IR.BRANCH.NZ, result.load())
            expansion.store(result, _inner)
            expansion.add(Store.STATIC_FIELD(_cache_field, result.load()))
            expansion.close(cached)

            expansion.add(result.load())

            return expansion.result
        si

        gen(context: IR.CONTEXT) is
            IR.EXPANSION.gen(expand(), context)
        si

        to_string() -> string =>
            "memoized-delegate:[{_type}]({_inner})"
    si
si
