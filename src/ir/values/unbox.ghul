namespace IR.Values is
    use Semantic.Types.Type

    class UNBOX: Value is
        value: Value
        type: Type? pure => value.type
        is_value_type: bool => true

        // Whether a receiver taken from this unboxed value is the struct
        // inside the box rather than a copy of it, so that writing through
        // the receiver changes the boxed value: the receiver of an accessor
        // that reflection calls on a boxed struct.
        in_place: bool

        init(
            value: Value
        ) is
            super.init()

            self.value = value
        si

        init(
            value: Value,
            in_place: bool
        ) is
            init(value)

            self.in_place = in_place
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "unbox:[{type}]({value})"
    si

si
