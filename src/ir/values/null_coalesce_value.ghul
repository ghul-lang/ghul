namespace IR.Values is
    use Semantic.Types.Type

    // The result of `a ?? b` for a value-type optional `a` —
    // NULLABLE[T] or MAYBE[T]. The receiver is spilled to a local so
    // its address can feed the has_value / value accessor calls: the
    // left operand can be any expression, not just an addressable
    // slot. `b` is evaluated only on the absent path. The presence
    // test and the value extract read the receiver's address from the
    // stack, and the present arm reads the extracted value from it.
    //
    // Built by COMPILE_OPERATORS._visit_null_coalesce.
    class NULL_COALESCE_VALUE: Value is
        receiver: Value
        presence_test: Value
        value_extract: Value
        present_arm: Value
        absent_arm: Value
        _result_type: Type

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(
            receiver: Value,
            presence_test: Value,
            value_extract: Value,
            present_arm: Value,
            absent_arm: Value,
            result_type: Type
        ) is
            super.init()

            self.receiver = receiver
            self.presence_test = presence_test
            self.value_extract = value_extract
            self.present_arm = present_arm
            self.absent_arm = absent_arm
            self._result_type = result_type
        si

        // The receiver is held in a temporary, whose address the
        // presence test and the value extract read.
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)
            let held = expansion.temp("coalesce", receiver.type!)

            expansion.store(held, receiver)

            let result = expansion.temp("coalesced", type)

            let done = expansion.region()
            let absent = expansion.region()

            expansion.exit_if(absent, IR.BRANCH.Z, STEPS([ADDRESS(held.load()), presence_test]:Value))
            expansion.store(result, STEPS([ADDRESS(held.load()), value_extract, present_arm]:Value))
            expansion.exit(done)
            expansion.close(absent)

            expansion.store(result, absent_arm)
            expansion.close(done)

            expansion.add(result.load())

            return expansion.result
        si

        gen(context: IR.CONTEXT) is
            IR.EXPANSION.gen(expand(), context)
        si

        to_string() -> string =>
            "null-coalesce-value:[{type}]({receiver},{absent_arm})"
    si
si
