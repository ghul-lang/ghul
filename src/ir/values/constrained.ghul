namespace IR.Values is
    use Semantic.Types.Type

    class CONSTRAINED: Value is
        value: Value
        _type: Type
        type: Type? pure => _type
        is_value_type: bool => false

        init(
            value: Value,
            type: Type
        ) is
            super.init()

            self._type = type
            self.value = ADDRESS(value, type)
        si

        init(
            value: Value
        ) is
            init(value, value.type!)
        si

        // Lowers to the receiver's address only. The `constrained.`
        // prefix sits immediately before the `callvirt`, after the
        // arguments, so the enclosing instance call emits it.
        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "constrained:[{type}]({value})"
    si
si
