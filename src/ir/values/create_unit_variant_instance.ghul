namespace IR.Values is
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    // Creates a unit variant's single shared instance, and keeps it
    // where every use of the variant reads it from.
    class CREATE_UNIT_VARIANT_INSTANCE: Value is
        variant: Classy
        constructor: Function

        init(variant: Classy, constructor: Function) is
            super.init()

            self.variant = variant
            self.constructor = constructor
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "create-unit-variant-instance({variant})"
    si
si
