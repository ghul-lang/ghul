namespace IR.Values is
    use Ghul.Pipes

    use Semantic.Types.Type

    // Values encoded one after another as a single value, the last
    // leaving the result. A step can consume what the one before it
    // left on the stack, so the steps are only ever straight-line code:
    // no branch falls between them. Part of a composite's expansion, so
    // it marks no source position.
    class STEPS: Value is
        steps: Collections.List[Value]

        type: Type => steps[steps.count - 1].type!
        has_location: bool => false

        init(steps: Collections.List[Value]) is
            super.init()

            assert steps.count > 0 else "steps needs at least one value"

            self.steps = steps
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "steps:({steps |> join("; ")})"
    si
si
