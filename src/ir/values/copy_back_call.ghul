namespace IR.Values is
    use Semantic.Types.Type

    /// A call with a `ref` argument naming a local that lives in a box: the
    /// box holds its value in a property, which has no address, so the
    /// argument is the address of a temporary initialised from it where the
    /// argument is evaluated, and this stores each temporary back into its
    /// box once the call returns, in argument order, before the call's
    /// result is used. A call that throws stores nothing back.
    class COPY_BACK_CALL: Composite is
        /// The call, whose `ref` arguments address the temporaries.
        call: Value

        /// The stores of the temporaries back into their boxes, in
        /// argument order.
        copy_backs: Value[]

        type: Type => call.type!
        is_lightweight_pure: bool => false

        init(call: Value, copy_backs: Value[]) is
            super.init()

            self.call = call
            self.copy_backs = copy_backs
        si

        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)

            if type.is_void then
                expansion.add(call)

                for copy_back in copy_backs do
                    expansion.add(copy_back)
                od
            else
                let result = expansion.temp("copied_back", type)

                expansion.store(result, call)

                for copy_back in copy_backs do
                    expansion.add(copy_back)
                od

                expansion.add(result.load())
            fi

            return expansion.result
        si

        to_string() -> string =>
            "copy-back-call:[{type}]({call},{copy_backs})"
    si

    /// A `ref` argument naming a local that lives in a box, or a field of a
    /// struct it holds: initialises the temporary from the box where the
    /// argument is evaluated, and leaves the address of the temporary, or of
    /// the field within it. COPY_BACK_CALL stores the temporary back.
    class COPY_IN_ADDRESS: Composite is
        /// The temporary the callee writes.
        temporary: IR.LOCAL

        /// The read of the boxed local the temporary starts from.
        initial: Value

        /// What the argument addresses: a load of the temporary, or a
        /// field reached from one.
        addressed: Value

        type: Type
        is_lightweight_pure: bool => false

        init(temporary: IR.LOCAL, initial: Value, addressed: Value, type: Type) is
            super.init()

            self.temporary = temporary
            self.initial = initial
            self.addressed = addressed
            self.type = type
        si

        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)

            expansion.declare(temporary)
            expansion.store(temporary, initial)
            expansion.add(ADDRESS(addressed, type))

            return expansion.result
        si

        to_string() -> string =>
            "copy-in-address:[{type}]({temporary},{initial},{addressed})"
    si
si
