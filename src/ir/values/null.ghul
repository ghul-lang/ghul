namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class NULL: Value, TypeTyped is
        type: Type

        init(
            type: Type
        ) is
            super.init()

            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "null:[{type}]()"
    si
si
