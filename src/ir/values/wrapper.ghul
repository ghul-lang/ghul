namespace IR.Values is
    use Semantic.Types.Type

    class WRAPPER: Value is
        has_address: bool => value!.has_address
        type: Type? pure => value!.type
        value: Value? public

        init(
            value: Value
        ) is
            super.init()

            self.value = value
        si

        init() is
            super.init()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        accept_address(visitor: Visitor) is
            visitor.visit_address(self)
        si

        to_string() -> string =>
            "wrapper:[{if value? then value.type else null fi}]({value})"
    si
si
