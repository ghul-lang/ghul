namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type
    use Semantic.Symbols.Function

    // A function value: `function`, bound to `receiver`, as a value of
    // the function or delegate type `type`. The receiver is a null
    // value for a function that takes none.
    //
    // A virtual one calls whatever overrides `function` on the
    // receiver's run-time type, rather than `function` itself.
    class MAKE_CLOSURE: Value, TypeTyped is
        function: Function
        receiver: Value
        is_virtual: bool
        type: Type

        // Marks nothing itself: the receiver is where the source wrote
        // anything.
        has_location: bool => false

        referenced_function: Function? => function

        init(type: Type, function: Function, receiver: Value, is_virtual: bool) is
            super.init()

            self.type = type
            self.function = function
            self.receiver = receiver
            self.is_virtual = is_virtual
        si

        init(type: Type, function: Function, receiver: Value) is
            self.init(type, function, receiver, false)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "make-closure:[{type}]({receiver},\"{function.name}\")"
    si
si
