namespace IR.Values is
    use Ghul.Pipes

    use Semantic.Types.Type

    // Structured control flow that a BREAK can leave: a body of values
    // followed by an end.
    //
    // The labels belong to the CIL lowering. `position` is the source
    // position current where the node begins and `end_position` the
    // one current where it is closed: the lowering marks them against
    // the labels and branches it adds.
    class Breakable: Value abstract is
        end: IR.LABEL
        body: BLOCK

        position: Source.LOCATION?
        end_position: Source.LOCATION?

        is_closed: bool

        // A position is marked by the lowering, against the values it
        // adds, so the node itself has none to mark.
        has_location: bool => false

        init(end: IR.LABEL, void_type: Type) is
            super.init()

            self.end = end

            position = IoC.CONTAINER.instance.location_stack.current

            body = BLOCK(void_type)
        si

        // Records that the body is complete.
        close() is
            assert !is_closed else "structured node is already closed"

            is_closed = true
            end_position = IoC.CONTAINER.instance.location_stack.current
        si

        gen(context: IR.CONTEXT) is
            assert is_closed else "structured node generated before it was closed"

            IR.STRUCTURED_LOWERING.gen(self, context)
        si
    si

    // A sequence of values that a BREAK can leave early, continuing
    // after its end.
    class REGION: Breakable is
        init(end: IR.LABEL, void_type: Type) is
            super.init(end, void_type)
        si

        to_string() -> string => "region {end}:[{body}]"
    si

    // A loop: the body repeats until a BREAK leaves it. A CONTINUE,
    // and reaching the end of the body, both go round again. The CIL
    // lowering places `start` before the body and `end` after the
    // branch back to `start`.
    class LOOP: Breakable is
        start: IR.LABEL

        init(start: IR.LABEL, end: IR.LABEL, void_type: Type) is
            super.init(end, void_type)

            self.start = start
        si

        to_string() -> string => "loop {start}:[{body}]"
    si

    // An exit from an enclosing structured node, taken when
    // `condition` holds of `operands`, or always where the condition
    // is ALWAYS.
    //
    // `via_leave` says an unconditional exit is lowered to CIL as
    // `leave` rather than `br`, because it is made inside a try, catch
    // or finally. Try regions are not structured nodes, so the lowering
    // cannot see them, and generate-il decides this where it makes the
    // exit.
    class Exit: Value abstract is
        target: Breakable
        condition: IR.BRANCH
        operands: Collections.List[Value]
        via_leave: bool

        position: Source.LOCATION?

        has_location: bool => false

        init(target: Breakable, condition: IR.BRANCH, operands: Collections.List[Value], via_leave: bool) is
            super.init()

            assert (condition == IR.BRANCH.ALWAYS) == (operands.count == 0) else "an exit takes operands exactly when it is conditional"
            assert operands.count <= 2 else "an exit compares at most two operands"

            self.target = target
            self.condition = condition
            self.operands = operands
            self.via_leave = via_leave

            position = IoC.CONTAINER.instance.location_stack.current
        si

        gen(context: IR.CONTEXT) is
            IR.STRUCTURED_LOWERING.gen(self, context)
        si

        operands_of(operand: Value) -> Collections.List[Value] static is
            let result = Collections.LIST[Value]()

            result.add(operand)

            return result
        si

        operands_of(left: Value, right: Value) -> Collections.List[Value] static is
            let result = Collections.LIST[Value]()

            result.add(left)
            result.add(right)

            return result
        si
    si

    // Leaves `target`, continuing after its end.
    class BREAK: Exit is
        init(target: Breakable, via_leave: bool) is
            super.init(target, IR.BRANCH.ALWAYS, Collections.LIST[Value](), via_leave)
        si

        init(target: Breakable, condition: IR.BRANCH, operands: Collections.List[Value]) is
            super.init(target, condition, operands, false)
        si

        init(target: Breakable, condition: IR.BRANCH, operand: Value) is
            super.init(target, condition, operands_of(operand), false)
        si

        init(target: Breakable, condition: IR.BRANCH, left: Value, right: Value) is
            super.init(target, condition, operands_of(left, right), false)
        si

        to_string() -> string => "break {target.end} {condition}({operands |> join(", ")})"
    si

    // Starts `loop`'s next iteration.
    class CONTINUE: Exit is
        loop: LOOP

        init(loop: LOOP, via_leave: bool) is
            super.init(loop, IR.BRANCH.ALWAYS, Collections.LIST[Value](), via_leave)

            self.loop = loop
        si

        init(loop: LOOP, condition: IR.BRANCH, operands: Collections.List[Value]) is
            super.init(loop, condition, operands, false)

            self.loop = loop
        si

        init(loop: LOOP, condition: IR.BRANCH, operand: Value) is
            super.init(loop, condition, operands_of(operand), false)

            self.loop = loop
        si

        init(loop: LOOP, condition: IR.BRANCH, left: Value, right: Value) is
            super.init(loop, condition, operands_of(left, right), false)

            self.loop = loop
        si

        to_string() -> string => "continue {loop.start} {condition}({operands |> join(", ")})"
    si
si
