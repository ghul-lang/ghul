namespace IR.Values is
    use Semantic.Types.Type
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    // Operations the bodies the lowering synthesises need, which no
    // symbol in the compilation names.

    // Runs the root object constructor on a newly allocated instance,
    // as a constructor must before it stores anything.
    class INIT_OBJECT: Value is
        instance: Value

        init(instance: Value) is
            super.init()

            self.instance = instance
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "init-object({instance})"
    si

    // The id of the thread the code is running on.
    class CURRENT_THREAD_ID: Value is
        type: Type

        init(type: Type) is
            super.init()

            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "current-thread-id"
    si

    // Renders the elements of a pipe as a string, as every pipe's
    // to_string does.
    class JOIN_PIPE: Value is
        pipe: Value
        element_type: Type

        init(pipe: Value, element_type: Type) is
            super.init()

            self.pipe = pipe
            self.element_type = element_type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "join-pipe:[{element_type}]({pipe})"
    si

    // Creates a unit variant's single shared instance, and keeps it
    // where every use of the variant reads it from.
    class CREATE_UNIT_VARIANT_INSTANCE: Value is
        variant: Classy
        constructor: Function

        init(variant: Classy, constructor: Function) is
            super.init()

            self.variant = variant
            self.constructor = constructor
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "create-unit-variant-instance({variant})"
    si
si
