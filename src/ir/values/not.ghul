namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class NOT: Value is
        value: Value

        type: Type? pure => value.type
        is_value_type: bool => value.is_value_type

        // An operator marks its operand's position and then its own,
        // before the negation, rather than its own before the operand.
        has_location: bool => !is_operator /\ super.has_location

        is_operator: bool

        init(value: Value) is
            super.init()

            self.value = value
        si

        // The negation written as an operator in source.
        operator(value: Value) -> NOT static is
            let result = NOT(value)

            result.is_operator = true

            return result
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

            to_string() -> string =>
                "not:[{type}]({value})"
            si
si
