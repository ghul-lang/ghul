namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class NOT: Value is
        value: Value

        type: Type? pure => value.type
        is_value_type: bool => value.is_value_type

        // An operator marks its operand's position and then its own,
        // before the negation, rather than its own before the operand.
        has_location: bool => !_is_operator /\ super.has_location

        _is_operator: bool

        init(value: Value) is
            super.init()

            self.value = value
        si

        // The negation written as an operator in source.
        operator(value: Value) -> NOT static is
            let result = NOT(value)

            result._is_operator = true

            return result
        si

        gen(context: IR.CONTEXT) is
            if _is_operator then
                gen_marked(value, context)
                mark_operator(context)
            else
                Value.gen(value, context)
            fi

            let body = context.current_srm_body_emitter!
                body.ldc_i4(0)
                body.op(System.Reflection.Metadata.ILOpCode.CEQ)
        si

            to_string() -> string =>
                "not:[{type}]({value})"
            si
si
