namespace IR.Values is
    use Semantic.Types.Type

    // An int operand, or zero where it is negative, on the stack. A range
    // whose end precedes its start yields no elements, and a fused
    // collect sized at its `to - from` must allocate nothing rather than
    // ask for a negative length.
    class INT_MAX_ZERO: Value is
        _operand: Value

        type: Type

        init(operand: Value, type: Type) is
            super.init()

            _operand = operand
            self.type = type
        si

        // operand, or zero where the operand is negative
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)
            let result = expansion.temp("max_zero", type)

            expansion.store(result, _operand)

            let non_negative = expansion.region()

            expansion.exit_if(non_negative, IR.BRANCH.GE, result.load(), Literal.NUMBER(0, type))
            expansion.store(result, Literal.NUMBER(0, type))
            expansion.close(non_negative)

            expansion.add(result.load())

            return expansion.result
        si

        gen(context: IR.CONTEXT) is
            IR.EXPANSION.gen(expand(), context)
        si

        to_string() -> string => "int-max-zero:({_operand})"
    si
si
