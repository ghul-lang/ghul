namespace IR.Values is
    use Semantic.Types.Type

    class ENTER_FILE: Value is
        path: string

        init(
            path: string
        ) is
            super.init()

            self.path = path
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "enter-file:({path})"
    si

    class LEAVE_FILE: Value is
        path: string

        init(
            path: string
        ) is
            super.init()

            self.path = path
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "exit-file"
    si
si
