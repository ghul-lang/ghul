namespace IR.Values is
    use Semantic.Types.Type

    // A built-in conversion of a scalar to another scalar kind. `from`
    // is the kind converted from, or null where the source is not a
    // scalar (an enum).
    class CONVERT: Value is
        type: Type
        value: Value
        from: IR.Scalar?
        to: IR.Scalar

        init(
            type: Type,
            value: Value,
            from: IR.Scalar?,
            to: IR.Scalar
        ) is
            super.init()

            self.type = type
            self.value = value
            self.from = from
            self.to = to
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "cast:[{type}]({value})"
    si
si
