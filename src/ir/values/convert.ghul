namespace IR.Values is
    use Semantic.Types.Type

    // A built-in conversion of a scalar to another scalar kind. `from`
    // is the kind converted from, or null where the source is not a
    // scalar (an enum).
    class CONVERT: Value is
        type: Type
        value: Value
        from: IR.Scalar?
        to: IR.Scalar

        init(
            type: Type,
            value: Value,
            from: IR.Scalar?,
            to: IR.Scalar
        ) is
            super.init()

            self.type = type
            self.value = value
            self.from = from
            self.to = to
        si

        gen(context: IR.CONTEXT) is
            gen(value, context)

            let body = context.current_srm_body_emitter!

            for op_code in IR.Emitter.CIL_OPERATIONS.conversion(from, to) do
                body.op(op_code)
            od
        si

        to_string() -> string =>
            "cast:[{type}]({value})"
    si
si
