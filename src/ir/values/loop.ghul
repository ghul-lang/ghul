namespace IR.Values is
    use Ghul.Pipes

    use Semantic.Types.Type

    // A loop as structured control flow: the body repeats until a
    // BREAK leaves it. A CONTINUE, and reaching the end of the body,
    // both go round again.
    //
    // The labels belong to the CIL lowering, which places `start`
    // before the body and `end` after the branch back to `start`.
    // `position` is the source position current where the loop begins
    // and `end_position` the one current where it is closed: the
    // lowering marks them against the labels and branch it adds.
    class LOOP: Value is
        start: IR.LABEL
        end: IR.LABEL
        body: BLOCK

        position: Source.LOCATION?
        end_position: Source.LOCATION?

        is_closed: bool

        // A position is marked by the lowering, against the values it
        // adds, so the loop itself has none to mark.
        has_location: bool => false

        init(start: IR.LABEL, end: IR.LABEL, void_type: Type) is
            super.init()

            self.start = start
            self.end = end

            position = IoC.CONTAINER.instance.location_stack.current

            body = BLOCK(void_type)
        si

        // Records that the body is complete.
        close() is
            assert !is_closed else "loop is already closed"

            is_closed = true
            end_position = IoC.CONTAINER.instance.location_stack.current
        si

        gen(context: IR.CONTEXT) is
            assert is_closed else "loop generated before it was closed"

            IR.STRUCTURED_LOWERING.gen(self, context)
        si

        to_string() -> string => "loop {start}:[{body}]"
    si

    // An exit from an enclosing LOOP, taken when `condition` holds of
    // `operands`, or always where the condition is ALWAYS.
    //
    // `within_protected_region` says the exit is written somewhere
    // inside a try, catch or finally, where an unconditional exit is
    // lowered to CIL as `leave` rather than `br`. Try regions are not
    // structured nodes, so the lowering cannot see them, and the exit
    // records this itself.
    class LoopExit: Value abstract is
        loop: LOOP
        condition: IR.BRANCH
        operands: Collections.List[Value]
        within_protected_region: bool

        position: Source.LOCATION?

        has_location: bool => false

        init(loop: LOOP, condition: IR.BRANCH, operands: Collections.List[Value], within_protected_region: bool) is
            super.init()

            assert (condition == IR.BRANCH.ALWAYS) == (operands.count == 0) else "a loop exit takes operands exactly when it is conditional"
            assert operands.count <= 2 else "a loop exit compares at most two operands"

            self.loop = loop
            self.condition = condition
            self.operands = operands
            self.within_protected_region = within_protected_region

            position = IoC.CONTAINER.instance.location_stack.current
        si

        gen(context: IR.CONTEXT) is
            IR.STRUCTURED_LOWERING.gen(self, context)
        si

        operands_of(operand: Value) -> Collections.List[Value] static is
            let result = Collections.LIST[Value]()

            result.add(operand)

            return result
        si

        operands_of(left: Value, right: Value) -> Collections.List[Value] static is
            let result = Collections.LIST[Value]()

            result.add(left)
            result.add(right)

            return result
        si
    si

    // Leaves `loop`.
    class BREAK: LoopExit is
        init(loop: LOOP, within_protected_region: bool) is
            super.init(loop, IR.BRANCH.ALWAYS, Collections.LIST[Value](), within_protected_region)
        si

        init(loop: LOOP, condition: IR.BRANCH, operands: Collections.List[Value]) is
            super.init(loop, condition, operands, false)
        si

        init(loop: LOOP, condition: IR.BRANCH, operand: Value) is
            super.init(loop, condition, operands_of(operand), false)
        si

        init(loop: LOOP, condition: IR.BRANCH, left: Value, right: Value) is
            super.init(loop, condition, operands_of(left, right), false)
        si

        to_string() -> string => "break {loop.start} {condition}({operands |> join(", ")})"
    si

    // Starts `loop`'s next iteration.
    class CONTINUE: LoopExit is
        init(loop: LOOP, within_protected_region: bool) is
            super.init(loop, IR.BRANCH.ALWAYS, Collections.LIST[Value](), within_protected_region)
        si

        init(loop: LOOP, condition: IR.BRANCH, operands: Collections.List[Value]) is
            super.init(loop, condition, operands, false)
        si

        init(loop: LOOP, condition: IR.BRANCH, operand: Value) is
            super.init(loop, condition, operands_of(operand), false)
        si

        init(loop: LOOP, condition: IR.BRANCH, left: Value, right: Value) is
            super.init(loop, condition, operands_of(left, right), false)
        si

        to_string() -> string => "continue {loop.start} {condition}({operands |> join(", ")})"
    si
si
