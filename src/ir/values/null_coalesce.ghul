namespace IR.Values is
    use Semantic.Types.Type

    // The result of `a ?? b` for a reference-typed `a: T?`. `T?` is a
    // reference that may be null, so a null test is enough — `b` is
    // evaluated only when `a` is null.
    //
    // Built by COMPILE_OPERATORS.visit_binary when the operator is `??`.
    // The two operands are evaluated by their own Values; this Value
    // composes the surrounding short-circuit shell.
    class NULL_COALESCE: Value is
        left: Value
        right: Value
        _result_type: Type

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(left: Value, right: Value, result_type: Type) is
            super.init()

            self.left = left
            self.right = right
            self._result_type = result_type
        si

        // `a` where it is present, and `b` only where it is not.
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)
            let result = expansion.temp("coalesce", type)

            expansion.store(result, left)

            let done = expansion.region()
            let absent = expansion.region()

            expansion.exit_if(absent, IR.BRANCH.Z, result.load())
            expansion.exit(done)
            expansion.close(absent)

            expansion.store(result, right)
            expansion.close(done)

            expansion.add(result.load())

            return expansion.result
        si

        gen(context: IR.CONTEXT) is
            IR.EXPANSION.gen(expand(), context)
        si

        to_string() -> string =>
            "null-coalesce:[{type}]({left},{right})"
    si
si
