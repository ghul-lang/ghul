namespace IR.Values is
    use System.Reflection.Metadata.ILOpCode
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class COMPARE_ORDER_TO_ZERO: Value, TypeTyped is
        value: Value
        actual_operation: string?
        type: Type

        is_value_type: bool => true

        init(value: Value, actual_operation: string?, type: Type) is
            super.init()

            self.value = value
            self.actual_operation = actual_operation
            self.type = type
        si

        // The comparison against zero the operator makes. `==` reads
        // an order value as an equality test - used by `case` when it
        // falls back to a scrutinee's `<>` in place of a missing `=~`
        // (see CASE_MATCH_OPERAND_RESOLVER).
        comparison: IR.Comparison =>
            if actual_operation =~ ">" then
                IR.Comparison.GREATER
            elif actual_operation =~ ">=" then
                IR.Comparison.GREATER_OR_EQUAL
            elif actual_operation =~ "<" then
                IR.Comparison.LESS
            elif actual_operation =~ "<=" then
                IR.Comparison.LESS_OR_EQUAL
            elif actual_operation =~ "==" then
                IR.Comparison.EQUAL
            else
                throw System.Exception("unexpected compare order operation: {actual_operation}")
            fi

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "compare-order-to-zero[{actual_operation}]({value})"
    si
si
