namespace IR.Values.Call is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class INSTANCE: Value, TypeTyped is
        is_state_changing_call: bool => !function.is_store_free
        is_receiver_interior_call: bool => function.writes_only_receiver_interior
        from: Value
        function: Semantic.Symbols.Function
        arguments: Collections.List[Value]
        type: Type

        init(from: Value, function: Semantic.Symbols.Function, arguments: Collections.List[Value], type: Type?) is
            super.init()

            self.from = from
            self.function = function
            self.arguments = arguments

            if type? then
                self.type = type
            else
                self.type = function.return_type!
            fi

        si

        // Decided when the call is lowered rather than when it is built:
        // whether the function can be overridden is not settled until
        // the inheritance passes have run.
        dispatch: IR.Dispatch =>
            if isa CONSTRAINED(from) then
                IR.Dispatch.CONSTRAINED
            elif from.is_super \/ !function.is_virtual then
                IR.Dispatch.DIRECT
            elif let owner: Semantic.Symbols.Classy = function.owner /\ owner.is_trait then
                IR.Dispatch.INTERFACE
            else
                IR.Dispatch.VIRTUAL
            fi

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "instance-call:[{type}]({from},\"{function.name}\",{arguments})"
    si

si
