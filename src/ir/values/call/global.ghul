namespace IR.Values.Call is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    /// A call to a function that is neither an instance nor a static member:
    /// a global function, or a function generated in its place.
    class GLOBAL: Value, TypeTyped is
        /// Whether the call can change state, judged from the function the
        /// source wrote.
        is_state_changing_call: bool => !written_function.is_store_free

        /// The function called. After `retarget`, the function code is
        /// generated against, which can differ from `written_function`.
        function: Semantic.Symbols.Function

        /// The arguments passed. After `retarget`, the ones code is
        /// generated against, which can differ from `written_arguments`.
        arguments: Value[]

        /// The call's type.
        type: Type

        /// A call to `function` with `arguments`.
        ///
        /// - function: the function called
        /// - arguments: the arguments passed
        /// - type: the call's type, or null for the function's return type
        init(function: Semantic.Symbols.Function, arguments: Value[], type: Type?) is
            super.init()

            self.function = function
            self.arguments = arguments

            if type? then
                self.type = type
            else
                self.type = function.return_type!
            fi

        si

        /// Point the call at another function with other arguments, keeping
        /// its type. A value built into the IR around the call keeps its
        /// reference, so this is how a call already composed into its parent
        /// is generated differently once the parent has compiled. `function`
        /// and `arguments` answer the new target from then on; the first
        /// target the call had stays readable as `written_function` and
        /// `written_arguments`.
        ///
        /// - function: the function the call now calls
        /// - arguments: the arguments it now passes
        retarget(function: Semantic.Symbols.Function, arguments: Value[]) is
            if !_written_function? then
                _written_function = self.function
                _written_arguments = self.arguments
            fi

            self.function = function
            self.arguments = arguments
        si

        /// The function the source wrote: `function`, unless the call was
        /// retargeted. What judges the call as written reads this - whether a
        /// pure slot was given a pure function, or what the call can change.
        written_function: Semantic.Symbols.Function => _written_function ?? function

        /// The arguments the source wrote: `arguments`, unless the call was
        /// retargeted.
        written_arguments: Value[] => _written_arguments ?? arguments

        _written_function: Semantic.Symbols.Function?
        _written_arguments: Value[]?

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "global-call:[{type}](\"{function.name}\",{arguments})"
    si
si
