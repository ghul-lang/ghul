namespace IR.Values.Call is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class GLOBAL: Value, TypeTyped is
        is_state_changing_call: bool => !function.is_store_free
        function: Semantic.Symbols.Function
        arguments: Collections.List[Value]
        type: Type

        init(function: Semantic.Symbols.Function, arguments: Collections.List[Value], type: Type?) is
            super.init()

            self.function = function
            self.arguments = arguments

            if type? then
                self.type = type
            else
                self.type = function.return_type!
            fi

        si

        // Point the call at another function with other arguments. A
        // value built into the IR around it keeps its reference, so this
        // is how a call already composed into its parent is lowered
        // differently once its parent has compiled. The type is kept.
        retarget(function: Semantic.Symbols.Function, arguments: Collections.List[Value]) is
            self.function = function
            self.arguments = arguments
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "global-call:[{type}](\"{function.name}\",{arguments})"
    si
si
