namespace IR.Values.Call is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class STATIC: Value, TypeTyped is
        is_state_changing_call: bool => !function.is_store_free
        function: Semantic.Symbols.Function
        arguments: Value[]
        type: Type

        // The type a static interface member is dispatched through,
        // when it needs the CLR's `constrained.` prefix; null
        // otherwise. A bound type parameter where the call is generic,
        // and the concrete type where the interface is instantiated at
        // one.
        constrained_receiver: Type?

        // Temporaries a target's lowering of this call declares, made the
        // first time it is lowered and named again by every later lowering,
        // since a target that decides which locals live in cells while it
        // discovers the program looks them up again when it emits it.
        lowered_temporaries: IR.LOCAL[]? public

        init(function: Semantic.Symbols.Function, arguments: Value[], type: Type?, constrained_receiver: Type?) is
            super.init()

            self.function = function
            self.arguments = arguments
            self.constrained_receiver = constrained_receiver

            if type? then
                self.type = type
            else
                self.type = function.return_type!
            fi
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "static-call:[{type}](\"{function.name}\",{arguments})"
    si
si
