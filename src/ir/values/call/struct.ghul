namespace IR.Values.Call is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class STRUCT: Value, TypeTyped is
        is_state_changing_call: bool => !function.is_store_free
        /// The struct value, or its address, the method is called on.
        from: Value public
        function: Semantic.Symbols.Function
        arguments: Value[]
        type: Type

        init(from: Value, function: Semantic.Symbols.Function, arguments: Value[], type: Type?) is
            super.init()

            self.from = from
            self.function = function
            self.arguments = arguments

            if type? then
                self.type = type
            else
                self.type = function.return_type!
            fi
        si

        replace_operand(old: Value, replacement: Value) -> bool is
            if from == old then
                from = replacement
                return true
            fi

            if from.replace_operand(old, replacement) then
                return true
            fi

            for i in 0..arguments.count do
                if arguments[i] == old then
                    arguments = Value.with_replaced(arguments, i, replacement)
                    return true
                fi
            od

            for operand in arguments do
                if operand.replace_operand(old, replacement) then
                    return true
                fi
            od

            return false
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "struct-call:[{type}]({from},\"{function.name}\",{arguments})"
    si
si
