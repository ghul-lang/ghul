namespace IR.Values.Load is
    // An argument of the method being emitted, named by the slot it
    // occupies rather than by a symbol.
    //
    // The state-machine lowering forwards its enclosing method's own
    // arguments into a frame constructor, where what is wanted is
    // positional: the receiver when the method has one, then each
    // declared argument in order. There is no symbol to resolve,
    // because the argument being loaded belongs to the method the
    // lowering is rewriting rather than to anything it declares.
    class ARGUMENT_SLOT: Value is
        _index: int
        _il_name: string
        _type: Semantic.Types.Type?

        // Absent for a slot forwarded untouched; present where the
        // value is consumed by something that reads its operand types.
        type: Semantic.Types.Type? pure => _type

        // `il_name` names the argument the slot loads — the receiver,
        // or a declared argument by name — alongside the index the
        // instruction is actually encoded from.
        init(index: int, il_name: string) is
            super.init()

            _index = index
            _il_name = il_name
        si

        init(index: int, il_name: string, type: Semantic.Types.Type) is
            init(index, il_name)

            _type = type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.ldarg(_index)
        si

        to_string() -> string => "load-argument-slot:({_index})"
    si
si
