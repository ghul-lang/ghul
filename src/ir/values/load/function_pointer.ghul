namespace IR.Values.Load is
    use IO.Std

    use System.NotImplementedException
    use System.Text.StringBuilder

    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type
    use SymbolBase = Semantic.Symbols.Symbol

    // The cast to the symbol's expected kind is a checked construction
    // invariant: the caller only ever builds this value with a symbol of
    // that kind, so a throw here means the invariant broke elsewhere.
    @suppress("cast-may-throw")
    class FUNCTION_POINTER: SYMBOL, TypeTyped is
        has_address: bool => false
        is_consumable: bool => true

        // True when this pointer must dispatch virtually - a real
        // override could sit behind the statically-known symbol at
        // the receiver's runtime type, and a plain `ldftn` always
        // captures the statically-resolved implementation. Only ever
        // true for a function reference bound to a live receiver
        // (FUNCTION_REFERENCE_RESOLVER); a closure's own synthesized
        // method is never virtual, so every other caller passes false.
        is_virtual: bool
        is_virtual_dispatch: bool => is_virtual

        init(symbol: Semantic.Symbols.Symbol) is
            init(symbol, false)
        si

        init(symbol: Semantic.Symbols.Symbol, is_virtual: bool) is
            super.init(null, symbol)

            self.is_virtual = is_virtual
        si

        referenced_function: Semantic.Symbols.Function? =>
            cast Semantic.Symbols.Function?(symbol)

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "function:[{type}](\"{symbol.name}\")"
    si
si
