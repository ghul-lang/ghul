namespace IR.Values.Load is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    // A load of a local, typed as the local unless given a type of its
    // own.
    class TEMP: Value, TypeTyped is
        local: IR.LOCAL

        type: Type

        has_address: bool => true
        is_lightweight_pure: bool => true

        init(local: IR.LOCAL) is
            self.init(local, local.type)
        si

        init(local: IR.LOCAL, type: Type) is
            self.local = local
            self.type = type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.ldloc(local)
        si

        gen_address(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.ldloca(local)
        si

        to_string() -> string =>
            "load:[{type}]({local})"
    si
si
