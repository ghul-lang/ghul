namespace IR.Values.Load is
    use TypeTyped = Semantic.Types.Typed
    use SymbolBase = Semantic.Symbols.Symbol

    class LOCAL_VARIABLE: SYMBOL, TypeTyped is
        is_consumable: bool => true
        is_lightweight_pure: bool => true

        init(symbol: SymbolBase) is
            super.init(null, symbol)
        si

        gen(context: IR.CONTEXT) is
            // Generator-function locals: the CLR-local slot doesn't
            // exist inside MoveNext, so the load is redirected to
            // the field on the state-machine frame. See the matching
            // Load.LOCAL_ARGUMENT for the rationale.
            if let state_machine_field = IR.Values.state_machine_field_for(symbol) then
                let body = context.current_srm_body_emitter!
                    body.ldarg(0)
                    body.ldfld(context.resolve_field_target(state_machine_field))

                guard_complement_narrow(context)

                return
            fi

            let body = context.current_srm_body_emitter!
                body.ldloc((cast Semantic.Symbols.Variable(symbol)).ir_local)

            guard_complement_narrow(context)
        si

        gen_address(context: IR.CONTEXT) is
            if let state_machine_field = IR.Values.state_machine_field_for(symbol) then
                let body = context.current_srm_body_emitter!
                    body.ldarg(0)
                    body.ldflda(context.resolve_field_target(state_machine_field))

                return
            fi

            let body = context.current_srm_body_emitter!
                body.ldloca((cast Semantic.Symbols.Variable(symbol)).ir_local)
        si

        to_string() -> string =>
            "load:[{type}]({from},\"{symbol.name}\")"
    si
si
