namespace IR.Values.Load is
    use Semantic.Types.Type
    use Semantic.Symbols.Function

    // An argument of a function, named by its position among the
    // arguments the function declares rather than by a symbol.
    //
    // The state-machine lowering forwards its enclosing method's own
    // arguments into a frame constructor, where what is wanted is
    // positional. There is no symbol to resolve, because the argument
    // being loaded belongs to the method the lowering is rewriting
    // rather than to anything it declares.
    class ARGUMENT: Value is
        function: Function
        index: int

        type: Type? =>
            if index < function.arguments.count then
                function.arguments[index]
            else
                null
            fi

        init(function: Function, index: int) is
            super.init()

            self.function = function
            self.index = index
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "load-argument:({function.name}, {index})"
    si

    // The receiver of a function that has one: the instance a method
    // was called on, or the frame a closure runs in.
    class RECEIVER: Value is
        function: Function

        init(function: Function) is
            super.init()

            self.function = function
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "load-receiver:({function.name})"
    si
si
