namespace IR.Values is
    use Source.LOCATION

    use Semantic.Types.Type

    // The operand of a runtime type test, as the object reference the
    // test examines. A value type is boxed: boxing a
    // `Nullable<T>` already yields null or the boxed payload. A `MAYBE[T]`
    // does not box that way - the box would hold the carrier rather than
    // its payload - so it is unwrapped first, giving null when absent. A
    // type variable is boxed through its own token, which leaves a
    // reference alone.
    enum TypeTestOperandMode is
        AS_IS,
        BOX,
        BOX_TYPE_VARIABLE,
        UNWRAP_MAYBE
    si

    class TYPE_TEST_OPERAND is
        init() is si

        mode(value: Value) -> TypeTestOperandMode static =>
            if isa Semantic.Types.MAYBE(value.type) then
                TypeTestOperandMode.UNWRAP_MAYBE
            elif value.is_value_type then
                TypeTestOperandMode.BOX
            elif value.type?.type_variable_side? then
                TypeTestOperandMode.BOX_TYPE_VARIABLE
            else
                TypeTestOperandMode.AS_IS
            fi

        // The operand a runtime type test examines, as an object
        // reference.
        operand(value: Value) -> Value static =>
            case mode(value)
            when TypeTestOperandMode.UNWRAP_MAYBE then
                MAYBE_PAYLOAD(value, cast Semantic.Types.MAYBE(value.type))
            when TypeTestOperandMode.BOX then
                BOX(value)
            when TypeTestOperandMode.BOX_TYPE_VARIABLE then
                BOX(value, value.type!.type_variable_side!)
            else
                value
            esac

        // The payload of a MAYBE operand, boxed, or null where it holds
        // nothing.
        expand_maybe(value: Value, maybe: Semantic.Types.MAYBE) -> BLOCK static is
            let loader = IoC.CONTAINER.instance.symbol_loader
            let object_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_object_type()
            let address = STACK_TOP_ADDRESS(maybe)

            let has_value = maybe.find_member("has_value")!.load(LOCATION.internal, address, loader)
            let payload = maybe.find_member("value")!.load(LOCATION.internal, address, loader)

            let expansion = IR.EXPANSION(object_type)
            let held = expansion.temp("type_test", maybe)

            expansion.store(held, value)

            let result = expansion.temp("type_test.boxed", object_type)

            let done = expansion.region()
            let absent = expansion.region()

            expansion.exit_if(absent, IR.BRANCH.Z, STEPS([ADDRESS(held.load()), has_value]:Value))
            expansion.store(result, BOX(STEPS([ADDRESS(held.load()), payload]:Value)))
            expansion.exit(done)
            expansion.close(absent)

            expansion.store(result, NULL(object_type))
            expansion.close(done)

            expansion.add(result.load())

            return expansion.result
        si
    si

    // The payload a MAYBE holds, boxed, or null where it holds nothing.
    class MAYBE_PAYLOAD: Composite is
        value: Value
        maybe: Semantic.Types.MAYBE
        type: Type

        init(value: Value, maybe: Semantic.Types.MAYBE) is
            super.init()

            self.value = value
            self.maybe = maybe
            type = IoC.CONTAINER.instance.innate_symbol_lookup.get_object_type()
        si

        expand() -> BLOCK => TYPE_TEST_OPERAND.expand_maybe(value, maybe)

        to_string() -> string => "maybe-payload({value})"
    si
si
