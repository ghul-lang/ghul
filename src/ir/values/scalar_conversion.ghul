namespace IR.Values is
    use Semantic.Types.Type

    // A scalar constructed from another scalar, as `double(n)` is: the
    // conversion `cast` to the same type produces, marked as one so the
    // effects analysis treats it exactly as it treats that cast rather
    // than as a call to whatever conversion operator it lowers to.
    class SCALAR_CONVERSION: Value is
        converted: Value

        has_address: bool => converted.has_address
        type: Type? pure => converted.type

        init(converted: Value) is
            super.init()

            self.converted = converted
        si

        gen(context: IR.CONTEXT) is
            gen(converted, context)
        si

        to_string() -> string =>
            "scalar-conversion({converted})"
    si
si
