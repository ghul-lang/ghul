namespace IR.Values is
    use Semantic.Types.Type

    // Declares one CLR local.
    //
    // A body header points at a StandAloneSig listing the local types
    // in slot order, and every load and store addresses a slot by
    // index, so a declaration has to reach the emitter as data rather
    // than as anything textual.
    //
    // Being in the block gets the ordering right for free: a
    // declaration is emitted before the loads that follow it, so the
    // slot exists by the time one is encoded.
    class DECLARE_LOCAL: Value is
        name: string
        type: Type

        init(name: string, type: Type) is
            super.init()

            self.name = name
            self.type = type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.declare_local(name, type)
        si

        to_string() -> string => "declare-local:[{type}]({name})"
    si

    // Stores the top of the stack into a named local. The counterpart
    // of DECLARE_LOCAL, and raw text for the same reason.
    class STORE_TEMP: Value is
        name: string
        type: Type

        init(name: string, type: Type) is
            super.init()

            self.name = name
            self.type = type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.stloc(name)
        si

        to_string() -> string => "store-temp:[{type}]({name})"
    si

    // Stores `value` in a local and also leaves it as this value's
    // result.
    class TEE_TEMP: Value is
        name: string
        value: Value

        type: Type? pure => value.type

        has_location: bool => false

        init(name: string, value: Value) is
            super.init()

            self.name = name
            self.value = value
        si

        gen(context: IR.CONTEXT) is
            gen_marked(value, context)
            mark_operator(context)

            let body = context.current_srm_body_emitter!

            body.op(System.Reflection.Metadata.ILOpCode.DUP)
            body.stloc(name)
        si

        to_string() -> string => "tee-temp:[{type}]({name}, {value})"
    si

    // Evaluates `value` for its effects and discards its result, or,
    // with no value, discards the result an earlier value left: the
    // exception a catch handler starts with, or a value a join leaves
    // where nothing consumes it.
    class DISCARD: Value is
        value: Value?

        has_location: bool => false

        init() is
            super.init()
        si

        init(value: Value) is
            super.init()

            self.value = value
        si

        gen(context: IR.CONTEXT) is
            if let v = value then
                gen_marked(v, context)
            fi

            mark_operator(context)

            context.current_srm_body_emitter!.op(System.Reflection.Metadata.ILOpCode.POP)
        si

        to_string() -> string => "discard({value})"
    si

    // Throws `exception`, or, with no value, the exception an earlier
    // value left.
    class THROW: Value is
        exception: Value?

        has_location: bool => false

        init() is
            super.init()
        si

        init(exception: Value) is
            super.init()

            self.exception = exception
        si

        gen(context: IR.CONTEXT) is
            if let e = exception then
                gen_marked(e, context)
            fi

            mark_operator(context)

            context.current_srm_body_emitter!.op(System.Reflection.Metadata.ILOpCode.THROW)
        si

        to_string() -> string => "throw({exception})"
    si

    // Returns from the enclosing method. A value for the same reason
    // as DECLARE_LOCAL: silently dropping an instruction produces a
    // body that fails verification with nothing to point at.
    class RET: Value is
        init() is
            super.init()
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.ret()
        si

        to_string() -> string => "ret"
    si

    // The value a non-void function falls out of the bottom with: a
    // fresh local of the return type, never assigned, loaded so the
    // trailing `ret` has something to return. The local is anonymous
    // and used once, so it is declared and loaded together rather than
    // through the usual declare-then-load pair.
    class DEFAULT_RETURN: Value is
        type: Type

        init(type: Type) is
            super.init()

            self.type = type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.declare_local(".default", type)
                body.ldloc(".default")
        si

        to_string() -> string => "default-return:[{type}]()"
    si
si
