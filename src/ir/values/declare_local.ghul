namespace IR.Values is
    use Semantic.Types.Type

    // Declares a local.
    //
    // Being in the block gets the ordering right for free: a
    // declaration is emitted before the loads that follow it, so the
    // local has a slot by the time one is encoded.
    class DECLARE_LOCAL: Value is
        local: IR.LOCAL

        type: Type => local.type

        init(local: IR.LOCAL) is
            super.init()

            self.local = local
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "declare-local:[{type}]({local})"
    si

    // Stores the result an earlier value left into a local.
    class STORE_TEMP: Value is
        local: IR.LOCAL

        type: Type => local.type

        init(local: IR.LOCAL) is
            super.init()

            self.local = local
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "store-temp:[{type}]({local})"
    si

    // Stores `value` in a local and also leaves it as this value's
    // result.
    class TEE_TEMP: Value is
        local: IR.LOCAL
        value: Value

        type: Type? pure => value.type

        has_location: bool => false

        init(local: IR.LOCAL, value: Value) is
            super.init()

            self.local = local
            self.value = value
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "tee-temp:[{type}]({local}, {value})"
    si

    // Evaluates `value` for its effects and discards its result, or,
    // with no value, discards the result an earlier value left: the
    // exception a catch handler starts with, or a value a join leaves
    // where nothing consumes it.
    class DISCARD: Value is
        value: Value?

        has_location: bool => false

        init() is
            super.init()
        si

        init(value: Value) is
            super.init()

            self.value = value
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "discard({value})"
    si

    // Throws `exception`, or, with no value, the exception an earlier
    // value left.
    class THROW: Value is
        exception: Value?

        has_location: bool => false

        init() is
            super.init()
        si

        init(exception: Value) is
            super.init()

            self.exception = exception
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "throw({exception})"
    si

    // Returns from the enclosing method. A value for the same reason
    // as DECLARE_LOCAL: silently dropping an instruction produces a
    // body that fails verification with nothing to point at.
    class RET: Value is
        init() is
            super.init()
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "ret"
    si

    // The value a non-void function falls out of the bottom with: a
    // fresh local of the return type, never assigned, loaded so the
    // trailing `ret` has something to return. The local is anonymous
    // and used once, so it is declared and loaded together rather than
    // through the usual declare-then-load pair.
    class DEFAULT_RETURN: Value is
        type: Type

        init(type: Type) is
            super.init()

            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "default-return:[{type}]()"
    si
si
