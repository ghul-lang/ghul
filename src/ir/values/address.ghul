namespace IR.Values is
    use Semantic.Types.Type

    class ADDRESS: Value is
        _next_id: int static

        is_lightweight_pure: bool => value.is_lightweight_pure
        has_address: bool => value.has_address
        type: Type
        value: Value

        local: IR.LOCAL? public

        next_name: string static is
            let result = ".address.{_next_id}"

            _next_id = _next_id + 1

            return result
        si

        init(
            value: Value,
            type: Type
        ) is
            super.init()

            self.value = value
            self.type = type
        si

        init(
            value: Value
        ) is
            init(value, value.type!)
        si

        reset_id() static is
            _next_id = 0
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        accept_address(visitor: Visitor) is
            visitor.visit_address(self)
        si

        to_string() -> string =>
            "address:[{type}]({value})"
    si
si
