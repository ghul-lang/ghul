namespace IR.Values is
    use Semantic.Types.Type

    class ADDRESS: Value is
        _next_id: int static

        is_lightweight_pure: bool => value.is_lightweight_pure
        has_address: bool => value.has_address
        type: Type
        value: Value

        local: IR.LOCAL?

        next_name: string static is
            let result = ".address.{_next_id}"

            _next_id = _next_id + 1

            return result
        si

        init(
            value: Value,
            type: Type
        ) is
            super.init()

            self.value = value
            self.type = type
        si

        init(
            value: Value
        ) is
            init(value, value.type!)
        si

        reset_id() static is
            _next_id = 0
        si

        gen_address(context: IR.CONTEXT) is
            gen(context)
        si

        gen(context: IR.CONTEXT) is
            if value.has_address then
                value.gen_address(context)
            else
                if !local? then
                    local = IR.LOCAL(next_name, type)
                fi

                let body = context.current_srm_body_emitter!
                    body.declare_local(local!)

                    value.gen(context)

                    body.stloc(local!)
                    body.ldloca(local!)
            fi
        si

        to_string() -> string =>
            "address:[{type}]({value})"
    si
si
