namespace IR.Values is
    use Semantic.Types.Type

    use Ghul.Pipes

    // A built-in arithmetic or bitwise operator applied to one operand
    // or two.
    class ARITHMETIC: Value is
        operation: IR.ArithmeticOperation
        operands: Collections.List[Value]

        type: Type

        // Marked before the operator rather than before the operands,
        // which mark their own positions, unless unmarked.
        has_location: bool => !is_marked /\ super.has_location

        is_marked: bool

        init(operation: IR.ArithmeticOperation, operands: Collections.List[Value], type: Type) is
            super.init()

            assert operands.count == 1 \/ operands.count == 2 else "arithmetic takes one operand or two"

            self.operation = operation
            self.operands = operands
            self.type = type

            is_marked = true
        si

        init(operation: IR.ArithmeticOperation, left: Value, right: Value, type: Type) is
            self.init(operation, [left, right]:Value, type)
        si

        // Marks no source positions inside it: whatever holds it marks
        // its position as a whole, if anything does.
        unmarked() -> ARITHMETIC is
            is_marked = false

            return self
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "arithmetic:{operation}({operands |> join(", ")})"
    si

    // A built-in comparison of two values, answering a bool. An
    // unsigned comparison orders integers as unsigned, and floating
    // values with unordered operands answering true.
    class COMPARE: Value is
        comparison: IR.Comparison
        left: Value
        right: Value
        is_unsigned: bool

        type: Type

        // Marked before the comparison rather than before the
        // operands, which mark their own positions.
        has_location: bool => false

        init(comparison: IR.Comparison, left: Value, right: Value, is_unsigned: bool, type: Type) is
            super.init()

            self.comparison = comparison
            self.left = left
            self.right = right
            self.is_unsigned = is_unsigned
            self.type = type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "compare:{comparison}{if is_unsigned then ".unsigned" else "" fi}({left}, {right})"
    si
si
