namespace IR.Values is
    use Semantic.Types.Type

    class TYPEOF: Value is
        type: Type
        typeof_type: Type

        init(
            type: Type,
            typeof_type: Type
        ) is
            super.init()

            self.type = type
            self.typeof_type = typeof_type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "typeof:[{type}]({typeof_type})"
    si
si
