namespace IR.Values is
    use Ghul.Pipes

    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    class BLOCK: Value, TypeTyped is
        _values: Collections.MutableList[Value]

        type: Type
        is_block: bool => true

        is_closed: bool
        is_emitted: bool public

        is_consumable: bool => true

        init(type: Type) is
            super.init()

            _values = Collections.LIST[Value]()

            self.type = type
        si

        init() is
            super.init()

            _values = Collections.LIST[Value]()

            self.type = Semantic.Types.ERROR()
        si

        close() is
            assert !self.is_emitted else "oops: block value already emitted"
            assert !self.is_closed else "oops: block is already closed"

            self.is_closed = true
        si

        // While the body of a structured node in this block is open,
        // values added here are added to that body instead. Code that
        // holds a block from before the node opened, such as the block
        // a TEMP was declared in, still appends at the current position.
        _open_body: BLOCK?

        add(value: Value) is
            if _open_body? then
                _open_body.add(value)
                return
            fi

            assert !self.is_emitted else "oops: block value already emitted"
            assert !self.is_closed else "oops: block is closed, can't add more values"

            _values.add(value)
        si

        open_body(body: BLOCK) is
            assert !_open_body? else "a structured node's body is already open in this block"

            _open_body = body
        si

        close_body(body: BLOCK) is
            assert _open_body == body else "closing a structured node's body that is not open in this block"

            _open_body = null
        si

        values: Collections.MutableList[Value] => _values

        // The value the block leaves behind when consumed as an
        // expression: the earlier entries run for effect only.
        result_value: Value? =>
            if _values.count > 0 then
                _values[_values.count - 1]
            else
                null
            fi

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "block:[{type}]({_values |> join("; ")})"
    si

    class DUMMY_BLOCK: BLOCK is
        location: Source.LOCATION
        why: string

        init(type: Type, location: Source.LOCATION, why: string) is
            super.init(type)

            self.location = location
            self.why = why
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si
    si
si
