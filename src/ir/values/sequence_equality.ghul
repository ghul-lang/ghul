namespace IR.Values is
    use Semantic.Types.Type

    // `a =~ b` where both operands are a sequence - an array, or a
    // list - compared by count and then element by element.
    //
    // The element comparison arrives already built against a load of
    // the index local this node declares, so what the element type's
    // equality is has been decided by the caller in the same way as for
    // any other operand; this node only supplies the loop around it.
    // Both counts are read twice, so they arrive as repeatable loads.
    class SEQUENCE_EQUALITY: Composite is
        left_count: Value
        right_count: Value
        index: IR.LOCAL
        element_equals: Value
        _result_type: Type

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(
            left_count: Value,
            right_count: Value,
            index: IR.LOCAL,
            element_equals: Value,
            result_type: Type
        ) is
            super.init()

            self.left_count = left_count
            self.right_count = right_count
            self.index = index
            self.element_equals = element_equals
            self._result_type = result_type
        si

        // Unequal counts, or the first element pair to compare unequal,
        // leave the comparison false.
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)
            let result = expansion.temp("sequence_equality", type)
            let index_type = index.type

            expansion.declare(index)

            let done = expansion.region()
            let unequal = expansion.region()

            expansion.exit_if(unequal, IR.BRANCH.NE, left_count, right_count)
            expansion.store(index, Literal.NUMBER(0, index_type))

            let loop = expansion.loop()

            expansion.exit_if(loop, IR.BRANCH.GE, index.load(), left_count)
            expansion.exit_if(unequal, IR.BRANCH.Z, element_equals)
            expansion.store(
                index,
                ARITHMETIC(IR.ArithmeticOperation.ADD, index.load(), Literal.NUMBER(1, index_type), index_type).unmarked()
            )
            expansion.close(loop)

            expansion.store(result, Literal.NUMBER(1, type))
            expansion.exit(done)
            expansion.close(unequal)

            expansion.store(result, Literal.NUMBER(0, type))
            expansion.close(done)

            expansion.add(result.load())

            return expansion.result
        si

        to_string() -> string =>
            "sequence-equality:[{type}]({left_count},{right_count},{index},{element_equals})"
    si

    // `a =~ b` on two references of a class declaring neither `=~` nor
    // `<>`: the same thing as `a == b`, reached from a synthesized
    // comparison where the operator could not have been written.
    class REFERENCE_EQUALITY: Value is
        left: Value
        right: Value
        _result_type: Type

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(left: Value, right: Value, result_type: Type) is
            super.init()

            self.left = left
            self.right = right
            self._result_type = result_type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "reference-equality:[{type}]({left},{right})"
    si
si
