namespace IR.Values is
    // Lowers IR values for a target: one visit for each kind of value a
    // backend lowers itself. A value reaches `visit_value` until it has a
    // visit of its own.
    trait Visitor open is
        visit_value(value: Value)
        visit_address_of_value(value: Value)

        visit(number: Literal.NUMBER)
        visit(string: Literal.STRING)
        visit(decimal: Literal.DECIMAL)
        visit(bigint: Literal.BIGINT)
    si
si
