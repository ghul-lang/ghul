namespace IR.Values is
    // Lowers IR values for a target: one visit for each kind of value a
    // backend lowers itself. A value reaches `visit_value` until it has a
    // visit of its own.
    trait Visitor open is
        visit_value(value: Value)
        visit_address_of_value(value: Value)

        visit(number: Literal.NUMBER)
        visit(string: Literal.STRING)
        visit(decimal: Literal.DECIMAL)
        visit(bigint: Literal.BIGINT)

        visit(load: Load.SYMBOL)
        visit_address(load: Load.SYMBOL)
        visit(load: Load.INSTANCE_FIELD)
        visit_address(load: Load.INSTANCE_FIELD)
        visit(load: Load.STATIC_ANONYMOUS_FUNCTION)
        visit(load: Load.GLOBAL_ANONYMOUS_FUNCTION)
        visit(load: Load.INSTANCE_ANONYMOUS_FUNCTION)
        visit(load: Load.FUNCTION_POINTER)
        visit(load: Load.TEMP)
        visit_address(load: Load.TEMP)
        visit(load: Load.STATIC_FIELD)
        visit_address(load: Load.STATIC_FIELD)
        visit(load: Load.GLOBAL_FIELD)
        visit_address(load: Load.GLOBAL_FIELD)
        visit(load: Load.LOCAL_ARGUMENT)
        visit_address(load: Load.LOCAL_ARGUMENT)
        visit(load: Load.LOCAL_VARIABLE)
        visit_address(load: Load.LOCAL_VARIABLE)
        visit(load: Load.ARGUMENT_SLOT)

        visit(composite: Composite)

        visit(dummy: DUMMY)
        visit(type_expression: TYPE_EXPRESSION)
        visit(store: Need.STORE)
        visit(store: Store.INDIRECT)
        visit(wrapper: TYPE_WRAPPER)
        visit_address(wrapper: TYPE_WRAPPER)
        visit(wrapper: WRAPPER)
        visit_address(wrapper: WRAPPER)
        visit(wrap: WRAP_OPTIONAL)
        visit(projection: NARROW_PROJECT)
        visit(view: NARROW_VIEW)
        visit_address(view: NARROW_VIEW)
        visit(enter: ENTER_FILE)
        visit(leave: LEAVE_FILE)
        visit(delegate: Load.DELEGATE)

        visit(address: ARRAY_ELEMENT_ADDRESS)
        visit_address(address: ARRAY_ELEMENT_ADDRESS)
        visit(array: NEW_ARRAY)
        visit(store: STORE_ARRAY_ELEMENT)
        visit(sequence: SEQUENCE)
        visit(compare: COMPARE_ORDER_TO_ZERO)
        visit(receiver: CONSTRAINED)
        visit(call: DECIMAL_CALL)
        visit(convert: DECIMAL_CONVERT)
        visit(equality: EQUALITY_COMPARISON)
        visit(test: HAS_VALUE)
        visit(check: REFERENCE_NULL_CHECK)
        visit(conversion: SCALAR_CONVERSION)

        visit(declaration: DECLARE_LOCAL)
        visit(store: STORE_TEMP)
        visit(tee: TEE_TEMP)
        visit(discard: DISCARD)
        visit(thrown: THROW)
        visit(ret: RET)
        visit(default_return: DEFAULT_RETURN)
        visit(default_value: DEFAULT)
        visit_address(default_value: DEFAULT)
        visit(deref: DEREF)
        visit_address(deref: DEREF)
        visit(address: ADDRESS)
        visit_address(address: ADDRESS)
        visit(steps: STEPS)
        visit(decrement: DECREMENT)
        visit(increment: POST_INCREMENT)
        visit(decrement: PRE_DECREMENT)
        visit(repack: TUPLE_REPACK)
        visit(spilled: SPILLED_SUBJECT)

        visit(null_value: NULL)
        visit(box: BOX)
        visit(unbox: UNBOX)
        visit(conversion: CAST)
        visit(test: ISA)
        visit(type_of: TYPEOF)
        visit(tuple: TUPLE)
        visit(construction: NEW)
        visit(negation: NOT)
        visit(arithmetic: ARITHMETIC)
        visit(compare: COMPARE)
        visit(convert: CONVERT)

        visit(node: Breakable)
        visit(exit: Exit)
        visit(dispatch: DISPATCH)
        visit(resume: RESUME_POINT)

        visit(call: Call.GLOBAL)
        visit(call: Call.STATIC)
        visit(call: Call.STRUCT)
        visit(call: Call.INSTANCE)
        visit(call: Call.CLOSURE)
        visit(call: Call.INNATE)

        visit(store: Store.SYMBOL)
        visit(store: Store.LOCAL_VARIABLE)
        visit(store: Store.LOCAL_ARGUMENT)
        visit(store: Store.STATIC_FIELD)
        visit(store: Store.GLOBAL_FIELD)
        visit(store: Store.INSTANCE_FIELD)
    si
si
