namespace IR.Values is
    // Lowers IR values for a target: one visit for each kind of value a
    // backend lowers itself. A value reaches `visit_value` until it has a
    // visit of its own.
    trait Visitor open is
        visit_value(value: Value)
        visit_address_of_value(value: Value)

        visit(number: Literal.NUMBER)
        visit(string: Literal.STRING)
        visit(decimal: Literal.DECIMAL)
        visit(bigint: Literal.BIGINT)

        visit(load: Load.SYMBOL)
        visit_address(load: Load.SYMBOL)
        visit(load: Load.INSTANCE_FIELD)
        visit_address(load: Load.INSTANCE_FIELD)
        visit(load: Load.STATIC_ANONYMOUS_FUNCTION)
        visit(load: Load.GLOBAL_ANONYMOUS_FUNCTION)
        visit(load: Load.INSTANCE_ANONYMOUS_FUNCTION)
        visit(load: Load.FUNCTION_POINTER)
        visit(load: Load.TEMP)
        visit_address(load: Load.TEMP)
        visit(load: Load.STATIC_FIELD)
        visit_address(load: Load.STATIC_FIELD)
        visit(load: Load.GLOBAL_FIELD)
        visit_address(load: Load.GLOBAL_FIELD)
        visit(load: Load.LOCAL_ARGUMENT)
        visit_address(load: Load.LOCAL_ARGUMENT)
        visit(load: Load.LOCAL_VARIABLE)
        visit_address(load: Load.LOCAL_VARIABLE)
        visit(load: Load.ARGUMENT_SLOT)

        visit(node: Breakable)
        visit(exit: Exit)
        visit(dispatch: DISPATCH)
        visit(resume: RESUME_POINT)

        visit(call: Call.GLOBAL)
        visit(call: Call.STATIC)
        visit(call: Call.STRUCT)
        visit(call: Call.INSTANCE)
        visit(call: Call.CLOSURE)
        visit(call: Call.INNATE)

        visit(store: Store.SYMBOL)
        visit(store: Store.LOCAL_VARIABLE)
        visit(store: Store.LOCAL_ARGUMENT)
        visit(store: Store.STATIC_FIELD)
        visit(store: Store.GLOBAL_FIELD)
        visit(store: Store.INSTANCE_FIELD)
    si
si
