namespace IR.Values is
    use Semantic.Types.Type

    class DEREF: Value is
        type: Type
        value: Value

        is_deref: bool => true
        has_address: bool => true

        init(
            value: Value,
            type: Type
        ) is
            super.init()

            self.value = value
            self.type = type
        si

        init(
            value: Value
        ) is
            init(value, value.type!)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        accept_address(visitor: Visitor) is
            visitor.visit_address(self)
        si

        to_string() -> string =>
            "deref:[{type}]({value})"
    si
si
