namespace IR.Values.Literal is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    // The constant a numeric literal loads, at the width it is loaded at.
    //
    // An integer is held at the width its load asks for rather than as a
    // magnitude, because the two are not the same: `0xFF00FF00` is a
    // `uint` in range, and the constant `ldc.i4` takes is the 32-bit
    // pattern, which read as a magnitude is negative.
    union CONSTANT is
        I4(value: int)
        I8(value: long)
        R4(value: single)
        R8(value: double)
    si

    // A numeric constant, held as the value rather than as the way it was
    // written down. A source literal can be written in any radix and with
    // any suffix, so the spelling and the value are not the same thing,
    // and reading that spelling back is not something emission should
    // have to do.
    class NUMBER: Value, TypeTyped is
        constant: CONSTANT
        type: Type

        // The scalar the loaded constant is converted to, where the
        // width it is loaded at is not the literal's declared type.
        narrowing: IR.Scalar?

        is_lightweight_pure: bool => true

        is_real: bool =>
            case constant
            when _: CONSTANT.R4 then true
            when _: CONSTANT.R8 then true
            else false
            esac

        // The constant written out, used to render an attribute
        // argument and as a key for comparing case-arm constants.
        rendered: string =>
            case constant
            when i4: CONSTANT.I4 then "{i4.value}"
            when i8: CONSTANT.I8 then "{i8.value}"
            when r4: CONSTANT.R4 then "{r4.value}"
            when r8: CONSTANT.R8 then "{r8.value}"
            esac

        init(constant: CONSTANT, type: Type, narrowing: IR.Scalar?) is
            super.init()

            self.constant = constant
            self.type = type
            self.narrowing = narrowing
        si

        init(constant: CONSTANT, type: Type) is
            self.init(constant, type, null)
        si

        init(value: int, type: Type) is
            self.init(CONSTANT.I4(value), type, null)
        si

        init(value: long, type: Type) is
            self.init(CONSTANT.I8(value), type, null)
        si

        init(value: single, type: Type) is
            self.init(CONSTANT.R4(value), type, null)
        si

        init(value: double, type: Type) is
            self.init(CONSTANT.R8(value), type, null)
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!

            case constant
            when i4: CONSTANT.I4 then body.ldc_i4(i4.value)
            when i8: CONSTANT.I8 then body.ldc_i8(i8.value)
            when r4: CONSTANT.R4 then body.ldc_r4(r4.value)
            when r8: CONSTANT.R8 then body.ldc_r8(r8.value)
            esac

            if let to = narrowing then
                let from =
                    case constant
                    when _: CONSTANT.I4 then IR.Scalar.INT32
                    when _: CONSTANT.I8 then IR.Scalar.INT64
                    when _: CONSTANT.R4 then IR.Scalar.FLOAT32
                    when _: CONSTANT.R8 then IR.Scalar.FLOAT64
                    esac

                for op_code in IR.Emitter.CIL_OPERATIONS.conversion(from, to) do
                    body.op(op_code)
                od
            fi
        si

        to_string() -> string =>
            "literal:[{type}]({constant})"
    si
si
