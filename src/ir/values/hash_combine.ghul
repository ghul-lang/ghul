namespace IR.Values is

    use Semantic.Types.Type

    use Ghul.Pipes

    // The whole body of a synthesized `get_hash_code`: each member's
    // hash, folded together.
    //
    // Every operand arrives boxed, so a member of any kind answers -
    // a value type through its box, a bare type parameter through its
    // own hash, and an absent optional through the null arm rather
    // than a call that would throw on it.
    class HASH_COMBINE: Value is
        operands: Collections.LIST[Value]
        get_hash_code: Semantic.Symbols.Function
        // What the fold starts from: a base's own hash where this type
        // extends one that holds members, so that the members it does
        // not declare are hashed where they are compared. Zero
        // otherwise - `object`'s hash is identity, and two equal
        // values would answer differently through it.
        seed: Value?
        _result_type: Type

        type: Type => _result_type
        is_lightweight_pure: bool => false

        init(
            operands: Collections.LIST[Value],
            get_hash_code: Semantic.Symbols.Function,
            seed: Value?,
            result_type: Type
        ) is
            super.init()

            self.operands = operands
            self.get_hash_code = get_hash_code
            self.seed = seed
            self._result_type = result_type
        si

        // The running total is multiplied before each member is
        // evaluated, and an absent member adds nothing to it.
        expand() -> BLOCK is
            let expansion = IR.EXPANSION(type)
            let total = expansion.temp("hash", type)

            expansion.store(total, seed ?? Literal.NUMBER(0, type))

            for operand in operands do
                expansion.store(
                    total,
                    ARITHMETIC(IR.ArithmeticOperation.MULTIPLY, total.load(), Literal.NUMBER(31, type), type)
                )

                // A box answers the type it boxes, not the reference it
                // leaves.
                let held_type =
                    if isa BOX(operand) then
                        IoC.CONTAINER.instance.innate_symbol_lookup.get_object_type()
                    else
                        operand.type!
                    fi

                let held = expansion.temp("hash.member", held_type)

                expansion.store(held, operand)

                let absent = expansion.region()

                expansion.exit_if(absent, IR.BRANCH.Z, held.load())
                expansion.store(
                    total,
                    ARITHMETIC(
                        IR.ArithmeticOperation.ADD,
                        total.load(),
                        Call.INSTANCE(held.load(), get_hash_code, Collections.LIST[Value](), type),
                        type
                    )
                )
                expansion.close(absent)
            od

            expansion.add(total.load())

            return expansion.result
        si

        gen(context: IR.CONTEXT) is
            IR.EXPANSION.gen(expand(), context)
        si

        to_string() -> string =>
            "hash-combine:[{type}]({operands |> map(o => "{o}") |> join(",")})"
    si
si
