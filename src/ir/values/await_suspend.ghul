namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    // Per-`await` IL emission inside MoveNext. Stashes the awaiter
    // to a frame field, IsCompleted-short-circuits when the awaited
    // value is already done, otherwise records the state, registers
    // the continuation through the builder and leaves the resumable
    // MoveNext body. A dispatch routes re-entry back to the resume
    // point at `cold_resume_label`, where state is cleared and
    // execution falls through to call `GetResult` and leave T on the
    // stack (or stack-effect 0 for a void result).
    //
    // The control flow is built from structured nodes and encoded
    // without marking source positions, so the await marks only its
    // own.
    //
    // The three awaiter-pattern calls arrive as ordinary call values:
    // `get_awaiter` over the awaited operand, and `is_completed` /
    // `get_result` over a load of the awaiter field, so the receiver
    // conventions (address of a struct, dispatch on a class) are the
    // ones every other call uses.
    //
    // ghūl uses CLASS-based state machines (matches the generator
    // shape) — `ldarg.0` is the SM instance and `ldarga.s 0` is the
    // byref needed for `ref TStateMachine`. C# Release uses STRUCT-
    // based for performance; the CLASS path costs one alloc per
    // async call.
    class AWAIT_SUSPEND: Value, TypeTyped is
        type: Type

        get_awaiter: Value
        is_completed: Value
        get_result: Value
        awaiter_type: Type

        // The awaiter implements `ICriticalNotifyCompletion`, so the
        // continuation is registered with `AwaitUnsafeOnCompleted`
        // rather than `AwaitOnCompleted`.
        is_critical: bool

        state_number: int
        state_local: IR.LOCAL
        cold_resume_label: IR.LABEL
        resumable: RESUMABLE
        state_machine_type: Type
        state_field: Semantic.Symbols.Field
        awaiter_field: Semantic.Symbols.Field
        builder_field: Semantic.Symbols.Field

        init(
            type: Type,
            get_awaiter: Value,
            is_completed: Value,
            get_result: Value,
            awaiter_type: Type,
            is_critical: bool,
            state_number: int,
            state_local: IR.LOCAL,
            cold_resume_label: IR.LABEL,
            resumable: RESUMABLE,
            state_machine_type: Type,
            state_field: Semantic.Symbols.Field,
            awaiter_field: Semantic.Symbols.Field,
            builder_field: Semantic.Symbols.Field
        ) is
            super.init()

            self.type = type
            self.get_awaiter = get_awaiter
            self.is_completed = is_completed
            self.get_result = get_result
            self.awaiter_type = awaiter_type
            self.is_critical = is_critical
            self.state_number = state_number
            self.state_local = state_local
            self.cold_resume_label = cold_resume_label
            self.resumable = resumable
            self.state_machine_type = state_machine_type
            self.state_field = state_field
            self.awaiter_field = awaiter_field
            self.builder_field = builder_field
        si

        gen(context: IR.CONTEXT) is
            let void_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_void_type()

            // Left when the awaited value has already completed, so no
            // continuation is registered and GetResult runs at once.
            let completed = REGION(IR.LABEL(), void_type)
            let skip = BREAK(completed, IR.BRANCH.NZ, is_completed)
            let suspend = BREAK(resumable)
            let resume = RESUME_POINT(cold_resume_label)

            completed.clear_position()
            skip.clear_position()
            suspend.clear_position()
            resume.clear_position()

            completed.body.add(AWAIT_SUSPEND_STEP(self, AwaitSuspendStep.CAPTURE_AWAITER))
            completed.body.add(skip)
            completed.body.add(AWAIT_SUSPEND_STEP(self, AwaitSuspendStep.REGISTER_CONTINUATION))
            completed.body.add(suspend)
            completed.body.add(resume)
            completed.body.add(AWAIT_SUSPEND_STEP(self, AwaitSuspendStep.CLEAR_STATE))
            completed.close()

            // Resolved before anything is encoded, and in this order, so
            // the member references are numbered as the steps have always
            // numbered them.
            context.resolve_field_target(state_field)
            context.resolve_field_target(awaiter_field)
            context.resolve_field_target(builder_field)

            context.begin_unmarked()

            gen(completed, context)
            gen(get_result, context)

            context.end_unmarked()
        si

        // Capture the awaiter into the frame.
        gen_capture_awaiter(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!

            body.ldarg(0)
            gen(get_awaiter, context)
            body.stfld(context.resolve_field_target(awaiter_field))
        si

        // Record the state and register the continuation through the
        // builder.
        gen_register_continuation(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
            let builder = context.resolve_field_target(builder_field)

            _stamp_state_srm(context, body, state_number, context.resolve_field_target(state_field))

            body.ldarg(0)

            // The builder goes by address for a struct - the shape the
            // BCL builders use - and as the object a class builder's
            // methods receive as `this`.
            if builder_field.type!.is_value_type then
                body.ldflda(builder)
            else
                body.ldfld(builder)
            fi

            body.ldarg(0)
            body.ldflda(context.resolve_field_target(awaiter_field))

            // The state machine goes by reference for a builder whose
            // member takes it so, and as the interface object for one
            // that takes it by value.
            if context.builder_awaits_sm_by_reference(builder_field.type!, is_critical) then
                body.ldarga(0)
            else
                body.ldarg(0)
            fi

            body.call(
                context.resolve_await_on_completed(
                    builder_field.type!, awaiter_type, state_machine_type, is_critical))
        si

        // Mark the machine running again, on a resumed MoveNext.
        gen_clear_state(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!

            _stamp_state_srm(context, body, -1, context.resolve_field_target(state_field))
        si

        // Write a state value to both the cached CLR local and the
        // frame's state field, so a `leave` out of a protected region
        // fires finally bodies that read the local and see the right
        // sentinel.
        _stamp_state_srm(
            context: IR.CONTEXT,
            body: IR.Emitter.SRM_METHOD_BODY_EMITTER,
            value: int,
            state: System.Reflection.Metadata.EntityHandle
        ) is
            body.ldarg(0)
            body.ldc_i4(value)
            body.op(System.Reflection.Metadata.ILOpCode.DUP)
            body.stloc(state_local)
            body.stfld(state)
        si

        to_string() -> string =>
            "await-suspend:[{type}](state={state_number})"
    si

    enum AwaitSuspendStep is
        CAPTURE_AWAITER,
        REGISTER_CONTINUATION,
        CLEAR_STATE
    si

    // One straight-line step of an AWAIT_SUSPEND, which the await's
    // control flow is built around.
    class AWAIT_SUSPEND_STEP: Value is
        suspend: AWAIT_SUSPEND
        kind: AwaitSuspendStep

        has_location: bool => false

        init(suspend: AWAIT_SUSPEND, kind: AwaitSuspendStep) is
            super.init()

            self.suspend = suspend
            self.kind = kind
        si

        gen(context: IR.CONTEXT) is
            case kind
            when AwaitSuspendStep.CAPTURE_AWAITER then
                suspend.gen_capture_awaiter(context)
            when AwaitSuspendStep.REGISTER_CONTINUATION then
                suspend.gen_register_continuation(context)
            when AwaitSuspendStep.CLEAR_STATE then
                suspend.gen_clear_state(context)
            esac
        si

        to_string() -> string => "await-step:{kind}"
    si
si
