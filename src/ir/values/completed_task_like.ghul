namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed
    use Semantic.Types.Type

    // A completed handle for a result-less task-like, produced by
    // driving the task-like's builder directly: create, set_result,
    // read `task`. Emitted where a machine-less body completes at
    // fall-through or from a bare `return;` - the state-machine
    // lowering never produces this value, since its own trailer
    // completes through the builder field. Task itself completes
    // through `Tasks.TASK.completed_task` at compile time, so this is
    // the other task-likes only.
    class COMPLETED_TASK_LIKE: Value, TypeTyped is
        type: Type

        builder_type: Type

        is_state_changing_call: bool => true

        init(type: Type, builder_type: Type) is
            super.init()

            self.type = type
            self.builder_type = builder_type
        si

        gen(context: IR.CONTEXT) is
            let body = context.current_srm_body_emitter!
                let local = IR.LOCAL(".completed_builder", builder_type)

                body.declare_local(local)

                body.call(context.resolve_builder_member(builder_type, "create", 0))
                body.stloc(local)

                _load_builder(body, builder_type, local)
                body.call(context.resolve_builder_member(builder_type, "set_result", 0))

                _load_builder(body, builder_type, local)
                body.call(context.resolve_builder_property(builder_type, "task"))
        si

        // A struct builder is reached through its address, a class
        // builder through the object the local holds - the same
        // distinction the state-machine launch makes for the builder
        // field.
        _load_builder(
            body: IR.Emitter.SRM_METHOD_BODY_EMITTER,
            builder_type: Type,
            local: IR.LOCAL
        ) static is
            if builder_type.is_value_type then
                body.ldloca(local)
            else
                body.ldloc(local)
            fi
        si

        to_string() -> string => "completed-task-like:[{type}]()"
    si
si
