namespace IR.Values is
    use Semantic.Symbols.Symbol

    // A parameter of a literal written with an argument pack spread out
    // has no CLR parameter: the emitted method takes the pack's tuple and
    // unpacks it on entry into a local for each. Returns that local, or
    // null for an argument that keeps its CLR slot.
    packed_parameter_local_for(symbol: Symbol?) -> IR.LOCAL? is
        if !symbol? then
            return null
        fi

        if let closure: Semantic.Symbols.Closure = symbol.owner then
            if let parameter: Semantic.Symbols.Variable = symbol /\ closure.is_packed_parameter(symbol) then
                return parameter.ir_local_for("$pack.{symbol.name}", parameter.type!)
            fi
        fi

        return null
    si
si
