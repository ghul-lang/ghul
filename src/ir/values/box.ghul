namespace IR.Values is
    use Semantic.Types.Type

    class BOX: Value is
        value: Value
        type: Type? pure => value.type
        is_value_type: bool => false

        init(
            value: Value
        ) is
            super.init()

            self.value = value
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "box:[{type}]({value})"
    si
si
