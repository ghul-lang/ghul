namespace IR.Values is
    use Semantic.Types.Type

    class BOX: Value is
        value: Value

        // The type the value is boxed as, where that is not its own: a
        // value of a type variable is boxed as the variable.
        _boxed_type: Type?

        type: Type? pure => _boxed_type ?? value.type
        is_value_type: bool => false

        init(
            value: Value
        ) is
            super.init()

            self.value = value
        si

        init(value: Value, boxed_type: Type) is
            self.init(value)

            _boxed_type = boxed_type
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string =>
            "box:[{type}]({value})"
    si
si
