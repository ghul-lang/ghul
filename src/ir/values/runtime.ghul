namespace IR.Values is
    use Semantic.Types.Type

    use Ghul.Pipes

    // An operation the runtime provides, applied to its operands.
    class RUNTIME: Value is
        operation: IR.RuntimeOperation
        operands: Collections.List[Value]
        type: Type?

        // The type an operation over a generic member is instantiated
        // with, for an operation that has one.
        type_argument: Type?

        // An operation on a string builder is marked once, before
        // everything it lowers to, as a call is. Every other operation is
        // marked after its operands, which mark their own positions, as
        // an operator is.
        is_marked_as_call: bool =>
            case operation
            when IR.RuntimeOperation.NEW_STRING_BUILDER then true
            when IR.RuntimeOperation.APPEND_TEXT then true
            when IR.RuntimeOperation.APPEND_VALUE then true
            when IR.RuntimeOperation.APPEND_ALIGNED_VALUE then true
            when IR.RuntimeOperation.APPEND_FORMATTED_VALUE then true
            when IR.RuntimeOperation.APPEND_ALIGNED_FORMATTED_VALUE then true
            when IR.RuntimeOperation.BUILD_STRING then true
            else false
            esac

        has_location: bool => is_marked_as_call /\ super.has_location

        init(operation: IR.RuntimeOperation, operands: Collections.List[Value], type: Type?, type_argument: Type?) is
            super.init()

            self.operation = operation
            self.operands = operands
            self.type = type
            self.type_argument = type_argument
        si

        init(operation: IR.RuntimeOperation, operands: Collections.List[Value], type: Type?) is
            self.init(operation, operands, type, null)
        si

        init(operation: IR.RuntimeOperation, type: Type?) is
            self.init(operation, Collections.LIST[Value](), type, null)
        si

        init(operation: IR.RuntimeOperation, operand: Value, type: Type?) is
            self.init(operation, [operand]:Value, type, null)
        si

        init(operation: IR.RuntimeOperation, left: Value, right: Value, type: Type?) is
            self.init(operation, [left, right]:Value, type, null)
        si

        accept(visitor: Visitor) is
            visitor.visit(self)
        si

        to_string() -> string => "runtime:{operation}({operands |> join(", ")})"
    si
si
