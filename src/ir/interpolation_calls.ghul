namespace IR is
    use Collections.LIST

    use Semantic.Types.Type
    use Semantic.Symbols.Function

    use Values.Value

    /// An interpolation's builder operations as calls on the core library's
    /// builder, for a target whose core library is compiled from source: the
    /// builder is constructed, takes each piece of text through `append`, and
    /// answers the whole through `to_string`. A value's text comes from its
    /// own `to_string`, which dispatches as any other call does. Each answer
    /// is IR the target lowers as it lowers any other.
    class INTERPOLATION_CALLS is
        _report: string -> void

        // The temporaries each lowered `System.Enum.try_parse` call writes
        // through, kept so every lowering of the call names the same ones.
        // Keyed on the call itself, and held only as long as it is.
        _try_parse_temporaries: System.Runtime.CompilerServices.ConditionalWeakTable[Values.Call.STATIC, TRY_PARSE_TEMPORARIES] static

        init() static is
            _try_parse_temporaries = System.Runtime.CompilerServices.ConditionalWeakTable[Values.Call.STATIC, TRY_PARSE_TEMPORARIES]()
        si

        /// - report: called with a description of what an interpolation needs
        ///   that the core library does not provide
        init(report: string -> void) is
            _report = report
        si

        /// The construction of the builder `type` with room for the text
        /// `hints` predicts, the literal text's length and the number of
        /// values, as .NET's handler is given them. Where the hints are not
        /// both constant, or predict nothing, or the builder has no
        /// constructor taking a capacity, it is constructed with nothing.
        new_builder(type: Type?, hints: Value[]) -> Value? is
            if let capacity = _capacity(hints) /\ capacity > 0 then
                let int_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_int_type()

                if let function = method(type, "init", [int_type]) then
                    return Values.NEW(type!, function, LIST[Value]([Values.Literal.NUMBER(capacity, int_type)]))
                fi
            fi

            return new_builder(type)
        si

        // The number of code units an interpolation's text is predicted to
        // take: its literal text, and eleven for each value, which is what
        // an `int` can take.
        _capacity(hints: Value[]) -> int? static is
            if hints.count != 2 then
                return null
            fi

            if let literal: Values.Literal.NUMBER = hints[0], values: Values.Literal.NUMBER = hints[1] then
                if let l: Values.Literal.CONSTANT.I4 = literal.constant, v: Values.Literal.CONSTANT.I4 = values.constant then
                    return l.value + 11 * v.value
                fi
            fi

            return null
        si

        /// The construction of the builder `type`, or null where it has no
        /// constructor taking nothing.
        new_builder(type: Type?) -> Value? is
            if let constructor = method(type, "init", []) then
                return Values.NEW(type!, constructor, LIST[Value]())
            fi

            _report("an interpolation, whose builder has no constructor")

            return null
        si

        /// The call appending `text` to `builder` through the builder's
        /// `append` taking a string, or null where it has none. A builder may
        /// overload `append` and return itself from it, as .NET's does, so
        /// the overload is chosen by its argument and the target drops any
        /// result.
        append(builder: Value, text: Value) -> Value? is
            if let append = string_append(builder.type) then
                return Values.Call.INSTANCE(builder, append, LIST[Value]([text]), null)
            fi

            _report("an interpolation, whose builder has no append")

            return null
        si

        /// The call appending `text` to `builder` padded to `alignment`, or
        /// null where the builder cannot.
        append_aligned(builder: Value, text: Value, alignment: Value) -> Value? is
            if let append = method(builder.type, "_append_aligned", [_string_type, _int_type]) then
                return Values.Call.INSTANCE(builder, append, LIST[Value]([text, alignment]), null)
            fi

            _report("an interpolated value with an alignment")

            return null
        si

        /// The call answering everything appended to `builder`, or null
        /// where it has no `to_string`.
        build(builder: Value) -> Value? is
            if let build = method(builder.type, "to_string", []) then
                return Values.Call.INSTANCE(builder, build, LIST[Value](), null)
            fi

            _report("an interpolation, whose builder has no to_string")

            return null
        si

        /// The text of `value`, whose type is `type` once any type parameter
        /// is replaced: a string as itself, anything else through its
        /// `to_string`. A value whose type has no `to_string` of its own is
        /// displayed through the core library's `$`, so it reaches here only
        /// where the library declares none, and is reported rather than
        /// given different text.
        text_of(value: Value, type: Type?) -> Value is
            if _is_string(type) then
                return value
            elif let text = enum_text(value, type) then
                return text
            elif let to_string = method(type, "to_string", []) then
                if let owner: Semantic.Symbols.Classy = to_string.owner /\ owner.is_object then
                    _report("an interpolated value whose type has no to_string of its own")

                    return value
                fi

                return Values.Call.INSTANCE(value, to_string, LIST[Value](), null)
            fi

            _report("an interpolated value of type {value.type}")

            return value
        si

        /// The text of `value`, whose type is `type` once any type parameter
        /// is replaced, under the format string `format`. A numeric value is
        /// written by its type's `to_string(format)`. .NET ignores the format
        /// of a value that is not formattable, so a string, a bool, a char or
        /// an object of a class is written as it is without one. Enums and
        /// decimals are formattable on .NET and have no formatter in the core
        /// library, so they are reported rather than given different text.
        formatted_text_of(value: Value, format: Value, type: Type?) -> Value is
            if type?.symbol?.symbol_kind =~ Semantic.Symbols.SymbolKind.ENUM then
                _report("an interpolated enum with a format")

                return value
            fi

            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            if type? /\ type.symbol == lookup.get_decimal_type().symbol then
                _report("an interpolated decimal with a format")

                return value
            fi

            let scalar = IoC.CONTAINER.instance.value_converter.scalar(type)
            let is_bigint = type? /\ !type.is_optional /\ type.symbol == lookup.get_bigint_type().symbol

            if !is_bigint /\ !scalar? then
                if let formatted = _formattable_text(value, format, type) then
                    return formatted
                fi

                return text_of(value, type)
            fi

            if !is_bigint /\ (scalar =~ Scalar.BOOL \/ scalar =~ Scalar.CHAR) then
                return text_of(value, type)
            fi

            if let literal: Values.Literal.STRING = format then
                let integer = is_bigint \/ !(scalar =~ Scalar.FLOAT32 \/ scalar =~ Scalar.FLOAT64)

                if !CORE_NUMERIC_FORMAT.is_covered(literal.value, integer) then
                    _report("the numeric format {literal.value} for {type}")

                    return value
                fi
            fi

            if let to_string = method(type, "to_string", [_string_type]) then
                return Values.Call.INSTANCE(value, to_string, LIST[Value]([format]), null)
            fi

            _report("an interpolated value of type {type} with a format")

            return value
        si

        /// The builder's `append` taking a string: one that may be null, as
        /// both the core library's and .NET's declare it, or else one that
        /// may not, as a builder written in ghūl can.
        string_append(type: Type?) -> Function? =>
            method(type, "append", [_string_type.as_optional()]) ?? method(type, "append", [_string_type])

        // `value` written in `format` by its `to_string(format, provider)`,
        // where its type implements the core library's `System.IFormattable`,
        // as .NET formats only a value that does.
        _formattable_text(value: Value, format: Value, type: Type?) -> Value? static is
            let formattable = cast Semantic.Symbols.Classy?(IoC.CONTAINER.instance.innate_symbol_lookup.get_formattable_symbol())

            if !formattable? \/ !type? \/ !Semantic.Types.NAMED(formattable).is_assignable_from(type) then
                return null
            fi

            // The `to_string` the trait itself declares, beside those it
            // inherits from `object`; the type's implementation of it is the
            // one taking exactly its parameters.
            let declared: Function? mut = null

            if let group: Semantic.Symbols.FUNCTION_GROUP = Semantic.Types.NAMED(formattable).find_member("to_string") then
                for f in group.functions do
                    if f.owner?.unspecialized_symbol == formattable.unspecialized_symbol then
                        declared = f
                    fi
                od
            elif let f: Function = Semantic.Types.NAMED(formattable).find_member("to_string") then
                declared = f
            fi

            if let d = declared, to_string = method(type, "to_string", d.arguments) then
                return Values.Call.INSTANCE(value, to_string, LIST[Value]([format, Values.NULL(to_string.arguments[1])]), null)
            fi

            return null
        si

        /// The method of `type` named `name` taking exactly the parameter
        /// types `parameters`, pinned once and kept by `KNOWN_MEMBERS`.
        method(type: Type?, name: string, parameters: Type?[]) -> Function? static =>
            Semantic.KNOWN_MEMBERS.find(type, name, parameters)

        /// The text of `value`, a value of the enum `type`, as .NET gives
        /// it: its member's name, the names a flags value combines, or the
        /// number. A value is held as its integer, so the core library is
        /// handed the enum's members. Null where `type` is not an enum the
        /// core library can name.
        enum_text(value: Value, type: Type?) -> Value? static is
            // A value whose text is asked for through `object` arrives boxed.
            let inner = if let box: Values.BOX = value then box.value else value fi
            let `enum = cast Semantic.Symbols.ENUM_STRUCT?((if inner == value then type else inner.type fi)?.symbol)
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup
            let functions = lookup.get_enum_text_functions()

            if !`enum? \/ !functions? \/ `enum.is_wider_than_int32(lookup) then
                return null
            fi

            let function = Semantic.KNOWN_MEMBERS.in_group(functions, Semantic.KNOWN_SIGNATURE([lookup.get_int_type(), lookup.get_array_type(lookup.get_string_type()), lookup.get_array_type(lookup.get_int_type()), lookup.get_bool_type()]))

            if !function? then
                return null
            fi

            let (names, values) = _members(`enum)

            let arguments = LIST[Value]([
                inner,
                names,
                values,
                Values.Literal.NUMBER(if `enum.is_flags then 1 else 0 fi, lookup.get_bool_type())
            ])

            return Values.Call.STATIC(function, arguments, lookup.get_string_type(), null)
        si

        /// What a call to the core library's `System.Enum.parse` or
        /// `try_parse`, at an enum the core library can name, becomes: a call
        /// to the `ENUM_TEXT` helper that reads an enum's text, handed the
        /// enum's members as `enum_text` hands them, so no reflection is
        /// needed. Null where the call is to neither, or `type_argument` is
        /// not such an enum.
        ///
        /// - call: the static call
        /// - function: the function it calls
        /// - type_argument: the type argument it calls the function at
        enum_parse(call: Values.Call.STATIC, function: Function, type_argument: Type?) -> Value? static is
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup
            let `enum = cast Semantic.Symbols.ENUM_STRUCT?(type_argument?.symbol)

            if !`enum? \/ `enum.is_wider_than_int32(lookup) then
                return null
            fi

            let declared = cast Function?(function.root_specialized_from) ?? function

            let string_type = lookup.get_string_type()
            let optional_string = string_type.as_optional()
            let bool_type = lookup.get_bool_type()
            let string_array = lookup.get_array_type(string_type)
            let int_array = lookup.get_array_type(lookup.get_int_type())
            let int_reference = lookup.get_reference_type(lookup.get_int_type())

            let parse = lookup.get_system_enum_group("parse")
            let try_parse = lookup.get_system_enum_group("try_parse")

            let is_try mut = false
            let ignores_case mut = false

            if Semantic.KNOWN_MEMBERS.in_group(parse, Semantic.KNOWN_SIGNATURE([string_type])) == declared then
                is_try = false
            elif Semantic.KNOWN_MEMBERS.in_group(parse, Semantic.KNOWN_SIGNATURE([string_type, bool_type])) == declared then
                ignores_case = true
            elif Semantic.KNOWN_MEMBERS.in_group(try_parse, Semantic.KNOWN_SIGNATURE([optional_string, null])) == declared then
                is_try = true
            elif Semantic.KNOWN_MEMBERS.in_group(try_parse, Semantic.KNOWN_SIGNATURE([optional_string, bool_type, null])) == declared then
                is_try = true
                ignores_case = true
            else
                return null
            fi

            let helper =
                if is_try then
                    Semantic.KNOWN_MEMBERS.in_group(
                        lookup.get_enum_text_group("try_value_of"),
                        Semantic.KNOWN_SIGNATURE([optional_string, bool_type, string_array, int_array, int_reference]))
                else
                    Semantic.KNOWN_MEMBERS.in_group(
                        lookup.get_enum_text_group("value_of"),
                        Semantic.KNOWN_SIGNATURE([string_type, bool_type, string_array, int_array]))
                fi

            if !helper? then
                return null
            fi

            let (names, values) = _members(`enum)

            let arguments = LIST[Value]()

            arguments.add(call.arguments[0])

            if ignores_case then
                arguments.add(call.arguments[1])
            else
                arguments.add(Values.Literal.NUMBER(0, bool_type))
            fi

            arguments.add(names)
            arguments.add(values)

            if !is_try then
                return Values.Call.STATIC(helper, arguments, type_argument!, null)
            fi

            // The helper writes an int, and a reference to an enum is not
            // one to an int on every target: it writes a temporary, which is
            // then stored through the caller's reference as the enum.
            // The same temporaries each time the call is lowered, since a
            // target that decides which locals live in cells while it
            // discovers the program looks them up again when it emits it.
            let int_type = lookup.get_int_type()
            let expansion = EXPANSION(bool_type)

            let temporaries: TRY_PARSE_TEMPORARIES mut

            if !_try_parse_temporaries.try_get_value(call, temporaries ref) then
                temporaries = TRY_PARSE_TEMPORARIES(
                    LOCAL(".enum_value.{TEMP.get_next_id()}", int_type),
                    LOCAL(".enum_found.{TEMP.get_next_id()}", bool_type)
                )

                _try_parse_temporaries.add(call, temporaries)
            fi

            let written = expansion.declare(temporaries.written)
            let found = expansion.declare(temporaries.found)

            arguments.add(Values.ADDRESS(written.load(), int_reference))

            expansion.store(found, Values.Call.STATIC(helper, arguments, bool_type, null))
            expansion.add(Values.Store.INDIRECT(call.arguments[call.arguments.count - 1], written.load(), type_argument!))
            expansion.add(found.load())

            return expansion.result
        si

        // An enum's member names and values, in ascending order of value, as
        // the two arrays the `ENUM_TEXT` helpers take.
        _members(`enum: Semantic.Symbols.ENUM_STRUCT) -> (names: Value, values: Value) static is
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup
            let members = LIST[(name: string, value: int)]()

            for symbol in `enum.symbols do
                if let member: Semantic.Symbols.ENUM_STRUCT_MEMBER = symbol, number = member.numeric_value then
                    members.add((name = member.name, value = number))
                fi
            od

            members.sort((a, b) => if a.value < b.value then -1 elif a.value > b.value then 1 else a.name.compare_to(b.name) fi)

            let int_type = lookup.get_int_type()
            let string_type = lookup.get_string_type()

            let names = LIST[Value]()
            let values = LIST[Value]()

            for (name, number) in members do
                names.add(Values.Literal.STRING(name, string_type))
                values.add(Values.Literal.NUMBER(number, int_type))
            od

            return (
                names = Values.SEQUENCE(lookup.get_array_type(string_type), string_type, names),
                values = Values.SEQUENCE(lookup.get_array_type(int_type), int_type, values)
            )
        si

        _string_type: Type static => IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type()

        _int_type: Type static => IoC.CONTAINER.instance.innate_symbol_lookup.get_int_type()

        _is_string(type: Type?) -> bool =>
            type? /\ type.symbol == IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type().symbol
    si

    // The two temporaries a lowered `System.Enum.try_parse` call uses: the
    // int its helper writes, and whether it found a value.
    class TRY_PARSE_TEMPORARIES(written: LOCAL public, found: LOCAL public)
si
