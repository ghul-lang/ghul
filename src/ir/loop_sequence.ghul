namespace IR is
    use Values

    // A source a fused loop produces its elements from itself, with no
    // pipe object: the loop sets it up once, then for each element exits
    // while `more` is zero, takes the element from `current`, and calls
    // `advance`.
    trait LoopSequence is
        /// The local the next element is read from.
        current: LOCAL

        /// Non-zero while there is an element left to take.
        more: LOCAL

        /// The values that evaluate the source's arguments, once and in
        /// the order the call would, and leave the sequence ready to read.
        setup() -> Collections.LIST[Value]

        /// Moves on from the element just taken, which `previous` holds.
        advance(expansion: EXPANSION, previous: LOCAL)
    si
si
