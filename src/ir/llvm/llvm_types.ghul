namespace IR.LLVMTarget is
    use Semantic.Types.Type

    use LLVM.Types

    /// How the LLVM target holds values of the built-in scalar kinds.
    ///
    /// Every location holding a value, a local, an argument, a field, a
    /// global, an array element, a member of a struct or a box, stores it at
    /// the width of its kind: a `byte` in an `i8`, a `char` in an `i16`, as
    /// clang stores a `char`. An integer kind narrower than 32 bits is
    /// computed with as an `i32`, as CIL holds it on its evaluation stack, so
    /// a load from memory widens it and a store narrows it again. A bool is
    /// an `i1` wherever it is computed with and a byte holding 0 or 1 in
    /// memory, as clang holds one. A reference to any location of a kind
    /// therefore means the same width.
    class LLVM_TYPES is
        /// The scalar kind a value of `type` is, or null where the type is
        /// not one of the built-in scalars. An enum is held as the `int`
        /// underneath it.
        scalar(type: Type?) -> Scalar? static =>
            if type? /\ isa Semantic.Symbols.ENUM_STRUCT(type.symbol) /\ !type.is_optional then
                Scalar.INT32
            else
                IoC.CONTAINER.instance.value_converter.scalar(type)
            fi

        /// The LLVM type a value of the scalar kind is held in.
        value_type(scalar: Scalar) -> LLVM.Type static =>
            case scalar
            when Scalar.BOOL then Types.i1
            when Scalar.INT64, Scalar.UINT64, Scalar.INT_NATIVE, Scalar.UINT_NATIVE then Types.i64
            when Scalar.FLOAT32 then LLVM.Type.FLOAT
            when Scalar.FLOAT64 then LLVM.Type.DOUBLE
            else Types.i32
            esac

        /// The LLVM type a value of `type` is held in, or null where the
        /// target holds no values of the type yet.
        value_type(type: Type?) -> LLVM.Type? static =>
            if let kind = scalar(type) then
                value_type(kind)
            elif is_string(type) \/ is_array(type) \/ is_object_reference(type) then
                Types.pointer
            else
                null
            fi

        /// Whether `type` is `string`, which is held as a pointer to the
        /// string object.
        is_string(type: Type?) -> bool static =>
            type? /\ type.symbol == IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type().symbol

        /// Whether `type` is a class, a trait, a union or one of its variants,
        /// `object`, a function type or a frame, whose values are
        /// held as pointers to objects.
        is_object_reference(type: Type?) -> bool static =>
            type? /\ !type.is_value_type /\ !(type.optional_inner_type?.is_value_type ?? false) /\ (type.is_class \/ type.is_trait \/ type.is_object \/ type.is_function \/ type.is_action \/ _is_frame(type) \/ _is_union(type))

        // A closure's frame, or a generator's or asynchronous function's.
        _is_frame(type: Type) -> bool static is
            let symbol = if let generic: Semantic.Symbols.GENERIC = type.symbol then generic.unspecialized_symbol else type.symbol fi

            return isa Semantic.Symbols.FRAME(symbol) \/ isa Semantic.Symbols.STATE_MACHINE_FRAME_BASE(symbol)
        si

        _is_union(type: Type) -> bool static =>
            if let classy: Semantic.Symbols.Classy = type.symbol then
                classy.is_union \/ classy.is_variant
            elif let generic: Semantic.Symbols.GENERIC = type.symbol then
                if let classy: Semantic.Symbols.Classy = generic.unspecialized_symbol then classy.is_union \/ classy.is_variant else false fi
            else
                false
            fi

        /// Whether `type` is an array type, which is held as a pointer to the
        /// array object.
        is_array(type: Type?) -> bool static =>
            if let generic: Semantic.Symbols.GENERIC = type?.symbol then
                cast Semantic.Symbols.Classy?(generic.unspecialized_symbol) == IR.Program.INNATE_CORE_CLASSES().array_definition
            else
                false
            fi

        /// The type a function returning `type` is declared to return: `void`
        /// for nothing, or null where the target holds no values of the type
        /// yet.
        result_type(type: Type?) -> LLVM.Type? static =>
            if is_void(type) then LLVM.Type.VOID else value_type(type) fi

        /// Whether `type` is absent or `void`.
        is_void(type: Type?) -> bool static => !type? \/ type.is_void

        /// Whether the kind is an integer computed with as an `i32` but held
        /// in memory in fewer bits.
        is_narrow(scalar: Scalar) -> bool static =>
            case scalar
            when Scalar.CHAR, Scalar.INT8, Scalar.UINT8, Scalar.INT16, Scalar.UINT16 then true
            else false
            esac

        /// The LLVM type a value of the scalar kind is stored as in memory:
        /// the width of the kind.
        stored_type(scalar: Scalar) -> LLVM.Type static =>
            case scalar
            when Scalar.BOOL, Scalar.INT8, Scalar.UINT8 then Types.i8
            when Scalar.CHAR, Scalar.INT16, Scalar.UINT16 then Types.i16
            else value_type(scalar)
            esac

        /// The LLVM type a value of `type` is stored as in memory, or null
        /// where it is not one of the built-in scalars.
        stored_type(type: Type?) -> LLVM.Type? static =>
            if let kind = scalar(type) then stored_type(kind) else null fi

        /// `value`, loaded from memory where a value of the kind is stored,
        /// widened to the type the kind is computed with.
        ///
        /// - block: where the conversion goes
        /// - value: the value as stored
        /// - scalar: its kind
        widen(block: LLVM.BLOCK, value: LLVM.Value, scalar: Scalar) -> LLVM.Value static =>
            if scalar == Scalar.BOOL then
                block.convert(LLVM.Conversion.TRUNCATE, value, Types.i1)
            elif is_narrow(scalar) then
                block.convert(if is_unsigned(scalar) then LLVM.Conversion.ZERO_EXTEND else LLVM.Conversion.SIGN_EXTEND fi, value, value_type(scalar))
            else
                value
            fi

        /// `value`, computed with as the kind is, narrowed to the width the
        /// kind is stored at.
        ///
        /// - block: where the conversion goes
        /// - value: the value as computed with
        /// - scalar: its kind
        narrow(block: LLVM.BLOCK, value: LLVM.Value, scalar: Scalar) -> LLVM.Value static =>
            if scalar == Scalar.BOOL then
                block.convert(LLVM.Conversion.ZERO_EXTEND, value, Types.i8)
            elif is_narrow(scalar) then
                block.convert(LLVM.Conversion.TRUNCATE, value, stored_type(scalar))
            else
                value
            fi

        /// Whether the kind's top bit is part of its magnitude.
        is_unsigned(scalar: Scalar) -> bool static =>
            case scalar
            when Scalar.BOOL, Scalar.CHAR, Scalar.UINT8, Scalar.UINT16 then true
            when Scalar.UINT32, Scalar.UINT64, Scalar.UINT_NATIVE then true
            else false
            esac

        /// Whether `type` is a floating point type.
        is_floating(type: LLVM.Type) -> bool static =>
            type =~ LLVM.Type.FLOAT \/ type =~ LLVM.Type.DOUBLE

        /// The width in bits of an integer type, or zero for any other.
        width(type: LLVM.Type) -> int static =>
            if let integer: LLVM.Type.INTEGER = type then integer.width else 0 fi


        /// Whether a value of `type` can hold a pointer, so memory holding one
        /// has to be scanned by the collector rather than allocated atomic: a
        /// pointer itself, and a struct, array or vector with one anywhere in
        /// it. A named struct is taken to hold one, as its fields are not
        /// known here.
        holds_pointer(type: LLVM.Type) -> bool static =>
            case type
            when _: LLVM.Type.POINTER then true
            when s: LLVM.Type.STRUCT then s.fields |> Ghul.Pipes.any(holds_pointer(*))
            when a: LLVM.Type.ARRAY then holds_pointer(a.element)
            when v: LLVM.Type.VECTOR then holds_pointer(v.element)
            when _: LLVM.Type.NAMED then true
            else false
            esac

        /// The size in bytes of a value of `type` as x86-64 lays it out: each
        /// struct field at its natural alignment, and the whole rounded up to
        /// the largest of them, as LLVM's own layout for the target does.
        size_of(type: LLVM.Type) -> int static =>
            case type
            when integer: LLVM.Type.INTEGER then if integer.width <= 8 then 1 elif integer.width <= 16 then 2 elif integer.width <= 32 then 4 else 8 fi
            when LLVM.Type.HALF then 2
            when LLVM.Type.FLOAT then 4
            when s: LLVM.Type.STRUCT then _struct_size(s)
            when a: LLVM.Type.ARRAY then a.count * size_of(a.element)
            else 8
            esac

        /// The alignment in bytes of a value of `type` as x86-64 lays it out.
        align_of(type: LLVM.Type) -> int static =>
            case type
            when s: LLVM.Type.STRUCT then s.fields |> Ghul.Pipes.reduce(1, (a, f) => if align_of(f) > a then align_of(f) else a fi)
            when a: LLVM.Type.ARRAY then align_of(a.element)
            else size_of(type)
            esac

        /// The offset in bytes of field `index` of `s` as x86-64 lays it out:
        /// each field at its natural alignment after the one before.
        ///
        /// - s: the structure
        /// - index: the field's position, from 0
        offset_of(s: LLVM.Type.STRUCT, index: int) -> int static is
            let offset mut = 0

            for i in 0..index + 1 do
                let alignment = align_of(s.fields[i])

                offset = (offset + alignment - 1) / alignment * alignment

                if i < index then
                    offset = offset + size_of(s.fields[i])
                fi
            od

            return offset
        si

        _struct_size(s: LLVM.Type.STRUCT) -> int static is
            if s.fields.count == 0 then
                return 0
            fi

            let last = s.fields.count - 1
            let whole = align_of(s)
            let offset = offset_of(s, last) + size_of(s.fields[last])

            return (offset + whole - 1) / whole * whole
        si
        /// The zero of `type`.
        zero(type: LLVM.Type) -> LLVM.Value static =>
            case type
            when LLVM.Type.FLOAT then LLVM.Values.of_single(0.0s)
            when LLVM.Type.DOUBLE then LLVM.Values.of_double(0.0)
            when _: LLVM.Type.POINTER then LLVM.Values.null_pointer
            when _: LLVM.Type.STRUCT then LLVM.Values.zero(type)
            else LLVM.Values.integer(type, bigint.zero)
            esac
    si
si
