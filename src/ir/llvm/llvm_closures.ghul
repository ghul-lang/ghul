namespace IR.LLVMTarget is
    use IR.Program

    use Collections.LIST
    use Collections.MAP

    use LLVM.BLOCK
    use LLVM.FUNCTION
    use LLVM.GLOBAL_VARIABLE
    use LLVM.Linkage
    use LLVM.MODULE
    use LLVM.PARAMETER
    use LLVM.Types
    use LLVM.Values

    /// How a closure's thunk reaches the function it calls.
    enum ThunkKind is
        /// The function takes no receiver, so the closure's is dropped.
        DROP_RECEIVER,

        /// The function takes the closure's receiver as its first argument.
        PASS_RECEIVER,

        /// The receiver's vtable slot holds the function.
        VIRTUAL,

        /// The receiver's row in the trait table holds the function.
        INTERFACE
    si

    /// Function values on the LLVM target. A closure is
    /// `{ ptr descriptor, ptr function, ptr receiver }`: calling it calls
    /// the function with the receiver, then the call's own arguments. The
    /// receiver is null for a function that takes none.
    ///
    /// The function a closure holds has exactly the signature its type calls
    /// through: a receiver, then the arguments, then the result. A function
    /// that does not, because it takes no receiver, answers a result the
    /// value's type discards, or is reached through a vtable or the trait
    /// table, is reached through a thunk that does.
    class LLVM_CLOSURES is
        _module: MODULE
        _objects: LLVM_OBJECTS
        _thunks: MAP[THUNK_KEY, FUNCTION]
        _unboxing: MAP[FUNCTION, FUNCTION]
        _referencing: MAP[FUNCTION, FUNCTION]
        _constants: MAP[FUNCTION, LLVM.Value]
        _is_used: bool

        /// The size of a closure in bytes.
        SIZE: int static => 24

        /// The offset of the function a closure calls.
        FUNCTION_OFFSET: int static => 8

        /// The offset of the receiver a closure passes.
        RECEIVER_OFFSET: int static => 16

        /// The name of the descriptor every closure carries.
        DESCRIPTOR_NAME: string static => "$closure.$descriptor"

        /// The class number a closure's descriptor holds, which falls in no
        /// class's range.
        CLASS_ID: int static => 0x7fffffff

        /// - module: where thunks and the descriptor are added
        /// - objects: the program's classes, whose vtables and trait table the thunks dispatch through
        init(module: MODULE, objects: LLVM_OBJECTS) is
            _module = module
            _objects = objects
            _thunks = MAP[THUNK_KEY, FUNCTION]()
            _unboxing = MAP[FUNCTION, FUNCTION]()
            _referencing = MAP[FUNCTION, FUNCTION]()
            _constants = MAP[FUNCTION, LLVM.Value]()
        si

        /// The descriptor every closure carries.
        descriptor: LLVM.Value is
            _is_used = true

            return Values.global(DESCRIPTOR_NAME)
        si

        /// The one closure holding `thunk` with no receiver, a constant every
        /// evaluation of a capture-free function literal yields, as the
        /// delegate .NET caches for it is. It lies outside the collected heap
        /// and holds no heap pointers, so the collector need not know of it.
        ///
        /// - thunk: the function the closure calls
        constant(thunk: FUNCTION) -> LLVM.Value is
            let found: LLVM.Value mut

            if _constants.try_get_value(thunk, found ref) then
                return found
            fi

            let type = Types.structure([Types.pointer, Types.pointer, Types.pointer])

            let global =
                GLOBAL_VARIABLE(
                    _objects.names.unique("{thunk.name}.$value"),
                    type,
                    LLVM.Value.AGGREGATE([descriptor, thunk.reference, Values.null_pointer], type),
                    true)

            global.linkage = Linkage.INTERNAL
            global.alignment = 8

            _module.add_global(global)

            let reference = global.reference

            _constants[thunk] = reference

            return reference
        si

        /// The function a closure of the function type `signature` holds to
        /// call `target`, the compiled function of `instance`, reached as
        /// `kind` says.
        ///
        /// - signature: the function type a call through the closure has
        /// - instance: the function the closure stands for
        /// - target: its compiled function, which only `DROP_RECEIVER` and `PASS_RECEIVER` call
        /// - kind: how the thunk reaches the function
        /// - offset: the vtable slot or trait table row a dispatching thunk reads
        thunk(signature: LLVM.Type.FUNCTION, instance: FUNCTION_INSTANCE, target: FUNCTION?, kind: ThunkKind, offset: int) -> FUNCTION? => thunk(signature, instance, target, kind, offset, null)

        /// As above, for a build whose cells are loaded into one process, where a
        /// dispatching thunk through a trait finds the receiver's table of that
        /// trait's methods by the trait's identity and reads it at `offset`.
        ///
        /// - trait_id: the global whose address stands for the trait, or null
        thunk(signature: LLVM.Type.FUNCTION, instance: FUNCTION_INSTANCE, target: FUNCTION?, kind: ThunkKind, offset: int, trait_id: string?) -> FUNCTION? is
            let discards = signature.result =~ LLVM.Type.VOID /\ !(target?.result =~ LLVM.Type.VOID ?? true)

            if kind == ThunkKind.PASS_RECEIVER /\ !discards /\ target? then
                if _same_signature(signature, target) then
                    return target
                fi
            fi

            let key = THUNK_KEY(instance, kind, signature)
            let found: FUNCTION mut

            if _thunks.try_get_value(key, found ref) then
                return found
            fi

            let parameters = LIST[PARAMETER]()

            for (i, type) in signature.parameters |> Ghul.Pipes.index() do
                parameters.add(PARAMETER(type, "a{i}"))
            od

            let thunk = FUNCTION(_objects.names.unique("{_objects.names.label(instance)}.$thunk"), signature.result, parameters.to_array())

            thunk.linkage = Linkage.INTERNAL

            let block = thunk.add_block("entry")
            let receiver = thunk.parameter(0)
            let arguments = LIST[LLVM.Value]()

            if kind != ThunkKind.DROP_RECEIVER then
                arguments.add(receiver)
            fi

            for i in 1..signature.parameters.count do
                arguments.add(thunk.parameter(i))
            od

            let result =
                case kind
                when ThunkKind.DROP_RECEIVER, ThunkKind.PASS_RECEIVER then
                    if let t = target then block.call(t, arguments.to_array()) else null fi
                else
                    _dispatch(block, signature, instance, receiver, kind, offset, trait_id, arguments)
                esac

            if signature.result =~ LLVM.Type.VOID then
                block.return_void()
            elif let r = result then
                block.return_value(r)
            else
                block.return_value(LLVM_TYPES.zero(signature.result))
            fi

            _module.add_function(thunk)

            _thunks[key] = thunk

            return thunk
        si

        // Calls through the receiver's vtable slot, or its row of the trait
        // table, at `offset`.
        _dispatch(
            block: BLOCK,
            signature: LLVM.Type.FUNCTION,
            instance: FUNCTION_INSTANCE,
            receiver: LLVM.Value,
            kind: ThunkKind,
            offset: int,
            trait_id: string?,
            arguments: LIST[LLVM.Value]
        ) -> LLVM.Value? is
            let descriptor = block.load(Types.pointer, receiver, 8)

            let entry =
                if kind == ThunkKind.VIRTUAL then
                    block.element_pointer(Types.i8, descriptor, [Values.i32(LLVM_OBJECTS.DESCRIPTOR_VTABLE + 8 * offset)], true)
                elif trait_id? then
                    let table = block.call(_objects.trait_table_function(), [receiver, Values.global(trait_id)])!

                    block.element_pointer(Types.pointer, table, [Values.i32(offset)], true)
                else
                    let class_id = block.load(Types.i32, descriptor, 8)
                    let index = block.binary(LLVM.BinaryOperator.ADD, LLVM.IntegerFlags.NONE, class_id, Values.i32(offset))

                    block.element_pointer(Types.pointer, Values.global(LLVM_OBJECTS.TRAIT_TABLE_NAME), [index], true)
                fi

            let function = block.load(Types.pointer, entry, 8)

            let called = _called_signature(instance)

            if !called? then
                return null
            fi

            let result = block.call(called, function, arguments.to_array())

            return if signature.result =~ LLVM.Type.VOID then null else result fi
        si

        // The signature of the method a dispatching thunk calls: the receiver,
        // its arguments and its result, at the instance's type arguments.
        _called_signature(instance: FUNCTION_INSTANCE) -> LLVM.Type? is
            let parameters = LIST[LLVM.Type]()

            parameters.add(Types.pointer)

            for argument in instance.definition.arguments do
                if let held = LLVM_TYPES.value_type(instance.specialize(argument)) then
                    parameters.add(held)
                else
                    return null
                fi
            od

            if let result = LLVM_TYPES.result_type(instance.specialize(instance.definition.return_type)) then
                return LLVM.Type.FUNCTION(result, parameters.to_array(), false)
            fi

            return null
        si

        /// The function a box's vtable slot or trait table entry holds for a
        /// method of the value it boxes, a scalar or a struct, whose receiver
        /// is the address of that value: it is called with the box, and calls
        /// `target` with the address of the value within it.
        ///
        /// - target: the method's compiled function
        unboxing_thunk(target: FUNCTION) -> FUNCTION is
            let found: FUNCTION mut

            if _unboxing.try_get_value(target, found ref) then
                return found
            fi

            let parameters = LIST[PARAMETER]()

            for (i, parameter) in target.parameters |> Ghul.Pipes.index() do
                parameters.add(PARAMETER(parameter.type, "a{i}"))
            od

            let thunk = FUNCTION(_objects.names.unique("{target.name}.$unboxed"), target.result, parameters.to_array())

            thunk.linkage = Linkage.INTERNAL

            let block = thunk.add_block("entry")
            let arguments = LIST[LLVM.Value]()

            arguments.add(block.element_pointer(Types.i8, thunk.parameter(0), [Values.i32(LLVM_OBJECTS.BOX_VALUE_OFFSET)], true))

            for i in 1..parameters.count do
                arguments.add(thunk.parameter(i))
            od

            let result = block.call(target, arguments.to_array())

            if target.result =~ LLVM.Type.VOID then
                block.return_void()
            else
                block.return_value(result!)
            fi

            _module.add_function(thunk)

            _unboxing[target] = thunk

            return thunk
        si
        /// The function a bigint's vtable slot holds for one of its
        /// methods. A bigint is a reference to its box, and its methods take
        /// the address of that reference: the thunk is called with the box,
        /// and calls `target` with the address of a slot holding it.
        ///
        /// - target: the method's compiled function
        referencing_thunk(target: FUNCTION) -> FUNCTION is
            let found: FUNCTION mut

            if _referencing.try_get_value(target, found ref) then
                return found
            fi

            let parameters = LIST[PARAMETER]()

            for (i, parameter) in target.parameters |> Ghul.Pipes.index() do
                parameters.add(PARAMETER(parameter.type, "a{i}"))
            od

            let thunk = FUNCTION(_objects.names.unique("{target.name}.$referencing"), target.result, parameters.to_array())

            thunk.linkage = Linkage.INTERNAL

            let block = thunk.add_block("entry")
            let slot = block.alloca(Types.pointer, 0)

            block.store(thunk.parameter(0), slot, 0)

            let arguments = LIST[LLVM.Value]()

            arguments.add(slot)

            for i in 1..parameters.count do
                arguments.add(thunk.parameter(i))
            od

            let result = block.call(target, arguments.to_array())

            if target.result =~ LLVM.Type.VOID then
                block.return_void()
            else
                block.return_value(result!)
            fi

            _module.add_function(thunk)

            _referencing[target] = thunk

            return thunk
        si

        _same_signature(signature: LLVM.Type.FUNCTION, target: FUNCTION) -> bool is
            if signature.parameters.count != target.parameters.count \/ !(signature.result =~ target.result) then
                return false
            fi

            for i in 0..signature.parameters.count do
                if !(signature.parameters[i] =~ target.parameters[i].type) then
                    return false
                fi
            od

            return true
        si

        /// Adds the closures' descriptor, where any closure was made. Its
        /// vtable is the root's, so a virtual call through `object` on a
        /// closure runs the root's method.
        finish(strings: LLVM_STRINGS, callee: (FUNCTION_INSTANCE) -> FUNCTION?) is
            if !_is_used then
                return
            fi

            let entries = _objects.root_vtable(callee)
            let vtable_type = LLVM.Type.ARRAY(entries.count, Types.pointer)

            let type = LLVM_OBJECTS.descriptor_struct(vtable_type)

            let superclass =
                if let root = _objects.root then Values.global(_objects.descriptor_name(root)) else Values.null_pointer fi

            let fields = LIST[LLVM.Value](
                [
                    Values.i32(CLASS_ID),
                    Values.i32(CLASS_ID),
                    superclass,
                    strings.literal("System.Delegate"),
                    Values.null_pointer,
                    _objects.type_object(DESCRIPTOR_NAME, strings.literal("System.Delegate")),
                    Values.i64(cast long(SIZE))
                ]
            )

            // A function value implements no trait table of its own.
            if CELL_LINK.is_active then
                fields.add(Values.null_pointer)
            fi

            fields.add(LLVM.Value.AGGREGATE(entries.to_array(), vtable_type))

            let initializer = LLVM.Value.AGGREGATE(fields.to_array(), type)

            let global = GLOBAL_VARIABLE(DESCRIPTOR_NAME, type, initializer, true)

            global.linkage = Linkage.INTERNAL
            global.alignment = 8

            _module.add_global(global)
        si
    si

    /// A thunk, told apart by the function it stands for, how it reaches it,
    /// and the signature it is called with.
    class THUNK_KEY(instance: FUNCTION_INSTANCE, kind: ThunkKind, signature: LLVM.Type) is
        =~(other: THUNK_KEY) -> bool pure =>
            instance =~ other.instance /\ kind == other.kind /\ signature =~ other.signature

        get_hash_code() -> int pure => instance.get_hash_code()
    si
si
