namespace IR.LLVMTarget is
    use Source.LOCATION

    // The C symbols the program's `@extern` declarations name, each with the
    // declaration that names it: the function called, and any function it
    // names to release a string. A link that finds no definition for one is
    // reported at that declaration.
    class EXTERN_SYMBOLS is
        _declared: Collections.MAP[string, LOCATION] static

        // Notes that the declaration at `location` names the C symbol `name`.
        note(name: string, location: LOCATION) static is
            if !_declared? then
                _declared = Collections.MAP[string, LOCATION]()
            fi

            if !_declared.contains_key(name) then
                _declared[name] = location
            fi
        si

        // The declaration that names the C symbol `name`, or null where no
        // `@extern` does.
        declaration_of(name: string) -> LOCATION? static =>
            if let declared = _declared /\ declared.contains_key(name) then declared[name] else null fi

        // The symbols a failed link left undefined, each as the linker named
        // it in a line of `message`.
        undefined_in(message: string) -> Collections.LIST[string] static is
            let result = Collections.LIST[string]()
            let marker = "undefined symbol: "

            for line in message.split(['\n']) do
                let at = line.index_of(marker)

                if at >= 0 then
                    let name = line.substring(at + marker.length).trim()

                    if name.length > 0 /\ !result.contains(name) then
                        result.add(name)
                    fi
                fi
            od

            return result
        si
    si
si
