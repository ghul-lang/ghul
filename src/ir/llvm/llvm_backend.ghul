namespace IR.LLVMTarget is
    use IR.Program

    use IO.File

    use Collections.LIST
    use Collections.MAP
    use Collections.STACK
    use Collections.SET

    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use LLVM.MODULE
    use LLVM.FUNCTION
    use LLVM.PARAMETER
    use LLVM.WRITER

    use Values.Value

    /// Writes the program as an LLVM module, and links an executable from it
    /// with `ghul-llvm` against the runtime.
    ///
    /// A body's lowering needs what only the whole program settles, so each
    /// body is kept as it is finished and lowered once the last has been
    /// handed over, in `end_assembly`.
    class LLVM_BACKEND: Backend is
        _bodies: MAP[Function, LIST[Value]]
        _order: LIST[Function]
        _frame_members: LIST[(frame: Classy, method: Function)]
        _enclosing: STACK[LIST[Value]?]
        _current: LIST[Value]?

        _entry_point: Function?
        _module: MODULE?
        _want_library: bool
        _debug_info: LLVM_DEBUG_INFO?
        _objects: LLVM_OBJECTS?

        // The functions the program's own sources compiled to, for the text
        // `--llvm-program-only` asks for.
        _program_functions: SET[FUNCTION]

        // The functions an earlier cell of the session defines, which this
        // build declares and does not compile.
        _prebuilt: SET[Function]

        init() is
            _bodies = MAP[Function, LIST[Value]]()
            _order = LIST[Function]()
            _frame_members = LIST[(frame: Classy, method: Function)]()
            _enclosing = STACK[LIST[Value]?]()
            _program_functions = SET[FUNCTION]()
            _prebuilt = SET[Function]()
        si

        /// Starts a module, discarding anything kept from an earlier one.
        install(module_name: string, module_version: string, want_library: bool) is
            reset()

            _want_library = want_library
        si

        reset() is
            _bodies.clear()
            _order.clear()
            _frame_members.clear()
            _enclosing.clear()
            _current = null
            _entry_point = null
            _module = null
            _program_functions.clear()
            _prebuilt.clear()
        si

        begin_assembly() is si

        /// Lowers every kept body the program reaches into the module `write`
        /// writes.
        end_assembly() is
            _module = _build_module()
        si

        add_resource(name: string, content: ubyte[]) is si

        /// Writes the module's text to `<path>.ll` and, for an executable,
        /// links it into `path` with `ghul-llvm`. The text is kept where
        /// `--llvm-output` names a file for it.
        write(path: string) is
            let module = _module

            if !module? then
                return
            fi

            if !CELL_LINK.is_active then
                _mark_declarations_local(module)
            fi

            let kept = IoC.CONTAINER.instance.build_flags.llvm_output

            // What `--llvm-output` keeps can be the program's functions
            // alone, while the module linked stays whole.
            let program_only = IoC.CONTAINER.instance.build_flags.want_llvm_program_only
            let copy = if program_only then null else kept fi

            if _want_library then
                _write_text(module, path, copy)
                _write_program_only(module, kept, program_only)
                return
            fi

            // Where only the module's text is wanted, it is all that is
            // written.
            if let k = kept /\ IoC.CONTAINER.instance.build_flags.want_llvm_no_link then
                _write_text(module, k, null)
                _write_program_only(module, kept, program_only)
                return
            fi

            let ll_path = "{path}.ll"

            // The text kept for `--llvm-output` may be the very file the
            // linker reads, which is then left in place.
            let is_kept = kept? /\ IO.Path.get_full_path(kept) =~ IO.Path.get_full_path(ll_path)

            _write_text(module, ll_path, copy)

            try
                LLVM_LINKER.link(ll_path, path, IoC.CONTAINER.instance.build_flags.llvm_optimisation_level)
            finally
                if !is_kept then
                    File.delete(ll_path)
                fi

                _write_program_only(module, kept, program_only)
            yrt
        si

        // A program is linked statically, so what it declares and the runtime
        // defines is at a fixed address, which the listing shows by calling
        // it directly. A cell resolves its externals against the host when
        // it is loaded, so its declarations stay preemptible.
        _mark_declarations_local(module: MODULE) is
            for function in module.functions do
                if function.is_declaration /\ function.linkage == LLVM.Linkage.EXTERNAL /\ !function.name.starts_with("llvm.") then
                    function.dso_local = true
                fi
            od

            for global in module.globals do
                if !global.initializer? /\ global.linkage == LLVM.Linkage.EXTERNAL then
                    global.dso_local = true
                fi
            od
        si

        // Writes the program's own functions to `kept` where only those are
        // to be kept.
        _write_program_only(module: MODULE, kept: string?, program_only: bool) is
            if let k = kept /\ program_only then
                File.write_all_text(k, WRITER.functions_text(module, f => _program_functions.contains(f)))
            fi
        si

        // Writes the module's text to `path`, and to `copy` too where that
        // names another file, a piece at a time as it is written, so the
        // text of the whole module is never held.
        _write_text(module: MODULE, path: string, copy: string?) is
            let writers = LIST[IO.TextWriter]()

            writers.add(IO.File.create_text(path))

            if let c = copy /\ IO.Path.get_full_path(c) !~ IO.Path.get_full_path(path) then
                writers.add(IO.File.create_text(c))
            fi

            // Each writer is flushed every megabyte or so rather than every
            // piece, so what a writer holds stays small without a file
            // operation for every function.
            let unflushed mut = 0

            try
                WRITER.write_module(module, text is
                    for writer in writers do
                        writer.write(text)
                    od

                    unflushed = unflushed + text.length

                    if unflushed > 1_000_000 then
                        for writer in writers do
                            writer.flush()
                        od

                        unflushed = 0
                    fi
                si)
            finally
                for writer in writers do
                    writer.dispose()
                od
            yrt
        si

        begin_body() is
            _enclosing.push(_current)
            _current = LIST[Value]()
        si

        begin_body(member: Symbol) is
            begin_body()
        si

        write(value: Value) is
            _current!.add(value)
        si

        /// Keeps the body for lowering. A function that provides an intrinsic
        /// has its body dropped, since a call to it lowers to the operation
        /// itself, except an array's members, for a call that reaches one
        /// through a trait, and a constructor intrinsic, which is called as
        /// the ordinary method it is.
        finish_body(function: Function) is
            if let operation = function.intrinsic_operation /\ !(operation.starts_with("array.") /\ function.is_instance) /\ !operation.starts_with("constructor.") then
                return
            fi

            if !_bodies.contains_key(function) then
                _order.add(function)
            fi

            _bodies[function] = _current!
        si

        /// Keeps a generator's or an asynchronous function's frame member as
        /// a method of the frame, which dispatch reaches as it reaches any
        /// other implementation. A member no trait the frame implements stands
        /// for is dropped: nothing on this target calls it.
        finish_frame_member_body(frame: Classy, member: FrameMember) is
            let method =
                if let generator: Semantic.Symbols.STATE_MACHINE_FRAME = frame then
                    FRAME_MEMBER_METHODS.method_for(generator, member)
                elif let asynchronous: Semantic.Symbols.ASYNC_STATE_MACHINE_FRAME = frame then
                    FRAME_MEMBER_METHODS.method_for(asynchronous, member)
                else
                    null
                fi

            if let m = method then
                _frame_members.add((frame, m))
                _order.add(m)
                _bodies[m] = _current!
            fi
        si

        /// Drops the initializer: a unit variant's one instance is a global
        /// whose fields are all zero, built where the module is finished.
        finish_unit_variant_initializer(variant: Classy) is si

        end_body() is
            assert _enclosing.count > 0 else "body ended without one begun"

            _current = _enclosing.pop()
        si

        abandon_bodies() is
            _enclosing.clear()
            _current = null
        si

        /// Always false: a unit variant's instance is built by the backend, not
        /// by an initializer the program runs.
        has_unit_variant_instance(variant: Classy) -> bool => false

        mark_entry_point(function: Function) is
            _entry_point = function
        si

        declare_prebuilt(function: Function) is
            _prebuilt.add(function)
        si

        _report(location: Source.LOCATION, construct: string) is
            IoC.CONTAINER.instance.logger.error(
                location,
                "code generation for {construct} is not supported on the llvm target")
        si

        // Finds every instance the program reaches through the program plan,
        // declaring an LLVM function for each the first time it is named,
        // then lowers each body into its function.
        _build_module() -> MODULE is
            let module = MODULE()
            let names = LLVM_NAMES()

            _debug_info = if IoC.CONTAINER.instance.build_flags.want_debug then LLVM_DEBUG_INFO(module) else null fi

            let worklist = FUNCTION_WORKLIST(f => _bodies.contains_key(f) \/ _prebuilt.contains(f))
            let declared = MAP[FUNCTION_INSTANCE, FUNCTION?]()

            let declare = (instance: FUNCTION_INSTANCE) -> FUNCTION? is
                let found: FUNCTION? mut

                if declared.try_get_value(instance, found ref) then
                    return found
                fi

                let function =
                    if worklist.add(instance)? then
                        _declare(instance, names.name_of(instance))
                    else
                        null
                    fi

                if let declared_function = function /\ PROGRAM_FUNCTIONS.contains(instance.definition) then
                    _program_functions.add(declared_function)
                fi

                declared[instance] = function

                return function
            si

            // An executable compiles what its entry point reaches; a library
            // compiles everything that is not generic, since anything can be
            // called from outside.
            if let entry = _entry_point then
                declare(FUNCTION_INSTANCE.of(entry))

                // The description of an exception nothing caught reads its
                // message.
                if let getter = LLVM_EXCEPTIONS.message_getter /\ _bodies.contains_key(getter) then
                    declare(FUNCTION_INSTANCE.of(getter))
                fi

                // A cell shows the value it ends on, as text the runtime writes.
                if CELL_LINK.is_active then
                    if let inspect = IR.Program.CORE_LIBRARY.inspect_function() /\ _bodies.contains_key(inspect) then
                        declare(FUNCTION_INSTANCE.of(inspect))
                    fi
                fi

                // A read through null that faults throws the null-reference
                // exception, made by its constructor.
                if let constructor = LLVM_EXCEPTIONS.null_reference_constructor /\ _bodies.contains_key(constructor) then
                    declare(FUNCTION_INSTANCE.of(constructor))
                fi

                // A later cell may call anything this one defines, so it is
                // all compiled, whether or not this cell calls it.
                if CELL_LINK.is_active then
                    for function in _order do
                        if CELL_LINK.is_exported(function) then
                            declare(FUNCTION_INSTANCE.of(function))
                        fi
                    od
                fi
            elif CELL_LINK.is_active then
                // A cell with nothing to run still defines what a later cell
                // calls, and nothing else: the whole library is not its to
                // compile.
                for function in _order do
                    if CELL_LINK.is_exported(function) then
                        declare(FUNCTION_INSTANCE.of(function))
                    fi
                od
            else
                for function in _order do
                    if !FUNCTION_BODIES.is_generic(function) then
                        declare(FUNCTION_INSTANCE.of(function))
                    fi
                od
            fi

            let container = IoC.CONTAINER.instance
            let object = cast Classy?(container.innate_symbol_lookup.get_object_type().symbol)
            let classes = CLASS_SET(object, LLVM_ARRAYS.holds_element(*), INNATE_CORE_CLASSES())
            let objects = LLVM_OBJECTS(module, names, classes, cast Classy?(container.innate_symbol_lookup.get_string_type().symbol))

            _objects = objects

            objects.collect(container.symbol_table.global_scope)

            for (frame, method) in _frame_members do
                objects.add_method(frame, method)
            od

            // A boxed enum answers to_string with its member names.
            for (_, boxed) in classes.boxes do
                if let `enum: Semantic.Symbols.ENUM_STRUCT = boxed.symbol, (method, body) = ENUM_BOX_METHODS.to_string_for(`enum) then
                    objects.add_method(`enum, method)
                    _bodies[method] = body
                    _order.add(method)
                fi
            od

            let display = DISPLAY_PLAN(objects, classes.core)

            let plan =
                PROGRAM_PLAN(
                    classes,
                    worklist,
                    objects.dispatched,
                    display,
                    _order)

            objects.reach = instance => declare(instance)

            objects.declare_external = instance => _declare_external(module, names, instance)

            let discovery_module = MODULE()
            let discovery_strings = LLVM_STRINGS(discovery_module)
            let discovery_arrays = LLVM_ARRAYS(discovery_module, discovery_strings, classes, objects)

            plan.discover(
                LLVM_DISCOVERY(
                    objects,
                    instance => _reach(discovery_module, discovery_strings, discovery_arrays, objects, instance, declare),
                    (location, construct) => _report(location, construct)))

            worklist.seal()

            objects.build()
            objects.exact.solve()

            if let debug_info = _debug_info then
                debug_info.objects = objects
            fi

            let strings = LLVM_STRINGS(module, names)
            let arrays = LLVM_ARRAYS(module, strings, classes, objects)
            let closures = LLVM_CLOSURES(module, objects)

            objects.closures = closures

            let callee = (instance: FUNCTION_INSTANCE) -> FUNCTION? is
                let found: FUNCTION? mut

                declared.try_get_value(instance, found ref)

                return found
            si

            worklist.restart()

            while let instance = worklist.next() do
                if let function = callee(instance) then
                    function.linkage = _linkage_of(instance)

                    module.add_function(function)

                    // An earlier cell defines it: only declared here.
                    if !_prebuilt.contains(instance.definition) then
                        _lower(module, strings, arrays, objects, instance, function, callee)
                    fi
                fi
            od

            LLVM_DISPLAY(module, objects, display, strings, callee).add()

            objects.finish(strings, callee)

            if !objects.has_string_type then
                strings.add_placeholder_descriptor()
            fi

            closures.finish(strings, callee)

            for (location, construct) in objects.unsupported do
                _report(location, construct)
            od

            if let entry = _entry_point then
                _add_entry(module, strings, arrays, entry, callee(FUNCTION_INSTANCE.of(entry)), if let inspect = IR.Program.CORE_LIBRARY.inspect_function() then callee(FUNCTION_INSTANCE.of(inspect)) else null fi)

                strings.add_exports()
                arrays.add_exports()

                let getter = LLVM_EXCEPTIONS.message_getter

                LLVM_EXCEPTIONS.add_report_unhandled(module, strings, if let g = getter then callee(FUNCTION_INSTANCE.of(g)) else null fi)

                if let c = LLVM_EXCEPTIONS.null_reference_constructor,
                    type = objects.class_of(IR.Program.CORE_LIBRARY.exception_class(Semantic.Lookups.RuntimeException.NULL_REFERENCE)!, MAP[Semantic.Symbols.Symbol, Semantic.Types.Type]()),
                    constructor = callee(FUNCTION_INSTANCE.of(c))
                then
                    LLVM_EXCEPTIONS.add_make_null_reference(module, strings, objects, type, constructor)
                fi
            fi

            _debug_info?.finish()

            return module
        si

        // Whether the function is written in a source library, as against one
        // a program wrote or the compiler made.
        _is_library_function(definition: Function) -> bool is
            let location = PROGRAM_FUNCTIONS.source_location(definition)

            if location.is_internal \/ location.is_reflected \/ location.is_unknown then
                return false
            fi

            return !PROGRAM_FUNCTIONS.contains(definition)
        si

        // Declares `instance` as a function another cell defines, for a table
        // that points at it before that cell is loaded.
        _declare_external(module: MODULE, names: LLVM_NAMES, instance: FUNCTION_INSTANCE) -> FUNCTION? is
            let function = _declare(instance, names.name_of(instance), true)

            if let declared = function then
                declared.linkage = LLVM.Linkage.EXTERNAL

                module.add_function(declared)
            fi

            return function
        si

        // How `instance` is linked. An executable keeps its functions to itself,
        // and a library exports them. A cell of a session exports the
        // functions it defines for the cells after it, names those an
        // earlier cell defines, and leaves what any cell may need, a generic
        // instance or library code, to whichever is loaded first.
        _linkage_of(instance: FUNCTION_INSTANCE) -> LLVM.Linkage is
            let definition = instance.definition

            if CELL_LINK.is_active then
                if _prebuilt.contains(definition) \/ CELL_LINK.is_exported(definition) then
                    return LLVM.Linkage.EXTERNAL
                elif !definition.is_closure /\ (instance.type_map.count > 0 \/ _is_library_function(definition)) then
                    return LLVM.Linkage.WEAK
                fi

                return LLVM.Linkage.INTERNAL
            fi

            return if _want_library then LLVM.Linkage.EXTERNAL else LLVM.Linkage.INTERNAL fi
        si

        // Lowers `instance`'s body into a copy of its function in `module`,
        // which is thrown away, so every instance it calls is declared.
        _reach(
            module: MODULE,
            strings: LLVM_STRINGS,
            arrays: LLVM_ARRAYS,
            objects: LLVM_OBJECTS,
            instance: FUNCTION_INSTANCE,
            declare: (FUNCTION_INSTANCE) -> FUNCTION?
        ) is
            // The plan adds implementations a dispatched call can reach without
            // naming them, so an instance can arrive here undeclared.
            if _prebuilt.contains(instance.definition) then
                return
            fi

            if let found = declare(instance) then
                let copy = FUNCTION(found.name, found.result, found.parameters |> Ghul.Pipes.collect())

                LLVM_LOWERING(module, copy, instance, instance.specialize(instance.definition.return_type), declare, strings, arrays, objects)
                    .lower(_bodies[instance.definition])
            fi
        si

        /// The name of the function the runtime starts the program at, which
        /// takes nothing and returns the exit status.
        ENTRY_NAME: string static => "$ghul_entry"

        /// The global the runtime defines for the ABI version the program is
        /// compiled for, which a runtime of any other version lacks.
        ABI_CHECK_NAME: string static => "$ghul_abi_4"

        // Exports `$ghul_entry`, which calls the entry point and returns the
        // exit status it answers, or zero for an entry point that answers
        // nothing. An entry point taking a `string[]` is handed the
        // command-line arguments, read through the runtime's host operations.
        // It reads the runtime's ABI marker, so a program linked against a
        // runtime of another ABI version fails to link rather than failing
        // when it runs.
        _add_entry(module: MODULE, strings: LLVM_STRINGS, arrays: LLVM_ARRAYS, entry: Function, compiled: FUNCTION?, inspect: FUNCTION?) is
            let string_array: CLASS_INSTANCE? mut

            if entry.arguments.count == 1 then
                string_array = arrays.array_of(entry.arguments[0])

                if !string_array? \/ !LLVM_TYPES.is_string(arrays.element_of(string_array)) then
                    _report(entry.location, "an entry point taking {entry.arguments[0]}")
                    return
                fi
            elif entry.arguments.count > 1 then
                _report(entry.location, "an entry point that takes more than one argument")
                return
            fi

            if !compiled? then
                return
            fi

            let wrapper = FUNCTION(ENTRY_NAME, LLVM.Types.i32, [])
            let block mut = wrapper.add_block("entry")

            let marker = LLVM.GLOBAL_VARIABLE(ABI_CHECK_NAME, LLVM.Types.i32, null, true)

            module.add_global(marker)

            let read = wrapper.fresh_name()

            block.append(LLVM.Operation.LOAD(read, LLVM.Types.i32, marker.reference, 4, true), LLVM.Values.local(LLVM.Types.i32, read))

            let arguments = LIST[LLVM.Value]()

            if let type = string_array then
                arguments.add(_command_line(wrapper, block, strings, arrays, type))

                block = wrapper.blocks[wrapper.blocks.count - 1]
            fi

            // A cell's entry answers the value of its final expression, which
            // is not an exit status: it is written as text instead, after the
            // byte 0x02, to the standard output, for a host to show.
            let produced = block.call(compiled, arguments.to_array())

            if let value = produced /\ CELL_LINK.is_active /\ compiled.result !~ LLVM.Types.i32 then
                if let describe = inspect then
                    let show = wrapper.add_block("show_value")
                    let done = wrapper.add_block("value_shown")
                    let write = strings.runtime(LLVM_STRINGS.host_name("write"), LLVM.Type.VOID, [LLVM.Types.pointer, LLVM.Types.i32, LLVM.Types.i32])

                    block.branch(block.compare(LLVM.IntegerPredicate.NE, value, LLVM.Values.null_pointer), show, done)

                    let text = show.call(describe, [value])!

                    for piece in ["\u0002"] do
                        let literal = strings.literal(piece)

                        show.call(write, [strings.chars(show, literal), strings.length(show, literal), LLVM.Values.integer(LLVM.Types.i32, bigint.one)])
                    od

                    show.call(write, [strings.chars(show, text), strings.length(show, text), LLVM.Values.integer(LLVM.Types.i32, bigint.one)])

                    let newline = strings.literal("\n")

                    show.call(write, [strings.chars(show, newline), strings.length(show, newline), LLVM.Values.integer(LLVM.Types.i32, bigint.one)])
                    show.branch(done)

                    done.return_value(LLVM.Values.integer(LLVM.Types.i32, bigint.zero))
                else
                    block.return_value(LLVM.Values.integer(LLVM.Types.i32, bigint.zero))
                fi
            elif let result = produced /\ !(CELL_LINK.is_active /\ compiled.result !~ LLVM.Types.i32) then
                block.return_value(result)
            else
                block.return_value(LLVM.Values.integer(LLVM.Types.i32, bigint.zero))
            fi

            module.add_function(wrapper)
        si

        // Builds a `string[]` of the command-line arguments, starting in
        // `block` and leaving the wrapper's last block to carry on in.
        _command_line(wrapper: FUNCTION, block: LLVM.BLOCK, strings: LLVM_STRINGS, arrays: LLVM_ARRAYS, type: CLASS_INSTANCE) -> LLVM.Value is
            let i32 = LLVM.Types.i32

            let count = block.call(strings.runtime(LLVM_STRINGS.host_name("argument_count"), i32, []), [])!
            let result = arrays.allocate(block, type, count)
            let index = block.alloca(i32, 4)

            block.store(LLVM.Values.i32(0), index, 4)

            let test = wrapper.add_block("test")
            let body = wrapper.add_block("body")
            let done = wrapper.add_block("done")

            block.branch(test)

            let at = test.load(i32, index, 4)

            test.branch(test.compare(LLVM.IntegerPredicate.SLT, at, count), body, done)

            let current = body.load(i32, index, 4)
            let argument = body.call(strings.runtime(LLVM_STRINGS.host_name("argument"), LLVM.Types.pointer, [i32]), [current])!

            arrays.store(body, type, result, current, argument)

            body.store(body.binary(LLVM.BinaryOperator.ADD, LLVM.IntegerFlags.NONE, current, LLVM.Values.i32(1)), index, 4)
            body.branch(test)

            return result
        si

        // The LLVM type a value of `type` is held in, a struct and an
        // optional value type included once the classes are known.
        _held(type: Semantic.Types.Type?) -> LLVM.Type? =>
            if let objects = _objects then objects.held_type(type) else LLVM_TYPES.value_type(type) fi

        // The LLVM function an instance is compiled into, with no body yet,
        // or null, reported, where its signature has a type the target holds
        // no values of.
        _declare(instance: FUNCTION_INSTANCE, name: string) -> FUNCTION? => _declare(instance, name, false)

        // `is_quiet` leaves a signature the target holds no values of unreported,
        // for a function declared only so a table can point at it.
        _declare(instance: FUNCTION_INSTANCE, name: string, is_quiet: bool) -> FUNCTION? is
            let definition = instance.definition

            let parameters = LIST[PARAMETER]()

            // A struct method's receiver is the address of the struct, so
            // the method changes it in place, as on .NET.
            if definition.is_emitted_with_receiver then
                parameters.add(PARAMETER(LLVM.Types.pointer, "self"))
            fi

            for (i, argument) in definition.arguments |> Ghul.Pipes.index() do
                if let type = _held(instance.specialize(argument)) then
                    parameters.add(PARAMETER(type, "a{i}"))
                else
                    if !is_quiet then
                        _report(definition.location, "an argument of type {argument}")
                    fi

                    return null
                fi
            od

            let return_type = instance.specialize(definition.return_type)
            let result = if LLVM_TYPES.is_void(return_type) then LLVM.Type.VOID else _held(return_type) fi

            if !result? then
                if !is_quiet then
                    _report(definition.location, "a result of type {definition.return_type}")
                fi

                return null
            fi

            return FUNCTION(name, result, parameters.to_array())
        si

        _lower(module: MODULE, strings: LLVM_STRINGS, arrays: LLVM_ARRAYS, objects: LLVM_OBJECTS, instance: FUNCTION_INSTANCE, function: FUNCTION, callee: (FUNCTION_INSTANCE) -> FUNCTION?) is
            let definition = instance.definition

            let lowering = LLVM_LOWERING(module, function, instance, instance.specialize(definition.return_type), callee, strings, arrays, objects)

            if let debug = _debug_info then
                lowering.debug_info = debug
                // A function the compiler made from source the program
                // wrote, as the entry made from a file's top-level
                // statements is, has an internal name; it is placed at the
                // source it was made from, so its statements keep their
                // lines.
                let location = if definition.location.is_internal /\ !definition.span.is_internal then definition.span else definition.location fi

                lowering.debug_scope = debug.subprogram(function, instance.to_string(), location)
            fi

            lowering.lower(_bodies[definition])

            for construct in lowering.unsupported do
                _report(definition.location, construct)
            od
        si

    si

    // Finds a program's reach by lowering each body it reaches into a
    // module that is thrown away.
    class LLVM_DISCOVERY(
        objects: LLVM_OBJECTS private,
        reach: (FUNCTION_INSTANCE) -> void private,
        report: (Source.LOCATION, string) -> void private
    ): DiscoveryTarget is
        reach(instance: FUNCTION_INSTANCE) => _reach(instance)

        is_instantiated(type: CLASS_INSTANCE) -> bool => _objects.is_instantiated(type)

        note_instantiated(type: CLASS_INSTANCE) => _objects.note_instantiated(type)

        report(location: Source.LOCATION, construct: string) => _report(location, construct)
    si
si
