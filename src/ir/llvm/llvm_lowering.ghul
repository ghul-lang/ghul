namespace IR.LLVMTarget is
    use IR.Program

    use Collections.LIST
    use Collections.MAP

    use Semantic.Types.Type
    use Semantic.Symbols.Function

    use LLVM.BinaryOperator
    use LLVM.BLOCK
    use LLVM.Conversion
    use LLVM.FloatPredicate
    use LLVM.FUNCTION
    use LLVM.IntegerFlags
    use LLVM.IntegerPredicate
    use LLVM.Intrinsics
    use LLVM.MODULE
    use LLVM.Types
    use LLVM.FastMath

    use Values.Value

    /// Lowers the IR values of one function body into the blocks of an
    /// LLVM function. A construct it cannot lower yet is recorded in
    /// `unsupported` rather than thrown.
    ///
    /// Every local, argument and temporary lives in an `alloca` in the entry
    /// block, which LLVM promotes to registers, so nothing here builds SSA
    /// form. The values the IR leaves on CIL's evaluation stack are kept on
    /// a stack of LLVM values while the body is lowered.
    class LLVM_LOWERING: Values.Visitor is
        _module: MODULE
        _function: FUNCTION
        _instance: FUNCTION_INSTANCE?
        _type_map: Collections.Map[Semantic.Symbols.Symbol, Type]
        _return_type: Type?
        _await_structures: MAP[Values.AWAIT_SUSPEND, Values.REGION]
        _callee: (FUNCTION_INSTANCE) -> FUNCTION?
        _scalars: (Type?) -> Scalar?
        _is_string: (Type?) -> bool
        _strings: LLVM_STRINGS?
        _arrays: LLVM_ARRAYS?
        _objects: LLVM_OBJECTS?
        _receiver_offset: int

        _entry: BLOCK
        _block: BLOCK
        _is_terminated: bool
        _next_block: int

        _stack: LIST[LLVM.Value]

        // The calls of the `for` loops lowered over their storage.
        _counted_loops: MAP[Value, COUNTED_LOOP]

        // Receivers already lowered, each for the one value that reads it.
        _preevaluated: MAP[Value, LLVM.Value]

        // Where each value with a known exact-class source came from.
        _sources: MAP[LLVM.Value, EXACT_SOURCE]

        // The values that are nulls the program wrote or defaults.
        _nulls: Collections.SET[LLVM.Value]

        // The shallowest the stack has been since the innermost _value_of
        // began, so a value that reads an operand already on the stack, as
        // a member load reads its receiver, still counts as producing one.
        _low_water: int

        _locals: MAP[LOCAL, (pointer: LLVM.Value, type: LLVM.Type)]
        _arguments: LIST[(pointer: LLVM.Value, type: LLVM.Type, value_type: Type?)]

        // The structured nodes open at the point being lowered, innermost
        // last: each node's continuation, and a loop's header after it, which
        // is where a CONTINUE goes. A region that produces a value has an
        // `alloca` each arm stores it into, and `depth` is how deep the value
        // stack was when the node began.
        _labels: LIST[(node: Values.Breakable, is_loop_head: bool, target: BLOCK, result: LLVM.Value?, depth: int)]

        // The try being lowered's landing pad, which calls unwind to, or null
        // outside every try.
        _unwind: BLOCK?

        // Where each catch being lowered keeps the exception it caught,
        // innermost last.
        _caught: LIST[LLVM.Value]

        // The position on the label stack of each try with a finally whose
        // protected body is being lowered, with the slot an exit leaving it
        // records its number in and the numbers given out.
        _finally_exits: MAP[int, (selector: LLVM.Value, exits: IR.Program.EXIT_NUMBERING)]

        // The block of each resume point, made where a dispatch or the point
        // itself is first lowered.
        _resume_blocks: MAP[IR.LABEL, BLOCK]

        _unsupported: LIST[string]

        /// Where the debug information is recorded, or null where the module
        /// carries none.
        debug_info: LLVM_DEBUG_INFO? public

        /// The subprogram the function's locations are scoped to, where it
        /// carries debug information.
        debug_scope: LLVM.Metadata? public

        _debug_location: LLVM.Metadata?
        _debug_position: Source.LOCATION?
        _debug_line: int
        _debug_column: int

        /// The kinds of construct the lowered values used that this target
        /// cannot generate yet, each once, in the order they were met. A body
        /// with any is not a valid function.
        unsupported: string[] => _unsupported

        /// - module: where intrinsics the body calls are declared
        /// - function: the function the body is lowered into, with no blocks yet
        /// - instance: the function instance the body belongs to, or null where it belongs to none
        /// - return_type: the type the function returns
        /// - callee: the LLVM function a call to an instance names, or null where it cannot be called
        /// - strings: where string literals and the runtime's functions are declared, or null where strings are not lowered
        /// - arrays: where array descriptors are declared, or null where arrays are not lowered
        /// - objects: the program's classes, or null where objects are not lowered
        init(
            module: MODULE,
            function: FUNCTION,
            instance: FUNCTION_INSTANCE?,
            return_type: Type?,
            callee: (FUNCTION_INSTANCE) -> FUNCTION?,
            strings: LLVM_STRINGS?,
            arrays: LLVM_ARRAYS?,
            objects: LLVM_OBJECTS?
        ) is
            self.init(module, function, instance, return_type, callee, strings, arrays, objects, LLVM_TYPES.scalar(*), LLVM_TYPES.is_string(*))
        si

        /// - module: where intrinsics the body calls are declared
        /// - function: the function the body is lowered into, with no blocks yet
        /// - instance: the function instance the body belongs to, or null where it belongs to none
        /// - return_type: the type the function returns
        /// - callee: the LLVM function a call to an instance names, or null where it cannot be called
        /// - strings: where string literals and the runtime's functions are declared, or null where strings are not lowered
        /// - arrays: where array descriptors are declared, or null where arrays are not lowered
        /// - objects: the program's classes, or null where objects are not lowered
        /// - scalars: the scalar kind a value of a type is, or null where it is not a scalar
        /// - is_string: whether a type is `string`
        init(
            module: MODULE,
            function: FUNCTION,
            instance: FUNCTION_INSTANCE?,
            return_type: Type?,
            callee: (FUNCTION_INSTANCE) -> FUNCTION?,
            strings: LLVM_STRINGS?,
            arrays: LLVM_ARRAYS?,
            objects: LLVM_OBJECTS?,
            scalars: (Type?) -> Scalar?,
            is_string: (Type?) -> bool
        ) is
            _strings = strings
            _arrays = arrays
            _objects = objects
            _receiver_offset = if instance?.definition?.is_emitted_with_receiver ?? false then 1 else 0 fi
            _scalars = scalars
            _is_string = is_string
            _module = module
            _function = function
            _instance = instance
            _type_map = if let i = instance then TYPE_MAPS.body_map(i) else MAP[Semantic.Symbols.Symbol, Type]() fi
            _return_type = return_type
            _callee = callee

            _stack = LIST[LLVM.Value]()
            _counted_loops = MAP[Value, COUNTED_LOOP](Collections.ReferenceEqualityComparer.instance)
            _preevaluated = MAP[Value, LLVM.Value](Collections.ReferenceEqualityComparer.instance)
            _sources = MAP[LLVM.Value, EXACT_SOURCE](Collections.ReferenceEqualityComparer.instance)
            _nulls = Collections.SET[LLVM.Value](Collections.ReferenceEqualityComparer.instance)
            _locals = MAP[LOCAL, (pointer: LLVM.Value, type: LLVM.Type)]()
            _arguments = LIST[(pointer: LLVM.Value, type: LLVM.Type, value_type: Type?)]()
            _labels = LIST[(node: Values.Breakable, is_loop_head: bool, target: BLOCK, result: LLVM.Value?, depth: int)]()
            _caught = LIST[LLVM.Value]()
            _await_structures = MAP[Values.AWAIT_SUSPEND, Values.REGION]()
            _finally_exits = MAP[int, (selector: LLVM.Value, exits: IR.Program.EXIT_NUMBERING)]()
            _resume_blocks = MAP[IR.LABEL, BLOCK]()
            _unsupported = LIST[string]()

            _entry = function.add_block("entry")
            _block = _entry
        si

        /// Lowers the body into the function. Afterwards every block ends in
        /// exactly one terminator.
        lower(values: Collections.Iterable[Value]) is
            // An instruction before the body's first position, such as an
            // argument's spill, is placed at the function's declaration.
            if let instance = _instance then
                _note_position(instance.definition.location)
                _entry.debug_location = _debug_location
            fi

            // Each argument is spilled to a slot of the width its type is stored
            // at, so its address means the same as any other location's.
            for (i, parameter) in _function.parameters |> Ghul.Pipes.index() do
                let value_type = _argument_type(i)
                let stored = if let scalar = _scalar(value_type) then LLVM_TYPES.stored_type(scalar) else parameter.type fi
                let pointer = _entry.alloca(stored, 0)

                _entry.store(_narrow_in(_entry, parameter.value, value_type), pointer, 0)
                _arguments.add((pointer, stored, value_type))
            od

            _declare_arguments()

            let start = _new_block()

            _start(start)

            for value in values do
                gen(value)
            od

            // A body that falls off its end returns what it leaves, or the
            // default value of its result where it leaves nothing.
            if !_is_terminated then
                _return()
            fi

            _entry.branch(start)

            _elide_dominated_guards()
        si

        /// Lowers one value. An absent value lowers to nothing. Where the
        /// function carries debug information, what it emits is recorded
        /// against the value's source position.
        gen(value: Value?) is
            if value? then
                if value.has_location then
                    _note_position(value.location)
                fi

                if _counted_loops.count > 0 /\ _lower_counted(value) then
                    return
                fi

                value.accept(self)
            fi
        si

        // Each argument is declared to a debugger as the variable it is, in
        // the slot it is spilled to.
        _declare_arguments() is
            let info = debug_info
            let scope = debug_scope
            let instance = _instance

            if !info? \/ !scope? \/ !instance? \/ !_debug_location? then
                return
            fi

            let definition = instance.definition

            for i in 0.._arguments.count do
                let (name, type) =
                    if i < _receiver_offset then
                        ("self", null)
                    elif i - _receiver_offset < definition.argument_names.count then
                        (definition.argument_names[i - _receiver_offset], instance.specialize(definition.arguments[i - _receiver_offset]))
                    else
                        continue
                    fi

                _entry.declare(_arguments[i].pointer, info.variable(name, i + 1, scope, definition.location, type), _debug_location!)
            od
        si

        // A local the source names is declared to a debugger, under the name
        // it has in the source. One the compiler made up starts with a `.`.
        _declare_local(local: LOCAL, pointer: LLVM.Value) is
            if let info = debug_info, scope = debug_scope, position = _debug_position, location = _debug_location then
                if local.name.starts_with('.') \/ local.name.length == 0 then
                    return
                fi

                let dot = local.name.last_index_of('.')
                let name = if dot > 0 then local.name.substring(0, dot) else local.name fi

                _entry.declare(pointer, info.variable(name, 0, scope, position, _specialize(local.type)), location)
            fi
        si

        _note_position(location: Source.LOCATION) is
            if let info = debug_info, scope = debug_scope then
                _debug_position = location

                if location.start_line != _debug_line \/ location.start_column != _debug_column then
                    _debug_line = location.start_line
                    _debug_column = location.start_column
                    _debug_location = info.location(location, scope)
                    _block.debug_location = _debug_location
                fi
            fi
        si

        _report(construct: string) is
            if !_unsupported.contains(construct) then
                _unsupported.add(construct)
            fi
        si

        _specialize(type: Type?) -> Type? => TYPE_MAPS.specialize(type, _type_map)

        _scalar_of(type: Type?) -> Scalar? => _scalars(type)

        _scalar(type: Type?) -> Scalar? => _scalar_of(_specialize(type))

        _held(type: Type?) -> LLVM.Type? =>
            if isa Semantic.Types.REFERENCE(_specialize(type)) then
                Types.pointer
            elif let inner = _value_optional_inner(type) then
                _optional_type(inner)
            elif let scalar = _scalar(type) then
                LLVM_TYPES.value_type(scalar)
            elif _is_string(_specialize(type)) \/ LLVM_TYPES.is_array(_specialize(type)) \/ LLVM_TYPES.is_object_reference(_specialize(type)) then
                Types.pointer
            else
                _objects?.held_type(_specialize(type))
            fi

        // The type a value of `type` is stored as in memory: a scalar at the
        // width of its kind, anything else as it is held.
        _stored(type: Type?) -> LLVM.Type? =>
            if let scalar = _scalar(type) then LLVM_TYPES.stored_type(scalar) else _held(type) fi

        // `value` of `type` as loaded from memory, widened to the width it is
        // computed with.
        _widen(value: LLVM.Value, type: Type?) -> LLVM.Value =>
            if let scalar = _scalar(type) then LLVM_TYPES.widen(_current, value, scalar) else value fi

        // `value` of `type` narrowed to the width it is stored at.
        _narrow(value: LLVM.Value, type: Type?) -> LLVM.Value => _narrow_in(_current, value, type)

        _narrow_in(block: BLOCK, value: LLVM.Value, type: Type?) -> LLVM.Value =>
            if let scalar = _scalar(type) then LLVM_TYPES.narrow(block, value, scalar) else value fi

        // A value of `type` loaded from `pointer`, which holds it as stored.
        _load_stored(type: Type?, pointer: LLVM.Value) -> LLVM.Value? =>
            if let stored = _stored(type) then _widen(_current.load(stored, pointer, 0), type) else null fi

        // Stores `value` of `type` at `pointer`, at the width it is stored at.
        _store_stored(value: LLVM.Value, type: Type?, pointer: LLVM.Value) is
            _current.store(_narrow(value, type), pointer, 0)
        si

        // The member at `index` of an aggregate held in place, a struct, a
        // tuple or an optional value type, whose type is `member`.
        _extract_member(aggregate: LLVM.Value, index: int, member: Type?) -> LLVM.Value =>
            _widen(_current.extract_value(_stored(member)!, aggregate, [index]), member)

        // `aggregate` with its member at `index`, of type `member`, replaced.
        _insert_member(aggregate: LLVM.Value, value: LLVM.Value, index: int, member: Type?) -> LLVM.Value =>
            _current.insert_value(aggregate, _narrow(value, member), [index])

        // The type of the argument at `index` among the function's
        // parameters, or null for the receiver or where there is no instance.
        _argument_type(index: int) -> Type? is
            if let instance = _instance then
                let at = index - _receiver_offset

                if at >= 0 /\ at < instance.definition.arguments.count then
                    return instance.specialize(instance.definition.arguments[at])
                fi
            fi

            return null
        si

        // The block instructions go into, opened afresh where the last one
        // ended in a terminator: code after an unconditional exit is
        // unreachable, but every block needs exactly one terminator.
        _current: BLOCK is
            if _is_terminated then
                _start(_new_block())
            fi

            return _block
        si

        _new_block() -> BLOCK is
            let block = _function.add_block("b{_next_block}")

            _next_block = _next_block + 1

            return block
        si

        _start(block: BLOCK) is
            _block = block
            block.debug_location = _debug_location
            _is_terminated = false
        si

        _branch(target: BLOCK) is
            _current.branch(target)
            _is_terminated = true
        si

        _push(value: LLVM.Value) is
            _stack.add(value)
        si

        _pop() -> LLVM.Value? is
            if _stack.count == 0 then
                _report("a value the lowering did not produce")
                return null
            fi

            let value = _stack[_stack.count - 1]

            _stack.remove_at(_stack.count - 1)

            if _stack.count < _low_water then
                _low_water = _stack.count
            fi

            return value
        si

        _peek() -> LLVM.Value? =>
            if _stack.count > 0 then _stack[_stack.count - 1] else null fi

        // Lowers `value` and takes what it produces off the stack.
        _value_of(value: Value) -> LLVM.Value? is
            if _preevaluated.count > 0 then
                let ready: LLVM.Value mut

                if _preevaluated.try_get_value(value, ready ref) then
                    _preevaluated.remove(value)

                    return ready
                fi
            fi

            // A value already on the stack, or its address there, is taken
            // from it: lowering one leaves the stack as deep as it was.
            let inner = if let address: Values.ADDRESS = value then address.value else value fi

            if isa Values.STACK_TOP(inner) \/ isa Values.STACK_TOP_ADDRESS(inner) then
                return _pop()
            fi

            let outer_low_water = _low_water

            _low_water = _stack.count

            gen(value)

            let produced = _stack.count > _low_water

            if _low_water > outer_low_water then
                _low_water = outer_low_water
            fi

            if !produced then
                if _unsupported.count == 0 then
                    _report("a value that produces nothing")
                fi

                return null
            fi

            return _pop()
        si

        // An `alloca` in the entry block, holding the zero of `type` from the
        // start, as a .NET local holds a zeroed value.
        _slot(type: LLVM.Type) -> LLVM.Value is
            let pointer = _entry.alloca(type, 0)

            _entry.store(LLVM_TYPES.zero(type), pointer, 0)

            return pointer
        si

        _local(local: LOCAL) -> (pointer: LLVM.Value, type: LLVM.Type)? is
            let found: (pointer: LLVM.Value, type: LLVM.Type) mut

            if _locals.try_get_value(local, found ref) then
                return found
            fi

            if let type = _stored(local.type) then
                let slot = (pointer = _slot(type), type = type)

                _locals[local] = slot

                _declare_local(local, slot.pointer)

                return slot
            fi

            _report("a local of type {local.type}")

            return null
        si

        _local_address(local: LOCAL) is
            _note_store(local, null)

            if let (pointer, _) = _local(local) then
                _push(pointer)
            fi
        si

        // `value` where it is an address, and otherwise a new place holding
        // it. Null stays null.
        _held_in_place(value: LLVM.Value?) -> LLVM.Value? is
            if !value? \/ isa LLVM.Type.POINTER(value.type) then
                return value
            fi

            let slot = _slot(value.type)

            _current.store(value, slot, 0)

            return slot
        si

        // The address of `value`, for a struct method's receiver or a field
        // of a struct. A value with a place of its own is reached where it
        // is, so a method changes it there; any other is copied into a new
        // place first, as .NET copies a temporary.
        _address_of(value: Value) -> LLVM.Value? is
            // A receiver the IR already gives as an address is that address.
            // Where what the stack holds is the value itself, as the payload a
            // coalescing access unwraps is, it is copied into a new place.
            if isa Values.STACK_TOP_ADDRESS(value) then
                return _held_in_place(_pop())
            fi

            if isa Values.ADDRESS(value) then
                return _held_in_place(_value_of(value))
            fi

            if value.has_address then
                let depth = _stack.count

                value.accept_address(self)

                if _stack.count > depth then
                    return _pop()
                fi

                return null
            fi

            let stored = _stored(value.type)

            if !stored? then
                _report("the address of a value of type {value.type}")
                return null
            fi

            let result = _value_of(value)

            if !result? then
                return null
            fi

            let slot = _slot(stored)

            _store_stored(result, value.type, slot)

            return slot
        si

        _load_local(local: LOCAL) is
            if let (pointer, type) = _local(local) then
                let value = _widen(_current.load(type, pointer, 0), local.type)

                if let instance = _instance then
                    _sources[value] = EXACT_SOURCE(null, instance, local)
                fi

                _push(value)
            fi
        si

        _store_local(local: LOCAL, value: LLVM.Value?) is
            if !_is_null(value) then
                _note_store(local, _source_of(value))
            fi

            if let (pointer, _) = _local(local) /\ value? then
                _current.store(_narrow(value, local.type), pointer, 0)
            fi
        si

        // The position of the parameter `symbol` among the arguments of the
        // function being lowered, or null where it belongs to another.
        _argument_index(symbol: Semantic.Symbols.Symbol) -> int? is
            if let instance = _instance /\ symbol.owner == instance.definition then
                let names = instance.definition.argument_names

                for i in 0..names.count do
                    if names[i] =~ symbol.name then
                        return i + _receiver_offset
                    fi
                od
            fi

            return null
        si

        _load_argument(index: int) is
            if index < _arguments.count then
                let (pointer, type, value_type) = _arguments[index]

                _push(_widen(_current.load(type, pointer, 0), value_type))
            else
                _report("an argument the function does not take")
            fi
        si

        _store_argument(index: int, value: LLVM.Value?, type: Type?) is
            if index < _arguments.count /\ value? then
                let (pointer, _, _) = _arguments[index]

                _current.store(_narrow(value, type), pointer, 0)
            else
                _report("an argument the function does not take")
            fi
        si

        // Where a value came from, as far as its exact class goes, or null
        // where nothing is known of it.
        _source_of(value: LLVM.Value?) -> EXACT_SOURCE? is
            let source: EXACT_SOURCE mut

            if let v = value /\ _sources.try_get_value(v, source ref) then
                return source
            fi

            return null
        si

        // Records, while discovering, what is stored in `local`: a value
        // from `source`, or anything at all where it is null.
        _note_store(local: LOCAL, source: EXACT_SOURCE?) is
            if let objects = _objects, instance = _instance /\ !objects.is_built then
                objects.exact.note_store(instance, local, source)
            fi
        si

        _is_null(value: LLVM.Value?) -> bool => if let v = value then _nulls.contains(v) else false fi

        // The exact class of `value`, where it is known to be one class.
        _exact_class(value: LLVM.Value) -> CLASS_INSTANCE? =>
            if let objects = _objects then objects.exact.exact(_source_of(value)) else null fi

        // Returns the value on the stack, or the default value of the result
        // where the stack is empty.
        _return() is
            if LLVM_TYPES.is_void(_return_type) then
                _current.return_void()
            elif let type = _held(_return_type) then
                let is_default = _stack.count == 0
                let value = if _stack.count > 0 then _pop()! else LLVM_TYPES.zero(type) fi

                if let objects = _objects, instance = _instance /\ !objects.is_built /\ !is_default /\ !_is_null(value) then
                    objects.exact.note_return(instance, _source_of(value))
                fi

                _current.return_value(_normalise_for(value, _return_type))
            else
                _report("a result of type {_return_type}")
                _current.unreachable()
            fi

            _is_terminated = true
        si

        // Brings a value of a narrow kind back into its range: sign-extended
        // for a signed kind and masked for an unsigned one, which is what
        // CIL's narrowing conversions and narrow stores do.
        _normalise(value: LLVM.Value, scalar: Scalar) -> LLVM.Value =>
            case scalar
            when Scalar.INT8 then _sign_extend_from(value, 8)
            when Scalar.INT16 then _sign_extend_from(value, 16)
            when Scalar.UINT8 then _current.binary(BinaryOperator.AND, IntegerFlags.NONE, value, _i32(0xFF))
            when Scalar.UINT16, Scalar.CHAR then _current.binary(BinaryOperator.AND, IntegerFlags.NONE, value, _i32(0xFFFF))
            else value
            esac

        _sign_extend_from(value: LLVM.Value, width: int) -> LLVM.Value =>
            _current.convert(
                Conversion.SIGN_EXTEND,
                _current.convert(Conversion.TRUNCATE, value, LLVM.Type.INTEGER(width)),
                Types.i32)

        _normalise_for(value: LLVM.Value, type: Type?) -> LLVM.Value =>
            if let scalar = _scalar(type) /\ LLVM_TYPES.is_narrow(scalar) then
                _normalise(value, scalar)
            else
                value
            fi

        _i32(value: int) -> LLVM.Value => LLVM.Values.integer(Types.i32, bigint(value))

        visit_value(value: Value) is
            if let lowered: LLVM_VALUE = value then
                _push(lowered.value)
            else
                _report("{value.get_type().name}")
            fi
        si

        visit_address_of_value(value: Value) is
            _report("the address of {value.get_type().name}")
        si

        visit(number: Values.Literal.NUMBER) is
            let (value, from) =
                case number.constant
                when i4: Values.Literal.CONSTANT.I4 then (LLVM.Values.integer(Types.i32, bigint(i4.value)), Scalar.INT32)
                when i8: Values.Literal.CONSTANT.I8 then (LLVM.Values.integer(Types.i64, bigint(i8.value)), Scalar.INT64)
                when r4: Values.Literal.CONSTANT.R4 then (LLVM.Values.of_single(r4.value), Scalar.FLOAT32)
                when r8: Values.Literal.CONSTANT.R8 then (LLVM.Values.of_double(r8.value), Scalar.FLOAT64)
                esac

            if let to = number.narrowing then
                _push(_convert(value, from, to))
            elif _scalar(number.type) =~ Scalar.BOOL then
                _push(_convert(value, from, Scalar.BOOL))
            else
                _push(value)
            fi
        si

        visit(string: Values.Literal.STRING) is
            if let strings = _strings then
                _push(strings.literal(string.value))
            else
                _report("a string literal")
            fi
        si
        visit(decimal: Values.Literal.DECIMAL) is _report("a decimal literal") si
        // A bigint literal that fits in a long is built into the box's i64
        // field. A wider one is built at run time from its decimal digits,
        // through the static `parse` the core library gives `bigint`.
        visit(bigint: Values.Literal.BIGINT) is
            let small: long mut

            if long.try_parse(bigint.value, small ref) then
                let long_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_long_type()

                _bigint_of_small(bigint.type, Values.Literal.NUMBER(Values.Literal.CONSTANT.I8(small), long_type))
            elif let parse = _static_method(bigint.type, "parse", 1) then
                let string_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type()

                gen(Values.Call.STATIC(parse, LIST[Value]([Values.Literal.STRING(bigint.value, string_type)]), bigint.type, null))
            else
                _report("a bigint literal, whose type has no parse")
            fi
        si

        visit(load: Values.Load.SYMBOL) is _report("a load of {load.symbol.name}") si
        visit_address(load: Values.Load.SYMBOL) is _report("the address of {load.symbol.name}") si
        visit_address(load: Values.Load.INSTANCE_FIELD) is
            if let address = _field_address(load.from, load.symbol) then
                _push(address)
            fi
        si

        visit(load: Values.Load.TEMP) is
            _load_local(load.local)
        si

        visit_address(load: Values.Load.TEMP) is _local_address(load.local) si
        visit_address(load: Values.Load.STATIC_FIELD) is _global_address(load.symbol, true) si
        visit_address(load: Values.Load.GLOBAL_FIELD) is _global_address(load.symbol, false) si

        _global_address(symbol: Semantic.Symbols.Symbol, is_static: bool) is
            if let (name, _) = _global(symbol, is_static) then
                _push(LLVM.Values.global(name))
            fi
        si

        visit(load: Values.Load.LOCAL_ARGUMENT) is
            let symbol = load.symbol

            if let state_machine_field = Values.state_machine_field_for(symbol) then
                gen(_frame_field_load(state_machine_field))
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _load_local(packed_local)
            elif let index = _argument_index(symbol) then
                _load_argument(index)
            else
                _report("an argument of another function")
            fi
        si

        visit_address(load: Values.Load.LOCAL_ARGUMENT) is
            let symbol = load.symbol

            if let state_machine_field = Values.state_machine_field_for(symbol) then
                _frame_field_load(state_machine_field).accept_address(self)
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _local_address(packed_local)
            elif let index = _argument_index(symbol) /\ index < _arguments.count then
                _push(_arguments[index].pointer)
            else
                _report("the address of an argument of another function")
            fi
        si

        visit(load: Values.Load.LOCAL_VARIABLE) is
            if let state_machine_field = Values.state_machine_field_for(load.symbol) then
                gen(_frame_field_load(state_machine_field))
            elif let variable = cast Semantic.Symbols.Variable?(load.symbol) then
                _load_local(variable.ir_local)
            else
                _report("a load of {load.symbol.name}")
            fi
        si

        visit_address(load: Values.Load.LOCAL_VARIABLE) is
            if let state_machine_field = Values.state_machine_field_for(load.symbol) then
                _frame_field_load(state_machine_field).accept_address(self)
            elif let variable = cast Semantic.Symbols.Variable?(load.symbol) then
                _local_address(variable.ir_local)
            else
                _report("the address of {load.symbol.name}")
            fi
        si

        visit(load: Values.Load.ARGUMENT) is
            _load_argument(load.index + _receiver_offset)
        si

        /// A composite value's structured expansion is lowered as any other
        /// structured IR is.
        visit(composite: Values.Composite) is
            // A capture-free literal the cache would hold is one constant
            // closure instead.
            if let memoized: Values.MEMOIZED_DELEGATE = composite /\ memoized.function? then
                _closure(Values.MAKE_CLOSURE(memoized.type, memoized.function!, Values.NULL(Semantic.Types.NULL())), true)
                return
            fi

            for value in composite.expand().values do
                gen(value)
            od
        si

        visit_address(coalesce: Values.COALESCE_LOAD) is _report("the address of a coalesced load") si

        // An asynchronous function's body constructs its frame, marks it not
        // yet started, gives it a builder, starts it through the builder,
        // and answers the builder's task, as the .NET async builder protocol
        // has it. The builder's members are found by name and argument count
        // on the builder type the frame was given.
        visit(launch: Values.ASYNC_METHOD_LAUNCH) is
            let builder_type = launch.builder_field.type!
            let local = launch.state_machine_local
            let frame = Values.Load.TEMP(local, launch.state_machine_type)

            let arguments =
                if let block: Values.BLOCK = launch.ctor_arg_loads then
                    LIST[Value](block.values)
                else
                    LIST[Value]([launch.ctor_arg_loads])
                fi

            gen(Values.DECLARE_LOCAL(local))
            gen(Values.NEW(launch.state_machine_type, launch.constructor, arguments))
            gen(Values.STORE_TEMP(local))

            gen(Values.Store.INSTANCE_FIELD(frame, launch.state_field, _int_literal(-1)))

            if let create = _builder_member(builder_type, "create", 0) then
                gen(Values.Store.INSTANCE_FIELD(frame, launch.builder_field, Values.Call.STATIC(create, LIST[Value](), builder_type, null)))
            fi

            let builder = Values.Load.INSTANCE_FIELD(frame, launch.builder_field)

            if let start = _builder_generic_member(builder_type, "start", 1, LIST[Type]([launch.state_machine_type])) then
                gen(Values.Call.INSTANCE(builder, start, _by_reference(start, LIST[Value]([frame]), LIST[bool]([true])), null))
            fi

            _builder_task(builder, builder_type)
        si

        // The end of a frame's `move_next`: the machine is finished, and the
        // builder is handed the result, or the exception the handler caught,
        // which the handler leaves on the stack.
        visit(completion: Values.ASYNC_COMPLETION) is
            let builder_type = completion.builder_field.type!

            let exception =
                if let exception_type = completion.exception_type then
                    let local = IR.LOCAL(".caught_exception", exception_type)

                    gen(Values.DECLARE_LOCAL(local))
                    _store_local(local, _pop())

                    Values.Load.TEMP(local, exception_type)
                else
                    null
                fi

            gen(_frame_field_store(completion.state_field, _int_literal(-1)))

            let builder = _frame_field_load(completion.builder_field)

            if let e = exception then
                if let set_exception = _builder_member(builder_type, "set_exception", 1) then
                    gen(Values.Call.INSTANCE(builder, set_exception, LIST[Value]([e]), null))
                fi
            else
                let arguments =
                    if let result = completion.result_field then
                        LIST[Value]([_frame_field_load(result)])
                    else
                        LIST[Value]()
                    fi

                if let set_result = _builder_member(builder_type, "set_result", arguments.count) then
                    gen(Values.Call.INSTANCE(builder, set_result, arguments, null))
                fi
            fi
        si

        // A task-like that is complete from the start: a builder is created,
        // given its result at once, and asked for its task.
        visit(completed: Values.COMPLETED_TASK_LIKE) is
            let builder_type = completed.builder_type

            let create = _builder_member(builder_type, "create", 0)
            let set_result = _builder_member(builder_type, "set_result", 0)

            if !create? \/ !set_result? then
                return
            fi

            let local = IR.LOCAL(".completed_builder", builder_type)
            let builder = Values.Load.TEMP(local, builder_type)

            gen(Values.DECLARE_LOCAL(local))
            gen(Values.Call.STATIC(create, LIST[Value](), builder_type, null))
            gen(Values.STORE_TEMP(local))

            gen(Values.Call.INSTANCE(builder, set_result, LIST[Value](), null))

            _builder_task(builder, builder_type)
        si

        // An await is a region holding its steps and the resume point a
        // later `move_next` re-enters at, and then the awaiter's result.
        // The region is made once for each await, since every lowering of
        // the body has to see the same resume point.
        visit(suspend: Values.AWAIT_SUSPEND) is
            let structure: Values.REGION mut

            if !_await_structures.try_get_value(suspend, structure ref) then
                structure = suspend.structure()
                _await_structures[suspend] = structure
            fi

            gen(structure)
            gen(suspend.get_result)
        si

        visit(step: Values.AWAIT_SUSPEND_STEP) is
            let suspend = step.suspend

            case step.kind
            when Values.AwaitSuspendStep.CAPTURE_AWAITER then
                gen(_frame_field_store(suspend.awaiter_field, suspend.get_awaiter))

            when Values.AwaitSuspendStep.REGISTER_CONTINUATION then
                _stamp_state(suspend, suspend.state_number)
                _register_continuation(suspend)

            when Values.AwaitSuspendStep.CLEAR_STATE then
                _stamp_state(suspend, -1)
            esac
        si

        // The state goes to both the local the dispatch reads and the
        // frame's field, which the next `move_next` starts from.
        _stamp_state(suspend: Values.AWAIT_SUSPEND, state: int) is
            _store_local(suspend.state_local, _i32(state))

            gen(_frame_field_store(suspend.state_field, _int_literal(state)))
        si

        // Registers the frame's resumption with the awaiter through the
        // builder's `await_on_completed`, or `await_unsafe_on_completed` for
        // an awaiter implementing `ICriticalNotifyCompletion`. The awaiter
        // goes by reference, as the address of the frame's copy, and the
        // machine by reference or as the interface, as the member takes it.
        _register_continuation(suspend: Values.AWAIT_SUSPEND) is
            let builder_type = suspend.builder_field.type!
            let name = if suspend.is_critical then "await_unsafe_on_completed" else "await_on_completed" fi

            let member = Semantic.TASK_LIKE.member_of_arity(builder_type, name, 2)

            if !member? then
                _report("a builder with no {name}")
                return
            fi

            let machine_by_reference = isa Semantic.Types.REFERENCE(member.arguments[1])

            let type_arguments = LIST[Type]([suspend.awaiter_type])

            if member.generic_arguments.count > 1 then
                type_arguments.add(suspend.state_machine_type)
            fi

            if let await_on_completed = _builder_generic_member(builder_type, name, 2, type_arguments) then
                let frame = Values.Load.REFERENCE_SELF(cast Semantic.Symbols.Classy(suspend.state_field.owner), suspend.state_machine_type)

                gen(
                    Values.Call.INSTANCE(
                        _frame_field_load(suspend.builder_field),
                        await_on_completed,
                        _by_reference(
                            await_on_completed,
                            LIST[Value]([_frame_field_load(suspend.awaiter_field), frame]),
                            LIST[bool]([true, machine_by_reference])),
                        null))
            fi
        si

        // The arguments of a call to a builder member, those `by_reference`
        // marks passed as their address, as the member's `ref` parameters
        // take them.
        _by_reference(function: Function, arguments: Value[], by_reference: bool[]) -> LIST[Value] is
            let result = LIST[Value]()

            for i in 0..arguments.count do
                if by_reference[i] then
                    result.add(Values.ADDRESS(arguments[i], function.arguments[i]))
                else
                    result.add(arguments[i])
                fi
            od

            return result
        si

        // The builder member `name` taking `arity` arguments, or null, with
        // the build reported, where the builder declares none.
        _builder_member(builder_type: Type, name: string, arity: int) -> Function? is
            let member = Semantic.TASK_LIKE.member_of_arity(builder_type, name, arity)

            if !member? then
                _report("a builder with no {name} taking {arity} arguments")
            fi

            return member
        si

        // The generic builder member `name`, at `type_arguments`.
        _builder_generic_member(builder_type: Type, name: string, arity: int, type_arguments: Type[]) -> Function? is
            if let member = _builder_member(builder_type, name, arity) then
                return cast Function?(member.specialize(type_arguments))
            fi

            return null
        si

        _builder_task(builder: Value, builder_type: Type) is
            if let property: Semantic.Symbols.Property = builder_type.find_member("task") /\ property.read_function? then
                gen(Values.Call.INSTANCE(builder, property.read_function, LIST[Value](), null))
            else
                _report("a builder with no task")
            fi
        si

        _int_literal(value: int) -> Value =>
            Values.Literal.NUMBER(value, IoC.CONTAINER.instance.innate_symbol_lookup.get_int_type())


        visit(max_stack: Values.MAX_STACK) is si
        // A MAYBE holding a value is built by the core library's constructor
        // taking that value.
        visit(construct: Values.CONSTRUCT_MAYBE) is
            if let constructor = INTERPOLATION_CALLS.method(construct.type, "init", 1) then
                gen(Values.NEW(construct.type, constructor, LIST[Value]([construct.value])))
            else
                _report("an optional value, whose MAYBE has no constructor taking its value")
            fi
        si

        // The value is already on the stack, where whatever reads it finds it.
        visit(stack_top: Values.STACK_TOP) is si
        // An address already on top of the stack, which stays where it is.
        visit(stack_top: Values.STACK_TOP_ADDRESS) is si
        visit_address(stack_top: Values.STACK_TOP_ADDRESS) is si

        /// A block lowers each of its values in turn. One that produces a
        /// value and ends in a region produces it through that region.
        visit(block: Values.BLOCK) is
            let values = block.values

            for i in 0..values.count do
                let value = values[i]

                if i == values.count - 1 /\ _produces_value(block) /\ isa Values.REGION(value) then
                    let result = _held(block.type)

                    if !result? then
                        _report("a value of type {block.type}")
                    fi

                    _lower_region(cast Values.REGION(value), result)
                else
                    gen(value)
                fi
            od
        si

        // A body every path out of which diverges, by a throw or a return,
        // is typed as an error, and produces no value.
        _produces_value(block: Values.BLOCK) -> bool =>
            !LLVM_TYPES.is_void(block.type) /\ !(block.type?.is_error ?? false)

        visit(block: Values.DUMMY_BLOCK) is
            throw System.InvalidOperationException("dummy block generated, created at: {block.location} because: {block.why}")
        si

        // A struct method's receiver is already the address of the struct.
        // A class's receiver is a reference, so its address is the slot the
        // reference is held in, as an asynchronous function's frame passes
        // itself by reference to the builder that resumes it.
        visit_address(self_load: Values.Load.REFERENCE_SELF) is
            if isa Semantic.Symbols.STRUCT(self_load.`self) then
                if let pointer = _receiver_address() then
                    _push(pointer)
                fi
            elif _receiver_offset == 0 \/ _arguments.count == 0 then
                _report("self outside an instance method")
            else
                _push(_arguments[0].pointer)
            fi
        si
        /// Inside a generator's frame, the receiver of the method that made
        /// it, held in a field of the frame.
        visit(self_load: Values.Load.OUTER_SELF) is gen(_frame_field_load(self_load.outer_self_field)) si
        visit_address(self_load: Values.Load.OUTER_SELF) is visit(self_load) si
        // A struct method's receiver is the address of its struct.
        visit(self_load: Values.Load.VALUE_SELF) is
            if !_stored(self_load.type)? then
                _report("self of type {self_load.type}")
                return
            fi

            if let pointer = _receiver_address() then
                _push(_load_stored(self_load.type, pointer)!)
            fi
        si

        visit_address(self_load: Values.Load.VALUE_SELF) is
            if let pointer = _receiver_address() then
                _push(pointer)
            fi
        si

        _receiver_address() -> LLVM.Value? is
            if _receiver_offset == 0 \/ _arguments.count == 0 then
                _report("self outside an instance method")
                return null
            fi

            return _current.load(Types.pointer, _arguments[0].pointer, 0)
        si
        /// An object is allocated whole where it is constructed, so there
        /// is nothing for its constructor to initialise first, and a program
        /// runs on one thread.
        visit(runtime: Values.RUNTIME) is
            if runtime.operation == IR.RuntimeOperation.INIT_OBJECT then
                return
            elif runtime.operation == IR.RuntimeOperation.CURRENT_THREAD_ID then
                _push(_i32(0))
            elif runtime.operation == IR.RuntimeOperation.NEW_RANGE then
                // A range is constructed from its two endpoints.
                if let constructor = INTERPOLATION_CALLS.method(runtime.type, "init", 2) then
                    gen(Values.NEW(runtime.type!, constructor, LIST[Value](runtime.operands)))
                else
                    _report("a range, whose type has no constructor taking its endpoints")
                fi
            elif let kind = _runtime_exception(runtime.operation) then
                if let exception = _new_exception(kind, runtime.operands) then
                    _push(exception)
                fi
            elif runtime.operation == IR.RuntimeOperation.STRINGS_EQUAL then
                _call_string_helper(_strings?.equals_function, runtime.operands)
            elif runtime.operation == IR.RuntimeOperation.CONCAT_STRINGS then
                _call_string_helper(_strings?.concat_function, runtime.operands)
            elif !_lower_builder(runtime) then
                _report("the runtime operation {runtime.operation}")
            fi
        si
        visit(creation: Values.CREATE_UNIT_VARIANT_INSTANCE) is _report("a union") si

        visit(dummy: Values.DUMMY) is _report("a placeholder value") si
        visit(type_expression: Values.TYPE_EXPRESSION) is _report("a type used as a value") si
        visit(store: Values.Need.STORE) is _report("an indirect store") si
        // A store through a reference, which is a pointer to where its value
        // is held.
        visit(store: Values.Store.INDIRECT) is
            if let pointer = _value_of(store.address), value = _value_of(store.value) then
                _store_stored(value, store.type, pointer)
            fi
        si
        visit(wrapper: Values.TYPE_WRAPPER) is gen(wrapper.value) si
        visit_address(wrapper: Values.TYPE_WRAPPER) is _push_address_of(wrapper.value) si
        visit(wrapper: Values.WRAPPER) is
            assert wrapper.value? else "generate wrapper without value"

            gen(wrapper.value)
        si
        visit_address(wrapper: Values.WRAPPER) is
            if let value = wrapper.value then
                _push_address_of(value)
            else
                _report("the address of a value")
            fi
        si

        // The value type `type` is an optional of, or null where it is not
        // one. A reference to an optional, which a method of the optional
        // receives, counts as the optional.
        _value_optional_inner(type: Type?) -> Type? is
            let specialized mut = _specialize(type)

            if let reference: Semantic.Types.REFERENCE = specialized then
                specialized = reference.arguments[0]
            fi

            if specialized? /\ specialized.is_optional /\ specialized.is_value_type /\ !specialized.is_maybe then
                return specialized.optional_inner_type
            fi

            return null
        si

        // An optional value type is held in place as whether it is present,
        // a byte holding 0 or 1, and its value as stored: `{ i8, T }`, zeroed
        // where absent.
        _optional_type(inner: Type) -> LLVM.Type? =>
            if let stored = _stored(inner) then Types.structure([Types.i8, stored]) else null fi

        // The present optional of type `optional` holding `value` of type
        // `inner`.
        _wrap(value: LLVM.Value, optional: LLVM.Type, inner: Type?) -> LLVM.Value =>
            _insert_member(_current.insert_value(LLVM_TYPES.zero(optional), LLVM.Values.integer(Types.i8, 1n), [0]), value, 1, inner)

        // Whether the optional value type `optional` holds a value.
        _is_present(optional: LLVM.Value) -> LLVM.Value =>
            _current.convert(Conversion.TRUNCATE, _current.extract_value(Types.i8, optional, [0]), Types.i1)

        visit(wrap: Values.WRAP_OPTIONAL) is
            // A MAYBE, the optional of an unconstrained type parameter, is the
            // core library's struct, built by its constructor.
            if _specialize(wrap.type)?.is_maybe ?? false then
                gen(Values.CONSTRUCT_MAYBE(_specialize(wrap.type)!, wrap.value))
                return
            fi

            let optional = _held(wrap.type)

            if !optional? \/ !_value_optional_inner(wrap.type)? then
                _report("an optional value of type {wrap.type}")
                return
            fi

            if let value = _value_of(wrap.value) then
                _push(_wrap(value, optional, _value_optional_inner(wrap.type)))
            fi
        si

        // `has_value` and `value` of an optional value type, called on where
        // it is held. Reading the value of an absent optional throws, as .NET
        // does.
        _lower_nullable(operation: string, from: Value?) is
            let inner = if let f = from then _value_optional_inner(f.type) else null fi
            let optional = if let i = inner then _optional_type(i) else null fi

            if !from? \/ !optional? then
                _report("the operation {operation}")
                return
            fi

            let pointer = _optional_pointer(from)

            if !pointer? then
                return
            fi

            let held = _current.load(optional, pointer, 0)
            let present = _is_present(held)

            if operation =~ "nullable.has_value" then
                _push(present)
            elif operation =~ "nullable.value" then
                let absent = _new_block()
                let carry_on = _new_block()

                _current.branch(present, carry_on, absent)

                _start(absent)

                let message = Values.Literal.STRING("Nullable object must have a value.", IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type())

                // Where the program has no such class, what is thrown carries
                // no type or message, as for any exception the runtime makes.
                if IR.Program.CORE_LIBRARY.exception_class(Semantic.Lookups.RuntimeException.INVALID_OPERATION)? then
                    _throw(_new_exception(Semantic.Lookups.RuntimeException.INVALID_OPERATION, LIST[Value]([message])) ?? LLVM.Values.null_pointer)
                else
                    _throw(LLVM.Values.null_pointer)
                fi

                _start(carry_on)

                _push(_extract_member(held, 1, inner))
            else
                _report("the operation {operation}")
            fi
        si

        // Where the optional `from` stands for is held: `from` itself where
        // it is a reference to one, otherwise its address.
        _optional_pointer(from: Value) -> LLVM.Value? =>
            if isa Semantic.Types.REFERENCE(_specialize(from.type)) then _value_of(from) else _address_of(from) fi
        // A narrowed value is the value it narrows, read as its narrower
        // type: the IR already holds what that reading is.
        visit(projection: Values.NARROW_PROJECT) is gen(projection.projected) si
        visit(view: Values.NARROW_VIEW) is gen(view.underlying) si
        // A view held as its underlying value is where that value is; one
        // held otherwise, such as an optional value type viewed as the value
        // it holds, is copied into a place of its own.
        visit_address(view: Values.NARROW_VIEW) is
            let viewed = _stored(view.type)
            let underlying = _stored(view.underlying.type)

            if viewed? /\ underlying? /\ viewed =~ underlying then
                _push_address_of(view.underlying)
            elif let stored = viewed, value = _value_of(view) then
                let slot = _slot(stored)

                _store_stored(value, view.type, slot)
                _push(slot)
            else
                _report("the address of a value of type {view.type}")
            fi
        si

        _push_address_of(value: Value) is
            if let address = _address_of(value) then
                _push(address)
            fi
        si
        visit(enter: Values.ENTER_FILE) is si
        visit(leave: Values.LEAVE_FILE) is si

        visit(address: Values.ARRAY_ELEMENT_ADDRESS) is _element_address(address) si
        visit_address(address: Values.ARRAY_ELEMENT_ADDRESS) is _element_address(address) si

        // The address of an array element, checked against the array's count.
        _element_address(address: Values.ARRAY_ELEMENT_ADDRESS) is
            let arrays = _arrays
            let type = _array_of(address.array.type)

            if !arrays? \/ !type? then
                _report("the address of an array element")
                return
            fi

            if let array = _value_of(address.array), index = _value_of(address.index) then
                _check_index(array, index)
                _push(arrays.element_address(_current, type, array, index))
            fi
        si

        visit(array: Values.NEW_ARRAY) is
            _new_array(array.type, array.count)
        si

        visit(store: Values.STORE_ARRAY_ELEMENT) is
            _store_array_element(store.array, store.index, store.element)
        si

        visit(sequence: Values.SEQUENCE) is
            let type = _array_of(sequence.type)

            if !type? then
                return
            fi

            let arrays = _arrays!
            let result = arrays.allocate(_current, type, _i32(sequence.values.count))

            // An element whose type is not the array's, an int in an
            // object[], is boxed as it is stored.
            let boxer = IoC.CONTAINER.instance.value_boxer

            for (i, value) in sequence.values |> Ghul.Pipes.index() do
                if let element = _value_of(boxer.box_if_needed(value, sequence.element_type)) then
                    arrays.store(_current, type, result, _i32(i), _normalise_for(element, sequence.element_type))
                else
                    return
                fi
            od

            _push(result)
        si

        // The array type a value of `type` is, or null, reported, where the
        // target holds no arrays of its element type.
        _array_of(type: Type?) -> CLASS_INSTANCE? is
            if let arrays = _arrays, array = arrays.array_of(_specialize(type)) then
                return array
            fi

            _report("an array of type {type}")

            return null
        si

        _new_array(array_type: Type?, count: Value) is
            if let type = _array_of(array_type), length = _value_of(count) then
                _push(_arrays!.allocate(_current, type, length))
            fi
        si

        // An element whose type is not the array's, an int in an object[],
        // is boxed as it is stored.
        _store_array_element(array_value: Value, index_value: Value, element_value: Value) is
            let type = _array_of(array_value.type)

            if !type? then
                return
            fi

            let boxed = IoC.CONTAINER.instance.value_boxer.box_if_needed(element_value, _arrays!.element_of(type))

            if let array = _value_of(array_value),
                index = _value_of(index_value),
                element = _value_of(boxed)
            then
                let arrays = _arrays!

                _check_index(array, index)

                arrays.store(_current, type, array, index, _normalise_for(element, arrays.element_of(type)))
            fi
        si

        // Throws where `array` is null, or where `index` is outside the array
        // it points at, an unsigned comparison catching a negative index too.
        _check_index(array: LLVM.Value, index: LLVM.Value) is
            _check_dereference(array)

            let in_range = _current.compare(IntegerPredicate.ULT, index, _arrays!.count(_current, array))

            _throw_if(_current.compare(IntegerPredicate.EQ, in_range, LLVM.Values.boolean(false)), Semantic.Lookups.RuntimeException.INDEX_OUT_OF_RANGE)
        si

        // The built-in array operation a call to `function` performs, or
        // null where it performs none.
        _array_operation(function: Function) -> string? is
            if let operation = cast Function?(function.root_specialized_from)?.intrinsic_operation /\ operation.starts_with("array.") then
                return operation
            fi

            return null
        si

        visit(compare: Values.COMPARE_ORDER_TO_ZERO) is
            if let value = _value_of(compare.value) then
                _push(_compare(compare.comparison, value, _i32(0), false))
            fi
        si

        visit(receiver: Values.CONSTRAINED) is _report("a constrained call") si
        visit(arithmetic: Values.DECIMAL_ARITHMETIC) is _report("decimal arithmetic") si
        visit(compare: Values.DECIMAL_COMPARE) is _report("decimal arithmetic") si
        visit(convert: Values.DECIMAL_CONVERT) is _report("a decimal conversion") si
        /// A reference optional is present where it is not null. A value-type
        /// optional is not lowered yet.
        visit(test: Values.HAS_VALUE) is
            // A box of a value that is never absent is always present, so the
            // value is evaluated for its effects and nothing is allocated.
            if let boxed = _boxed_present_value(test.value) then
                if _value_of(boxed)? then
                    _push(LLVM.Values.boolean(true))
                fi

                return
            fi

            if let value = _value_of(test.value) then
                if value.type =~ Types.pointer then
                    _push(_current.compare(IntegerPredicate.NE, value, LLVM.Values.null_pointer))
                elif _value_optional_inner(test.value.type)? then
                    _push(_is_present(value))
                else
                    _report("an optional value of type {test.value.type}")
                fi
            fi
        si

        visit(conversion: Values.SCALAR_CONVERSION) is
            gen(conversion.converted)
        si

        visit(declaration: Values.DECLARE_LOCAL) is
            _local(declaration.local)
            _note_iteration(declaration.local)
        si

        visit(store: Values.STORE_TEMP) is
            _store_local(store.local, _pop())
        si

        visit(tee: Values.TEE_TEMP) is
            if let value = _value_of(tee.value) then
                let held = _normalise_for(value, tee.local.type)

                _store_local(tee.local, held)
                _push(held)
            fi
        si

        visit(discard: Values.DISCARD) is
            if let value = discard.value then
                let depth = _stack.count

                gen(value)

                while _stack.count > depth do
                    _pop()
                od
            else
                _pop()
            fi
        si

        visit(ret: Values.RET) is
            _return()
        si

        visit(default_return: Values.DEFAULT_RETURN) is
            _default(default_return.type)
            _mark_null_top()
        si

        _mark_null_top() is
            if _stack.count > 0 then
                _nulls.add(_stack[_stack.count - 1])
            fi
        si

        visit(size_of: Values.SIZE_OF) is
            _push(LLVM.Values.i32(_size_of(size_of.measured)))
        si

        // The bytes a value of `type` takes where it is stored, as an array's
        // element holds it.
        _size_of(type: Type) -> int =>
            if let stored = _objects?.stored_type(_specialize(type)) then LLVM_TYPES.size_of(stored) else 8 fi

        visit(default_value: Values.DEFAULT) is
            _default(default_value.type)
            _mark_null_top()
        si

        _default(type: Type?) is
            if LLVM_TYPES.is_void(type) then
                return
            elif let value_type = _held(type) then
                _push(LLVM_TYPES.zero(value_type))
            else
                _report("the default value of {type}")
            fi
        si

        visit_address(default_value: Values.DEFAULT) is _report("the address of a value") si
        // A reference is a pointer to where its value is held.
        visit(deref: Values.DEREF) is
            if !_stored(deref.type)? then
                _report("a reference to {deref.type}")
                return
            fi

            if let pointer = _value_of(deref.value) then
                _push(_load_stored(deref.type, pointer)!)
            fi
        si

        visit_address(deref: Values.DEREF) is gen(deref.value) si

        visit(address: Values.ADDRESS) is
            if let pointer = _address_of(address.value) then
                _push(pointer)
            fi
        si

        visit_address(address: Values.ADDRESS) is _report("the address of a reference") si
        // Each step in turn, the last leaving the value.
        visit(steps: Values.STEPS) is
            for step in steps.steps do
                gen(step)
            od
        si

        // Decrements the counter in place, leaving nothing.
        visit(decrement: Values.DECREMENT) is
            if let before = _counter(decrement.counter) then
                _store_local(decrement.counter, _step(before, BinaryOperator.SUB))
            fi
        si

        // Leaves the counter's value before the increment, and stores the
        // incremented value back.
        visit(increment: Values.POST_INCREMENT) is
            if let before = _counter(increment.counter) then
                _store_local(increment.counter, _step(before, BinaryOperator.ADD))
                _push(before)
            fi
        si

        // Leaves the counter's value after the decrement.
        visit(decrement: Values.PRE_DECREMENT) is
            if let before = _counter(decrement.counter) then
                let after = _step(before, BinaryOperator.SUB)

                _store_local(decrement.counter, after)
                _push(after)
            fi
        si

        _counter(counter: LOCAL) -> LLVM.Value? is
            _load_local(counter)

            return _pop()
        si

        _step(value: LLVM.Value, operator: BinaryOperator) -> LLVM.Value =>
            _current.binary(operator, IntegerFlags.NONE, value, _i32(1))

        // The source is held in a local, which the rebuilt tuple reads.
        visit(repack: Values.TUPLE_REPACK) is
            _store_local(repack.temp, _value_of(repack.source))
            gen(repack.built)
        si
        // The subject already on the stack is held in a local, which what is
        // built from it reads.
        visit(spilled: Values.SPILLED_SUBJECT) is
            _store_local(spilled.temp, _pop())
            gen(spilled.built)
        si

        visit(null_value: Values.NULL) is
            _push_null(LLVM.Values.null_pointer)
        si

        // Pushes `value`, a null the program wrote or a default it falls
        // back on. A null reaches a call as a null receiver whatever class
        // the call is bound to, so it says nothing against exactness.
        _push_null(value: LLVM.Value) is
            _nulls.add(value)
            _push(value)
        si
        /// A scalar is boxed in an object carrying its box's descriptor, so a
        /// boxed int and a boxed long answer type tests differently. A
        /// reference needs no box.
        visit(box: Values.BOX) is
            let value = box.value

            if _value_optional_inner(value.type)? then
                _box_optional(value)
            elif let objects = _objects, s = objects.struct_of(_specialize(value.type)) then
                if let held = _value_of(value) then
                    _push(_box_struct(objects, s, held))
                fi
            elif let objects = _objects, box_type = objects.box_type(_specialize(value.type)) then
                if let held = _value_of(value) then
                    _push(_box_value(objects, box_type, held, value.type))
                fi
            elif let held = _held(value.type) /\ isa LLVM.Type.POINTER(held) then
                gen(value)
            else
                _report("boxing a {value.type}")
            fi
        si


        // A new box of `box_type` holding `held`, a value of `type`.
        // A box holding something the collector must follow is one it scans.
        _box_value(objects: LLVM_OBJECTS, box_type: CLASS_INSTANCE, held: LLVM.Value, type: Type?) -> LLVM.Value is
            objects.note_boxed(box_type)

            let scanned = LLVM_TYPES.holds_pointer(held.type)

            let object =
                _strings!.allocate_object(_current, LLVM.Values.global(objects.descriptor_name(box_type)), LLVM.Values.i64(cast long(objects.size_of(box_type))), scanned)

            _store_stored(held, type, _current.element_pointer(objects.struct_type(box_type), object, [_i32(0), _i32(1)], true))

            return object
        si

        // An optional value type boxes as .NET boxes one: an absent value is
        // null, and a present one is a box of the value it holds.
        _box_optional(value: Value) is
            let inner = _value_optional_inner(value.type)!
            let objects = _objects
            let box_type = if let o = objects then o.box_type(_specialize(inner)) else null fi
            let struct_type = if let o = objects then o.struct_of(_specialize(inner)) else null fi
            let optional = _held(value.type)

            if !objects? \/ (!box_type? /\ !struct_type?) \/ !optional? then
                _report("boxing a {value.type}")
                return
            fi

            let held = _value_of(value)

            if !held? then
                return
            fi

            let slot = _slot(Types.pointer)

            _current.store(LLVM.Values.null_pointer, slot, 0)

            let present = _new_block()
            let join = _new_block()

            _current.branch(_is_present(held), present, join)

            _start(present)

            let inner_value = _extract_member(held, 1, inner)
            let object =
                if let b = box_type then
                    _box_value(objects, b, inner_value, inner)
                else
                    _box_struct(objects, struct_type!, inner_value)
                fi

            _current.store(object, slot, 0)
            _current.branch(join)

            _start(join)

            _push(_current.load(Types.pointer, slot, 0))
        si

        // Unboxing to an optional value type answers absent for a null, and
        // otherwise unboxes the value, throwing where the box is of another
        // type.
        _unbox_optional(value: Value, type: Type?) is
            let inner = _value_optional_inner(type)!
            let optional = _held(type)

            if !optional? then
                _report("unboxing a {type}")
                return
            fi

            let object = _value_of(value)

            if !object? then
                return
            fi

            let slot = _slot(optional)

            _current.store(LLVM_TYPES.zero(optional), slot, 0)

            let present = _new_block()
            let join = _new_block()

            _current.branch(_current.compare(IntegerPredicate.NE, object, LLVM.Values.null_pointer), present, join)

            _start(present)

            if let unboxed = _unbox_value(object, inner) then
                let wrapped = _wrap(unboxed, optional, inner)

                _current.store(wrapped, slot, 0)
            fi

            _current.branch(join)

            _start(join)

            _push(_current.load(optional, slot, 0))
        si

        // A cast to an optional value type tests the object as CIL's `isinst`
        // does, and never throws: it answers the object where that is a box
        // of the inner type, a scalar or a struct, and null otherwise. The
        // unboxing that follows it turns null into an absent value.
        _cast_to_optional(conversion: Values.CAST, target: Type) is
            let inner = _value_optional_inner(target)!
            let objects = _objects
            let box_type = if let o = objects then o.box_type(_specialize(inner)) ?? o.struct_of(_specialize(inner)) else null fi

            if !objects? \/ !box_type? then
                _report("a cast to {conversion.type}")
                return
            fi

            let object = _value_of(conversion.value)

            if !object? then
                return
            fi

            let range = LIST[(first: int, last: int)]()

            range.add(objects.class_range(box_type))

            let fits = _fits(object, range)

            _push(_current.select(fits, object, LLVM.Values.null_pointer))
        si
        /// A null, or a box of another type, throws, as .NET does. Unboxing
        /// through a type parameter follows the cast that tested the box,
        /// so there a null is the declined cast and gives the default.
        visit(unbox: Values.UNBOX) is
            if (unbox.type?.is_type_variable ?? false) /\ !LLVM_TYPES.is_object_reference(_specialize(unbox.type)) then
                _unbox_or_default(unbox.value, unbox.type)
            else
                _unbox(unbox.value, unbox.type)
            fi
        si

        _unbox_or_default(value: Value, type: Type?) is
            let held = _held(type)
            let object = _value_of(value)

            if !held? \/ !object? then
                if !held? then
                    _report("unboxing a {_specialize(type)}")
                fi

                return
            fi

            let slot = _slot(held)

            _current.store(LLVM_TYPES.zero(held), slot, 0)

            let present = _new_block()
            let join = _new_block()

            _current.branch(_current.compare(IntegerPredicate.NE, object, LLVM.Values.null_pointer), present, join)

            _start(present)

            if let unboxed = _unbox_value(object, type) then
                _current.store(unboxed, slot, 0)
            fi

            _current.branch(join)

            _start(join)

            _push(_current.load(held, slot, 0))
        si

        _unbox(value: Value, type: Type?) is
            if _value_optional_inner(type)? then
                _unbox_optional(value, type)
                return
            fi

            if let object = _value_of(value), unboxed = _unbox_value(object, type) then
                _push(unboxed)
            fi
        si

        // A struct boxes as an object carrying the struct's own descriptor,
        // so a type test finds it, with the struct after it. A struct holding
        // a reference is boxed where the collector scans it.
        _box_struct(objects: LLVM_OBJECTS, s: CLASS_INSTANCE, held: LLVM.Value) -> LLVM.Value is
            objects.note_allocated(s)

            let boxed = Types.structure([Types.pointer, held.type])
            let scanned = LLVM_TYPES.holds_pointer(held.type)

            let object =
                _strings!.allocate_object(_current, LLVM.Values.global(objects.descriptor_name(s)), LLVM.Values.i64(cast long(LLVM_TYPES.size_of(boxed))), scanned)

            _current.store(held, _current.element_pointer(boxed, object, [_i32(0), _i32(1)], true), 0)

            return object
        si

        // The value of `type` held in the box `object` points at, or null,
        // reported, where the target has no box for `type`. A null, or a box
        // of another type, throws.
        _unbox_value(object: LLVM.Value, unboxed: Type?) -> LLVM.Value? is
            let objects = _objects
            let type = _specialize(unboxed)

            if let o = objects, s = o.struct_of(type) then
                let held = o.struct_type(s)
                let range = LIST[(first: int, last: int)]()

                range.add(o.class_range(s))

                let fits = _fits(object, range)

                _throw_if(_current.compare(IntegerPredicate.EQ, fits, LLVM.Values.boolean(false)), Semantic.Lookups.RuntimeException.INVALID_CAST)

                return _current.load(held, _current.element_pointer(Types.structure([Types.pointer, held]), object, [_i32(0), _i32(1)], true), 0)
            fi

            // A bigint is held as a reference to its box, so the box is the
            // value once it is known to be one.
            if let o = objects, b = o.bigint_of(type) then
                let range = LIST[(first: int, last: int)]()

                range.add(o.class_range(b))

                let fits = _fits(object, range)

                _throw_if(_current.compare(IntegerPredicate.EQ, fits, LLVM.Values.boolean(false)), Semantic.Lookups.RuntimeException.INVALID_CAST)

                return object
            fi

            // Unboxing to a reference type, as a type parameter bound to one
            // does, is a checked cast that lets null through.
            if type? /\ LLVM_TYPES.is_object_reference(type) then
                if type.is_object then
                    return object
                fi

                let ranges = _class_ranges(type)

                if !ranges? then
                    _report("unboxing a {type}")
                    return null
                fi

                let in_class = _fits(object, ranges)
                let fits = _current.binary(BinaryOperator.OR, IntegerFlags.NONE, in_class, _current.compare(IntegerPredicate.EQ, object, LLVM.Values.null_pointer))

                _throw_if(_current.compare(IntegerPredicate.EQ, fits, LLVM.Values.boolean(false)), Semantic.Lookups.RuntimeException.INVALID_CAST)

                return object
            fi

            let box_type = if let o = objects then o.box_type(type) else null fi

            if !objects? \/ !box_type? \/ !_stored(type)? then
                _report("unboxing a {type}")
                return null
            fi

            let range = LIST[(first: int, last: int)]()

            range.add(objects.class_range(box_type))

            let in_class = _fits(object, range)

            _throw_if(_current.compare(IntegerPredicate.EQ, in_class, LLVM.Values.boolean(false)), Semantic.Lookups.RuntimeException.INVALID_CAST)

            return _load_stored(type, _current.element_pointer(objects.struct_type(box_type), object, [_i32(0), _i32(1)], true))
        si

        /// The type object of a type named in the program: the one its
        /// descriptor stands for: a scalar's box's, or a struct's own.
        visit(type_of: Values.TYPEOF) is
            let objects = _objects!
            let type = _specialize(type_of.typeof_type)
            let held = if let box = objects.box_type(type) then box else objects.class_of(type) fi

            if !held? then
                _report("typeof {type}")
            elif let t = _type_object(LLVM.Values.global(objects.descriptor_name(held))) then
                _push(t)
            fi
        si

        // A tuple is a struct of its elements, in order, held in place.
        visit(tuple: Values.TUPLE) is
            let held = _held(tuple.type)

            if !isa LLVM.Type.STRUCT(held) then
                _report("a tuple of type {tuple.type}")
                return
            fi

            let result mut = LLVM_TYPES.zero(held)
            let element_types = cast Semantic.Types.TUPLE?(_specialize(tuple.type))?.arguments

            for (i, element) in tuple.values |> Ghul.Pipes.index() do
                if let value = _value_of(element) then
                    result = _insert_member(result, value, i, if let types = element_types then types[i] else element.type fi)
                else
                    return
                fi
            od

            _push(result)
        si

        visit(negation: Values.NOT) is
            if let value = _value_of(negation.value) then
                _push(_current.binary(BinaryOperator.XOR, IntegerFlags.NONE, value, LLVM.Values.boolean(true)))
            fi
        si

        visit(arithmetic: Values.ARITHMETIC) is
            let type = _specialize(arithmetic.type)
            let held = if let scalar = _scalar_of(type) then LLVM_TYPES.value_type(scalar) else null fi

            if !held? then
                _report("arithmetic on {arithmetic.type}")
                return
            fi

            let operation = arithmetic.operation
            let is_floating = LLVM_TYPES.is_floating(held)

            let result =
                if operation == ArithmeticOperation.NEGATE then
                    _negate(arithmetic.operands[0], is_floating)
                elif operation == ArithmeticOperation.COMPLEMENT then
                    _complement(arithmetic.operands[0], is_floating)
                elif _is_shift(operation) then
                    _shift(operation, arithmetic.operands[0], arithmetic.operands[1], held, _scalar_of(type))
                else
                    _binary(operation, arithmetic.operands[0], arithmetic.operands[1], is_floating, held)
                fi

            if !result? then
                return
            fi

            // A narrow kind's arithmetic runs at 32 bits, so its result is
            // wrapped back to the kind's width as CIL's narrow stores do.
            if let scalar = _scalar_of(type) /\ LLVM_TYPES.is_narrow(scalar) then
                _push(_normalise(result, scalar))
            else
                _push(result)
            fi
        si

        _is_shift(operation: ArithmeticOperation) -> bool =>
            operation == ArithmeticOperation.SHIFT_LEFT \/
            operation == ArithmeticOperation.SHIFT_RIGHT \/
            operation == ArithmeticOperation.SHIFT_RIGHT_UNSIGNED

        _negate(operand: Value, is_floating: bool) -> LLVM.Value? is
            if let value = _value_of(operand) then
                if is_floating then
                    return _current.negate(value)
                fi

                return _current.binary(BinaryOperator.SUB, IntegerFlags.NONE, LLVM_TYPES.zero(value.type), value)
            fi

            return null
        si

        _complement(operand: Value, is_floating: bool) -> LLVM.Value? is
            if is_floating then
                _report("complement of a floating point value")
                return null
            fi

            if let value = _value_of(operand) then
                return _current.binary(BinaryOperator.XOR, IntegerFlags.NONE, value, LLVM.Values.integer(value.type, bigint.minus_one))
            fi

            return null
        si

        // A shift count is an int whatever the shifted value is, and only its
        // low bits count, as CIL's and wasm's shifts use them: LLVM makes a
        // count at or past the width poison instead.
        _shift(operation: ArithmeticOperation, operand: Value, count: Value, held: LLVM.Type, scalar: Scalar?) -> LLVM.Value? is
            let value_found = _value_of(operand)
            let count_found = _value_of(count)

            if !value_found? \/ !count_found? then
                return null
            fi

            let value mut = value_found
            let amount mut = count_found

            // An unsigned shift of a narrow signed kind shifts in zeros at the
            // kind's own width, so its sign-extended operand is first cut back
            // to that width.
            if operation == ArithmeticOperation.SHIFT_RIGHT_UNSIGNED then
                if scalar =~ Scalar.INT8 then
                    value = _normalise(value, Scalar.UINT8)
                elif scalar =~ Scalar.INT16 then
                    value = _normalise(value, Scalar.UINT16)
                fi
            fi

            let width = LLVM_TYPES.width(held)

            if LLVM_TYPES.width(amount.type) < width then
                amount = _current.convert(Conversion.ZERO_EXTEND, amount, held)
            elif LLVM_TYPES.width(amount.type) > width then
                amount = _current.convert(Conversion.TRUNCATE, amount, held)
            fi

            amount = _current.binary(BinaryOperator.AND, IntegerFlags.NONE, amount, LLVM.Values.integer(held, bigint(width - 1)))

            let operator =
                case operation
                when ArithmeticOperation.SHIFT_LEFT then BinaryOperator.SHL
                when ArithmeticOperation.SHIFT_RIGHT then BinaryOperator.ASHR
                else BinaryOperator.LSHR
                esac

            return _current.binary(operator, IntegerFlags.NONE, value, amount)
        si

        _binary(operation: ArithmeticOperation, left: Value, right: Value, is_floating: bool, held: LLVM.Type) -> LLVM.Value? is
            if !is_floating /\ _is_division(operation) then
                return _divide(operation, left, right)
            fi

            let operator = _operator(operation, is_floating)

            if !operator? then
                return null
            fi

            let l = _value_of(left)
            let r = _value_of(right)

            if !l? \/ !r? then
                return null
            fi

            if is_floating then
                return _current.floating(operator, FastMath.NONE, l, r)
            fi

            return _current.binary(operator, IntegerFlags.NONE, _bool_as_integer(l, held), _bool_as_integer(r, held))
        si

        // A bool operand of integer arithmetic is 0 or 1 at the width the
        // result is computed at, as CIL holds one, so `(a > b) - (a < b)`
        // orders. Arithmetic on bools, such as `&`, stays an `i1`.
        _bool_as_integer(value: LLVM.Value, held: LLVM.Type) -> LLVM.Value =>
            if value.type =~ Types.i1 /\ !(held =~ Types.i1) then
                _current.convert(Conversion.ZERO_EXTEND, value, held)
            else
                value
            fi


        // Integer division and remainder throw where .NET's do: on a zero
        // divisor, and, signed, on the one quotient that does not fit, the
        // most negative value divided by -1.
        _divide(operation: ArithmeticOperation, left: Value, right: Value) -> LLVM.Value? is
            let l = _value_of(left)
            let r = _value_of(right)

            if !l? \/ !r? then
                return null
            fi

            let is_zero = _current.compare(IntegerPredicate.EQ, r, LLVM.Values.integer(r.type, bigint.zero))

            _throw_if(is_zero, Semantic.Lookups.RuntimeException.DIVIDE_BY_ZERO)

            let is_signed = operation == ArithmeticOperation.DIVIDE \/ operation == ArithmeticOperation.REMAINDER

            if is_signed then
                let lowest = -(bigint.one << (LLVM_TYPES.width(l.type) - 1))
                let is_lowest = _current.compare(IntegerPredicate.EQ, l, LLVM.Values.integer(l.type, lowest))
                let is_minus_one = _current.compare(IntegerPredicate.EQ, r, LLVM.Values.integer(r.type, -bigint.one))
                let overflows = _current.binary(BinaryOperator.AND, IntegerFlags.NONE, is_lowest, is_minus_one)

                _throw_if(overflows, Semantic.Lookups.RuntimeException.OVERFLOW)
            fi

            let operator =
                case operation
                when ArithmeticOperation.DIVIDE then BinaryOperator.SDIV
                when ArithmeticOperation.DIVIDE_UNSIGNED then BinaryOperator.UDIV
                when ArithmeticOperation.REMAINDER then BinaryOperator.SREM
                else BinaryOperator.UREM
                esac

            return _current.binary(operator, IntegerFlags.NONE, l, r)
        si
        // Integer division and remainder are lowered by `_divide`.
        _operator(operation: ArithmeticOperation, is_floating: bool) -> BinaryOperator? is
            let result: BinaryOperator? =
                if is_floating then
                    case operation
                    when ArithmeticOperation.ADD then BinaryOperator.FADD
                    when ArithmeticOperation.SUBTRACT then BinaryOperator.FSUB
                    when ArithmeticOperation.MULTIPLY then BinaryOperator.FMUL
                    when ArithmeticOperation.DIVIDE then BinaryOperator.FDIV
                    when ArithmeticOperation.REMAINDER then BinaryOperator.FREM
                    else null
                    esac
                else
                    case operation
                    when ArithmeticOperation.ADD then BinaryOperator.ADD
                    when ArithmeticOperation.SUBTRACT then BinaryOperator.SUB
                    when ArithmeticOperation.MULTIPLY then BinaryOperator.MUL
                    when ArithmeticOperation.AND then BinaryOperator.AND
                    when ArithmeticOperation.OR then BinaryOperator.OR
                    when ArithmeticOperation.XOR then BinaryOperator.XOR
                    else null
                    esac
                fi

            if !result? then
                if !is_floating /\ _is_division(operation) then
                    _report("integer division")
                else
                    _report("{operation}")
                fi
            fi

            return result
        si

        _is_division(operation: ArithmeticOperation) -> bool =>
            operation == ArithmeticOperation.DIVIDE \/
            operation == ArithmeticOperation.DIVIDE_UNSIGNED \/
            operation == ArithmeticOperation.REMAINDER \/
            operation == ArithmeticOperation.REMAINDER_UNSIGNED

        visit(compare: Values.COMPARE) is
            if !_held(compare.left.type)? then
                _report("a comparison of {compare.left.type}")
                return
            fi

            let left = _value_of(compare.left)
            let right = _value_of(compare.right)

            if left? /\ right? then
                _push(_compare(compare.comparison, left, right, compare.is_unsigned))
            fi
        si

        // An unsigned comparison orders integers as unsigned, and answers true
        // for floating values with unordered operands, as CIL's `.un`
        // comparisons do. Inequality of floating values is always unordered,
        // since it is the negation of an ordered equality.
        _compare(comparison: Comparison, left: LLVM.Value, right: LLVM.Value, is_unsigned: bool) -> LLVM.Value is
            if LLVM_TYPES.is_floating(left.type) then
                let predicate =
                    case comparison
                    when Comparison.EQUAL then if is_unsigned then FloatPredicate.UEQ else FloatPredicate.OEQ fi
                    when Comparison.NOT_EQUAL then FloatPredicate.UNE
                    when Comparison.LESS then if is_unsigned then FloatPredicate.ULT else FloatPredicate.OLT fi
                    when Comparison.LESS_OR_EQUAL then if is_unsigned then FloatPredicate.ULE else FloatPredicate.OLE fi
                    when Comparison.GREATER then if is_unsigned then FloatPredicate.UGT else FloatPredicate.OGT fi
                    when Comparison.GREATER_OR_EQUAL then if is_unsigned then FloatPredicate.UGE else FloatPredicate.OGE fi
                    esac

                return _current.compare(predicate, left, right)
            fi

            let predicate =
                case comparison
                when Comparison.EQUAL then IntegerPredicate.EQ
                when Comparison.NOT_EQUAL then IntegerPredicate.NE
                when Comparison.LESS then if is_unsigned then IntegerPredicate.ULT else IntegerPredicate.SLT fi
                when Comparison.LESS_OR_EQUAL then if is_unsigned then IntegerPredicate.ULE else IntegerPredicate.SLE fi
                when Comparison.GREATER then if is_unsigned then IntegerPredicate.UGT else IntegerPredicate.SGT fi
                when Comparison.GREATER_OR_EQUAL then if is_unsigned then IntegerPredicate.UGE else IntegerPredicate.SGE fi
                esac

            return _current.compare(predicate, left, right)
        si

        visit(convert: Values.CONVERT) is
            if !convert.from? /\ !_scalar(convert.value.type)? then
                _report("unboxing a {convert.type}")
                return
            fi

            if let value = _value_of(convert.value) then
                // A source narrowed from a reference is still the box its
                // value is held in.
                if isa LLVM.Type.POINTER(value.type) then
                    if let unboxed = _unbox_value(value, convert.type) then
                        _push(unboxed)
                    fi

                    return
                fi

                _push(_convert(value, convert.from ?? Scalar.INT32, convert.to))
            fi
        si

        // The conversion of a value of kind `from` to kind `to`, saturating
        // from floating to integer as .NET does.
        _convert(value: LLVM.Value, from: Scalar, to: Scalar) -> LLVM.Value is
            // A value is true where it is not zero.
            if to == Scalar.BOOL /\ from != Scalar.BOOL then
                if LLVM_TYPES.is_floating(value.type) then
                    return _current.compare(FloatPredicate.UNE, value, LLVM_TYPES.zero(value.type))
                fi

                return _current.compare(IntegerPredicate.NE, value, LLVM_TYPES.zero(value.type))
            fi

            let source = LLVM_TYPES.value_type(from)
            let target = LLVM_TYPES.value_type(to)
            let source_unsigned = LLVM_TYPES.is_unsigned(from)
            let target_unsigned = LLVM_TYPES.is_unsigned(to)

            let changed mut = value

            if LLVM_TYPES.is_floating(source) then
                if LLVM_TYPES.is_floating(target) then
                    if source =~ LLVM.Type.DOUBLE /\ target =~ LLVM.Type.FLOAT then
                        changed = _current.convert(Conversion.FLOAT_TRUNCATE, value, target)
                    elif source =~ LLVM.Type.FLOAT /\ target =~ LLVM.Type.DOUBLE then
                        changed = _current.convert(Conversion.FLOAT_EXTEND, value, target)
                    fi
                else
                    // .NET converts to a type narrower than 32 bits through int,
                    // saturating there and then truncating, whatever the
                    // narrower type's sign.
                    let intrinsic =
                        if target_unsigned /\ !LLVM_TYPES.is_narrow(to) then
                            Intrinsics.float_to_unsigned_saturating(target, source)
                        else
                            Intrinsics.float_to_signed_saturating(target, source)
                        fi

                    changed = _current.call(_module.declare_intrinsic(intrinsic), [value])!
                fi
            elif LLVM_TYPES.is_floating(target) then
                changed =
                    _current.convert(
                        if source_unsigned then Conversion.UNSIGNED_TO_FLOAT else Conversion.SIGNED_TO_FLOAT fi,
                        value,
                        target)
            else
                let source_width = LLVM_TYPES.width(source)
                let target_width = LLVM_TYPES.width(target)

                if source_width > target_width then
                    changed = _current.convert(Conversion.TRUNCATE, value, target)
                elif source_width < target_width then
                    changed =
                        _current.convert(
                            if source_unsigned then Conversion.ZERO_EXTEND else Conversion.SIGN_EXTEND fi,
                            value,
                            target)
                fi
            fi

            if LLVM_TYPES.is_narrow(to) then
                return _normalise(changed, to)
            fi

            return changed
        si

        visit(node: Values.Breakable) is
            assert node.is_closed else "structured node generated before it was closed"

            if let region: Values.REGION = node then
                _lower_region(region, null)
            elif let loop: Values.LOOP = node then
                _lower_loop(loop)
            elif let `try: Values.TRY = node then
                if let `finally = `try.finally_region then
                    if `try.catches.count > 0 then
                        _report("a try with both catches and a finally")
                    else
                        _lower_try_finally(`try, `finally)
                    fi
                elif `try.catches.count > 0 then
                    _lower_try_catch(`try)
                else
                    _report("a try with no handler")
                fi
            elif let resumable: Values.RESUMABLE = node then
                _lower_resumable(resumable)
            else
                _report("a generator or asynchronous function")
            fi
        si

        // A region continues at a block of its own. One that produces a value
        // has each arm store the value into an `alloca` before it leaves,
        // and the value is read back where the region continues.
        _lower_region(region: Values.REGION, result_type: LLVM.Type?) is
            let end = _new_block()
            let result = if let type = result_type then _slot(type) else null fi
            let depth = _stack.count

            _labels.add((region, false, end, result, depth))

            let values = region.body.values

            // A region that ends in another produces its value through that
            // one: a block expression's statements end with the value they
            // leave, and that region falls through holding it.
            let last_region =
                if result_type? /\ values.count > 0 then
                    cast Values.REGION?(values[values.count - 1])
                else
                    null
                fi

            if let last = last_region then
                for i in 0..values.count - 1 do
                    gen(values[i])
                od

                _lower_region(last, result_type)
            else
                for value in values do
                    gen(value)
                od
            fi

            if !_is_terminated then
                _leave_with_result(result, depth)
                _branch(end)
            fi

            _labels.remove_at(_labels.count - 1)

            _start(end)

            _check_depth(depth, "region")

            if let pointer = result, type = result_type then
                _push(_current.load(type, pointer, 0))
            fi
        si

        // Stores the value an arm leaves into its region's result.
        _leave_with_result(result: LLVM.Value?, depth: int) is
            if let pointer = result /\ _stack.count > depth then
                _current.store(_pop()!, pointer, 0)
            fi
        si

        // The IR never leaves a value on the stack across a branch, so the
        // stack is as deep where a node continues as where it began.
        _check_depth(depth: int, construct: string) is
            if _stack.count != depth then
                _report("a value left on the stack across a {construct}")

                while _stack.count > depth do
                    _pop()
                od
            fi
        si

        // A loop has a header, where its body starts and where reaching the
        // end of the body and a CONTINUE both go, and a continuation a BREAK
        // goes to.
        _lower_loop(loop: Values.LOOP) is
            if let counted = _guarded_loop_of(loop) then
                _lower_loop_twice(loop, counted)
                return
            fi

            let header = _new_block()
            let end = _new_block()
            let depth = _stack.count

            _labels.add((loop, false, end, null, depth))
            _labels.add((loop, true, header, null, depth))

            _branch(header)
            _start(header)

            for value in loop.body.values do
                gen(value)
            od

            if !_is_terminated then
                _branch(header)
            fi

            _labels.remove_at(_labels.count - 1)
            _labels.remove_at(_labels.count - 1)

            _start(end)

            _check_depth(depth, "loop")
        si

        visit(exit: Values.Exit) is _route(exit, false) si

        // An exit goes to its target's block, unless it leaves the protected
        // body of a try with a finally on the way. Where `is_taken`, the
        // exit's condition has already held and any value it carries is
        // already where its target reads it: the exit is being taken again
        // after a finally.
        _route(exit: Values.Exit, is_taken: bool) is
            let is_continue = isa Values.CONTINUE(exit)

            let i mut = _labels.count - 1

            while i >= 0 do
                let label = _labels[i]

                let finally_exits: (selector: LLVM.Value, exits: IR.Program.EXIT_NUMBERING) mut

                if _finally_exits.try_get_value(i, finally_exits ref) then
                    _leave_through_finally(exit, is_taken, finally_exits.selector, finally_exits.exits, label.target)
                    return
                fi

                if label.node == exit.target /\ label.is_loop_head == is_continue then
                    if is_taken then
                        _branch(label.target)
                    else
                        _exit(exit, label.target, label.result, label.depth)
                    fi

                    return
                fi

                i = i - 1
            od

            _report("an exit from a construct the lowering does not handle")
        si

        // The label an exit goes to, outside any try it leaves.
        _target_label(exit: Values.Exit) -> (node: Values.Breakable, is_loop_head: bool, target: BLOCK, result: LLVM.Value?, depth: int)? is
            let is_continue = isa Values.CONTINUE(exit)

            let i mut = _labels.count - 1

            while i >= 0 do
                let label = _labels[i]

                if label.node == exit.target /\ label.is_loop_head == is_continue /\ !_finally_exits.contains_key(i) then
                    return label
                fi

                i = i - 1
            od

            return null
        si

        _exit(exit: Values.Exit, target: BLOCK, result: LLVM.Value?, depth: int) is
            if exit.condition == IR.BRANCH.ALWAYS then
                _leave_with_result(result, depth)
                _branch(target)
                return
            fi

            // A conditional exit from a region that produces a value leaves
            // the value on the stack for the path that carries on.
            if let pointer = result /\ _stack.count > depth then
                _current.store(_peek()!, pointer, 0)
            fi

            if let condition = _test(exit.condition, exit.operands) then
                let next = _new_block()

                _current.branch(condition, target, next)
                _start(next)
            fi
        si

        // The `i1` a conditional exit branches on.
        _test(condition: IR.BRANCH, operands: Value[]) -> LLVM.Value? is
            let first = _value_of(operands[0])

            if !first? then
                return null
            fi

            if condition == IR.BRANCH.Z \/ condition == IR.BRANCH.NZ then
                if LLVM_TYPES.is_floating(first.type) then
                    _report("a condition on {operands[0].type}")
                    return null
                fi

                // A bool is its own condition.
                if first.type =~ Types.i1 then
                    return
                        if condition == IR.BRANCH.Z then
                            _current.binary(BinaryOperator.XOR, IntegerFlags.NONE, first, LLVM.Values.boolean(true))
                        else
                            first
                        fi
                fi

                return _current.compare(
                    if condition == IR.BRANCH.Z then IntegerPredicate.EQ else IntegerPredicate.NE fi,
                    first,
                    LLVM_TYPES.zero(first.type))
            fi

            if operands.count < 2 then
                _report("the condition {condition}")
                return null
            fi

            let second = _value_of(operands[1])

            if !second? then
                return null
            fi

            let comparison: (Comparison, bool)? =
                case condition
                when IR.BRANCH.EQ then (Comparison.EQUAL, false)
                when IR.BRANCH.NE then (Comparison.NOT_EQUAL, true)
                when IR.BRANCH.GE then (Comparison.GREATER_OR_EQUAL, false)
                when IR.BRANCH.GEU then (Comparison.GREATER_OR_EQUAL, true)
                when IR.BRANCH.GT then (Comparison.GREATER, false)
                when IR.BRANCH.GTU then (Comparison.GREATER, true)
                when IR.BRANCH.LE then (Comparison.LESS_OR_EQUAL, false)
                when IR.BRANCH.LEU then (Comparison.LESS_OR_EQUAL, true)
                when IR.BRANCH.LT then (Comparison.LESS, false)
                when IR.BRANCH.LTU then (Comparison.LESS, true)
                else null
                esac

            if let (operation, is_unsigned) = comparison then
                return _compare(operation, first, second, is_unsigned)
            fi

            _report("the condition {condition}")

            return null
        si

        /// A resumed state machine finds its place through one `switch` on its
        /// state, which can enter a resume point's block wherever it is,
        /// inside a try included: the try's landing pad belongs to its calls,
        /// not to how control reached them. Any other state carries on.
        visit(dispatch: Values.DISPATCH) is
            // An enclosing dispatch reaches a resume point inside a try by
            // jumping to the try's own dispatch, at its top.
            let top = _resume_block(dispatch.top)

            if !_is_terminated then
                _current.branch(top)
            fi

            _start(top)

            if let state = _local(dispatch.state_local) then
                let carry_on = _new_block()
                let cases = LIST[(LLVM.Value, BLOCK)]()

                for (value, target) in dispatch.entries do
                    cases.add((LLVM.Values.integer(state.type, bigint(value)), _resume_block(target)))
                od

                _current.switch(_current.load(state.type, state.pointer, 0), carry_on, cases.to_array())
                _is_terminated = true

                _start(carry_on)
            else
                _report("a dispatch on a state with no local")
            fi
        si

        /// A resume point is a block of its own, which control falls into
        /// and a dispatch can jump to.
        visit(resume: Values.RESUME_POINT) is
            let block = _resume_block(resume.label)

            if !_is_terminated then
                _current.branch(block)
            fi

            _start(block)
        si

        _resume_block(label: IR.LABEL) -> BLOCK is
            let found: BLOCK mut

            if _resume_blocks.try_get_value(label, found ref) then
                return found
            fi

            let block = _new_block()

            _resume_blocks[label] = block

            return block
        si

        // A state machine's resumable body is a region that a suspend inside a
        // try leaves, continuing after it where the method returns.
        _lower_resumable(resumable: Values.RESUMABLE) is
            let end = _new_block()

            _labels.add((resumable, false, end, null, _stack.count))

            for value in resumable.body.values do
                gen(value)
            od

            if !_is_terminated then
                _branch(end)
            fi

            _labels.remove_at(_labels.count - 1)

            _start(end)
        si

        _frame_field_load(`field: Semantic.Symbols.Field) -> Value =>
            Values.Load.INSTANCE_FIELD(Values.Load.REFERENCE_SELF(cast Semantic.Symbols.Classy(`field.owner)), `field)

        _frame_field_store(`field: Semantic.Symbols.Field, value: Value) -> Value =>
            Values.Store.INSTANCE_FIELD(Values.Load.REFERENCE_SELF(cast Semantic.Symbols.Classy(`field.owner)), `field, value)

        visit(call: Values.Call.GLOBAL) is
            _call(call.function, call.arguments)
        si

        /// A static method takes no receiver, so it is called as a global
        /// function is.
        visit(call: Values.Call.STATIC) is
            _ensure_initialised(call.function.owner)
            _call(call.function, call.arguments)
        si

        // A struct method is called with the address of its receiver, so it
        // changes the struct where it is held.
        visit(call: Values.Call.STRUCT) is
            _call_struct(call.from, call.function, call.arguments)
        si

        _call_struct(from: Value, function: Function, arguments: Value[]) is

            if function.intrinsic_operation? then
                _report("the intrinsic {function.intrinsic_operation} on a value")
                return
            fi

            let callee = _callee(_instance_of(function))

            if !callee? then
                _report("a call to {function.name}")
                return
            fi

            let receiver = _address_of(from)

            if !receiver? then
                return
            fi

            if let values = _arguments_for(function, arguments) then
                values.insert(0, receiver)

                if let result = _emit_call(callee, values.to_array()) then
                    _push(result)
                fi
            fi
        si

        /// An array's count and indexer lower to the operations they stand
        /// for. No other instance method can be called yet.
        visit(call: Values.Call.INSTANCE) is
            let operation = _array_operation(call.function)

            if operation =~ "array.count" then
                if let _ = _array_of(call.from.type), array = _value_of(call.from) then
                    _check_dereference(array)
                    _push(_arrays!.count(_current, array))
                fi
            elif operation =~ "array.get" then
                if let type = _array_of(call.from.type), array = _value_of(call.from), index = _value_of(call.arguments[0]) then
                    _check_index(array, index)

                    _push(_arrays!.load(_current, type, array, index))
                fi
            else
                _call_instance(call)
            fi
        si

        /// A built-in operation lowers to the IR the operation stands for,
        /// made once and reused by every later lowering of the same body.
        visit(call: Values.Call.INNATE) is
            if call.innate_name =~ "object.type_name" then
                _type_name(call.arguments[0])
            elif call.innate_name =~ "object.get_type" then
                if let from = call.from, value = _value_of(from), t = _type_object_of(value) then
                    _push(t)
                fi
            elif call.innate_name.starts_with("host.") \/ call.innate_name.starts_with("object.") then
                _report("the operation {call.innate_name}")
            elif call.innate_name.starts_with("nullable.") then
                _lower_nullable(call.innate_name, call.from)
            elif call.innate_name.starts_with("string.") then
                _call_string(call.innate_name, call.arguments)
            elif call.innate_name =~ "bigint.is_small" \/ call.innate_name =~ "bigint.small" then
                _lower_bigint_field(call.innate_name, call.arguments[0])
            elif call.is_lowered then
                gen(call.lowering)
            else
                gen(call.lower())
            fi
        si

        // The instance a call from this body names: a reference from inside a
        // generic body takes its type arguments from the body's own.
        _instance_of(function: Function) -> FUNCTION_INSTANCE =>
            FUNCTION_INSTANCE(
                cast Function?(function.root_specialized_from)!,
                TYPE_MAPS.function_map(function, _type_map))

        _call(function: Function, arguments: Value[]) is
            if function.is_extern then
                _call_extern(function, arguments)
                return
            fi

            // A constructor intrinsic is an ordinary method, called as one.
            if let operation = function.intrinsic_operation /\ !operation.starts_with("constructor.") then
                if operation.starts_with("host.") then
                    _call_host(operation.substring(5), function, arguments)
                elif operation =~ "array.new" then
                    _new_array(_instance_of(function).specialize(cast Function?(function.root_specialized_from)!.return_type), arguments[0])
                elif operation =~ "array.set" then
                    _store_array_element(arguments[0], arguments[1], arguments[2])
                elif operation.starts_with("string.") then
                    _call_string(operation, arguments)
                elif operation =~ "type.size_of" then
                    _push(LLVM.Values.i32(_size_of(function.generic_arguments[0])))
                elif operation =~ "bigint.is_small" \/ operation =~ "bigint.small" then
                    _lower_bigint_field(operation, arguments[0])
                elif operation =~ "object.type_name" then
                    _type_name(arguments[0])
                elif operation =~ "double.bits" \/ operation =~ "single.bits" then
                    // The bits of a floating value, as the integer of its width.
                    if let value = _value_of(arguments[0]) then
                        _push(_current.convert(Conversion.BIT_CAST, value, if operation =~ "double.bits" then Types.i64 else Types.i32 fi))
                    fi
                elif operation =~ "object.get_type" then
                    if let value = _value_of(arguments[0]), t = _type_object_of(value) then
                        _push(t)
                    fi
                elif operation =~ "object.display" then
                    _display(arguments[0], arguments[1])
                elif operation =~ "object.memberwise_clone" \/ operation =~ "object.identity_hash" then
                    // A shallow copy of the whole allocation, and a hash of an
                    // address the collector never moves: both are libghul's.
                    let clone = operation =~ "object.memberwise_clone"

                    if let strings = _strings, value = _value_of(arguments[0]) then
                        let runtime =
                            if clone then
                                strings.runtime("$ghul_clone", Types.pointer, [Types.pointer])
                            else
                                strings.runtime("$ghul_identity_hash", Types.i32, [Types.pointer])
                            fi

                        if let answer = _current.call(runtime, [value]) then
                            _push(answer)
                        fi
                    else
                        _report("the intrinsic {operation}")
                    fi
                else
                    _report("the intrinsic {operation}")
                fi

                return
            fi

            let callee = _callee(_instance_of(function))

            if !callee? then
                _report("a call to {function.name}")
                return
            fi

            let values = LIST[LLVM.Value]()
            let parameters = function.arguments

            for i in 0..arguments.count do
                if let value = _value_of(arguments[i]) then
                    values.add(if i < parameters.count then _normalise_for(value, parameters[i]) else value fi)
                else
                    return
                fi
            od

            if let result = _emit_call(callee, values.to_array()) then
                _sources[result] = EXACT_SOURCE(null, _instance_of(function), null)
                _push(result)
            fi
        si


        // An interpolation's builder operations, as INTERPOLATION_CALLS gives
        // them. Answers false for any other operation.
        _lower_builder(runtime: Values.RUNTIME) -> bool is
            let operands = runtime.operands
            let calls = INTERPOLATION_CALLS(_report(*))

            case runtime.operation
            when IR.RuntimeOperation.NEW_STRING_BUILDER then
                _gen_call(calls.new_builder(runtime.type, operands), false)

            when IR.RuntimeOperation.APPEND_TEXT then
                _gen_call(calls.append(operands[0], operands[1]), true)

            when IR.RuntimeOperation.APPEND_VALUE then
                _gen_call(calls.append(operands[0], calls.text_of(operands[1], _specialize(operands[1].type))), true)

            when IR.RuntimeOperation.BUILD_STRING then
                _gen_call(calls.build(operands[0]), false)

            when IR.RuntimeOperation.APPEND_ALIGNED_VALUE then
                _gen_call(calls.append_aligned(operands[0], calls.text_of(operands[1], _specialize(operands[1].type)), operands[2]), true)

            when IR.RuntimeOperation.APPEND_FORMATTED_VALUE then
                _gen_call(calls.append(operands[0], calls.formatted_text_of(operands[1], operands[2], _specialize(operands[1].type))), true)

            when IR.RuntimeOperation.APPEND_ALIGNED_FORMATTED_VALUE then
                _gen_call(calls.append_aligned(operands[0], calls.formatted_text_of(operands[1], operands[3], _specialize(operands[1].type)), operands[2]), true)

            else
                return false
            esac

            return true
        si

        // Lowers `call`, dropping any result it leaves where `discard` says
        // to.
        _gen_call(call: Value?, discard: bool) is
            if let c = call then
                let depth = _stack.count

                gen(c)

                if discard /\ _stack.count > depth then
                    _pop()
                fi
            fi
        si
        // The core library's string intrinsics. A string's length is where an
        // array's count is, so an index into one is checked as an array
        // index is.
        _call_string(operation: string, arguments: Value[]) is
            let strings = _strings

            if !strings? then
                _report("the intrinsic {operation}")
                return
            fi

            if operation =~ "string.length" then
                if let text = _value_of(arguments[0]) then
                    _check_dereference(text)
                    _push(strings.length(_current, text))
                fi
            elif operation =~ "string.char_at" then
                let text = _value_of(arguments[0])
                let index = _value_of(arguments[1])

                if text? /\ index? then
                    _check_index(text, index)
                    _push(strings.char_at(_current, text, index))
                fi
            elif operation =~ "string.concat" then
                _call_string_helper(strings.concat_function, arguments)
            elif operation =~ "string.equals" then
                _call_string_helper(strings.equals_function, arguments)
            elif operation =~ "string.substring" then
                _call_string_helper(strings.substring_function, arguments)
            elif operation =~ "string.from_chars" then
                // An array of `char` has a string's layout, its count where a
                // string's length is and its code units where a string's are,
                // so the substring helper copies a range of one as it is.
                _call_string_helper(strings.substring_function, arguments)
            elif operation =~ "string.copy_to" then
                _call_string_helper(strings.copy_to_function, arguments)
            elif operation =~ "string.from_char" then
                _call_string_helper(strings.from_char_function, arguments)
            else
                _report("the intrinsic {operation}")
            fi
        si

        // Calls one of the string helpers the module defines, with `arguments`
        // as they are held. A helper answering an `i1` answers a `bool`.
        _call_string_helper(helper: LLVM.FUNCTION?, arguments: Value[]) is
            if !helper? then
                _report("a string operation")
                return
            fi

            let values = LIST[LLVM.Value]()

            for argument in arguments do
                if let value = _value_of(argument) then
                    values.add(value)
                else
                    return
                fi
            od

            if let result = _current.call(helper, values.to_array()) then
                _push(result)
            fi
        si


        // A new bigint box holding `small` in its i64 field and `big`, the
        // runtime's integer or null, in the other. It holds a pointer, so it
        // is one the collector scans.
        _new_bigint(objects: LLVM_OBJECTS, type: CLASS_INSTANCE, small: LLVM.Value, big: LLVM.Value) -> LLVM.Value is
            objects.note_allocated(type)

            let box =
                _strings!.allocate_object(_current, LLVM.Values.global(objects.descriptor_name(type)), LLVM.Values.i64(cast long(objects.size_of(type))), true)

            let layout = objects.struct_type(type)

            _current.store(small, _current.element_pointer(layout, box, [_i32(0), _i32(LLVM_OBJECTS.BIGINT_SMALL)], true), 0)
            _current.store(big, _current.element_pointer(layout, box, [_i32(0), _i32(LLVM_OBJECTS.BIGINT_BIG)], true), 0)

            return box
        si


        // The name of the type of the object `value` is, which every
        // descriptor holds as a string.
        _type_name(value: Value) is
            if let object = _value_of(value) then
                _check_dereference(object)

                let descriptor = _strings!.load_descriptor(_current, object)

                _push(_current.load(Types.pointer, _current.element_pointer(Types.i8, descriptor, [_i32(LLVM_OBJECTS.DESCRIPTOR_NAME)], true), 8))
            fi
        si
        // A bigint whose value its i64 field holds: `value`, a long or an int.
        _bigint_of_small(type: Type?, value: Value) is
            let objects = _objects
            let b = if let o = objects then o.bigint_of(_specialize(type)) else null fi

            if !objects? \/ !b? then
                _report("a bigint made from a {value.type}")
                return
            fi

            if let held = _value_of(value) then
                let small = if LLVM_TYPES.width(held.type) < 64 then _current.convert(Conversion.SIGN_EXTEND, held, Types.i64) else held fi

                _push(_new_bigint(objects, b, small, LLVM.Values.null_pointer))
            fi
        si

        // The bigint `box` points at's i64 field, or whether that holds its
        // value: where it does, the runtime's integer is null.
        _lower_bigint_field(operation: string, value: Value) is
            let objects = _objects
            let b = if let o = objects then o.bigint_of(_specialize(value.type)) else null fi

            if !objects? \/ !b? then
                _report("{operation} on a {value.type}")
                return
            fi

            if let box = _value_of(value) then
                let layout = objects.struct_type(b)

                if operation =~ "bigint.small" then
                    _push(_current.load(Types.i64, _current.element_pointer(layout, box, [_i32(0), _i32(LLVM_OBJECTS.BIGINT_SMALL)], true), 0))
                else
                    let big = _current.load(Types.pointer, _current.element_pointer(layout, box, [_i32(0), _i32(LLVM_OBJECTS.BIGINT_BIG)], true), 0)

                    _push(_current.compare(IntegerPredicate.EQ, big, LLVM.Values.null_pointer))
                fi
            fi
        si

        // The runtime's integer for the bigint `box` points at: the one it
        // holds, or, for a value its i64 field holds, one made from that.
        _bigint_to_host(box: LLVM.Value) -> LLVM.Value is
            let layout = LLVM.Types.structure([Types.pointer, Types.i64, Types.pointer])

            let slot = _slot(Types.pointer)
            let big = _current.load(Types.pointer, _current.element_pointer(layout, box, [_i32(0), _i32(LLVM_OBJECTS.BIGINT_BIG)], true), 0)

            _current.store(big, slot, 0)

            let from_small = _new_block()
            let join = _new_block()

            _current.branch(_current.compare(IntegerPredicate.EQ, big, LLVM.Values.null_pointer), from_small, join)

            _start(from_small)

            let small = _current.load(Types.i64, _current.element_pointer(layout, box, [_i32(0), _i32(LLVM_OBJECTS.BIGINT_SMALL)], true), 0)
            let made = _current.call(_strings!.runtime(LLVM_STRINGS.host_name("bigint_from_long"), Types.pointer, [Types.i64]), [small])!

            _current.store(made, slot, 0)
            _current.branch(join)

            _start(join)

            return _current.load(Types.pointer, slot, 0)
        si

        // Wraps the runtime's integer `big` in a new bigint box, which the
        // core library's `_canonical` moves into the i64 field where it fits,
        // as every other bigint operation looks there first.
        _bigint_from_host(b: CLASS_INSTANCE, type: Type, big: LLVM.Value) is
            let canonical = _static_method(type, "_canonical", 1)

            if !canonical? then
                _report("a bigint the runtime answers with, with no bigint._canonical")
                return
            fi

            let box = _new_bigint(_objects!, b, LLVM.Values.i64(0L), big)

            if let callee = _callee(_instance_of(canonical)) then
                if let result = _emit_call(callee, [box]) then
                    _push(result)
                fi
            else
                _report("a call to {canonical.name}")
            fi
        si

        // The static method of `type` named `name` that takes `arity`
        // arguments.
        _static_method(type: Type?, name: string, arity: int) -> Function? is
            let found = type?.find_member(name)

            if let group: Semantic.Symbols.FUNCTION_GROUP = found then
                for function in group.functions do
                    if !function.is_instance /\ function.arguments.count == arity then
                        return function
                    fi
                od
            elif let function: Function = found /\ !function.is_instance /\ function.arguments.count == arity then
                return function
            fi

            return null
        si
        // A host operation is a function the native runtime defines, named
        // for the operation. A string crosses as the address of its code
        // units and their count, and comes back as a string the runtime made
        // through `ghul_make_string`.
        _call_host(operation: string, function: Function, arguments: Value[]) is
            _call_host(operation, function, arguments, function.return_type)
        si

        // A bigint crosses as the runtime's integer, made from its i64 field
        // where that holds the value, and comes back wrapped in a new box.
        _call_host(operation: string, function: Function, arguments: Value[], result: Type?) is
            let strings = _strings

            if !strings? then
                _report("the host operation {operation}")
                return
            fi

            let parameter_types = LIST[LLVM.Type]()
            let parameter_attributes = LIST[LLVM.Attribute?]()
            let values = LIST[LLVM.Value]()
            let formals = function.arguments

            for i in 0..arguments.count do
                let formal = if i < formals.count then formals[i] else arguments[i].type fi

                let value = _value_of(arguments[i])

                if !value? then
                    return
                fi

                if let scalar = _scalar(formal) then
                    parameter_types.add(_c_type(scalar))
                    parameter_attributes.add(_c_extension(scalar))
                    values.add(_to_c(value, scalar))
                elif _is_string(_specialize(formal)) then
                    // A null string reaches the host as the empty string, as
                    // .NET writes nothing for one.
                    let text = _current.select(_current.compare(IntegerPredicate.EQ, value, LLVM.Values.null_pointer), strings.literal(""), value)

                    parameter_types.add(Types.pointer)
                    parameter_types.add(Types.i32)
                    parameter_attributes.add(null)
                    parameter_attributes.add(null)
                    values.add(strings.chars(_current, text))
                    values.add(strings.length(_current, text))
                elif _objects?.bigint_of(_specialize(formal))? then
                    parameter_types.add(Types.pointer)
                    parameter_attributes.add(null)
                    values.add(_bigint_to_host(value))
                elif let arrays = _arrays, array = arrays.array_of(_specialize(formal)) /\ LLVM_TYPES.scalar(arrays.element_of(array)) =~ Scalar.UINT8 then
                    // A ubyte[] crosses as C takes bytes: the address of its
                    // first element and how many there are.
                    parameter_types.add(Types.pointer)
                    parameter_types.add(Types.i32)
                    parameter_attributes.add(null)
                    parameter_attributes.add(null)
                    values.add(arrays.element_address(_current, array, value, _i32(0)))
                    values.add(arrays.count(_current, value))
                else
                    _report("a host operation taking {formal}")
                    return
                fi
            od

            let result_scalar = if LLVM_TYPES.is_void(result) then null else _scalar(result) fi

            let result_type =
                if LLVM_TYPES.is_void(result) then
                    LLVM.Type.VOID
                elif let scalar = result_scalar then
                    _c_type(scalar)
                else
                    _held(result)
                fi

            if !result_type? then
                _report("a host operation answering {result}")
                return
            fi

            let host = strings.runtime(LLVM_STRINGS.host_name(operation), result_type, parameter_types.to_array())

            // A small scalar crosses as the C prototype declares it, and is
            // extended to a register by the side that passes it, as clang
            // declares one.
            if host.result_attributes.count == 0 then
                if let scalar = result_scalar, extension = _c_extension(scalar) then
                    host.result_attributes.add(extension)
                fi

                for (i, attribute) in parameter_attributes |> Ghul.Pipes.index() do
                    if let a = attribute /\ host.parameters[i].attributes.count == 0 then
                        host.parameters[i].attributes.add(a)
                    fi
                od
            fi

            if let answer = _current.call(host, values.to_array()) then
                if let b = _objects?.bigint_of(_specialize(result)) then
                    _bigint_from_host(b, _specialize(result)!, answer)
                elif let scalar = result_scalar then
                    _push(_from_c(answer, scalar))
                else
                    _push(answer)
                fi
            fi
        si

        // A call to a function the program is linked with: the C symbol is
        // declared as the signature says and called with the C ABI. A string
        // argument is a NUL-terminated UTF-8 copy made for the call and
        // released after it; a string answer is copied out, and released
        // too where the declaration says the callee handed it over.
        _call_extern(function: Function, arguments: Value[]) is
            let strings = _strings
            let import = function.extern_import

            if !strings? \/ !import? then
                _report("a call to {function.name}")
                return
            fi

            let result = _specialize(function.return_type)
            let formals = function.arguments
            let parameter_types = LIST[LLVM.Type]()
            let parameter_attributes = LIST[LLVM.Attribute?]()
            let values = LIST[LLVM.Value]()
            let buffers = LIST[LLVM.Value]()

            for i in 0..arguments.count do
                let formal = if i < formals.count then formals[i] else arguments[i].type fi
                let value = _value_of(arguments[i])

                if !value? then
                    return
                fi

                if let scalar = _scalar(formal) then
                    parameter_types.add(_c_type(scalar))
                    parameter_attributes.add(_c_extension(scalar))
                    values.add(_to_c(value, scalar))
                elif _is_string(_specialize(formal)) then
                    let text = _current.select(_current.compare(IntegerPredicate.EQ, value, LLVM.Values.null_pointer), strings.literal(""), value)
                    let buffer = _c_string(strings, text)

                    parameter_types.add(Types.pointer)
                    parameter_attributes.add(null)
                    values.add(buffer)
                    buffers.add(buffer)
                else
                    _report("a foreign function taking {formal}")
                    return
                fi
            od

            let result_scalar = if LLVM_TYPES.is_void(result) then null else _scalar(result) fi
            let answers_string = !LLVM_TYPES.is_void(result) /\ !result_scalar? /\ _is_string(result)

            let result_type =
                if LLVM_TYPES.is_void(result) then
                    LLVM.Type.VOID
                elif let scalar = result_scalar then
                    _c_type(scalar)
                elif answers_string then
                    Types.pointer
                else
                    null
                fi

            if !result_type? then
                _report("a foreign function answering {result}")
                return
            fi

            let callee = strings.runtime(import.name, result_type, parameter_types.to_array())

            // A small argument is extended to a register, as clang does for
            // the callee that relies on it. A small result is not marked
            // extended: a callee built by another compiler may leave the
            // upper bits of the register as they were, so the extension is
            // made here from the bits the type says are meaningful.
            for (i, attribute) in parameter_attributes |> Ghul.Pipes.index() do
                if let a = attribute /\ callee.parameters[i].attributes.count == 0 then
                    callee.parameters[i].attributes.add(a)
                fi
            od

            let answer = _current.call(callee, values.to_array())

            for buffer in buffers do
                _current.call(strings.runtime("free", LLVM.Type.VOID, [Types.pointer]), [buffer])
            od

            if !answer? then
                return
            fi

            if let scalar = result_scalar then
                _push(_from_c(answer, scalar))
            elif answers_string then
                _push(_string_from_c(strings, answer, import.result == Semantic.ExternResult.TAKE))
            fi
        si

        // `text` as NUL-terminated UTF-8 in memory from the C library's
        // malloc, which the caller frees.
        _c_string(strings: LLVM_STRINGS, text: LLVM.Value) -> LLVM.Value is
            let length = strings.length(_current, text)
            let wide = _current.convert(Conversion.ZERO_EXTEND, length, Types.i64)
            let room = _current.binary(LLVM.BinaryOperator.ADD, LLVM.IntegerFlags.NONE, _current.binary(LLVM.BinaryOperator.MUL, LLVM.IntegerFlags.NONE, wide, LLVM.Values.i64(3L)), LLVM.Values.i64(4L))
            let buffer = _current.call(strings.runtime("malloc", Types.pointer, [Types.i64]), [room])!
            let pending = _slot(Types.i16)

            _current.store(LLVM.Values.integer(Types.i16, 0n), pending, 2)
            let size = _current.call(
                strings.runtime("$libghul_utf8_encode", Types.i64, [Types.pointer, Types.i32, Types.pointer, Types.pointer]),
                [strings.chars(_current, text), length, buffer, pending])!

            _current.store(LLVM.Values.integer(Types.i8, 0n), _current.element_pointer(Types.i8, buffer, [size], true), 1)

            return buffer
        si

        // A string made from the NUL-terminated UTF-8 at `address`, or the
        // absent string for a null address; `release` frees the original
        // with the C library's free once it is copied.
        _string_from_c(strings: LLVM_STRINGS, address: LLVM.Value, release: bool) -> LLVM.Value is
            let slot = _slot(Types.pointer)
            let present = _new_block()
            let join = _new_block()

            _current.store(LLVM.Values.null_pointer, slot, 0)
            _current.branch(_current.compare(IntegerPredicate.NE, address, LLVM.Values.null_pointer), present, join)

            _start(present)

            let text = _slot(Types.structure([Types.pointer, Types.i32, Types.i32]))
            let length = _current.call(strings.runtime("strlen", Types.i64, [Types.pointer]), [address])!

            _current.call(
                strings.runtime("$libghul_utf8_decode", LLVM.Type.VOID, [Types.pointer, Types.i64, Types.pointer]),
                [address, length, text])

            _current.store(_current.call(strings.runtime("$libghul_utf16_make_string", Types.pointer, [Types.pointer]), [text])!, slot, 0)

            if release then
                _current.call(strings.runtime("free", LLVM.Type.VOID, [Types.pointer]), [address])
            fi

            _current.branch(join)

            _start(join)

            return _current.load(Types.pointer, slot, 0)
        si

        // The type a value of the kind has in a C prototype: a bool as an
        // `i1`, a small integer at its width, anything else as it is held.
        _c_type(scalar: Scalar) -> LLVM.Type =>
            if scalar == Scalar.BOOL then Types.i1 else LLVM_TYPES.stored_type(scalar) fi

        // How C extends a value of the kind to a register: `zeroext` for a
        // bool or an unsigned small kind, `signext` for a signed one.
        _c_extension(scalar: Scalar) -> LLVM.Attribute? =>
            if scalar != Scalar.BOOL /\ !LLVM_TYPES.is_narrow(scalar) then
                null
            elif LLVM_TYPES.is_unsigned(scalar) then
                LLVM.Attribute.FLAG("zeroext")
            else
                LLVM.Attribute.FLAG("signext")
            fi

        // `value`, as the kind is computed with, as C passes it: a bool is
        // the `i1` it already is.
        _to_c(value: LLVM.Value, scalar: Scalar) -> LLVM.Value =>
            if scalar == Scalar.BOOL then value else LLVM_TYPES.narrow(_current, value, scalar) fi

        // `value`, as C passes it, as the kind is computed with.
        _from_c(value: LLVM.Value, scalar: Scalar) -> LLVM.Value =>
            if scalar == Scalar.BOOL then value else LLVM_TYPES.widen(_current, value, scalar) fi

        visit(store: Values.Store.SYMBOL) is _report("a store to {store.symbol.name}") si

        visit(store: Values.Store.LOCAL_VARIABLE) is
            if let state_machine_field = Values.state_machine_field_for(store.symbol) then
                gen(_frame_field_store(state_machine_field, store.value))
            elif let variable = cast Semantic.Symbols.Variable?(store.symbol) then
                _store_local(variable.ir_local, _value_of(store.value))
            else
                _report("a store to {store.symbol.name}")
            fi
        si

        visit(store: Values.Store.LOCAL_ARGUMENT) is
            let symbol = store.symbol

            if let state_machine_field = Values.state_machine_field_for(symbol) then
                gen(_frame_field_store(state_machine_field, store.value))
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _store_local(packed_local, _value_of(store.value))
            elif let index = _argument_index(symbol) then
                _store_argument(index, _value_of(store.value), symbol.type)
            else
                _report("a store to an argument of another function")
            fi
        si

        _load_receiver() is
            if _receiver_offset == 0 then
                _report("self outside an instance method")
            else
                _load_argument(0)
            fi
        si

        // The class a member's owner is, at the arguments this body gives
        // it.
        _owner_class(owner: Semantic.Scope?) -> CLASS_INSTANCE? is
            if let objects = _objects then
                if let generic: Semantic.Symbols.GENERIC = owner then
                    return objects.class_of(_specialize(generic.type))
                elif let classy: Semantic.Symbols.Classy = owner then
                    return objects.class_of(classy, _type_map)
                fi
            fi

            return null
        si

        // The instance of the trait a member's owner is, at the arguments
        // this body gives it.
        _trait_instance(owner: Semantic.Scope?) -> CLASS_INSTANCE? is
            if let objects = _objects then
                if let generic: Semantic.Symbols.GENERIC = owner then
                    return objects.trait_of(_specialize(generic.type)!)
                elif let classy: Semantic.Symbols.Classy = owner then
                    return objects.trait_of(classy, _type_map)
                fi
            fi

            return null
        si

        // A type's static constructor runs once, before the type is first
        // used: before a static member is read, written or called, and before
        // an instance is made. Its flag is set before the body runs, so a use
        // of the type from inside it does not run it again.
        _ensure_initialised(owner: Semantic.Scope?) is
            if let objects = _objects, type = _owner_class(owner), (constructor, flag) = objects.static_constructor(type) then
                let callee = _callee(constructor)

                if !callee? then
                    _report("a static constructor of {type}")
                    return
                fi

                let run = _new_block()
                let carry_on = _new_block()
                let state = _current.load(Types.i32, LLVM.Values.global(flag), 4)

                _current.branch(_current.compare(IntegerPredicate.EQ, state, _i32(0)), run, carry_on)

                _note_guard(_current, flag, carry_on)

                _start(run)

                _current.store(_i32(1), LLVM.Values.global(flag), 4)
                _emit_call(callee, [])
                _current.branch(carry_on)

                _start(carry_on)
            fi
        si

        // The type object `descriptor` stands for, a constant beside it, so
        // a type has one type object however it is asked for. Null, reported,
        // where the core library declares no type object.
        _type_object(descriptor: LLVM.Value) -> LLVM.Value? is
            if !_type_object_constructor()? then
                _report("a type object")
                return null
            fi

            return _current.load(Types.pointer, _current.element_pointer(Types.i8, descriptor, [_i32(LLVM_OBJECTS.DESCRIPTOR_TYPE_OBJECT)], true), 8)
        si

        _type_object_constructor() -> (CLASS_INSTANCE, Function)? is
            if let constructor = IR.Program.CORE_LIBRARY.constructor(IR.Program.CORE_LIBRARY.type_class(), 1) then
                if let type = _owner_class(constructor.owner), objects = _objects /\ objects.is_object_type(type) then
                    return (type, constructor)
                fi
            fi

            return null
        si

        // The type object of the object `value` points to, which throws where
        // `value` is null.
        _type_object_of(value: LLVM.Value) -> LLVM.Value? is
            _check_dereference(value)

            return _type_object(_current.load(Types.pointer, value, 8))
        si

        // Whether a call to `function` asks for its receiver's type object,
        // which no type can override: a member declaring the same name
        // hides it.
        _is_get_type(function: Function) -> bool =>
            cast Function?(function.root_specialized_from)?.intrinsic_operation =~ "object.get_type"

        // The type object of `call`'s receiver: the one its descriptor stands
        // for, or, for a value held in place, the one its box's descriptor does.
        _get_type(call: Values.Call.INSTANCE) is
            let receiver: Value mut = call.from

            if let constrained: Values.CONSTRAINED = receiver then
                receiver = if let address: Values.ADDRESS = constrained.value then address.value else constrained.value fi

                let type = _specialize(constrained.type)

                if !_held(type)? \/ !isa LLVM.Type.POINTER(_held(type)!) then
                    _value_of(receiver)

                    if let box = _objects!.box_type(type) ?? _objects!.struct_of(type) then
                        if let t = _type_object(LLVM.Values.global(_objects!.descriptor_name(box))) then
                            _push(t)
                        fi
                    else
                        _report("the type of a {type}")
                    fi

                    return
                fi
            fi

            if let value = _value_of(receiver), t = _type_object_of(value) then
                _push(t)
            fi
        si

        // Writes `value` for display through `state`, a core library display
        // state, with the function its descriptor holds: true where it has
        // one, and false, leaving `state` as it was, where it has none.
        _display(value: Value, state: Value) is
            let objects = _objects!

            if let state_class = objects.class_of(_specialize(state.type)) then
                objects.note_display(state_class)
            fi

            if let v = _value_of(value), s = _value_of(state) then
                let descriptor = _strings!.load_descriptor(_current, v)
                let displayer = _current.load(Types.pointer, _current.element_pointer(Types.i8, descriptor, [_i32(LLVM_OBJECTS.DESCRIPTOR_DISPLAY)], true), 8)
                let result = _slot(Types.i1)

                _current.store(LLVM.Values.boolean(false), result, 1)

                let call = _new_block()
                let carry_on = _new_block()

                _current.branch(_current.compare(IntegerPredicate.NE, displayer, LLVM.Values.null_pointer), call, carry_on)

                _start(call)

                _current.call(LLVM.Type.FUNCTION(LLVM.Type.VOID, [Types.pointer, Types.pointer], false), displayer, [v, s])
                _current.store(LLVM.Values.boolean(true), result, 1)
                _current.branch(carry_on)

                _start(carry_on)

                _push(_current.load(Types.i1, result, 1))
            fi
        si

        // Throws a new instance of the core library's exception class for
        // `kind`, such as an invalid cast, where `condition`, an `i1`, holds.
        // Where the program has no such class, what is thrown carries no type
        // or message.
        _throw_if(condition: LLVM.Value, kind: Semantic.Lookups.RuntimeException) is
            let thrown = _new_block()
            let carry_on = _new_block()

            _current.branch(condition, thrown, carry_on)

            _start(thrown)

            _throw_new(kind)

            _start(carry_on)
        si

        // The exception a runtime operation makes, or null where it makes
        // none.
        _runtime_exception(operation: IR.RuntimeOperation) -> Semantic.Lookups.RuntimeException? =>
            case operation
            when IR.RuntimeOperation.NEW_NOT_IMPLEMENTED then Semantic.Lookups.RuntimeException.NOT_IMPLEMENTED
            when IR.RuntimeOperation.NEW_NOT_SUPPORTED then Semantic.Lookups.RuntimeException.NOT_SUPPORTED
            when IR.RuntimeOperation.NEW_ASSERT_FAILED then Semantic.Lookups.RuntimeException.ASSERT_FAILED
            else null
            esac

        // A new instance of the core library's exception class for `kind`,
        // made by its constructor taking `arguments`, or null, reported, where
        // the program declares no such constructor.
        _new_exception(kind: Semantic.Lookups.RuntimeException, arguments: Value[]) -> LLVM.Value? is
            let name = Semantic.Lookups.RUNTIME_EXCEPTIONS.name_of(kind)

            if let constructor = IR.Program.CORE_LIBRARY.constructor(IR.Program.CORE_LIBRARY.exception_class(kind), arguments.count) then
                return _construct(constructor, arguments, name)
            fi

            _report("a {name} constructor taking {arguments.count} arguments")

            return null
        si

        // Declares the constructor taking nothing of the core library's
        // exception class for `kind`, so a later lowering can throw one,
        // where there is one.
        _reach_exception(kind: Semantic.Lookups.RuntimeException) is
            if let constructor = IR.Program.CORE_LIBRARY.constructor(IR.Program.CORE_LIBRARY.exception_class(kind), 0) then
                _owner_class(constructor.owner)
                _callee(_instance_of(constructor))
            fi
        si

        // Throws a new instance of the core library's exception class for
        // `kind`, made by its constructor taking nothing.
        _throw_new(kind: Semantic.Lookups.RuntimeException) is
            if let constructor = IR.Program.CORE_LIBRARY.constructor(IR.Program.CORE_LIBRARY.exception_class(kind), 0) then
                if let exception = _construct(constructor, LIST[Value](), Semantic.Lookups.RUNTIME_EXCEPTIONS.name_of(kind)) then
                    _throw(exception)
                    return
                fi
            fi

            _throw(LLVM.Values.null_pointer)
        si

        // Throws `exception` through the runtime, which unwinds to this
        // function's landing pad where the throw is inside a try.
        _throw(exception: LLVM.Value) is
            _emit_call(_strings!.runtime("$ghul_throw", LLVM.Type.VOID, [Types.pointer]), [exception])
            _current.unreachable()
            _is_terminated = true
        si

        // Calls `function`: through `invoke` inside a try, so a throw reaches
        // the try's landing pad, and as a plain call outside every try.
        _emit_call(function: FUNCTION, arguments: ARRAY[LLVM.Value]) -> LLVM.Value? =>
            _emit_call(function.type, function.reference, arguments)

        _emit_call(function_type: LLVM.Type, callee: LLVM.Value, arguments: ARRAY[LLVM.Value]) -> LLVM.Value? is
            if let unwind = _unwind then
                let normal = _new_block()
                let result = _current.invoke(function_type, callee, arguments, normal, unwind)

                _start(normal)

                return result
            fi

            return _current.call(function_type, callee, arguments)
        si

        // Throws the null-reference exception where `object`, a reference
        // about to be read through, is null. The test is marked
        // !make.implicit, so where the read follows it LLVM folds the two:
        // the read is left to fault, and the runtime resumes at the throw.
        _check_dereference(object: LLVM.Value) is
            let thrown = _new_block()
            let carry_on = _new_block()

            _current
                .branch(_current.compare(IntegerPredicate.EQ, object, LLVM.Values.null_pointer), thrown, carry_on)
                .attach("make.implicit", _module.empty_metadata())

            _start(thrown)

            _throw_null_reference()

            _start(carry_on)
        si

        // Throws the null-reference exception through the runtime, which makes
        // it with the program's $ghul_make_null_reference: one call, so a test
        // for null adds little to the function it is in. Where the program
        // has no such exception, what is thrown carries no type or message.
        _throw_null_reference() is
            if !LLVM_EXCEPTIONS.null_reference_constructor? then
                _throw_new(Semantic.Lookups.RuntimeException.NULL_REFERENCE)
                return
            fi

            _reach_exception(Semantic.Lookups.RuntimeException.NULL_REFERENCE)

            _emit_call(_strings!.throw_null_reference, [])
            _current.unreachable()
            _is_terminated = true
        si

        // The address of the instance field `symbol` of the object `from`
        // answers, tested for null first, or null, reported, where the target
        // does not hold it.
        _field_address(from: Value?, symbol: Semantic.Symbols.Symbol) -> LLVM.Value? is
            if let (object, address) = _field_access(from, symbol) then
                _check_receiver(from, object)
                return address
            fi

            return null
        si

        // The address of the instance field `symbol` and the object it is in,
        // which is null for a field of a struct, untested. The caller tests
        // the object before it reads or writes the field.
        _field_access(from: Value?, symbol: Semantic.Symbols.Symbol) -> (object: LLVM.Value?, address: LLVM.Value)? is
            let objects = _objects

            if !objects? \/ !from? then
                _report("a field")
                return null
            fi

            let owner = _owner_class(symbol.owner)
            let position = objects.field_position(symbol)

            if !owner? \/ !position? then
                _report("a field of {symbol.owner}")
                return null
            fi

            // A struct's field is within the struct, wherever that is held.
            if from.is_value_type then
                if !objects.is_struct(owner) then
                    _report("a field of {symbol.owner}")
                    return null
                fi

                if let address = _address_of(from) then
                    let within: LLVM.Value? = null

                    return (object = within, address = _current.element_pointer(objects.struct_type(owner), address, [_i32(0), _i32(position)], true))
                fi

                return null
            fi

            if let object = _value_of(from) then
                return (object = object, address = _current.element_pointer(objects.struct_type(owner), object, [_i32(0), _i32(position)], true))
            fi

            return null
        si

        // Tests `object`, which `from` lowered to, for null before it is read
        // through, unless `from` is the receiver, which its caller tested, or
        // `object` is null because `from` is a struct, which is not a
        // reference.
        _check_receiver(from: Value?, object: LLVM.Value?) is
            if let o = object /\ !isa Values.Load.REFERENCE_SELF(from) then
                _check_dereference(o)
            fi
        si

        visit(load: Values.Load.INSTANCE_FIELD) is
            if !_stored(load.type)? then
                _report("a field of type {load.type}")
                return
            fi

            if let address = _field_address(load.from, load.symbol) then
                _push(_load_stored(load.type, address)!)
            fi
        si

        visit(store: Values.Store.INSTANCE_FIELD) is
            if let (object, address) = _field_access(store.from, store.symbol), value = _value_of(store.value) then
                _check_receiver(store.from, object)
                _store_stored(value, store.type, address)
            fi
        si

        // The global holding a static field, or a namespace-level variable
        // where `owner` is null.
        _global(symbol: Semantic.Symbols.Symbol, is_static: bool) -> (name: string, type: LLVM.Type)? is
            let objects = _objects

            if !objects? then
                _report("a static field")
                return null
            fi

            // A static field of a namespace is a namespace-level variable.
            let is_class_static = is_static /\ !isa Semantic.Symbols.NAMESPACE(symbol.owner)
            let owner = if is_class_static then _owner_class(symbol.owner) else null fi

            if is_class_static then
                if !owner? then
                    _report("a static field of {symbol.owner}")
                    return null
                fi

                _ensure_initialised(symbol.owner)
            fi

            let type = _specialize(cast Semantic.Types.Typed?(symbol)?.type)

            if let global = objects.global_of(symbol, owner, type) then
                return global
            fi

            _report("a static field of type {type}")

            return null
        si

        _load_global(symbol: Semantic.Symbols.Symbol, is_static: bool) is
            if let (name, type) = _global(symbol, is_static) then
                _push(_widen(_current.load(type, LLVM.Values.global(name), 0), _specialize(cast Semantic.Types.Typed?(symbol)?.type)))
            fi
        si

        _store_global(symbol: Semantic.Symbols.Symbol, is_static: bool, value: Value) is
            if let (name, _) = _global(symbol, is_static), stored = _value_of(value) then
                _store_stored(stored, _specialize(cast Semantic.Types.Typed?(symbol)?.type), LLVM.Values.global(name))
            fi
        si

        visit(load: Values.Load.STATIC_FIELD) is _load_global(load.symbol, true) si
        visit(load: Values.Load.GLOBAL_FIELD) is _load_global(load.symbol, false) si
        visit(store: Values.Store.STATIC_FIELD) is _store_global(store.symbol, true, store.value) si
        visit(store: Values.Store.GLOBAL_FIELD) is _store_global(store.symbol, false, store.value) si

        visit(load: Values.Load.RECEIVER) is _load_receiver() si
        visit(self_load: Values.Load.REFERENCE_SELF) is _load_receiver() si

        /// An object is allocated through the runtime, zeroed, with its
        /// descriptor in place, and its constructor is called on it.
        visit(construction: Values.NEW) is
            let operation = construction.constructor.intrinsic_operation

            // A bigint is built in its box's i64 field from a long or an int,
            // and by the runtime from anything else.
            if operation =~ "bigint.of_small" then
                _bigint_of_small(construction.type, construction.arguments[0])
                return
            elif let o = operation /\ o.starts_with("host.") then
                _call_host(o.substring(5), construction.constructor, construction.arguments, construction.type)
                return
            fi

            if let object = _construct(construction.constructor, construction.arguments, "{construction.type}") then
                _push(object)
            fi
        si

        // A new struct is zeroed in a place of its own and its constructor
        // called on that place; the value is what the constructor leaves.
        _construct_struct(objects: LLVM_OBJECTS, type: CLASS_INSTANCE, constructor: Function, arguments: Value[]) -> LLVM.Value? is
            let callee = _callee(_instance_of(constructor))

            if !callee? then
                _report("a call to {constructor.name}")
                return null
            fi

            let values = _arguments_for(constructor, arguments)

            if !values? then
                return null
            fi

            _ensure_initialised(constructor.owner)

            let struct_type = objects.struct_type(type)
            let slot = _slot(struct_type)

            _current.store(LLVM_TYPES.zero(struct_type), slot, 0)

            values.insert(0, slot)

            _emit_call(callee, values.to_array())

            return _current.load(struct_type, slot, 0)
        si

        // A new instance of `constructor`'s class, built from `arguments`, or
        // null, reported, where the target cannot build one. The arguments
        // are evaluated before the object is allocated, as on .NET.
        _construct(constructor: Function, arguments: Value[], description: string) -> LLVM.Value? is
            let objects = _objects
            let type = _owner_class(constructor.owner)

            if let o = objects, t = type /\ o.is_struct(t) /\ !constructor.intrinsic_operation? then
                return _construct_struct(o, t, constructor, arguments)
            fi

            if constructor.intrinsic_operation? \/ !objects? \/ !type? \/ !(objects.is_object_type(type) \/ objects.is_object(type)) then
                _report("constructing a {description}")
                return null
            fi

            // A unit variant has one shared instance, which the variant's
            // constructor never runs on.
            if type.definition.is_unit_variant then
                return LLVM.Values.global(objects.unit_variant_name(type))
            fi

            let callee = if objects.is_object(type) then null else _callee(_instance_of(constructor)) fi

            if !objects.is_object(type) /\ !callee? then
                _report("a call to {constructor.name}")
                return null
            fi

            let values = _arguments_for(constructor, arguments)

            if !values? then
                return null
            fi

            return _allocate(objects, type, constructor, callee, values)
        si

        // Allocates an instance of `type` and calls `callee`, its constructor,
        // on it with `values`, already lowered. The root's constructor has no
        // body, so `callee` is null for it.
        _allocate(objects: LLVM_OBJECTS, type: CLASS_INSTANCE, constructor: Function, callee: FUNCTION?, values: LIST[LLVM.Value]) -> LLVM.Value is
            _ensure_initialised(constructor.owner)
            objects.note_allocated(type)

            let object =
                _strings!.allocate_object(_current, LLVM.Values.global(objects.descriptor_name(type)), LLVM.Values.i64(cast long(objects.size_of(type))), true)

            _sources[object] = EXACT_SOURCE(type, null, null)

            _register_finalizer(objects, type, object)

            if let c = callee then
                values.insert(0, object)

                _emit_call(c, values.to_array())
            fi

            return object
        si

        // Has the collector call the finalizer `type` or the nearest of its
        // superclasses declares, where one does, once `object` is
        // unreachable. A class with no finalizer in its chain pays nothing.
        _register_finalizer(objects: LLVM_OBJECTS, type: CLASS_INSTANCE, object: LLVM.Value) is
            let declarer: CLASS_INSTANCE? mut = type

            while let d = declarer do
                if let finalizer = d.definition.finalizer then
                    if let method = _callee(FUNCTION_INSTANCE(finalizer, d.type_map)) then
                        let register = _strings!.runtime("$ghul_register_finalizer", LLVM.Type.VOID, [Types.pointer, Types.pointer])

                        _current.call(register, [object, LLVM.Values.global(method.name)])
                    fi

                    return
                fi

                declarer = objects.superclass_of(d)
            od
        si

        // The arguments of a call to `function`, each brought into the
        // range of its parameter's kind, or null where one did not lower.
        _arguments_for(function: Function, arguments: Value[]) -> LIST[LLVM.Value]? is
            let values = LIST[LLVM.Value]()
            let parameters = function.arguments

            for i in 0..arguments.count do
                if let value = _value_of(arguments[i]) then
                    values.add(if i < parameters.count then _normalise_for(value, parameters[i]) else value fi)
                else
                    return null
                fi
            od

            return values
        si

        _is_trait_method(function: Function) -> bool =>
            cast Semantic.Symbols.Classy?(function.root_specialized_from.owner)?.is_trait ?? false

        // A call to a method of the root's constructor runs nothing, since
        // the root has no state of its own.
        _is_object_constructor(function: Function) -> bool =>
            function.is_constructor /\ (cast Semantic.Symbols.Classy?(function.owner)?.is_object ?? false)

        _call_instance(call: Values.Call.INSTANCE) is
            let function = call.function
            let dispatch = call.dispatch

            if _is_get_type(function) then
                _get_type(call)
                return
            fi

            // An enum value is held as its integer, so its to_string is the
            // text the core library gives it from the enum's members.
            if function.name =~ "to_string" /\ call.arguments.count == 0 then
                if let text = INTERPOLATION_CALLS.enum_text(call.from, _specialize(call.from.type)) then
                    gen(text)
                    return
                fi
            fi

            if let constrained: Values.CONSTRAINED = call.from then
                _call_constrained(call, constrained)
                return
            fi

            // A value type's own method, of a struct, a scalar or a bigint, is
            // called with the address of the value, as a struct's is.
            if isa Semantic.Symbols.STRUCT(function.root_specialized_from.owner) /\ (_specialize(call.from.type)?.is_value_type ?? false) then
                _call_struct(call.from, function, call.arguments)
                return
            fi

            if _is_object_constructor(function) then
                return
            fi

            if !_objects? then
                _report("an instance method")
                return
            fi

            if dispatch == IR.Dispatch.VIRTUAL /\ _is_trait_method(function) \/ dispatch == IR.Dispatch.INTERFACE then
                _call_interface(call)
            elif dispatch == IR.Dispatch.VIRTUAL /\ !function.has_no_overriders then
                _call_virtual(call)
            elif dispatch == IR.Dispatch.DIRECT \/ dispatch == IR.Dispatch.VIRTUAL then
                _call_direct(call, _instance_of(function))
            else
                _report("a {dispatch} call")
            fi
        si

        _call_direct(call: Values.Call.INSTANCE, instance: FUNCTION_INSTANCE) is
            let callee = _callee(instance)

            if !callee? then
                _report("a call to {instance.definition.name}")
                return
            fi

            if let receiver = _value_of(call.from) then
                _call_direct_on(call, instance, receiver)
            fi
        si

        // Calls `instance` directly on `receiver`, the call's receiver
        // already lowered.
        _call_direct_on(call: Values.Call.INSTANCE, instance: FUNCTION_INSTANCE, receiver: LLVM.Value) is
            let callee = _callee(instance)

            if !callee? then
                _report("a call to {instance.definition.name}")
                return
            fi

            if let values = _arguments_for(call.function, call.arguments) then

                _check_receiver(call.from, if call.from.is_value_type then null else receiver fi)

                values.insert(0, _receiver_for(instance, call.from, receiver))

                if let result = _emit_call(callee, values.to_array()) then
                    _sources[result] = EXACT_SOURCE(null, instance, null)
                    _push(result)
                fi
            fi
        si

        // A struct's method takes the address of the value it is called on.
        // Reached through a reference, as a trait call with one
        // implementation is, the receiver is the box holding the value, and
        // the address passed is that of the value within it.
        _receiver_for(instance: FUNCTION_INSTANCE, from: Value, receiver: LLVM.Value) -> LLVM.Value is
            if isa Semantic.Symbols.STRUCT(instance.definition.owner) /\ !(_specialize(from.type)?.is_value_type ?? false) then
                return _current.element_pointer(Types.i8, receiver, [_i32(LLVM_OBJECTS.BOX_VALUE_OFFSET)], true)
            fi

            return receiver
        si

        // The function type a call to `instance` through a pointer has: the
        // receiver, then its own arguments, then its result.
        _function_type(instance: FUNCTION_INSTANCE) -> LLVM.Type? is
            let parameters = LIST[LLVM.Type]()

            parameters.add(Types.pointer)

            let objects = _objects

            if !objects? then
                return null
            fi

            // Each type as the function is declared with it, so a call
            // through a pointer agrees with the function it reaches.
            for argument in instance.definition.arguments do
                if let held = objects.held_type(instance.specialize(argument)) then
                    parameters.add(held)
                else
                    return null
                fi
            od

            let return_type = instance.specialize(instance.definition.return_type)
            let result = if LLVM_TYPES.is_void(return_type) then LLVM.Type.VOID else objects.held_type(return_type) fi

            if let r = result then
                return LLVM.Type.FUNCTION(r, parameters.to_array(), false)
            fi

            return null
        si

        // While discovering, a call through a vtable or the trait table is
        // followed only for what its receiver and arguments reach, and
        // stands for a value of its result type.
        _discover_dispatched_call(call: Values.Call.INSTANCE, targets: (() -> Collections.Iterable[FUNCTION_INSTANCE]?)?) is
            gen(call.from)

            for argument in call.arguments do
                gen(argument)
            od

            if let result = _held(call.type) /\ !LLVM_TYPES.is_void(call.type) then
                let value = LLVM_TYPES.zero(result)

                if let t = targets then
                    _sources[value] = EXACT_SOURCE(t)
                fi

                _push(value)
            fi
        si

        // Marks the value a dispatched call left on the stack as coming from
        // whichever of `targets` it ran.
        _note_dispatched_result(depth: int, targets: (() -> Collections.Iterable[FUNCTION_INSTANCE]?)?) is
            if let t = targets /\ _stack.count > depth then
                _sources[_stack[_stack.count - 1]] = EXACT_SOURCE(t)
            fi
        si

        // Calls through `entry`, the address of a function pointer, with
        // the receiver and the arguments.
        _call_through(call: Values.Call.INSTANCE, receiver: LLVM.Value, values: LIST[LLVM.Value], entry: LLVM.Value) is
            let function_type = _function_type(_instance_of(call.function))

            if !function_type? then
                _report("a call to {call.function.name}")
                return
            fi

            values.insert(0, receiver)

            let target = _current.load(Types.pointer, entry, 8)

            if let result = _emit_call(function_type, target, values.to_array()) then
                _push(result)
            fi
        si

        // The receiver's vtable is read from its descriptor, and the
        // method's slot called.
        _call_virtual(call: Values.Call.INSTANCE) is
            let objects = _objects!

            let method = _instance_of(call.function)
            let targets = () -> Collections.Iterable[FUNCTION_INSTANCE]? => objects.slot_targets(method)

            if !objects.is_built then
                objects.note_dispatched(call.function)

                // The receiver may be an object an earlier cell made, of a class
                // this cell never makes, which still needs its slots planned.
                if CELL_LINK.is_active then
                    objects.note_receiver_class(method)
                fi

                _discover_dispatched_call(call, targets)
                return
            fi

            let slot = objects.slot_of(method)

            if !slot? then
                _report("a virtual call to {call.function.name}")
                return
            fi

            // Where every class that can exist runs the same method through
            // the slot, the call is a direct one, which the optimiser can
            // inline.
            if let only = objects.only_slot_implementation(slot) /\ _callee(only)? then
                _call_direct(call, only)
                return
            fi

            let receiver = _value_of(call.from)

            if !receiver? then
                return
            fi

            // A receiver whose exact class is known runs that class's own
            // entry for the slot.
            if let type = _exact_class(receiver), exact = objects.exact_slot_implementation(slot, type) /\ _callee(exact)? then
                _call_direct_on(call, exact, receiver)
                return
            fi

            if let values = _arguments_for(call.function, call.arguments) then

                _check_receiver(call.from, receiver)

                let descriptor = _strings!.load_descriptor(_current, receiver)
                let entry = _current.element_pointer(Types.i8, descriptor, [_i32(LLVM_OBJECTS.DESCRIPTOR_VTABLE + 8 * slot.index)], true)
                let depth = _stack.count

                _call_through(call, receiver, values, entry)
                _note_dispatched_result(depth, targets)
            fi
        si

        // A trait call no instance the program makes can receive: nothing
        // implements the trait, or the one class that does is never
        // instantiated. The receiver can only be null, and the call throws as
        // a call on null does.
        _call_on_null(call: Values.Call.INSTANCE) is
            _value_of(call.from)
            _arguments_for(call.function, call.arguments)
            _throw_new(Semantic.Lookups.RuntimeException.NULL_REFERENCE)
            _start(_new_block())

            if let result = _held(_instance_of(call.function).specialize(call.function.return_type)) then
                _push(LLVM_TYPES.zero(result))
            fi
        si

        // A call through a trait in a build whose cells are loaded into one
        // process: the receiver's class lists the methods it runs for each
        // trait it implements, found by the trait and read by place, so a call
        // compiled before the receiver's class existed reaches its methods.
        _call_trait_table(call: Values.Call.INSTANCE, trait_type: CLASS_INSTANCE?, is_generic: bool, targets: (() -> Collections.Iterable[FUNCTION_INSTANCE]?)?) is
            let objects = _objects!
            let function = call.function

            if !trait_type? \/ is_generic then
                _report("a call to a trait method generic in its own right{_in_cells()}")
                return
            fi

            let place = objects.table_slot_of(cast Function?(function.root_specialized_from)!, trait_type)

            if !place? then
                _call_on_null(call)
                return
            fi

            let receiver = _value_of(call.from)

            if !receiver? then
                return
            fi

            if let values = _arguments_for(function, call.arguments) then
                _check_receiver(call.from, receiver)

                let table = _current.call(objects.trait_table_function(), [receiver, LLVM.Values.global(objects.trait_id(place.trait_type))])!
                let entry = _current.element_pointer(Types.pointer, table, [_i32(place.slot)], true)
                let depth = _stack.count

                _call_through(call, receiver, values, entry)
                _note_dispatched_result(depth, targets)
            fi
        si

        // The trait instance a type test or cast names, in a build whose cells
        // are loaded into one process, or null.
        _cell_trait(type: Type?) -> CLASS_INSTANCE? is
            if !CELL_LINK.is_active \/ !type? \/ !_objects? \/ !type.is_trait then
                return null
            fi

            return _objects!.trait_of(type)
        si

        // Whether the class of `value` implements the trait, as an `i1`.
        _has_trait(value: LLVM.Value, trait_type: CLASS_INSTANCE) -> LLVM.Value is
            let objects = _objects!
            let table = _current.call(objects.trait_table_function(), [value, LLVM.Values.global(objects.trait_id(trait_type))])!

            return _current.compare(IntegerPredicate.NE, table, LLVM.Values.null_pointer)
        si

        // The receiver's class number, read from its descriptor, picks the
        // method's entry in its row of the trait table.
        _call_interface(call: Values.Call.INSTANCE) is
            let objects = _objects!
            let function = call.function
            let trait_type = _trait_instance(function.owner)
            let root = cast Function?(function.root_specialized_from)!

            let generic_arguments = DISPATCH_PLAN.own_type_arguments(_instance_of(function))

            let targets: (() -> Collections.Iterable[FUNCTION_INSTANCE]?)? =
                if let t = trait_type /\ !generic_arguments? then
                    () -> Collections.Iterable[FUNCTION_INSTANCE]? => objects.trait_targets(root, t)
                else
                    null
                fi

            if !objects.is_built then
                if let arguments = generic_arguments, t = trait_type then
                    objects.note_generic_call(root, t, arguments)
                else
                    objects.note_dispatched(function)

                    if let t = trait_type then
                        objects.selector_of(root, t)
                    fi
                fi

                // A trait nothing implements is called by throwing, below.
                _reach_exception(Semantic.Lookups.RuntimeException.NULL_REFERENCE)

                _discover_dispatched_call(call, targets)
                return
            fi

            if CELL_LINK.is_active then
                _call_trait_table(call, trait_type, generic_arguments?, targets)

                return
            fi

            // A method generic in its own right has a row for each
            // instantiation a call was recorded at.
            let selector =
                if let t = trait_type then
                    if let arguments = generic_arguments then objects.generic_selector_of(root, t, arguments) else objects.selector_of(root, t) fi
                else
                    null
                fi

            if !selector? then
                _call_on_null(call)
                return
            fi

            if let only = objects.only_implementation(selector) then
                if _callee(only)? then
                    _call_direct(call, only)
                else
                    _call_on_null(call)
                fi

                return
            fi

            let receiver = _value_of(call.from)

            if !receiver? then
                return
            fi

            if let type = _exact_class(receiver), exact = objects.exact_implementation(selector, type) /\ _callee(exact)? then
                _call_direct_on(call, exact, receiver)
                return
            fi

            if let values = _arguments_for(function, call.arguments) then

                _check_receiver(call.from, receiver)

                let descriptor = _strings!.load_descriptor(_current, receiver)
                let class_id = _current.load(Types.i32, descriptor, 8)
                let index = _current.binary(BinaryOperator.ADD, IntegerFlags.NONE, class_id, _i32(selector.offset))
                let entry = _current.element_pointer(Types.pointer, LLVM.Values.global(LLVM_OBJECTS.TRAIT_TABLE_NAME), [index], true)
                let depth = _stack.count

                _call_through(call, receiver, values, entry)
                _note_dispatched_result(depth, targets)
            fi
        si

        // The class numbers a value must have to be a `type`: one range for
        // a class, and the implementors' numbers for a trait. Null where the
        // target cannot test for the type.
        _class_ranges(type: Type?) -> LIST[(first: int, last: int)]? is
            let objects = _objects

            if !objects? \/ !type? then
                return null
            fi

            let result = LIST[(first: int, last: int)]()

            // An array's or a trait's test names classes whose numbers the
            // cells do not share.
            if CELL_LINK.is_active /\ (objects.classes.array_of(type)? \/ type.is_trait) then
                return null
            fi

            if let array = objects.classes.array_of(type) then
                return objects.array_ranges(array)
            elif let target = objects.class_of(type) ?? objects.box_type(type) ?? objects.struct_of(type) then
                result.add(objects.class_range(target))

                return result
            fi

            if type.is_trait then
                if let trait_type = objects.trait_of(type) then
                    if let implementors = objects.implementors(trait_type) then
                        for implementor in implementors do
                            result.add(objects.class_range(implementor))
                        od
                    fi

                    return result
                fi
            fi

            return null
        si

        // The class number of the object `value` points at, or -1 where it
        // is null, which no class has.
        _class_id(value: LLVM.Value) -> LLVM.Value is
            let slot = _entry.alloca(Types.i32, 4)

            _current.store(_i32(-1), slot, 4)

            let present = _new_block()
            let join = _new_block()

            _current.branch(_current.compare(IntegerPredicate.NE, value, LLVM.Values.null_pointer), present, join)

            _start(present)

            let descriptor = _strings!.load_descriptor(_current, value)

            _current.store(_current.load(Types.i32, descriptor, 8), slot, 4)
            _current.branch(join)

            _start(join)

            return _current.load(Types.i32, slot, 4)
        si

        // What a report of something unsupported adds when cells are loaded into
        // one process, where it is the cells that cannot support it.
        _in_cells() -> string => if CELL_LINK.is_active then " in cells loaded into one process" else "" fi

        // Whether `value` is an instance of one of the classes `ranges` names:
        // by class number where the program is one piece, and by walking the
        // value's superclasses where cells are loaded into one process.
        _fits(value: LLVM.Value, ranges: LIST[(first: int, last: int)]) -> LLVM.Value is
            if !CELL_LINK.is_active then
                return _in_ranges(_class_id(value), ranges)
            fi

            let objects = _objects!
            let test = objects.is_instance_function()
            let result mut = LLVM.Values.boolean(false)

            for (first, _) in ranges do
                let descriptor = LLVM.Values.global(objects.descriptor_name(objects.test_class(first)))
                let fits = _current.call(test, [value, descriptor])!

                result = _current.binary(BinaryOperator.OR, IntegerFlags.NONE, result, fits)
            od

            return result
        si

        // Whether the class number `id` falls in one of `ranges`, as an `i1`.
        _in_ranges(id: LLVM.Value, ranges: LIST[(first: int, last: int)]) -> LLVM.Value is
            let result mut = LLVM.Values.boolean(false)

            for (first, last) in ranges do
                let from_first = _current.compare(IntegerPredicate.SGE, id, _i32(first))
                let to_last = _current.compare(IntegerPredicate.SLE, id, _i32(last))
                let within = _current.binary(BinaryOperator.AND, IntegerFlags.NONE, from_first, to_last)

                result = _current.binary(BinaryOperator.OR, IntegerFlags.NONE, result, within)
            od

            return result
        si

        visit(test: Values.ISA) is
            if let trait_type = _cell_trait(_specialize(test.isa_type)) then
                if let value = _value_of(_type_test_operand(test.value)) then
                    _push(_has_trait(value, trait_type))
                fi

                return
            fi

            let ranges = _class_ranges(_specialize(test.isa_type))

            if !ranges? then
                _report("a type test against {test.isa_type}{_in_cells()}")
                return
            fi

            if let value = _value_of(_type_test_operand(test.value)) then
                if !(isa LLVM.Type.POINTER(value.type)) then
                    _report("a type test of {test.value.type}")
                    return
                fi

                _push(_fits(value, ranges))
            fi
        si

        // A cast between references tests the class number, since a
        // narrowed operand can carry the type it is being tested for: a
        // checked cast throws where the test fails, and one to an optional
        // type answers null. A cast to `object` cannot fail.
        visit(conversion: Values.CAST) is
            let target = _specialize(conversion.type)
            let operand = _type_test_operand(conversion.value)

            if let t = target /\ _value_optional_inner(t)? then
                _cast_to_optional(conversion, t)
                return
            fi

            // `null` cast to a reference type is that type's null.
            if (conversion.value.type?.is_null ?? false) /\ isa LLVM.Type.POINTER(_held(target)) then
                gen(conversion.value)
                return
            fi

            let held = _held(operand.type)

            if !isa Values.BOX(operand) /\ (!held? \/ !isa LLVM.Type.POINTER(held)) then
                _report("a cast")
                return
            fi

            // A bigint is a reference to its box, so a cast to one checks
            // the object is a bigint and keeps the reference.
            if _objects?.bigint_of(_specialize(target))? then
                _unbox(conversion.value, target)
                return
            fi

            // A checked cast to a scalar or a struct tests for its box and
            // keeps the reference, which is unboxed afterwards, and so does a
            // cast to a type parameter, which declines rather than throwing.
            // Any other unchecked one unboxes.
            let is_box = _objects?.box_type(target)? \/ _objects?.struct_of(target)?

            if is_box /\ !conversion.is_checked /\ !conversion.type.is_type_variable then
                _unbox(conversion.value, target)
                return
            fi

            if !target? \/ !(LLVM_TYPES.is_object_reference(target) \/ is_box) then
                _report("a cast to {conversion.type}")
                return
            fi

            let value = _value_of(operand)

            if !value? then
                return
            fi

            if target.is_object then
                _push(value)
                return
            fi

            let trait_type = _cell_trait(target)
            let ranges = if trait_type? then LIST[(first: int, last: int)]() else _class_ranges(target) fi

            if !ranges? then
                _report("a cast to {conversion.type}{_in_cells()}")
                return
            fi

            let in_class = if let t = trait_type then _has_trait(value, t) else _fits(value, ranges) fi
            let fits = _current.binary(BinaryOperator.OR, IntegerFlags.NONE, in_class, _current.compare(IntegerPredicate.EQ, value, LLVM.Values.null_pointer))

            // A checked cast to a box throws where the box is of another
            // type, unless it is a cast to or from a type parameter, which
            // declines.
            let declines = conversion.type.is_type_variable \/ (conversion.value.type?.is_type_variable ?? false)

            if conversion.faults_on_failure \/ (conversion.is_checked /\ is_box /\ !declines) then
                _throw_if(_current.compare(IntegerPredicate.EQ, fits, LLVM.Values.boolean(false)), Semantic.Lookups.RuntimeException.INVALID_CAST)
                _push(value)
            else
                _push(_current.select(fits, value, LLVM.Values.null_pointer))
            fi
        si

        visit(equality: Values.REFERENCE_EQUALITY) is
            if let left = _value_of(equality.left), right = _value_of(equality.right) then
                _push(_current.compare(IntegerPredicate.EQ, left, right))
            fi
        si

        visit(check: Values.REFERENCE_NULL_CHECK) is
            if let value = _value_of(check.inner) then
                _check_dereference(value)
                _push(value)
            fi
        si

        // The signature a call through a function value of `type` has: the
        // closure's receiver, then the function type's own parameters, then
        // its result. Null where `type` is not a function type the target
        // holds values of.
        _closure_signature(type: Type?) -> LLVM.Type.FUNCTION? is
            let specialized = _specialize(type)

            if !specialized? \/ !(specialized.is_function \/ specialized.is_action) then
                return null
            fi

            let arguments = specialized.arguments
            let count = if specialized.is_action then arguments.count else arguments.count - 1 fi

            let parameters = LIST[LLVM.Type]()

            parameters.add(Types.pointer)

            for i in 0..count do
                if let held = _held(arguments[i]) then
                    parameters.add(held)
                else
                    return null
                fi
            od

            let result =
                if specialized.is_action \/ LLVM_TYPES.is_void(arguments[count]) then
                    LLVM.Type.VOID
                else
                    _held(arguments[count])
                fi

            if !result? then
                return null
            fi

            return cast LLVM.Type.FUNCTION(LLVM.Type.FUNCTION(result, parameters.to_array(), false))
        si

        visit(load: Values.Load.STATIC_ANONYMOUS_FUNCTION) is _anonymous_function(load.symbol, load.func_type) si
        visit(load: Values.Load.GLOBAL_ANONYMOUS_FUNCTION) is _anonymous_function(load.symbol, load.func_type) si
        visit(load: Values.Load.INSTANCE_ANONYMOUS_FUNCTION) is _report("a function value") si

        // A literal that captures nothing but its enclosing body's type
        // parameters is a function value with no receiver.
        _anonymous_function(symbol: Semantic.Symbols.Symbol, type: Type) is
            if let function: Function = symbol then
                _closure(Values.MAKE_CLOSURE(type, function, Values.NULL(Semantic.Types.NULL())), true)
            else
                _report("a function value")
            fi
        si

        /// A function value holds the function a call through it reaches,
        /// directly or through a thunk, and the receiver or frame it passes.
        visit(closure: Values.MAKE_CLOSURE) is _closure(closure, false) si

        // A capture-free literal is one constant closure rather than one
        // allocated on every evaluation.
        _closure(closure: Values.MAKE_CLOSURE, is_capture_free_literal: bool) is
            let objects = _objects

            if !objects? then
                _report("a function value")
                return
            fi

            let function = closure.function
            let instance = _instance_of(function)
            let root = cast Function?(function.root_specialized_from)!
            let is_trait = (closure.is_virtual \/ function.is_abstract) /\ _is_trait_method(function)
            let is_virtual = !is_trait /\ closure.is_virtual /\ !function.has_no_overriders
            let has_receiver = !isa Values.NULL(closure.receiver)

            if !objects.is_built then
                if is_trait then
                    objects.note_dispatched(function)

                    if let t = _trait_instance(function.owner) then
                        objects.selector_of(root, t)
                    fi
                elif is_virtual then
                    objects.note_dispatched(function)
                else
                    _callee(instance)
                fi

                if has_receiver then
                    _value_of(closure.receiver)
                fi

                _push(LLVM.Values.null_pointer)
                return
            fi

            let signature = _closure_signature(closure.type)

            if !signature? then
                _report("a function value of type {closure.type}")
                return
            fi

            let target: FUNCTION? mut = null
            let kind mut = ThunkKind.PASS_RECEIVER
            let offset mut = 0
            let trait_id: string? mut = null

            if is_trait /\ CELL_LINK.is_active then
                let place = if let t = _trait_instance(function.owner) then objects.table_slot_of(root, t) else null fi

                if !place? then
                    _report("a function value of a trait method nothing implements")
                    return
                fi

                kind = ThunkKind.INTERFACE
                offset = place.slot
                trait_id = objects.trait_id(place.trait_type)
            elif is_trait then
                let selector = if let t = _trait_instance(function.owner) then objects.selector_of(root, t) else null fi

                if !selector? then
                    _report("a function value of a trait method nothing implements")
                    return
                fi

                kind = ThunkKind.INTERFACE
                offset = selector.offset
            elif is_virtual then
                let slot = objects.slot_of(instance)

                if !slot? then
                    _report("a function value of an overridden method")
                    return
                fi

                kind = ThunkKind.VIRTUAL
                offset = slot.index
            else
                target = _callee(instance)

                if !target? then
                    _report("a function value of {function.name}")
                    return
                fi

                // A function with no receiver can still be held closed over
                // its first argument, which the value carries where a
                // receiver would go.
                if !function.is_emitted_with_receiver then
                    if !has_receiver then
                        kind = ThunkKind.DROP_RECEIVER
                    elif target.parameters.count == 0 \/ !isa LLVM.Type.POINTER(target.parameters[0].type) then
                        _report("a function value closed over a value that is not a reference")
                        return
                    fi
                fi
            fi

            let thunk = objects.closures!.thunk(signature, instance, target, kind, offset, trait_id)

            if !thunk? then
                _report("a function value of {function.name}")
                return
            fi

            let receiver: LLVM.Value mut = LLVM.Values.null_pointer

            if has_receiver /\ kind != ThunkKind.DROP_RECEIVER then
                if let value = _value_of(closure.receiver) then
                    receiver = value
                else
                    return
                fi
            fi

            if is_capture_free_literal /\ !has_receiver then
                _push(objects.closures!.constant(thunk))
                return
            fi

            let value =
                _strings!.allocate_object(_current, objects.closures!.descriptor, LLVM.Values.i64(cast long(LLVM_CLOSURES.SIZE)), true)

            _current.store(thunk.reference, _current.element_pointer(Types.i8, value, [_i32(LLVM_CLOSURES.FUNCTION_OFFSET)], true), 8)
            _current.store(receiver, _current.element_pointer(Types.i8, value, [_i32(LLVM_CLOSURES.RECEIVER_OFFSET)], true), 8)

            _push(value)
        si

        /// A call through a function value passes the receiver it holds,
        /// then the call's arguments.
        visit(call: Values.Call.CLOSURE) is
            let func_type = call.func_type ?? call.from.type
            let signature = _closure_signature(func_type)

            if !signature? then
                _report("a call to a function value of type {func_type}")
                return
            fi

            let closure = _value_of(call.from)

            if !closure? then
                return
            fi

            let parameters = _specialize(func_type)!.arguments
            let values = LIST[LLVM.Value]()

            for i in 0..call.arguments.count do
                if let value = _value_of(call.arguments[i]) then
                    values.add(if i < parameters.count then _normalise_for(value, parameters[i]) else value fi)
                else
                    return
                fi
            od

            _check_dereference(closure)

            let function = _current.load(Types.pointer, _current.element_pointer(Types.i8, closure, [_i32(LLVM_CLOSURES.FUNCTION_OFFSET)], true), 8)
            let receiver = _current.load(Types.pointer, _current.element_pointer(Types.i8, closure, [_i32(LLVM_CLOSURES.RECEIVER_OFFSET)], true), 8)

            values.insert(0, receiver)

            if let result = _emit_call(signature, function, values.to_array()) then
                if !(signature.result =~ LLVM.Type.VOID) then
                    _push(result)
                fi
            fi
        si

        // The landing pad of the innermost try being lowered: the block
        // starts the handler, and makes this function name the runtime's
        // personality routine.
        _landing_pad(block: BLOCK) -> LLVM.Value is
            _function.personality = _strings!.runtime("$ghul_personality", Types.i32, []).reference

            _start(block)

            let landed = _current.landing_pad(Types.structure([Types.pointer, Types.i32]), false, [LLVM.Values.null_pointer])
            let header = _current.extract_value(Types.pointer, landed, [0])

            return _current.call(_strings!.runtime("$ghul_caught", Types.pointer, [Types.pointer]), [header])!
        si

        // The protected body's calls unwind to a landing pad that tests the
        // exception against each catch's type in turn. A catch that matches
        // has the exception on the stack where its body starts. One no catch
        // matches is thrown on.
        _lower_try_catch(node: Values.TRY) is
            let end = _new_block()
            let handler = _new_block()
            let enclosing = _unwind

            _labels.add((node, false, end, null, _stack.count))

            _unwind = handler

            for value in node.body.values do
                gen(value)
            od

            _unwind = enclosing

            if !_is_terminated then
                _branch(end)
            fi

            let exception = _landing_pad(handler)
            let caught = _slot(Types.pointer)

            _current.store(exception, caught, 8)

            for `catch in node.catches do
                let ranges = _class_ranges(_specialize(`catch.type))

                if !ranges? then
                    _report("a catch of {`catch.type}{_in_cells()}")
                    continue
                fi

                let matched = _new_block()
                let next = _new_block()

                let in_class = _fits(_current.load(Types.pointer, caught, 8), ranges)

                _current.branch(in_class, matched, next)

                _start(matched)

                _caught.add(caught)
                _push(_current.load(Types.pointer, caught, 8))

                for value in `catch.body.values do
                    gen(value)
                od

                _caught.remove_at(_caught.count - 1)

                if !_is_terminated then
                    _branch(end)
                fi

                _start(next)
            od

            _throw(_current.load(Types.pointer, caught, 8))

            _labels.remove_at(_labels.count - 1)

            _start(end)
        si

        // An exit that leaves the protected body records which exit it is
        // and goes to the finally, after which the exit is taken again from
        // outside. An exception runs the finally and is thrown on. The
        // finally is lowered once for each path.
        _lower_try_finally(node: Values.TRY, `finally: Values.REGION) is
            let end = _new_block()
            let handler = _new_block()
            let normal = _new_block()
            let selector = _slot(Types.i32)
            let exits = IR.Program.EXIT_NUMBERING()
            let enclosing = _unwind

            _current.store(_i32(0), selector, 4)

            _labels.add((node, false, end, null, _stack.count))

            let marker = _labels.count

            _labels.add((node, true, normal, null, _stack.count))
            _finally_exits[marker] = (selector, exits)

            _unwind = handler

            for value in node.body.values do
                gen(value)
            od

            _unwind = enclosing

            if !_is_terminated then
                _branch(normal)
            fi

            _finally_exits.remove(marker)
            _labels.remove_at(marker)

            let exception = _landing_pad(handler)
            let caught = _slot(Types.pointer)

            _current.store(exception, caught, 8)

            _lower_region(`finally, null)

            if !_is_terminated then
                _throw(_current.load(Types.pointer, caught, 8))
            fi

            _start(normal)

            _lower_region(`finally, null)

            if !_is_terminated then
                let taken = _current.load(Types.i32, selector, 4)

                for i in 0..exits.exits.count do
                    let take = _new_block()
                    let next = _new_block()

                    _current.branch(_current.compare(IntegerPredicate.EQ, taken, _i32(i + 1)), take, next)

                    _start(take)

                    _route(exits.exits[i], true)

                    if !_is_terminated then
                        _branch(end)
                    fi

                    _start(next)
                od

                _branch(end)
            fi

            _labels.remove_at(_labels.count - 1)

            _start(end)
        si

        // Records which exit is being taken and goes to the finally, after
        // which the exit is taken again.
        _leave_through_finally(exit: Values.Exit, is_taken: bool, selector: LLVM.Value, exits: IR.Program.EXIT_NUMBERING, finally_block: BLOCK) is
            let number = exits.number(exit)
            let target = _target_label(exit)

            if is_taken \/ exit.condition == IR.BRANCH.ALWAYS then
                // A value the exit carries goes where its target reads it now,
                // since the finally runs between here and there.
                if !is_taken then
                    if let t = target then
                        _leave_with_result(t.result, t.depth)
                    fi
                fi

                _current.store(_i32(number), selector, 4)
                _branch(finally_block)
                return
            fi

            if target?.result? ?? false then
                _report("a conditional exit carrying a value out of a try with a finally")
                return
            fi

            if let condition = _test(exit.condition, exit.operands) then
                let leave = _new_block()
                let next = _new_block()

                _current.branch(condition, leave, next)

                _start(leave)

                _current.store(_i32(number), selector, 4)
                _branch(finally_block)

                _start(next)
            fi
        si

        /// A throw hands the exception to the runtime, which unwinds to
        /// the innermost try's landing pad. A throw with no exception, in a
        /// catch, throws on the exception the catch caught.
        visit(thrown: Values.THROW) is
            if let exception = thrown.exception then
                if let value = _value_of(exception) then
                    _throw(value)
                fi
            elif _caught.count > 0 then
                _throw(_current.load(Types.pointer, _caught[_caught.count - 1], 8))
            else
                _report("a rethrow outside a catch")
            fi
        si

        // `left =~ right` over values of the concrete type the comparer's
        // type parameter is.
        visit(equality: Values.EQUALITY_COMPARISON) is
            let type = _specialize(equality.left.type)
            let left = _value_of(equality.left)
            let right = _value_of(equality.right)

            if left? /\ right? then
                if let equal = _equal_held(left, right, type) then
                    _push(equal)
                fi
            fi
        si

        // Whether `left` and `right`, held values of `type`, are equal as `=~`
        // compares them, as an `i1`, or null where reported:
        // - a scalar by value, a NaN equal to another as .NET's comparer has it
        // - a string by its code units
        // - a tuple element by element
        // - a type through the `=~` it declares, with two absent references
        //   equal and an absent one equal to nothing
        // - any other reference by identity
        _equal_held(left: LLVM.Value, right: LLVM.Value, type: Type?) -> LLVM.Value? is
            if let inner = _value_optional_inner(type) then
                return _equal_optionals(left, right, inner)
            fi

            if _scalar_of(type)? then
                if LLVM_TYPES.is_floating(left.type) then
                    let equal = _current.compare(FloatPredicate.OEQ, left, right)
                    let left_nan = _current.compare(FloatPredicate.UNO, left, left)
                    let right_nan = _current.compare(FloatPredicate.UNO, right, right)
                    let both_nan = _current.binary(BinaryOperator.AND, IntegerFlags.NONE, left_nan, right_nan)

                    return _current.binary(BinaryOperator.OR, IntegerFlags.NONE, equal, both_nan)
                fi

                return _current.compare(IntegerPredicate.EQ, left, right)
            fi

            if let strings = _strings /\ _is_string(type) then
                return _current.call(strings.equals_function, [left, right])
            fi

            if let tuple: Semantic.Types.TUPLE = type then
                let result mut = LLVM.Values.boolean(true)

                for (i, element) in tuple.arguments |> Ghul.Pipes.index() do
                    if !_stored(element)? then
                        _report("an equality comparison of {type}")
                        return null
                    fi

                    let equal = _equal_held(_extract_member(left, i, element), _extract_member(right, i, element), element)

                    if !equal? then
                        return null
                    fi

                    result = _current.binary(BinaryOperator.AND, IntegerFlags.NONE, result, equal)
                od

                return result
            fi

            let operator = if let t = type then EQUALITY_OPERATOR.declared(t) else null fi

            if let t = type /\ t.is_value_type, o = operator then
                return _equal_values_through(o, left, right, t)
            elif let t = type, o = operator /\ isa LLVM.Type.POINTER(left.type) then
                return _equal_references_through(o, left, right, t)
            elif isa LLVM.Type.POINTER(left.type) then
                return _current.compare(IntegerPredicate.EQ, left, right)
            fi

            _report("an equality comparison of {type}")

            return null
        si

        // `left =~ right` over two held optionals of a value type: two absent
        // ones are equal and an absent one equals nothing, and only two
        // present ones compare what they hold.
        _equal_optionals(left: LLVM.Value, right: LLVM.Value, inner: Type) -> LLVM.Value? is
            let result = _slot(Types.i1)
            let left_present = _is_present(left)
            let right_present = _is_present(right)
            let both = _new_block()
            let not_both = _new_block()
            let done = _new_block()

            _current.branch(_current.binary(BinaryOperator.AND, IntegerFlags.NONE, left_present, right_present), both, not_both)

            _start(not_both)
            _current.store(_current.compare(IntegerPredicate.EQ, left_present, right_present), result, 1)
            _branch(done)

            _start(both)

            let equal = _equal_held(_extract_member(left, 1, inner), _extract_member(right, 1, inner), inner)

            if !equal? then
                return null
            fi

            _current.store(equal, result, 1)
            _branch(done)

            _start(done)

            return _current.load(Types.i1, result, 1)
        si

        // `left =~ right` through a value type's own `=~`, which takes the
        // address of its receiver.
        _equal_values_through(operator: Function, left: LLVM.Value, right: LLVM.Value, type: Type) -> LLVM.Value? is
            let callee = _callee(_instance_of(operator))

            if !callee? then
                _report("a call to {operator.name}")
                return null
            fi

            let slot = _slot(left.type)

            _current.store(left, slot, 0)

            if let answer = _emit_call(callee, [slot, right]) then
                return _current.compare(IntegerPredicate.NE, answer, LLVM_TYPES.zero(answer.type))
            fi

            return null
        si

        // `left =~ right` through a reference type's `=~`, called as any
        // instance method is, so an override is the one reached, and only
        // where both are present.
        _equal_references_through(operator: Function, left: LLVM.Value, right: LLVM.Value, type: Type) -> LLVM.Value is
            let result = _slot(Types.i1)
            let left_absent = _new_block()
            let left_present = _new_block()
            let both_present = _new_block()
            let done = _new_block()

            _current.branch(_current.compare(IntegerPredicate.EQ, left, LLVM.Values.null_pointer), left_absent, left_present)

            _start(left_absent)
            _current.store(_current.compare(IntegerPredicate.EQ, right, LLVM.Values.null_pointer), result, 1)
            _branch(done)

            _start(left_present)
            _current.store(LLVM.Values.boolean(false), result, 1)
            _current.branch(_current.compare(IntegerPredicate.EQ, right, LLVM.Values.null_pointer), done, both_present)

            _start(both_present)

            let bool_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_bool_type()

            if let compared = _value_of(Values.Call.INSTANCE(LLVM_VALUE(left, type), operator, LIST[Value]([LLVM_VALUE(right, type)]), bool_type)) then
                _current.store(compared, result, 1)
            fi

            _branch(done)

            _start(done)

            return _current.load(Types.i1, result, 1)
        si

        // A constrained call on a reference is an ordinary call on it, once
        // the type parameter is the reference type it stands for.
        _call_constrained(call: Values.Call.INSTANCE, constrained: Values.CONSTRAINED) is
            let receiver = if let address: Values.ADDRESS = constrained.value then address.value else constrained.value fi
            let type = _specialize(constrained.type)

            // A value type calls its own implementation directly, with the
            // value's address, and is boxed to reach one it inherits, as
            // CIL's constrained call does.
            if type?.is_value_type ?? false then
                let own = INTERPOLATION_CALLS.method(type, call.function.name, call.function.arguments.count)

                if let o = own /\ isa Semantic.Symbols.STRUCT(o.root_specialized_from.owner) then
                    _call_struct(constrained.value, o, call.arguments)
                else
                    _call_instance(Values.Call.INSTANCE(Values.BOX(receiver, type!), call.function, call.arguments, call.type))
                fi

                return
            fi

            if !LLVM_TYPES.is_object_reference(type) /\ !_is_string(type) then
                _report("a constrained call on {type}")
                return
            fi

            _call_instance(Values.Call.INSTANCE(receiver, call.function, call.arguments, call.type))
        si

        // The value `value` boxes, seen through casts, where it is of a value
        // type that is not optional at this instantiation, and so the box can
        // never be absent. Null otherwise.
        _boxed_present_value(value: Value) -> Value? is
            let inner mut = value

            while true do
                if let checked: Values.CAST = inner then
                    inner = checked.value
                else
                    break
                fi
            od

            if let box: Values.BOX = inner, type = _specialize(box.value.type) /\ type.is_value_type /\ !type.is_optional then
                return box.value
            fi

            return null
        si

        // The operand of a type test, as the reference the test examines: a
        // value whose type parameter stands for a scalar is boxed.
        _type_test_operand(value: Value) -> Value =>
            if value.type?.type_variable_side? /\ _objects?.box_type(_specialize(value.type))? then
                Values.BOX(value)
            else
                Values.TYPE_TEST_OPERAND.operand(value)
            fi
    si
si
