namespace IR.LLVMTarget is
    use LLVM.FUNCTION
    use LLVM.MODULE
    use LLVM.PARAMETER
    use LLVM.Types
    use LLVM.Values

    /// What the native runtime needs from the program to describe an
    /// exception nothing caught.
    class LLVM_EXCEPTIONS is
        init() is si

        /// The getter of the core library's `Ghul.Exception.message`, or null
        /// where the program declares none.
        message_getter: Semantic.Symbols.Function? static =>
            if let exception = IR.Program.CORE_LIBRARY.root_exception_class() then
                IR.Program.CORE_LIBRARY.find_getter(exception, "message")
            else
                null
            fi

        /// Adds `$ghul_report_unhandled`, which writes the first line .NET
        /// prints for an exception nothing caught: `Unhandled exception.`,
        /// then the exception's type name and its message where it has them.
        ///
        /// - module: where the function is added
        /// - strings: the literals and the runtime's write operation
        /// - message: the compiled getter of an exception's message, or null where the program has none
        add_report_unhandled(module: MODULE, strings: LLVM_STRINGS, message: FUNCTION?) static is
            let function = FUNCTION(LLVM_STRINGS.REPORT_UNHANDLED_NAME, LLVM.Type.VOID, [PARAMETER(Types.pointer, "exception")])

            let write = strings.runtime(LLVM_STRINGS.host_name("write"), LLVM.Type.VOID, [Types.pointer, Types.i32, Types.i32])

            let entry = function.add_block("entry")
            let described = function.add_block("described")
            let messaged = function.add_block("messaged")
            let done = function.add_block("done")

            let exception = function.parameter(0)

            let write_text = (block: LLVM.BLOCK, text: LLVM.Value) is
                block.call(write, [strings.chars(block, text), strings.length(block, text), Values.i32(2)])
            si

            write_text(entry, strings.literal("Unhandled exception."))
            entry.branch(entry.compare(LLVM.IntegerPredicate.EQ, exception, Values.null_pointer), done, described)

            let descriptor = strings.load_descriptor(described, exception)
            let name = described.load(Types.pointer, described.element_pointer(Types.i8, descriptor, [Values.i32(LLVM_OBJECTS.DESCRIPTOR_NAME)], true), 8)

            write_text(described, strings.literal(" "))
            write_text(described, name)

            if let getter = message then
                let text = described.call(getter, [exception])!

                described.branch(described.compare(LLVM.IntegerPredicate.EQ, text, Values.null_pointer), done, messaged)

                write_text(messaged, strings.literal(": "))
                write_text(messaged, text)
                messaged.branch(done)
            else
                described.branch(done)
                messaged.unreachable()
            fi

            write_text(done, strings.literal("\n"))
            done.return_void()

            module.add_function(function)
        si

        /// The constructor taking nothing of the core library's
        /// null-reference exception, or null where it declares none.
        null_reference_constructor: Semantic.Symbols.Function? static =>
            IR.Program.CORE_LIBRARY.constructor(
                IR.Program.CORE_LIBRARY.exception_class(Semantic.Lookups.RuntimeException.NULL_REFERENCE), [])

        /// Adds `$ghul_make_null_reference`, which makes the exception the
        /// native runtime throws for a read through null that faulted.
        ///
        /// - module: where the function is added
        /// - strings: the runtime's allocation
        /// - objects: the layout of the exception's class
        /// - type: the null-reference exception's class
        /// - constructor: its compiled constructor taking nothing
        add_make_null_reference(module: MODULE, strings: LLVM_STRINGS, objects: LLVM_OBJECTS, type: IR.Program.CLASS_INSTANCE, constructor: FUNCTION) static is
            let function = FUNCTION(LLVM_STRINGS.MAKE_NULL_REFERENCE_NAME, Types.pointer, [])
            let entry = function.add_block("entry")

            let exception =
                strings.allocate_object(entry, Values.global(objects.descriptor_name(type)), Values.i64(cast long(objects.size_of(type))), true)

            entry.call(constructor, [exception])
            entry.return_value(exception)

            module.add_function(function)
        si
    si
si
