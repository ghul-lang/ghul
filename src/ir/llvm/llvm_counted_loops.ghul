namespace IR.LLVMTarget is
    use IR.Program

    use Collections.MAP

    use Semantic.Types.Type

    use LLVM.BinaryOperator
    use LLVM.IntegerFlags
    use LLVM.IntegerPredicate
    use LLVM.Types

    use Values.Value

    // How a counted `for` loop knows what it walks: an array, a collection
    // of a known class, or a collection a run-time test of the receiver's
    // class confirms, falling back to the iterator otherwise.
    enum CountedRoute is
        ARRAY,
        EXACT,
        GUARDED
    si

    // The collection a counted loop walks the storage of.
    enum StorageKind is
        ARRAY,
        LIST,
        MAP,
        SET
    si

    // How a counted loop steps: through every element of an array up to a
    // count, or through the entries of a hash table, skipping removed ones,
    // reading each entry's key and value or its key alone.
    enum CountedShape is
        PLAIN,
        PAIRS,
        KEYS
    si

    // A `for` loop lowered over the storage it iterates: the array the
    // elements are in, how many there are, and where the loop is. Where
    // the receiver's class is only tested at run time, `flag` is the slot
    // saying whether the test passed, and the iterator is used otherwise.
    class COUNTED_LOOP is
        iteration: FOR_ITERATION
        is_active: bool public
        flag: LLVM.Value? public
        storage: LLVM.Value? public
        count: LLVM.Value? public
        index: LLVM.Value? public
        array: CLASS_INSTANCE? public
        shape: CountedShape public
        hashes: LLVM.Value? public
        values: LLVM.Value? public
        value_array: CLASS_INSTANCE? public

        /// Whether the copy of the loop being lowered is the one entered
        /// only when the run-time test passed, which needs no test of its
        /// own on each step.
        is_counted_copy: bool public

        init(iteration: FOR_ITERATION) is
            self.iteration = iteration
        si
    si

    partial LLVM_LOWERING is
        // Records, when the local declared holds a `for` loop's iterator,
        // the calls the loop makes on it, so they can be lowered over the
        // iterated value's storage.
        _note_iteration(local: LOCAL) is
            if let iteration = local.iteration, objects = _objects, move_next = iteration.move_next, current = iteration.current /\ objects.is_built then
                let loop = COUNTED_LOOP(iteration)

                _counted_loops[iteration.get_iterator] = loop
                _counted_loops[move_next] = loop
                _counted_loops[current] = loop
            fi
        si

        // Lowers `value` where it is one of a counted loop's calls,
        // answering whether it did.
        _lower_counted(value: Value) -> bool is
            let loop: COUNTED_LOOP mut

            if !_counted_loops.try_get_value(value, loop ref) then
                return false
            elif value == loop.iteration.get_iterator then
                return _start_counted(loop, value)
            elif !loop.is_active then
                return false
            elif value == loop.iteration.move_next then
                _counted_step(loop, value, true)
            else
                _counted_step(loop, value, false)
            fi

            return true
        si

        _start_counted(loop: COUNTED_LOOP, value: Value) -> bool is
            let objects = _objects!
            let arrays = _arrays!
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let call = cast Values.Call.INSTANCE?(value)

            if !call? \/ call.from != loop.iteration.receiver \/ call.from.is_value_type then
                return false
            fi

            let element = _specialize(loop.iteration.current!.type)
            let receiver_type = _specialize(loop.iteration.receiver.type)

            let moved = _held(loop.iteration.move_next!.type)

            if !element? \/ !receiver_type? \/ !moved? \/ !(moved =~ Types.i1) then
                return false
            fi

            let candidates = Collections.LIST[(type: CLASS_INSTANCE, kind: StorageKind)]()
            let has_other mut = false

            if let array = arrays.array_of(receiver_type) then
                candidates.add((array, StorageKind.ARRAY))
            elif let static_class = objects.class_of(receiver_type) then
                if let kind = _storage_kind(static_class) /\ objects.has_no_subclasses(static_class) then
                    candidates.add((static_class, kind))
                else
                    return false
                fi
            elif let trait_type = objects.trait_of(receiver_type), implementors = objects.implementors(trait_type) then
                for implementor in implementors do
                    if objects.is_allocated(implementor) then
                        if let kind = _storage_kind(implementor) then
                            candidates.add((implementor, kind))
                        else
                            has_other = true
                        fi
                    fi
                od
            else
                return false
            fi

            if candidates.count == 0 then
                return false
            fi

            let receiver = _value_of(call.from)

            if !receiver? then
                return true
            fi

            let family = Collections.LIST[(type: CLASS_INSTANCE, kind: StorageKind)]()
            let route: CountedRoute mut

            if let exact = _exact_class(receiver), kind = _storage_kind(exact) /\ _contains(candidates, exact) then
                family.add((exact, kind))
                route = CountedRoute.EXACT
            elif !has_other /\ candidates.count <= COUNTED_FAMILY_LIMIT /\ _one_shape(candidates) then
                family.add_range(candidates)
                route = if candidates.count == 1 /\ !objects.trait_of(receiver_type)? then CountedRoute.EXACT else CountedRoute.GUARDED fi
            else
                _preevaluated[call.from] = receiver
                value.accept(self)

                return true
            fi

            if !_prepare_shape(loop, family[0], element) then
                _preevaluated[call.from] = receiver
                value.accept(self)

                return true
            fi

            let storage = _slot(Types.pointer)
            let count = _slot(Types.i32)
            let index = _slot(Types.i32)

            loop.storage = storage
            loop.count = count
            loop.index = index
            loop.hashes = _slot(Types.pointer)
            loop.values = _slot(Types.pointer)
            loop.is_active = true

            _current.store(_i32(-1), index, 0)

            if route == CountedRoute.EXACT then
                _check_dereference(receiver)
                _load_storage(loop, family[0], receiver)
                _push(LLVM.Values.null_pointer)
            else
                let flag = _slot(Types.i1)
                let iterator = _slot(Types.pointer)

                loop.flag = flag

                let check = _new_block()
                let other = _new_block()
                let join = _new_block()

                _current.branch(_current.compare(IntegerPredicate.NE, receiver, LLVM.Values.null_pointer), check, other)

                _start(check)
                let descriptor = _strings!.load_descriptor(_current, receiver)

                for member in family do
                    let matched = _new_block()
                    let next = _new_block()

                    _current.branch(_current.compare(IntegerPredicate.EQ, descriptor, LLVM.Values.global(objects.descriptor_name(member.type))), matched, next)

                    _start(matched)
                    _current.store(LLVM.Values.boolean(true), flag, 0)
                    _load_storage(loop, member, receiver)
                    _current.branch(join)

                    _start(next)
                od

                _current.branch(other)

                _start(other)
                _preevaluated[call.from] = receiver
                value.accept(self)

                if let made = _pop() then
                    _current.store(made, iterator, 0)
                fi

                _current.branch(join)

                _start(join)
                _push(_current.load(Types.pointer, iterator, 0))
            fi

            return true
        si

        // The collection `type` is, where a counted loop can walk its
        // storage.
        _storage_kind(type: CLASS_INSTANCE) -> StorageKind? is
            let objects = _objects!
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            if objects.is_array(type) then
                return StorageKind.ARRAY
            elif let list = lookup.get_list_class() /\ type.definition == list then
                return StorageKind.LIST
            elif let map = lookup.get_map_class() /\ type.definition == map then
                return StorageKind.MAP
            elif let set = lookup.get_set_class() /\ type.definition == set then
                return StorageKind.SET
            fi

            return null
        si

        _shape_of(kind: StorageKind) -> CountedShape =>
            if kind == StorageKind.MAP then CountedShape.PAIRS elif kind == StorageKind.SET then CountedShape.KEYS else CountedShape.PLAIN fi

        _one_shape(family: Collections.List[(type: CLASS_INSTANCE, kind: StorageKind)]) -> bool is
            for member in family do
                if _shape_of(member.kind) != _shape_of(family[0].kind) then
                    return false
                fi
            od

            return true
        si

        _contains(family: Collections.List[(type: CLASS_INSTANCE, kind: StorageKind)], type: CLASS_INSTANCE) -> bool is
            for member in family do
                if member.type =~ type then
                    return true
                fi
            od

            return false
        si

        // Settles how `loop` steps and reads its elements, from `member`, the
        // first class it walks, and `element`, the type of what it reads.
        // False where the arrays it reads cannot be found.
        _prepare_shape(loop: COUNTED_LOOP, member: (type: CLASS_INSTANCE, kind: StorageKind), element: Type) -> bool is
            let arrays = _arrays!
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            loop.shape = _shape_of(member.kind)

            if loop.shape == CountedShape.PLAIN then
                loop.array = arrays.array_of(lookup.get_array_type(element)) ?? arrays.array_of(lookup.get_array_type(lookup.get_object_type()))
                return loop.array?
            fi

            let map = if member.kind == StorageKind.SET then _field_class(member.type, "_map") else member.type fi

            if !map? then
                return false
            fi

            loop.array = _field_array(map, "_keys")
            loop.value_array = _field_array(map, "_values")

            return loop.array? /\ (loop.shape == CountedShape.KEYS \/ loop.value_array?)
        si

        _field(type: CLASS_INSTANCE, name: string) -> (position: int, type: Type)? is
            for (`field, field_type, position) in _objects!.fields_of(type) do
                if `field.name =~ name \/ `field.name =~ "${name}" then
                    return (position, field_type)
                fi
            od

            return null
        si

        _field_class(type: CLASS_INSTANCE, name: string) -> CLASS_INSTANCE? =>
            if let f = _field(type, name) then _objects!.class_of(f.type) else null fi

        _field_array(type: CLASS_INSTANCE, name: string) -> CLASS_INSTANCE? =>
            if let f = _field(type, name) then _arrays!.array_of(f.type) else null fi

        _load_field(type: CLASS_INSTANCE, object: LLVM.Value, name: string, as: LLVM.Type) -> LLVM.Value? =>
            if let f = _field(type, name) then
                _current.load(as, _current.element_pointer(_objects!.struct_type(type), object, [_i32(0), _i32(f.position)], true), 0)
            else
                null
            fi

        // Stores the storage of `receiver`, a `member`, where `loop` reads
        // it, as the collection's own iterator takes it when it is made.
        _load_storage(loop: COUNTED_LOOP, member: (type: CLASS_INSTANCE, kind: StorageKind), receiver: LLVM.Value) is
            let map_type: CLASS_INSTANCE mut
            let map: LLVM.Value mut

            if member.kind == StorageKind.ARRAY then
                _current.store(receiver, loop.storage!, 0)
                _current.store(_arrays!.count(_current, receiver), loop.count!, 0)
                return
            elif member.kind == StorageKind.LIST then
                if let items = _load_field(member.type, receiver, "_items", Types.pointer), counted = _load_field(member.type, receiver, "_count", Types.i32) then
                    _current.store(items, loop.storage!, 0)
                    _current.store(counted, loop.count!, 0)
                else
                    _report("a list's storage")
                fi

                return
            elif member.kind == StorageKind.SET then
                if let inner = _field_class(member.type, "_map"), loaded = _load_field(member.type, receiver, "_map", Types.pointer) then
                    map_type = inner
                    map = loaded
                else
                    _report("a set's storage")
                    return
                fi
            else
                map_type = member.type
                map = receiver
            fi

            if let hashes = _load_field(map_type, map, "_hashes", Types.pointer), keys = _load_field(map_type, map, "_keys", Types.pointer), values = _load_field(map_type, map, "_values", Types.pointer), used = _load_field(map_type, map, "_used", Types.i32) then
                _current.store(hashes, loop.hashes!, 0)
                _current.store(keys, loop.storage!, 0)
                _current.store(values, loop.values!, 0)
                _current.store(used, loop.count!, 0)
            else
                _report("a map's storage")
            fi
        si

        // A loop whose body is lowered at most this many instructions large
        // is lowered twice where its receiver is tested at run time: once
        // walking the storage with no test per step, and once testing the
        // flag on each step, which the iterator path needs.
        COUNTED_COPY_LIMIT: int static => 80

        // The guarded counted loop `loop` is the loop of, where it is one:
        // its exit tests that loop's move to the next element.
        _guarded_loop_of(loop: Values.LOOP) -> COUNTED_LOOP? is
            if _counted_loops.count == 0 then
                return null
            fi

            for value in loop.body.values do
                if let exit: Values.BREAK = value then
                    for operand in exit.operands do
                        let counted: COUNTED_LOOP mut

                        if _counted_loops.try_get_value(operand, counted ref) /\ counted.is_active /\ counted.flag? /\ operand == counted.iteration.move_next then
                            return counted
                        fi
                    od

                    return null
                fi
            od

            return null
        si

        // Lowers `loop` once testing the flag on each step, and again with
        // no test where that copy is small, entering the second where the
        // run-time test passed.
        _lower_loop_twice(loop: Values.LOOP, counted: COUNTED_LOOP) is
            let end = _new_block()
            let depth = _stack.count
            let dispatch = _new_block()

            _branch(dispatch)

            let first_block = _function.blocks.count
            let dynamic_header = _lower_loop_copy(loop, end, depth)

            let size mut = 0

            for i in first_block.._function.blocks.count do
                size = size + _function.blocks[i].instructions.count
            od

            if size <= COUNTED_COPY_LIMIT then
                counted.is_counted_copy = true

                let counted_header = _lower_loop_copy(loop, end, depth)

                counted.is_counted_copy = false

                dispatch.branch(dispatch.load(Types.i1, counted.flag!, 0), counted_header, dynamic_header)
            else
                dispatch.branch(dynamic_header)
            fi

            _start(end)

            _check_depth(depth, "loop")
        si

        _lower_loop_copy(loop: Values.LOOP, end: LLVM.BLOCK, depth: int) -> LLVM.BLOCK is
            let header = _new_block()

            _labels.add((loop, false, end, null, depth))
            _labels.add((loop, true, header, null, depth))

            _start(header)

            for value in loop.body.values do
                gen(value)
            od

            if !_is_terminated then
                _branch(header)
            fi

            _labels.remove_at(_labels.count - 1)
            _labels.remove_at(_labels.count - 1)

            return header
        si

        // A guarded loop tests the receiver against at most this many
        // collection classes.
        COUNTED_FAMILY_LIMIT: int static => 8

        // A counted loop's move to the next element, or its read of the
        // element it is at; through the iterator where the run-time test
        // did not pass.
        _counted_step(loop: COUNTED_LOOP, value: Value, is_move: bool) is
            if let flag = loop.flag /\ !loop.is_counted_copy then
                let held = _held(value.type)

                if !held? then
                    _report("a counted loop's element")
                    return
                fi

                let result = _slot(held)
                let counted = _new_block()
                let other = _new_block()
                let join = _new_block()

                _current.branch(_current.load(Types.i1, flag, 0), counted, other)

                _start(counted)
                let stepped = _counted_value(loop, value, is_move)
                _current.store(stepped, result, 0)
                _current.branch(join)

                _start(other)
                value.accept(self)

                if let made = _pop() then
                    _current.store(made, result, 0)
                fi

                _current.branch(join)

                _start(join)
                _push(_current.load(held, result, 0))
            else
                _push(_counted_value(loop, value, is_move))
            fi
        si

        _counted_value(loop: COUNTED_LOOP, value: Value, is_move: bool) -> LLVM.Value is
            let index = loop.index!
            let arrays = _arrays!

            if is_move then
                let next = _current.binary(BinaryOperator.ADD, IntegerFlags.NONE, _current.load(Types.i32, index, 0), _i32(1))

                _current.store(next, index, 0)

                if loop.shape != CountedShape.PLAIN then
                    _skip_removed(loop)
                fi

                let at = _current.load(Types.i32, index, 0)

                return _current.compare(IntegerPredicate.SLT, at, _current.load(Types.i32, loop.count!, 0))
            fi

            let at = _current.load(Types.i32, index, 0)
            let key = arrays.load(_current, loop.array!, _current.load(Types.pointer, loop.storage!, 0), at)

            if loop.shape != CountedShape.PAIRS then
                return key
            fi

            let element = arrays.load(_current, loop.value_array!, _current.load(Types.pointer, loop.values!, 0), at)

            return _pair(value.type, key, element)
        si

        // Moves `loop`'s index on past the removed entries of a hash table,
        // whose hashes are negative, as the table's own iterator does.
        _skip_removed(loop: COUNTED_LOOP) is
            let arrays = _arrays!
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup
            let hashes_array = arrays.array_of(lookup.get_array_type(lookup.get_int_type()))!

            let check = _new_block()
            let test = _new_block()
            let skip = _new_block()
            let done = _new_block()

            _current.branch(check)

            _start(check)
            let at = _current.load(Types.i32, loop.index!, 0)
            _current.branch(_current.compare(IntegerPredicate.SLT, at, _current.load(Types.i32, loop.count!, 0)), test, done)

            _start(test)
            let hash = arrays.load(_current, hashes_array, _current.load(Types.pointer, loop.hashes!, 0), at)
            _current.branch(_current.compare(IntegerPredicate.SLT, hash, _i32(0)), skip, done)

            _start(skip)
            _current.store(_current.binary(BinaryOperator.ADD, IntegerFlags.NONE, at, _i32(1)), loop.index!, 0)
            _current.branch(check)

            _start(done)
        si

        // A key and value pair of `type` holding `key` and `element`.
        _pair(type: Type?, key: LLVM.Value, element: LLVM.Value) -> LLVM.Value is
            let objects = _objects!
            let pair = objects.class_of(_specialize(type))
            let held = _held(type)

            if !pair? \/ !held? then
                _report("a map entry")
                return key
            fi

            let key_field = pair.definition.find_direct("_key")
            let value_field = pair.definition.find_direct("_value")

            if let key_symbol = key_field, value_symbol = value_field, key_at = objects.field_position(key_symbol), value_at = objects.field_position(value_symbol) then
                let with_key = _insert_member(LLVM_TYPES.zero(held), key, key_at, pair.specialize(key_symbol.type))

                return _insert_member(with_key, element, value_at, pair.specialize(value_symbol.type))
            fi

            _report("a map entry")
            return key
        si
    si
si
