namespace IR.LLVMTarget is
    use Collections.LIST
    use Collections.MAP

    use LLVM.BLOCK
    use LLVM.FUNCTION
    use LLVM.GLOBAL_VARIABLE
    use LLVM.Intrinsics
    use LLVM.Linkage
    use LLVM.MODULE
    use LLVM.PARAMETER
    use LLVM.Types
    use LLVM.Values

    /// A string on the LLVM target: one object holding the string type's
    /// descriptor, a cached hash, the number of UTF-16 code units and the
    /// code units themselves, laid out as `{ ptr, i32, i32, [N x i16] }`.
    ///
    /// This builds what strings need beyond the lowering of each body: one
    /// constant global per distinct literal, and the functions the native
    /// runtime calls to make the program's strings.
    class LLVM_STRINGS is
        _module: MODULE
        _literals: MAP[string, LLVM.Value]
        _is_descriptor_used: bool

        /// The offset of the cached hash within a string.
        HASH_OFFSET: int static => 8

        /// The offset of the count of code units within a string.
        LENGTH_OFFSET: int static => 12

        /// The offset of the first code unit within a string.
        CHARS_OFFSET: int static => 16

        /// The name of the global that stands for the string type's
        /// descriptor.
        DESCRIPTOR_NAME: string static => "string.$descriptor"

        /// The name of the function the runtime calls to make a string.
        MAKE_STRING_NAME: string static => "$ghul_make_string"

        /// The name of the function the runtime calls to make a `ubyte[]`.
        MAKE_BYTES_NAME: string static => "$ghul_make_bytes"

        /// The name of the function the runtime calls to describe an
        /// exception nothing caught.
        REPORT_UNHANDLED_NAME: string static => "$ghul_report_unhandled"

        /// The name of the function the runtime calls to make the exception
        /// a read through null throws.
        MAKE_NULL_REFERENCE_NAME: string static => "$ghul_make_null_reference"

        /// The name of the runtime's function that throws what
        /// `$ghul_make_null_reference` makes.
        THROW_NULL_REFERENCE_NAME: string static => "$ghul_throw_null_reference"

        /// The name of the runtime's host operation for `host.<operation>`.
        host_name(operation: string) -> string static => "$ghul_host_{operation}"

        _names: LLVM_NAMES

        /// - module: where the literals and functions are added
        init(module: MODULE) is
            init(module, LLVM_NAMES())
        si

        /// - module: where the literals and functions are added
        /// - names: the names the module's globals are given
        init(module: MODULE, names: LLVM_NAMES) is
            _module = module
            _names = names
            _literals = MAP[string, LLVM.Value]()
        si

        /// The hash `string.get_hash_code` answers for `text`, so a literal's
        /// cached hash agrees with one computed at run time.
        hash(text: string) -> int static is
            let hash mut = -2128831035

            for unit in text do
                hash = (hash ^ cast int(unit)) * 16777619
            od

            return hash
        si

        /// The string type's descriptor, which the string class adds with
        /// the other descriptors.
        descriptor: LLVM.Value is
            _is_descriptor_used = true

            return Values.global(DESCRIPTOR_NAME)
        si

        /// Adds a placeholder for the string type's descriptor where strings
        /// were made, for a program whose core library declares no string
        /// type and so has no string class to describe them.
        add_placeholder_descriptor() is
            if !_is_descriptor_used then
                return
            fi

            let global = GLOBAL_VARIABLE(DESCRIPTOR_NAME, Types.i8, Values.zero(Types.i8), true)

            global.linkage = Linkage.INTERNAL

            _module.add_global(global)
        si

        /// The label of the global holding the literal `text`: up to its
        /// first 24 code units, each letter or digit kept and anything else
        /// written as `_`.
        ///
        /// - text: the literal's text
        literal_label(text: string) -> string static is
            let result = Text.STRING_BUILDER("$literal.")
            let count = if text.length < 24 then text.length else 24 fi

            for i in 0..count do
                let unit = text[i]

                if (unit >= 'a' /\ unit <= 'z') \/ (unit >= 'A' /\ unit <= 'Z') \/ (unit >= '0' /\ unit <= '9') then
                    result.append(unit)
                else
                    result.append('_')
                fi
            od

            return result.to_string()
        si

        /// The constant global holding the literal `text`. Every literal
        /// with the same text is the same object, as on .NET.
        literal(text: string) -> LLVM.Value is
            let found: LLVM.Value mut

            if _literals.try_get_value(text, found ref) then
                return found
            fi

            let units = LIST[LLVM.Value]()

            for unit in text do
                units.add(Values.integer(Types.i16, bigint(cast int(unit))))
            od

            let chars = LLVM.Type.ARRAY(text.length, Types.i16)
            let type = Types.structure([Types.pointer, Types.i32, Types.i32, chars])

            let initializer =
                LLVM.Value.AGGREGATE(
                    [
                        descriptor,
                        Values.i32(hash(text)),
                        Values.i32(text.length),
                        LLVM.Value.AGGREGATE(units.to_array(), chars)
                    ],
                    type)

            let global = GLOBAL_VARIABLE(_names.unique(literal_label(text)), type, initializer, true)

            global.linkage = Linkage.PRIVATE
            global.alignment = 8

            _module.add_global(global)

            let reference = global.reference

            _literals[text] = reference

            return reference
        si

        /// The address of the first code unit of the string `text` points at.
        chars(block: BLOCK, text: LLVM.Value) -> LLVM.Value =>
            block.element_pointer(Types.i8, text, [Values.i32(CHARS_OFFSET)], true)

        /// The number of code units in the string `text` points at.
        length(block: BLOCK, text: LLVM.Value) -> LLVM.Value =>
            block.load(Types.i32, block.element_pointer(Types.i8, text, [Values.i32(LENGTH_OFFSET)], true), 4)

        /// The code unit at `index` in the string `text` points at, as the
        /// `i32` a `char` is held in. The index is not checked.
        char_at(block: BLOCK, text: LLVM.Value, index: LLVM.Value) -> LLVM.Value is
            let offset = block.binary(LLVM.BinaryOperator.SHL, LLVM.IntegerFlags.NONE, index, Values.i32(1))
            let unit = block.load(Types.i16, block.element_pointer(Types.i8, chars(block, text), [offset], true), 2)

            return block.convert(LLVM.Conversion.ZERO_EXTEND, unit, Types.i32)
        si

        /// A new string of `length` code units, as yet unwritten, from the
        /// allocator for objects that hold no references. Only the header is
        /// written, so every caller writes every code unit.
        allocate(block: BLOCK, length: LLVM.Value) -> LLVM.Value is
            let bytes = block.binary(LLVM.BinaryOperator.SHL, LLVM.IntegerFlags.NONE, block.convert(LLVM.Conversion.SIGN_EXTEND, length, Types.i64), Values.i64(1L))
            let size = block.binary(LLVM.BinaryOperator.ADD, LLVM.IntegerFlags.NONE, bytes, Values.i64(cast long(CHARS_OFFSET)))

            let result = _allocate_unzeroed(block, descriptor, size)

            block.store(Values.i32(0), block.element_pointer(Types.i8, result, [Values.i32(HASH_OFFSET)], true), 4)
            block.store(length, block.element_pointer(Types.i8, result, [Values.i32(LENGTH_OFFSET)], true), 4)

            return result
        si

        // Copies `count` code units from `from` to `to`.
        _copy(block: BLOCK, to: LLVM.Value, from: LLVM.Value, count: LLVM.Value) is
            let bytes = block.binary(LLVM.BinaryOperator.SHL, LLVM.IntegerFlags.NONE, block.convert(LLVM.Conversion.SIGN_EXTEND, count, Types.i64), Values.i64(1L))

            block.call(_module.declare_intrinsic(Intrinsics.memcpy()), [to, from, bytes, Values.boolean(false)])
        si

        // The address `count` code units on from `units`.
        _advance(block: BLOCK, units: LLVM.Value, count: LLVM.Value) -> LLVM.Value =>
            block.element_pointer(Types.i16, units, [count], true)

        /// The function that joins two strings, either of which may be
        /// null and is then taken as empty, into a new one.
        concat_function: FUNCTION =>
            _helper("string.$concat", Types.pointer, [Types.pointer, Types.pointer], function is
                let block = function.add_block("entry")
                let empty = literal("")

                let left = block.select(block.compare(LLVM.IntegerPredicate.EQ, function.parameter(0), Values.null_pointer), empty, function.parameter(0))
                let right = block.select(block.compare(LLVM.IntegerPredicate.EQ, function.parameter(1), Values.null_pointer), empty, function.parameter(1))

                let left_length = length(block, left)
                let right_length = length(block, right)

                let result = allocate(block, block.binary(LLVM.BinaryOperator.ADD, LLVM.IntegerFlags.NONE, left_length, right_length))
                let to = chars(block, result)

                _copy(block, to, chars(block, left), left_length)
                _copy(block, _advance(block, to, left_length), chars(block, right), right_length)

                block.return_value(result)
            si)

        /// The function that answers whether two strings, either of which
        /// may be null, hold the same code units: two nulls are equal, and
        /// a null is equal to no string.
        equals_function: FUNCTION =>
            _helper("string.$equals", Types.i1, [Types.pointer, Types.pointer], function is
                let left = function.parameter(0)
                let right = function.parameter(1)

                let entry = function.add_block("entry")
                let same = function.add_block("same")
                let present = function.add_block("present")
                let lengths = function.add_block("lengths")
                let compare = function.add_block("compare")
                let different = function.add_block("different")

                entry.branch(entry.compare(LLVM.IntegerPredicate.EQ, left, right), same, present)

                same.return_value(Values.boolean(true))

                let either_null =
                    present.binary(
                        LLVM.BinaryOperator.OR,
                        LLVM.IntegerFlags.NONE,
                        present.compare(LLVM.IntegerPredicate.EQ, left, Values.null_pointer),
                        present.compare(LLVM.IntegerPredicate.EQ, right, Values.null_pointer))

                present.branch(either_null, different, lengths)

                let left_length = lengths.load(Types.i32, lengths.element_pointer(Types.i8, left, [Values.i32(LENGTH_OFFSET)], true), 4)
                let right_length = lengths.load(Types.i32, lengths.element_pointer(Types.i8, right, [Values.i32(LENGTH_OFFSET)], true), 4)

                lengths.branch(lengths.compare(LLVM.IntegerPredicate.NE, left_length, right_length), different, compare)

                different.return_value(Values.boolean(false))

                let bytes = compare.binary(LLVM.BinaryOperator.SHL, LLVM.IntegerFlags.NONE, compare.convert(LLVM.Conversion.SIGN_EXTEND, left_length, Types.i64), Values.i64(1L))
                let order = compare.call(runtime("memcmp", Types.i32, [Types.pointer, Types.pointer, Types.i64]), [chars(compare, left), chars(compare, right), bytes])!

                compare.return_value(compare.compare(LLVM.IntegerPredicate.EQ, order, Values.i32(0)))
            si)

        /// The function that copies `count` code units of a string from
        /// `start` into a new string. The range is not checked.
        substring_function: FUNCTION =>
            _helper("string.$substring", Types.pointer, [Types.pointer, Types.i32, Types.i32], function is
                let block = function.add_block("entry")
                let count = function.parameter(2)

                let result = allocate(block, count)

                _copy(block, chars(block, result), _advance(block, chars(block, function.parameter(0)), function.parameter(1)), count)

                block.return_value(result)
            si)

        /// The function that makes a string of the one code unit it is
        /// passed, held as an `i32`.
        from_char_function: FUNCTION =>
            _helper("string.$from_char", Types.pointer, [Types.i32], function is
                let block = function.add_block("entry")

                let result = allocate(block, Values.i32(1))

                block.store(block.convert(LLVM.Conversion.TRUNCATE, function.parameter(0), Types.i16), chars(block, result), 2)

                block.return_value(result)
            si)

        /// The function that copies `count` code units of a string from
        /// `start` into an array of `char` from `at` on. An array of `char`
        /// has a string's layout, so the copy is one block move. The ranges
        /// are not checked.
        copy_to_function: FUNCTION =>
            _helper("string.$copy_to", LLVM.Type.VOID, [Types.pointer, Types.i32, Types.pointer, Types.i32, Types.i32], function is
                let block = function.add_block("entry")

                let from = _advance(block, chars(block, function.parameter(0)), function.parameter(1))
                let to = _advance(block, chars(block, function.parameter(2)), function.parameter(3))

                _copy(block, to, from, function.parameter(4))

                block.return_void()
            si)

        // The function `name`, private to the module, built by `build` the
        // first time it is asked for.
        _helper(name: string, result: LLVM.Type, parameters: ARRAY[LLVM.Type], build: FUNCTION -> void) -> FUNCTION is
            if let existing = _module.function_named(name) then
                return existing
            fi

            let declared = LIST[PARAMETER]()

            for (i, type) in parameters |> Ghul.Pipes.index() do
                declared.add(PARAMETER(type, "a{i}"))
            od

            let function = FUNCTION(name, result, declared.to_array())

            function.linkage = Linkage.INTERNAL

            build(function)

            return _module.add_function(function)
        si

        /// Adds the function the native runtime calls to make a string, which
        /// every program defines.
        add_exports() is
            _add_make_string()
        si

        // Copies `length` code units into a new string, through the runtime's
        // allocator for objects that hold no references. The hash is left
        // zero, as `string.get_hash_code` does not read it.
        _add_make_string() is
            let function =
                FUNCTION(
                    MAKE_STRING_NAME,
                    Types.pointer,
                    [PARAMETER(Types.pointer, "chars"), PARAMETER(Types.i32, "length")])

            let block = function.add_block("entry")

            let length = function.parameter(1)
            let result = allocate(block, length)

            _copy(block, chars(block, result), function.parameter(0), length)

            block.return_value(result)

            _module.add_function(function)
        si

        /// The runtime's `$ghul_throw_null_reference`, declared the first time
        /// it is asked for, as a cold function that does not return.
        throw_null_reference: FUNCTION is
            if let existing = _module.function_named(THROW_NULL_REFERENCE_NAME) then
                return existing
            fi

            let function = runtime(THROW_NULL_REFERENCE_NAME, LLVM.Type.VOID, [])

            function.attributes.add(LLVM.Attribute.FLAG("cold"))
            function.attributes.add(LLVM.Attribute.FLAG("noreturn"))

            return function
        si

        /// The module's declaration of `name`, a function the runtime
        /// defines, adding it the first time it is asked for.
        /// - name: the function's name
        /// - result: the type it returns
        /// - parameters: the types it takes
        runtime(name: string, result: LLVM.Type, parameters: ARRAY[LLVM.Type]) -> FUNCTION is
            if let existing = _module.function_named(name) then
                return existing
            fi

            let declared = LIST[PARAMETER]()

            for (i, type) in parameters |> Ghul.Pipes.index() do
                declared.add(PARAMETER(type, "a{i}"))
            od

            let function = FUNCTION(name, result, declared.to_array())

            _describe_runtime(function)

            return _module.add_function(function)
        si

        /// A new object of `size` bytes, its descriptor stored in its first
        /// word and every other byte zero. The stores are the program's, so
        /// the optimiser sees the object initialised and can drop a store
        /// that is overwritten before anything reads it.
        ///
        /// - block: where the allocation goes
        /// - descriptor: the object's descriptor
        /// - size: the object's size in bytes, an `i64`, header included
        /// - scanned: whether the object can hold a pointer the collector
        ///   must follow
        allocate_object(block: BLOCK, descriptor: LLVM.Value, size: LLVM.Value, scanned: bool) -> LLVM.Value is
            let allocator = runtime(if scanned then "$ghul_alloc" else "$ghul_alloc_atomic" fi, Types.pointer, [Types.i64])
            let result = block.call(allocator, [size])!

            if !scanned \/ !SCANNED_MEMORY_IS_ZEROED then
                block.call(_module.declare_intrinsic(Intrinsics.memset()), [result, Values.integer(Types.i8, 0n), size, Values.boolean(false)])
            fi

            block.store(descriptor, result, 8)
            block.last_instruction.attach("invariant.group", _module.empty_metadata())

            return result
        si

        // A new object of `size` bytes holding no references, with only its
        // descriptor written.
        _allocate_unzeroed(block: BLOCK, descriptor: LLVM.Value, size: LLVM.Value) -> LLVM.Value is
            let result = block.call(runtime("$ghul_alloc_atomic", Types.pointer, [Types.i64]), [size])!

            block.store(descriptor, result, 8)
            block.last_instruction.attach("invariant.group", _module.empty_metadata())

            return result
        si

        /// The descriptor of the object `object` points at. An object's
        /// descriptor is stored once, when it is allocated, and never changes,
        /// which the load says, so the optimiser can carry a descriptor it
        /// has seen stored, or loaded, across a call to code it cannot see.
        ///
        /// - block: where the load goes
        /// - object: the object
        load_descriptor(block: BLOCK, object: LLVM.Value) -> LLVM.Value is
            let descriptor = block.load(Types.pointer, object, 8)

            block.last_instruction.attach("invariant.group", _module.empty_metadata())

            return descriptor
        si

        /// Whether `$ghul_alloc` is described to the optimiser as answering
        /// zeroed memory, as the collector does, so the program does not
        /// zero what it allocates there.
        SCANNED_MEMORY_IS_ZEROED: bool static => false

        // Says what the optimiser cannot see for itself about a function the
        // runtime defines, whose body is not in the module: that an
        // allocation answers fresh memory of the size it was asked for,
        // aligned to 16 bytes as the collector aligns everything, and
        // which functions neither unwind nor touch memory they are not
        // given.
        _describe_runtime(function: FUNCTION) is
            let name = function.name

            if name =~ "$ghul_alloc" \/ name =~ "$ghul_alloc_atomic" then
                let zeroed = name =~ "$ghul_alloc" /\ SCANNED_MEMORY_IS_ZEROED

                function.result_attributes.add(LLVM.Attribute.FLAG("noalias"))
                function.result_attributes.add(LLVM.Attribute.FLAG("nonnull"))
                function.result_attributes.add(LLVM.Attribute.FLAG("align 16"))
                function.attributes.add(LLVM.Attribute.FLAG("nounwind"))
                function.attributes.add(LLVM.Attribute.INTEGER("allocsize", 0L))
                function.attributes.add(LLVM.Attribute.FLAG(if zeroed then "allockind(\"alloc,zeroed\")" else "allockind(\"alloc,uninitialized\")" fi))
                function.attributes.add(LLVM.Attribute.STRING("alloc-family", "ghul_gc"))
            elif name =~ "$ghul_clone" then
                function.result_attributes.add(LLVM.Attribute.FLAG("noalias"))
                function.result_attributes.add(LLVM.Attribute.FLAG("nonnull"))
                function.result_attributes.add(LLVM.Attribute.FLAG("align 16"))
                function.attributes.add(LLVM.Attribute.FLAG("nounwind"))
            elif name =~ "$ghul_identity_hash" then
                function.attributes.add(LLVM.Attribute.FLAG("nounwind"))
                function.attributes.add(LLVM.Attribute.FLAG("willreturn"))
                function.attributes.add(LLVM.Attribute.FLAG("memory(none)"))
            elif name =~ "memcmp" then
                function.attributes.add(LLVM.Attribute.FLAG("nounwind"))
                function.attributes.add(LLVM.Attribute.FLAG("willreturn"))
                function.attributes.add(LLVM.Attribute.FLAG("memory(argmem: read)"))
            elif name =~ "$ghul_throw" then
                function.attributes.add(LLVM.Attribute.FLAG("cold"))
                function.attributes.add(LLVM.Attribute.FLAG("noreturn"))
            elif name =~ "$ghul_caught" then
                function.attributes.add(LLVM.Attribute.FLAG("nounwind"))
                function.attributes.add(LLVM.Attribute.FLAG("willreturn"))
            fi
        si
    si
si
