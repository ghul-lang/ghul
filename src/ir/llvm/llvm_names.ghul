namespace IR.LLVMTarget is
    use IR.Program

    use Collections.MAP
    use Collections.SET

    use Semantic.Symbols.Function
    use Semantic.Symbols.FRAME
    use Semantic.Symbols.ScopedWithEnclosingScope
    use Semantic.Symbols.Symbol

    /// The names functions and globals are written with in an LLVM module.
    ///
    /// Each name is a readable label for what it stands for: a function's
    /// qualified name and type arguments, a type's descriptor as the type's
    /// name with `.$descriptor` after it, and so on. Where an earlier name
    /// already holds a label, a numeric suffix tells them apart. Names are
    /// given in the order they are asked for, so a program is named the
    /// same way every time it is compiled.
    ///
    /// A part the compiler adds starts with `$`, which no ghūl identifier
    /// can, so a label never clashes with a declared name. Only the names
    /// the runtime library itself defines or expects start `$ghul_`.
    class LLVM_NAMES is
        _names: MAP[FUNCTION_INSTANCE, string]
        _taken: SET[string]

        init() is
            _names = MAP[FUNCTION_INSTANCE, string]()
            _taken = SET[string]()
        si

        /// Keeps `name` from being given to anything else, for a name the
        /// module declares for itself.
        ///
        /// - name: the name to keep
        reserve(name: string) is
            _taken.add(name)
        si

        /// The name of the function `instance`, chosen the first time it is
        /// asked for.
        ///
        /// - instance: the function instance to name
        name_of(instance: FUNCTION_INSTANCE) -> string is
            let name mut = ""

            if _names.try_get_value(instance, name ref) then
                return name
            fi

            name = unique(label(instance))

            _names[instance] = name

            return name
        si

        /// `label` as it stands, kept from being given to anything else, for a
        /// name that must not depend on the order names were asked for.
        ///
        /// - label: the name to take
        claim(label: string) -> string is
            _taken.add(label)

            return label
        si

        /// The longest a label is kept before a name is made from it.
        MAX_LABEL_LENGTH: int static => 96

        /// A name no earlier one holds: `label`, cut to `MAX_LABEL_LENGTH`
        /// code units, itself or with the first numeric suffix that is free.
        ///
        /// - label: what the name should read as
        unique(label: string) -> string is
            let cut = shortened(label)
            let name mut = cut
            let suffix mut = 1

            while !_taken.add(name) do
                name = "{cut}.{suffix}"
                suffix = suffix + 1
            od

            return name
        si

        /// `label`, cut to at most `MAX_LABEL_LENGTH` code units without
        /// splitting a surrogate pair.
        ///
        /// - label: the label to cut
        shortened(label: string) -> string static is
            if label.length <= MAX_LABEL_LENGTH then
                return label
            fi

            let length = if label[MAX_LABEL_LENGTH - 1] >= '\uD800' /\ label[MAX_LABEL_LENGTH - 1] <= '\uDBFF' then MAX_LABEL_LENGTH - 1 else MAX_LABEL_LENGTH fi

            return label.substring(0, length)
        si

        /// The label of the function `instance`, without giving it a name.
        ///
        /// - instance: the function instance to label
        label(instance: FUNCTION_INSTANCE) -> string =>
            if CELL_LINK.is_active /\ !instance.definition.is_closure then
                cell_label(instance)
            elif instance.type_map.count == 0 then
                function_label(instance.definition)
            else
                "{function_label(instance.definition)}[{instance.type_map.values |> Ghul.Pipes.join(",")}]"
            fi

        /// The qualified name of `symbol`. A build whose cells are loaded into
        /// one process names the namespace the compiler made for a cell too,
        /// which the symbol's own qualified name leaves out, so two cells
        /// that declare the same name do not give two symbols the same name.
        ///
        /// - symbol: the declaration to name
        declared_name(symbol: Symbol) -> string static is
            if !CELL_LINK.is_active then
                return symbol.qualified_name
            fi

            let owner = symbol.owner

            if let containing: Semantic.Symbols.NAMESPACE = owner then
                let prefix = containing.qualified_name.trim_start(['.'])

                return if prefix.length == 0 then _part(symbol) else "{prefix}.{_part(symbol)}" fi
            elif let outer: Symbol = owner then
                return "{declared_name(outer)}.{_part(symbol)}"
            fi

            return _part(symbol)
        si

        // A symbol's name and how many type parameters it takes: a class and a
        // generic class of the same name are two types.
        _part(symbol: Symbol) -> string static =>
            if symbol.argument_names.count > 0 then "{symbol.name}`{symbol.argument_names.count}" else symbol.name fi

        /// The label of `instance` in a build whose cells are loaded into one
        /// process, where the name is the linkage identity: another cell
        /// compiled on its own must give the same function the same name. It is
        /// made of the declaration alone: the owners, the name, the types of the
        /// arguments and the type arguments, so overloads differ and no name
        /// depends on the order names were asked for.
        ///
        /// - instance: the function instance to label
        cell_label(instance: FUNCTION_INSTANCE) -> string is
            let definition = instance.definition
            let signature = definition.arguments |> Ghul.Pipes.map(a => structural_label(instance.specialize(a))) |> Ghul.Pipes.join(",")
            let arguments = instance.type_map.values |> Ghul.Pipes.map(structural_label(*)) |> Ghul.Pipes.join(",")
            let owner = function_label(definition)

            // A static member and an instance member can share a name and
            // arguments, a static constructor and a constructor do.
            let kind = if definition.is_instance \/ !isa Semantic.Symbols.Classy(definition.owner) then "" else "$static" fi

            return if instance.type_map.count == 0 then "{owner}{kind}({signature})" else "{owner}{kind}[{arguments}]({signature})" fi
        si

        /// A type named by the symbols that make it up and nothing a diagnostic
        /// would render: the declaring symbol's qualified name and, for a
        /// generic instantiation, its type arguments in turn.
        ///
        /// - type: the type to label
        structural_label(type: Semantic.Types.Type?) -> string static is
            if !type? then
                return "$none"
            fi

            let symbol = type.unspecialized_symbol ?? type.symbol
            let name = declared_name(symbol)

            if type.arguments.count == 0 then
                return name
            fi

            return "{name}[{type.arguments |> Ghul.Pipes.map(structural_label(*)) |> Ghul.Pipes.join(",")}]"
        si

        /// The label of the class instance `type`.
        ///
        /// - type: the class instance to label
        type_label(type: CLASS_INSTANCE) -> string is
            let name =
                if let frame: FRAME = type.definition then
                    frame_label(frame)
                else
                    declared_name(type.definition)
                fi

            if CELL_LINK.is_active /\ type.arguments.count > 0 then
                return "{name}[{type.arguments |> Ghul.Pipes.map(structural_label(*)) |> Ghul.Pipes.join(",")}]"
            fi

            return if type.arguments.count == 0 then name else "{name}[{type.arguments |> Ghul.Pipes.join(",")}]" fi
        si

        // A function literal has no name of its own, so it and the frame
        // holding what it captures are labelled after the function it is
        // written in. A function a frame declares is labelled after the frame.
        function_label(definition: Function) -> string =>
            if definition.is_closure then
                "{_enclosing_label(definition)}.$closure"
            elif let frame: FRAME = definition.owner then
                "{frame_label(frame)}.{definition.name}"
            else
                declared_name(definition)
            fi

        frame_label(frame: FRAME) -> string => "{_enclosing_label(frame.closure)}.$frame"

        // The label of the function a literal is written in, through any
        // block or literal it is nested in; at namespace scope, the
        // namespace's name.
        _enclosing_label(literal: Function) -> string is
            let scope: Semantic.Scope? mut = literal.enclosing_scope

            while scope? do
                if let function: Function = scope /\ !function.is_closure then
                    return function_label(function)
                elif let block: Semantic.BLOCK_SCOPE = scope then
                    scope = block.enclosing
                elif let scoped: ScopedWithEnclosingScope = scope then
                    scope = scoped.enclosing_scope
                elif let symbol: Symbol = scope then
                    return symbol.qualified_name
                else
                    scope = null
                fi
            od

            return "$global"
        si
    si
si
