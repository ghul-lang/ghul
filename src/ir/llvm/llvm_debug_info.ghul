namespace IR.LLVMTarget is
    use IR.Program

    use Collections.MAP

    use LLVM.Metadata
    use LLVM.MetadataNode
    use LLVM.MODULE

    /// The source-level debug information a module built with `--debug`
    /// carries: one compile unit, a file for each source file, a subprogram
    /// for each function, against which every instruction's line and column
    /// are recorded, and a variable for each argument and named local, so a
    /// debugger and a crash's backtrace name ghūl files, lines and variables.
    /// A scalar is described by its kind, a reference to an instance of a
    /// class as a pointer to a structure of its fields, and anything else as
    /// a pointer.
    class LLVM_DEBUG_INFO is
        _module: MODULE
        _files: MAP[string, Metadata]
        _unit: Metadata?
        _subroutine_type: Metadata?
        _scalar_types: MAP[Scalar, Metadata]
        _pointer_type: Metadata?
        _class_types: MAP[CLASS_INSTANCE, Metadata]

        /// The program's classes, whose fields a pointer to an object is
        /// described with once they are laid out.
        objects: LLVM_OBJECTS? public

        /// The language the compile unit is recorded as, until DWARF has an
        /// identifier for ghūl.
        LANGUAGE: string static => "DW_LANG_C"

        /// - module: where the debug information is added
        init(module: MODULE) is
            _module = module
            _files = MAP[string, Metadata]()
            _scalar_types = MAP[Scalar, Metadata]()
            _class_types = MAP[CLASS_INSTANCE, Metadata]()
        si

        /// The subprogram for a function, named `name`, starting at
        /// `location`, which every location in its body is scoped to. The
        /// function carries it as its `!dbg` attachment.
        ///
        /// - function: the compiled function
        /// - name: the ghūl name the debugger shows for it
        /// - location: where the function is declared
        subprogram(function: LLVM.FUNCTION, name: string, location: Source.LOCATION) -> Metadata is
            let file = _file(location)
            let line = _line(location)

            let subprogram =
                _module.add_metadata(
                    MetadataNode.SUBPROGRAM(name, function.name, file, file, line, _type(), line, true, _compile_unit(location)),
                    true)

            function.attach("dbg", subprogram)

            return subprogram
        si

        /// A location within `scope`, a subprogram, at `location`'s first
        /// line and column.
        location(location: Source.LOCATION, scope: Metadata) -> Metadata =>
            _module.add_metadata(MetadataNode.LOCATION(_line(location), location.start_column, scope, null), false)

        /// The source variable `name`, an argument where `argument` is its
        /// position from 1 and a local where it is 0, declared at `location`
        /// in `scope`, holding a value of `type`.
        variable(name: string, argument: int, scope: Metadata, location: Source.LOCATION, type: Semantic.Types.Type?) -> Metadata =>
            _module.add_metadata(MetadataNode.LOCAL_VARIABLE(name, argument, scope, _file(location), _line(location), _type_of(type)), false)

        // A scalar is described by its kind, as the lowering holds it, and a
        // reference to an instance of a class by the class's fields; any
        // other value is a pointer to nothing a debugger can show.
        _type_of(type: Semantic.Types.Type?) -> Metadata is
            if let o = objects /\ o.is_built, c = o.class_of(type) /\ o.is_object_type(c) /\ !o.is_string(c) /\ !o.is_array(c) then
                return _module.add_metadata(MetadataNode.POINTER_TYPE(_structure(o, c), 64), false)
            fi

            if let scalar = LLVM_TYPES.scalar(type) then
                let found: Metadata mut

                if _scalar_types.try_get_value(scalar, found ref) then
                    return found
                fi

                let stored = LLVM_TYPES.stored_type(scalar)
                let size = if LLVM_TYPES.width(stored) > 0 then LLVM_TYPES.width(stored) elif stored =~ LLVM.Type.FLOAT then 32 else 64 fi

                let node = _module.add_metadata(MetadataNode.BASIC_TYPE(_scalar_name(scalar), size, _encoding(scalar)), false)

                _scalar_types[scalar] = node

                return node
            fi

            if let pointer = _pointer_type then
                return pointer
            fi

            let pointer = _module.add_metadata(MetadataNode.POINTER_TYPE(Metadata.NULL, 64), false)

            _pointer_type = pointer

            return pointer
        si

        // A class's instance as a structure of its fields, each at the offset
        // the layout gives it. The descriptor that starts every instance is
        // left out. The structure is made before its members, so a field
        // holding the class itself refers back to it.
        _structure(objects: LLVM_OBJECTS, type: CLASS_INSTANCE) -> Metadata is
            let found: Metadata mut

            if _class_types.try_get_value(type, found ref) then
                return found
            fi

            let location = type.definition.location
            let file = _file(location)
            let structure = _module.add_metadata(MetadataNode.TUPLE([]), false)

            _class_types[type] = structure

            let layout = cast LLVM.Type.STRUCT(objects.struct_type(type))
            let members = Collections.LIST[Metadata]()

            for (`field, field_type, position) in objects.fields_of(type) do
                let held = layout.fields[position]
                let name = if `field.name.starts_with('$') then `field.name.substring(1) else `field.name fi
                let declared = _declared_at(`field, name, type)

                members.add(
                    _module.add_metadata(
                        MetadataNode.MEMBER(
                            name,
                            _file(declared),
                            _line(declared),
                            _type_of(field_type),
                            LLVM_TYPES.size_of(held) * 8,
                            LLVM_TYPES.offset_of(layout, position) * 8),
                        false))
            od

            let elements = _module.add_metadata(MetadataNode.TUPLE(members.to_array()), false)

            _module.replace_metadata(
                structure,
                MetadataNode.STRUCTURE_TYPE(
                    TYPE_NAMES.name_of(type, objects.classes, null, LLVM_TYPES.scalar(*), LLVM_TYPES.is_string(*)),
                    file,
                    _line(location),
                    objects.size_of(type) * 8,
                    elements))

            return structure
        si

        // Where `field` is declared: an auto-property's backing field has no
        // location of its own, so the property named `name` stands for it, or
        // failing that the class.
        _declared_at(`field: Semantic.Symbols.Symbol, name: string, type: CLASS_INSTANCE) -> Source.LOCATION is
            if `field.location != Source.LOCATION.internal then
                return `field.location
            fi

            if let property = type.definition.find_direct(name) /\ property.location != Source.LOCATION.internal then
                return property.location
            fi

            return type.definition.location
        si

        _scalar_name(scalar: Scalar) -> string =>
            case scalar
            when Scalar.BOOL then "bool"
            when Scalar.CHAR then "char"
            when Scalar.INT8 then "byte"
            when Scalar.UINT8 then "ubyte"
            when Scalar.INT16 then "short"
            when Scalar.UINT16 then "ushort"
            when Scalar.INT32 then "int"
            when Scalar.UINT32 then "uint"
            when Scalar.INT64 then "long"
            when Scalar.UINT64 then "ulong"
            when Scalar.INT_NATIVE then "word"
            when Scalar.UINT_NATIVE then "uword"
            when Scalar.FLOAT32 then "single"
            when Scalar.FLOAT64 then "double"
            esac

        _encoding(scalar: Scalar) -> string =>
            case scalar
            when Scalar.BOOL then "DW_ATE_boolean"
            when Scalar.CHAR then "DW_ATE_UTF"
            when Scalar.FLOAT32, Scalar.FLOAT64 then "DW_ATE_float"
            else if LLVM_TYPES.is_unsigned(scalar) then "DW_ATE_unsigned" else "DW_ATE_signed" fi
            esac

        /// Adds the module flags a debugger needs, and lists the compile unit,
        /// where any function carries debug information.
        finish() is
            if let unit = _unit then
                _module.add_module_flag(LLVM.ModuleFlagBehavior.MAX, "Dwarf Version", LLVM.Values.i32(5))
                _module.add_module_flag(LLVM.ModuleFlagBehavior.WARNING, "Debug Info Version", LLVM.Values.i32(3))

                _module.named("llvm.dbg.cu").operands.add(unit)
            fi
        si

        // The compile unit, recorded against the first file a function is
        // declared in.
        _compile_unit(location: Source.LOCATION) -> Metadata is
            if let unit = _unit then
                return unit
            fi

            let unit =
                _module.add_metadata(
                    MetadataNode.COMPILE_UNIT(LANGUAGE, _file(location), "ghul", false, LLVM.DebugEmission.FULL_DEBUG),
                    true)

            _unit = unit

            return unit
        si

        _file(location: Source.LOCATION) -> Metadata is
            let path = IO.Path.get_full_path(location.file_name)
            let found: Metadata mut

            if _files.try_get_value(path, found ref) then
                return found
            fi

            let file =
                _module.add_metadata(
                    MetadataNode.FILE(IO.Path.get_file_name(path) ?? path, IO.Path.get_directory_name(path) ?? ""),
                    false)

            _files[path] = file

            return file
        si

        // Every subprogram has the same type: line tables do not record
        // argument types.
        _type() -> Metadata is
            if let type = _subroutine_type then
                return type
            fi

            let type =
                _module.add_metadata(
                    MetadataNode.SUBROUTINE_TYPE(_module.add_metadata(MetadataNode.TUPLE([]), false)),
                    false)

            _subroutine_type = type

            return type
        si

        _line(location: Source.LOCATION) -> int => if location.start_line > 0 then location.start_line else 1 fi
    si
si
