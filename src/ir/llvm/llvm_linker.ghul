namespace IR.LLVMTarget is
    /// Links an LLVM module's text into an executable with `ghul-llvm`, which
    /// verifies, optimises and links it against the runtime.
    ///
    /// `ghul-llvm` is found on the path unless `GHUL_LLVM` names it, and the
    /// runtime it links against is the directory `GHUL_LLVM_RUNTIME` names,
    /// where that is set.
    class LLVM_LINKER is
        /// Links `ll_path` into the executable `output`, throwing
        /// `LinkFailedException` with what `ghul-llvm` said where it fails.
        ///
        /// - ll_path: the module's text
        /// - output: the executable to write
        /// - optimisation_level: the level to optimise at, 0 to 3
        @IF.dotnet()
        link(ll_path: string, output: string, optimisation_level: int) static is
            let start = System.Diagnostics.ProcessStartInfo(_linker)

            for argument in _arguments(ll_path, output, optimisation_level) do
                start.argument_list.add(argument)
            od

            start.redirect_standard_error = true
            start.redirect_standard_output = true
            start.use_shell_execute = false

            let message mut = ""

            try
                let process = System.Diagnostics.Process.start(start)

                if !process? then
                    throw LinkFailedException("ghul-llvm could not be started")
                fi

                let errors = process.standard_error.read_to_end_async()
                let out = process.standard_output.read_to_end()

                process.wait_for_exit()

                if process.exit_code == 0 then
                    return
                fi

                message = "{errors.result}{out}".trim()
            catch e: System.ComponentModel.Win32Exception
                message = e.message
            yrt

            throw LinkFailedException("ghul-llvm failed: {message}")
        si

        /// Links `ll_path` into the executable `output`, throwing
        /// `LinkFailedException` with what `ghul-llvm` said where it fails.
        ///
        /// - ll_path: the module's text
        /// - output: the executable to write
        /// - optimisation_level: the level to optimise at, 0 to 3
        @IF.not.dotnet()
        link(ll_path: string, output: string, optimisation_level: int) static is
            let message mut = ""

            try
                let result = IO.PROCESS.run(_linker, _arguments(ll_path, output, optimisation_level))

                if result.exit_code == 0 then
                    return
                fi

                message = "{result.error}{result.output}".trim()
            catch e: IO.FileNotFoundException
                message = e.message
            yrt

            throw LinkFailedException("ghul-llvm failed: {message}")
        si

        _linker: string static => Driver.COMPILER_ENVIRONMENT.llvm_linker ?? "ghul-llvm"

        _arguments(ll_path: string, output: string, optimisation_level: int) -> Collections.LIST[string] static is
            let result = Collections.LIST[string]()

            result.add(ll_path)

            // ghul-llvm optimises at 2 unless told otherwise.
            if optimisation_level != 2 then
                result.add("-O{optimisation_level}")
            fi

            if let runtime = Driver.COMPILER_ENVIRONMENT.llvm_runtime then
                result.add("-L")
                result.add(runtime)
            fi

            let flags = IoC.CONTAINER.instance.build_flags

            if flags.want_llvm_parallel_gc then
                result.add("--parallel-gc")
            fi

            for input in flags.native_inputs do
                result.add(input)
            od

            for path in flags.native_library_paths do
                result.add("-L")
                result.add(path)
            od

            for library in flags.native_libraries do
                result.add("-l")
                result.add(library)
            od

            result.add("-o")
            result.add(output)

            return result
        si
    si

    /// Thrown where `ghul-llvm` cannot link a module into an executable.
    class LinkFailedException: Ghul.Exception is
        init(message: string) is
            super.init(message)
        si
    si
si
