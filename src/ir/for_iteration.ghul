namespace IR is
    use Values.Value

    /// A `for` loop's iterator held in a local: what the loop iterates and
    /// the calls it makes on the iterator. A target that can walk the
    /// iterated value's storage directly uses it to lower the loop without
    /// an iterator; a target that cannot ignores it.
    class FOR_ITERATION is
        /// The value iterated, which `get_iterator` is called on.
        receiver: Value

        /// The call that makes the iterator.
        get_iterator: Value

        /// The call that moves the iterator on, answering whether there is
        /// an element.
        move_next: Value? public

        /// The call that reads the element the iterator is at.
        current: Value? public

        /// The call that disposes the iterator after the loop, if there is
        /// one: nothing to call where the loop walks the storage instead.
        dispose: Value? public

        init(receiver: Value, get_iterator: Value) is
            self.receiver = receiver
            self.get_iterator = get_iterator
        si
    si
si
