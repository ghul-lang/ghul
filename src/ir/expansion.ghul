namespace IR is
    use Semantic.Types.Type

    use Values

    // Builds the target-neutral IR a composite value expands to: its
    // operands and steps in order, temporaries for anything that has to
    // outlive a branch, and structured nodes for its control flow, so no
    // value is left on the stack across a branch. Nothing built here
    // marks a source position: the composite marks its own.
    class EXPANSION is
        result: BLOCK

        _void_type: Type
        _open: Collections.STACK[BLOCK]

        init(type: Type) is
            result = BLOCK(type)

            _void_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_void_type()
            _open = Collections.STACK[BLOCK]()
            _open.push(result)
        si

        add(value: Value) is
            _open.peek().add(value)
        si

        // Declares a temporary of `type`, named after `prefix`.
        temp(prefix: string, type: Type) -> TEMPORARY is
            let result = TEMPORARY(".{prefix}.{TEMP.get_next_id()}", type)

            add(DECLARE_LOCAL(result.name, type))

            return result
        si

        store(temp: TEMPORARY, value: Value) is
            add(value)
            add(STORE_TEMP(temp.name, temp.type))
        si

        // Opens a region: values added from here until `close` land in
        // it.
        region() -> REGION is
            let result = REGION(IR.LABEL(), _void_type)

            result.clear_position()

            add(result)
            _open.push(result.body)

            return result
        si

        close(region: REGION) is
            assert _open.peek() == region.body else "expansion regions closed out of order"

            _open.pop()

            region.close()
        si

        exit(target: Breakable) is
            _add_exit(BREAK(target, false))
        si

        exit_if(target: Breakable, condition: BRANCH, operand: Value) is
            _add_exit(BREAK(target, condition, operand))
        si

        exit_if(target: Breakable, condition: BRANCH, left: Value, right: Value) is
            _add_exit(BREAK(target, condition, left, right))
        si

        _add_exit(exit: Exit) is
            exit.clear_position()

            add(exit)
        si

        // Encodes an expansion as part of the composite that built it,
        // marking no source positions inside it.
        gen(expansion: BLOCK, context: IR.CONTEXT) static is
            context.begin_unmarked()

            for value in expansion.values do
                value.gen(context)
            od

            context.end_unmarked()
        si
    si

    // A temporary declared by an expansion.
    class TEMPORARY(name: string, type: Type) is
        load() -> Values.Value => Values.Load.TEMP(name, type)
    si
si
