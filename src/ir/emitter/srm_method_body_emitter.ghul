@@IF.dotnet()

namespace IR.Emitter is
    use System.Reflection.Metadata.BlobBuilder
    use System.Reflection.Metadata.EntityHandle
    use System.Reflection.Metadata.Ecma335.InstructionEncoder
    use System.Reflection.Metadata.Ecma335.ControlFlowBuilder
    use System.Reflection.Metadata.Ecma335.LabelHandle
    use System.Reflection.Metadata.ILOpCode

    use Semantic.Types.Type

    use Ghul.Pipes

    use BufferedInstruction.OP
    use BufferedInstruction.TOKEN
    use BufferedInstruction.LOCAL
    use BufferedInstruction.ARGUMENT
    use BufferedInstruction.CONSTANT_I4
    use BufferedInstruction.CONSTANT_I8
    use BufferedInstruction.CONSTANT_R4
    use BufferedInstruction.CONSTANT_R8
    use BufferedInstruction.STRING
    use BufferedInstruction.BRANCH
    use BufferedInstruction.LABEL
    use BufferedInstruction.REGION_BOUNDARY
    use BufferedInstruction.SEQUENCE_POINT
    use BufferedInstruction.OUTPUT_BEGIN
    use BufferedInstruction.OUTPUT_END

    // Instruction-level surface for one method body. The instructions
    // are held until the body is complete, then laid out by
    // CIL_BODY_LAYOUT and encoded with SRM's InstructionEncoder; `flush`
    // hands the encoded body to the owning assembly emitter's method body
    // stream and returns the body offset that AddMethodDefinition takes
    // directly (not a handle).
    //
    // Locals are addressed by name here even though the encoded
    // instructions address them by slot index. Names like `result.0`
    // are invented all over generate-il and the IR values, so taking
    // them as given keeps the slot numbering in one place rather than
    // threading it through every site that declares a local.
    class SRM_METHOD_BODY_EMITTER is
        _body: Collections.LIST[BufferedInstruction]

        // Only looked up, never enumerated: slots are numbered in the
        // order locals are declared.
        _local_slots: Collections.MAP[IR.LOCAL, int]
        _local_types: Collections.LIST[Type]

        // Protected regions, each as the four boundaries that
        // mark_region_boundary numbered, in the order they were added,
        // with the caught type or null for a finally.
        _regions: Collections.LIST[(try_start: int, try_end: int, handler_start: int, handler_end: int, catch_type: EntityHandle?)]
        _boundaries: int

        // Open `@IL.output` regions awaiting their end, so nested regions
        // close innermost-first.
        _il_output_depth: int

        // Whether any handler is entered with the exception already on
        // the stack. See max_stack.
        _has_catch: bool

        // The body as encoded by `flush`.
        _encoding: SRM_BODY_ENCODING?

        init() is
            _body = Collections.LIST[BufferedInstruction]()

            _local_slots = Collections.MAP[IR.LOCAL, int]()
            _local_types = Collections.LIST[Type]()
            _regions = Collections.LIST[(try_start: int, try_end: int, handler_start: int, handler_end: int, catch_type: EntityHandle?)]()
        si

        // Marks the current position and returns a handle on it that
        // `add_catch_region` / `add_finally_region` take. An int rather
        // than the SRM label so the walk that decides where regions
        // begin and end needs no metadata types of its own.
        mark_region_boundary() -> int is
            let boundary = _boundaries

            _boundaries = _boundaries + 1
            _body.add(REGION_BOUNDARY(boundary))

            return boundary
        si

        // Regions must be added innermost first: ECMA-335 requires the
        // ordering and the runtime relies on it, but nothing validates
        // it, so getting it wrong yields an assembly that loads and
        // then runs the wrong handler. Each `try` adds its own region
        // as it closes, which puts an inner one ahead of the outer one
        // that contains it.
        add_catch_region(
            try_start: int,
            try_end: int,
            handler_start: int,
            handler_end: int,
            catch_type: EntityHandle
        ) is
            _has_catch = true

            _regions.add((try_start, try_end, handler_start, handler_end, catch_type))
        si

        add_finally_region(
            try_start: int,
            try_end: int,
            handler_start: int,
            handler_end: int
        ) is
            _regions.add((try_start, try_end, handler_start, handler_end, null))
        si

        mark_label(label: IR.LABEL) is
            _body.add(LABEL(label))
        si

        branch(op_code: ILOpCode, label: IR.LABEL) is
            _body.add(BRANCH(op_code, label))
        si

        // Declaring the same local twice is not an error: at least one
        // value declares its temp on both arms of a branch. The first
        // declaration gives the local its slot.
        declare_local(local: IR.LOCAL) -> int is
            if _local_slots.contains_key(local) then
                return _local_slots[local]
            fi

            let slot = _local_types.count

            _local_types.add(local.type)
            _local_slots[local] = slot

            return slot
        si

        // A load of a local that was never declared means whatever built
        // it did not declare it. Failing here names the local, which is a
        // far shorter path to the culprit than the invalid program it
        // would otherwise produce.
        _slot(local: IR.LOCAL) -> int is
            assert _local_slots.contains_key(local) else
                "local '{local.name}' is loaded but never declared"

            return _local_slots[local]
        si

        has_locals: bool => _local_types.count > 0
        local_types: Type[] => _local_types

        ldloc(local: IR.LOCAL) is _body.add(LOCAL(ILOpCode.LDLOC, _slot(local))); si
        stloc(local: IR.LOCAL) is _body.add(LOCAL(ILOpCode.STLOC, _slot(local))); si
        ldloca(local: IR.LOCAL) is _body.add(LOCAL(ILOpCode.LDLOCA, _slot(local))); si

        ldarg(index: int) is _body.add(ARGUMENT(ILOpCode.LDARG, index)); si
        starg(index: int) is _body.add(ARGUMENT(ILOpCode.STARG, index)); si
        ldarga(index: int) is _body.add(ARGUMENT(ILOpCode.LDARGA, index)); si

        ldstr(metadata: SRM_ASSEMBLY_EMITTER, value: string) is
            _body.add(STRING(metadata.get_or_add_user_string(value)))
        si

        ldc_i4(value: int) is _body.add(CONSTANT_I4(value)); si
        ldc_i8(value: long) is _body.add(CONSTANT_I8(value)); si
        ldc_r4(value: single) is _body.add(CONSTANT_R4(value)); si
        ldc_r8(value: double) is _body.add(CONSTANT_R8(value)); si
        ldnull() is _body.add(OP(ILOpCode.LDNULL)); si

        call(target: EntityHandle) is _token(ILOpCode.CALL, target, true); si

        // Prefixes the following call with the type its receiver is
        // reached through, which is how a call on a value whose type is
        // a type parameter dispatches without the caller knowing whether
        // that parameter will be a value or a reference type.
        constrained(type: EntityHandle) is _token(ILOpCode.CONSTRAINED, type, false); si
        call_virtual(target: EntityHandle) is _token(ILOpCode.CALLVIRT, target, true); si
        new_object(constructor: EntityHandle) is _token(ILOpCode.NEWOBJ, constructor, true); si

        ldfld(`field: EntityHandle) is _token(ILOpCode.LDFLD, `field, false); si
        ldflda(`field: EntityHandle) is _token(ILOpCode.LDFLDA, `field, false); si
        stfld(`field: EntityHandle) is _token(ILOpCode.STFLD, `field, false); si
        ldsfld(`field: EntityHandle) is _token(ILOpCode.LDSFLD, `field, true); si
        ldsflda(`field: EntityHandle) is _token(ILOpCode.LDSFLDA, `field, true); si
        stsfld(`field: EntityHandle) is _token(ILOpCode.STSFLD, `field, false); si

        ldtoken(type: EntityHandle) is _token(ILOpCode.LDTOKEN, type, true); si

        box(type: EntityHandle) is _token(ILOpCode.BOX, type, false); si
        size_of(type: EntityHandle) is _token(ILOpCode.SIZEOF, type, true); si
        unbox_any(type: EntityHandle) is _token(ILOpCode.UNBOX_ANY, type, false); si
        cast_class(type: EntityHandle) is _token(ILOpCode.CASTCLASS, type, false); si
        is_instance(type: EntityHandle) is _token(ILOpCode.ISINST, type, false); si

        new_array(element_type: EntityHandle) is _token(ILOpCode.NEWARR, element_type, false); si
        store_element(element_type: EntityHandle) is _token(ILOpCode.STELEM, element_type, false); si
        load_element(element_type: EntityHandle) is _token(ILOpCode.LDELEM, element_type, false); si
        load_element_address(element_type: EntityHandle) is _token(ILOpCode.LDELEMA, element_type, false); si

        load_object(type: EntityHandle) is _token(ILOpCode.LDOBJ, type, false); si
        store_object(type: EntityHandle) is _token(ILOpCode.STOBJ, type, false); si

        load_function_pointer(method: EntityHandle) is _token(ILOpCode.LDFTN, method, true); si
        load_virtual_function_pointer(method: EntityHandle) is _token(ILOpCode.LDVIRTFTN, method, false); si

        _token(op_code: ILOpCode, handle: EntityHandle, pushes: bool) is
            _body.add(TOKEN(op_code, handle, pushes))
        si

        op(op_code: ILOpCode) is
            _body.add(OP(op_code))
        si

        ret() is _body.add(OP(ILOpCode.RET)); si

        // An upper bound on the evaluation stack depth anywhere in the
        // body, for the header's max stack. The depth only grows at an
        // instruction that pushes more than it pops, and by at most one
        // there. Every path to an instruction arrives at the same depth,
        // so a path that repeats an instruction has come back to the
        // depth it had the first time, and no path can go deeper than
        // one push from each such instruction. A catch handler starts
        // with its exception on the stack, which is one more. Only the
        // instructions that are encoded count.
        //
        // A body that declares a large max stack is never inlined by the
        // JIT, however small it is, so the bound has to be tight for
        // small bodies rather than a generous constant.
        max_stack: int => _encoded_body.pushes + (if _has_catch then 1 else 0 fi)

        // Whether the entry can leave the stack deeper than it found it.
        // A call or newobj can push one more than it pops at most; every
        // instruction not listed pops at least as much as it pushes.
        _pushes(entry: BufferedInstruction) -> bool =>
            case entry
            when op: OP then _is_push(op.op_code)
            when token: TOKEN then token.pushes
            when local: LOCAL then local.op_code != ILOpCode.STLOC
            when argument: ARGUMENT then argument.op_code != ILOpCode.STARG
            when _: CONSTANT_I4 then true
            when _: CONSTANT_I8 then true
            when _: CONSTANT_R4 then true
            when _: CONSTANT_R8 then true
            when _: STRING then true
            else false
            esac

        _is_push(op_code: ILOpCode) -> bool =>
            case op_code
            when
                ILOpCode.LDARG_0, ILOpCode.LDARG_1, ILOpCode.LDARG_2, ILOpCode.LDARG_3,
                ILOpCode.LDARG_S, ILOpCode.LDARG, ILOpCode.LDARGA_S, ILOpCode.LDARGA,
                ILOpCode.LDLOC_0, ILOpCode.LDLOC_1, ILOpCode.LDLOC_2, ILOpCode.LDLOC_3,
                ILOpCode.LDLOC_S, ILOpCode.LDLOC, ILOpCode.LDLOCA_S, ILOpCode.LDLOCA,
                ILOpCode.LDNULL, ILOpCode.LDSTR, ILOpCode.DUP,
                ILOpCode.LDC_I4_M1, ILOpCode.LDC_I4_0, ILOpCode.LDC_I4_1, ILOpCode.LDC_I4_2,
                ILOpCode.LDC_I4_3, ILOpCode.LDC_I4_4, ILOpCode.LDC_I4_5, ILOpCode.LDC_I4_6,
                ILOpCode.LDC_I4_7, ILOpCode.LDC_I4_8, ILOpCode.LDC_I4_S, ILOpCode.LDC_I4,
                ILOpCode.LDC_I8, ILOpCode.LDC_R4, ILOpCode.LDC_R8,
                ILOpCode.LDSFLD, ILOpCode.LDSFLDA, ILOpCode.LDTOKEN, ILOpCode.LDFTN,
                ILOpCode.ARGLIST, ILOpCode.SIZEOF,
                ILOpCode.CALL, ILOpCode.CALLI, ILOpCode.CALLVIRT, ILOpCode.NEWOBJ
            then
                true
            else
                false
            esac

        // Note that the instructions emitted from here on belong to a
        // new source position. Called once per statement.
        mark_sequence_point(location: Source.LOCATION) is
            _body.add(SEQUENCE_POINT(location))
        si

        // An `@IL.output` pragma opens a region whose emitted instructions
        // the IL test runner extracts. Only the byte-offset range is
        // recorded; the ranges leave with the method as a custom
        // attribute written by SRM_STRUCTURE_WALK._write_method.
        begin_il_output(path: string, sequence: int) is
            _il_output_depth = _il_output_depth + 1
            _body.add(OUTPUT_BEGIN(path, sequence))
        si

        end_il_output() is
            assert _il_output_depth > 0 else "IL output region ended but never begun"

            _il_output_depth = _il_output_depth - 1
            _body.add(OUTPUT_END)
        si

        il_outputs: SRM_IL_OUTPUT_RANGE[]? => _encoded_body.il_outputs

        // The body as `flush` encoded it, or as it would be encoded now
        // when it has not been flushed.
        _encoded_body: SRM_BODY_ENCODING => _encoding ?? _encode(true)

        flush(assembly_emitter: SRM_ASSEMBLY_EMITTER) -> int is
            let encoding = _encode(true)

            _encoding = encoding

            let offset = assembly_emitter.add_method_body(encoding.encoder, self)

            if let points = encoding.sequence_points then
                assembly_emitter.set_sequence_points(offset, points)
            fi

            return offset
        si

        // The instruction bytes the body so far encodes to, laid out as
        // `flush` lays it out. Branch offsets are only filled in when the
        // body is flushed, so this is what has been emitted rather than
        // what will be run.
        encoded: ARRAY[ubyte] => _encode(false).encoder.code_builder.to_array()

        _encode(complete: bool) -> SRM_BODY_ENCODING is
            let body = CIL_BODY_LAYOUT.tidy(_body)
            let layout = CIL_BODY_LAYOUT.short_branches(body, (b, s) => _write(b, s, 32, false).offsets)

            // SRM drops the byte after a short branch whose operand is the
            // last byte of one of the code builder's chunks, so the body
            // is encoded into a builder with room for all of it in its
            // first chunk. The last layout measured is at least as long as
            // the final one.
            let encoding = _write(body, layout.short, if layout.size > 32 then layout.size else 32 fi, complete)

            if complete then
                let control_flow = encoding.encoder.control_flow_builder!

                for region in _regions do
                    let try_start = encoding.boundaries[region.try_start]
                    let try_end = encoding.boundaries[region.try_end]
                    let handler_start = encoding.boundaries[region.handler_start]
                    let handler_end = encoding.boundaries[region.handler_end]

                    if let catch_type = region.catch_type then
                        control_flow.add_catch_region(try_start, try_end, handler_start, handler_end, catch_type)
                    else
                        control_flow.add_finally_region(try_start, try_end, handler_start, handler_end)
                    fi
                od
            fi

            return encoding
        si

        // Encodes `body`, with the branches `short` names in their short
        // form, into a code builder whose chunks hold `capacity` bytes. Source positions and `@IL.output` ranges are only
        // collected when `complete`.
        _write(body: Collections.List[BufferedInstruction], short: Collections.List[bool], capacity: int, complete: bool) -> SRM_BODY_ENCODING is
            let encoder = InstructionEncoder(BlobBuilder(capacity), ControlFlowBuilder())

            let labels = Collections.MAP[IR.LABEL, LabelHandle]()
            let boundaries = Collections.LIST[LabelHandle]()
            let offsets = Collections.LIST[int]()

            let sequence_points: Collections.LIST[SRM_SEQUENCE_POINT]? = if complete /\ body |> any(e => isa SEQUENCE_POINT(e)) then Collections.LIST[SRM_SEQUENCE_POINT]() else null fi
            let il_outputs: Collections.LIST[SRM_IL_OUTPUT_RANGE]? = if complete /\ body |> any(e => isa OUTPUT_BEGIN(e)) then Collections.LIST[SRM_IL_OUTPUT_RANGE]() else null fi
            let open_outputs = Collections.LIST[(path: string, start: int, sequence: int)]()

            let pushes mut = 0

            // A label can be branched to before it is marked, so the
            // handle is defined on first mention from either side and
            // the encoder patches the offsets in when the body is
            // serialized.
            //
            // Keyed on the label itself. Label ids restart per pass and per
            // class, and labels are also made while a body is encoded, so
            // neither an id nor a rendered name tells two labels apart: a
            // shared key merges two labels into one handle, and a branch
            // then lands wherever the other label was marked. The map is
            // only looked up, never enumerated, and handles are defined in
            // order of first mention, so the label's hash code never reaches
            // the output.
            let handle_for = (label: IR.LABEL) -> LabelHandle is
                if labels.contains_key(label) then
                    return labels[label]
                fi

                let handle = encoder.define_label()

                labels[label] = handle

                return handle
            si

            for i in 0..body.count do
                let entry = body[i]

                offsets.add(encoder.offset)

                if _pushes(entry) then
                    pushes = pushes + 1
                fi

                case entry
                when op: OP then encoder.op_code(op.op_code)
                when token: TOKEN then
                    encoder.op_code(token.op_code)
                    encoder.token(token.handle)
                when local: LOCAL then
                    case local.op_code
                    when ILOpCode.LDLOC then encoder.load_local(local.slot)
                    when ILOpCode.STLOC then encoder.store_local(local.slot)
                    else encoder.load_local_address(local.slot)
                    esac
                when argument: ARGUMENT then
                    case argument.op_code
                    when ILOpCode.LDARG then encoder.load_argument(argument.index)
                    when ILOpCode.STARG then encoder.store_argument(argument.index)
                    else encoder.load_argument_address(argument.index)
                    esac
                when constant: CONSTANT_I4 then encoder.load_constant_i4(constant.value)
                when constant: CONSTANT_I8 then encoder.load_constant_i8(constant.value)
                when constant: CONSTANT_R4 then encoder.load_constant_r4(constant.value)
                when constant: CONSTANT_R8 then encoder.load_constant_r8(constant.value)
                when string_value: STRING then encoder.load_string(string_value.handle)
                when branch: BRANCH then
                    let op_code =
                        if short[i] then
                            CIL_BODY_LAYOUT.short_form(branch.op_code)!
                        else
                            branch.op_code
                        fi

                    encoder.branch(op_code, handle_for(branch.target))
                when label: LABEL then encoder.mark_label(handle_for(label.label))
                when boundary: REGION_BOUNDARY then
                    let handle = encoder.define_label()

                    encoder.mark_label(handle)

                    assert boundary.boundary == boundaries.count else "region boundary {boundary.boundary} out of order"

                    boundaries.add(handle)
                when point: SEQUENCE_POINT then
                    if let points = sequence_points then
                        _add_sequence_point(points, encoder.offset, point.location)
                    fi
                when begin: OUTPUT_BEGIN then
                    open_outputs.add((begin.path, encoder.offset, begin.sequence))
                when _: OUTPUT_END then
                    let top = open_outputs[open_outputs.count - 1]

                    open_outputs.remove_at(open_outputs.count - 1)

                    if let outputs = il_outputs then
                        outputs.add(SRM_IL_OUTPUT_RANGE(top.path, top.start, encoder.offset, top.sequence))
                    fi
                esac
            od

            offsets.add(encoder.offset)

            return SRM_BODY_ENCODING(encoder, offsets, boundaries, pushes, sequence_points, il_outputs)
        si

        _add_sequence_point(points: Collections.LIST[SRM_SEQUENCE_POINT], offset: int, location: Source.LOCATION) is
            // Two statements can start at the same offset when the
            // first emits nothing. A sequence-point record after the
            // first has to advance the offset - a zero delta is the
            // document-change marker - so the later position replaces
            // the earlier rather than being appended after it.
            if points.count > 0 /\ points[points.count - 1].il_offset == offset then
                points.remove_at(points.count - 1)
            fi

            points.add(
                SRM_SEQUENCE_POINT(
                    offset,
                    IO.Path.get_full_path(location.file_name),
                    location.start_line,
                    location.start_column,
                    location.end_line,
                    // A sequence point's end column is exclusive, and a
                    // LOCATION's is not.
                    location.end_column + 1))
        si
    si

    // A method body as encoded: the encoder holding it, the offset of
    // each entry of the laid-out body and of its end, the handles of the
    // region boundaries, the instructions that can deepen the stack, and
    // the source positions and `@IL.output` ranges when they were asked
    // for.
    class SRM_BODY_ENCODING(
        encoder: InstructionEncoder,
        offsets: Collections.List[int],
        boundaries: Collections.List[LabelHandle],
        pushes: int,
        sequence_points: SRM_SEQUENCE_POINT[]?,
        il_outputs: SRM_IL_OUTPUT_RANGE[]?
    )
si
