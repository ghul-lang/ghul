@@IF.dotnet()

namespace IR.Emitter is
    use Semantic.Symbols.Field
    use Semantic.Symbols.Function

    // One type in the plan, with the members it was numbered for.
    class SRM_PLANNED_TYPE(
        type: SRM_EMITTED_TYPE,
        fields: Field[],
        methods: Function[]
    )

    // The sequence the numbering pass assigned rows to.
    //
    // Both passes used to derive that sequence from the symbol table
    // independently, which is only sound while the table does not
    // change between them. It does: compiling a state machine's body
    // declares the frame fields that body needs, and the numbering pass
    // has already run by then. A member appearing in between is
    // numbered by neither pass and written by one, so the type's member
    // run comes out longer than its successor's first-row pointer
    // assumed — and run-style tables are not validated, so the assembly
    // loads with members reparented onto the wrong type.
    //
    // Recording the sequence makes the second pass replay the first
    // rather than independently agree with it. A member declared too
    // late is then absent rather than misplaced, and absent says so:
    // it has no row, so the first reference to it fails.
    class SRM_EMISSION_PLAN is
        _types: Collections.LIST[SRM_PLANNED_TYPE]

        init() is
            _types = Collections.LIST[SRM_PLANNED_TYPE]()
        si

        types: SRM_PLANNED_TYPE[] => _types

        add(
            type: SRM_EMITTED_TYPE,
            fields: Field[],
            methods: Function[]
        ) is
            _types.add(SRM_PLANNED_TYPE(type, fields, methods))
        si
    si
si
