namespace IR.Emitter is
    use System.Reflection.Metadata.ILOpCode

    use IR.Values.Value
    use IR.Values.Visitor

    // A value only the CIL lowering makes, which writes its own
    // instructions: an instruction, label or branch that structured
    // control flow is lowered to, or the boundary of a protected region.
    class CIL_VALUE: Value abstract is
        init() is
            super.init()
        si

        accept(visitor: Visitor) is
            if let lowering: CIL_LOWERING = visitor then
                gen(lowering.context)
            else
                super.accept(visitor)
            fi
        si

        gen(context: CIL_CONTEXT)
    si

    // A single operand-less IL instruction.
    class INSTRUCTION: CIL_VALUE is
        op_code: ILOpCode

        init(op_code: ILOpCode) is
            super.init()

            self.op_code = op_code
        si

        gen(context: IR.Emitter.CIL_CONTEXT) is
            context.current_srm_body_emitter!.op(op_code)
        si

        to_string() -> string => "{op_code}"
    si

    // Marks the position a branch names.
    class MARK_LABEL: CIL_VALUE is
        label: IR.LABEL

        init(label: IR.LABEL) is
            super.init()

            self.label = label
        si

        gen(context: IR.Emitter.CIL_CONTEXT) is
            let body = context.current_srm_body_emitter!
                body.mark_label(label)
        si

        to_string() -> string => "{label}:"
    si

    // A branch to a label.
    //
    // The long-form opcode is not the final encoding: the encoder
    // narrows it to the short form once the eventual offset is known.
    class BRANCH_TO: CIL_VALUE is
        op_code: ILOpCode
        label: IR.LABEL

        init(op_code: ILOpCode, label: IR.LABEL) is
            super.init()

            self.op_code = op_code
            self.label = label
        si

        gen(context: IR.Emitter.CIL_CONTEXT) is
            context.current_srm_body_emitter!.branch(op_code, label)
        si

        to_string() -> string => "{op_code} {label}"
    si
si
