namespace IR.Emitter is
    // Lowers IR values to CIL, through the method body emitter of the
    // function being generated.
    //
    // A cast of a value's symbol to the kind the value was built for is
    // a checked construction invariant: a throw means the value was
    // built with the wrong kind of symbol.
    @suppress("cast-may-throw")
    class CIL_LOWERING: Values.Visitor is
        _context: IR.Emitter.CIL_CONTEXT

        context: CIL_CONTEXT => _context

        _body: SRM_METHOD_BODY_EMITTER => _context.current_srm_body_emitter!

        _async: CIL_ASYNC_LOWERING

        init(context: IR.Emitter.CIL_CONTEXT) is
            _context = context
            _async = CIL_ASYNC_LOWERING(context)
        si

        visit_value(value: Values.Value) is
            throw System.NotImplementedException("no lowering for {value.get_type()} {value}")
        si

        visit_address_of_value(value: Values.Value) is
            throw System.NotImplementedException("no address lowering for {value.get_type()} {value}")
        si

        gen(value: Values.Value?) is
            if value? then
                value.accept(self)
            else
                _context.fixme("null value")
            fi
        si

        gen_address(value: Values.Value) is
            value.accept_address(self)
        si

        // Lowers an operand as a block lowers each of its values,
        // marking its source position first.
        gen_marked(value: Values.Value) is
            if value.has_location then
                _context.mark_location(value.location)
            fi

            gen(value)
        si

        // Marks the position `value` was built at, after its operands.
        mark_operator(value: Values.Value) is
            if let location = value.operator_location then
                _context.mark_location(location)
            fi
        si

        _field(symbol: Semantic.Symbols.Symbol) -> System.Reflection.Metadata.EntityHandle =>
            _context.resolve_field_target(cast Semantic.Symbols.Field(symbol))

        visit(number: IR.Values.Literal.NUMBER) is
            let body = _body

            case number.constant
            when i4: IR.Values.Literal.CONSTANT.I4 then body.ldc_i4(i4.value)
            when i8: IR.Values.Literal.CONSTANT.I8 then body.ldc_i8(i8.value)
            when r4: IR.Values.Literal.CONSTANT.R4 then body.ldc_r4(r4.value)
            when r8: IR.Values.Literal.CONSTANT.R8 then body.ldc_r8(r8.value)
            esac

            if let to = number.narrowing then
                let from =
                    case number.constant
                    when _: IR.Values.Literal.CONSTANT.I4 then Scalar.INT32
                    when _: IR.Values.Literal.CONSTANT.I8 then Scalar.INT64
                    when _: IR.Values.Literal.CONSTANT.R4 then Scalar.FLOAT32
                    when _: IR.Values.Literal.CONSTANT.R8 then Scalar.FLOAT64
                    esac

                for op_code in CIL_OPERATIONS.conversion(from, to) do
                    body.op(op_code)
                od
            fi
        si

        visit(string: IR.Values.Literal.STRING) is
            _body.ldstr(_context.srm_assembly_emitter, string.value)
        si

        visit(decimal: IR.Values.Literal.DECIMAL) is
            let body = _body

            body.ldc_i4(decimal.lo)
            body.ldc_i4(decimal.mid)
            body.ldc_i4(decimal.hi)
            body.ldc_i4(0)
            body.ldc_i4(decimal.scale)
            body.new_object(_context.resolve_decimal_constructor())
        si

        visit(bigint: IR.Values.Literal.BIGINT) is
            let body = _body

            if bigint.fits_long then
                body.ldc_i8(bigint.as_long)
                body.new_object(_context.resolve_bigint_constructor(bigint.type))
            else
                body.ldstr(_context.srm_assembly_emitter, bigint.value)
                body.call(_context.resolve_bigint_parse(bigint.type))
            fi
        si

        visit(load: Values.Load.TEMP) is
            _body.ldloc(load.local)
        si

        visit_address(load: Values.Load.TEMP) is
            _body.ldloca(load.local)
        si

        visit(load: Values.Load.STATIC_FIELD) is
            _body.ldsfld(_field(load.symbol))
        si

        visit_address(load: Values.Load.STATIC_FIELD) is
            _body.ldsflda(_field(load.symbol))
        si

        visit(load: Values.Load.GLOBAL_FIELD) is
            _body.ldsfld(_field(load.symbol))
        si

        visit_address(load: Values.Load.GLOBAL_FIELD) is
            _body.ldsflda(_field(load.symbol))
        si

        // A generator's arguments live in fields of its state-machine
        // frame, and an argument spread out of a pack in a local of its
        // own.
        visit(load: Values.Load.LOCAL_ARGUMENT) is
            let symbol = load.symbol

            if let state_machine_field = Values.state_machine_field_for(symbol) then
                _body.ldarg(0)
                _body.ldfld(_context.resolve_field_target(state_machine_field))
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _body.ldloc(packed_local)
            else
                _body.ldarg(_context.resolve_argument_index(symbol))
            fi

            _narrow_guard(load.snapshot_type)
        si

        visit_address(load: Values.Load.LOCAL_ARGUMENT) is
            let symbol = load.symbol

            if let state_machine_field = Values.state_machine_field_for(symbol) then
                _body.ldarg(0)
                _body.ldflda(_context.resolve_field_target(state_machine_field))
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _body.ldloca(packed_local)
            else
                _body.ldarga(_context.resolve_argument_index(symbol))
            fi
        si

        // A generator's locals live in fields of its state-machine frame.
        visit(load: Values.Load.LOCAL_VARIABLE) is
            if let state_machine_field = Values.state_machine_field_for(load.symbol) then
                _body.ldarg(0)
                _body.ldfld(_context.resolve_field_target(state_machine_field))
            else
                _body.ldloc((cast Semantic.Symbols.Variable(load.symbol)).ir_local)
            fi

            _narrow_guard(load.snapshot_type)
        si

        visit_address(load: Values.Load.LOCAL_VARIABLE) is
            if let state_machine_field = Values.state_machine_field_for(load.symbol) then
                _body.ldarg(0)
                _body.ldflda(_context.resolve_field_target(state_machine_field))
            else
                _body.ldloca((cast Semantic.Symbols.Variable(load.symbol)).ir_local)
            fi
        si

        visit(load: Values.Load.ARGUMENT_SLOT) is
            _body.ldarg(load.index)
        si

        visit(store: Values.Store.LOCAL_VARIABLE) is
            if let state_machine_field = Values.state_machine_field_for(store.symbol) then
                _body.ldarg(0)
                gen(store.value)
                _body.stfld(_context.resolve_field_target(state_machine_field))
            else
                gen(store.value)
                _body.stloc((cast Semantic.Symbols.Variable(store.symbol)).ir_local)
            fi
        si

        visit(store: Values.Store.LOCAL_ARGUMENT) is
            let symbol = store.symbol

            if let state_machine_field = Values.state_machine_field_for(symbol) then
                _body.ldarg(0)
                gen(store.value)
                _body.stfld(_context.resolve_field_target(state_machine_field))
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                gen(store.value)
                _body.stloc(packed_local)
            else
                gen(store.value)
                _body.starg(_context.resolve_argument_index(symbol))
            fi
        si

        visit(store: Values.Store.STATIC_FIELD) is
            gen(store.value)
            _body.stsfld(_field(store.symbol))
        si

        visit(store: Values.Store.GLOBAL_FIELD) is
            gen(store.value)
            _body.stsfld(_field(store.symbol))
        si

        visit(store: Values.Store.INSTANCE_FIELD) is
            gen(store.from)
            gen(store.value)
            _body.stfld(_field(store.symbol))
        si

        // A load of a symbol with no lowering of its own.
        visit(load: Values.Load.SYMBOL) is
            gen(load.from)
            _context.fixme("load member {load.symbol.qualified_name}")
        si

        visit_address(load: Values.Load.SYMBOL) is
            gen(load.from)
            _context.fixme("load member address {load.symbol.qualified_name}")
        si

        visit(load: Values.Load.INSTANCE_FIELD) is
            gen(load.from)
            _body.ldfld(_field(load.symbol))
        si

        // `ldflda` takes the containing instance: the reference for a
        // reference-type receiver, a managed pointer for a value-type
        // one. Taking a reference receiver's address would compute the
        // field's offset from the local holding the reference.
        visit_address(load: Values.Load.INSTANCE_FIELD) is
            let from = load.from!

            if from.is_value_type then
                gen_address(from)
            else
                gen(from)
            fi

            _body.ldflda(_field(load.symbol))
        si

        visit(load: Values.Load.STATIC_ANONYMOUS_FUNCTION) is
            _body.ldnull()
            _load_delegate(load.symbol, load.func_type)
        si

        visit(load: Values.Load.GLOBAL_ANONYMOUS_FUNCTION) is
            _body.ldnull()
            _load_delegate(load.symbol, load.func_type)
        si

        visit(load: Values.Load.INSTANCE_ANONYMOUS_FUNCTION) is
            _body.ldarg(0)
            _load_delegate(load.symbol, load.func_type)
        si

        _load_delegate(function: Semantic.Symbols.Symbol, delegate_type: Semantic.Types.Type) is
            _body.load_function_pointer(_context.resolve_call_target(cast Semantic.Symbols.Function(function)))
            _body.new_object(_context.resolve_delegate_constructor(delegate_type))
        si

        visit(load: Values.Load.FUNCTION_POINTER) is
            let target = _context.resolve_call_target(cast Semantic.Symbols.Function(load.symbol))

            if load.is_virtual then
                _body.load_virtual_function_pointer(target)
            else
                _body.load_function_pointer(target)
            fi
        si

        // A store to a symbol with no lowering of its own.
        visit(store: Values.Store.SYMBOL) is
            gen(store.from)
            gen(store.value)

            throw System.NotImplementedException(
                "the binary back end has no emission for storing to '{store.symbol}' yet")
        si

        _lower_all(values: Collections.Iterable[Values.Value]) is
            for value in values do
                gen(value)
            od
        si

        visit(call: Values.Call.GLOBAL) is
            _lower_all(call.arguments)
            _body.call(_context.resolve_call_target(call.function))
        si

        // A static interface member reached through a type parameter,
        // or through the type an interface is instantiated at, takes
        // the `constrained.` prefix.
        visit(call: Values.Call.STATIC) is
            _lower_all(call.arguments)

            if let receiver = call.constrained_receiver then
                _body.constrained(_context.resolve_type_token(receiver))
            fi

            _body.call(_context.resolve_call_target(call.function))
        si

        visit(call: Values.Call.STRUCT) is
            gen(call.from)
            _lower_all(call.arguments)
            _body.call(_context.resolve_call_target(call.function))
        si

        visit(call: Values.Call.INSTANCE) is
            let from = call.from

            gen(from)
            _lower_all(call.arguments)

            if let constrained: Values.CONSTRAINED = from then
                constrained_prefix(constrained)
            fi

            let target = _context.resolve_call_target(call.function)

            if from.is_super \/ !call.function.is_virtual then
                _body.call(target)
            else
                _body.call_virtual(target)
            fi
        si

        // A function type still carrying an inference placeholder means
        // inference never settled and nothing upstream reported it.
        // Encoding the signature would fail inside the emitter as an
        // opaque internal error, so report a located diagnostic instead
        // and leave the call unemitted.
        visit(call: Values.Call.CLOSURE) is
            let func_type = call.func_type

            if IR.Emitter.CIL_CONTEXT.contains_sentinel(func_type) then
                _context.report_unresolved_type(call.location, func_type!)
                return
            fi

            gen(call.from)
            _lower_all(call.arguments)

            _body.call_virtual(
                _context.resolve_delegate_invoke(func_type!, call.arguments.count, call.is_action))
        si

        // A built-in operation is lowered to the values that implement
        // it the first time it is generated.
        visit(call: Values.Call.INNATE) is
            if !call.is_lowered then
                gen(call.lower())
            fi
        si

        visit(node: Values.Breakable) is
            assert node.is_closed else "structured node generated before it was closed"

            STRUCTURED_LOWERING.gen(node, _context)
        si

        visit(exit: Values.Exit) is
            STRUCTURED_LOWERING.gen(exit, _context)
        si

        visit(dispatch: Values.DISPATCH) is
            STRUCTURED_LOWERING.gen(dispatch, _context)
        si

        visit(resume: Values.RESUME_POINT) is
            STRUCTURED_LOWERING.gen(resume, _context)
        si

        visit(composite: Values.Composite) is
            gen_expansion(composite.expand())
        si

        // A coalesced load has no storage of its own to take the address
        // of, so its value is spilled to a local first.
        visit_address(coalesce: Values.COALESCE_LOAD) is
            let local = IR.LOCAL(".coalesce.{TEMP.get_next_id()}", coalesce.type)

            _body.declare_local(local)
            gen(coalesce)
            _body.stloc(local)
            _body.ldloca(local)
        si

        // Pushes the operand of a runtime type test as the object
        // reference isinst and castclass expect; see TYPE_TEST_OPERAND.
        _type_test_operand(value: Values.Value) is
            let chosen = Values.TYPE_TEST_OPERAND.mode(value)

            if chosen == Values.TypeTestOperandMode.UNWRAP_MAYBE then
                gen_expansion(Values.TYPE_TEST_OPERAND.expand_maybe(value, cast Semantic.Types.MAYBE(value.type)))

                return
            fi

            gen(value)

            if chosen == Values.TypeTestOperandMode.BOX then
                _body.box(_context.resolve_type_token(value.type!))
            elif chosen == Values.TypeTestOperandMode.BOX_TYPE_VARIABLE then
                _body.box(_context.resolve_type_token(value.type!.type_variable_side!))
            fi
        si

        // A value type reached through a wider slot is boxed there, so
        // the check and the unboxing are the same instruction.
        _narrow_guard(narrowed: Semantic.Types.Type?) is
            if !Values.NARROW_GUARD.is_needed(narrowed) then
                return
            fi

            if narrowed!.is_value_type then
                _body.unbox_any(_context.resolve_type_token(narrowed!))
            else
                _body.cast_class(_context.resolve_type_token(narrowed!))
            fi
        si

        // Encodes an expansion as part of the composite that built it,
        // marking no source positions for the structure inside it.
        gen_expansion(expansion: Values.BLOCK) is
            _context.begin_unmarked()

            for value in expansion.values do
                gen(value)
            od

            _context.end_unmarked()
        si

        _type_token(type: Semantic.Types.Type) -> System.Reflection.Metadata.EntityHandle =>
            _context.resolve_type_token(type)

        visit(null_value: Values.NULL) is
            _body.ldnull()
        si

        visit(box: Values.BOX) is
            gen(box.value)
            _body.box(_type_token(box.type!))
        si

        visit(unbox: Values.UNBOX) is
            gen(unbox.value)
            _body.unbox_any(_type_token(unbox.type!))
        si

        visit(conversion: Values.CAST) is
            _type_test_operand(conversion.value)

            if conversion.faults_on_failure then
                _body.cast_class(_type_token(conversion.type))
            else
                _body.is_instance(_type_token(conversion.type))
            fi
        si

        visit(test: Values.ISA) is
            _type_test_operand(test.value)

            _body.is_instance(_type_token(test.isa_type))
            _body.ldnull()
            _body.op(System.Reflection.Metadata.ILOpCode.CGT_UN)
        si

        visit(type_of: Values.TYPEOF) is
            _body.ldtoken(_type_token(type_of.typeof_type))
            _body.call(_context.resolve_get_type_from_handle())
        si

        visit(tuple: Values.TUPLE) is
            _lower_all(tuple.values)
            _body.new_object(_context.resolve_generic_constructor(tuple.type, tuple.values.count))
        si

        // A unit variant is a single shared instance. Which one to load
        // follows from the value's own type rather than from wherever the
        // constructor was found: for a generic variant the type names the
        // instantiation, while the constructor's owner is the open
        // definition, whose parameters an imported variant does not even
        // declare.
        visit(construction: Values.NEW) is
            if construction.constructor.owner!.is_unit_variant then
                _body.ldsfld(_context.resolve_unit_variant_instance(construction.type.symbol))

                return
            fi

            _lower_all(construction.arguments)
            _body.new_object(_context.resolve_call_target(construction.constructor))
        si

        visit(negation: Values.NOT) is
            if negation.is_operator then
                gen_marked(negation.value)
                mark_operator(negation)
            else
                gen(negation.value)
            fi

            _body.ldc_i4(0)
            _body.op(System.Reflection.Metadata.ILOpCode.CEQ)
        si

        visit(arithmetic: Values.ARITHMETIC) is
            for operand in arithmetic.operands do
                if arithmetic.is_marked then
                    gen_marked(operand)
                else
                    gen(operand)
                fi
            od

            if arithmetic.is_marked then
                mark_operator(arithmetic)
            fi

            _body.op(CIL_OPERATIONS.arithmetic(arithmetic.operation))
        si

        visit(compare: Values.COMPARE) is
            gen_marked(compare.left)
            gen_marked(compare.right)

            mark_operator(compare)

            let (op_code, negates) = CIL_OPERATIONS.comparison(compare.comparison, compare.is_unsigned)

            _body.op(op_code)

            if negates then
                _body.ldc_i4(0)
                _body.op(System.Reflection.Metadata.ILOpCode.CEQ)
            fi
        si

        visit(convert: Values.CONVERT) is
            gen(convert.value)

            for op_code in CIL_OPERATIONS.conversion(convert.from, convert.to) do
                _body.op(op_code)
            od
        si

        visit(declaration: Values.DECLARE_LOCAL) is
            _body.declare_local(declaration.local)
        si

        visit(store: Values.STORE_TEMP) is
            _body.stloc(store.local)
        si

        visit(tee: Values.TEE_TEMP) is
            gen_marked(tee.value)
            mark_operator(tee)

            _body.op(System.Reflection.Metadata.ILOpCode.DUP)
            _body.stloc(tee.local)
        si

        visit(discard: Values.DISCARD) is
            if let value = discard.value then
                gen_marked(value)
            fi

            mark_operator(discard)

            _body.op(System.Reflection.Metadata.ILOpCode.POP)
        si

        visit(thrown: Values.THROW) is
            if let exception = thrown.exception then
                gen_marked(exception)
            fi

            mark_operator(thrown)

            _body.op(System.Reflection.Metadata.ILOpCode.THROW)
        si

        visit(ret: Values.RET) is
            _body.ret()
        si

        // A fresh local of the return type, never assigned.
        visit(default_return: Values.DEFAULT_RETURN) is
            let local = IR.LOCAL(".default", default_return.type)

            _body.declare_local(local)
            _body.ldloc(local)
        si

        // The default of a type is what a fresh local of it holds.
        visit(default_value: Values.DEFAULT) is
            let local = IR.LOCAL(".default.{IR.TEMP.get_next_id()}", default_value.type)

            _body.declare_local(local)
            _body.ldloc(local)
        si

        visit_address(default_value: Values.DEFAULT) is
            let local = IR.LOCAL(".default.{IR.TEMP.get_next_id()}", default_value.type)

            _body.declare_local(local)
            _body.ldloca(local)
        si

        visit(deref: Values.DEREF) is
            gen(deref.value)
            _body.load_object(_type_token(deref.type))
        si

        visit_address(deref: Values.DEREF) is
            gen(deref.value)
        si

        // A value with no address of its own is copied into a local
        // whose address is taken instead.
        visit(address: Values.ADDRESS) is
            let value = address.value

            if value.has_address then
                gen_address(value)

                return
            fi

            if !address.local? then
                address.local = IR.LOCAL(Values.ADDRESS.next_name, address.type)
            fi

            let local = address.local!

            _body.declare_local(local)
            gen(value)
            _body.stloc(local)
            _body.ldloca(local)
        si

        visit_address(address: Values.ADDRESS) is
            visit(address)
        si

        visit(steps: Values.STEPS) is
            _lower_all(steps.steps)
        si

        visit(decrement: Values.DECREMENT) is
            _body.ldloc(decrement.counter)
            _body.ldc_i4(1)
            _body.op(System.Reflection.Metadata.ILOpCode.SUB)
            _body.stloc(decrement.counter)
        si

        // Leaves the counter's value before the increment.
        visit(increment: Values.POST_INCREMENT) is
            _body.ldloc(increment.counter)
            _body.ldloc(increment.counter)
            _body.ldc_i4(1)
            _body.op(System.Reflection.Metadata.ILOpCode.ADD)
            _body.stloc(increment.counter)
        si

        // Leaves the counter's value after the decrement.
        visit(decrement: Values.PRE_DECREMENT) is
            _body.ldloc(decrement.counter)
            _body.ldc_i4(1)
            _body.op(System.Reflection.Metadata.ILOpCode.SUB)
            _body.op(System.Reflection.Metadata.ILOpCode.DUP)
            _body.stloc(decrement.counter)
        si

        visit(repack: Values.TUPLE_REPACK) is
            _body.declare_local(repack.temp)
            gen(repack.source)
            _body.stloc(repack.temp)
            gen(repack.built)
        si

        // The subject is already on the stack, left by the wrap around
        // the arm this value is built for.
        visit(spilled: Values.SPILLED_SUBJECT) is
            _body.declare_local(spilled.temp)
            _body.stloc(spilled.temp)
            gen(spilled.built)
        si

        visit(address: Values.ARRAY_ELEMENT_ADDRESS) is
            gen(address.array)
            gen(address.index)
            _body.load_element_address(_type_token(address.element_type))
        si

        visit_address(address: Values.ARRAY_ELEMENT_ADDRESS) is
            visit(address)
        si

        visit(array: Values.NEW_ARRAY) is
            gen(array.count)
            _body.new_array(_type_token(array.element_type))
        si

        visit(store: Values.STORE_ARRAY_ELEMENT) is
            gen(store.array)
            gen(store.index)
            gen(IoC.CONTAINER.instance.value_boxer.box_if_needed(store.element, store.element_type))
            _body.store_element(_type_token(store.element_type))
        si

        visit(sequence: Values.SEQUENCE) is
            let boxer = IoC.CONTAINER.instance.value_boxer
            let element = _type_token(sequence.element_type)
            let values = sequence.values

            _body.ldc_i4(values.count)
            _body.new_array(element)

            for i in 0..values.count do
                _body.op(System.Reflection.Metadata.ILOpCode.DUP)
                _body.ldc_i4(i)

                gen(boxer.box_if_needed(values[i], sequence.element_type))

                _body.store_element(element)
            od
        si

        visit(compare: Values.COMPARE_ORDER_TO_ZERO) is
            let (op_code, negates) = CIL_OPERATIONS.comparison(compare.comparison, false)

            gen(compare.value)

            _body.ldc_i4(0)
            _body.op(op_code)

            if negates then
                _body.ldc_i4(0)
                _body.op(System.Reflection.Metadata.ILOpCode.CEQ)
            fi
        si

        visit(receiver: Values.CONSTRAINED) is
            gen(receiver.value)
        si

        // The `constrained.` prefix a call through `receiver` takes,
        // immediately before its `callvirt`.
        constrained_prefix(receiver: Values.CONSTRAINED) is
            _body.constrained(_type_token(receiver.type!))
        si

        // Decimal's operators are its own static members.
        visit(arithmetic: Values.DECIMAL_ARITHMETIC) is
            for operand in arithmetic.operands do
                gen_marked(operand)
            od

            mark_operator(arithmetic)

            _call_decimal(CIL_OPERATIONS.decimal_arithmetic(arithmetic.operation), arithmetic.operands.count, arithmetic.type)
        si

        visit(compare: Values.DECIMAL_COMPARE) is
            gen_marked(compare.left)
            gen_marked(compare.right)

            mark_operator(compare)

            _call_decimal(CIL_OPERATIONS.decimal_comparison(compare.comparison), 2, compare.type)
        si

        _call_decimal(method_name: string, operand_count: int, return_type: Semantic.Types.Type) is
            let decimal_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_decimal_type()
            let parameter_types = Collections.LIST[Semantic.Types.Type]()

            for i in 0..operand_count do
                parameter_types.add(decimal_type)
            od

            _body.call(_context.resolve_decimal_method(method_name, parameter_types, return_type))
        si

        visit(convert: Values.DECIMAL_CONVERT) is
            gen(convert.value)

            let conversion = IoC.CONTAINER.instance.value_converter.get_decimal_conversion(convert.from, convert.type)!

            let parameter_types = Collections.LIST[Semantic.Types.Type]()

            parameter_types.add(conversion.parameter_type)

            _body.call(_context.resolve_decimal_method(conversion.method_name, parameter_types, convert.type))
        si

        visit(equality: Values.EQUALITY_COMPARISON) is
            _body.call(_context.resolve_equality_comparer_default(equality.comparer_type))

            gen(equality.left)
            gen(equality.right)

            _body.call_virtual(_context.resolve_equality_comparer_equals(equality.comparer_type))
        si

        visit(test: Values.HAS_VALUE) is
            gen(test.value)

            _body.ldnull()
            _body.op(System.Reflection.Metadata.ILOpCode.CGT_UN)
        si

        // Calling GetType through the reference faults on null, and
        // nothing else; the reference itself is left in place.
        visit(check: Values.REFERENCE_NULL_CHECK) is
            gen(check.inner)

            _body.op(System.Reflection.Metadata.ILOpCode.DUP)
            _body.call_virtual(_context.resolve_object_get_type())
            _body.op(System.Reflection.Metadata.ILOpCode.POP)
        si

        visit(conversion: Values.SCALAR_CONVERSION) is
            gen(conversion.converted)
        si

        visit(dummy: Values.DUMMY) is
            IoC.CONTAINER.instance.logger.poison(dummy.location, "generated dummy value: {dummy.type} from {dummy.location}")
            _context.fixme("dummy {dummy.type} from {dummy.location}")
        si

        visit(type_expression: Values.TYPE_EXPRESSION) is
            IoC.CONTAINER.instance.logger.poison(type_expression.location, "generated type expression: {type_expression.type} from {type_expression.location}")
            _context.fixme("type expression {type_expression.type} from {type_expression.location}")
        si

        visit(store: Values.Need.STORE) is
            gen(store.value)

            assert false else "unresolved need store"
        si

        visit(store: Values.Store.INDIRECT) is
            gen(store.address)
            gen(store.value)
            _body.store_object(_type_token(store.type))
        si

        visit(wrapper: Values.TYPE_WRAPPER) is
            gen(wrapper.value)
        si

        visit_address(wrapper: Values.TYPE_WRAPPER) is
            gen_address(wrapper.value)
        si

        visit(wrapper: Values.WRAPPER) is
            assert wrapper.value? else "generate wrapper without value"

            gen(wrapper.value)
        si

        visit_address(wrapper: Values.WRAPPER) is
            assert wrapper.value? else "generate wrapper without value"

            gen_address(wrapper.value)
        si

        visit(wrap: Values.WRAP_OPTIONAL) is
            gen(wrap.value)
            _body.new_object(_context.resolve_generic_constructor(wrap.type, 1))
        si

        visit(projection: Values.NARROW_PROJECT) is
            gen(projection.projected)

            _narrow_guard(projection.type)
        si

        visit(view: Values.NARROW_VIEW) is
            gen(view.underlying)

            _narrow_guard(view.type)
        si

        visit_address(view: Values.NARROW_VIEW) is
            gen_address(view.underlying)
        si

        // Records the offset range the marked statement emits. The range
        // leaves the method as a custom attribute the IL test runner
        // reads. Outside a body there is no range to record: a pragma on
        // a declaration marks nothing this can measure.
        visit(enter: Values.ENTER_FILE) is
            if let body = _context.current_srm_body_emitter then
                body.begin_il_output(enter.path, _context.next_il_output_sequence())
            fi
        si

        visit(leave: Values.LEAVE_FILE) is
            if let body = _context.current_srm_body_emitter then
                body.end_il_output()
            fi
        si

        // `ldvirtftn` consumes the receiver it dispatches against, so the
        // receiver pushed for the delegate's own constructor argument
        // needs a duplicate first.
        visit(delegate: Values.Load.DELEGATE) is
            gen(delegate.frame)

            if delegate.function.is_virtual_dispatch then
                _body.op(System.Reflection.Metadata.ILOpCode.DUP)
            fi

            gen(delegate.function)
            _body.new_object(_context.resolve_delegate_constructor(delegate.type))
        si

        visit(block: Values.BLOCK) is
            assert !block.is_emitted else "oops: block value already emitted"

            block.is_emitted = true

            for value in block.values do
                gen_marked(value)
            od
        si

        visit(block: Values.DUMMY_BLOCK) is
            throw System.InvalidOperationException("oops: dummy block generated, created at: {block.location} because: {block.why}")
        si

        visit(self_load: Values.Load.REFERENCE_SELF) is
            _body.ldarg(0)
        si

        visit_address(self_load: Values.Load.REFERENCE_SELF) is
            _body.ldarg(0)
        si

        // A closure's frame holds the self of the function it was made in.
        visit(self_load: Values.Load.OUTER_SELF) is
            _body.ldarg(0)
            _body.ldfld(_context.resolve_field_target(self_load.outer_self_field))
        si

        visit_address(self_load: Values.Load.OUTER_SELF) is
            visit(self_load)
        si

        // A struct's own `self` is its address; the value is loaded from it.
        visit(self_load: Values.Load.VALUE_SELF) is
            _body.ldarg(0)
            _body.load_object(_type_token(self_load.type!))
        si

        visit_address(self_load: Values.Load.VALUE_SELF) is
            _body.ldarg(0)
        si

        // Each runtime operation is a member of the .NET runtime or of
        // ghūl's own runtime library.
        visit(runtime: Values.RUNTIME) is
            if runtime.is_marked_as_call then
                gen(_context.string_builder.lowered(runtime))

                return
            fi

            for operand in runtime.operands do
                gen_marked(operand)
            od

            mark_operator(runtime)

            case runtime.operation
            when IR.RuntimeOperation.CONCAT_STRINGS then
                _body.call(_context.resolve_string_concat())
            when IR.RuntimeOperation.STRINGS_EQUAL then
                _body.call(_context.resolve_string_equality())
            when IR.RuntimeOperation.NEW_NOT_IMPLEMENTED then
                _body.new_object(_context.resolve_not_implemented_constructor())
            when IR.RuntimeOperation.NEW_NOT_SUPPORTED then
                _body.new_object(_context.resolve_not_supported_constructor())
            when IR.RuntimeOperation.NEW_ASSERT_FAILED then
                _body.new_object(_context.resolve_assert_failed_constructor())
            when IR.RuntimeOperation.INIT_OBJECT then
                _body.call(_context.resolve_object_constructor())
            when IR.RuntimeOperation.CURRENT_THREAD_ID then
                _body.call(_context.resolve_current_managed_thread_id())
            when IR.RuntimeOperation.JOIN_PIPE then
                _body.call(_context.resolve_pipe_join(runtime.type_argument!))
            when IR.RuntimeOperation.NEW_RANGE then
                _body.new_object(_context.resolve_range_constructor(runtime.type!))
            else
                throw System.NotImplementedException("no lowering for runtime operation {runtime.operation}")
            esac
        si

        visit(creation: Values.CREATE_UNIT_VARIANT_INSTANCE) is
            _body.new_object(_context.resolve_call_target(creation.constructor))
            _body.stsfld(_context.resolve_unit_variant_instance(creation.variant))
        si

        // The emitter reserves the same depth for every body it writes,
        // so nothing is encoded for this.
        visit(max_stack: Values.MAX_STACK) is
        si

        visit(equality: Values.REFERENCE_EQUALITY) is
            gen(equality.left)
            gen(equality.right)
            _body.op(System.Reflection.Metadata.ILOpCode.CEQ)
        si

        visit(construct: Values.CONSTRUCT_MAYBE) is
            gen(construct.value)
            _body.new_object(_context.resolve_generic_constructor(construct.type, 1))
        si

        // Stands for a value an earlier step left on the stack, so there
        // is nothing to encode.
        visit(stack_top: Values.STACK_TOP) is
        si

        visit(stack_top: Values.STACK_TOP_ADDRESS) is
        si

        visit_address(stack_top: Values.STACK_TOP_ADDRESS) is
        si

        visit(launch: Values.ASYNC_METHOD_LAUNCH) is
            _async.launch(launch)
        si

        visit(completion: Values.ASYNC_COMPLETION) is
            _async.complete(completion)
        si

        visit(completed: Values.COMPLETED_TASK_LIKE) is
            _async.completed(completed)
        si

        visit(suspend: Values.AWAIT_SUSPEND) is
            _async.suspend(suspend)
        si

        visit(step: Values.AWAIT_SUSPEND_STEP) is
            _async.step(step)
        si
    si
si
