namespace IR.Emitter is
    use System.NotImplementedException
    use IO.File

    use Values.Call

    // The state the CIL backend carries while it lowers and encodes:
    // the assembly being written, the body of the function being
    // generated, and how values reach the members and types they name.
    class CIL_CONTEXT is
        _logger: Logging.Logger

        // Binary emission state, carried here so that a value's `gen`
        // can reach the method body it is being emitted into without
        // every caller threading it through.
        //
        // The assembly emitter is installed by the driver before any
        // pass that emits runs, and every emitting pass requires one, so
        // it reads as non-optional: a build that reaches emission
        // without one is a wiring error rather than a state to branch
        // on, and fails here rather than silently emitting nothing.
        //
        // The body emitter is genuinely optional - it tracks the method
        // the IL visitor currently has open, and is null outside one.
        _srm_assembly_emitter: Emitter.SRM_ASSEMBLY_EMITTER?

        // What the emitter was installed as, so a rebuild can make
        // another one like it. Analysis compiles the project again on
        // every edit and query miss, and an emitter accumulates a
        // reference and specification cache per compile: kept across
        // rebuilds it grows for as long as the editor session lasts.
        _srm_module_name: string?
        _srm_module_version: string?
        _srm_want_library: bool

        srm_assembly_emitter: Emitter.SRM_ASSEMBLY_EMITTER =>
            _srm_assembly_emitter!

        install_srm_assembly_emitter(
            module_name: string,
            module_version: string,
            want_library: bool
        ) is
            _srm_module_name = module_name
            _srm_module_version = module_version
            _srm_want_library = want_library

            reset_srm_assembly_emitter()
        si

        // Called wherever the symbol table is abandoned: the handles the
        // old emitter holds name symbols that no longer exist.
        reset_srm_assembly_emitter() is
            if let module_name = _srm_module_name then
                _srm_assembly_emitter =
                    Emitter.SRM_ASSEMBLY_EMITTER(
                        "{module_name}.{if _srm_want_library then "dll" else "exe" fi}",
                        module_name,
                        _srm_module_version!,
                        _srm_want_library)
            fi
        si

        current_srm_body_emitter: Emitter.SRM_METHOD_BODY_EMITTER? public

        // Reads `--debug` off the shared build-flags singleton so
        // non-debug builds pay nothing for the `mark_location` check.
        want_debug_info: bool =>
            IoC.CONTAINER.instance.build_flags.want_debug

        // Compilation-global counter assigning each `@IL.output` region a
        // sequence number, so the runner can rebuild source order across
        // methods. Bumped once per region, at its start.
        _il_output_sequence: int

        // While positive, structured nodes are lowered without marking
        // source positions for the values they lower to, as for control
        // flow inside a value that marks its own position. Values still
        // mark whatever their own encoding marks.
        _unmarked_depth: int

        // The structured nodes being generated, innermost last.
        _open_structured: Collections.STACK[Values.Breakable]

        // Lowers each value generated through this context.
        lowering: Emitter.CIL_LOWERING

        init(logger: Logging.Logger) is
            _logger = logger

            _open_structured = Collections.STACK[Values.Breakable]()

            lowering = Emitter.CIL_LOWERING(self)
        si

        enter_structured(node: Values.Breakable) is
            _open_structured.push(node)
        si

        leave_structured(node: Values.Breakable) is
            assert _open_structured.count > 0 /\ _open_structured.peek() == node else "structured nodes left out of order"

            _open_structured.pop()
        si

        is_structured_open(node: Values.Breakable) -> bool =>
            _open_structured.contains(node)

        // The structured nodes being generated, innermost first.
        open_structured: Collections.Iterable[Values.Breakable] => _open_structured

        // Note a source-language position at the current emission
        // point. A position is recorded against the instruction offset
        // the body has reached, so this is only meaningful while one is
        // open; `mark_sequence_point` itself dedupes a repeated position
        // at the same offset. Internal / sentinel locations are ignored.
        begin_unmarked() is
            _unmarked_depth = _unmarked_depth + 1
        si

        end_unmarked() is
            assert _unmarked_depth > 0 else "unbalanced end of unmarked encoding"

            _unmarked_depth = _unmarked_depth - 1
        si

        is_marking_structure: bool => _unmarked_depth == 0

        mark_location(location: Source.LOCATION?) is
            if !want_debug_info \/ !location? \/ location.is_internal \/ !current_srm_body_emitter? then
                return
            fi

            current_srm_body_emitter.mark_sequence_point(location)
        si

        // Marks an emission path that isn't implemented yet, so a build
        // can continue past a gap in the binary back end rather than
        // crashing. Traced to stderr; nothing reads what a gap produces.
        fixme(value: object) is
            Logging.debug_always("FIXME: {value}")
        si

        next_il_output_sequence() -> int is
            _il_output_sequence = _il_output_sequence + 1

            return _il_output_sequence
        si

        // Resolves a call target to a member reference. Handles the two
        // owner shapes a call can have: a ghūl global function, hosted on
        // its namespace's $globals carrier, and a static method, hosted
        // directly on its declaring type.
        //
        // Only void-returning signatures taking zero or one string
        // argument are encoded; anything else needs the signature blob
        // built from the function's actual argument and return types.
        // The CLR parameter index of a named argument.
        //
        // Arguments are addressed by name up to here, and metadata has
        // only positions. An instance method's slot 0 is the receiver,
        // so a declared argument sits one further along.
        resolve_argument_index(symbol: Semantic.Symbols.Symbol) -> int is
            let function = cast Semantic.Symbols.Function?(symbol.owner)

            assert function? else
                "argument '{symbol.name}' is not owned by a function"

            let names = function.argument_names

            for i in 0..names.count do
                if names[i] =~ symbol.name then
                    return if function.is_emitted_with_receiver then i + 1 else i fi
                fi
            od

            assert false else
                "argument '{symbol.name}' is not declared by {function.name}"

            return 0
        si

        // The metadata token naming a type, for instructions that take
        // one directly (box, castclass, isinst). A constructed generic
        // needs a TypeSpec rather than a bare reference, which is not
        // built yet, so those report rather than emitting a token that
        // names the open definition.
        // A unit variant is constructed by loading the one interned
        // instance the back end synthesises for it, rather than by
        // calling its constructor.
        resolve_unit_variant_instance(
            variant: Semantic.Scope
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            // A specialization holds the open definition rather than
            // being one, and only the definition has a row.
            let classy =
                if let generic: Semantic.Symbols.GENERIC = variant then
                    cast Semantic.Symbols.Classy?(generic.symbol)
                else
                    cast Semantic.Symbols.Classy?(variant)
                fi

            assert classy? else "unit variant '{variant.name}' is not a type"

            // A generic variant's instance field belongs to the
            // instantiation, so it is reached through a reference whose
            // parent is that instantiation's specification. The field's
            // own type is written open — the variant applied to its own
            // parameters — because the reference names the field on the
            // open definition and the instantiation lives in the parent.
            if classy.is_generic then
                if let constructed: Semantic.Symbols.GENERIC = variant then
                    return cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_named_member_reference(
                            resolve_type_token(constructed.type),
                            "_instance",
                            "_instance {constructed.type}",
                            Emitter.SRM_SIGNATURE_ENCODER(emitter)
                                .field_signature(classy.own_instantiation)))
                fi

                // Reached from inside the variant's own static
                // initializer, where there is no instantiation to hand:
                // the parent is the variant applied to its own
                // parameters, which is what the field's row names too.
                return cast System.Reflection.Metadata.EntityHandle(
                    emitter.add_named_member_reference(
                        resolve_type_token(classy.own_instantiation),
                        "_instance",
                        "_instance {classy.own_instantiation}",
                        Emitter.SRM_SIGNATURE_ENCODER(emitter)
                            .field_signature(classy.own_instantiation)))
            fi

            let instance = emitter.handles.unit_variant_instance(classy)

            if instance? then
                return cast System.Reflection.Metadata.EntityHandle(instance)
            fi

            // A variant of a union another assembly declares. Its
            // interned instance is a field over there, so it is reached
            // by reference rather than by the row this assembly would
            // have written for one of its own.
            assert classy.is_reflected else
                "unit variant '{variant.name}' has no interned instance"

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(classy.type!),
                    "_instance",
                    "_instance {classy.type}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter).field_signature(classy.type!)))
        si

        // A token for a type named rather than resolved: the compiler
        // synthesises code around a few framework types it knows by
        // name and has no symbol for, the way the assert helper names
        // its own exception.
        resolve_type_token_by_name(
            assembly_name: string,
            namespace_name: string,
            name: string
        ) -> System.Reflection.Metadata.EntityHandle =>
            cast System.Reflection.Metadata.EntityHandle(
                srm_assembly_emitter.add_type_reference_by_name(
                    assembly_name, namespace_name, name))

        resolve_type_token(type: Semantic.Types.Type) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            // A constructed generic has no row of its own, and neither
            // does a type parameter or a primitive: all three are
            // structural types, named by a specification carrying their
            // encoded shape. A primitive especially cannot be named by
            // reference — its il_name_override is the assembler keyword
            // (`int8`, `int32`), which is not what the type is called.
            if type.arguments.count > 0 \/
               isa Semantic.Symbols.GenericArgument(type.symbol) \/
               type.symbol.il_is_primitive_type
            then
                return cast System.Reflection.Metadata.EntityHandle(
                    emitter.add_type_specification(type))
            fi

            // Same unwrapping as the signature encoder: a constructed
            // generic's symbol holds the open definition rather than
            // being one, and only the definition has a row.
            let symbol =
                if let generic: Semantic.Symbols.GENERIC = type.symbol then
                    generic.symbol
                else
                    cast Semantic.Symbols.Classy?(type.symbol)
                fi

            assert symbol? else "cannot name the type '{type}' in an instruction"

            if let definition = emitter.handles.type_definition(symbol) then
                return cast System.Reflection.Metadata.EntityHandle(definition)
            fi

            return cast System.Reflection.Metadata.EntityHandle(
                Emitter.SRM_SIGNATURE_ENCODER(emitter).type_reference_for(symbol))
        si

        // Invoking a function value calls Invoke on the delegate type.
        resolve_delegate_invoke(
            func_type: Semantic.Types.Type,
            argument_count: int,
            is_action: bool
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(func_type),
                    "Invoke",
                    "Invoke {func_type}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .delegate_invoke_signature(argument_count, is_action)))
        si

        // An inference sentinel inside a type reaching code
        // generation means an inference gap upstream was never
        // reported as a diagnostic — the signature encoder refuses
        // sentinels, so without this check the gap surfaces as an
        // internal error deep in emission instead.
        contains_sentinel(type: Semantic.Types.Type?) -> bool static is
            if !type? then
                return false
            fi

            if type.is_sentinel then
                return true
            fi

            // Every composite that carries child types — arrays,
            // tuples, functions, refs, pointers, maybes — is a
            // GENERIC over them, so recursing over the arguments
            // visits the whole tree.
            if let generic: Semantic.Types.GENERIC = type then
                for argument in generic.arguments do
                    if contains_sentinel(argument) then
                        return true
                    fi
                od
            fi

            return false
        si

        report_unresolved_type(location: Source.LOCATION, type: Semantic.Types.Type) is
            _logger.error(
                location,
                "cannot call a function value whose type was not fully inferred: '{type}'")
        si

        // A tuple and a wrapped optional are both a constructed generic
        // built from one value per type parameter, so both reach their
        // constructor the same way: through the owning TypeSpec, with
        // the parameters written as indexes.
        resolve_generic_constructor(
            type: Semantic.Types.Type,
            argument_count: int
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(type),
                    ".ctor",
                    ".ctor {type}/{argument_count}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .generic_constructor_signature(argument_count)))
        si

        // `assert` joins its location to its message and wraps the
        // result in an exception. Both members belong to types no symbol
        // in this compilation names, so both are built from their known
        // shapes rather than read off a declaration.
        resolve_string_concat() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_object_type())
            arguments.add(lookup.get_object_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_type_reference_by_name("System.Runtime", "System", "String")),
                    "Concat",
                    "String::Concat(object,object)",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .static_signature(lookup.get_string_type(), arguments)))
        si

        // `=~` on two strings lowers to the framework's own equality
        // operator rather than to an instruction, so it needs a member
        // reference like any other imported static.
        resolve_string_equality() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_string_type())
            arguments.add(lookup.get_string_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_type_reference_by_name("System.Runtime", "System", "String")),
                    "op_Equality",
                    "String::op_Equality(string,string)",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .static_signature(lookup.get_bool_type(), arguments)))
        si

        // The two members of `EqualityComparer[T]` a value-equality test
        // over a bare type parameter goes through. Neither is declared by
        // any symbol in the compilation, so each is built from its known
        // shape.
        //
        // The reference hangs off the caller's instantiation while the
        // signature is written in the comparer's own terms — `!0` is the
        // comparer's type parameter, not the caller's — the same open-form
        // rule every other methodref on a constructed generic follows.
        resolve_equality_comparer_default(
            comparer_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            let classy = _comparer_classy(comparer_type)

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(comparer_type),
                    "get_Default",
                    "EqualityComparer::get_Default()",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .static_signature(classy.own_instantiation, Collections.LIST[Semantic.Types.Type]())))
        si

        resolve_equality_comparer_equals(
            comparer_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let parameter = _comparer_classy(comparer_type).type_parameter_at(0)
            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(parameter!.type!)
            arguments.add(parameter.type!)

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(comparer_type),
                    "Equals",
                    "EqualityComparer::Equals(!0,!0)",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .call_signature(lookup.get_bool_type(), arguments, true)))
        si

        // A constructed generic's symbol is a `Symbols.GENERIC` holding
        // the open definition rather than being one.
        _comparer_classy(comparer_type: Semantic.Types.Type) -> Semantic.Symbols.Classy is
            if let generic: Semantic.Symbols.GENERIC = comparer_type.symbol then
                return cast Semantic.Symbols.Classy(generic.symbol)
            fi

            return cast Semantic.Symbols.Classy?(comparer_type.symbol)!
        si

        // The constructor of the exception a body-less class method
        // throws when it is called: it overrides an implemented member,
        // so it has a slot to fill and nothing to fill it with.
        resolve_not_implemented_constructor() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_string_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_type_reference_by_name(
                            "System.Runtime", "System", "NotImplementedException")),
                    "NotImplementedException::.ctor(string)",
                    arguments))
        si

        resolve_not_supported_constructor() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_type_reference_by_name(
                            "System.Runtime", "System", "NotSupportedException")),
                    "NotSupportedException::.ctor()",
                    Collections.LIST[Semantic.Types.Type]()))
        si

        resolve_assert_failed_constructor() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_string_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_type_reference_by_name(
                            "ghul-runtime", "Ghul", "AssertFailedException")),
                    "AssertFailedException::.ctor(string)",
                    arguments))
        si

        // The free function a state-machine frame's ToString calls to
        // render itself the way the runtime's own pipes do:
        // `Ghul.Pipes.render_elements(source)`, or `Ghul.Pipes.join(source)`
        // from a runtime too old to have it. The `Pipe[T]` trait's own
        // to_string is a default interface method and so does not
        // override Object.ToString, and a frame that called the trait
        // member would reach its own override and recurse.
        resolve_pipe_join(
            element_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let functions = lookup.get_render_elements_functions() ?? lookup.get_join_functions()

            assert functions? else "Ghul.Pipes.join is not available"

            let single_argument: Semantic.Symbols.Function? mut = null

            for f in functions.functions do
                if f.arguments.count == 1 then
                    single_argument = f
                fi
            od

            assert single_argument? else
                "Ghul.Pipes.join has no single-argument overload"

            let specialized =
                cast Semantic.Symbols.Function?(
                    single_argument.specialize(
                        Collections.LIST[Semantic.Types.Type]([element_type])))

            assert specialized? else
                "Ghul.Pipes.join could not be specialized over {element_type}"

            return resolve_call_target(specialized)
        si

        // The builder members an async lowering reaches, located by their
        // ghul names on the builder type - the same lookup for a reflected
        // builder, whose members import under these names, and for one
        // declared in ghul source. Resolution goes through the ordinary
        // call-target machinery, so a same-assembly builder is called
        // through its own definition row and a reflected one through a
        // member reference, each with a signature read off the member
        // rather than written out here.
        resolve_builder_member(
            builder_type: Semantic.Types.Type,
            name: string,
            argument_count: int
        ) -> System.Reflection.Metadata.EntityHandle is
            let member = Semantic.TASK_LIKE.member_of_arity(builder_type, name, argument_count)

            assert member? else "no {name}/{argument_count} member on builder {builder_type}"

            return resolve_call_target(member)
        si

        resolve_builder_property(
            builder_type: Semantic.Types.Type,
            name: string
        ) -> System.Reflection.Metadata.EntityHandle is
            let property = cast Semantic.Symbols.Property?(builder_type.find_member(name))

            assert property? /\ property.read_function? else
                "no readable {name} property on builder {builder_type}"

            return resolve_call_target(property.read_function)
        si

        // Whether the builder's await-on-completed member takes the state
        // machine by reference (the shape the BCL builders use) or by
        // value as the interface (which lets a builder register a
        // method value as the continuation, with no closure).
        builder_awaits_sm_by_reference(
            builder_type: Semantic.Types.Type,
            is_critical: bool
        ) -> bool is
            let name =
                if is_critical then
                    "await_unsafe_on_completed"
                else
                    "await_on_completed"
                fi

            let member = Semantic.TASK_LIKE.member_of_arity(builder_type, name, 2)

            if !member? then
                return true
            fi

            return isa Semantic.Types.REFERENCE(member.arguments[1])
        si

        // A generic builder member - `start[A](a: A ref)` or
        // `await_on_completed[A, S](a: A ref, s: S ref)`. The reference
        // names the open method and a specification supplies the
        // construction types, which no member specialization carries.
        resolve_builder_generic_member(
            builder_type: Semantic.Types.Type,
            name: string,
            argument_count: int,
            type_arguments: Collections.List[Semantic.Types.Type]
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            let member = Semantic.TASK_LIKE.member_of_arity(builder_type, name, argument_count)

            assert member? else "no {name}/{argument_count} member on builder {builder_type}"

            let root = cast Semantic.Symbols.Function?(member.root_specialized_from) ?? member

            let reference =
                emitter.add_named_member_reference(
                    _member_owner_handle(member),
                    Emitter.SRM_FLAGS.method_name(root),
                    "method {member.owner}::{root.description}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter).method_signature(root))

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_method_specification(
                    cast System.Reflection.Metadata.EntityHandle(reference),
                    "{member}",
                    type_arguments))
        si


        // `start[A](state_machine: A ref)` is generic in the state machine
        // it drives, so the reference names the open method and a
        // specification supplies the frame type.
        resolve_async_builder_start(
            builder_type: Semantic.Types.Type,
            state_machine_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(state_machine_type)

            return resolve_builder_generic_member(builder_type, "start", 1, arguments)
        si

        // The builder method that registers an await's continuation:
        // `await_unsafe_on_completed` for an awaiter implementing
        // `ICriticalNotifyCompletion`, `await_on_completed` otherwise.
        // Both are generic in the awaiter and the state machine.
        resolve_await_on_completed(
            builder_type: Semantic.Types.Type,
            awaiter_type: Semantic.Types.Type,
            state_machine_type: Semantic.Types.Type,
            is_critical: bool
        ) -> System.Reflection.Metadata.EntityHandle is
            let name =
                if is_critical then
                    "await_unsafe_on_completed"
                else
                    "await_on_completed"
                fi

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(awaiter_type)

            // The specification names one type argument per method type
            // parameter: a member typing the state machine as the
            // interface has only the awaiter's.
            let member = Semantic.TASK_LIKE.member_of_arity(builder_type, name, 2)

            if !member? \/ member.generic_arguments.count > 1 then
                arguments.add(state_machine_type)
            fi

            return resolve_builder_generic_member(builder_type, name, 2, arguments)
        si

        // `System.Type.GetTypeFromHandle`, which turns the handle
        // `ldtoken` pushes into the `System.Type` a `typeof` yields.
        // Neither the method nor either of the types it mentions is
        // declared by any symbol in the compilation.
        resolve_get_type_from_handle() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            let system_type =
                emitter.add_type_reference_by_name("System.Runtime", "System", "Type")

            let handle_type =
                emitter.add_type_reference_by_name(
                    "System.Runtime", "System", "RuntimeTypeHandle")

            let builder = System.Reflection.Metadata.BlobBuilder(16)

            let return_type: System.Reflection.Metadata.Ecma335.ReturnTypeEncoder mut
            let parameters: System.Reflection.Metadata.Ecma335.ParametersEncoder mut

            System.Reflection.Metadata.Ecma335.BlobEncoder(builder)
                .method_signature(
                    System.Reflection.Metadata.SignatureCallingConvention.DEFAULT, 0, false)
                .parameters(1, return_type ref, parameters ref)

            return_type.`type(false).`type(
                cast System.Reflection.Metadata.EntityHandle(system_type), false)

            parameters.add_parameter().`type(false).`type(
                cast System.Reflection.Metadata.EntityHandle(handle_type), true)

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    cast System.Reflection.Metadata.EntityHandle(system_type),
                    "GetTypeFromHandle",
                    "System.Type::GetTypeFromHandle(RuntimeTypeHandle)",
                    builder.to_array()))
        si

        // MoveNext.s trailer completes the task through `set_result`. A
        // builder can declare both the parameterless and the one-argument
        // overload; the one reached is chosen by whether there is a
        // result to deliver.
        resolve_async_builder_set_result(
            builder_type: Semantic.Types.Type,
            has_result: bool
        ) -> System.Reflection.Metadata.EntityHandle is
            return resolve_builder_member(
                builder_type, "set_result", if has_result then 1 else 0 fi)
        si

        resolve_async_builder_set_exception(
            builder_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle =>
            resolve_builder_member(builder_type, "set_exception", 1)

        // `System.Object`'s constructor, which every constructor that
        // does not chain to a declared superclass calls first. Named
        // here because no symbol in the compilation declares it.
        resolve_object_constructor() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_type_reference_by_name("System.Runtime", "System", "Object")),
                    "Object::.ctor()",
                    Collections.LIST[Semantic.Types.Type]()))
        si

        // `System.Object.GetType()`. `!` on a plain reference-typed
        // `T?` calls it through a dup-and-discard so the runtime's own
        // null check does the throwing; named here for the same reason
        // as `Object`'s constructor: no symbol in the compilation
        // declares it.
        resolve_object_get_type() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            let object_type =
                emitter.add_type_reference_by_name("System.Runtime", "System", "Object")

            let type_type =
                emitter.add_type_reference_by_name("System.Runtime", "System", "Type")

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    cast System.Reflection.Metadata.EntityHandle(object_type),
                    "GetType",
                    "Object::GetType()",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .nullary_instance_signature(cast System.Reflection.Metadata.EntityHandle(type_type))))
        si

        // `System.Environment.CurrentManagedThreadId`, which a generator's
        // GetEnumerator reads to tell whether the thread asking is the one
        // that made it.
        resolve_current_managed_thread_id() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token_by_name("System.Runtime", "System", "Environment"),
                    "get_CurrentManagedThreadId",
                    "Environment::get_CurrentManagedThreadId()",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .static_signature(lookup.get_int_type(), Collections.LIST[Semantic.Types.Type]())))
        si

        // `System.Decimal`'s full-resolution constructor, which a
        // decimal literal is built through. Named here for the same
        // reason as `Object`'s: no symbol in the compilation declares
        // it.
        resolve_decimal_constructor() -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_int_type())
            arguments.add(lookup.get_int_type())
            arguments.add(lookup.get_int_type())
            arguments.add(lookup.get_bool_type())
            arguments.add(lookup.get_ubyte_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    resolve_type_token_by_name("System.Runtime", "System", "Decimal"),
                    "Decimal::.ctor(int32, int32, int32, bool, unsigned int8)",
                    arguments))
        si

        // `System.Numerics.BigInteger`'s single-`long` constructor and
        // its `Parse`, which a `bigint` literal is built through. Named
        // here for the same reason as `Decimal`'s constructor: no symbol
        // in the compilation declares either.
        resolve_bigint_constructor(bigint_type: Semantic.Types.Type) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_long_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    resolve_type_token(bigint_type),
                    "BigInteger::.ctor(int64)",
                    arguments))
        si

        resolve_bigint_parse(bigint_type: Semantic.Types.Type) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_string_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(bigint_type),
                    "Parse",
                    "BigInteger::Parse(string)",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .static_signature(bigint_type, arguments)))
        si

        // A static method on `System.Decimal`. Decimal has no IL
        // opcodes of its own, so both its arithmetic and its
        // conversions to and from other scalars are calls to one of
        // these.
        resolve_decimal_method(
            method_name: string,
            parameter_types: Collections.List[Semantic.Types.Type],
            return_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token_by_name("System.Runtime", "System", "Decimal"),
                    method_name,
                    "Decimal::{method_name}/{parameter_types.count} -> {return_type}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .static_signature(return_type, parameter_types)))
        si

        // A range struct is constructed from its two integer bounds.
        resolve_range_constructor(
            range_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_int_type())
            arguments.add(lookup.get_int_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    resolve_type_token(range_type),
                    "range .ctor {range_type}",
                    arguments))
        si

        // A delegate is constructed from a receiver and a function
        // pointer, so its constructor always takes (object, native int).
        // The delegate type is normally a constructed generic, which
        // has no reference row of its own: its TypeSpec is the owner.
        resolve_delegate_constructor(
            delegate_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

            let arguments = Collections.LIST[Semantic.Types.Type]()

            arguments.add(lookup.get_object_type())
            arguments.add(lookup.get_word_type())

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    resolve_type_token(delegate_type),
                    "delegate .ctor {delegate_type}",
                    arguments))
        si

        // The metadata token naming a field, for a load or store.
        // Same rule as resolve_call_target: a field this assembly
        // defines is named by its own FieldDef row, whose number the
        // numbering pass has already fixed.
        resolve_field_target(`field: Semantic.Symbols.Field) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            if let definition = emitter.handles.field_definition(`field) then
                if !_owner_is_generic(`field) then
                    return cast System.Reflection.Metadata.EntityHandle(definition)
                fi
            fi

            let root = cast Semantic.Symbols.Field?(`field.root_specialized_from) ?? `field

            // The parent names the constructed owner while the name and
            // signature come from the open definition: a reference to a
            // field of `Pair[int]` hangs off a specification for that
            // instantiation, and says its type is `!0`. Taking both from
            // the unspecialized field points the reference at the open
            // type, which is not a type any instantiation has.
            //
            // The name is the CLR one. A reflected member can be
            // renamed on the way in — a tuple's `Item1` is `0` in ghūl —
            // and it is the original the metadata has to carry.
            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    _member_owner_handle(`field),
                    root.il_name,
                    "field {root.owner}::{root.il_name}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter).field_signature(root)))
        si

        // Whether a member is declared by a generic type.
        //
        // A member of one cannot be named by its own definition row even
        // when this assembly declares it: within the type's own methods
        // the receiver is the type applied to its own parameters, and a
        // definition row names the open type, which no instantiation is.
        _owner_is_generic(member: Semantic.Symbols.Symbol) -> bool is
            let owner = _owning_scope(member)

            if isa Semantic.Symbols.GENERIC(owner) then
                return true
            fi

            if let classy: Semantic.Symbols.Classy = owner then
                return classy.is_generic
            fi

            return false
        si

        // An `impl` or `partial` block owns its members through the
        // block's own scope, but they are members of the type the block
        // injects into, and it is that type they hang off.
        _owning_scope(member: Semantic.Symbols.Symbol) -> Semantic.Scope? =>
            if let injection: Semantic.INJECTION_SCOPE = member.owner then
                injection.target
            else
                member.owner
            fi

        // The reference row for the type an imported member hangs off.
        // A global function or variable hangs off its namespace's
        // globals carrier, which is a naming convention rather than a
        // declared type; everything else hangs off its owning type.
        _member_owner_handle(
            member: Semantic.Symbols.Symbol
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            let owner = _owning_scope(member)

            // A member of a constructed generic hangs off the
            // instantiation, which is named by a specification. The
            // open type's own reference names a type of no arguments
            // by that name, which does not exist, so a reference
            // through it fails to load.
            if let constructed: Semantic.Symbols.GENERIC = owner then
                return resolve_type_token(constructed.type)
            fi

            // A member reached from inside its own generic type: the
            // receiver is that type applied to its own parameters, so
            // the reference hangs off a specification for exactly that,
            // rendered `Type<!0, !1, ...>`.
            //
            // `Classy.type` is the *open* type (`Types.NAMED(self)`), so
            // the instantiation has to be built here from the type
            // parameters the class declared into its own scope.
            if let classy: Semantic.Symbols.Classy = owner then
                if classy.is_generic then
                    return cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_type_specification(classy.own_instantiation))
                fi
            fi

            // An imported global hangs off the carrier that holds it. A
            // namespace can have several - one per assembly contributing
            // globals to it, and a staging namespace re-homed onto it - so
            // the carrier comes from the member rather than from the
            // namespace it was re-homed onto.
            let carrier =
                if let global_function: Semantic.Symbols.GLOBAL_FUNCTION = member then
                    global_function.il_carrier
                elif let global_variable: Semantic.Symbols.GLOBAL_VARIABLE = member then
                    global_variable.il_carrier
                else
                    null
                fi

            if carrier? then
                return cast System.Reflection.Metadata.EntityHandle(
                    Emitter.SRM_SIGNATURE_ENCODER(emitter).type_reference_for(carrier))
            fi

            let owner_namespace =
                if let declared: Semantic.Symbols.NAMESPACE = owner then
                    declared
                elif let scope: Semantic.NAMESPACE_SCOPE = owner then
                    scope.containing_namespace
                else
                    null
                fi

            assert !owner_namespace? else
                "'{member.qualified_name}' is a global of a referenced assembly with no carrier recorded"

            let owner_classy = cast Semantic.Symbols.Classy?(owner)

            assert owner_classy? else "cannot reference a member owned by {owner}"

            // A type this assembly defines is named by its own
            // definition row rather than by a reference into another
            // assembly. The row does not exist yet — the numbering pass
            // fixed which row it will be, and the token resolves once
            // the structure walk writes it.
            //
            // This comes after the generic branches above: a definition
            // row names the open type, so an instantiation still needs
            // a specification even when this assembly declares it.
            if let definition = emitter.handles.type_definition(owner_classy) then
                return cast System.Reflection.Metadata.EntityHandle(definition)
            fi

            // il_name_override on an imported type is the CLR-side
            // dotted full name, unlike qualified_name which is the
            // ghūl-mapped spelling (e.g. "IO.Std" for System.Console).
            let il_name =
                owner_classy.il_name_override ?? owner_classy.qualified_name

            let clr_type_name =
                Emitter.SRM_SIGNATURE_ENCODER.clr_name_for_primitive(il_name) ?? il_name

            return cast System.Reflection.Metadata.EntityHandle(
                Emitter.SRM_SIGNATURE_ENCODER(emitter).reference_for_clr_name(
                    owner_classy,
                    _referenced_assembly(owner_classy.il_assembly_name ?? "", owner_classy),
                    clr_type_name))
        si

        // A type reference names the assembly it points into, which has
        // to have a row of its own before anything can name it.
        //
        // An empty name is not a usable reference: it produces a row the
        // runtime resolves to the assembly being built, so every type
        // named through it appears to be one this assembly defines and
        // fails to load. Refuse it rather than emit that.
        _referenced_assembly(assembly_name: string, owner: Semantic.Symbols.Symbol) -> string is
            assert assembly_name.length > 0 else
                "'{owner.qualified_name}' names no assembly to reference it through"

            srm_assembly_emitter.add_assembly_reference(assembly_name)

            return assembly_name
        si

        resolve_call_target(function: Semantic.Symbols.Function) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter

            // A target this assembly defines is called through its own
            // MethodDef row. The row does not exist yet — the numbering
            // pass fixed which row it will be, and the token embedded
            // here resolves once the structure walk writes it.
            //
            // Two cases cannot use it. A member of a generic type needs
            // a reference through the instantiation, because a
            // definition row names the open type. A generic method
            // called at an instantiation needs a MethodSpec over its
            // open definition, because a definition row names the
            // uninstantiated method and the runtime refuses to call one.
            if let definition = emitter.handles.method_definition(function) then
                if !_owner_is_generic(function) /\ function.generic_arguments.count == 0 then
                    return cast System.Reflection.Metadata.EntityHandle(definition)
                fi
            fi

            // An instantiation of a generic method is named by a
            // MethodSpec over the open method, not by a reference of its
            // own: the reference carries the method's own type
            // parameters as indexes, and the arguments live in the spec.
            let root = cast Semantic.Symbols.Function?(function.root_specialized_from) ?? function

            // The open method this assembly defines is already a row of
            // its own, and a MethodSpec can name it directly. Building a
            // reference to it instead would name the same method twice,
            // once as a definition and once as a reference into this
            // assembly, which is not a shape the format has.
            //
            // Only when the owner is non-generic. A generic method on a
            // generic type needs both instantiations — the owner's, in a
            // reference through its TypeSpec, and the method's own — and
            // a definition row carries neither.
            if !_owner_is_generic(function) /\ function.generic_arguments.count > 0 then
                if let open_row = emitter.handles.method_definition(root) then
                    return cast System.Reflection.Metadata.EntityHandle(
                        emitter.add_method_specification(
                            cast System.Reflection.Metadata.EntityHandle(open_row),
                            "{function}",
                            function.generic_arguments))
                fi
            fi

            let owner_ref = _member_owner_handle(function)

            let signature = Emitter.SRM_SIGNATURE_ENCODER(emitter).method_signature(root)

            let reference =
                emitter.add_named_member_reference(
                    owner_ref,
                    Emitter.SRM_FLAGS.method_name(root),
                    "method {function.owner}::{root.description}",
                    signature)

            if function.generic_arguments.count == 0 then
                return cast System.Reflection.Metadata.EntityHandle(reference)
            fi

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_method_specification(
                    cast System.Reflection.Metadata.EntityHandle(reference),
                    "{function}",
                    function.generic_arguments))
        si
    si
si
