@@IF.dotnet()

namespace IR.Emitter is
    use System.Reflection.Metadata.EntityHandle
    use System.Reflection.Metadata.UserStringHandle
    use System.Reflection.Metadata.ILOpCode

    // One entry in a method body as it is built, before it is encoded.
    // A body is held as these so that the whole of it can be seen before
    // any of it is encoded: unreachable instructions are dropped and each
    // branch takes its short form where its target is close enough.
    //
    // Everything an entry needs is computed when it is recorded, so
    // encoding one has no effect beyond the instruction encoder, and a
    // body can be encoded more than once.
    union BufferedInstruction is
        // An instruction with no operand.
        OP(op_code: ILOpCode)

        // An instruction with a metadata token operand. `pushes` is
        // whether it can leave the stack deeper than it found it.
        TOKEN(op_code: ILOpCode, handle: EntityHandle, pushes: bool)

        // A local or argument instruction, in the long form: the
        // encoder picks the shortest encoding for the slot.
        LOCAL(op_code: ILOpCode, slot: int)
        ARGUMENT(op_code: ILOpCode, index: int)

        CONSTANT_I4(value: int)
        CONSTANT_I8(value: long)
        CONSTANT_R4(value: single)
        CONSTANT_R8(value: double)
        STRING(handle: UserStringHandle)

        // A branch, recorded in its long form.
        BRANCH(op_code: ILOpCode, target: IR.LABEL)

        // Not instructions: positions in the body that are recorded
        // where they fall between the instructions.
        LABEL(label: IR.LABEL)
        REGION_BOUNDARY(boundary: int)
        SEQUENCE_POINT(location: Source.LOCATION)
        OUTPUT_BEGIN(path: string, sequence: int)
        OUTPUT_END
    si
si
