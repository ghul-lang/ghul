namespace IR is
    class LABEL is
        _current_pass: string static
        _next_id: int static

        pass: string
        id: int

        init() is
            pass = _current_pass
            id = _next_id

            _next_id = _next_id + 1
        si

        set_pass(p: string) static is
            _current_pass = p
        si

        reset_id() static is
            _next_id = 0
        si

        to_string() -> string => "L{pass}{id}"
    si

    enum BRANCH is
        NONE,
        EQ,
        GE,
        GEU,
        GT,
        GTU,
        LE,
        LEU,
        LT,
        LTU,
        NE,
        Z,
        NZ,
        ALWAYS
    si
si
