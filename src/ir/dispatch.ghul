namespace IR is
    // How a call on a receiver reaches the function it runs.
    enum Dispatch is
        // The named function itself, whatever the receiver's type: a
        // super call, or a function nothing can override.
        DIRECT,

        // Whatever overrides the function in the receiver's class.
        VIRTUAL,

        // Whatever implements the trait member in the receiver's type.
        INTERFACE,

        // Whatever implements the member in the type a type parameter
        // stands for, on a receiver whose type is that parameter or a
        // value type.
        CONSTRAINED
    si
si
