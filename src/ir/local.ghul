namespace IR is
    use Semantic.Types.Type

    // A local of the function being generated. Locals are told apart by
    // identity: the name is only for reading the IR, and two locals may
    // share one.
    //
    // The type is settled by the time the local is declared, which can
    // be after values that read it were built.
    class LOCAL is
        name: string
        type: Type public

        init(name: string, type: Type) is
            self.name = name
            self.type = type
        si

        load() -> Values.Value => Values.Load.TEMP(self)

        to_string() -> string => name
    si
si
