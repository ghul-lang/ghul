namespace IR is
    use Semantic.Types.Type
    use Semantic.Symbols.Function

    /// The `=~` a type declares for itself, which a target calls to compare
    /// two values of the type that `=~` reaches through no other route.
    class EQUALITY_OPERATOR is
        /// The `=~` `type` declares taking a value of itself, or for a class
        /// that declares none, an `equals` taking `object?` that the class
        /// declares or inherits from anything but `object` itself, which is
        /// what .NET's default comparer calls. For `object` or a trait, the
        /// root's `equals`, called through dispatch. Null where there is none.
        ///
        /// - type: the type whose operator to find
        declared(type: Type) -> Function? static is
            // The operator whose parameter is the type itself: one taking a
            // wider type is a different comparison, whichever is declared first.
            if let function = Semantic.KNOWN_MEMBERS.find(type, "=~", [type]) then
                return function
            fi

            if type.is_value_type then
                return null
            fi

            if let found = _equals_override(type) then
                return found
            fi

            // A value held as `object` or as a trait can be of any class, so
            // the root's `equals` is called, and dispatch reaches whatever
            // the value's own class answers with.
            if type.is_object \/ (cast Semantic.Symbols.Classy?(type.symbol)?.is_trait ?? false) then
                return _root_equals()
            fi

            return null
        si

        _root_equals() -> Function? static is
            let object_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_object_type()

            if let group: Semantic.Symbols.FUNCTION_GROUP = object_type.find_member("equals") then
                for function in group.functions do
                    if function.is_instance /\ function.arguments.count == 1 then
                        return function
                    fi
                od
            fi

            return null
        si

        _equals_override(type: Type) -> Function? static is
            let object_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_object_type()

            if let group: Semantic.Symbols.FUNCTION_GROUP = type.find_member("equals") then
                for function in group.functions do
                    if
                        function.is_instance /\
                        function.arguments.count == 1 /\
                        (function.arguments[0].optional_inner_type ?? function.arguments[0]).is_object /\
                        function.owner?.unspecialized_symbol != object_type.symbol.unspecialized_symbol
                    then
                        return function
                    fi
                od
            fi

            return null
        si
    si
si
