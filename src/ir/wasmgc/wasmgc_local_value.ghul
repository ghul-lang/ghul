namespace IR.WasmGC is
    use Semantic.Types.Type

    /// A value the lowering has already put in one of its own locals,
    /// for an IR value it builds to read it again.
    class WASMGC_LOCAL_VALUE: IR.Values.Value is
        /// The local holding the value.
        index: int

        _type: Type

        type: Type? pure => _type

        /// - index: the local holding the value
        /// - type: the type of the value it holds
        init(index: int, type: Type) is
            super.init()

            self.index = index
            _type = type
        si

        to_string() -> string => "wasmgc-local:[{_type}]({index})"
    si
si
