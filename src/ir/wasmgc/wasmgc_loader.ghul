namespace IR.WasmGC is
    use IO.File
    use IO.Path
    use IO.StreamReader

    /// The JavaScript loader that runs a module: instantiates it with the
    /// host imports, starts it, and reports its exit status.
    class WASMGC_LOADER is
        /// Writes the loader for the module at `module_path` beside it,
        /// with the module's name and the extension `.mjs`.
        ///
        /// - module_path: where the module was written
        write(module_path: string) static is
            let loader_path = Path.change_extension(module_path, ".mjs") ?? "{module_path}.mjs"

            File.write_all_text(loader_path, text_for(Path.get_file_name(module_path) ?? module_path))
        si

        /// The loader's text for a module file of this name, which it
        /// loads from beside itself.
        ///
        /// - module_file: the module's file name
        text_for(module_file: string) -> string static =>
            _template().replace("__GHUL_MODULE_FILE__", _escaped(module_file))

        _template() -> string static is
            let assembly = System.Reflection.Assembly.get_executing_assembly()
            let stream = assembly.get_manifest_resource_stream("wasmgc-loader.mjs")

            assert stream? else "the wasm loader is not embedded in the compiler"

            let use reader = StreamReader(stream)

            return reader.read_to_end()
        si

        // The file name, as the inside of a JavaScript string literal.
        _escaped(text: string) -> string static =>
            text.replace("\\", "\\\\").replace("\"", "\\\"")
    si
si
