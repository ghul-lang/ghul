namespace IR.WasmGC is
    use Collections.LIST

    /// Groups class numbers into the fewest runs of consecutive numbers,
    /// so a test against a set of classes is one comparison a run.
    class CLASS_ID_RANGES is
        /// The runs `ids` falls into, lowest first, each as its lowest and
        /// highest number. Repeated numbers count once.
        of(ids: Collections.Iterable[int]) -> Collections.List[(low: int, high: int)] static is
            let sorted = LIST[int](ids)

            sorted.sort()

            let result = LIST[(low: int, high: int)]()

            for id in sorted do
                if result.count > 0 /\ id <= result[result.count - 1].high + 1 then
                    let last = result[result.count - 1]

                    if id > last.high then
                        result[result.count - 1] = (last.low, id)
                    fi
                else
                    result.add((id, id))
                fi
            od

            return result
        si
    si
si
