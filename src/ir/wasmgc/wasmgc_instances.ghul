namespace IR.WasmGC is
    use Semantic.Symbols.Function

    /// A function as the wasm module compiles it: one definition, compiled
    /// once.
    ///
    /// - definition: the function whose body is compiled
    class WASMGC_FUNCTION is
        definition: Function

        init(definition: Function) is
            self.definition = definition
        si

        /// The instance of `definition` that takes no type arguments.
        of(definition: Function) -> WASMGC_FUNCTION static => WASMGC_FUNCTION(definition)

        =~(other: WASMGC_FUNCTION) -> bool pure => definition == other.definition

        get_hash_code() -> int => definition.get_hash_code()

        to_string() -> string => definition.qualified_name
    si
si
