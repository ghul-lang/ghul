namespace IR.WasmGC is
    /// Finds what the core library declares that the backend generates code
    /// against, without reporting anything it does not declare.
    class WASMGC_CORE_LIBRARY is
        /// The class declared as `qualified_name`, such as `Ghul.Exception`,
        /// or null where nothing of that name is a class.
        find_class(qualified_name: string) -> Semantic.Symbols.Classy? static is
            let scope: Semantic.Scope? mut = IoC.CONTAINER.instance.symbol_table.global_scope

            for part in qualified_name.split(['.']) do
                if !scope? then
                    return null
                fi

                scope = cast Semantic.Scope?(scope.find_direct(part))
            od

            return cast Semantic.Symbols.Classy?(scope)
        si

        /// The getter of the property `name` that `type` declares, or null
        /// where it declares no readable property of that name.
        find_getter(type: Semantic.Symbols.Classy, name: string) -> Semantic.Symbols.Function? static is
            if let property: Semantic.Symbols.Property = type.find_direct(name) then
                return property.read_function
            fi

            return null
        si
    si
si
