namespace IR.WasmGC is
    /// Which numeric format strings the core library's `to_string(format)`
    /// writes on the wasm target: the standard formats `D`, `E`, `F`, `G`,
    /// `N`, `R` and `X`, either case, with an optional precision, `D` and
    /// `X` only for an integer; and custom patterns of `0` and `#`
    /// placeholders with at most one `.` and `,` among the placeholders
    /// before it.
    class WASMGC_NUMERIC_FORMAT is
        /// Whether the core library writes a value under `format`.
        ///
        /// - format: the format string written after the `:` in an interpolation
        /// - integer: whether the value is of an integer type rather than a floating one
        is_covered(format: string, integer: bool) -> bool static is
            if format.length == 0 then
                return true
            fi

            let letter = char.to_upper_invariant(format[0])

            if "DEFGNRX".index_of(letter) >= 0 then
                for i in 1..format.length do
                    if !char.is_ascii_digit(format[i]) then
                        return _is_custom(format)
                    fi
                od

                return integer \/ (letter != 'D' /\ letter != 'X')
            fi

            return _is_custom(format)
        si

        _is_custom(format: string) -> bool static is
            let dot = format.index_of('.')

            for i in 0..format.length do
                let c = format[i]

                if c == '0' \/ c == '#' then
                    continue
                fi

                if c == '.' /\ i == dot then
                    continue
                fi

                if c == ',' /\ (dot < 0 \/ i < dot) then
                    continue
                fi

                return false
            od

            return true
        si
    si
si
