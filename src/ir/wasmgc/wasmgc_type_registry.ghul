namespace IR.WasmGC is
    use IR.Program

    use Wasm.MODULE
    use Wasm.SUB_TYPE
    use Wasm.FUNC_TYPE
    use Wasm.STRUCT_TYPE
    use Wasm.FIELD_TYPE
    use Wasm.ARRAY_TYPE
    use Wasm.PackedType
    use Wasm.TYPE_LENGTH_INSTRUCTION
    use Wasm.VALUE_TYPE
    use Wasm.HEAP_TYPE
    use Wasm.NumericType
    use Wasm.GLOBAL
    use Wasm.INSTRUCTION
    use Wasm.INDEX_INSTRUCTION
    use Wasm.TYPE_INSTRUCTION
    use Wasm.TYPE_FIELD_INSTRUCTION
    use Wasm.HEAP_TYPE_INSTRUCTION
    use Wasm.I32_CONSTANT
    use Wasm.I64_CONSTANT
    use Wasm.CALL_INDIRECT_INSTRUCTION
    use Wasm.F32_CONSTANT
    use Wasm.F64_CONSTANT
    use Wasm.Opcode
    use Wasm.AbstractHeapType

    use Collections.LIST
    use Collections.MAP

    use Source.LOCATION

    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Scope
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Field
    use Semantic.Symbols.Function
    use Semantic.Symbols.GENERIC

    use IR.Emitter.SRM_MEMBER_ORDER
    use IR.Emitter.SRM_EMITTED_TYPE

    /// Where an instance field lives: the struct type of the class that
    /// declares it and its position there. A subclass keeps its
    /// superclass's fields in the same positions, so this reaches the field
    /// in any instance.
    ///
    /// - type_index: the declaring class's struct type
    /// - field_index: the field's position in that struct
    /// - value_type: the type the field is held in
    class WASMGC_FIELD(type_index: int, field_index: int, value_type: VALUE_TYPE)

    /// The program's classes, unions and variants as WasmGC struct types,
    /// one for each instantiation the program uses, with a box type for each
    /// scalar, and the globals holding their descriptors, their static
    /// fields, static-constructor flags, the namespace-level variables and
    /// the unit variants' shared instances.
    ///
    /// Field 0 of every object is its type's descriptor, followed by its
    /// superclass's fields in order, then its own. A class nothing derives
    /// from is final.
    ///
    /// The classes are found in two steps. `collect` takes every class that
    /// is not generic, and while `discovering` is set, every instantiation
    /// asked about is added too. `build` then numbers them all.
    class WASMGC_TYPE_REGISTRY: DisplayTarget is
        // Every struct type goes in one recursion group near the start of
        // the type section. WasmGC treats two types as the same when their
        // groups have the same shape, so separate groups would make classes
        // with the same fields interchangeable.

        /// The array of UTF-16 code units a string holds, first in the type
        /// section and in a group of its own. It has to be exactly the
        /// standalone mutable array of i16 the host's string builtins take,
        /// though nothing writes one after it is built.
        CHARS_TYPE_INDEX: int static => 0

        /// The descriptor's struct type, first in the recursion group.
        DESCRIPTOR_TYPE_INDEX: int static => 1

        /// The root's struct type, which every class derives from.
        OBJECT_TYPE_INDEX: int static => 2

        /// The descriptor field holding the class's number.
        DESCRIPTOR_CLASS_ID: int static => 0

        /// The descriptor field holding the highest number of any class
        /// derived from it.
        DESCRIPTOR_LAST_DESCENDANT: int static => 1

        /// The descriptor field holding the superclass's descriptor, null
        /// for the root.
        DESCRIPTOR_SUPERCLASS: int static => 2

        /// The descriptor field holding the type's name, as the UTF-16 code
        /// units a string holds.
        DESCRIPTOR_NAME: int static => 3

        /// The string field caching its hash code.
        STRING_HASH: int static => 1

        /// The string field holding its UTF-16 code units.
        STRING_CHARS: int static => 2

        /// The field of a bigint's box holding its value while it fits in an
        /// i64.
        BIGINT_SMALL: int static => 1

        /// The field of a bigint's box holding the host's integer, or null
        /// while the value is in the i64 field.
        BIGINT_BIG: int static => 2

        /// The descriptor field holding the class's vtable, null where it
        /// has none.
        DESCRIPTOR_VTABLE: int static => 4

        /// The descriptor field caching the type object `get_type` and
        /// `typeof` answer for the type, null until one is first asked for.
        DESCRIPTOR_TYPE_OBJECT: int static => 5

        /// The descriptor field holding the function that writes a value of
        /// the class for display, null where the class has none.
        DESCRIPTOR_DISPLAY: int static => 6

        /// The descriptor field holding the function that copies an instance
        /// of the class, null where nothing the program reaches copies one.
        DESCRIPTOR_CLONE: int static => 7

        /// The descriptor field holding the function that describes the
        /// type for reflection, null where it has none. Present only where
        /// the build describes the program's types.
        DESCRIPTOR_DESCRIBE: int static => 8

        /// The closure field holding the function to call.
        CLOSURE_FUNCTION: int static => 1

        /// The closure field holding the receiver or frame, null for none.
        CLOSURE_RECEIVER: int static => 2

        /// The field of a box holding the value.
        BOX_VALUE: int static => 1

        /// The field of a reference cell holding the value.
        REFERENCE_CELL_VALUE: int static => 0

        _module: MODULE
        _object_definition: Classy?
        _object: CLASS_INSTANCE?
        _string: CLASS_INSTANCE?

        // A session-step build's classes are never final: a later step of
        // the session can subclass any of them, whatever this build sees.
        _session_step: bool

        /// Whether classes asked about are being found rather than
        /// compiled: every instantiation is added, and nothing is written
        /// to the module.
        discovering: bool public

        _dispatched: DISPATCHED_METHODS
        _lowered: Collections.SET[IR.Values.Call.INNATE]

        _class_set: CLASS_SET

        _type_indices: MAP[CLASS_INSTANCE, int]
        _layouts: MAP[CLASS_INSTANCE, LIST[VALUE_TYPE]]

        // The ghūl type of each field in a class's layout, null for the
        // descriptor, which says where a struct-typed field needs a box.
        _layout_types: MAP[CLASS_INSTANCE, LIST[Type?]]

        // Whether each struct is read-only, inferred once.
        _read_only: MAP[CLASS_INSTANCE, bool]
        _cells: Collections.SET[IR.LOCAL]
        _descriptor_globals: MAP[CLASS_INSTANCE, int]
        _unit_variant_globals: MAP[CLASS_INSTANCE, int]
        _shared_defaults: MAP[CLASS_INSTANCE, int]
        _classes_by_index: MAP[int, CLASS_INSTANCE]

        _field_positions: MAP[Symbol, int]
        _statics: MAP[(member: Symbol, owner: CLASS_INSTANCE), (index: int, type: VALUE_TYPE)]
        _namespace_globals: MAP[Symbol, (index: int, type: VALUE_TYPE)]

        _static_constructors: MAP[CLASS_INSTANCE, (constructor: FUNCTION_INSTANCE, initialised: int)]

        // The ways the program's arrays hold their elements, and the struct
        // type each takes. Every array whose elements are held the same way
        // shares one struct type, so an array of a class is usable where an
        // array of its superclass is expected.
        _array_storages: Collections.SET[int]
        _array_storage_types: MAP[int, int]

        _unsupported: LIST[(location: LOCATION, construct: string)]

        // Methods a class has on this target that no symbol of it declares.
        _synthesised_methods: MAP[Classy, LIST[Function]]

        _dispatch: WASMGC_DISPATCH

        _closure_type_index: int
        _reference_cell_type_index: int
        _reference_cells_wanted: bool
        _closure_descriptor: LIST[INSTRUCTION]
        _closure_descriptor_global: int
        _closure_thunks: LIST[int]
        _ordered: CLASS_INSTANCE[]
        _initialisers: MAP[CLASS_INSTANCE, LIST[INSTRUCTION]]
        _functions: WASMGC_FUNCTION_NUMBERING?
        _display_state: CLASS_INSTANCE?
        _display_signature: int?
        _displayers: MAP[CLASS_INSTANCE, int]
        _clones_wanted: bool
        _clone_signature: int?
        _cloners: MAP[CLASS_INSTANCE, int]
        _describers: MAP[CLASS_INSTANCE, int]
        _closure_describer: int?

        // Types a value is never an instance of but `typeof` can name: the
        // traits, each with a descriptor of its own.
        _descriptor_only: LIST[CLASS_INSTANCE]
        _descriptor_only_set: Collections.SET[CLASS_INSTANCE]
        _rtti_plan: RTTI_PLAN?
        _rtti_planned: bool
        _boxes_made: Collections.SET[CLASS_INSTANCE]

        /// The constructs the program declares that the object model cannot
        /// represent yet, each with where it was declared.
        unsupported: (location: LOCATION, construct: string)[] => _unsupported

        /// The numbers given to the classes.
        numbering: CLASS_ID_NUMBERING[CLASS_INSTANCE] => _class_set.numbering

        /// The classes the program uses.
        class_set: CLASS_SET => _class_set

        /// The methods calls dispatch on.
        dispatched: DISPATCHED_METHODS => _dispatched

        /// Which types get a displayer, and what each calls.
        display_plan: DISPLAY_PLAN => DISPLAY_PLAN(self, core)

        /// The built-in types the program's classes are planned around.
        core: CoreClasses => _class_set.core

        /// The trait instance a value of `type` is, or null where `type` is
        /// not a trait.
        trait_of(type: Type) -> CLASS_INSTANCE? => _dispatch.trait_of(type)

        /// A nullable reference to the root, which holds any object.
        object_reference: VALUE_TYPE => VALUE_TYPE.of_type_index(OBJECT_TYPE_INDEX, true)

        /// How the program's virtual and trait calls dispatch.
        dispatch: WASMGC_DISPATCH => _dispatch

        /// A registry that knows no classes, and so holds scalars only.
        init(module: MODULE) is
            init(module, null)
        si

        /// A registry for `module`, whose classes derive from `object`.
        init(module: MODULE, object: Classy?) is
            init(module, object, null)
        si

        /// A registry for `module`, whose classes derive from `object`, and
        /// whose strings are instances of `string_type`.
        init(module: MODULE, object: Classy?, string_type: Classy?) is
            _module = module
            _object_definition = object
            _session_step = IoC.CONTAINER.instance.build_flags.is_session_step

            _dispatched = DISPATCHED_METHODS()
            _lowered = Collections.SET[IR.Values.Call.INNATE]()

            _class_set = CLASS_SET(object, _holds_array_of(*), INNATE_CORE_CLASSES())

            _type_indices = MAP[CLASS_INSTANCE, int]()
            _layouts = MAP[CLASS_INSTANCE, LIST[VALUE_TYPE]]()
            _layout_types = MAP[CLASS_INSTANCE, LIST[Type?]]()
            _read_only = MAP[CLASS_INSTANCE, bool]()
            _descriptor_globals = MAP[CLASS_INSTANCE, int]()
            _unit_variant_globals = MAP[CLASS_INSTANCE, int]()
            _shared_defaults = MAP[CLASS_INSTANCE, int]()
            _classes_by_index = MAP[int, CLASS_INSTANCE]()

            _field_positions = MAP[Symbol, int]()
            _statics = MAP[(member: Symbol, owner: CLASS_INSTANCE), (index: int, type: VALUE_TYPE)]()
            _namespace_globals = MAP[Symbol, (index: int, type: VALUE_TYPE)]()

            _displayers = MAP[CLASS_INSTANCE, int]()
            _cloners = MAP[CLASS_INSTANCE, int]()
            _describers = MAP[CLASS_INSTANCE, int]()
            _descriptor_only = LIST[CLASS_INSTANCE]()
            _descriptor_only_set = Collections.SET[CLASS_INSTANCE]()
            _boxes_made = Collections.SET[CLASS_INSTANCE]()
            _cells = Collections.SET[IR.LOCAL]()
            _static_constructors = MAP[CLASS_INSTANCE, (constructor: FUNCTION_INSTANCE, initialised: int)]()

            _array_storages = Collections.SET[int]()
            _array_storage_types = MAP[int, int]()

            _unsupported = LIST[(location: LOCATION, construct: string)]()

            _synthesised_methods = MAP[Classy, LIST[Function]]()

            _dispatch = WASMGC_DISPATCH(self)
            _closure_descriptor = LIST[INSTRUCTION]()
            _closure_thunks = LIST[int]()
            _ordered = LIST[CLASS_INSTANCE]()
            _initialisers = MAP[CLASS_INSTANCE, LIST[INSTRUCTION]]()

            _object = _class_set.root

            if let definition = string_type then
                _string = _class_set.intern(CLASS_INSTANCE.of(definition))
            fi
        si

        /// Takes every class declared under `root` that is not generic, a
        /// box for each scalar, and a box for each enum.
        collect(root: Scope) => _class_set.collect(root, _scalar_types())

        /// Gives `owner` a method that no symbol of it declares, which
        /// dispatch reaches as it reaches the methods `owner` declares.
        add_method(owner: Classy, method: Function) is
            if !_synthesised_methods.contains_key(owner) then
                _synthesised_methods[owner] = LIST[Function]()
            fi

            _synthesised_methods[owner].add(method)
        si

        /// The methods `definition` has: those it declares, then any it
        /// was given.
        methods_of(definition: Classy) -> Function[] is
            let declared = SRM_MEMBER_ORDER.methods(SRM_EMITTED_TYPE(definition))
            let synthesised: LIST[Function] mut

            if !_synthesised_methods.try_get_value(definition, synthesised ref) then
                return declared
            fi

            let result = LIST[Function](declared)

            result.add_range(synthesised)

            return result
        si

        /// Every box held, with the scalar or enum type it holds.
        boxes: Collections.Iterable[Collections.KEY_VALUE_PAIR[CLASS_INSTANCE, Type]] => _class_set.boxes

        /// The classes added since this was last asked, each once.
        take_new_classes() -> CLASS_INSTANCE[] => _class_set.take_new_classes()

        /// Records, while discovering, that a call dispatches on `method`
        /// through a vtable or the trait table, so whatever overrides it
        /// can be reached.
        note_dispatched(method: Function) => _dispatched.note(method)

        /// Whether `method` is, or overrides, a method a call dispatches on.
        is_dispatched_to(method: Function) -> bool => _dispatched.is_dispatched_to(method)

        /// Records that the backend lowered the built-in operation `call`,
        /// so a later pass over the same body lowers it the same way.
        note_lowered(call: IR.Values.Call.INNATE) is
            _lowered.add(call)
        si

        /// Whether the backend lowered the built-in operation `call`.
        was_lowered(call: IR.Values.Call.INNATE) -> bool => _lowered.contains(call)

        /// Every class the registry holds, boxes included.
        classes: Collections.Iterable[CLASS_INSTANCE] => _class_set.classes

        /// Records that the types `type`'s fields hold are not added, because
        /// the class is already reported as instantiating itself without end.
        /// A field whose type is then missing is laid out as an object
        /// reference rather than reported again.
        leave_field_types(type: CLASS_INSTANCE) => _class_set.leave_field_types(type)

        /// Adds the type each of `type`'s fields holds, instance and static.
        /// A class this adds is taken by the next `take_new_classes`.
        add_field_types(type: CLASS_INSTANCE) => _class_set.add_field_types(type)

        /// The class `definition` at the type arguments `type_map` gives its
        /// parameters, added while discovering. Null where the registry does
        /// not hold it, or where `definition` is not a class the object
        /// model represents.
        class_of(definition: Classy, type_map: Collections.Map[Symbol, Type]) -> CLASS_INSTANCE? =>
            _class_set.class_of(definition, type_map)

        /// The class a value of `type` is an instance of, or null where it
        /// is not one the registry holds. `type` must have no type
        /// parameters left in it.
        class_of(type: Type?) -> CLASS_INSTANCE? => _class_set.class_of(type)

        /// Numbers every class held and builds the recursion group and the
        /// globals. Must run before anything else adds a type to the module.
        build() is
            assert _module.type_count() == 0 else "the object model's types must come first"

            _class_set.number()

            let object = _object!

            let ordered = LIST[CLASS_INSTANCE]()

            for type in _class_set.numbering.in_order() do
                if !is_array(type) then
                    ordered.add(type)
                fi
            od

            for i in 0..ordered.count do
                _type_indices[ordered[i]] = OBJECT_TYPE_INDEX + i
                _classes_by_index[OBJECT_TYPE_INDEX + i] = ordered[i]
            od

            let chars = _module.add_sub_type(SUB_TYPE(ARRAY_TYPE(FIELD_TYPE.of_packed(PackedType.I16, true)), true, []))

            assert chars == CHARS_TYPE_INDEX else "the code unit array must come first"

            // The closure type follows the classes, but a field can hold a
            // function value, so its index is fixed before any class's
            // fields are laid out.
            _closure_type_index = OBJECT_TYPE_INDEX + ordered.count

            // The array types follow the closure type, and a field can hold
            // an array, so theirs are fixed before any field is laid out too.
            _number_array_types(_closure_type_index + 1)

            let group = LIST[SUB_TYPE]()

            group.add(SUB_TYPE(_descriptor_struct(), true, []))

            for type in ordered do
                group.add(_sub_type(type))
            od

            _ordered = ordered

            assert DESCRIPTOR_TYPE_INDEX + group.count == _closure_type_index else "the closure type follows the classes"

            group.add(SUB_TYPE(_closure_struct(), true, [OBJECT_TYPE_INDEX]))

            _add_array_types(group)

            // A reference to a value of reference type is a cell holding the
            // value. One cell type serves every such type, so a read casts the
            // value back to the type it was stored as. Its index is fixed
            // before the trait table, whose signatures can take one, and it is
            // added only where discovery found a use for it.
            if _reference_cells_wanted then
                _reference_cell_type_index = DESCRIPTOR_TYPE_INDEX + group.count

                group.add(
                    SUB_TYPE(
                        STRUCT_TYPE([FIELD_TYPE.of_reference(VALUE_TYPE.of_abstract(AbstractHeapType.ANY), true)]),
                        true,
                        []))
            fi

            // An array type implements the traits the array family declares
            // as a class does, so it is planned with the classes.
            let planned = LIST[CLASS_INSTANCE](ordered)

            for (array, _) in _class_set.arrays do
                planned.add(array)
            od

            group.add_range(_dispatch.plan(planned, DESCRIPTOR_TYPE_INDEX + group.count))

            let first = _module.add_rec_group(group)

            assert first == DESCRIPTOR_TYPE_INDEX else "the object model's types must come first"

            for type in ordered do
                _add_descriptor_global(type)
            od

            // An array's descriptor refers to its element's, so the arrays'
            // are added after every class's.
            for (array, _) in _class_set.arrays do
                _add_descriptor_global(array)
            od

            for type in _descriptor_only do
                _add_descriptor_global(type)
            od

            _closure_descriptor = LIST[INSTRUCTION]()
            _closure_descriptor_global =
                _module.add_global(
                    GLOBAL(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false), false, _closure_descriptor))

            for type in ordered do
                if !_class_set.is_box(type) /\ type != object then
                    _add_statics(type)
                fi
            od

            _add_namespace_globals()

            for type in ordered do
                if type.definition.is_unit_variant then
                    _add_unit_variant_global(type)
                fi
            od
        si

        /// Fills in the descriptors and adds the trait table, once the walk
        /// has reached everything. The descriptors' global indices are fixed
        /// by `build`.
        finish(numbering: WASMGC_FUNCTION_NUMBERING) is
            _functions = numbering

            _dispatch.finish(_module, numbering)

            for type in _ordered do
                _fill_descriptor(type)
            od

            for (array, element) in _class_set.arrays do
                _fill_array_descriptor(array, element)
            od

            for type in _descriptor_only do
                _fill_descriptor_only(type)
            od

            // A function value is numbered after every class and array type,
            // so no class or trait test matches one.
            let closure_id = _class_set.numbering.last_descendant(_object!) + 1

            _closure_descriptor.add(I32_CONSTANT(closure_id))
            _closure_descriptor.add(I32_CONSTANT(closure_id))
            _closure_descriptor.add(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _descriptor_globals[_object!]))
            _closure_descriptor.add_range(chars_of("function"))

            // A function value answers the root's methods as any object does.
            if let vtable = _dispatch.vtable(_object!, numbering) then
                _closure_descriptor.add_range(vtable)
            else
                _closure_descriptor.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.STRUCT)))
            fi
            _end_descriptor(
                _closure_descriptor,
                _no_displayer,
                _no_displayer,
                if let describer = _closure_describer then INDEX_INSTRUCTION(Opcode.REF_FUNC, describer) else _no_displayer fi)
        si

        /// Records that the program renders values for display, through
        /// the core library's state class `state`.
        note_display(state: CLASS_INSTANCE) is
            _display_state = state
        si

        /// The core library's display state class, where something the
        /// program reaches renders values for display.
        display_state: CLASS_INSTANCE? => _display_state

        /// The signature of a displayer: the value and the display state,
        /// both as objects.
        display_signature: int is
            if discovering then
                return 0
            fi

            if let signature = _display_signature then
                return signature
            fi

            let signature = _module.add_type(FUNC_TYPE([object_reference, object_reference], []))

            _display_signature = signature

            return signature
        si

        /// Makes the function numbered `index` the displayer of `type`.
        set_displayer(type: CLASS_INSTANCE, index: int) is
            _displayers[type] = index
            _closure_thunks.add(index)
        si

        _displayer_of(type: CLASS_INSTANCE) -> INSTRUCTION is
            let index mut = 0

            if _displayers.try_get_value(type, index ref) then
                return INDEX_INSTRUCTION(Opcode.REF_FUNC, index)
            fi

            return _no_displayer
        si

        _no_displayer: INSTRUCTION => HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.FUNC))

        /// Records that something the program reaches copies an object with
        /// memberwise_clone, so every class gets a function that copies it.
        note_clone() is
            _clones_wanted = true
        si

        /// Whether something the program reaches copies an object with
        /// memberwise_clone.
        clones_wanted: bool => _clones_wanted

        /// The signature of a cloner: the object to copy, and the copy, both
        /// as objects.
        clone_signature: int is
            if discovering then
                return 0
            fi

            if let signature = _clone_signature then
                return signature
            fi

            let signature = _module.add_type(FUNC_TYPE([object_reference], [object_reference]))

            _clone_signature = signature

            return signature
        si

        /// Makes the function numbered `index` the cloner of `type`.
        set_cloner(type: CLASS_INSTANCE, index: int) is
            _cloners[type] = index
            _closure_thunks.add(index)
        si

        /// The function numbered as the cloner of `type`, or null where it has
        /// none.
        cloner_of(type: CLASS_INSTANCE) -> int? is
            let index mut = 0

            if _cloners.try_get_value(type, index ref) then
                return index
            fi

            return null
        si

        _cloner_reference(type: CLASS_INSTANCE) -> INSTRUCTION =>
            if let index = cloner_of(type) then INDEX_INSTRUCTION(Opcode.REF_FUNC, index) else _no_displayer fi

        /// What each type's description calls, where the build describes
        /// the program's types for reflection and the core library's type
        /// object takes a description; null otherwise.
        rtti_plan: RTTI_PLAN? is
            if !_rtti_planned then
                _rtti_planned = true

                if IoC.CONTAINER.instance.build_flags.want_rtti then
                    if let description = RTTI_PLAN.description_class(class_of(*)) then
                        _rtti_plan = RTTI_PLAN(self, description, () -> Collections.Iterable[CLASS_INSTANCE] => _descriptor_only)
                    fi
                fi
            fi

            return _rtti_plan
        si

        /// Makes the function numbered `index` the describer of `type`.
        set_describer(type: CLASS_INSTANCE, index: int) is
            _describers[type] = index
            _closure_thunks.add(index)
        si

        /// Makes the function numbered `index` the describer every function
        /// value's type shares.
        set_closure_describer(index: int) is
            _closure_describer = index
            _closure_thunks.add(index)
        si

        /// Records that the function numbered `index` is referenced as a
        /// function value, which a module has to declare.
        note_function_value(index: int) is
            _closure_thunks.add(index)
        si

        _describer_of(type: CLASS_INSTANCE) -> INSTRUCTION is
            let index mut = 0

            if _describers.try_get_value(type, index ref) then
                return INDEX_INSTRUCTION(Opcode.REF_FUNC, index)
            fi

            return _no_displayer
        si

        // A function value: its descriptor, the function to call, and the
        // receiver or captured frame it is called with, null for none.
        _closure_struct() -> STRUCT_TYPE =>
            STRUCT_TYPE([
                FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false), false),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_abstract(AbstractHeapType.FUNC), false),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(OBJECT_TYPE_INDEX, true), false)
            ])

        /// The struct type a function value is held in.
        closure_type_index: int => _closure_type_index

        /// The global holding the descriptor every function value has.
        closure_descriptor_global: int => _closure_descriptor_global

        /// The signature a call through a value of the function type `type`
        /// uses: the receiver or frame as the root, then the parameters,
        /// then the result, each reference held as the root, so function
        /// types that differ only in reference types one converts to by
        /// variance share a signature. Null where one of them cannot be
        /// held yet.
        closure_signature(type: Type) -> int? is
            let arguments = type.arguments
            let parameter_count = if type.is_action then arguments.count else arguments.count - 1 fi

            let parameters = LIST[VALUE_TYPE]()

            parameters.add(object_reference)

            for i in 0..parameter_count do
                if let value_type = value_type(arguments[i]) then
                    parameters.add(_erased(value_type))
                else
                    return null
                fi
            od

            let results = LIST[VALUE_TYPE]()

            if !type.is_action /\ !WASMGC_TYPES.is_void(arguments[arguments.count - 1]) then
                if let value_type = value_type(arguments[arguments.count - 1]) then
                    results.add(_erased(value_type))
                else
                    return null
                fi
            fi

            if discovering then
                return 0
            fi

            return _module.add_type(FUNC_TYPE(parameters.to_array(), results.to_array()))
        si

        // A reference held as the root, as a function value's signature
        // holds its references.
        _erased(value_type: VALUE_TYPE) -> VALUE_TYPE =>
            if value_type.heap_type()? then object_reference else value_type fi

        // Loads parameter `local` of a thunk, cast from the root its
        // signature holds it as to `expected`, the type the function it
        // calls takes.
        _forward(body: LIST[INSTRUCTION], local: int, expected: VALUE_TYPE?) is
            body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, local))

            if let heap_type = expected?.heap_type() /\ !heap_type.matches(object_reference.heap_type()!) then
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, heap_type))
            fi
        si

        /// The thunk a function value of `signature` holding `function`
        /// calls, reserved in `numbering`. It casts the receiver or frame it
        /// is given to the type the function takes, or ignores it where the
        /// function takes none, and calls the function. Where the value is
        /// closed over the function's first argument, what it is given is
        /// that argument. Nothing is reserved while discovering.
        closure_thunk(signature: int, function: FUNCTION_INSTANCE, discards_result: bool, closes_over_first: bool, numbering: WASMGC_FUNCTION_NUMBERING) -> int is
            if discovering then
                return 0
            fi

            let registry = self

            let index = numbering.reserve(() is
                let body = LIST[INSTRUCTION]()

                let definition = function.definition

                if definition.is_emitted_with_receiver then
                    body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))

                    if let receiver = registry.receiver_type(function) then
                        if let heap_type = receiver.heap_type() /\ !heap_type.matches(registry.object_reference.heap_type()!) then
                            body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, heap_type))
                        fi
                    fi
                fi

                if closes_over_first then
                    body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))

                    if let first = registry.value_type(function.specialize(definition.arguments[0])), heap_type = first.heap_type() then
                        body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, heap_type))
                    fi

                    for i in 1..definition.arguments.count do
                        registry._forward(body, i, registry.value_type(function.specialize(definition.arguments[i])))
                    od
                else
                    for i in 0..definition.arguments.count do
                        registry._forward(body, i + 1, registry.value_type(function.specialize(definition.arguments[i])))
                    od
                fi

                body.add(INDEX_INSTRUCTION(Opcode.CALL, numbering.indexed(function)!))

                if discards_result then
                    body.add(Wasm.SIMPLE_INSTRUCTION(Opcode.DROP))
                fi

                return Wasm.FUNCTION(signature, [], body)
            si)

            _closure_thunks.add(index)

            return index
        si

        /// The thunk a function value of `signature` holding an overridden
        /// method calls, reserved in `numbering`. It calls through the
        /// receiver's vtable at `slot`, so the value runs whichever override
        /// the receiver has. Nothing is reserved while discovering.
        closure_virtual_thunk(signature: int, slot: DISPATCH_SLOT, parameter_types: VALUE_TYPE?[], discards_result: bool, numbering: WASMGC_FUNCTION_NUMBERING) -> int is
            if discovering then
                return 0
            fi

            let registry = self

            let index = numbering.reserve(() is
                let body = LIST[INSTRUCTION]()

                let vtable_type = registry.dispatch.vtable_type(slot.owner)!

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, HEAP_TYPE.of_type_index(registry.type_index(slot.owner)!)))

                for i in 0..parameter_types.count do
                    registry._forward(body, i + 1, parameter_types[i])
                od

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, OBJECT_TYPE_INDEX, 0))
                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, DESCRIPTOR_TYPE_INDEX, DESCRIPTOR_VTABLE))
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(vtable_type)))
                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, vtable_type, slot.index))
                body.add(TYPE_INSTRUCTION(Opcode.CALL_REF, slot.signature))

                if discards_result then
                    body.add(Wasm.SIMPLE_INSTRUCTION(Opcode.DROP))
                fi

                return Wasm.FUNCTION(signature, [], body)
            si)

            _closure_thunks.add(index)

            return index
        si

        /// The thunk a function value of `signature` holding a trait method
        /// calls, reserved in `numbering`. It calls through the dispatch table
        /// row `selector` names, at the receiver's class, so the value runs
        /// whichever implementation the receiver has. Nothing is reserved
        /// while discovering.
        closure_interface_thunk(signature: int, selector: TRAIT_SELECTOR, parameter_types: VALUE_TYPE?[], discards_result: bool, numbering: WASMGC_FUNCTION_NUMBERING) -> int is
            if discovering then
                return 0
            fi

            let registry = self

            let index = numbering.reserve(() is
                let body = LIST[INSTRUCTION]()

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, HEAP_TYPE.of_type_index(OBJECT_TYPE_INDEX)))

                for i in 0..parameter_types.count do
                    registry._forward(body, i + 1, parameter_types[i])
                od

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(OBJECT_TYPE_INDEX)))
                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, OBJECT_TYPE_INDEX, 0))
                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, DESCRIPTOR_TYPE_INDEX, DESCRIPTOR_CLASS_ID))
                body.add(I32_CONSTANT(selector.offset))
                body.add(Wasm.SIMPLE_INSTRUCTION(Opcode.I32_ADD))
                body.add(CALL_INDIRECT_INSTRUCTION(selector.signature, 0))

                if discards_result then
                    body.add(Wasm.SIMPLE_INSTRUCTION(Opcode.DROP))
                fi

                return Wasm.FUNCTION(signature, [], body)
            si)

            _closure_thunks.add(index)

            return index
        si

        /// The thunks function values hold, which a module has to declare,
        /// since bodies name them with ref.func.
        closure_thunks: LIST[int] => _closure_thunks


        /// The type the instance of `function` receives `self` as: its
        /// class, or the frame of a closure body, or the root for a trait's
        /// default method. Null where it has no receiver the object model
        /// holds.
        receiver_type(function: FUNCTION_INSTANCE) -> VALUE_TYPE? is
            let definition = function.definition

            if let closure: Semantic.Symbols.Closure = definition /\ closure.frame? then
                // A generic body's frame is instantiated at the arguments the
                // closure was compiled with, which its own type does not carry.
                if let frame = class_of(closure.frame, function.type_map) /\ is_object_type(frame) then
                    return VALUE_TYPE.of_type_index(type_index(frame)!, true)
                fi
            elif let owner = FUNCTION_BODIES.owning_class(definition) /\ owner == _class_set.core.array_definition then
                for (parameter, element) in function.type_map do
                    if parameter.owner == owner then
                        let lookup = IoC.CONTAINER.instance.innate_symbol_lookup

                        if let array = array_of(lookup.get_array_type(element)) then
                            return VALUE_TYPE.of_type_index(type_index(array)!, true)
                        fi
                    fi
                od
            elif let owner = FUNCTION_BODIES.owning_class(definition) /\ (owner.is_trait \/ owner.is_object) then
                return object_reference
            elif let owner = FUNCTION_BODIES.owning_class(definition) then
                if let type = class_of(owner, function.type_map) /\ is_object_type(type) then
                    return VALUE_TYPE.of_type_index(type_index(type)!, true)
                elif owner == _string?.definition /\ string_type_index? then
                    return VALUE_TYPE.of_type_index(string_type_index!, true)
                elif let scalar = WASMGC_TYPES.scalar(Semantic.Types.NAMED(owner)) then
                    // A method the core library gives a scalar takes the
                    // value itself.
                    return WASMGC_TYPES.value_type(scalar)
                fi
            fi

            return null
        si

        /// The array type `type` is, added while discovering. Null where
        /// `type` is not an array, or where its elements are of a type the
        /// target cannot hold yet.
        array_of(type: Type?) -> CLASS_INSTANCE? => _class_set.array_of(type)

        /// Every class the registry holds, and every array type.
        classes_and_arrays: CLASS_INSTANCE[] => _class_set.classes_and_arrays

        /// The class numbers of every array type a value of the array type
        /// `type` can be: `type` itself and, where its element is a
        /// reference type, every array type whose element is a subtype of
        /// it, as an array of a class is an array of its superclass. Empty
        /// while discovering, since nothing is numbered yet.
        array_class_ids(type: CLASS_INSTANCE) -> int[] is
            let result = LIST[int]()

            if discovering then
                return result
            fi

            let target = _class_set.array_element(type)

            for (array, element) in _class_set.arrays do
                if
                    array =~ type \/
                    (!target.is_value_type /\ !element.is_value_type /\ target.is_assignable_from(element))
                then
                    result.add(_class_set.numbering.id(array))
                fi
            od

            return result
        si

        /// Whether `type` is an array type.
        is_array(type: CLASS_INSTANCE) -> bool => _class_set.is_array(type)

        /// The element type of the array type `type`.
        array_element(type: CLASS_INSTANCE) -> Type => _class_set.array_element(type)

        /// The struct type an array of `type` is held in, the array type its
        /// elements are held in, the type of an element as read: a scalar
        /// as itself, a narrow scalar as an `i32`, and any reference as a
        /// reference to the root, and the instruction that reads one.
        array_storage(type: CLASS_INSTANCE) -> (struct_index: int, data_index: int, element: VALUE_TYPE, get: Opcode) is
            let element_type = _class_set.array_element(type)
            let storage = _array_storage(element_type)!
            let element = _array_storage_value_type(storage)
            let get = _array_get(storage, element_type)

            if discovering then
                return (OBJECT_TYPE_INDEX, OBJECT_TYPE_INDEX, element, get)
            fi

            let struct_index = _array_storage_types[storage]

            return (struct_index, struct_index + 1, element, get)
        si

        /// Whether storing a reference into an array of `type` has to check
        /// that the array was made for it: an array of a class with no
        /// subclasses can only be an array of exactly that class.
        array_store_is_checked(type: CLASS_INSTANCE) -> bool is
            let element = _class_set.array_element(type)

            if WASMGC_TYPES.scalar(element)? then
                return false
            fi

            if let held = class_of(element) /\ _type_indices.contains_key(held) then
                return may_gain_children(held)
            fi

            return true
        si

        /// Whether `type` can gain a subclass after this build: a
        /// session-step build never emits a final class, since a later
        /// step of the session can subclass any class it sees.
        may_gain_children(type: CLASS_INSTANCE) -> bool =>
            _class_set.numbering.has_children(type) \/ _session_step

        // Whether the target can hold an array of `element`, recording the
        // storage such an array takes when it can.
        _holds_array_of(element: Type) -> bool is
            if let storage = _array_storage(element) then
                _array_storages.add(storage)

                return true
            fi

            return false
        si

        // How the elements of an array of `element` are held: one of the
        // four numeric types, a reference, or a packed `i8` or `i16` for a
        // scalar narrower than 32 bits. Null where the target cannot hold an
        // `element`.
        _array_storage(element: Type) -> int? is
            let value_type = value_type(element)

            if !value_type? then
                return null
            fi

            if let scalar = WASMGC_TYPES.scalar(element) /\ WASMGC_TYPES.is_narrow(scalar) then
                return
                    case scalar
                    when Scalar.BOOL, Scalar.INT8, Scalar.UINT8 then 5
                    else 6
                    esac
            fi

            if let numeric = value_type.numeric() then
                return
                    case numeric
                    when NumericType.I32 then 0
                    when NumericType.I64 then 1
                    when NumericType.F32 then 2
                    when NumericType.F64 then 3
                    else null
                    esac
            fi

            return 4
        si

        _array_storage_value_type(storage: int) -> VALUE_TYPE =>
            case storage
            when 0 then VALUE_TYPE.of_numeric(NumericType.I32)
            when 1 then VALUE_TYPE.of_numeric(NumericType.I64)
            when 2 then VALUE_TYPE.of_numeric(NumericType.F32)
            when 3 then VALUE_TYPE.of_numeric(NumericType.F64)
            when 5, 6 then VALUE_TYPE.of_numeric(NumericType.I32)
            else object_reference
            esac

        // The packed type a narrow storage holds its elements in.
        _array_storage_packed_type(storage: int) -> PackedType? =>
            case storage
            when 5 then PackedType.I8
            when 6 then PackedType.I16
            else null
            esac

        // A packed element is read extended to an `i32`, by zero for an
        // unsigned element and by sign otherwise.
        _array_get(storage: int, element: Type) -> Opcode is
            if !_array_storage_packed_type(storage)? then
                return Opcode.ARRAY_GET
            fi

            if let scalar = WASMGC_TYPES.scalar(element) /\ WASMGC_TYPES.is_unsigned(scalar) then
                return Opcode.ARRAY_GET_U
            fi

            return Opcode.ARRAY_GET_S
        si

        // The type indices of the array types, from `first` on: a struct
        // and its element array for each way of holding elements the
        // program's arrays use. Every array type takes the struct of its
        // element storage.
        _number_array_types(first: int) is
            let next mut = first

            for storage in 0::6 do
                if _array_storages.contains(storage) then
                    _array_storage_types[storage] = next
                    next = next + 2
                fi
            od

            for (array, element) in _class_set.arrays do
                _type_indices[array] = _array_storage_types[_array_storage(element)!]
            od
        si

        // For each way of holding elements the program's arrays use, a
        // final struct under the root holding the descriptor, the elements
        // and the element descriptor, then the mutable array of the
        // elements.
        _add_array_types(group: LIST[SUB_TYPE]) is
            for storage in 0::6 do
                if !_array_storages.contains(storage) then
                    continue
                fi

                let struct_index = DESCRIPTOR_TYPE_INDEX + group.count
                let element = _array_storage_value_type(storage)

                assert _array_storage_types[storage] == struct_index else "array types are numbered where they are added"

                // The element descriptor is held by each array rather than
                // its descriptor, whose vtable slot holds the array type's
                // vtable.
                group.add(
                    SUB_TYPE(
                        STRUCT_TYPE([
                            FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false), false),
                            FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(struct_index + 1, false), false),
                            FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, true), false)
                        ]),
                        true,
                        [OBJECT_TYPE_INDEX]))

                let element_field =
                    if let packed = _array_storage_packed_type(storage) then
                        FIELD_TYPE.of_packed(packed, true)
                    elif let numeric = element.numeric() then
                        FIELD_TYPE(numeric, true)
                    else
                        FIELD_TYPE.of_reference(element, true)
                    fi

                group.add(SUB_TYPE(ARRAY_TYPE(element_field), true, []))
            od
        si

        // An array type is planned with the classes, so its descriptor
        // holds a vtable of its own, starting with the root's methods.
        _fill_array_descriptor(array: CLASS_INSTANCE, element: Type) is
            let initialiser = _initialisers[array]

            initialiser.add(I32_CONSTANT(_class_set.numbering.id(array)))
            initialiser.add(I32_CONSTANT(_class_set.numbering.last_descendant(array)))
            initialiser.add(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _descriptor_globals[_object!]))
            initialiser.add_range(chars_of("{_display_name(element)}[]"))

            if let vtable = _dispatch.vtable(array, _functions!) then
                initialiser.add_range(vtable)
            else
                initialiser.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.STRUCT)))
            fi

            _end_descriptor(initialiser, _displayer_of(array), _no_displayer, _describer_of(array))
        si

        // A descriptor-only type has no class number a value could carry, no
        // superclass and no vtable: its descriptor serves `typeof` and
        // reflection only.
        _fill_descriptor_only(type: CLASS_INSTANCE) is
            let initialiser = _initialisers[type]

            initialiser.add(I32_CONSTANT(-1))
            initialiser.add(I32_CONSTANT(-2))
            initialiser.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX)))
            initialiser.add_range(chars_of(display_name(type)))
            initialiser.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.STRUCT)))

            _end_descriptor(initialiser, _no_displayer, _no_displayer, _describer_of(type))
        si

        /// The global holding the descriptor of the class the elements of
        /// an array of `type` are made to hold, which a store into the
        /// array is checked against, or null where no check is needed: the
        /// elements are scalars, or of a trait, or of the root.
        array_element_descriptor(type: CLASS_INSTANCE) -> int? is
            if discovering then
                return null
            fi

            let element = _class_set.array_element(type)

            if WASMGC_TYPES.scalar(element)? then
                return null
            fi

            if let element_class = class_of(element) /\ element_class != _object /\ _descriptor_globals.contains_key(element_class) then
                return _descriptor_globals[element_class]
            fi

            return null
        si

        /// The class `type` extends, or null where that is the root.
        superclass_of(type: CLASS_INSTANCE) -> CLASS_INSTANCE? => _class_set.superclass_of(type)

        // A descriptor's type object is made the first time one is asked
        // for, so every descriptor starts without one; its displayer, its
        // cloner and its describer are known when the descriptor is built.
        _end_descriptor(initialiser: LIST[INSTRUCTION], displayer: INSTRUCTION, cloner: INSTRUCTION, describer: INSTRUCTION) is
            initialiser.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.STRUCT)))
            initialiser.add(displayer)
            initialiser.add(cloner)

            if _describes_types then
                initialiser.add(describer)
            fi

            initialiser.add(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, DESCRIPTOR_TYPE_INDEX))
        si

        /// The name `type`'s descriptor carries: the name .NET gives the
        /// same type, so a type's name reads the same on either target.
        display_name(type: CLASS_INSTANCE) -> string =>
            TYPE_NAMES.name_of(type, _class_set, _string, WASMGC_TYPES.scalar(*), WASMGC_TYPES.is_string(*))

        _display_name(type: Type) -> string =>
            TYPE_NAMES.name_of(type, _class_set, _string, WASMGC_TYPES.scalar(*), WASMGC_TYPES.is_string(*))

        // A descriptor holds its describer only where the build describes
        // the program's types, so a build without --rtti is laid out as
        // before.
        _descriptor_struct() -> STRUCT_TYPE is
            let fields = LIST[FIELD_TYPE]([
                FIELD_TYPE(NumericType.I32, false),
                FIELD_TYPE(NumericType.I32, false),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, true), false),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(CHARS_TYPE_INDEX, false), false),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_abstract(AbstractHeapType.STRUCT), false),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_abstract(AbstractHeapType.STRUCT), true),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_abstract(AbstractHeapType.FUNC), false),
                FIELD_TYPE.of_reference(VALUE_TYPE.of_abstract(AbstractHeapType.FUNC), false)
            ]: FIELD_TYPE)

            if _describes_types then
                fields.add(FIELD_TYPE.of_reference(VALUE_TYPE.of_abstract(AbstractHeapType.FUNC), false))
            fi

            return STRUCT_TYPE(fields.to_array())
        si

        _describes_types: bool => IoC.CONTAINER.instance.build_flags.want_rtti

        // Every scalar a program can box: a box is a final struct holding
        // the descriptor of the scalar's type and the value.
        _scalar_types() -> Type[] => CLASS_SET.innate_scalar_types()

        _sub_type(type: CLASS_INSTANCE) -> SUB_TYPE is
            let layout = LIST[VALUE_TYPE]()

            if let boxed = _class_set.boxed_type(type) then
                layout.add(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false))
                layout.add(value_type(boxed)!)

                _layouts[type] = layout
                let box_types = LIST[Type?]()
                box_types.add(null)
                box_types.add(boxed)
                _layout_types[type] = box_types

                return SUB_TYPE(_struct(layout), true, [OBJECT_TYPE_INDEX])
            fi

            if type == _object then
                layout.add(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false))

                _layouts[type] = layout
                let root_types = LIST[Type?]()
                root_types.add(null)
                _layout_types[type] = root_types

                return SUB_TYPE(_struct(layout), false, [])
            fi

            if type == _string then
                layout.add(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false))
                layout.add(VALUE_TYPE.of_numeric(NumericType.I32))
                layout.add(VALUE_TYPE.of_type_index(CHARS_TYPE_INDEX, false))

                _layouts[type] = layout

                return SUB_TYPE(
                    STRUCT_TYPE([
                        FIELD_TYPE.of_reference(layout[0], false),
                        FIELD_TYPE(NumericType.I32, true),
                        FIELD_TYPE.of_reference(layout[2], false)
                    ]),
                    true,
                    [OBJECT_TYPE_INDEX])
            fi

            // A bigint holds its value in an i64 while it fits, and
            // otherwise the host's arbitrary-precision integer, which no
            // ghūl type describes. The host's field is null exactly when the
            // i64 holds the value.
            if is_bigint(type) then
                layout.add(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false))
                layout.add(VALUE_TYPE.of_numeric(NumericType.I64))
                layout.add(VALUE_TYPE.of_abstract(AbstractHeapType.EXTERN))

                _layouts[type] = layout
                let bigint_types = LIST[Type?]()
                bigint_types.add(null)
                bigint_types.add(null)
                bigint_types.add(null)
                _layout_types[type] = bigint_types

                return SUB_TYPE(_struct(layout), true, [OBJECT_TYPE_INDEX])
            fi

            let parent = _class_set.superclass_of(type) ?? _object!
            let layout_types = LIST[Type?]()

            for inherited in _layouts[parent] do
                layout.add(inherited)
            od

            for inherited in _layout_types_of(parent) do
                layout_types.add(inherited)
            od

            for `field in SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(type.definition)) do
                if `field.is_instance then
                    _field_positions[`field] = layout.count

                    layout.add(_field_value_type(`field, type))
                    layout_types.add(type.specialize(`field.type))
                fi
            od

            _layouts[type] = layout
            _layout_types[type] = layout_types

            return SUB_TYPE(
                _struct(layout),
                !may_gain_children(type),
                [_type_indices[parent]])
        si

        // Field 0, the descriptor, never changes; every other field can be
        // assigned.
        _struct(layout: LIST[VALUE_TYPE]) -> STRUCT_TYPE is
            let fields = LIST[FIELD_TYPE]()

            for i in 0..layout.count do
                let value_type = layout[i]
                let mutable = i > 0

                if let numeric = value_type.numeric() then
                    fields.add(FIELD_TYPE(numeric, mutable))
                else
                    fields.add(FIELD_TYPE.of_reference(value_type, mutable))
                fi
            od

            return STRUCT_TYPE(fields.to_array())
        si

        _field_value_type(`field: Field, owner: CLASS_INSTANCE?) -> VALUE_TYPE is
            let type = if let o = owner then o.specialize(`field.type) else `field.type fi

            if let value_type = value_type(type) then
                return value_type
            fi

            if !owner? \/ !_class_set.field_types_left_out(owner) then
                _unsupported.add((`field.location, "a field of type {type}"))
            fi

            return object_reference
        si

        // A descriptor's global takes its index when the types are built,
        // so lowering can name it, and its initialiser is filled in by
        // `finish`, once the functions its vtable refers to are numbered.
        _add_descriptor_global(type: CLASS_INSTANCE) is
            let initialiser = LIST[INSTRUCTION]()

            _initialisers[type] = initialiser

            _descriptor_globals[type] =
                _module.add_global(
                    GLOBAL(VALUE_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX, false), false, initialiser))
        si

        _fill_descriptor(type: CLASS_INSTANCE) is
            let initialiser = _initialisers[type]

            initialiser.add(I32_CONSTANT(_class_set.numbering.id(type)))
            initialiser.add(I32_CONSTANT(_class_set.numbering.last_descendant(type)))

            if type == _object then
                initialiser.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_type_index(DESCRIPTOR_TYPE_INDEX)))
            else
                initialiser.add(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _descriptor_globals[_class_set.superclass_of(type) ?? _object!]))
            fi

            for instruction in chars_of(display_name(type)) do
                initialiser.add(instruction)
            od

            if let vtable = _dispatch.vtable(type, _functions!) then
                initialiser.add_range(vtable)
            else
                initialiser.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.STRUCT)))
            fi

            _end_descriptor(initialiser, _displayer_of(type), _cloner_reference(type), _describer_of(type))
        si

        // A class's static fields are globals, each instantiation of a
        // generic class having its own, as on .NET. So is its static
        // constructor's flag.
        _add_statics(type: CLASS_INSTANCE) is
            let emitted = SRM_EMITTED_TYPE(type.definition)

            for method in SRM_MEMBER_ORDER.methods(emitted) do
                if method.is_static_constructor then
                    _static_constructors[type] =
                        (
                            FUNCTION_INSTANCE(method, type.type_map),
                            _module.add_global(GLOBAL(VALUE_TYPE.of_numeric(NumericType.I32), true, [I32_CONSTANT(0)]))
                        )
                fi
            od

            for `field in SRM_MEMBER_ORDER.fields(emitted) do
                if `field.is_instance \/ isa Semantic.Symbols.CONSTANT_FIELD(`field) then
                    continue
                fi

                let value_type = _field_value_type(`field, type)

                _statics[(`field, type)] =
                    (_module.add_global(GLOBAL(value_type, true, [default_value(value_type)])), value_type)
            od
        si

        // Namespace-level variables are globals, each starting at its
        // type's default value. A static constructor anywhere the object
        // model does not hold a class is reported.
        _add_namespace_globals() is
            let root = IoC.CONTAINER.instance.symbol_table.global_scope

            for type in SRM_MEMBER_ORDER.types(root) do
                if type.is_globals_carrier then
                    for `field in SRM_MEMBER_ORDER.fields(type) do
                        if `field.is_instance \/ isa Semantic.Symbols.CONSTANT_FIELD(`field) then
                            continue
                        fi

                        let value_type = _field_value_type(`field, null)

                        _namespace_globals[`field] =
                            (_module.add_global(GLOBAL(value_type, true, [default_value(value_type)])), value_type)
                    od
                elif let declared = type.declared /\ !_class_set.is_object_type(declared) then
                    for method in SRM_MEMBER_ORDER.methods(type) do
                        if method.is_static_constructor then
                            _unsupported.add((method.location, "a static constructor"))
                        fi
                    od
                fi
            od
        si

        // A unit variant is one shared instance for each instantiation,
        // built once, holding the default value of every field it inherits.
        _add_unit_variant_global(variant: CLASS_INSTANCE) is
            _unit_variant_globals[variant] =
                _module.add_global(
                    GLOBAL(
                        VALUE_TYPE.of_type_index(_type_indices[variant], false),
                        false,
                        new_instance(variant)))
        si

        /// The instructions that give the default value of the struct
        /// `type`: for a read-only struct, whose box nothing changes once it
        /// is built, the one instance every default of the type shares;
        /// otherwise a fresh instance.
        default_instance(type: CLASS_INSTANCE) -> LIST[INSTRUCTION] is
            if discovering \/ !is_read_only(type) then
                return new_instance(type)
            fi

            let index mut = 0

            if !_shared_defaults.try_get_value(type, index ref) then
                index =
                    _module.add_global(
                        GLOBAL(VALUE_TYPE.of_type_index(_type_indices[type], false), false, new_instance(type)))

                _shared_defaults[type] = index
            fi

            return LIST[INSTRUCTION]([INDEX_INSTRUCTION(Opcode.GLOBAL_GET, index)])
        si

        /// The constant expression that builds an instance of `type` with
        /// every field at its default value.
        new_instance(type: CLASS_INSTANCE) -> LIST[INSTRUCTION] is
            let result = LIST[INSTRUCTION]()

            if discovering then
                return result
            fi

            result.add(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _descriptor_globals[type]))

            let layout = _layouts[type]
            let layout_types = _layout_types_of(type)

            for i in 1..layout.count do
                // A struct-typed field holds a box from the start, so it is
                // never null where a value of its type is expected.
                if let held = if i < layout_types.count then struct_of(layout_types[i]) else null fi then
                    result.add_range(new_instance(held))
                else
                    result.add(default_value(layout[i]))
                fi
            od

            result.add(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, _type_indices[type]))

            return result
        si

        /// The constant expression that builds the code units of `text`.
        chars_of(text: string) -> LIST[INSTRUCTION] is
            let result = LIST[INSTRUCTION]()

            for c in text do
                result.add(I32_CONSTANT(int(c)))
            od

            result.add(TYPE_LENGTH_INSTRUCTION(Opcode.ARRAY_NEW_FIXED, CHARS_TYPE_INDEX, text.length))

            return result
        si

        /// Whether the program has a string type, which it does once the
        /// core library declares one.
        has_string_type: bool => _string?

        /// Whether `type` is the string type.
        is_string(type: CLASS_INSTANCE) -> bool => type == _string

        /// Whether `type` is `bigint`, whose box holds its value as an i64 in
        /// field 1 while it fits, and otherwise the host's integer as an
        /// `externref` in field 2.
        is_bigint(type: CLASS_INSTANCE) -> bool =>
            type.definition == IoC.CONTAINER.instance.innate_symbol_lookup.get_bigint_type().symbol

        _layout_types_of(type: CLASS_INSTANCE) -> LIST[Type?] is
            let result: LIST[Type?] mut

            if _layout_types.try_get_value(type, result ref) then
                return result
            fi

            return LIST[Type?]()
        si

        /// The ghūl types of a class's fields, in layout order, with null for
        /// the descriptor.
        field_types(type: CLASS_INSTANCE) -> Type?[] => _layout_types_of(type)

        /// The wasm types of a class's fields, in layout order, the
        /// descriptor first.
        field_value_types(type: CLASS_INSTANCE) -> VALUE_TYPE[] => _layouts[type]

        /// Whether `type` is a struct, which is held in a box of its own. A
        /// scalar's box is not one: its definition is the scalar's.
        is_struct(type: CLASS_INSTANCE) -> bool =>
            isa Semantic.Symbols.STRUCT(type.definition) /\ !is_box(type) /\ _class_set.is_object_type(type.definition)

        /// The struct a value of `type` is a box of, or null where `type` is
        /// not a struct the registry holds. An optional struct is not one:
        /// it is a reference that can be null. Nor is an enum, a value type
        /// held as its int.
        struct_of(type: Type?) -> CLASS_INSTANCE? is
            if !type? \/ (type.is_optional /\ !type.is_maybe) \/ !type.is_value_type \/ WASMGC_TYPES.scalar(type)? \/ WASMGC_TYPES.is_enum(type) then
                return null
            fi

            if let held = class_of(type) /\ is_struct(held) then
                return held
            fi

            return null
        si

        /// Whether a struct's box is never changed once built, so a value
        /// of it can share the box rather than copy it. That holds where
        /// every field backs a property and no instance member but a
        /// constructor stores anything.
        is_read_only(type: CLASS_INSTANCE) -> bool is
            let result: bool mut

            if _read_only.try_get_value(type, result ref) then
                return result
            fi

            result = _infer_read_only(type)
            _read_only[type] = result

            return result
        si

        /// The struct type a string is held in, or null where the registry
        /// knows no string type.
        string_type_index: int? => if let string_type = _string then type_index(string_type) else null fi

        /// The array type holding a string's UTF-16 code units.
        chars_type_index: int => CHARS_TYPE_INDEX

        /// The global holding the string type's descriptor, or null where
        /// the registry knows no string type.
        string_descriptor_global: int? =>
            if let string_type = _string then _descriptor_globals[string_type] else null fi

        _infer_read_only(type: CLASS_INSTANCE) -> bool is
            // A constructed struct is a tuple, which cannot be changed.
            if type.definition.location == LOCATION.internal then
                return true
            fi

            let emitted = SRM_EMITTED_TYPE(type.definition)

            for `field in SRM_MEMBER_ORDER.fields(emitted) do
                if `field.is_instance /\ !`field.name.starts_with('$') then
                    return false
                fi
            od

            for method in SRM_MEMBER_ORDER.methods(emitted) do
                if method.is_instance /\ !method.is_constructor /\ !method.is_proven_store_free then
                    return false
                fi
            od

            return true
        si

        /// The zero of a numeric type, or the null of a reference type.
        default_value(value_type: VALUE_TYPE) -> INSTRUCTION static =>
            case value_type.numeric()
            when NumericType.I64 then I64_CONSTANT(0L)
            when NumericType.F32 then F32_CONSTANT(0.0s)
            when NumericType.F64 then F64_CONSTANT(0.0)
            when NumericType.I32 then I32_CONSTANT(0)
            else HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, value_type.heap_type()!)
            esac

        /// The type a value of `type` is held in, or null where the target
        /// cannot hold it yet. A declared class is a reference to its
        /// struct; `object` and a trait are references to the root. `type`
        /// must have no type parameters left in it.
        value_type(type: Type?) -> VALUE_TYPE? is
            if !type? \/ type.is_void then
                return null
            fi

            if let scalar = WASMGC_TYPES.scalar(type) then
                return WASMGC_TYPES.value_type(scalar)
            fi

            // An enum is held as its underlying int, as its members are.
            if WASMGC_TYPES.is_enum(type) then
                return VALUE_TYPE.of_numeric(NumericType.I32)
            fi

            // The type of `null` itself, such as a tuple literal's element
            // before the tuple converts to the type it goes into, holds
            // nothing but null: the bottom reference, which goes wherever a
            // reference does.
            if isa Semantic.Types.NULL(type) then
                return VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.NONE)
            fi

            // A reference to a scalar is the box, the cell, the scalar
            // lives in, and a reference to a struct the struct's own box.
            if let reference: Semantic.Types.REFERENCE = type then
                let element = reference.arguments[0]

                if let index = box_index(element) then
                    return VALUE_TYPE.of_type_index(index, true)
                elif let held = struct_of(element) then
                    return VALUE_TYPE.of_type_index(type_index(held)!, true)
                elif reference_cell_value_type(element)? then
                    return VALUE_TYPE.of_type_index(reference_cell_type_index, true)
                fi

                return null
            fi
            // A value-type optional is a reference to the box of its value,
            // null where it is absent, as boxing it on .NET gives.
            if type.is_optional /\ type.is_value_type /\ !type.is_maybe then
                let inner = type.optional_inner_type

                if let index = box_index(inner) then
                    return VALUE_TYPE.of_type_index(index, true)
                elif let held = struct_of(inner) then
                    return VALUE_TYPE.of_type_index(type_index(held)!, true)
                fi

                return null
            fi

            if let held = struct_of(type) then
                return VALUE_TYPE.of_type_index(type_index(held)!, true)
            fi

            if type.is_value_type \/ type.is_type_variable then
                return null
            fi

            if let index = type_index(type) then
                return VALUE_TYPE.of_type_index(index, true)
            fi

            if type.is_function \/ type.is_action then
                return VALUE_TYPE.of_type_index(_closure_type_index, true)
            fi

            if type.is_trait \/ (cast Classy?(type.symbol)?.is_object ?? false) then
                return object_reference
            fi

            return null
        si

        /// The struct type a value of `type` is held in, or null where
        /// `type` is not a class the program declares.
        type_index(type: Type?) -> int? =>
            if let held = class_of(type) then type_index(held) else null fi

        /// The struct type of `type`, or null where it has none; while
        /// discovering, the root's.
        type_index(type: CLASS_INSTANCE) -> int? is
            if discovering then
                return OBJECT_TYPE_INDEX
            fi

            let index mut = 0

            if _type_indices.try_get_value(type, index ref) then
                return index
            fi

            return null
        si

        /// Whether `type` is a class with a struct type of its own.
        is_object_type(type: CLASS_INSTANCE) -> bool =>
            !is_box(type) /\ _class_set.is_object_type(type.definition)

        /// Whether `type` is a scalar's box rather than a class.
        is_box(type: CLASS_INSTANCE) -> bool => _class_set.is_box(type)

        /// The scalar type a box holds a value of, or null where `type` is
        /// not a box.
        boxed_type(type: CLASS_INSTANCE) -> Type? => _class_set.boxed_type(type)

        /// Where the instance field `field` lives in `owner`, the class
        /// declaring it, or null where the registry does not hold it.
        field_of(`field: Symbol, owner: CLASS_INSTANCE) -> WASMGC_FIELD? is
            let root = `field.root_specialized_from

            let position mut = 0

            if discovering then
                return WASMGC_FIELD(OBJECT_TYPE_INDEX, 0, object_reference)
            fi

            if !_field_positions.try_get_value(root, position ref) then
                return null
            fi

            let index = type_index(owner)

            if !index? then
                return null
            fi

            return WASMGC_FIELD(index, position, _layouts[owner][position])
        si

        /// The global holding the static field `field` of `owner`, or the
        /// namespace-level variable `field` where `owner` is null, and its
        /// type.
        global_of(`field: Symbol, owner: CLASS_INSTANCE?) -> (index: int, type: VALUE_TYPE)? is
            if discovering then
                return (0, object_reference)
            fi

            let root = `field.root_specialized_from
            let result: (index: int, type: VALUE_TYPE) mut

            if let o = owner then
                if _statics.try_get_value((root, o), result ref) then
                    return result
                fi
            elif _namespace_globals.try_get_value(root, result ref) then
                return result
            fi

            return null
        si

        /// The global holding the descriptor of `type`.
        descriptor_global(type: CLASS_INSTANCE) -> int =>
            if discovering then 0 else _descriptor_globals[type] fi

        /// Whether a reference held as `held` is usable as `expected`
        /// without a cast: the same type, or a class derived from it.
        is_held_as(held: HEAP_TYPE, expected: HEAP_TYPE) -> bool is
            if held.matches(expected) then
                return true
            fi

            // The bottom reference, which only null has, is held as any.
            if held.matches(HEAP_TYPE.of_abstract(Wasm.AbstractHeapType.NONE)) then
                return true
            fi

            let held_index = held.type_index()
            let expected_index = expected.type_index()

            if !held_index? \/ !expected_index? then
                return false
            fi

            let derived: CLASS_INSTANCE mut
            let base: CLASS_INSTANCE mut

            if
                !_classes_by_index.try_get_value(held_index, derived ref) \/
                !_classes_by_index.try_get_value(expected_index, base ref)
            then
                return false
            fi

            return is_subclass(derived, base)
        si

        /// The static constructor of `type`, and the global that records
        /// whether it has run, or null where `type` declares none.
        static_constructor(type: CLASS_INSTANCE) -> (constructor: FUNCTION_INSTANCE, initialised: int)? is
            if discovering then
                for method in SRM_MEMBER_ORDER.methods(SRM_EMITTED_TYPE(type.definition)) do
                    if method.is_static_constructor then
                        return (FUNCTION_INSTANCE(method, type.type_map), 0)
                    fi
                od

                return null
            fi

            let result: (constructor: FUNCTION_INSTANCE, initialised: int) mut

            if _static_constructors.try_get_value(type, result ref) then
                return result
            fi

            return null
        si

        /// The global holding a unit variant's shared instance.
        unit_variant_global(variant: CLASS_INSTANCE) -> int? is
            if discovering then
                return 0
            fi

            let index mut = 0

            if _unit_variant_globals.try_get_value(variant, index ref) then
                return index
            fi

            return null
        si

        /// Records that `local` has its address taken, so it lives in a
        /// cell, a box of its own, for its whole life.
        ///
        /// - local: the local whose address is taken
        mark_cell(local: IR.LOCAL) is
            _cells.add(local)
        si

        /// Whether `local` lives in a cell.
        ///
        /// - local: the local to ask about
        is_cell(local: IR.LOCAL) -> bool => _cells.contains(local)

        /// Records that the program boxes a value in `box`, which makes the
        /// methods the box answers reachable.
        note_boxed(box: CLASS_INSTANCE) is
            _boxes_made.add(box)
        si

        /// Whether a value of `type` can exist: a box only where something
        /// boxes a value in it.
        is_instantiated(type: CLASS_INSTANCE) -> bool =>
            !_class_set.is_box(type) \/ _boxes_made.contains(type)

        /// The struct type a reference to a value of reference type is held
        /// in: a cell with one field, `REFERENCE_CELL_VALUE`, holding any
        /// reference. While discovering, the root's.
        reference_cell_type_index: int is
            if discovering then
                _reference_cells_wanted = true

                return OBJECT_TYPE_INDEX
            fi

            assert _reference_cells_wanted else "a reference cell discovery did not find"

            return _reference_cell_type_index
        si

        /// The type a value of `type` is held in where a reference to it is
        /// a reference cell, or null where `type` is a scalar or a struct,
        /// whose references are their boxes, or a type the target cannot
        /// hold.
        ///
        /// - type: the type referred to, with no type parameters left in it
        reference_cell_value_type(type: Type?) -> VALUE_TYPE? is
            if box_index(type)? \/ struct_of(type)? then
                return null
            fi

            if let held = value_type(type) /\ held.heap_type()? then
                return held
            fi

            return null
        si

        /// The struct type a value of the scalar `type` is boxed in, or null
        /// where `type` is not a scalar.
        box_index(type: Type?) -> int? =>
            if let box = box_type(type) then type_index(box) else null fi

        /// The class whose descriptor stands for `type` at run time: its box
        /// where it is a scalar, otherwise the class or array type it names.
        /// Null where `type` has no descriptor, as a trait or a function type
        /// has none.
        descriptor_class_of(type: Type?) -> CLASS_INSTANCE? is
            if let box = box_type(type) then
                return box
            elif WASMGC_TYPES.is_string(type) then
                return _string
            elif let array = array_of(type) then
                return array
            elif let held = class_of(type) /\ (is_object(held) \/ is_object_type(held)) then
                return held
            elif let descriptor_only = _descriptor_only_instance(type) then
                return descriptor_only
            fi

            return null
        si

        // The trait or value-type optional `type` is, as a type with a
        // descriptor of its own, added while discovering; null where `type`
        // is neither. No value is an instance of either: a trait's values
        // are its implementors', and a value-type optional is held as its
        // value's box.
        _descriptor_only_instance(type: Type?) -> CLASS_INSTANCE? is
            if !type? \/ !(type.is_trait \/ (type.is_optional /\ type.is_value_type /\ !type.is_maybe)) then
                return null
            fi

            let definition =
                if let generic: GENERIC = type.symbol then cast Classy?(generic.unspecialized_symbol) else cast Classy?(type.symbol) fi

            if !definition? then
                return null
            fi

            let map = MAP[Symbol, Type]()

            if let generic: GENERIC = type.symbol then
                for (parameter, argument) in generic.type_map do
                    if parameter.owner == definition then
                        map[parameter] = argument
                    fi
                od
            fi

            let key = CLASS_INSTANCE(definition, type.arguments, map)

            if _descriptor_only_set.contains(key) then
                return key
            fi

            if !discovering then
                return null
            fi

            _descriptor_only_set.add(key)
            _descriptor_only.add(key)

            return key
        si

        /// The types with descriptors that no value is an instance of.
        descriptor_only: CLASS_INSTANCE[] => _descriptor_only

        /// The box a value of the scalar `type` is held in, or null where
        /// `type` is not a scalar.
        box_type(type: Type?) -> CLASS_INSTANCE? => _class_set.box_type(type)

        /// Whether every instance of `derived` is an instance of `base`.
        is_subclass(derived: CLASS_INSTANCE, base: CLASS_INSTANCE) -> bool =>
            base == _object \/
            _type_indices.contains_key(derived) /\
            _type_indices.contains_key(base) /\
            _class_set.numbering.is_within(derived, base)

        /// Whether `type` is the root class.
        is_object(type: CLASS_INSTANCE) -> bool => type == _object

        /// The root class, or null for a registry that knows no classes.
        root: CLASS_INSTANCE? => _object
    si
si
