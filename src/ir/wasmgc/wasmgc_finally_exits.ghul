namespace IR.WasmGC is
    use Collections.LIST

    /// The exits that leave the protected body of a try with a finally.
    /// Wasm has no branch that runs a finally on its way out, so an exit
    /// stores its number in `selector` and branches to the finally; after
    /// the finally each numbered exit is taken again from there.
    class WASMGC_FINALLY_EXITS is
        _exits: LIST[Values.Exit]

        /// The local holding the number of the exit being taken, 0 for
        /// none.
        selector: int

        /// The position on the label stack of the block an exit branches
        /// to, after which the finally runs.
        finally_label: int public

        /// One of each kind of exit numbered so far, the exit numbered
        /// `n` at `n - 1`.
        exits: Collections.List[Values.Exit] => _exits

        /// - selector: the local the exit's number is stored in
        init(selector: int) is
            self.selector = selector

            _exits = LIST[Values.Exit]()
        si

        /// The number of `exit`, from 1. Exits that go to the same place
        /// share a number.
        number(exit: Values.Exit) -> int is
            let is_continue = isa Values.CONTINUE(exit)

            for i in 0.._exits.count do
                let numbered = _exits[i]

                if numbered.target == exit.target /\ isa Values.CONTINUE(numbered) == is_continue then
                    return i + 1
                fi
            od

            _exits.add(exit)

            return _exits.count
        si
    si
si
