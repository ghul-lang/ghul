namespace IR.WasmGC is
    use Wasm.INSTRUCTION
    use Wasm.SIMPLE_INSTRUCTION
    use Wasm.INDEX_INSTRUCTION
    use Wasm.I32_CONSTANT
    use Wasm.I64_CONSTANT
    use Wasm.F32_CONSTANT
    use Wasm.F64_CONSTANT
    use Wasm.BLOCK_INSTRUCTION
    use Wasm.BLOCK_TYPE
    use Wasm.VALUE_TYPE
    use Wasm.NumericType
    use Wasm.Opcode
    use Wasm.HEAP_TYPE
    use Wasm.TYPE_INSTRUCTION
    use Wasm.TYPE_FIELD_INSTRUCTION
    use Wasm.TYPE_LENGTH_INSTRUCTION
    use Wasm.HEAP_TYPE_INSTRUCTION
    use Wasm.CAST_BRANCH_INSTRUCTION
    use Wasm.THROW_INSTRUCTION
    use Wasm.TRY_TABLE_INSTRUCTION
    use Wasm.CATCH_CLAUSE
    use Wasm.CatchKind
    use Wasm.AbstractHeapType
    use Wasm.IF_INSTRUCTION
    use Wasm.CALL_INDIRECT_INSTRUCTION

    use Collections.LIST
    use Collections.MAP

    use Semantic.Types.Type
    use Semantic.Symbols.Function

    use Values.Value

    /// Lowers the IR values of one function body to wasm instructions. A
    /// construct it cannot lower yet is recorded in `unsupported` rather
    /// than thrown.
    class WASMGC_LOWERING: Values.Visitor is
        // Structured control flow maps directly: a REGION is a `block`, a
        // LOOP is a `loop` inside a `block`, a BREAK branches to the block
        // and a CONTINUE to the loop. Branch depths count the blocks open
        // between an exit and its target, so they are found from the nodes
        // open when the exit is lowered.

        _numbering: WASMGC_FUNCTION_NUMBERING
        _registry: WASMGC_TYPE_REGISTRY

        // The instantiation being compiled: the type arguments the body's
        // type parameters stand for.
        _instance: WASMGC_FUNCTION?
        _imports: WASMGC_IMPORTS
        _strings: WASMGC_STRINGS?
        _exceptions: WASMGC_EXCEPTIONS?

        // An instance method's receiver is its parameter 0, so its
        // declared arguments start at 1.
        _receiver_offset: int

        _parameter_count: int
        _parameter_types: Collections.List[VALUE_TYPE]
        _return_type: Type?

        // The wasm type of the value most recently lowered, as held: for
        // a load, the type of the local, parameter, field or global it
        // reads, which can be wider than the type the IR gives it where
        // flow analysis has narrowed the variable. A consumer that needs
        // the narrower type casts to it.
        _top: VALUE_TYPE? =>
            if let cast_to = _top_cast then
                cast_to
            elif let value = _top_value then
                _held_type(value)
            else
                null
            fi

        _top_value: Value?
        _top_cast: VALUE_TYPE?
        _locals: MAP[LOCAL, int]
        _local_types: LIST[VALUE_TYPE]

        _bodies: LIST[LIST[INSTRUCTION]]

        // The labels open at the point being lowered, innermost last:
        // each structured node's block, and a loop's own `loop` after
        // it, which is where a CONTINUE goes.
        _labels: LIST[(node: Values.Breakable?, is_loop_head: bool, finally_exits: WASMGC_FINALLY_EXITS?)]

        _unsupported: LIST[string]
        // The struct-typed locals the body declared, and the scalar locals
        // that live in cells, each of which holds a default box from the
        // start, as a .NET local holds a zeroed value.
        _struct_locals: LIST[(index: int, type: WASMGC_CLASS)]

        // Set while a call is lowered as the receiver of a call on a struct,
        // where an array element it reads is changed in place, not copied.
        _element_in_place: bool

        /// The kinds of construct the lowered values used that this
        /// target cannot generate yet, each once, in the order they were
        /// met. A body with any is not a valid function.
        unsupported: Collections.List[string] => _unsupported

        /// The wasm types of the locals the lowered values declared, in
        /// index order; the first is numbered after the parameters.
        local_types: LIST[VALUE_TYPE] => _local_types

        /// Lowers a body of `function`.
        ///
        /// - numbering: the function indices, which a call numbers the function
        ///   it reaches with
        /// - registry: the program's struct types and globals
        /// - imports: the module's imports, which a call to a host
        ///   operation is a call of
        /// - parameter_types: the types of the function's parameters, the
        ///   receiver first where it takes one
        init(
            numbering: WASMGC_FUNCTION_NUMBERING,
            registry: WASMGC_TYPE_REGISTRY,
            imports: WASMGC_IMPORTS,
            function: WASMGC_FUNCTION,
            parameter_types: Collections.List[VALUE_TYPE]
        ) is
            init(numbering, registry, imports, null, null, function, parameter_types)
        si

        /// Lowers a body of `function` that can use strings.
        ///
        /// - numbering: the function indices, which a call numbers the function
        ///   it reaches with
        /// - registry: the program's struct types and globals
        /// - imports: the module's imports, which a call to a host
        ///   operation is a call of
        /// - strings: the string literals and helper functions, or null
        ///   where the program has no string type
        /// - exceptions: the tag exceptions are thrown with, or null where
        ///   the body neither throws nor catches
        /// - parameter_types: the types of the function's parameters, the
        ///   receiver first where it takes one
        init(
            numbering: WASMGC_FUNCTION_NUMBERING,
            registry: WASMGC_TYPE_REGISTRY,
            imports: WASMGC_IMPORTS,
            strings: WASMGC_STRINGS?,
            exceptions: WASMGC_EXCEPTIONS?,
            function: WASMGC_FUNCTION,
            parameter_types: Collections.List[VALUE_TYPE]
        ) is
            init(numbering, registry, imports, parameter_types)

            _strings = strings
            _exceptions = exceptions

            _instance = function
            _receiver_offset = if function.definition.is_emitted_with_receiver then 1 else 0 fi
            _return_type = function.specialize(function.definition.return_type)
        si

        /// Lowers a body that takes no receiver and whose result needs no
        /// cast.
        init(
            numbering: WASMGC_FUNCTION_NUMBERING,
            registry: WASMGC_TYPE_REGISTRY,
            imports: WASMGC_IMPORTS,
            parameter_types: Collections.List[VALUE_TYPE]
        ) is
            _numbering = numbering
            _registry = registry
            _imports = imports
            _parameter_types = parameter_types
            _parameter_count = parameter_types.count

            _locals = MAP[LOCAL, int]()
            _local_types = LIST[VALUE_TYPE]()
            _bodies = LIST[LIST[INSTRUCTION]]()
            _labels = LIST[(node: Values.Breakable?, is_loop_head: bool, finally_exits: WASMGC_FINALLY_EXITS?)]()
            _unsupported = LIST[string]()
            _struct_locals = LIST[(index: int, type: WASMGC_CLASS)]()
        si

        /// Lowers a whole body, answering its instructions.
        lower(values: Collections.Iterable[Value]) -> LIST[INSTRUCTION] is
            _begin()

            for value in values do
                gen(value)
            od

            let body = _end()

            if _struct_locals.count == 0 \/ _registry.discovering then
                return body
            fi

            let result = LIST[INSTRUCTION]()

            for (index, type) in _struct_locals do
                result.add_range(_registry.new_instance(type))
                result.add(INDEX_INSTRUCTION(Opcode.LOCAL_SET, index))
            od

            result.add_range(body)

            return result
        si

        /// Lowers one value into the instructions being built. An absent
        /// value lowers to nothing.
        gen(value: Value?) is
            if value? then
                value.accept(self)

                _top_value = value
                _top_cast = null
            fi
        si

        /// Lowers the address of `value`, which for a struct is the box the
        /// value lives in.
        gen_address(value: Value) is
            value.accept_address(self)

            _top_value = value
            _top_cast = null
        si

        // The struct a value of `type` is a box of, or null.
        _struct_of(type: Type?) -> WASMGC_CLASS? => _registry.struct_of(_specialize(type))


        // The struct a value-type optional `type` holds, or null.
        _optional_struct_of(type: Type?) -> WASMGC_CLASS? is
            let specialized = _specialize(type)

            if !specialized? \/ !specialized.is_optional \/ !specialized.is_value_type then
                return null
            fi

            return _registry.struct_of(specialized.optional_inner_type)
        si
        // Whether a value of `type` is a struct whose box is changed in
        // place, so that a value read from somewhere is a copy of the box.
        _is_mutable_struct(type: Type?) -> bool =>
            if let held = _struct_of(type) then !_registry.is_read_only(held) else false fi

        // A read of a mutable struct, left on the stack, becomes a copy of
        // its box, so that changing the copy leaves the original alone.
        // Each struct-typed field of the box is copied in turn.
        _copy_if_mutable(type: Type?) is
            if !_is_mutable_struct(type) \/ _registry.discovering then
                return
            fi

            _copy_struct(_struct_of(type)!)
        si

        // As _copy_if_mutable, for a value that may be absent: null stays
        // null.
        _copy_if_mutable_or_null(held: WASMGC_CLASS) is
            if !_registry.is_struct(held) \/ _registry.is_read_only(held) \/ _registry.discovering then
                return
            fi

            let index = _registry.type_index(held)!
            let value_type = VALUE_TYPE.of_type_index(index, true)
            let source = _temp(value_type)

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, source))
            _emit(Opcode.REF_IS_NULL)

            _begin()
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, source))
            _copy_struct(held)
            let present = _end()

            _emit(IF_INSTRUCTION(
                BLOCK_TYPE.of_value(value_type),
                [HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_type_index(index))]: INSTRUCTION,
                present))
        si

        _copy_struct(held: WASMGC_CLASS) is
            let index = _registry.type_index(held)!
            let source = _temp(VALUE_TYPE.of_type_index(index, true))
            let field_types = _registry.field_types(held)
            let count = _registry.field_value_types(held).count

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, source))
            _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.descriptor_global(held)))

            for i in 1..count do
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, source))
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, index, i))

                if i < field_types.count then
                    _copy_if_mutable(field_types[i])
                fi
            od

            _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, index))
        si

        // The receiver of a field access or call on a struct is its box,
        // read in place where the value has an address.
        _struct_receiver(from: Value) is
            if from.has_address /\ _struct_of(from.type)? then
                gen_address(from)
            elif isa Values.Call.INSTANCE(from) then
                _element_in_place = true
                gen(from)
                _element_in_place = false
            else
                gen(from)
            fi
        si

        // The wasm type `value` leaves on the stack.
        _held_type(value: Value) -> VALUE_TYPE? is
            if let wrapper: Values.TYPE_WRAPPER = value then
                return _held_type(wrapper.value)
            elif let wrapper: Values.WRAPPER = value /\ wrapper.value? then
                return _held_type(wrapper.value)
            elif let view: Values.NARROW_VIEW = value then
                return _held_type(view.underlying)
            elif let projection: Values.NARROW_PROJECT = value then
                return _held_type(projection.projected)
            elif let conversion: Values.CAST = value /\ _registry.box_index(_specialize(conversion.type))? then
                return VALUE_TYPE.of_type_index(_registry.box_index(_specialize(conversion.type))!, true)
            elif let box: Values.BOX = value then
                if let index = _registry.box_index(_specialize(box.value.type)) then
                    return VALUE_TYPE.of_type_index(index, true)
                fi

                return _held_type(box.value)
            elif let load: Values.Load.TEMP = value then
                return _local_type(_local(load.local))
            elif let local: WASMGC_LOCAL_VALUE = value then
                return _local_type(local.index)
            elif let load: Values.Load.LOCAL_VARIABLE = value then
                if let variable = cast Semantic.Symbols.Variable?(load.symbol) then
                    return _local_type(_local(variable.ir_local))
                fi
            elif let load: Values.Load.LOCAL_ARGUMENT = value then
                if let index = _argument_index(load.symbol) then
                    return _local_type(index)
                fi
            elif let load: Values.Load.ARGUMENT = value then
                return _local_type(load.index + _receiver_offset)
            elif isa Values.Load.RECEIVER(value) \/ isa Values.Load.REFERENCE_SELF(value) then
                return _local_type(0)
            elif let load: Values.Load.INSTANCE_FIELD = value then
                if let owner = _owner_class(load.symbol.owner) then
                    return _registry.field_of(load.symbol, owner)?.value_type
                fi
            elif let load: Values.Load.STATIC_FIELD = value then
                return _global_of(load.symbol)?.type
            elif let load: Values.Load.GLOBAL_FIELD = value then
                return _global_of(load.symbol)?.type
            fi

            return _value_type(value.type)
        si

        // The declared type of parameter or local `index`.
        _local_type(index: int) -> VALUE_TYPE? =>
            if index < _parameter_count then
                _parameter_types[index]
            elif index - _parameter_count < _local_types.count then
                _local_types[index - _parameter_count]
            else
                null
            fi

        // Casts the value just lowered to `expected` where it is held as a
        // wider reference type, which a load of a variable flow analysis
        // has narrowed is.
        _coerce_top(expected: VALUE_TYPE?) is
            let held = _top

            if !expected? \/ !held? then
                return
            fi

            if let expected_heap = expected.heap_type() then
                if let held_heap = held.heap_type() then
                    if _registry.is_held_as(held_heap, expected_heap) then
                        return
                    fi

                    _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, expected_heap))
                    _top_cast = expected
                fi
            fi
        si

        _begin() is
            _bodies.add(LIST[INSTRUCTION]())
        si

        _end() -> LIST[INSTRUCTION] is
            let body = _bodies[_bodies.count - 1]

            _bodies.remove_at(_bodies.count - 1)

            return body
        si

        _emit(instruction: INSTRUCTION) is
            _bodies[_bodies.count - 1].add(instruction)
        si

        _emit(opcode: Opcode) is
            _emit(SIMPLE_INSTRUCTION(opcode))
        si

        _emit_all(instructions: Collections.Iterable[INSTRUCTION]) is
            for instruction in instructions do
                _emit(instruction)
            od
        si

        _report(construct: string) is
            for reported in _unsupported do
                if reported =~ construct then
                    return
                fi
            od

            _unsupported.add(construct)
        si

        // The wasm type a value of `type` is held in, or null where it
        // is not a scalar the target can hold yet.
        _value_type(type: Type?) -> VALUE_TYPE? => _registry.value_type(_specialize(type))

        // `type` with the type parameters of the body being compiled
        // replaced by the arguments of this instantiation.
        _specialize(type: Type?) -> Type? =>
            if let instance = _instance then instance.specialize(type) else type fi

        _type_map: Collections.Map[Semantic.Symbols.Symbol, Type] =>
            if let instance = _instance then instance.type_map else MAP[Semantic.Symbols.Symbol, Type]() fi

        // The index of the instantiation of `function` a reference from
        // this body names, numbered the first time it is asked for.
        _index_of(function: Function) -> int? =>
            _numbering.index_of(_instance_of(function))

        // The instantiation of `function` a reference from this body names.
        _instance_of(function: Function) -> WASMGC_FUNCTION =>
            WASMGC_FUNCTION(
                cast Function?(function.root_specialized_from)!,
                WASMGC_TYPE_MAPS.function_map(function, _type_map))

        // The class a member's owner is, at the arguments this body gives
        // it: a constructed generic names them itself, and a reference from
        // inside a generic class to its own members takes the body's.
        _owner_class(owner: Semantic.Scope?) -> WASMGC_CLASS? is
            if let generic: Semantic.Symbols.GENERIC = owner then
                return _registry.class_of(_specialize(generic.type))
            elif let classy: Semantic.Symbols.Classy = owner then
                return _registry.class_of(classy, _type_map)
            fi

            return null
        si

        // The global holding a static field or a namespace-level variable.
        _global_of(symbol: Semantic.Symbols.Symbol) -> (index: int, type: VALUE_TYPE)? =>
            _registry.global_of(symbol, _owner_class(symbol.owner))

        // The instantiation of the trait a member's owner is, at the
        // arguments this body gives it.
        _trait_instance(owner: Semantic.Scope?) -> WASMGC_CLASS? is
            if let generic: Semantic.Symbols.GENERIC = owner then
                return _registry.dispatch.trait_of(_specialize(generic.type)!)
            elif let classy: Semantic.Symbols.Classy = owner then
                return _registry.dispatch.trait_of(classy, _type_map)
            fi

            return null
        si

        _numeric(type: Type?) -> NumericType? is
            if let scalar = WASMGC_TYPES.scalar(_specialize(type)) then
                return WASMGC_TYPES.numeric(scalar)
            fi

            return null
        si

        // Brings a value stored into a slot of a narrow kind back into
        // range, as a CIL store into a narrow local or argument does.
        _normalise_for(type: Type?) is
            _coerce_top(_value_type(type))

            if let scalar = WASMGC_TYPES.scalar(_specialize(type)) then
                if WASMGC_TYPES.is_narrow(scalar) then
                    _emit_all(WASMGC_OPERATIONS.normalise(scalar))
                fi
            fi
        si

        // The index of `local`, numbered after the parameters the first
        // time it is seen.
        _local(local: LOCAL) -> int is
            let index mut = 0

            if _locals.try_get_value(local, index ref) then
                return index
            fi

            index = _parameter_count + _local_types.count

            _locals[local] = index

            if let cell = _cell_index(local) then
                _local_types.add(VALUE_TYPE.of_type_index(cell, true))
                _struct_locals.add((index, _registry.box_type(_specialize(local.type))!))
            elif let type = _value_type(local.type) then
                _local_types.add(type)

                if let held = _struct_of(local.type) then
                    _struct_locals.add((index, held))
                fi
            else
                _report("a local of type {local.type}")

                _local_types.add(VALUE_TYPE.of_numeric(NumericType.I32))
            fi

            return index
        si

        // The zero of `type`: a default box for a struct, the zero or null
        // of the wasm type otherwise. The null type has no wasm type of its
        // own, and its null is the bottom of the reference types, which
        // any struct or array slot accepts.
        _zero(type: Type?) is
            if let held = _struct_of(type) then
                _emit_all(_registry.new_instance(held))
            elif let value_type = _value_type(type) then
                _emit(WASMGC_TYPE_REGISTRY.default_value(value_type))
            elif type?.is_null ?? false then
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.NONE)))
            else
                _report("the default value of {type}")
            fi
        si

        // A local the lowering needs for itself, holding a value of
        // `value_type`.
        _temp(value_type: VALUE_TYPE) -> int is
            let index = _parameter_count + _local_types.count

            _local_types.add(value_type)

            return index
        si

        // The parameter `symbol` is passed in: its position among the
        // arguments of the function that owns it, after the receiver where
        // there is one.
        _argument_index(symbol: Semantic.Symbols.Symbol) -> int? is
            if let function = cast Function?(symbol.owner) then
                let names = function.argument_names

                for i in 0..names.count do
                    if names[i] =~ symbol.name then
                        return i + _receiver_offset
                    fi
                od
            fi

            return null
        si

        _lower_all(values: Collections.Iterable[Value]) is
            for value in values do
                gen(value)
            od
        si

        // The arguments of a call, each brought into the range of the
        // parameter it is passed to.
        _lower_arguments(function: Function, arguments: Collections.List[Value]) is
            let parameters = function.arguments

            for i in 0..arguments.count do
                gen(arguments[i])

                if i < parameters.count then
                    _normalise_for(parameters[i])
                fi
            od
        si

        _call(function: Function, arguments: Collections.List[Value]) is
            if WASMGC_IMPORTS.is_host(function.intrinsic_operation) then
                _call_host(function.intrinsic_operation!, arguments)
                return
            elif _lower_representation(function.intrinsic_operation, arguments) then
                return
            elif let opcode = WASMGC_OPERATIONS.reinterpretation(function.intrinsic_operation) then
                gen(arguments[0])
                _emit(opcode)
                return
            elif function.intrinsic_operation =~ "array.new" then
                _new_array(_instance_of(function).specialize(cast Function?(function.root_specialized_from)!.return_type), arguments[0])
                return
            elif function.intrinsic_operation =~ "array.set" then
                _store_array_element(arguments[0], arguments[1], arguments[2])
                return
            fi

            let index_found = _index_of(function)

            if !index_found? then
                _report("a call to {function.name}")
                return
            fi

            let index = index_found

            _lower_arguments(function, arguments)

            _emit(INDEX_INSTRUCTION(Opcode.CALL, index))
        si

        visit_value(value: Value) is
            if let local: WASMGC_LOCAL_VALUE = value then
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, local.index))
                return
            fi

            _report("{value.get_type().name}")
        si

        visit_address_of_value(value: Value) is
            _report("the address of {value.get_type().name}")
        si

        visit(number: Values.Literal.NUMBER) is
            case number.constant
            when i4: Values.Literal.CONSTANT.I4 then _emit(I32_CONSTANT(i4.value))
            when i8: Values.Literal.CONSTANT.I8 then _emit(I64_CONSTANT(i8.value))
            when r4: Values.Literal.CONSTANT.R4 then _emit(F32_CONSTANT(r4.value))
            when r8: Values.Literal.CONSTANT.R8 then _emit(F64_CONSTANT(r8.value))
            esac

            if let to = number.narrowing then
                let from =
                    case number.constant
                    when _: Values.Literal.CONSTANT.I4 then Scalar.INT32
                    when _: Values.Literal.CONSTANT.I8 then Scalar.INT64
                    when _: Values.Literal.CONSTANT.R4 then Scalar.FLOAT32
                    when _: Values.Literal.CONSTANT.R8 then Scalar.FLOAT64
                    esac

                _emit_all(WASMGC_OPERATIONS.conversion(from, to))
            fi
        si

        visit(string: Values.Literal.STRING) is
            if let strings = _strings then
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, strings.literal(string.value)))
            else
                _report("a string literal")
            fi
        si
        visit(decimal: Values.Literal.DECIMAL) is _report("a decimal literal") si
        visit(bigint: Values.Literal.BIGINT) is _report("a bigint literal") si

        visit(load: Values.Load.SYMBOL) is _report("a load of {load.symbol.name}") si
        visit_address(load: Values.Load.SYMBOL) is _report("the address of {load.symbol.name}") si
        visit(load: Values.Load.INSTANCE_FIELD) is
            _field_get(load)
            _copy_if_mutable(load.type)
        si

        _field_get(load: Values.Load.INSTANCE_FIELD) is
            if let `field = _instance_field(load.from, load.symbol) then
                _struct_receiver(load.from!)
                _coerce_top(VALUE_TYPE.of_type_index(`field.type_index, true))

                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, `field.type_index, `field.field_index))
            fi
        si

        // Where an instance field lives, or null, reported, where the
        // object model does not hold it.
        _instance_field(from: Value?, symbol: Semantic.Symbols.Symbol) -> WASMGC_FIELD? is
            if !from? \/ (from.is_value_type /\ !_struct_of(from.type)?) then
                _report("a field of a value type")
                return null
            fi

            if let owner = _owner_class(symbol.owner) then
                if let `field = _registry.field_of(symbol, owner) then
                    return `field
                fi
            fi

            _report("a field of {symbol.owner}")

            return null
        si
        visit_address(load: Values.Load.INSTANCE_FIELD) is
            if _struct_of(load.type)? then
                _field_get(load)
            else
                _report("a reference to a field or array element")
            fi
        si
        visit(load: Values.Load.STATIC_ANONYMOUS_FUNCTION) is _report("a function value") si
        visit(load: Values.Load.GLOBAL_ANONYMOUS_FUNCTION) is _report("a function value") si
        visit(load: Values.Load.INSTANCE_ANONYMOUS_FUNCTION) is _report("a function value") si

        visit(load: Values.Load.TEMP) is
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, _local(load.local)))
            _copy_if_mutable(load.type)
        si

        visit_address(load: Values.Load.TEMP) is
            if _struct_of(load.type)? then
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, _local(load.local)))
            else
                _report("the address of a local")
            fi
        si
        visit(load: Values.Load.STATIC_FIELD) is
            _global_get(load.symbol)
            _copy_if_mutable(load.type)
        si

        _global_get(symbol: Semantic.Symbols.Symbol) is
            if let (index, _) = _global_of(symbol) then
                _ensure_initialised(symbol.owner)
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, index))
            else
                _report("a static field of {symbol.owner}")
            fi
        si

        _global_set(symbol: Semantic.Symbols.Symbol, value: Value) is
            if let (index, _) = _global_of(symbol) then
                _ensure_initialised(symbol.owner)
                gen(value)

                _normalise_for(cast Semantic.Types.Typed?(symbol)?.type)
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_SET, index))
            else
                _report("a static field of {symbol.owner}")
            fi
        si
        visit_address(load: Values.Load.STATIC_FIELD) is
            if _struct_of(load.type)? then
                _global_get(load.symbol)
            else
                _report("the address of a static field")
            fi
        si
        visit(load: Values.Load.GLOBAL_FIELD) is
            _global_get(load.symbol)
            _copy_if_mutable(load.type)
        si
        visit_address(load: Values.Load.GLOBAL_FIELD) is
            if _struct_of(load.type)? then
                _global_get(load.symbol)
            else
                _report("the address of a global variable")
            fi
        si

        visit(load: Values.Load.LOCAL_ARGUMENT) is
            _argument_get(load)
            _copy_if_mutable(load.type)
        si

        _argument_get(load: Values.Load.LOCAL_ARGUMENT) is
            let symbol = load.symbol

            if Values.state_machine_field_for(symbol)? then
                _report("a generator or asynchronous function's argument")
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, _local(packed_local)))
            elif let index = _argument_index(symbol) then
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, index))
            else
                _report("an argument of another function")
            fi
        si

        visit_address(load: Values.Load.LOCAL_ARGUMENT) is
            if _struct_of(load.type)? then
                _argument_get(load)
            else
                _report("the address of an argument")
            fi
        si

        visit(load: Values.Load.LOCAL_VARIABLE) is
            _variable_get(load)
            _copy_if_mutable(load.type)
        si

        _variable_get(load: Values.Load.LOCAL_VARIABLE) is
            if Values.state_machine_field_for(load.symbol)? then
                _report("a generator or asynchronous function's local")
            elif let variable = cast Semantic.Symbols.Variable?(load.symbol) then
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, _local(variable.ir_local)))

                if let cell = _cell_index(variable.ir_local) then
                    _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, cell, WASMGC_TYPE_REGISTRY.BOX_VALUE))
                fi
            else
                _report("a load of {load.symbol.name}")
            fi
        si

        // The address of a scalar local is the cell it lives in, which the
        // local holds in place of the value.
        visit_address(load: Values.Load.LOCAL_VARIABLE) is
            if _struct_of(load.type)? then
                _variable_get(load)
            elif Values.state_machine_field_for(load.symbol)? then
                _report("a generator or asynchronous function's local")
            elif let variable = cast Semantic.Symbols.Variable?(load.symbol) /\ _registry.box_index(_specialize(load.type))? then
                _registry.mark_cell(variable.ir_local)
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, _local(variable.ir_local)))
            else
                _report("the address of a local")
            fi
        si

        // The box type of the cell `local` lives in, or null where it holds
        // its value directly.
        _cell_index(local: IR.LOCAL) -> int? =>
            if _registry.is_cell(local) then _registry.box_index(_specialize(local.type)) else null fi

        visit(load: Values.Load.ARGUMENT) is
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, load.index + _receiver_offset))
            _copy_if_mutable(load.type)
        si

        visit(load: Values.Load.RECEIVER) is
            _load_receiver()
        si

        _load_receiver() is
            if _receiver_offset == 0 then
                _report("self outside an instance method")
                return
            fi

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
        si

        /// A composite value's structured expansion is lowered as any
        /// other structured IR is.
        visit(composite: Values.Composite) is
            _lower_all(composite.expand().values)
        si

        visit_address(coalesce: Values.COALESCE_LOAD) is _report("the address of a coalesced load") si

        visit(launch: Values.ASYNC_METHOD_LAUNCH) is _report("an asynchronous function") si
        visit(completion: Values.ASYNC_COMPLETION) is _report("an asynchronous function") si
        visit(completed: Values.COMPLETED_TASK_LIKE) is _report("an asynchronous function") si
        visit(suspend: Values.AWAIT_SUSPEND) is _report("await") si
        visit(step: Values.AWAIT_SUSPEND_STEP) is _report("await") si

        visit(max_stack: Values.MAX_STACK) is si

        visit(equality: Values.REFERENCE_EQUALITY) is
            gen(equality.left)
            gen(equality.right)

            _emit(Opcode.REF_EQ)
        si
        visit(construct: Values.CONSTRUCT_MAYBE) is _report("an optional value") si
        // A value an earlier step left on the stack, where it still is.
        visit(stack_top: Values.STACK_TOP) is si
        visit(stack_top: Values.STACK_TOP_ADDRESS) is si
        visit_address(stack_top: Values.STACK_TOP_ADDRESS) is si

        /// An `if` or `case` that produces a value is a block whose last
        /// value is the region its arms leave, each carrying the value it
        /// produces, so that region's wasm block results in the type the
        /// block produces.
        // Unlike the CIL backend, this one lowers a body more than once,
        // while discovering and then once for each instantiation, so a block
        // is not marked as emitted.
        visit(block: Values.BLOCK) is
            let values = block.values

            for i in 0..values.count do
                let value = values[i]

                if i == values.count - 1 /\ _produces_value(block) /\ isa Values.REGION(value) then
                    let result = _value_type(block.type)

                    if !result? then
                        _report("a value of type {block.type}")
                    fi

                    _lower_region(cast Values.REGION(value), result)
                else
                    gen(value)
                fi
            od
        si

        // A body every path out of which diverges, by a throw or a return,
        // is typed as an error, and produces no value.
        _produces_value(block: Values.BLOCK) -> bool =>
            !WASMGC_TYPES.is_void(block.type) /\ !(block.type?.is_error ?? false)

        visit(block: Values.DUMMY_BLOCK) is
            throw System.InvalidOperationException("dummy block generated, created at: {block.location} because: {block.why}")
        si

        // `super` is a REFERENCE_SELF too: it is the same receiver, and
        // only the calls made through it differ.
        visit(self_load: Values.Load.REFERENCE_SELF) is
            _load_receiver()
        si

        visit_address(self_load: Values.Load.REFERENCE_SELF) is
            if _struct_of(self_load.type)? then
                _load_receiver()
            else
                _report("self")
            fi
        si

        visit(self_load: Values.Load.OUTER_SELF) is _report("self") si
        visit_address(self_load: Values.Load.OUTER_SELF) is _report("self") si
        // A scalar's method takes the value itself as its receiver. A
        // struct method's receiver is the box its value lives in, so its
        // address is the receiver and its value a copy.
        visit(self_load: Values.Load.VALUE_SELF) is
            if WASMGC_TYPES.scalar(self_load.type)? then
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
            elif _struct_of(self_load.type)? then
                _load_receiver()
                _copy_if_mutable(self_load.type)
            else
                _report("self")
            fi
        si

        visit_address(self_load: Values.Load.VALUE_SELF) is
            if _struct_of(self_load.type)? then
                _load_receiver()
            else
                _report("self")
            fi
        si
        visit(runtime: Values.RUNTIME) is
            if _lower_builder(runtime) then
                return
            fi

            if let exception = _runtime_exception(runtime.operation) then
                _construct_runtime_exception(exception, runtime.operands)
                return
            fi

            let strings = _strings

            if !strings? then
                _report("a runtime operation")
                return
            fi

            case runtime.operation
            when IR.RuntimeOperation.STRINGS_EQUAL then
                _call_string_helper(strings.equals_function, strings, runtime.operands)

            when IR.RuntimeOperation.CONCAT_STRINGS then
                _call_string_helper(strings.concat_function, strings, runtime.operands)

            else
                _report("the runtime operation {runtime.operation}")
            esac
        si

        _is_representation_operation(name: string) -> bool =>
            name =~ "string.length" \/ name =~ "string.char_at" \/ name =~ "string.concat" \/
            name =~ "string.from_char" \/ name =~ "string.substring" \/ name =~ "object.type_name"

        // An interpolation's builder operations, as calls on the core
        // library's builder: it is constructed, takes each piece of text
        // through `append`, and answers the whole through `to_string`. A
        // value's text comes from its own `to_string`, which dispatches as
        // any other call does.
        _lower_builder(runtime: Values.RUNTIME) -> bool is
            let operands = runtime.operands

            case runtime.operation
            when IR.RuntimeOperation.NEW_STRING_BUILDER then
                let builder_type = runtime.type

                if let constructor = _method(builder_type, "init", 0) then
                    gen(Values.NEW(builder_type!, constructor, LIST[Value]()))
                else
                    _report("an interpolation, whose builder has no constructor")
                fi

            when IR.RuntimeOperation.APPEND_TEXT then
                _append(operands[0], operands[1])

            when IR.RuntimeOperation.APPEND_VALUE then
                _append(operands[0], _text_of(operands[1]))

            when IR.RuntimeOperation.BUILD_STRING then
                if let build = _method(operands[0].type, "to_string", 0) then
                    gen(Values.Call.INSTANCE(operands[0], build, LIST[Value](), null))
                else
                    _report("an interpolation, whose builder has no to_string")
                fi

            when
                IR.RuntimeOperation.APPEND_ALIGNED_VALUE,
                IR.RuntimeOperation.APPEND_FORMATTED_VALUE,
                IR.RuntimeOperation.APPEND_ALIGNED_FORMATTED_VALUE
            then
                _report("an interpolated value with an alignment or a format")

            else
                return false
            esac

            return true
        si

        _append(builder: Value, text: Value) is
            if let append = _method(builder.type, "append", 1) then
                gen(Values.Call.INSTANCE(builder, append, LIST[Value]([text]), null))
            else
                _report("an interpolation, whose builder has no append")
            fi
        si

        // The text of `value`: a string as itself, anything else through
        // its `to_string`. A value whose type has no `to_string` of its own
        // is displayed through the core library's `$`, so it reaches here
        // only where the library declares none, and is reported rather
        // than given different text.
        _text_of(value: Value) -> Value is
            // Under a type parameter the instantiation decides: generic code
            // is compiled once per instantiation, so the type is known here.
            let type = _specialize(value.type)

            if WASMGC_TYPES.is_string(type) then
                return value
            elif let to_string = _method(type, "to_string", 0) then
                if let owner: Semantic.Symbols.Classy = to_string.owner /\ owner.is_object then
                    _report("an interpolated value whose type has no to_string of its own")

                    return value
                fi

                return Values.Call.INSTANCE(value, to_string, LIST[Value](), null)
            fi

            _report("an interpolated value of type {value.type}")

            return value
        si

        // The method of `type` named `name` that takes `arity` arguments.
        _method(type: Type?, name: string, arity: int) -> Function? is
            let found = type?.find_member(name)

            if let group: Semantic.Symbols.FUNCTION_GROUP = found then
                for function in group.functions do
                    if function.arguments.count == arity then
                        return function
                    fi
                od
            elif let function: Function = found /\ function.arguments.count == arity then
                return function
            fi

            return null
        si

        _call_string_helper(index: int, strings: WASMGC_STRINGS, arguments: Collections.List[Value]) is
            for argument in arguments do
                gen(argument)
                _coerce_top(strings.string_reference)
            od

            _emit(INDEX_INSTRUCTION(Opcode.CALL, index))
        si

        // The operations the core library declares on strings and objects
        // that read their representation, which no ghūl code can reach.
        _lower_representation(operation: string?, arguments: Collections.List[Value]) -> bool is
            if !operation? then
                return false
            fi

            let name = operation

            if name =~ "object.get_type" then
                gen(arguments[0])
                _coerce_top(_registry.object_reference)
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.OBJECT_TYPE_INDEX, 0))
                _type_object()

                return true
            fi

            if name =~ "object.display" then
                _lower_display(arguments)
                return true
            fi

            let strings = _strings

            // Discovery runs before the strings exist, and only needs
            // what the arguments reach.
            if !strings? then
                if _registry.discovering /\ _is_representation_operation(name) then
                    _lower_all(arguments)
                    return true
                fi

                return false
            fi

            let string_type = strings.string_type_index
            let chars = _registry.chars_type_index

            if name =~ "string.length" then
                gen(arguments[0])
                _coerce_top(strings.string_reference)
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, string_type, WASMGC_TYPE_REGISTRY.STRING_CHARS))
                _emit(Opcode.ARRAY_LEN)
            elif name =~ "string.char_at" then
                gen(arguments[0])
                _coerce_top(strings.string_reference)
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, string_type, WASMGC_TYPE_REGISTRY.STRING_CHARS))
                gen(arguments[1])
                _emit(TYPE_INSTRUCTION(Opcode.ARRAY_GET_U, chars))
            elif name =~ "string.concat" then
                _call_string_helper(strings.concat_function, strings, arguments)
            elif name =~ "string.substring" then
                gen(arguments[0])
                _coerce_top(strings.string_reference)
                gen(arguments[1])
                gen(arguments[2])
                _emit(INDEX_INSTRUCTION(Opcode.CALL, strings.substring_function))
            elif name =~ "string.from_char" then
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.string_descriptor_global!))
                _emit(I32_CONSTANT(0))
                gen(arguments[0])
                _emit(TYPE_LENGTH_INSTRUCTION(Opcode.ARRAY_NEW_FIXED, chars, 1))
                _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, string_type))
            elif name =~ "object.type_name" then
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.string_descriptor_global!))
                _emit(I32_CONSTANT(0))
                gen(arguments[0])
                _coerce_top(_registry.object_reference)
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.OBJECT_TYPE_INDEX, 0))
                _emit(
                    TYPE_FIELD_INSTRUCTION(
                        Opcode.STRUCT_GET,
                        WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX,
                        WASMGC_TYPE_REGISTRY.DESCRIPTOR_NAME))
                _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, string_type))
            else
                return false
            fi

            return true
        si
        visit(creation: Values.CREATE_UNIT_VARIANT_INSTANCE) is _report("a union") si

        visit(dummy: Values.DUMMY) is
            IoC.CONTAINER.instance.logger.poison(dummy.location, "generated dummy value: {dummy.type} from {dummy.location}")
        si

        visit(type_expression: Values.TYPE_EXPRESSION) is
            IoC.CONTAINER.instance.logger.poison(type_expression.location, "generated type expression: {type_expression.type} from {type_expression.location}")
        si

        visit(store: Values.Need.STORE) is
            assert false else "unresolved need store"
        si

        // A store through a reference to a scalar sets the cell's value. One
        // through a reference to a struct changes the box it refers
        // to in place, field by field, so whatever else holds that box
        // sees the new value, as it would on .NET.
        visit(store: Values.Store.INDIRECT) is
            if let held = _struct_of(store.type) then
                let index = _registry.type_index(held)!
                let target = _temp(VALUE_TYPE.of_type_index(index, true))
                let source = _temp(VALUE_TYPE.of_type_index(index, true))

                gen(store.address)
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, target))

                gen(store.value)
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, source))

                for i in 1.._registry.field_value_types(held).count do
                    _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, target))
                    _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, source))
                    _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, index, i))
                    _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_SET, index, i))
                od
            elif let cell = _registry.box_index(_specialize(store.type)) then
                gen(store.address)
                gen(store.value)

                _normalise_for(store.type)
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_SET, cell, WASMGC_TYPE_REGISTRY.BOX_VALUE))
            else
                _report("a store through a reference")
            fi
        si

        visit(wrapper: Values.TYPE_WRAPPER) is
            gen(wrapper.value)
        si

        visit_address(wrapper: Values.TYPE_WRAPPER) is _report("the address of a value") si

        visit(wrapper: Values.WRAPPER) is
            assert wrapper.value? else "generate wrapper without value"

            gen(wrapper.value)
        si

        visit_address(wrapper: Values.WRAPPER) is _report("the address of a value") si
        // A present value-type optional is the box its value is held in.
        visit(wrap: Values.WRAP_OPTIONAL) is
            let value = wrap.value

            if let index = _registry.box_index(_specialize(value.type)) then
                _box(value, _registry.box_type(_specialize(value.type))!, index)
            elif _struct_of(value.type)? then
                gen(value)
            else
                _report("an optional value")
            fi
        si

        visit(projection: Values.NARROW_PROJECT) is
            gen(projection.projected)
        si

        visit(view: Values.NARROW_VIEW) is
            gen(view.underlying)
        si

        visit_address(view: Values.NARROW_VIEW) is _report("the address of a value") si

        /// An `@IL.output` region names CIL the build emits, and there is
        /// none on this target.
        visit(enter: Values.ENTER_FILE) is si
        visit(leave: Values.LEAVE_FILE) is si

        // A function value holds a thunk with the signature its type calls
        // through, and the receiver or frame the thunk passes on.
        visit(closure: Values.MAKE_CLOSURE) is
            let function = closure.function

            let is_virtual = closure.is_virtual /\ !function.has_no_overriders

            if is_virtual /\ _is_trait_method(function) then
                _report("a function value of a trait method")
                return
            fi

            let instance = _instance_of(function)

            if !_numbering.index_of(instance)? then
                _report("a function value of {function.name}")
                return
            fi

            let signature = _registry.closure_signature(_specialize(closure.type)!)

            if !signature? then
                _report("a function value of type {closure.type}")
                return
            fi

            let discards_result = _discards_result(closure.type, function)

            let thunk mut = 0

            if !is_virtual then
                thunk = _registry.closure_thunk(signature, instance, discards_result, _numbering)
            elif _registry.discovering then
                _registry.note_dispatched(function)
            elif let slot = _registry.dispatch.slot_of(instance) then
                _registry.dispatch.use_slot(slot, _numbering)

                thunk = _registry.closure_virtual_thunk(signature, slot, function.arguments.count, discards_result, _numbering)
            else
                _report("a function value of an overridden method")
                return
            fi

            _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.closure_descriptor_global))
            _emit(INDEX_INSTRUCTION(Opcode.REF_FUNC, thunk))

            if function.is_emitted_with_receiver /\ !isa Values.NULL(closure.receiver) then
                gen(closure.receiver)
            else
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, _registry.object_reference.heap_type()!))
            fi

            _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, _registry.closure_type_index))
        si

        // Whether a function value's type returns nothing while the
        // function it holds returns something, which the thunk drops.
        _discards_result(type: Type, function: Function) -> bool =>
            (type.is_action \/ WASMGC_TYPES.is_void(type.arguments[type.arguments.count - 1])) /\
            !WASMGC_TYPES.is_void(function.return_type)

        visit(address: Values.ARRAY_ELEMENT_ADDRESS) is _report("the address of an array element") si
        visit_address(address: Values.ARRAY_ELEMENT_ADDRESS) is _report("a reference to a field or array element") si

        // An array is a struct holding its descriptor and its elements.
        visit(array: Values.NEW_ARRAY) is
            _new_array(array.type, array.count)
        si

        // An array of `array_type` holding `count` elements, each the
        // default value of the element type.
        _new_array(array_type: Type?, count: Value) is
            let type = _array_of(array_type)

            if !type? then
                return
            fi

            let storage = _registry.array_storage(type)

            _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.descriptor_global(type)))

            gen(count)

            _emit(TYPE_INSTRUCTION(Opcode.ARRAY_NEW_DEFAULT, storage.data_index))
            _load_array_element_descriptor(type)
            _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, storage.struct_index))
        si

        visit(sequence: Values.SEQUENCE) is
            let type = _array_of(sequence.type)

            if !type? then
                return
            fi

            let storage = _registry.array_storage(type)

            _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.descriptor_global(type)))

            for value in sequence.values do
                gen(value)
                _normalise_for(sequence.element_type)
            od

            _emit(TYPE_LENGTH_INSTRUCTION(Opcode.ARRAY_NEW_FIXED, storage.data_index, sequence.values.count))
            _load_array_element_descriptor(type)
            _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, storage.struct_index))
        si

        // A store into an array of references checks that the array was
        // made to hold the value, since an array of a class is usable as an
        // array of its superclass. A store that would break that traps.
        visit(store: Values.STORE_ARRAY_ELEMENT) is
            _store_array_element(store.array, store.index, store.element)
        si

        _store_array_element(array_value: Value, index: Value, element: Value) is
            let type = _array_of(array_value.type)

            if !type? then
                return
            fi

            let storage = _registry.array_storage(type)
            let array = _temp(VALUE_TYPE.of_type_index(storage.struct_index, true))

            gen(array_value)
            _coerce_top(VALUE_TYPE.of_type_index(storage.struct_index, true))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, array))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, storage.struct_index, 1))

            gen(index)

            gen(element)
            _normalise_for(_registry.array_element(type))

            if !_registry.discovering /\ _registry.array_store_is_checked(type) then
                let value = _temp(_registry.object_reference)

                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, value))
                _check_array_store(array, storage.struct_index, value)
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, value))
            fi

            _emit(TYPE_INSTRUCTION(Opcode.ARRAY_SET, storage.data_index))
        si

        // The descriptor of the class an array of `type` is made to hold, or
        // null where a store into it needs no check.
        _load_array_element_descriptor(type: WASMGC_CLASS) is
            if let global = _registry.array_element_descriptor(type) then
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, global))
            else
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_type_index(WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX)))
            fi
        si

        // Traps where the non-null `value` is not an instance of the
        // element class `array` records. An array of the root or of a trait
        // records none, and takes any value.
        _check_array_store(array: int, struct_index: int, value: int) is
            _emit(Opcode.DROP)

            let descriptor_type = VALUE_TYPE.of_type_index(WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, true)
            let element = _temp(descriptor_type)
            let id = _temp(VALUE_TYPE.of_numeric(NumericType.I32))

            let check = LIST[INSTRUCTION]()

            check.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, value))
            check.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.OBJECT_TYPE_INDEX, 0))
            check.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, WASMGC_TYPE_REGISTRY.DESCRIPTOR_CLASS_ID))
            check.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, element))
            check.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, WASMGC_TYPE_REGISTRY.DESCRIPTOR_CLASS_ID))
            check.add(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, id))
            check.add(SIMPLE_INSTRUCTION(Opcode.I32_SUB))
            check.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, element))
            check.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, WASMGC_TYPE_REGISTRY.DESCRIPTOR_LAST_DESCENDANT))
            check.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, id))
            check.add(SIMPLE_INSTRUCTION(Opcode.I32_SUB))
            check.add(SIMPLE_INSTRUCTION(Opcode.I32_GT_U))
            check.add(IF_INSTRUCTION(BLOCK_TYPE(), [SIMPLE_INSTRUCTION(Opcode.UNREACHABLE)]: INSTRUCTION, LIST[INSTRUCTION]()))

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, array))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, struct_index, 2))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, element))
            _emit(Opcode.REF_IS_NULL)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, value))
            _emit(Opcode.REF_IS_NULL)
            _emit(Opcode.I32_OR)
            _emit(IF_INSTRUCTION(BLOCK_TYPE(), LIST[INSTRUCTION](), check))
        si

        // The array type `type` is, or null, reported, where the target
        // cannot hold it.
        _array_of(type: Type?) -> WASMGC_CLASS? is
            if let array = _registry.array_of(_specialize(type)) then
                return array
            fi

            _report("an array of type {type}")

            return null
        si

        // The built-in operation on an array that a call to `function`
        // performs, or null where it is not one.
        _array_operation(function: Function) -> string? is
            if let operation = cast Function?(function.root_specialized_from)?.intrinsic_operation /\ operation.starts_with("array.") then
                return operation
            fi

            return null
        si

        // The member the core library gives every array that `call` reaches
        // on an array, whether it names that member or a trait member the
        // array implements with it. Null where `call` is not on an array.
        _array_member(call: Values.Call.INSTANCE) -> Function? is
            let type = _registry.array_of(_specialize(call.from?.type))

            if !type? then
                return null
            fi

            let called = cast Function?(call.function.root_specialized_from)!

            if called.owner == type.definition then
                return called
            fi

            let member = type.definition.find_member(called.name)

            let candidates =
                if let group: Semantic.Symbols.FUNCTION_GROUP = member then
                    group.functions
                elif let function: Function = member then
                    LIST[Function]([function])
                else
                    LIST[Function]()
                fi

            for candidate in candidates do
                if let overridees = candidate.overridees then
                    for overridee in overridees do
                        if overridee.root_specialized_from == called then
                            return candidate
                        fi
                    od
                fi
            od

            return null
        si

        // The elements of the array `from` holds are read from the struct
        // holding them, an element of a mutable struct as a copy unless it
        // is read `in_place` as a receiver.
        _lower_array_operation(operation: string, call: Values.Call.INSTANCE, in_place: bool) is

            let type = _array_of(call.from?.type)

            if !type? then
                return
            fi

            let storage = _registry.array_storage(type)

            gen(call.from)
            _coerce_top(VALUE_TYPE.of_type_index(storage.struct_index, true))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, storage.struct_index, 1))

            if operation =~ "array.count" then
                _emit(Opcode.ARRAY_LEN)
            elif operation =~ "array.get" then
                gen(call.arguments[0])

                _emit(TYPE_INSTRUCTION(Opcode.ARRAY_GET, storage.data_index))

                if let element = _value_type(_registry.array_element(type)), heap = element.heap_type() /\ !_registry.discovering then
                    if !heap.matches(_registry.object_reference.heap_type()!) then
                        _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, heap))
                    fi
                fi

                if !in_place then
                    _copy_if_mutable(_registry.array_element(type))
                fi
            else
                _report("the array operation {operation}")
            fi
        si

        visit(compare: Values.COMPARE_ORDER_TO_ZERO) is
            gen(compare.value)

            _emit(I32_CONSTANT(0))
            _compare(compare.comparison, NumericType.I32, false)
        si

        visit(receiver: Values.CONSTRAINED) is _report("a constrained call") si
        visit(arithmetic: Values.DECIMAL_ARITHMETIC) is _report("decimal arithmetic") si
        visit(compare: Values.DECIMAL_COMPARE) is _report("decimal arithmetic") si
        visit(convert: Values.DECIMAL_CONVERT) is _report("a decimal conversion") si
        // A comparison over a type parameter compares as the instantiation's
        // type argument does.
        visit(equality: Values.EQUALITY_COMPARISON) is
            _equal_values(equality.left, equality.right, _specialize(equality.left.type))
        si

        // `left =~ right` over values of the concrete `type`: by value for
        // a scalar, by characters for a string, through the type's own `=~`
        // where it declares one, and by reference otherwise. An absent
        // value is equal only to another.
        _equal_values(left: Value, right: Value, type: Type?) is
            if let scalar = WASMGC_TYPES.scalar(type) then
                _equal_scalars(left, right, WASMGC_TYPES.numeric(scalar))
                return
            fi

            let value_type = _value_type(type)

            // A tuple declares no `=~` and is compared element by element,
            // which is not lowered yet.
            if !value_type? \/ !value_type.heap_type()? \/ isa Semantic.Types.TUPLE(type) then
                _report("an equality comparison of {type}")
                return
            fi

            if let strings = _strings /\ WASMGC_TYPES.is_string(type) then
                _call_string_helper(strings.equals_function, strings, LIST[Value]([left, right]))
                return
            fi

            let operator = _declared_equals(type!)

            if !operator? then
                gen(left)
                gen(right)
                _emit(Opcode.REF_EQ)
                return
            fi

            let left_local = _temp(value_type)
            let right_local = _temp(value_type)

            gen(left)
            _coerce_top(value_type)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, left_local))

            gen(right)
            _coerce_top(value_type)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, right_local))

            let bool_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_bool_type()
            let receiver = WASMGC_LOCAL_VALUE(left_local, type)
            let argument = WASMGC_LOCAL_VALUE(right_local, type)

            let call: Value =
                if type.is_value_type then
                    Values.Call.STRUCT(receiver, operator, LIST[Value]([argument]), bool_type)
                else
                    Values.Call.INSTANCE(receiver, operator, LIST[Value]([argument]), bool_type)
                fi

            _begin()
            gen(call)
            let compared = _end()

            let right_present = LIST[INSTRUCTION]()

            right_present.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, right_local))
            right_present.add(SIMPLE_INSTRUCTION(Opcode.REF_IS_NULL))
            right_present.add(
                IF_INSTRUCTION(
                    BLOCK_TYPE.of_value(VALUE_TYPE.of_numeric(NumericType.I32)),
                    LIST[INSTRUCTION]([I32_CONSTANT(0)]: INSTRUCTION),
                    compared))

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, left_local))
            _emit(Opcode.REF_IS_NULL)
            _emit(
                IF_INSTRUCTION(
                    BLOCK_TYPE.of_value(VALUE_TYPE.of_numeric(NumericType.I32)),
                    LIST[INSTRUCTION]([
                        INDEX_INSTRUCTION(Opcode.LOCAL_GET, right_local),
                        SIMPLE_INSTRUCTION(Opcode.REF_IS_NULL)
                    ]: INSTRUCTION),
                    right_present))
        si

        // Integers are equal where their bits are; floating values where
        // they compare equal, or where both are NaN.
        _equal_scalars(left: Value, right: Value, type: NumericType) is
            if type == NumericType.I32 \/ type == NumericType.I64 then
                gen(left)
                gen(right)
                _emit(if type == NumericType.I32 then Opcode.I32_EQ else Opcode.I64_EQ fi)
                return
            fi

            let value_type = VALUE_TYPE.of_numeric(type)
            let left_local = _temp(value_type)
            let right_local = _temp(value_type)
            let (eq, ne) = if type == NumericType.F32 then (Opcode.F32_EQ, Opcode.F32_NE) else (Opcode.F64_EQ, Opcode.F64_NE) fi

            gen(left)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, left_local))
            gen(right)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, right_local))
            _emit(eq)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, left_local))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, left_local))
            _emit(ne)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, right_local))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, right_local))
            _emit(ne)
            _emit(Opcode.I32_AND)
            _emit(Opcode.I32_OR)
        si

        // The `=~` a type declares taking a value of itself, or null where
        // it declares none.
        _declared_equals(type: Type) -> Function? is
            if let group: Semantic.Symbols.FUNCTION_GROUP = type.find_member("=~") then
                for function in group.functions do
                    if function.arguments.count == 1 /\ function.arguments[0].is_assignable_from(type) then
                        return function
                    fi
                od
            fi

            return null
        si
        // An optional reference holds a value when it is not null.
        visit(test: Values.HAS_VALUE) is
            gen(test.value)

            if !_top?.heap_type()? then
                _report("an optional value of type {test.value.type}")
                return
            fi

            _emit(Opcode.REF_IS_NULL)
            _emit(Opcode.I32_EQZ)
        si
        // `!` on a reference optional raises the core library's
        // NullReferenceException where the value is absent, or traps where
        // the library declares none.
        visit(check: Values.REFERENCE_NULL_CHECK) is
            gen(check.inner)

            let held = _top

            if !held? \/ !held.heap_type()? then
                _report("a null check of {check.inner.type}")
                return
            fi

            let tag = _exceptions?.tag_index
            let exception_type = _exceptions?.exception

            if !tag? \/ !exception_type? \/ !WASMGC_CORE_LIBRARY.find_class("Ghul.NullReferenceException")? \/ _registry.discovering then
                _emit(Opcode.REF_AS_NON_NULL)
                return
            fi

            let value = _temp(held)

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, value))
            _emit(Opcode.REF_IS_NULL)

            _begin()
            _construct_runtime_exception("Ghul.NullReferenceException", LIST[Value]())
            _coerce_top(exception_type)
            _emit(Opcode.REF_AS_NON_NULL)
            _emit(THROW_INSTRUCTION(tag))
            let absent = _end()

            _emit(IF_INSTRUCTION(BLOCK_TYPE(), absent, LIST[INSTRUCTION]()))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, value))
            _emit(Opcode.REF_AS_NON_NULL)
        si

        visit(conversion: Values.SCALAR_CONVERSION) is
            gen(conversion.converted)
        si

        visit(declaration: Values.DECLARE_LOCAL) is
            _local(declaration.local)
        si

        visit(store: Values.STORE_TEMP) is
            _normalise_for(store.local.type)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, _local(store.local)))
        si

        visit(tee: Values.TEE_TEMP) is
            gen(tee.value)

            _normalise_for(tee.local.type)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, _local(tee.local)))
        si

        visit(discard: Values.DISCARD) is
            if let value = discard.value then
                gen(value)

                if WASMGC_TYPES.is_void(value.type) then
                    return
                fi
            fi

            _emit(Opcode.DROP)
        si


        visit(ret: Values.RET) is
            _normalise_for(_return_type)
            _emit(Opcode.RETURN)
        si

        visit(default_return: Values.DEFAULT_RETURN) is
            if !WASMGC_TYPES.is_void(default_return.type) then
                _zero(default_return.type)
            fi
        si

        visit(default_value: Values.DEFAULT) is
            _zero(default_value.type)
        si

        // A discarded `ref` argument is a fresh cell holding the default
        // value, which the callee writes and nothing reads.
        visit_address(default_value: Values.DEFAULT) is
            if let held = _struct_of(default_value.type) ?? _registry.box_type(_specialize(default_value.type)) then
                _emit_all(_registry.new_instance(held))
            else
                _report("the address of a default value")
            fi
        si
        // A reference to a struct is its box, and one to a scalar the cell
        // the scalar lives in. Dereferencing one reads it,
        // which for a mutable struct is a copy.
        visit(deref: Values.DEREF) is
            if _struct_of(deref.type)? then
                gen(deref.value)
                _copy_if_mutable(deref.type)
            elif let cell = _registry.box_index(_specialize(deref.type)) then
                gen(deref.value)
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, cell, WASMGC_TYPE_REGISTRY.BOX_VALUE))
            else
                _report("a reference")
            fi
        si

        visit_address(deref: Values.DEREF) is
            if _struct_of(deref.type)? then
                gen(deref.value)
            else
                _report("a reference")
            fi
        si

        // The address of a struct is the box it lives in, or for a value
        // with no location of its own, the box the value already is.
        visit(address: Values.ADDRESS) is
            if _struct_of(address.type)? then
                _struct_receiver(address.value)
            elif _optional_inner(address.value.type)? then
                gen(address.value)
            elif _registry.box_index(_specialize(address.value.type))? then
                gen_address(address.value)
            else
                _report("a reference")
            fi
        si

        visit_address(address: Values.ADDRESS) is
            visit(address)
        si

        visit(steps: Values.STEPS) is
            _lower_all(steps.steps)
        si

        visit(decrement: Values.DECREMENT) is _report("decrement") si
        visit(increment: Values.POST_INCREMENT) is _report("increment") si
        visit(decrement: Values.PRE_DECREMENT) is _report("decrement") si
        // The source is held in a local and the target built from its
        // elements.
        visit(repack: Values.TUPLE_REPACK) is
            gen(repack.source)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, _local(repack.temp)))
            gen(repack.built)
        si

        visit(spilled: Values.SPILLED_SUBJECT) is
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, _local(spilled.temp)))

            gen(spilled.built)
        si

        visit(null_value: Values.NULL) is
            _zero(null_value.type)
        si
        // The value is lowered before the descriptor is pushed, as a value
        // can read an operand its enclosing construct left on the stack:
        // the member call a coalescing access makes reads its receiver there.
        _box(value: Value, box_type: WASMGC_CLASS, index: int) is
            _registry.note_boxed(box_type)

            gen(value)

            let held = _temp(_value_type(value.type)!)

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, held))
            _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.descriptor_global(box_type)))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, held))
            _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, index))
        si

        // A scalar is boxed in a struct carrying its type's descriptor, so
        // a boxed int and a boxed long answer type tests differently. A
        // reference needs no box.
        visit(box: Values.BOX) is
            let value = box.value

            if let index = _registry.box_index(_specialize(value.type)) then
                _box(value, _registry.box_type(_specialize(value.type))!, index)
            elif _value_type(value.type)?.heap_type()? then
                gen(value)
            else
                _report("boxing a {value.type}")
            fi
        si

        // A null or a box of another type traps, where .NET throws.
        visit(unbox: Values.UNBOX) is
            if let index = _registry.box_index(_specialize(unbox.type)) then
                gen(unbox.value)

                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(index)))
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, index, WASMGC_TYPE_REGISTRY.BOX_VALUE))
            elif let held = _struct_of(unbox.type) then
                // A boxed struct is the struct's own box, so unboxing it
                // is a cast, and for a mutable struct a copy.
                gen(unbox.value)

                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(_registry.type_index(held)!)))
                _copy_if_mutable(unbox.type)
            elif let index = _optional_box_index(unbox.type) then
                // A present value-type optional is the box itself.
                gen(unbox.value)

                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, HEAP_TYPE.of_type_index(index)))
            elif let held = _optional_struct_of(unbox.type) then
                gen(unbox.value)

                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, HEAP_TYPE.of_type_index(_registry.type_index(held)!)))
                _copy_if_mutable_or_null(held)
            else
                _report("unboxing a {unbox.type}")
            fi
        si
        // A cast to a class the program declares is checked against the
        // struct type, which holds exactly that class and those derived
        // from it. A cast that faults on failure keeps null, as CIL's
        // castclass does; one that declines answers null instead.
        visit(conversion: Values.CAST) is
            let value = _type_test_operand(conversion.value)

            if !value? then
                _report("a cast from {conversion.value.type}")
                return
            fi

            if let ids = _trait_class_ids(conversion.type) then
                _cast_to_trait(value, ids, conversion.faults_on_failure)
                return
            fi

            // Array types sharing a struct type are told apart by class
            // number, as a trait's implementors are.
            if let array = _registry.array_of(_specialize(conversion.type)) then
                _cast_to_trait(value, _registry.array_class_ids(array), conversion.faults_on_failure)
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, HEAP_TYPE.of_type_index(_registry.array_storage(array).struct_index)))
                return
            fi

            if let held = _optional_struct_of(conversion.type) then
                _cast_to_optional_struct(value, held, conversion.faults_on_failure)
                return
            fi

            let target = _registry.type_index(_specialize(conversion.type)) ?? _optional_box_index(conversion.type)

            if !target? then
                if _is_unchecked_widening(conversion.type) then
                    gen(value)
                else
                    _report("a cast to {conversion.type}")
                fi

                return
            fi

            gen(value)

            let target_heap = HEAP_TYPE.of_type_index(target)

            let source_type = _top!

            if _registry.is_held_as(source_type.heap_type()!, target_heap) then
                return
            fi

            if conversion.faults_on_failure then
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, target_heap))
                return
            fi

            let held = _temp(source_type)

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, held))

            let body = LIST[INSTRUCTION]()

            body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, held))
            body.add(CAST_BRANCH_INSTRUCTION(Opcode.BR_ON_CAST, 0, source_type.heap_type()!, true, target_heap, false))
            body.add(SIMPLE_INSTRUCTION(Opcode.DROP))
            body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, target_heap))

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE.of_value(VALUE_TYPE.of_type_index(target, true)), body))
        si

        // A cast to an optional struct answers its box, or null where the
        // value is some other type, and copies a mutable struct as an
        // unbox does.
        _cast_to_optional_struct(value: Value, held: WASMGC_CLASS, faults: bool) is
            let index = _registry.type_index(held)!
            let target_heap = HEAP_TYPE.of_type_index(index)

            gen(value)

            if faults then
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, target_heap))
            else
                let source_type = _top!
                let source = _temp(source_type)

                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, source))

                let body = LIST[INSTRUCTION]()

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, source))
                body.add(CAST_BRANCH_INSTRUCTION(Opcode.BR_ON_CAST, 0, source_type.heap_type()!, true, target_heap, false))
                body.add(SIMPLE_INSTRUCTION(Opcode.DROP))
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, target_heap))

                _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE.of_value(VALUE_TYPE.of_type_index(index, true)), body))
            fi

            _copy_if_mutable_or_null(held)
        si

        // A cast to a trait answers the value where its class implements
        // the trait. Otherwise it traps where the cast faults on failure,
        // and answers null where it declines.
        _cast_to_trait(value: Value, ids: Collections.List[int], faults: bool) is
            let held = _temp(_registry.object_reference)

            gen(value)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, held))
            _test_class_ids(ids)

            let failed = LIST[INSTRUCTION]()

            if faults then
                failed.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, held))
                failed.add(SIMPLE_INSTRUCTION(Opcode.REF_IS_NULL))
                failed.add(SIMPLE_INSTRUCTION(Opcode.I32_EQZ))
                failed.add(IF_INSTRUCTION(BLOCK_TYPE(), [SIMPLE_INSTRUCTION(Opcode.UNREACHABLE)]: INSTRUCTION, LIST[INSTRUCTION]()))
                failed.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, held))
            else
                failed.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, _registry.object_reference.heap_type()!))
            fi

            _emit(
                IF_INSTRUCTION(
                    BLOCK_TYPE.of_value(_registry.object_reference),
                    [INDEX_INSTRUCTION(Opcode.LOCAL_GET, held)]: INSTRUCTION,
                    failed))
        si

        // An instance of a class the program declares is tested against
        // its struct type; null is not an instance of anything.
        visit(test: Values.ISA) is
            let value = _type_test_operand(test.value)

            if !value? then
                _report("a type test of {test.value.type}")
                return
            fi

            if let array = _registry.array_of(_specialize(test.isa_type)) then
                gen(value)

                _test_class_ids(_registry.array_class_ids(array))
            elif let target = _registry.type_index(_specialize(test.isa_type)) then
                gen(value)

                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_TEST, HEAP_TYPE.of_type_index(target)))
            elif let ids = _trait_class_ids(test.isa_type) then
                gen(value)

                _test_class_ids(ids)
            else
                _report("a type test against {test.isa_type}")
            fi
        si

        // The numbers of the classes implementing `type`, where it is a
        // trait that is not generic.
        _trait_class_ids(type: Type?) -> Collections.List[int]? is
            if !type? \/ !type.is_trait then
                return null
            fi

            if let trait_type = _registry.dispatch.trait_of(_specialize(type)!) then
                let ids = LIST[int]()

                if let implementors = _registry.dispatch.implementors(trait_type) then
                    for implementor in implementors do
                        ids.add(_registry.numbering.id(implementor))
                    od
                fi

                return ids
            fi

            return null
        si

        // Replaces the reference on the stack with whether it is an object
        // whose class number is among `ids`. Null is not.
        _test_class_ids(ids: Collections.List[int]) is
            let held = _temp(_registry.object_reference)
            let id = _temp(VALUE_TYPE.of_numeric(NumericType.I32))

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, held))
            _emit(Opcode.REF_IS_NULL)

            let present = LIST[INSTRUCTION]()

            present.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, held))
            present.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.OBJECT_TYPE_INDEX, 0))
            present.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, WASMGC_TYPE_REGISTRY.DESCRIPTOR_CLASS_ID))
            present.add(INDEX_INSTRUCTION(Opcode.LOCAL_SET, id))
            present.add(I32_CONSTANT(0))

            for (low, high) in CLASS_ID_RANGES.of(ids) do
                present.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, id))
                present.add(I32_CONSTANT(low))
                present.add(SIMPLE_INSTRUCTION(Opcode.I32_SUB))
                present.add(I32_CONSTANT(high - low))
                present.add(SIMPLE_INSTRUCTION(Opcode.I32_LE_U))
                present.add(SIMPLE_INSTRUCTION(Opcode.I32_OR))
            od

            _emit(IF_INSTRUCTION(BLOCK_TYPE.of_value(VALUE_TYPE.of_numeric(NumericType.I32)), [I32_CONSTANT(0)]: INSTRUCTION, present))
        si

        // The reference a type test examines: the value itself, or a
        // scalar boxed. Null where the value is neither.
        _type_test_operand(value: Value) -> Value? is
            let mode = Values.TYPE_TEST_OPERAND.mode(value)

            if mode == Values.TypeTestOperandMode.AS_IS /\ _value_type(value.type)?.heap_type()? then
                return value
            elif mode == Values.TypeTestOperandMode.BOX /\ _registry.box_index(_specialize(value.type))? then
                return Values.TYPE_TEST_OPERAND.operand(value)
            fi

            return null
        si

        // The box a value-type optional over a scalar is held as, or null
        // where `type` is not one.
        _optional_box_index(type: Type?) -> int? is
            if let optional = _specialize(type) /\ optional.is_optional /\ optional.is_value_type then
                return _registry.box_index(optional.optional_inner_type)
            fi

            return null
        si

        // A cast to `object`: every reference is held as one already.
        _is_unchecked_widening(to: Type?) -> bool =>
            if let to_class: Semantic.Symbols.Classy = to?.symbol then to_class.is_object else false fi
        visit(type_of: Values.TYPEOF) is
            if let held = _registry.descriptor_class_of(_specialize(type_of.typeof_type)) then
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.descriptor_global(held)))
                _type_object()
            else
                _report("typeof {type_of.typeof_type}")
            fi
        si
        // A tuple is a read-only struct built from its elements in order.
        visit(tuple: Values.TUPLE) is
            let held = _struct_of(tuple.type)

            if !held? then
                _report("a tuple")
                return
            fi

            if _registry.discovering then
                for value in tuple.values do
                    gen(value)
                od

                return
            fi

            let field_types = _registry.field_value_types(held)

            _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.descriptor_global(held)))

            for i in 0..tuple.values.count do
                gen(tuple.values[i])
                _coerce_top(field_types[i + 1])
            od

            _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, _registry.type_index(held)!))
        si
        // A new object holds its descriptor and the default value of each
        // field, and its constructor then runs on it. A unit variant is
        // the one shared instance.
        visit(construction: Values.NEW) is
            let constructor = construction.constructor

            let type = _owner_class(constructor.owner)

            if !type? \/ !_registry.is_object_type(type) then
                _report("constructing a {construction.type}")
                return
            fi

            if type.definition.is_unit_variant then
                _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.unit_variant_global(type)!))
                return
            fi

            _construct(type, constructor, construction.arguments)
        si

        _construct(type: WASMGC_CLASS, constructor: Function, arguments: Collections.List[Value]) is
            let index_found = _index_of(constructor)

            if !index_found? then
                _report("a constructor of {type}")
                return
            fi

            let index = index_found

            _ensure_initialised(constructor.owner)

            let instance = _temp(VALUE_TYPE.of_type_index(_registry.type_index(type)!, true))

            _emit_all(_registry.new_instance(type))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, instance))

            _lower_arguments(constructor, arguments)

            _emit(INDEX_INSTRUCTION(Opcode.CALL, index))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, instance))
        si

        // Replaces the descriptor on the stack with its type object: the
        // one it caches, or, the first time, a new core library type object
        // made from the descriptor's name and cached there, so a type has
        // one type object however it is asked for.
        _type_object() is
            let found = _type_object_constructor()

            if !found? then
                _report("a type object")
                return
            fi

            let (type, constructor) = found
            let string_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type()

            if _registry.discovering then
                _construct(type, constructor, [WASMGC_LOCAL_VALUE(0, string_type)]: Value)
                return
            fi

            let descriptor_type = WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX
            let cache = WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_OBJECT
            let type_index = _registry.type_index(type)!
            let descriptor = _temp(VALUE_TYPE.of_type_index(descriptor_type, false))
            let name = _temp(VALUE_TYPE.of_type_index(_strings!.string_type_index, true))
            let made = _temp(VALUE_TYPE.of_type_index(type_index, true))

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, descriptor))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, descriptor_type, cache))
            _emit(Opcode.REF_IS_NULL)

            _begin()
            _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.string_descriptor_global!))
            _emit(I32_CONSTANT(0))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, descriptor))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, descriptor_type, WASMGC_TYPE_REGISTRY.DESCRIPTOR_NAME))
            _emit(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, _strings!.string_type_index))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, name))
            _construct(type, constructor, [WASMGC_LOCAL_VALUE(name, string_type)]: Value)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, made))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, descriptor))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, made))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_SET, descriptor_type, cache))
            let make = _end()

            _emit(IF_INSTRUCTION(BLOCK_TYPE(), make, LIST[INSTRUCTION]()))

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, descriptor))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, descriptor_type, cache))
            _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(type_index)))
        si

        // Whether a call to `function` asks for its receiver's type object,
        // which no type can override: a member declaring the same name
        // hides it.
        _is_get_type(function: Function) -> bool =>
            cast Function?(function.root_specialized_from)?.intrinsic_operation =~ "object.get_type"

        // The type object of `call`'s receiver: the one its descriptor
        // stands for, or, for a scalar, the one its box's does.
        _get_type(call: Values.Call.INSTANCE) is
            let receiver: Value mut = call.from

            if let constrained: Values.CONSTRAINED = receiver then
                receiver = if let address: Values.ADDRESS = constrained.value then address.value else constrained.value fi

                if let box = _registry.box_type(_specialize(constrained.type)) then
                    gen(receiver)
                    _emit(Opcode.DROP)
                    _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, _registry.descriptor_global(box)))
                    _type_object()
                    return
                fi
            fi

            gen(receiver)
            _coerce_top(_registry.object_reference)
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.OBJECT_TYPE_INDEX, 0))
            _type_object()
        si

        // The core library's type object class and its constructor taking
        // the type's name, or null where the library declares none.
        _type_object_constructor() -> (WASMGC_CLASS, Function)? is
            if let declared = WASMGC_CORE_LIBRARY.find_class("Ghul.Type") then
                if let group = cast Semantic.Symbols.FUNCTION_GROUP?(declared.find_direct("init")) then
                    for constructor in group.functions do
                        if constructor.arguments.count == 1 then
                            if let type = _owner_class(constructor.owner) /\ _registry.is_object_type(type) then
                                return (type, constructor)
                            fi
                        fi
                    od
                fi
            fi

            return null
        si

        // An exception the runtime makes is an instance of the class the
        // core library declares for it, made by its constructor taking
        // the operation's operands. Null for any other operation.
        _runtime_exception(operation: IR.RuntimeOperation) -> string? =>
            case operation
            when IR.RuntimeOperation.NEW_NOT_IMPLEMENTED then "Ghul.NotImplementedException"
            when IR.RuntimeOperation.NEW_NOT_SUPPORTED then "Ghul.NotSupportedException"
            when IR.RuntimeOperation.NEW_ASSERT_FAILED then "Ghul.AssertFailedException"
            else null
            esac

        _construct_runtime_exception(name: string, operands: Collections.List[Value]) is
            if let declared = WASMGC_CORE_LIBRARY.find_class(name) then
                if let group = cast Semantic.Symbols.FUNCTION_GROUP?(declared.find_direct("init")) then
                    for constructor in group.functions do
                        if constructor.arguments.count == operands.count then
                            if let type = _owner_class(constructor.owner) /\ _registry.is_object_type(type) then
                                _construct(type, constructor, operands)
                                return
                            fi
                        fi
                    od
                fi
            fi

            _report("a {name} constructor taking {operands.count} arguments")
        si

        visit(negation: Values.NOT) is
            gen(negation.value)

            _emit(Opcode.I32_EQZ)
        si

        visit(arithmetic: Values.ARITHMETIC) is
            let numeric = _numeric(arithmetic.type)

            if !numeric? then
                _report("arithmetic on {arithmetic.type}")
                return
            fi

            let operation = arithmetic.operation

            if operation == ArithmeticOperation.NEGATE then
                _negate(arithmetic.operands[0], numeric)
            elif operation == ArithmeticOperation.COMPLEMENT then
                _complement(arithmetic.operands[0], numeric)
            elif let opcode = WASMGC_OPERATIONS.arithmetic(operation, numeric) then
                gen(arithmetic.operands[0])
                gen(arithmetic.operands[1])

                // A shift count is an int whatever the shifted value is,
                // and a 64-bit shift takes its count as an i64.
                if numeric == NumericType.I64 /\ _is_shift(operation) /\ _numeric(arithmetic.operands[1].type) =~ NumericType.I32 then
                    _emit(Opcode.I64_EXTEND_I32_U)
                fi

                _emit(opcode)
            else
                _report("{operation} on {arithmetic.type}")
            fi
        si

        _is_shift(operation: ArithmeticOperation) -> bool =>
            operation == ArithmeticOperation.SHIFT_LEFT \/
            operation == ArithmeticOperation.SHIFT_RIGHT \/
            operation == ArithmeticOperation.SHIFT_RIGHT_UNSIGNED

        // Wasm has no integer negation: an integer is subtracted from
        // zero, and a floating value has its sign flipped.
        _negate(operand: Value, type: NumericType) is
            case type
            when NumericType.I32 then
                _emit(I32_CONSTANT(0))
                gen(operand)
                _emit(Opcode.I32_SUB)
            when NumericType.I64 then
                _emit(I64_CONSTANT(0L))
                gen(operand)
                _emit(Opcode.I64_SUB)
            when NumericType.F32 then
                gen(operand)
                _emit(Opcode.F32_NEG)
            when NumericType.F64 then
                gen(operand)
                _emit(Opcode.F64_NEG)
            else
                _report("negation of {type}")
            esac
        si

        // Wasm has no bitwise not: every bit is flipped by an exclusive
        // or with all ones.
        _complement(operand: Value, type: NumericType) is
            gen(operand)

            case type
            when NumericType.I32 then
                _emit(I32_CONSTANT(-1))
                _emit(Opcode.I32_XOR)
            when NumericType.I64 then
                _emit(I64_CONSTANT(-1L))
                _emit(Opcode.I64_XOR)
            else
                _report("complement of {type}")
            esac
        si

        visit(compare: Values.COMPARE) is
            if _value_type(compare.left.type)?.heap_type()? then
                _compare_references(compare)
                return
            fi

            let numeric = _numeric(compare.left.type)

            if !numeric? then
                _report("a comparison of {compare.left.type}")
                return
            fi

            gen(compare.left)
            gen(compare.right)

            _compare(compare.comparison, numeric, compare.is_unsigned)
        si

        // Two references are equal when they are the same object.
        _compare_references(compare: Values.COMPARE) is
            gen(compare.left)
            gen(compare.right)

            case compare.comparison
            when Comparison.EQUAL then
                _emit(Opcode.REF_EQ)
            when Comparison.NOT_EQUAL then
                _emit(Opcode.REF_EQ)
                _emit(Opcode.I32_EQZ)
            else
                _report("an ordering of references")
            esac
        si

        _compare(comparison: Comparison, type: NumericType, is_unsigned: bool) is
            if let (opcode, negates) = WASMGC_OPERATIONS.comparison(comparison, type, is_unsigned) then
                _emit(opcode)

                if negates then
                    _emit(Opcode.I32_EQZ)
                fi
            else
                _report("a comparison of {type}")
            fi
        si

        visit(convert: Values.CONVERT) is
            gen(convert.value)

            // A conversion from a reference is an unboxing: the value held
            // as an object is the box of a scalar of the target type.
            if !convert.from? /\ _top?.heap_type()? then
                if let index = _registry.box_index(_specialize(convert.type)) then
                    _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(index)))
                    _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, index, WASMGC_TYPE_REGISTRY.BOX_VALUE))
                else
                    _report("unboxing a {convert.type}")
                fi

                return
            fi

            _emit_all(WASMGC_OPERATIONS.conversion(convert.from, convert.to))
        si

        visit(node: Values.Breakable) is
            assert node.is_closed else "structured node generated before it was closed"

            if let region: Values.REGION = node then
                _lower_region(region, null)
            elif let loop: Values.LOOP = node then
                _lower_loop(loop)
            elif let `try: Values.TRY = node then
                if let `finally = `try.finally_region then
                    if `try.catches.count > 0 then
                        _report("a try with both catches and a finally")
                    else
                        _lower_try_finally(`try, `finally)
                    fi
                elif `try.catches.count > 0 then
                    _lower_try_catch(`try)
                else
                    _report("a try with no handler")
                fi
            else
                _report("a generator or asynchronous function")
            fi
        si

        _lower_region(region: Values.REGION, result: VALUE_TYPE?) is
            _push_label(region, false)
            _begin()

            let values = region.body.values

            _lower_all(values)

            // A region that produces a value is left only by its arms,
            // each of which breaks out carrying it, so the end of its
            // last arm does not fall through. Wasm takes the end of a
            // block to be reachable, so it is told.
            if result? /\ values.count > 0 /\ isa Values.Breakable(values[values.count - 1]) then
                _emit(Opcode.UNREACHABLE)
            fi

            let body = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, _block_type(result), body))
        si

        _block_type(result: VALUE_TYPE?) -> BLOCK_TYPE =>
            if let type = result then BLOCK_TYPE.of_value(type) else BLOCK_TYPE() fi

        // `block (loop body (br 0))`: the end of the body goes round
        // again, a BREAK leaves the block, and a CONTINUE branches to the
        // loop, which starts it again.
        _lower_loop(loop: Values.LOOP) is
            _push_label(loop, false)
            _begin()

            _push_label(loop, true)
            _begin()

            _lower_all(loop.body.values)

            _emit(INDEX_INSTRUCTION(Opcode.BR, 0))

            let body = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.LOOP, BLOCK_TYPE(), body))

            let outer = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE(), outer))
        si

        _push_label(node: Values.Breakable?, is_loop_head: bool) is
            _labels.add((node, is_loop_head, null))
        si

        // A label no exit names: a block the lowering adds for itself.
        _push_label() is
            _labels.add((null, false, null))
        si

        // The label of the `try_table` around the protected body of a try
        // with a finally. An exit that finds it before its target leaves
        // through the finally.
        _push_label(finally_exits: WASMGC_FINALLY_EXITS) is
            _labels.add((null, false, finally_exits))
        si

        _pop_label() is
            _labels.remove_at(_labels.count - 1)
        si

        // How many labels lie between the point being lowered and the
        // one at `position` on the label stack: the label a branch
        // instruction names.
        _depth(position: int) -> int => _labels.count - 1 - position

        // An exit branches to its target's label, unless it finds the
        // protected body of a try with a finally on the way there.
        visit(exit: Values.Exit) is
            let is_continue = isa Values.CONTINUE(exit)

            let i mut = _labels.count - 1

            while i >= 0 do
                let label = _labels[i]

                if label.node == exit.target /\ label.is_loop_head == is_continue then
                    _branch(exit, _depth(i))
                    return
                elif let finally_exits = label.finally_exits then
                    _leave_through_finally(exit, finally_exits)
                    return
                fi

                i = i - 1
            od

            _report("an exit from a construct the lowering does not handle")
        si

        _branch(exit: Values.Exit, depth: int) is
            if exit.condition == BRANCH.ALWAYS then
                _emit(INDEX_INSTRUCTION(Opcode.BR, depth))
                return
            fi

            if !_test(exit.condition, exit.operands) then
                return
            fi

            _emit(INDEX_INSTRUCTION(Opcode.BR_IF, depth))
        si

        // Records which exit is being taken and branches to the finally,
        // after which the exit is taken again.
        _leave_through_finally(exit: Values.Exit, finally_exits: WASMGC_FINALLY_EXITS) is
            if exit.condition != BRANCH.ALWAYS then
                _report("a conditional exit from a try with a finally")
                return
            fi

            _emit(I32_CONSTANT(finally_exits.number(exit)))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, finally_exits.selector))
            _emit(INDEX_INSTRUCTION(Opcode.BR, _depth(finally_exits.finally_label)))
        si

        // Every exception is thrown with the one tag, carrying the
        // exception as a non-null reference to the exception type.
        visit(thrown: Values.THROW) is
            let exception = thrown.exception

            if !exception? then
                _report("a rethrow")
                return
            fi

            gen(exception)

            let tag = _exceptions?.tag_index
            let exception_type = _exceptions?.exception

            if !tag? \/ !exception_type? then
                _report("a throw")
                return
            fi

            _coerce_top(exception_type)

            _emit(Opcode.REF_AS_NON_NULL)
            _emit(THROW_INSTRUCTION(tag))
        si

        // The protected body is a `try_table` whose handler receives the
        // exception and the reference that rethrows it. Each catch tests
        // the exception against its type in turn; one that matches has
        // the exception on the stack where its body starts, as the body
        // expects. One no catch matches is rethrown.
        _lower_try_catch(`try: Values.TRY) is
            let tag = _exceptions?.tag_index
            let exception = _exceptions?.exception

            if !tag? \/ !exception? then
                _lower_unhandled(`try)
                _report("a catch")
                return
            fi

            let caught = _temp(exception)
            let rethrow = _temp(VALUE_TYPE.of_abstract(AbstractHeapType.EXN))

            _push_label(`try, false)
            _begin()

            _push_label()
            _begin()

            _push_label()
            _begin()

            _lower_all(`try.body.values)

            let guarded = _end()
            _pop_label()

            // A catch clause's label is counted from outside the
            // `try_table`, so 0 is the handler block.
            _emit(TRY_TABLE_INSTRUCTION(BLOCK_TYPE(), [CATCH_CLAUSE(CatchKind.CATCH_REF, tag, 0)], guarded))
            _emit(INDEX_INSTRUCTION(Opcode.BR, 1))

            let handler = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE.of_type_index(_exceptions!.handler_type), handler))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, rethrow))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, caught))

            for `catch in `try.catches do
                _lower_catch(`catch, caught, exception)
            od

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, rethrow))
            _emit(Opcode.THROW_REF)

            let body = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE(), body))
        si

        // A block a catch body runs in, left early where the exception is
        // not of the catch's type.
        _lower_catch(`catch: Values.CATCH, caught: int, exception: VALUE_TYPE) is
            let target = _registry.type_index(`catch.type)

            if !target? then
                _report("a catch of {`catch.type}")
                return
            fi

            let target_heap = HEAP_TYPE.of_type_index(target)
            let is_every_exception = _registry.is_held_as(exception.heap_type()!, target_heap)

            _push_label()
            _begin()

            if !is_every_exception then
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, caught))
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_TEST, target_heap))
                _emit(Opcode.I32_EQZ)
                _emit(INDEX_INSTRUCTION(Opcode.BR_IF, 0))
            fi

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, caught))

            if is_every_exception then
                _top_cast = exception
            else
                _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, target_heap))
                _top_cast = VALUE_TYPE.of_type_index(target, false)
            fi

            _top_value = null

            _lower_all(`catch.body.values)

            let body = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE(), body))
        si

        // The protected body runs inside a `try_table` that catches
        // everything. An exception runs the finally and is rethrown. An
        // exit from the body records which it is and branches to the
        // finally, after which it is taken again from there, so an exit
        // crossing several finallies runs each of them in turn.
        _lower_try_finally(`try: Values.TRY, `finally: Values.REGION) is
            let exception = VALUE_TYPE.of_abstract(AbstractHeapType.EXN)

            let finally_exits = WASMGC_FINALLY_EXITS(_temp(VALUE_TYPE.of_numeric(NumericType.I32)))
            let rethrow = _temp(exception)

            _emit(I32_CONSTANT(0))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, finally_exits.selector))

            _push_label(`try, false)
            _begin()

            _push_label()
            _begin()

            finally_exits.finally_label = _labels.count - 1

            _push_label()
            _begin()

            _push_label(finally_exits)
            _begin()

            _lower_all(`try.body.values)

            let guarded = _end()
            _pop_label()

            _emit(TRY_TABLE_INSTRUCTION(BLOCK_TYPE(), [CATCH_CLAUSE(CatchKind.CATCH_ALL_REF, 0, 0)], guarded))
            _emit(INDEX_INSTRUCTION(Opcode.BR, 1))

            let exceptional = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE.of_value(exception), exceptional))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, rethrow))

            _lower_region(`finally, null)

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, rethrow))
            _emit(Opcode.THROW_REF)

            let normal = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE(), normal))

            _lower_region(`finally, null)

            let exits = finally_exits.exits

            for i in 0..exits.count do
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, finally_exits.selector))
                _emit(I32_CONSTANT(i + 1))
                _emit(Opcode.I32_EQ)

                _push_label()
                _begin()

                gen(exits[i])

                let taken = _end()
                _pop_label()

                _emit(IF_INSTRUCTION(BLOCK_TYPE(), taken, LIST[INSTRUCTION]()))
            od

            let body = _end()
            _pop_label()

            _emit(BLOCK_INSTRUCTION(Opcode.BLOCK, BLOCK_TYPE(), body))
        si

        // The body and catches of a try lowered for what they reach alone,
        // where there is no tag to catch with.
        _lower_unhandled(`try: Values.TRY) is
            _push_label(`try, false)
            _begin()

            _lower_all(`try.body.values)

            for `catch in `try.catches do
                _lower_all(`catch.body.values)
            od

            _end()
            _pop_label()
        si

        // Leaves an i32 on the stack that is nonzero when `condition`
        // holds of `operands`. False where it cannot.
        _test(condition: BRANCH, operands: Collections.List[Value]) -> bool is
            if _value_type(operands[0].type)?.heap_type()? then
                return _test_reference(condition, operands)
            fi

            let numeric = _numeric(operands[0].type)

            if !numeric? then
                _report("a condition on {operands[0].type}")
                return false
            fi

            _lower_all(operands)

            if condition == BRANCH.Z \/ condition == BRANCH.NZ then
                case numeric
                when NumericType.I32 then
                    if condition == BRANCH.Z then
                        _emit(Opcode.I32_EQZ)
                    fi
                when NumericType.I64 then
                    _emit(Opcode.I64_EQZ)

                    if condition == BRANCH.NZ then
                        _emit(Opcode.I32_EQZ)
                    fi
                else
                    _report("a condition on {operands[0].type}")
                    return false
                esac

                return true
            fi

            if let (comparison, is_unsigned) = WASMGC_OPERATIONS.branch_comparison(condition) then
                _compare(comparison, numeric, is_unsigned)

                return true
            fi

            _report("the condition {condition}")

            return false
        si

        // A reference is zero when it is null, and two references are
        // equal when they are the same object.
        _test_reference(condition: BRANCH, operands: Collections.List[Value]) -> bool is
            _lower_all(operands)

            case condition
            when BRANCH.Z then
                _emit(Opcode.REF_IS_NULL)
            when BRANCH.NZ then
                _emit(Opcode.REF_IS_NULL)
                _emit(Opcode.I32_EQZ)
            when BRANCH.EQ then
                _emit(Opcode.REF_EQ)
            when BRANCH.NE then
                _emit(Opcode.REF_EQ)
                _emit(Opcode.I32_EQZ)
            else
                _report("the condition {condition} on a reference")
                return false
            esac

            return true
        si

        visit(dispatch: Values.DISPATCH) is _report("a generator or asynchronous function") si
        visit(resume: Values.RESUME_POINT) is _report("a generator or asynchronous function") si

        visit(call: Values.Call.GLOBAL) is
            _call(call.function, call.arguments)
        si

        /// A static method takes no receiver, so it is called as a
        /// global function is.
        visit(call: Values.Call.STATIC) is
            if call.constrained_receiver? then
                _report("a constrained call")
            else
                _ensure_initialised(call.function.owner)
                _call(call.function, call.arguments)
            fi
        si

        // A type's static constructor runs once, before the type is first
        // used: before a static member is read, written or called, and
        // before an instance is made. Its flag is set before the body runs,
        // so a use of the type from inside it does not run it again.
        _ensure_initialised(owner: Semantic.Scope?) is
            if let type = _owner_class(owner) then
                if let (constructor, initialised) = _registry.static_constructor(type) then
                    let index_found = _numbering.index_of(constructor)

                    if !index_found? then
                        _report("a static constructor of {type}")
                        return
                    fi

                    let index = index_found

                    let run = LIST[INSTRUCTION]()

                    run.add(I32_CONSTANT(1))
                    run.add(INDEX_INSTRUCTION(Opcode.GLOBAL_SET, initialised))
                    run.add(INDEX_INSTRUCTION(Opcode.CALL, index))

                    _emit(INDEX_INSTRUCTION(Opcode.GLOBAL_GET, initialised))
                    _emit(Opcode.I32_EQZ)
                    _emit(IF_INSTRUCTION(BLOCK_TYPE(), run, LIST[INSTRUCTION]()))
                fi
            fi
        si

        // A method the core library gives a scalar takes the value itself
        // as its receiver. A struct method takes the box as its receiver,
        // so a call on a struct changes it in place.
        visit(call: Values.Call.STRUCT) is
            let function = call.function
            let instance = _instance_of(function)

            if _struct_of(cast Semantic.Types.Typed?(function.owner)?.type)? then
                let index = _index_of(function)

                if !index? then
                    _report("a call to {function.name}")
                    return
                fi

                gen(call.from)
                _coerce_top(_local_type_of_receiver(instance))

                _lower_arguments(function, call.arguments)

                _emit(INDEX_INSTRUCTION(Opcode.CALL, index))
                return
            fi

            let receiver = _registry.receiver_type(instance)

            if !receiver? \/ !receiver.numeric()? then
                _report("a struct method call")
                return
            fi

            let index = _numbering.index_of(instance)

            if !index? then
                _report("a call to {call.function.name}")
                return
            fi

            if let address: Values.ADDRESS = call.from then
                gen(address.value)
            else
                gen(call.from)
            fi

            _lower_arguments(call.function, call.arguments)

            _emit(INDEX_INSTRUCTION(Opcode.CALL, index))
        si
        // A call is direct where the dispatch says so, and where nothing
        // in the program overrides the method, since the whole program is
        // known. Dispatch through a vtable or a trait is not lowered yet.
        visit(call: Values.Call.INSTANCE) is
            let function = call.function
            let dispatch = call.dispatch
            let in_place = _element_in_place
            _element_in_place = false

            if function.is_constructor /\ _is_object_constructor(function) then
                return
            fi

            if _is_get_type(function) then
                _get_type(call)
                return
            fi

            if let constrained: Values.CONSTRAINED = call.from then
                _call_constrained(call, constrained)
                return
            fi

            if let member = _array_member(call) then
                if let operation = _array_operation(member) then
                    _lower_array_operation(operation, call, in_place)
                else
                    _call_direct(call, WASMGC_FUNCTION(member, WASMGC_TYPE_MAPS.function_map(function, _type_map)))
                fi

                return
            fi

            // A method of an instantiated generic trait is owned by the
            // instantiation rather than the trait, so the call reads as
            // virtual; its definition says where it dispatches.
            if dispatch == IR.Dispatch.VIRTUAL /\ _is_trait_method(function) then
                _call_interface(call)
                return
            elif dispatch == IR.Dispatch.VIRTUAL /\ !function.has_no_overriders then
                _call_virtual(call)
                return
            elif dispatch == IR.Dispatch.INTERFACE then
                _call_interface(call)
                return
            elif dispatch != IR.Dispatch.DIRECT /\ dispatch != IR.Dispatch.VIRTUAL then
                _report("a {dispatch} call")
                return
            fi

            _call_direct(call, _instance_of(function))
        si

        // A call on a type parameter's value, once the instantiation has
        // made its type concrete. A scalar's hash code is computed in
        // place; anything else held as a reference is called as any value
        // of its type is.
        _call_constrained(call: Values.Call.INSTANCE, constrained: Values.CONSTRAINED) is
            let receiver =
                if let address: Values.ADDRESS = constrained.value then address.value else constrained.value fi

            let type = _specialize(constrained.type)

            if let scalar = WASMGC_TYPES.scalar(type) then
                if call.function.name =~ "get_hash_code" /\ call.arguments.count == 0 then
                    gen(receiver)
                    let numeric = WASMGC_TYPES.numeric(scalar)

                    _emit_all(
                        WASMGC_OPERATIONS.hash(
                            numeric,
                            _temp(VALUE_TYPE.of_numeric(NumericType.I64)),
                            _temp(VALUE_TYPE.of_numeric(numeric))))
                else
                    _report("a call to {call.function.name} on {type}")
                fi

                return
            fi

            gen(Values.Call.INSTANCE(receiver, call.function, call.arguments, call.type))
        si

        _call_direct(call: Values.Call.INSTANCE, function: WASMGC_FUNCTION) is
            let index_found = _numbering.index_of(function)

            if !index_found? then
                _report("a call to {function.definition.name}")
                return
            fi

            let index = index_found

            gen(call.from)
            _coerce_top(_local_type_of_receiver(function))

            _lower_arguments(call.function, call.arguments)

            _emit(INDEX_INSTRUCTION(Opcode.CALL, index))
        si

        // The receiver's vtable is read from its descriptor and the
        // method's slot called. The receiver is held in a local, since it
        // is both the first argument and where the vtable comes from.
        _call_virtual(call: Values.Call.INSTANCE) is
            let function = call.function
            let dispatch = _registry.dispatch

            if _registry.discovering then
                _registry.note_dispatched(function)
                gen(call.from)
                _lower_all(call.arguments)
                return
            fi

            let slot = dispatch.slot_of(_instance_of(function))

            if !slot? then
                _report("a virtual call to {function.name}")
                return
            fi

            dispatch.use_slot(slot, _numbering)

            let receiver_type = VALUE_TYPE.of_type_index(_registry.type_index(slot.owner)!, true)
            let receiver = _temp(receiver_type)

            gen(call.from)
            _coerce_top(receiver_type)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, receiver))

            _lower_arguments(function, call.arguments)

            let vtable_type = dispatch.vtable_type(slot.owner)!

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, receiver))
            _load_descriptor()
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, WASMGC_TYPE_REGISTRY.DESCRIPTOR_VTABLE))
            _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(vtable_type)))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, vtable_type, slot.index))
            _emit(TYPE_INSTRUCTION(Opcode.CALL_REF, slot.signature))
        si

        // Writes a value for display through the displayer its descriptor
        // holds, answering whether it has one.
        _lower_display(arguments: Collections.List[Value]) is
            if let state_class = _registry.class_of(_specialize(arguments[1].type)) then
                _registry.note_display(state_class)
            fi

            let value = _temp(_registry.object_reference)
            let state = _temp(_registry.object_reference)
            let displayer = _temp(VALUE_TYPE.of_abstract(AbstractHeapType.FUNC))
            let signature = _registry.display_signature

            gen(arguments[0])
            _coerce_top(_registry.object_reference)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, value))
            _load_descriptor()
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, WASMGC_TYPE_REGISTRY.DESCRIPTOR_DISPLAY))
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, displayer))

            gen(arguments[1])
            _coerce_top(_registry.object_reference)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, state))

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, displayer))
            _emit(Opcode.REF_IS_NULL)
            _emit(
                IF_INSTRUCTION(
                    BLOCK_TYPE.of_value(VALUE_TYPE.of_numeric(NumericType.I32)),
                    [I32_CONSTANT(0)]: INSTRUCTION,
                    [
                        INDEX_INSTRUCTION(Opcode.LOCAL_GET, value),
                        INDEX_INSTRUCTION(Opcode.LOCAL_GET, state),
                        INDEX_INSTRUCTION(Opcode.LOCAL_GET, displayer),
                        HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(signature)),
                        TYPE_INSTRUCTION(Opcode.CALL_REF, signature),
                        I32_CONSTANT(1)
                    ]: INSTRUCTION))
        si

        // Reads the descriptor of the object on the stack, which traps
        // where it is null.
        _load_descriptor() is
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.OBJECT_TYPE_INDEX, 0))
        si

        // A trait call with one possible implementation in the program is
        // direct. Any other reads the trait table at the selector's row,
        // offset by the receiver's class number.
        _call_interface(call: Values.Call.INSTANCE) is
            let function = call.function
            let dispatch = _registry.dispatch

            if _registry.discovering then
                _registry.note_dispatched(function)

                // The trait instance the call goes through, and the one
                // declaring the member, are known to the planner, which
                // gives each the implementors of its variant instances.
                if let trait_type = _trait_instance(function.owner) then
                    dispatch.selector_of(cast Function?(function.root_specialized_from)!, trait_type)
                fi

                gen(call.from)
                _lower_all(call.arguments)
                return
            fi

            let trait_type = _trait_instance(function.owner)

            let selector = if trait_type? then dispatch.selector_of(cast Function?(function.root_specialized_from)!, trait_type) else null fi

            if !selector? then
                _report("a trait call to {function.name}")
                return
            fi

            if let only = dispatch.only_implementation(selector) then
                _call_direct(call, only)
                return
            fi

            dispatch.use_selector(selector, _numbering)

            let receiver = _temp(_registry.object_reference)

            gen(call.from)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, receiver))

            _lower_arguments(function, call.arguments)

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, receiver))
            _load_descriptor()
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, WASMGC_TYPE_REGISTRY.DESCRIPTOR_TYPE_INDEX, WASMGC_TYPE_REGISTRY.DESCRIPTOR_CLASS_ID))
            _emit(I32_CONSTANT(selector.offset))
            _emit(Opcode.I32_ADD)
            _emit(CALL_INDIRECT_INSTRUCTION(selector.signature, 0))
        si

        _is_trait_method(function: Function) -> bool =>
            cast Semantic.Symbols.Classy?(function.root_specialized_from.owner)?.is_trait ?? false

        _local_type_of_receiver(function: WASMGC_FUNCTION) -> VALUE_TYPE? =>
            _registry.receiver_type(function)

        // The root class has no constructor body to run, so a call to it
        // from a constructor does nothing.
        _is_object_constructor(function: Function) -> bool =>
            if let owner: Semantic.Symbols.Classy = function.owner then owner.is_object else false fi
        // The function value is held in a local: its receiver is the
        // first argument, and its function is called after the rest.
        visit(call: Values.Call.CLOSURE) is
            let func_type = call.func_type ?? call.from.type

            let signature = if func_type? then _registry.closure_signature(_specialize(func_type)!) else null fi

            if !signature? then
                _report("a call to a function value of type {func_type}")
                return
            fi

            let closure_type = VALUE_TYPE.of_type_index(_registry.closure_type_index, true)
            let closure = _temp(closure_type)

            gen(call.from)
            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_TEE, closure))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, _registry.closure_type_index, WASMGC_TYPE_REGISTRY.CLOSURE_RECEIVER))

            let parameters = func_type!.arguments

            for i in 0..call.arguments.count do
                gen(call.arguments[i])

                if i < parameters.count then
                    _normalise_for(parameters[i])
                fi
            od

            _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, closure))
            _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, _registry.closure_type_index, WASMGC_TYPE_REGISTRY.CLOSURE_FUNCTION))
            _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(signature)))
            _emit(TYPE_INSTRUCTION(Opcode.CALL_REF, signature))
        si

        // An operation the host provides is a call of its import rather
        // than an operation the generator lowers.
        visit(call: Values.Call.INNATE) is
            if WASMGC_IMPORTS.is_host(call.innate_name) then
                _call_host(call.innate_name, call.arguments)
            elif _lower_representation(call.innate_name, call.arguments) then
                return
            elif call.innate_name.starts_with("nullable.") then
                _lower_nullable(call.innate_name, call.from)
            elif !call.is_lowered then
                _registry.note_lowered(call)
                gen(call.lower())
            elif _registry.was_lowered(call) then
                // Lowered by an earlier pass over the same body: a body is
                // lowered while discovering and for each instantiation.
                gen(call.lowering)
            fi
        si

        // A value-type optional is a reference to the box its value lives
        // in, null where it is absent. Its receiver is reached by address,
        // which for an optional is the reference itself.
        _lower_nullable(operation: string, from: Value?) is
            if !from? then
                _report("the operation {operation}")
                return
            fi

            let receiver = from
            let inner = _optional_inner(receiver.type)

            if operation =~ "nullable.has_value" then
                _gen_optional(receiver)
                _emit(Opcode.REF_IS_NULL)
                _emit(Opcode.I32_EQZ)
            elif operation =~ "nullable.value" /\ inner? then
                _gen_optional(receiver)

                if let index = _registry.box_index(_specialize(inner)) then
                    _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(index)))
                    _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, index, WASMGC_TYPE_REGISTRY.BOX_VALUE))
                elif let held = _struct_of(inner) then
                    _emit(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(_registry.type_index(held)!)))
                    _copy_if_mutable(inner)
                else
                    _report("a value-type optional of {inner}")
                fi
            else
                _report("the operation {operation}")
            fi
        si

        // The value type a value-type optional `type`, or a reference to
        // one, holds, or null where it is neither.
        _optional_inner(type: Type?) -> Type? is
            let specialized mut = _specialize(type)

            if let reference: Semantic.Types.REFERENCE = specialized then
                specialized = reference.arguments[0]
            fi

            if specialized? /\ specialized.is_optional /\ specialized.is_value_type then
                return specialized.optional_inner_type
            fi

            return null
        si

        // Lowers `value`, a value-type optional or its address, to the
        // reference that holds it.
        _gen_optional(value: Value) is
            if let address: Values.ADDRESS = value then
                gen(address.value)
            else
                gen(value)
            fi
        si

        _call_host(operation: string, arguments: Collections.List[Value]) is
            let index = _imports.index_of(operation)

            if !index? then
                _report("{operation}, which no host import provides")
                return
            fi

            for argument in arguments do
                gen(argument)

                if WASMGC_TYPES.is_string(argument.type) then
                    _to_host(argument.type)
                fi
            od

            _emit(INDEX_INSTRUCTION(Opcode.CALL, index))
        si

        // Converts the ghūl string on the stack to the JavaScript string
        // a host import takes.
        _to_host(type: Type?) is
            if let strings = _strings then
                _coerce_top(strings.string_reference)
                _emit(INDEX_INSTRUCTION(Opcode.CALL, strings.to_host_function))
            else
                _report("a string passed to the host")
            fi
        si

        visit(store: Values.Store.SYMBOL) is _report("a store to {store.symbol.name}") si

        visit(store: Values.Store.LOCAL_VARIABLE) is
            if Values.state_machine_field_for(store.symbol)? then
                _report("a generator or asynchronous function's local")
            elif let variable = cast Semantic.Symbols.Variable?(store.symbol) then
                if let cell = _cell_index(variable.ir_local) then
                    _emit(INDEX_INSTRUCTION(Opcode.LOCAL_GET, _local(variable.ir_local)))
                    gen(store.value)

                    _normalise_for(variable.ir_local.type)
                    _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_SET, cell, WASMGC_TYPE_REGISTRY.BOX_VALUE))
                    return
                fi

                gen(store.value)

                _normalise_for(variable.ir_local.type)
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, _local(variable.ir_local)))
            else
                _report("a store to {store.symbol.name}")
            fi
        si

        visit(store: Values.Store.LOCAL_ARGUMENT) is
            let symbol = store.symbol

            if Values.state_machine_field_for(symbol)? then
                _report("a generator or asynchronous function's argument")
            elif let packed_local = Values.packed_parameter_local_for(symbol) then
                gen(store.value)
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, _local(packed_local)))
            elif let index = _argument_index(symbol) then
                gen(store.value)

                _normalise_for(symbol.type)
                _emit(INDEX_INSTRUCTION(Opcode.LOCAL_SET, index))
            else
                _report("a store to an argument of another function")
            fi
        si

        visit(store: Values.Store.STATIC_FIELD) is
            _global_set(store.symbol, store.value)
        si

        visit(store: Values.Store.GLOBAL_FIELD) is
            _global_set(store.symbol, store.value)
        si

        visit(store: Values.Store.INSTANCE_FIELD) is
            if let `field = _instance_field(store.from, store.symbol) then
                _struct_receiver(store.from!)
                _coerce_top(VALUE_TYPE.of_type_index(`field.type_index, true))

                gen(store.value)

                _normalise_for(store.type)
                _emit(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_SET, `field.type_index, `field.field_index))
            fi
        si
    si
si
