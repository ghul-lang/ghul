namespace IR.WasmGC is
    use Collections.LIST
    use Collections.MAP

    /// The distinct string literals a program uses, each placed in one run
    /// of UTF-16 code units, low byte first, ready for a data segment.
    class WASMGC_LITERAL_POOL is
        _indices: MAP[string, int]
        _entries: LIST[(text: string, offset: int)]
        _bytes: LIST[ubyte]

        init() is
            _indices = MAP[string, int]()
            _entries = LIST[(text: string, offset: int)]()
            _bytes = LIST[ubyte]()
        si

        /// The literals in the order they were first added, each with the
        /// byte offset its code units start at.
        entries: Collections.List[(text: string, offset: int)] => _entries

        /// Every literal's code units, in the order they were added.
        bytes: ubyte[] => _bytes.to_array()

        /// The position of `text` among the literals, adding it the first
        /// time it is seen. Equal texts share one position.
        add(text: string) -> int is
            let index mut = 0

            if _indices.try_get_value(text, index ref) then
                return index
            fi

            index = _entries.count

            _indices[text] = index
            _entries.add((text, _bytes.count))

            for c in text do
                let unit = int(c)

                _bytes.add(ubyte(unit & 0xFF))
                _bytes.add(ubyte(unit >> 8))
            od

            return index
        si
    si
si
