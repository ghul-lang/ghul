namespace IR.WasmGC is
    use IR.Program

    use Wasm.MODULE
    use Wasm.SUB_TYPE
    use Wasm.STRUCT_TYPE
    use Wasm.FUNC_TYPE
    use Wasm.FIELD_TYPE
    use Wasm.VALUE_TYPE
    use Wasm.HEAP_TYPE
    use Wasm.TYPE_FIELD_INSTRUCTION
    use Wasm.FUNCTION
    use Wasm.TABLE
    use Wasm.LIMITS
    use Wasm.ELEMENT_SEGMENT
    use Wasm.ElementMode
    use Wasm.AbstractHeapType
    use Wasm.INSTRUCTION
    use Wasm.INDEX_INSTRUCTION
    use Wasm.TYPE_INSTRUCTION
    use Wasm.HEAP_TYPE_INSTRUCTION
    use Wasm.NumericType
    use Wasm.I32_CONSTANT
    use Wasm.Opcode

    use Collections.LIST
    use Collections.MAP
    use Collections.SET

    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function
    use Semantic.Symbols.GENERIC
    use Semantic.Scope

    use IR.Emitter.SRM_MEMBER_ORDER
    use IR.Emitter.SRM_EMITTED_TYPE

    /// The WasmGC side of how the program's virtual and trait calls
    /// dispatch: the function and vtable types the planned slots and
    /// selectors need, the trait table, and the thunks every vtable and
    /// table entry calls through.
    ///
    /// Every entry is a thunk with the slot's or row's own signature, which
    /// casts the receiver to the implementation's class and calls it.
    class WASMGC_DISPATCH: DispatchTarget is
        _registry: WASMGC_TYPE_REGISTRY
        _plan: DISPATCH_PLAN

        _vtable_types: MAP[CLASS_INSTANCE, int]

        _types: LIST[SUB_TYPE]
        _next_type: int

        _thunk_indices: MAP[int, MAP[FUNCTION_INSTANCE, int]]
        _box_hashes: MAP[CLASS_INSTANCE, int]
        _box_equalities: MAP[CLASS_INSTANCE, int]
        _generic_calls: LIST[(method: Function, arguments: Collections.List[Type])]
        _found: LIST[CLASS_INSTANCE]

        /// Reaches, while discovering, a function a dispatched generic call
        /// can run without naming it.
        reach: ((FUNCTION_INSTANCE) -> void)? public

        init(registry: WASMGC_TYPE_REGISTRY) is
            _registry = registry
            _plan = DISPATCH_PLAN(self)

            _vtable_types = MAP[CLASS_INSTANCE, int]()

            _types = LIST[SUB_TYPE]()

            _thunk_indices = MAP[int, MAP[FUNCTION_INSTANCE, int]]()
            _box_hashes = MAP[CLASS_INSTANCE, int]()
            _box_equalities = MAP[CLASS_INSTANCE, int]()
            _generic_calls = LIST[(method: Function, arguments: Collections.List[Type])]()
            _found = LIST[CLASS_INSTANCE]()
        si

        /// The trait table's size, once `plan` has packed it.
        table_size: int => _plan.table_size

        /// Plans the slots and selectors of the classes in `ordered`, which
        /// lists parents before children, and answers the function and
        /// vtable types they need, to be numbered from `first_index` on.
        plan(ordered: Collections.List[CLASS_INSTANCE], first_index: int) -> Collections.List[SUB_TYPE] is
            _next_type = first_index

            _plan.plan_slots(ordered)

            for type in ordered do
                if _plan.has_slots(type) then
                    _add_vtable_type(type)
                fi
            od

            _plan.plan_traits()

            return _types
        si

        root: CLASS_INSTANCE? => _registry.root
        numbering: CLASS_ID_NUMBERING[CLASS_INSTANCE] => _registry.numbering
        class_of(type: Type?) -> CLASS_INSTANCE? => _registry.class_of(type)
        superclass_of(type: CLASS_INSTANCE) -> CLASS_INSTANCE? => _registry.superclass_of(type)
        methods_of(definition: Classy) -> Collections.List[Function] => _registry.methods_of(definition)
        is_object(type: CLASS_INSTANCE) -> bool => _registry.is_object(type)
        is_object_type(type: CLASS_INSTANCE) -> bool => _registry.is_object_type(type)
        is_box(type: CLASS_INSTANCE) -> bool => _registry.is_box(type)
        is_array(type: CLASS_INSTANCE) -> bool => _registry.is_array(type)
        is_string(type: CLASS_INSTANCE) -> bool => _registry.is_string(type)
        is_bigint(type: CLASS_INSTANCE) -> bool => _registry.is_bigint(type)
        is_instantiated(type: CLASS_INSTANCE) -> bool => _registry.is_instantiated(type)

        slot_signature(owner: CLASS_INSTANCE, method: FUNCTION_INSTANCE) -> int? =>
            _signature(VALUE_TYPE.of_type_index(_registry.type_index(owner)!, true), method)

        selector_signature(method: FUNCTION_INSTANCE) -> int? =>
            _signature(_registry.object_reference, method)

        _add_type(sub_type: SUB_TYPE) -> int is
            _types.add(sub_type)

            let index = _next_type

            _next_type = _next_type + 1

            return index
        si

        // A function type in the recursion group: the receiver, then the
        // method's own arguments, then its result, at the method's
        // instantiation. Null where one of them is a type the target cannot
        // hold yet.
        _signature(receiver: VALUE_TYPE, method: FUNCTION_INSTANCE) -> int? is
            let parameters = LIST[VALUE_TYPE]()

            parameters.add(receiver)

            for argument in method.definition.arguments do
                if let value_type = _registry.value_type(method.specialize(argument)) then
                    parameters.add(value_type)
                else
                    return null
                fi
            od

            let results = LIST[VALUE_TYPE]()
            let return_type = method.specialize(method.definition.return_type)

            if !WASMGC_TYPES.is_void(return_type) then
                if let value_type = _registry.value_type(return_type) then
                    results.add(value_type)
                else
                    return null
                fi
            fi

            return _add_type(SUB_TYPE(FUNC_TYPE(parameters.to_array(), results.to_array()), true, []))
        si

        /// Asks the registry, while it is discovering, for the cells and
        /// boxes the by-reference parameters of the slots and selectors
        /// `type` takes a place in are held in, which `plan` needs before
        /// any body that reaches them is compiled.
        ///
        /// - type: an instantiated class, box, string or array type
        discover_reference_parameters(type: CLASS_INSTANCE) is
            _discover_reference_parameters(type, SET[CLASS_INSTANCE]())
        si

        _discover_reference_parameters(type: CLASS_INSTANCE, seen: SET[CLASS_INSTANCE]) is
            if !seen.add(type) then
                return
            fi

            for method in _registry.methods_of(type.definition) do
                if DISPATCH_PLAN.is_dispatched(method) then
                    let function = FUNCTION_INSTANCE(method, type.type_map)

                    for argument in method.arguments do
                        if let reference: Semantic.Types.REFERENCE = function.specialize(argument) then
                            _registry.value_type(reference)
                        fi
                    od
                fi
            od

            for ancestor in type.definition.ancestors do
                let specialized = TYPE_MAPS.specialize(ancestor, type.type_map)!

                if let ancestor_type = _plan.trait_of(specialized) ?? _registry.class_of(specialized) then
                    _discover_reference_parameters(ancestor_type, seen)
                fi
            od
        si

        _add_vtable_type(type: CLASS_INSTANCE) is
            let fields = LIST[FIELD_TYPE]()

            for slot in _plan.slots(type) do
                fields.add(FIELD_TYPE.of_reference(VALUE_TYPE.of_type_index(slot.signature, true), false))
            od

            let super_types = LIST[int]()

            if let parent = _plan.parent(type) then
                let parent_vtable mut = 0

                if _vtable_types.try_get_value(parent, parent_vtable ref) then
                    super_types.add(parent_vtable)
                fi
            fi

            _vtable_types[type] =
                _add_type(SUB_TYPE(STRUCT_TYPE(fields.to_array()), !_registry.may_gain_children(type), super_types.to_array()))
        si

        /// The one instance of the trait a value of `type` is, at its
        /// arguments.
        trait_of(type: Type) -> CLASS_INSTANCE? => _plan.trait_of(type)

        /// The one instance of the trait `definition` at the arguments
        /// `type_map` gives its parameters.
        trait_of(definition: Classy, type_map: Collections.Map[Symbol, Type]) -> CLASS_INSTANCE? =>
            _plan.trait_of(definition, type_map)

        /// The vtable slot a call to `method` reads, or null where nothing
        /// overrides it.
        slot_of(method: FUNCTION_INSTANCE) -> DISPATCH_SLOT? => _plan.slot_of(method)

        /// The vtable type of `type`, whose fields are its slots.
        vtable_type(type: CLASS_INSTANCE) -> int? is
            let result mut = 0

            if _vtable_types.try_get_value(type, result ref) then
                return result
            fi

            return null
        si

        /// The selector a call to the trait method `method` dispatches on,
        /// where `method` is called on an instance of `trait_type`, or null
        /// where it has none.
        selector_of(method: Function, trait_type: CLASS_INSTANCE) -> TRAIT_SELECTOR? =>
            _plan.selector_of(method, trait_type)

        /// Records, while discovering, a call to the generic trait method
        /// `method` through `trait_type` at `arguments`, its own type
        /// arguments, so the instantiation has a row of its own.
        ///
        /// - method: the trait method called
        /// - trait_type: the trait instance the call goes through
        /// - arguments: the method's own type arguments at the call
        note_generic_call(method: Function, trait_type: CLASS_INSTANCE, arguments: Collections.List[Type]) is
            if !_plan.note_generic_call(method, trait_type, arguments)? then
                return
            fi

            _generic_calls.add((method, arguments))

            for type in LIST[CLASS_INSTANCE](_found) do
                _reach_generic(type, method, arguments)
            od
        si

        /// Records, while discovering, that a value of `type` can exist, and
        /// reaches its implementation of every generic trait method a call
        /// was recorded at.
        ///
        /// - type: the class found instantiated
        note_generic_implementor(type: CLASS_INSTANCE) is
            _found.add(type)

            for call in LIST[(method: Function, arguments: Collections.List[Type])](_generic_calls) do
                _reach_generic(type, call.method, call.arguments)
            od
        si

        _reach_generic(type: CLASS_INSTANCE, method: Function, arguments: Collections.List[Type]) is
            if let implementation = _plan.generic_implementation(type, method, arguments), r = reach then
                r(implementation)
            fi
        si

        /// The selector a call to the generic trait method `method` at
        /// `arguments` dispatches on, where it is called on an instance of
        /// `trait_type`, or null where it has none.
        generic_selector_of(method: Function, trait_type: CLASS_INSTANCE, arguments: Collections.List[Type]) -> TRAIT_SELECTOR? =>
            _plan.generic_selector_of(method, trait_type, arguments)

        /// The one method any call to `selector` can run, or null where the
        /// row has more than one, or none.
        only_implementation(selector: TRAIT_SELECTOR) -> FUNCTION_INSTANCE? =>
            _plan.only_implementation(selector)

        /// The classes implementing `trait_type`, or null where the program
        /// has none.
        implementors(trait_type: CLASS_INSTANCE) -> Collections.List[CLASS_INSTANCE]? =>
            _plan.implementors(trait_type)

        /// Marks every implementation that can fill `slot` as reached, so
        /// the walk compiles it.
        use_slot(slot: DISPATCH_SLOT, numbering: WASMGC_FUNCTION_NUMBERING) =>
            _plan.use_slot(slot, implementation => numbering.index_of(implementation))

        /// Marks every implementation in `selector`'s row as reached, so the
        /// walk compiles it.
        use_selector(selector: TRAIT_SELECTOR, numbering: WASMGC_FUNCTION_NUMBERING) =>
            _plan.use_selector(selector, implementation => numbering.index_of(implementation))

        /// Adds the trait table to `module`, once the walk has reached
        /// everything. Entries whose implementation the walk did not reach
        /// stay empty: nothing calls through their selector.
        finish(module: MODULE, numbering: WASMGC_FUNCTION_NUMBERING) is
            let entries = LIST[Collections.List[INSTRUCTION]]()

            for i in 0.._plan.table_size do
                entries.add([HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_abstract(AbstractHeapType.FUNC))]: INSTRUCTION)
            od

            for (selector_method, row) in _plan.rows do
                let selector = _plan.selector(selector_method)

                for (column, implementation) in row do
                    if numbering.indexed(implementation)? then
                        let thunk = _thunk(selector.signature, implementation, numbering)

                        entries[selector.offset + column] = [INDEX_INSTRUCTION(Opcode.REF_FUNC, thunk)]: INSTRUCTION
                    fi
                od
            od

            if _plan.table_size > 0 then
                let funcref = VALUE_TYPE.of_abstract(AbstractHeapType.FUNC)

                let table = module.add_table(TABLE(funcref, LIMITS(_plan.table_size, _plan.table_size)))

                module.add_element_segment(
                    ELEMENT_SEGMENT.of_expressions(ElementMode.ACTIVE, table, [I32_CONSTANT(0)]: INSTRUCTION, funcref, entries))
            fi
        si

        /// The constant expression building the vtable of `type`, or null
        /// where it has none. An entry the walk did not reach is null.
        vtable(type: CLASS_INSTANCE, numbering: WASMGC_FUNCTION_NUMBERING) -> Collections.List[INSTRUCTION]? is
            let vtable_type = vtable_type(type)

            if !vtable_type? then
                return null
            fi

            let result = LIST[INSTRUCTION]()
            let slots = _plan.slots(type)
            let entries = _plan.slot_entries(type)

            for i in 0..slots.count do
                if let implementation = entries[i] /\ _is_box_hash(type, implementation) then
                    result.add(INDEX_INSTRUCTION(Opcode.REF_FUNC, _box_hash(slots[i].signature, type, numbering)))
                elif let implementation = entries[i] /\ _is_box_equals(type, implementation) then
                    result.add(INDEX_INSTRUCTION(Opcode.REF_FUNC, _box_equals(slots[i].signature, type, numbering)))
                elif let implementation = entries[i] /\ numbering.indexed(implementation)? then
                    result.add(INDEX_INSTRUCTION(Opcode.REF_FUNC, _thunk(slots[i].signature, implementation, numbering)))
                else
                    result.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_NULL, HEAP_TYPE.of_type_index(slots[i].signature)))
                fi
            od

            result.add(TYPE_INSTRUCTION(Opcode.STRUCT_NEW, vtable_type))

            return result
        si

        // The thunk with `signature` that calls `implementation`, reserved
        // the first time it is asked for. It takes the signature's
        // parameters, casts the receiver to the class the implementation
        // belongs to, and calls it.
        _thunk(signature: int, implementation: FUNCTION_INSTANCE, numbering: WASMGC_FUNCTION_NUMBERING) -> int is
            if !_thunk_indices.contains_key(signature) then
                _thunk_indices[signature] = MAP[FUNCTION_INSTANCE, int]()
            fi

            let by_implementation = _thunk_indices[signature]

            let index mut = 0

            if by_implementation.try_get_value(implementation, index ref) then
                return index
            fi

            let registry = _registry

            index = numbering.reserve(() is
                let body = LIST[INSTRUCTION]()

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))

                if let receiver = registry.receiver_type(implementation) then
                    if let heap_type = receiver.heap_type() /\ !heap_type.matches(registry.object_reference.heap_type()!) then
                        body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST_NULL, heap_type))
                    elif receiver.numeric()? then
                        // A scalar's method takes the value, so the box is
                        // opened first.
                        if let owner: Classy = implementation.definition.owner then
                            if let box = registry.box_index(Semantic.Types.NAMED(owner)) then
                                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(box)))
                                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, box, WASMGC_TYPE_REGISTRY.BOX_VALUE))
                            fi
                        fi
                    fi
                fi

                for i in 0..implementation.definition.arguments.count do
                    body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, i + 1))
                od

                body.add(INDEX_INSTRUCTION(Opcode.CALL, numbering.indexed(implementation)!))

                return FUNCTION(signature, [], body)
            si)

            by_implementation[implementation] = index

            return index
        si

        // Whether `implementation` is the root's `get_hash_code` filling a
        // slot in the vtable of the box `type`, which hashes the scalar it
        // holds instead.
        _is_box_hash(type: CLASS_INSTANCE, implementation: FUNCTION_INSTANCE) -> bool =>
            _registry.is_box(type) /\
            implementation.definition.name =~ "get_hash_code" /\
            implementation.definition.arguments.count == 0 /\
            (cast Classy?(implementation.definition.owner)?.is_object ?? false)

        // A box's `get_hash_code`: the hash of the scalar it holds.
        _box_hash(signature: int, type: CLASS_INSTANCE, numbering: WASMGC_FUNCTION_NUMBERING) -> int is
            let index mut = 0

            if _box_hashes.try_get_value(type, index ref) then
                return index
            fi

            let registry = _registry

            index = numbering.reserve(() is
                let box_index = registry.type_index(type)!
                let numeric = WASMGC_TYPES.numeric_of(registry.boxed_type(type))!

                let body = LIST[INSTRUCTION]()

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, HEAP_TYPE.of_type_index(box_index)))
                body.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, box_index, 1))

                if let scalar = WASMGC_TYPES.scalar(registry.boxed_type(type)) /\ WASMGC_TYPES.is_narrow(scalar) then
                    body.add_range(WASMGC_OPERATIONS.normalise(scalar))
                fi

                body.add_range(WASMGC_OPERATIONS.hash(numeric, 1, 2))

                return FUNCTION(signature, [VALUE_TYPE.of_numeric(NumericType.I64), VALUE_TYPE.of_numeric(numeric)], body)
            si)

            _box_hashes[type] = index

            return index
        si

        // Whether `implementation` is the root's `equals` filling a slot in
        // the vtable of the box `type`, which compares the scalar it holds
        // instead, as the scalar's own Equals does on .NET.
        _is_box_equals(type: CLASS_INSTANCE, implementation: FUNCTION_INSTANCE) -> bool =>
            _registry.is_box(type) /\
            WASMGC_TYPES.numeric_of(_registry.boxed_type(type))? /\
            implementation.definition.name =~ "equals" /\
            implementation.definition.arguments.count == 1 /\
            (cast Classy?(implementation.definition.owner)?.is_object ?? false)

        // A box's `equals`: true where the other object is a box of the same
        // type, with the same descriptor, holding a value `=~` calls equal.
        _box_equals(signature: int, type: CLASS_INSTANCE, numbering: WASMGC_FUNCTION_NUMBERING) -> int is
            let index mut = 0

            if _box_equalities.try_get_value(type, index ref) then
                return index
            fi

            let registry = _registry

            index = numbering.reserve(() is
                let box_index = registry.type_index(type)!
                let numeric = WASMGC_TYPES.numeric_of(registry.boxed_type(type))!
                let box_heap = HEAP_TYPE.of_type_index(box_index)

                let same = LIST[INSTRUCTION]()

                same.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 0))
                same.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, box_heap))
                same.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, box_index, 0))
                same.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 1))
                same.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, box_heap))
                same.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, box_index, 0))
                same.add(Wasm.SIMPLE_INSTRUCTION(Opcode.REF_EQ))

                for receiver in [0, 1] do
                    same.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, receiver))
                    same.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_CAST, box_heap))
                    same.add(TYPE_FIELD_INSTRUCTION(Opcode.STRUCT_GET, box_index, 1))
                    same.add_range(WASMGC_OPERATIONS.canonical_bits(numeric, 2))
                od

                same.add(Wasm.SIMPLE_INSTRUCTION(WASMGC_OPERATIONS.bits_equal(numeric)))
                same.add(Wasm.SIMPLE_INSTRUCTION(Opcode.I32_AND))

                let body = LIST[INSTRUCTION]()

                body.add(INDEX_INSTRUCTION(Opcode.LOCAL_GET, 1))
                body.add(HEAP_TYPE_INSTRUCTION(Opcode.REF_TEST, box_heap))
                body.add(
                    Wasm.IF_INSTRUCTION(
                        Wasm.BLOCK_TYPE.of_value(VALUE_TYPE.of_numeric(NumericType.I32)),
                        same,
                        [I32_CONSTANT(0)]: INSTRUCTION))

                return FUNCTION(signature, [VALUE_TYPE.of_numeric(numeric)], body)
            si)

            _box_equalities[type] = index

            return index
        si
    si
si
