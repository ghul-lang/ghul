namespace IR.WasmGC is
    use IO.File

    use Wasm.MODULE
    use Wasm.FUNCTION
    use Wasm.FUNC_TYPE
    use Wasm.VALUE_TYPE
    use Wasm.EXPORT
    use Wasm.ExportKind
    use Wasm.NAME_MAP
    use Wasm.NAME_SECTION
    use Wasm.CUSTOM_SECTION
    use Wasm.BINARY_WRITER
    use Wasm.WAT_PRINTER

    use Collections.LIST
    use Collections.MAP
    use Collections.STACK

    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use Values.Value

    /// Writes the program as a WebAssembly module using the GC proposal.
    ///
    /// Wasm numbers every function and type before a body can name one,
    /// so each body is kept as it is finished and lowered only once the
    /// last has been handed over, in `end_assembly`.
    class WASMGC_BACKEND: Backend is
        _bodies: LIST[(function: Function, values: LIST[Value])]
        _enclosing: STACK[LIST[Value]?]
        _current: LIST[Value]?

        _host_declarations: LIST[Function]

        _entry_point: Function?
        _module: MODULE?
        _want_library: bool

        init() is
            _bodies = LIST[(function: Function, values: LIST[Value])]()
            _host_declarations = LIST[Function]()
            _enclosing = STACK[LIST[Value]?]()
        si

        /// Starts a module, discarding anything kept from an earlier one.
        install(module_name: string, module_version: string, want_library: bool) is
            reset()

            _want_library = want_library
        si

        reset() is
            _bodies.clear()
            _host_declarations.clear()
            _enclosing.clear()
            _current = null
            _entry_point = null
            _module = null
        si

        begin_assembly() is si

        /// Numbers and lowers every kept body into the module `write` writes.
        end_assembly() is
            _module = _build_module()
        si

        /// The driver refuses resources before a wasm module is written.
        add_resource(name: string, content: ubyte[]) is si

        /// Writes the module to `path`, and its text form where the build
        /// asks for one. An executable also gets its JavaScript loader,
        /// beside it with the extension `.mjs`.
        write(path: string) is
            let module = _module

            if !module? then
                return
            fi

            File.write_all_bytes(path, BINARY_WRITER().write(module))

            if !_want_library then
                WASMGC_LOADER.write(path)
            fi

            if let wat_path = IoC.CONTAINER.instance.build_flags.wat_output then
                File.write_all_text(wat_path, WAT_PRINTER().print(module))
            fi
        si

        begin_body() is
            _enclosing.push(_current)
            _current = LIST[Value]()
        si

        begin_body(member: Symbol) is
            begin_body()
        si

        write(value: Value) is
            _current!.add(value)
        si

        /// Keeps the body for lowering. A function that provides an
        /// intrinsic has its body dropped, since a call to it lowers to the
        /// operation itself; one the host provides becomes an import.
        finish_body(function: Function) is
            if WASMGC_IMPORTS.is_host(function.intrinsic_operation) then
                _host_declarations.add(function)
                return
            elif function.intrinsic_operation? then
                return
            fi

            _bodies.add((function, _current!))
        si

        /// Reports the frame member: this target generates no generators or
        /// asynchronous functions yet.
        finish_frame_member_body(frame: Classy, member: FrameMember) is
            _report(frame.location, "a generator or asynchronous function")
        si

        /// Reports the initializer: this target generates no unions yet.
        finish_unit_variant_initializer(variant: Classy) is
            _report(variant.location, "a union")
        si

        end_body() is
            assert _enclosing.count > 0 else "body ended without one begun"

            _current = _enclosing.pop()
        si

        abandon_bodies() is
            _enclosing.clear()
            _current = null
        si

        /// Always false: this target generates no unions yet.
        has_unit_variant_instance(variant: Classy) -> bool => false

        /// The function the module starts at, run through the `_start` it
        /// exports.
        mark_entry_point(function: Function) is
            _entry_point = function
        si

        _report(location: Source.LOCATION, construct: string) is
            IoC.CONTAINER.instance.logger.error(
                location,
                "code generation for {construct} is not supported on the wasm target")
        si

        // Builds the types, declares the imports, numbers every kept
        // function after them, then lowers each body against those
        // numbers.
        _build_module() -> MODULE is
            let module = MODULE()

            let registry = _build_registry(module)

            let imports = WASMGC_IMPORTS(module)

            for host in _host_declarations do
                if let signature = _host_signature(host) then
                    imports.host(host.intrinsic_operation!, module.add_type(signature))
                fi
            od

            // Every other import is declared here, before the defined
            // functions are numbered.

            imports.freeze()

            let indices = MAP[Function, int]()

            for i in 0.._bodies.count do
                indices[_bodies[i].function] = imports.count + i
            od

            registry.finish(indices, _bodies.count)

            let names = NAME_MAP()

            for i in 0.._bodies.count do
                let (function, values) = _bodies[i]

                module.add_function(_build_function(module, registry, imports, function, values, indices))

                names.add(imports.count + i, function.qualified_name)
            od

            // The thunks vtable and trait-table entries call through follow
            // the bodies, in the order the registry numbered them.
            for thunk in registry.dispatch.thunks(indices) do
                module.add_function(thunk)
            od

            if let entry = _entry_point then
                let index mut = 0

                if indices.try_get_value(entry, index ref) then
                    WASMGC_ENTRY.add(module, entry, index, names)
                fi
            fi

            module.add_custom_section(
                CUSTOM_SECTION("name", NAME_SECTION().with_functions(names).bytes()))

            return module
        si

        // The struct types and globals for every class the program
        // declares. They take the first type indices, so they are built
        // before any function's signature is added.
        _build_registry(module: MODULE) -> WASMGC_TYPE_REGISTRY is
            let container = IoC.CONTAINER.instance

            let object = cast Classy?(container.innate_symbol_lookup.get_object_type().symbol)!

            let registry = WASMGC_TYPE_REGISTRY(module, object)

            registry.build(container.symbol_table.global_scope)

            for (location, construct) in registry.unsupported do
                _report(location, construct)
            od

            return registry
        si

        // The signature of a host import, or null where a part of it cannot
        // cross to the host. A string crosses as a JavaScript string.
        _host_signature(function: Function) -> FUNC_TYPE? is
            let parameters = LIST[VALUE_TYPE]()
            let results = LIST[VALUE_TYPE]()
            let is_valid mut = true

            for argument in function.arguments do
                if let type = _host_value_type(argument) then
                    parameters.add(type)
                else
                    _report(function.location, "a host argument of type {argument}")
                    is_valid = false
                fi
            od

            if !WASMGC_TYPES.is_void(function.return_type) then
                if let scalar = WASMGC_TYPES.scalar(function.return_type) then
                    results.add(WASMGC_TYPES.value_type(scalar))
                else
                    _report(function.location, "a host result of type {function.return_type}")
                    is_valid = false
                fi
            fi

            if !is_valid then
                return null
            fi

            return FUNC_TYPE(parameters.to_array(), results.to_array())
        si

        _host_value_type(type: Semantic.Types.Type) -> VALUE_TYPE? is
            if let scalar = WASMGC_TYPES.scalar(type) then
                return WASMGC_TYPES.value_type(scalar)
            elif WASMGC_TYPES.is_string(type) then
                return VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.EXTERN)
            fi

            return null
        si

        _build_function(
            module: MODULE,
            registry: WASMGC_TYPE_REGISTRY,
            imports: WASMGC_IMPORTS,
            function: Function,
            values: LIST[Value],
            indices: MAP[Function, int]
        ) -> FUNCTION is
            let parameters = LIST[VALUE_TYPE]()

            if function.is_emitted_with_receiver then
                if let receiver = _receiver_type(registry, function) then
                    parameters.add(receiver)
                else
                    _report(function.location, "an instance method of {function.owner}")
                    parameters.add(registry.object_reference)
                fi
            fi

            for argument in function.arguments do
                if let value_type = registry.value_type(argument) then
                    parameters.add(value_type)
                else
                    _report(function.location, "an argument of type {argument}")
                fi
            od

            let results = LIST[VALUE_TYPE]()

            if !WASMGC_TYPES.is_void(function.return_type) then
                if let value_type = registry.value_type(function.return_type) then
                    results.add(value_type)
                else
                    _report(function.location, "a result of type {function.return_type}")
                fi
            fi

            let lowering = WASMGC_LOWERING(indices, registry, imports, function, parameters)

            let body = lowering.lower(values)

            for construct in lowering.unsupported do
                _report(function.location, construct)
            od

            let type_index = module.add_type(FUNC_TYPE(parameters.to_array(), results.to_array()))

            return FUNCTION(type_index, lowering.local_types.to_array(), body)
        si

        // An instance method takes its receiver as its first parameter,
        // typed as the class that declares the method.
        _receiver_type(registry: WASMGC_TYPE_REGISTRY, function: Function) -> VALUE_TYPE? is
            if let owner: Classy = function.owner /\ registry.is_object_type(owner) then
                if let index = registry.type_index(owner) then
                    return VALUE_TYPE.of_type_index(index, true)
                fi
            elif let owner: Classy = function.owner /\ owner.is_trait then
                // A trait's default method runs on any implementing
                // instance, so it takes its receiver as the root.
                return registry.object_reference
            fi

            return null
        si
    si
si
