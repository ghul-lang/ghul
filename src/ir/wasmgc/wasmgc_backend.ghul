namespace IR.WasmGC is
    use IR.Program

    use IO.File

    use Wasm.MODULE
    use Wasm.FUNCTION
    use Wasm.FUNC_TYPE
    use Wasm.VALUE_TYPE
    use Wasm.EXPORT
    use Wasm.ExportKind
    use Wasm.NAME_MAP
    use Wasm.NAME_SECTION
    use Wasm.CUSTOM_SECTION
    use Wasm.BINARY_WRITER
    use Wasm.WAT_PRINTER
    use Wasm.ELEMENT_SEGMENT
    use Wasm.ElementMode
    use Wasm.INSTRUCTION

    use Collections.LIST
    use Collections.MAP
    use Collections.SET
    use Collections.STACK

    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use Values.Value

    /// Writes the program as a WebAssembly module using the GC proposal.
    ///
    /// Wasm numbers every function and type before a body can name one,
    /// so each body is kept as it is finished and lowered only once the
    /// last has been handed over, in `end_assembly`.
    class WASMGC_BACKEND: Backend is
        _bodies: LIST[(function: Function, values: LIST[Value])]
        _enclosing: STACK[LIST[Value]?]
        _current: LIST[Value]?

        _host_declarations: LIST[Function]

        // Whether the core library declares the identity hash, which the
        // host provides.
        _declares_identity_hash: bool

        // The state machine frames already reported, so a frame with several
        // members is reported once.
        _reported_frames: SET[Classy]

        // The methods generator frames have that no symbol of theirs
        // declares.
        _frame_members: LIST[(frame: Classy, method: Function)]

        _entry_point: Function?
        _module: MODULE?
        _wat_annotations: WASMGC_WAT_ANNOTATIONS?
        _want_library: bool

        init() is
            _bodies = LIST[(function: Function, values: LIST[Value])]()
            _host_declarations = LIST[Function]()
            _enclosing = STACK[LIST[Value]?]()
            _reported_frames = SET[Classy]()
            _frame_members = LIST[(frame: Classy, method: Function)]()
        si

        /// Keeps a function declared extern, whose import the module
        /// declares once however many functions name it.
        declare_extern(function: Function) is
            let name = function.extern_import?.name

            for declared in _host_declarations do
                if let import = declared.extern_import /\ import.name =~ name then
                    return
                fi
            od

            _host_declarations.add(function)
        si

        /// Starts a module, discarding anything kept from an earlier one.
        install(module_name: string, module_version: string, want_library: bool) is
            reset()

            _want_library = want_library
        si

        reset() is
            _bodies.clear()
            _host_declarations.clear()
            _declares_identity_hash = false
            _reported_frames.clear()
            _frame_members.clear()
            _enclosing.clear()
            _current = null
            _entry_point = null
            _module = null
        si

        begin_assembly() is si

        /// Numbers and lowers every kept body into the module `write` writes.
        end_assembly() is
            _module = _build_module()
        si

        /// The driver refuses resources before a wasm module is written.
        add_resource(name: string, content: ARRAY[ubyte]) is si

        /// Writes the module to `path`, and its text form where the build
        /// asks for one. An executable also gets its JavaScript loader,
        /// beside it with the extension `.mjs`.
        write(path: string) is
            let module = _module

            if !module? then
                return
            fi

            File.write_all_bytes(path, BINARY_WRITER().write(module))

            if !_want_library then
                WASMGC_LOADER.write(path, IoC.CONTAINER.instance.build_flags.wasm_loader)
            fi

            if let wat_path = IoC.CONTAINER.instance.build_flags.wat_output then
                File.write_all_text(wat_path, WAT_PRINTER().print(module, _wat_annotations))
            fi
        si

        begin_body() is
            _enclosing.push(_current)
            _current = LIST[Value]()
        si

        begin_body(member: Symbol) is
            begin_body()
        si

        write(value: Value) is
            _current!.add(value)
        si

        _is_array_member(function: Function) -> bool =>
            (function.intrinsic_operation?.starts_with("array.") ?? false) /\ function.is_instance

        /// Keeps the body for lowering. A function that provides an
        /// intrinsic has its body dropped, since a call to it lowers to the
        /// operation itself; one the host provides becomes an import. An
        /// array's members keep theirs, for a call that reaches one through
        /// a trait, and so does a constructor intrinsic, which is called as
        /// the ordinary method it is.
        finish_body(function: Function) is
            if function.intrinsic_operation =~ "object.identity_hash" then
                _declares_identity_hash = true
            fi

            if WASMGC_IMPORTS.is_host(function.intrinsic_operation) then
                _host_declarations.add(function)
                return
            elif function.intrinsic_operation? /\ !_is_array_member(function) /\ !function.intrinsic_operation.starts_with("constructor.") then
                return
            fi

            _bodies.add((function, _current!))
        si

        /// Keeps a generator's or an asynchronous function's frame member
        /// as a method of the frame. A member no trait the frame implements
        /// stands for is dropped: nothing on this target calls it. Any other
        /// frame is reported, at the function the frame was made for, since
        /// the frame itself has no source location.
        finish_frame_member_body(frame: Classy, member: FrameMember) is
            if let generator: Semantic.Symbols.STATE_MACHINE_FRAME = frame then
                if let method = FRAME_MEMBER_METHODS.method_for(generator, member) then
                    _frame_members.add((frame, method))
                    _bodies.add((method, _current!))
                fi

                return
            fi

            if let asynchronous: Semantic.Symbols.ASYNC_STATE_MACHINE_FRAME = frame then
                if let method = FRAME_MEMBER_METHODS.method_for(asynchronous, member) then
                    _frame_members.add((frame, method))
                    _bodies.add((method, _current!))

                    return
                fi
            fi

            if !_reported_frames.add(frame) then
                return
            fi

            let location =
                if let state_machine: Semantic.Symbols.STATE_MACHINE_FRAME_BASE = frame then
                    state_machine.owning_function.location
                else
                    frame.location
                fi

            _report(location, "a generator or asynchronous function")
        si

        /// Reports the initializer: this target generates no unions yet.
        finish_unit_variant_initializer(variant: Classy) is
            _report(variant.location, "a union")
        si

        end_body() is
            assert _enclosing.count > 0 else "body ended without one begun"

            _current = _enclosing.pop()
        si

        abandon_bodies() is
            _enclosing.clear()
            _current = null
        si

        /// Always false: this target generates no unions yet.
        has_unit_variant_instance(variant: Classy) -> bool => false

        /// The function the module starts at, run through the `_start` it
        /// exports.
        mark_entry_point(function: Function) is
            _entry_point = function
        si

        _report(location: Source.LOCATION, construct: string) is
            IoC.CONTAINER.instance.logger.error(
                location,
                "code generation for {construct} is not supported on the wasm target")
        si

        // Builds the types, declares the imports, numbers every kept
        // function after them, then lowers each body against those
        // numbers.
        _build_module() -> MODULE is
            let module = MODULE()

            let registry = _create_registry(module)

            // Discovery compiles bodies only for what they number, so it
            // declares the imports into a module that is thrown away: the
            // real module's recursion group has to come before any import's
            // signature. Both declare the same imports in the same order,
            // so the function indices agree.
            let message_getter = _exception_message_getter()
            let arguments_getter = _arguments_getter()

            let discovery_module = MODULE()
            let discovery_imports =
                _declare_imports(
                    discovery_module,
                    if registry.has_string_type then WASMGC_STRINGS(discovery_module, registry) else null fi,
                    message_getter?)

            let bodies = MAP[Function, LIST[Value]]()

            for (function, values) in _bodies do
                bodies[function] = values
            od

            let numbering = WASMGC_FUNCTION_NUMBERING(discovery_imports.count, f => bodies.contains_key(f))

            // An executable compiles what its entry point reaches; a library
            // compiles everything that is not generic, since anything can be
            // called from outside, and each instantiation that reaches.
            if let entry = _entry_point then
                numbering.index_of(entry)

                if let getter = message_getter then
                    numbering.index_of(getter)
                fi

                if let getter = arguments_getter then
                    numbering.index_of(getter)
                fi
            else
                for (function, _) in _bodies do
                    if !FUNCTION_BODIES.is_generic(function) then
                        numbering.index_of(function)
                    fi
                od
            fi

            let bodies_compiled = LIST[Function]()

            for (function, _) in _bodies do
                bodies_compiled.add(function)
            od

            let plan = PROGRAM_PLAN(registry.class_set, numbering.worklist, registry.dispatched, registry.display_plan, bodies_compiled)

            registry.dispatch.reach = instance => numbering.index_of(instance)

            registry.discovering = true

            plan.rtti = registry.rtti_plan

            plan.discover(
                WASMGC_DISCOVERY(
                    registry,
                    (instance: FUNCTION_INSTANCE) -> void => _lower(registry, discovery_imports, null, null, numbering, instance, LIST[VALUE_TYPE]()),
                    (location, construct) => _report(location, construct)))

            registry.discovering = false

            registry.build()

            for (location, construct) in registry.unsupported do
                _report(location, construct)
            od

            let strings = if registry.has_string_type then WASMGC_STRINGS(module, registry) else null fi
            let imports = _declare_imports(module, strings, message_getter?)
            let exceptions = WASMGC_EXCEPTIONS(module, registry)

            assert imports.count == discovery_imports.count else "discovery declared different imports"

            strings?.use_numbering(numbering)

            let names = NAME_MAP()

            let flags = IoC.CONTAINER.instance.build_flags

            if flags.wat_output? /\ (flags.want_wat_lines \/ flags.want_wat_program_only) then
                _wat_annotations = WASMGC_WAT_ANNOTATIONS(flags.want_wat_program_only)
            fi

            numbering.restart()

            while let instance = numbering.next() do
                let index = numbering.index_of(instance)!

                if let annotations = _wat_annotations /\ IR.PROGRAM_FUNCTIONS.contains(instance.definition) then
                    annotations.note_program_function(index)
                fi

                numbering.place(
                    instance,
                    _build_function(module, registry, imports, strings, exceptions, numbering, instance))

                names.add(index, instance.to_string())
            od

            numbering.seal()

            // The loader describes an exception nothing caught through this,
            // where the program can throw one.
            if let getter = message_getter /\ strings? /\ exceptions.declared_tag_index? then
                if let getter_index = numbering.index_of(getter) then
                    if let describe = exceptions.describe(strings, getter_index, build => numbering.reserve(build)) then
                        module.add_export(EXPORT("_describe_exception", ExportKind.FUNCTION, describe))
                    fi
                fi
            fi

            WASMGC_DISPLAY(registry).reserve(numbering, strings)
            WASMGC_CLONE(registry).reserve(numbering)
            WASMGC_RTTI(registry).reserve(numbering, strings)

            // The descriptors, vtables and trait table refer to what the
            // walk reached, and add the thunks their entries call through.
            registry.finish(numbering)

            strings?.finish()

            numbering.add_to(module)

            // A function value names its thunk with ref.func, which a
            // module has to declare in an element segment.
            let referenced = registry.closure_thunks

            if referenced.count > 0 then
                module.add_element_segment(
                    ELEMENT_SEGMENT.of_functions(ElementMode.DECLARATIVE, 0, LIST[INSTRUCTION](), referenced.to_array()))
            fi

            if let entry = _entry_point then
                // `_start` passes the entry point the core library's command-line
                // arguments, so where the core library declares none, an entry
                // point that takes them cannot be started.
                if entry.arguments.count > 0 /\ !arguments_getter? then
                    _report(entry.location, "an entry point that takes arguments")
                elif let index = numbering.index_of(entry) then
                    let arguments_index = if let getter = arguments_getter then numbering.index_of(getter) else null fi

                    WASMGC_ENTRY.add(module, entry, index, arguments_index, names)
                fi
            fi

            // The loader tells an exception the program threw from any
            // other error by this tag.
            if let tag = exceptions.declared_tag_index then
                module.add_export(EXPORT("_exception", ExportKind.TAG, tag))
            fi

            module.add_custom_section(
                CUSTOM_SECTION("name", NAME_SECTION().with_functions(names).bytes()))

            return module
        si

        _declare_imports(module: MODULE, strings: WASMGC_STRINGS?, describes_exceptions: bool) -> WASMGC_IMPORTS is
            let imports = WASMGC_IMPORTS(module)

            for host in _host_declarations do
                if let signature = _host_signature(host) then
                    if let import = host.extern_import then
                        imports.extern_function(import.name, module.add_type(signature))
                    else
                        imports.host(host.intrinsic_operation!, module.add_type(signature))
                    fi
                fi
            od

            if _declares_identity_hash then
                imports.host(
                    WASMGC_IMPORTS.IDENTITY_HASH,
                    module.add_type(
                        FUNC_TYPE(
                            [VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.ANY)],
                            [VALUE_TYPE.of_numeric(Wasm.NumericType.I32)])))
            fi

            // Built with debug information, a program that can describe an
            // exception throws through the host, so the exception records the
            // stack it was thrown from. Otherwise the module throws it, which
            // costs no crossing into the host and records no stack.
            if describes_exceptions /\ IoC.CONTAINER.instance.build_flags.want_debug then
                imports.host(
                    WASMGC_IMPORTS.THROW,
                    module.add_type(FUNC_TYPE([VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.ANY)], [])))
            fi

            // Every other import is declared here, before the defined
            // functions are numbered.

            if let present = strings /\ (_host_takes_a_string() \/ _host_answers_a_string() \/ describes_exceptions) then
                present.declare_imports(imports)
            fi

            imports.freeze()

            return imports
        si




        // The registry the classes are collected into. Their struct types
        // take the first type indices, so they are built before any
        // function's signature is added.
        _create_registry(module: MODULE) -> WASMGC_TYPE_REGISTRY is
            let container = IoC.CONTAINER.instance

            let object = cast Classy?(container.innate_symbol_lookup.get_object_type().symbol)!
            let string_type = cast Classy?(container.innate_symbol_lookup.get_string_type().symbol)

            let registry = WASMGC_TYPE_REGISTRY(module, object, string_type)

            registry.collect(container.symbol_table.global_scope)

            for (frame, method) in _frame_members do
                registry.add_method(frame, method)
            od

            // A boxed enum answers to_string with its member names.
            for (_, boxed) in registry.boxes do
                if let `enum: Semantic.Symbols.ENUM_STRUCT = boxed.symbol, (method, body) = ENUM_BOX_METHODS.to_string_for(`enum) then
                    registry.add_method(`enum, method)
                    _bodies.add((method, body))
                fi
            od

            return registry
        si

        // The signature of a host import, or null where a part of it cannot
        // cross to the host. A string crosses as a JavaScript string.
        _host_signature(function: Function) -> FUNC_TYPE? is
            let parameters = LIST[VALUE_TYPE]()
            let results = LIST[VALUE_TYPE]()
            let is_valid mut = true

            for argument in function.arguments do
                if let type = _host_value_type(argument) then
                    parameters.add(type)
                else
                    _report(function.location, "a host argument of type {argument}")
                    is_valid = false
                fi
            od

            // A constructor the host provides answers the value it builds.
            if function.is_constructor then
                if let owner: Semantic.Types.Typed = function.owner, owner_type = owner.type, type = _host_value_type(owner_type) then
                    results.add(type)
                else
                    _report(function.location, "a host constructor of {function.owner}")
                    is_valid = false
                fi
            elif !WASMGC_TYPES.is_void(function.return_type) then
                if let type = _host_value_type(function.return_type!) then
                    results.add(type)
                else
                    _report(function.location, "a host result of type {function.return_type}")
                    is_valid = false
                fi
            fi

            if !is_valid then
                return null
            fi

            return FUNC_TYPE(parameters.to_array(), results.to_array())
        si

        // The getter of the core library's command-line arguments, which
        // `_start` passes to an entry point that takes them; null where the
        // entry point takes none, or the core library declares none.
        _arguments_getter() -> Function? is
            if !_entry_point? \/ _entry_point.arguments.count == 0 then
                return null
            fi

            if let environment = CORE_LIBRARY.environment_class() then
                if let getter = CORE_LIBRARY.find_getter(environment, "arguments") then
                    for (function, _) in _bodies do
                        if function == getter then
                            return getter
                        fi
                    od
                fi
            fi

            return null
        si

        // The getter of the core library's exception message, which an
        // executable describes an exception nothing caught with; null in
        // a library, or where the core library declares no exception
        // message with a body.
        _exception_message_getter() -> Function? is
            if !_entry_point? then
                return null
            fi

            if let exception = CORE_LIBRARY.root_exception_class() then
                if let getter = CORE_LIBRARY.find_getter(exception, "message") then
                    for (function, _) in _bodies do
                        if function == getter then
                            return getter
                        fi
                    od
                fi
            fi

            return null
        si

        // Whether any host operation the program declares answers with a
        // string, which the strings have to convert from the host's.
        _host_answers_a_string() -> bool is
            for host in _host_declarations do
                if WASMGC_TYPES.is_string(host.return_type) then
                    return true
                fi
            od

            return false
        si

        // Whether any host operation the program declares takes a string,
        // which the strings have to convert for it.
        _host_takes_a_string() -> bool is
            for host in _host_declarations do
                for argument in host.arguments do
                    if WASMGC_TYPES.is_string(argument) then
                        return true
                    fi
                od
            od

            return false
        si

        _host_value_type(type: Semantic.Types.Type) -> VALUE_TYPE? is
            if let scalar = WASMGC_TYPES.scalar(type) then
                return WASMGC_TYPES.value_type(scalar)
            elif WASMGC_TYPES.is_string(type) then
                return VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.EXTERN)
            elif WASMGC_TYPES.is_bigint(type) then
                return VALUE_TYPE.of_abstract(Wasm.AbstractHeapType.EXTERN)
            fi

            return null
        si

        _build_function(
            module: MODULE,
            registry: WASMGC_TYPE_REGISTRY,
            imports: WASMGC_IMPORTS,
            strings: WASMGC_STRINGS?,
            exceptions: WASMGC_EXCEPTIONS?,
            numbering: WASMGC_FUNCTION_NUMBERING,
            function: FUNCTION_INSTANCE
        ) -> FUNCTION is
            let definition = function.definition
            let parameters = LIST[VALUE_TYPE]()

            if definition.is_emitted_with_receiver then
                if let receiver = registry.receiver_type(function) then
                    parameters.add(receiver)
                else
                    _report(definition.location, "an instance method of {definition.owner}")
                    parameters.add(registry.object_reference)
                fi
            fi

            for argument in definition.arguments do
                if let value_type = registry.value_type(function.specialize(argument)) then
                    parameters.add(value_type)
                else
                    _report(definition.location, "an argument of type {argument}")
                fi
            od

            let results = LIST[VALUE_TYPE]()
            let return_type = function.specialize(definition.return_type)

            if !WASMGC_TYPES.is_void(return_type) then
                if let value_type = registry.value_type(return_type) then
                    results.add(value_type)
                else
                    _report(definition.location, "a result of type {return_type}")
                fi
            fi

            let (body, locals) = _lower(registry, imports, strings, exceptions, numbering, function, parameters)

            let type_index = module.add_type(FUNC_TYPE(parameters.to_array(), results.to_array()))

            return FUNCTION(type_index, locals, body)
        si

        // Lowers the body of `function`, reporting whatever it uses that the
        // target cannot generate, except while the registry is discovering,
        // when the result is wanted only for what it numbers.
        _lower(
            registry: WASMGC_TYPE_REGISTRY,
            imports: WASMGC_IMPORTS,
            strings: WASMGC_STRINGS?,
            exceptions: WASMGC_EXCEPTIONS?,
            numbering: WASMGC_FUNCTION_NUMBERING,
            function: FUNCTION_INSTANCE,
            parameters: LIST[VALUE_TYPE]
        ) -> (body: Collections.List[Wasm.INSTRUCTION], locals: ARRAY[VALUE_TYPE]) is
            let definition = function.definition

            let parameter_types mut = parameters

            if registry.discovering then
                // Only how many there are matters to a lowering that is
                // discarded.
                parameter_types = LIST[VALUE_TYPE]()

                let count = definition.arguments.count + (if definition.is_emitted_with_receiver then 1 else 0 fi)

                for i in 0..count do
                    parameter_types.add(registry.object_reference)
                od
            fi

            let lowering = WASMGC_LOWERING(numbering, registry, imports, strings, exceptions, function, parameter_types)

            if !registry.discovering /\ IoC.CONTAINER.instance.build_flags.want_wat_lines then
                lowering.source_lines = _wat_annotations
            fi

            let body = lowering.lower(_body_of(definition))

            if let annotations = lowering.source_lines, index = numbering.indexed(function) then
                for (local, name) in lowering.local_names do
                    annotations.note_local_name(index, local, name)
                od
            fi

            if !registry.discovering then
                for construct in lowering.unsupported do
                    _report(IR.PROGRAM_FUNCTIONS.source_location(definition), construct)
                od
            fi

            return (body, lowering.local_types.to_array())
        si

        _body_of(definition: Function) -> LIST[Value] is
            for (function, values) in _bodies do
                if function == definition then
                    return values
                fi
            od

            return LIST[Value]()
        si
    si

    // Finds a program's reach by lowering each body it reaches through the
    // backend's own lowering, with the registry discovering, and keeping
    // nothing but what the lowering recorded.
    class WASMGC_DISCOVERY(
        registry: WASMGC_TYPE_REGISTRY private,
        lower: (FUNCTION_INSTANCE) -> void private,
        report: (Source.LOCATION, string) -> void private
    ): DiscoveryTarget is
        reach(instance: FUNCTION_INSTANCE) => _lower(instance)

        is_instantiated(type: CLASS_INSTANCE) -> bool => _registry.is_instantiated(type)

        // The cells and boxes the by-reference parameters of the slots and
        // selectors `type` takes a place in are held in have to exist
        // before any body reaching them is compiled.
        note_instantiated(type: CLASS_INSTANCE) is
            _registry.dispatch.discover_reference_parameters(type)
            _registry.dispatch.note_generic_implementor(type)
        si

        report(location: Source.LOCATION, construct: string) => _report(location, construct)
    si
si
