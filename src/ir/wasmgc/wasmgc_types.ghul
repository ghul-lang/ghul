namespace IR.WasmGC is
    use Wasm.VALUE_TYPE
    use Wasm.NumericType

    use Semantic.Types.Type

    /// How the built-in scalar kinds are held on the wasm target: every
    /// integer up to 32 bits in an i32, every wider one in an i64, and the
    /// two floating kinds in their own types.
    class WASMGC_TYPES is
        /// The wasm number type a value of the scalar kind is held in.
        numeric(scalar: Scalar) -> NumericType static =>
            case scalar
            when Scalar.INT64, Scalar.UINT64, Scalar.INT_NATIVE, Scalar.UINT_NATIVE then NumericType.I64
            when Scalar.FLOAT32 then NumericType.F32
            when Scalar.FLOAT64 then NumericType.F64
            else NumericType.I32
            esac

        /// The wasm value type a value of the scalar kind is held in.
        value_type(scalar: Scalar) -> VALUE_TYPE static =>
            VALUE_TYPE.of_numeric(numeric(scalar))

        /// The scalar kind a value of `type` is, or null where the type
        /// is not one of the built-in scalars. An enum is held as the `int`
        /// underneath it.
        scalar(type: Type?) -> Scalar? static =>
            if type? /\ isa Semantic.Symbols.ENUM_STRUCT(type.symbol) /\ !type.is_optional then
                Scalar.INT32
            else
                IoC.CONTAINER.instance.value_converter.scalar(type)
            fi

        /// The numeric type a value of `type` is held as: a scalar's own,
        /// and an enum's int; null for anything else.
        numeric_of(type: Type?) -> NumericType? static is
            if let kind = scalar(type) then
                return numeric(kind)
            elif is_enum(type) then
                return NumericType.I32
            fi

            return null
        si

        /// Whether `type` is an enum, which is held as its underlying int.
        is_enum(type: Type?) -> bool static =>
            type?.symbol?.symbol_kind =~ Semantic.Symbols.SymbolKind.ENUM

        /// Whether `type` is `string`.
        is_string(type: Type?) -> bool static =>
            type? /\ type.symbol == IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type().symbol

        /// Whether a value of `type` is nothing at all: absent, or void.
        is_void(type: Type?) -> bool static =>
            !type? \/ type.is_void

        /// Whether the kind is held in fewer bits than the wasm type
        /// carrying it, so a value of it has to be brought back into
        /// range wherever CIL would truncate it.
        is_narrow(scalar: Scalar) -> bool static =>
            case scalar
            when Scalar.BOOL, Scalar.CHAR, Scalar.INT8, Scalar.UINT8, Scalar.INT16, Scalar.UINT16 then true
            else false
            esac

        /// Whether the kind's top bit is part of its magnitude.
        is_unsigned(scalar: Scalar) -> bool static =>
            case scalar
            when Scalar.BOOL, Scalar.CHAR, Scalar.UINT8, Scalar.UINT16 then true
            when Scalar.UINT32, Scalar.UINT64, Scalar.UINT_NATIVE then true
            else false
            esac

        /// Whether the kind is one of the two floating kinds.
        is_float(scalar: Scalar) -> bool static =>
            scalar == Scalar.FLOAT32 \/ scalar == Scalar.FLOAT64
    si
si
