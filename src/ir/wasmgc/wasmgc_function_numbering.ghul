namespace IR.WasmGC is
    use Wasm.MODULE
    use Wasm.FUNCTION

    use Collections.LIST
    use Collections.MAP

    use Semantic.Symbols.Function

    /// The function indices of a module, given out as functions are found
    /// to be needed, so only what is reached is compiled.
    ///
    /// A function with a body is numbered the first time something asks
    /// for it, which also puts it on the list `next` drains. A function the
    /// target generates for itself is numbered by `reserve` and built when
    /// the module is assembled. Numbers are never taken back or changed:
    /// asking twice answers the same number, and `restart` walks the
    /// numbered functions again, in order, without numbering anything anew.
    class WASMGC_FUNCTION_NUMBERING is
        _first_index: int
        _has_body: (Function) -> bool

        _indices: MAP[WASMGC_FUNCTION, int]
        _numbered: LIST[WASMGC_FUNCTION?]
        _reserved: MAP[int, () -> FUNCTION]
        _placed: MAP[int, FUNCTION]

        _cursor: int

        _is_sealed: bool

        /// Numbers functions from `first_index` on.
        ///
        /// - first_index: the index the first function takes, after the
        ///   imports
        /// - has_body: whether a function has a body the module compiles
        init(first_index: int, has_body: (Function) -> bool) is
            _first_index = first_index
            _has_body = has_body

            _indices = MAP[WASMGC_FUNCTION, int]()
            _numbered = LIST[WASMGC_FUNCTION?]()
            _reserved = MAP[int, () -> FUNCTION]()
            _placed = MAP[int, FUNCTION]()
        si

        /// How many indices have been given out.
        count: int => _numbered.count

        /// The index of `function`, numbering it the first time it is asked
        /// for, or null where it has no body to compile.
        index_of(function: Function) -> int? => index_of(WASMGC_FUNCTION.of(function))

        /// The index of `instance`, numbering it the first time it is asked
        /// for, or null where its definition has no body to compile.
        index_of(instance: WASMGC_FUNCTION) -> int? is
            let index mut = 0

            if _indices.try_get_value(instance, index ref) then
                return index
            fi

            if !_has_body(instance.definition) then
                return null
            fi

            // A function that calls itself at deeper and deeper type
            // arguments would be numbered without end. Past the depth the
            // class bound uses, it is not numbered, and the call is reported.
            if WASMGC_TYPE_MAPS.depth(instance.type_map.values) > WASMGC_BACKEND.MAXIMUM_TYPE_ARGUMENT_DEPTH then
                return null
            fi

            assert !_is_sealed else "{instance} was first asked for after every body was compiled, so it never would be"

            index = _first_index + _numbered.count

            _indices[instance] = index
            _numbered.add(instance)

            return index
        si

        /// The index `instance` already has, or null where nothing has
        /// asked for it. Unlike `index_of`, this numbers nothing.
        indexed(instance: WASMGC_FUNCTION) -> int? is
            let index mut = 0

            if _indices.try_get_value(instance, index ref) then
                return index
            fi

            return null
        si

        /// The index `function`, taking no type arguments, already has.
        indexed(function: Function) -> int? => indexed(WASMGC_FUNCTION.of(function))

        /// Numbers a function the target generates, which `build` makes when
        /// the module is assembled.
        reserve(build: () -> FUNCTION) -> int is
            let index = _first_index + _numbered.count

            _numbered.add(null)
            _reserved[index] = build

            return index
        si

        /// The next numbered function not yet handed out, or null when every
        /// one has been.
        next() -> WASMGC_FUNCTION? is
            while _cursor < _numbered.count do
                let instance = _numbered[_cursor]

                _cursor = _cursor + 1

                if instance? then
                    return instance
                fi
            od

            return null
        si

        /// Records that every body has been compiled. A function with a body
        /// that is first asked for after this would never be compiled, which
        /// `index_of` then asserts against.
        seal() is
            _is_sealed = true
        si

        /// Hands out the numbered functions again from the first, in index
        /// order, keeping every number.
        restart() is
            _cursor = 0
        si

        /// Records the compiled body of `instance`.
        place(instance: WASMGC_FUNCTION, function: FUNCTION) is
            let index = indexed(instance)

            assert index? else "{instance} was compiled without having been numbered"

            _placed[index] = function
        si

        /// Adds every numbered function to `module` in index order,
        /// building the generated ones. Every function with a body must
        /// have been placed.
        add_to(module: MODULE) is
            let i mut = 0

            while i < _numbered.count do
                let index = _first_index + i

                let build: () -> FUNCTION mut

                let function =
                    if _reserved.try_get_value(index, build ref) then
                        build()
                    else
                        let placed: FUNCTION mut

                        assert _placed.try_get_value(index, placed ref) else "function {index}, {_numbered[i]}, was numbered but never compiled"

                        placed
                    fi

                let added = module.add_function(function)

                assert added == index else "function {index} added at {added}"

                i = i + 1
            od
        si
    si
si
