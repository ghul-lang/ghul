namespace IR is
    use System.Reflection.Metadata.ILOpCode

    use Semantic.Symbols.INNATE_OPERATOR_WRAPPER

    // Deposits the body of every built-in operator stand-in the
    // numbering pass planned: the arguments, in order, through the
    // operator's own lowering, and the result returned. No tree walk
    // reaches these, since no source declares them.
    class INNATE_OPERATOR_WRAPPER_BODIES is
        gen(context: CONTEXT) static is
            for planned in context.srm_assembly_emitter.handles.emission_plan.types do
                for method in planned.methods do
                    if let wrapper: INNATE_OPERATOR_WRAPPER = method then
                        _gen(context, wrapper)
                    fi
                od
            od
        si

        _gen(context: CONTEXT, wrapper: INNATE_OPERATOR_WRAPPER) static is
            let assembly_emitter = context.srm_assembly_emitter
            let enclosing = context.current_srm_body_emitter
            let body = IR.Emitter.SRM_METHOD_BODY_EMITTER()

            context.current_srm_body_emitter = body

            try
                let names = wrapper.argument_names
                let operands = Collections.LIST[Values.Value]()

                for i in 0..wrapper.arguments.count do
                    operands.add(Values.Load.ARGUMENT_SLOT(i, names[i], wrapper.arguments[i]))
                od

                Values.Call.INNATE(wrapper.operator, null, operands, wrapper.return_type).gen(context)

                body.op(ILOpCode.RET)

                assembly_emitter.handles.set_body_offset(wrapper, body.flush(assembly_emitter))
            finally
                context.current_srm_body_emitter = enclosing
            yrt
        si
    si
si
