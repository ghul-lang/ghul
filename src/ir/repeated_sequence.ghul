namespace IR is
    use Semantic.Types.Type

    use Values

    // The sequence `Ghul.Pipes.repeat` makes, counted by a loop: the value,
    // evaluated once, taken as every element, for `count` elements, or for
    // ever where there is no count. A count of zero or less produces none.
    class REPEATED_SEQUENCE: LoopSequence is
        /// The local holding the value.
        current: LOCAL public

        /// How many elements are left, or 1 without end where there is no count.
        more: LOCAL public

        _value: Value
        _count: Value?
        _int_type: Type

        /// The sequence of `value`, repeated `count` times, or for ever where `count` is null.
        init(value: Value, count: Value?, element_type: Type, int_type: Type, id: int) is
            _value = value
            _count = count
            _int_type = int_type

            current = LOCAL(".fc_repeat.{id}", element_type)
            more = LOCAL(".fc_remaining.{id}", int_type)
        si

        setup() -> Collections.LIST[Value] is
            let values = Collections.LIST[Value]()

            values.add(DECLARE_LOCAL(current))
            values.add(_value)
            values.add(STORE_TEMP(current))

            values.add(DECLARE_LOCAL(more))

            if let count = _count then
                values.add(INT_MAX_ZERO(count, _int_type))
            else
                values.add(Literal.NUMBER(1, _int_type))
            fi

            values.add(STORE_TEMP(more))

            return values
        si

        advance(expansion: EXPANSION, previous: LOCAL) is
            if _count? then
                expansion.store(
                    more,
                    ARITHMETIC(
                        ArithmeticOperation.SUBTRACT,
                        more.load(),
                        Literal.NUMBER(1, _int_type),
                        _int_type).unmarked())
            fi
        si
    si
si
