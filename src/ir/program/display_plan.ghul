namespace IR.Program is
    use Collections.LIST
    use Collections.MAP

    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use IR.Emitter.SRM_MEMBER_ORDER
    use IR.Emitter.SRM_EMITTED_TYPE

    /// What a display plan needs to know about the program's classes from
    /// the target that compiles them.
    trait DisplayTarget open is
        /// The class a value of `type` is an instance of, or null where the
        /// program has none.
        class_of(type: Type?) -> CLASS_INSTANCE?

        /// The trait instance a value of `type` is, or null where `type` is
        /// not a trait.
        trait_of(type: Type) -> CLASS_INSTANCE?

        /// The class `type` extends, or null where that is the root.
        superclass_of(type: CLASS_INSTANCE) -> CLASS_INSTANCE?

        /// The element type of the array type `type`.
        array_element(type: CLASS_INSTANCE) -> Type

        /// The core library's display state class, where the program
        /// renders values for display.
        display_state: CLASS_INSTANCE?

        /// Whether `type` is a class with a representation of its own.
        is_object_type(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is a scalar's box.
        is_box(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is an array type.
        is_array(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is the string type.
        is_string(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is a struct.
        is_struct(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is the built-in `bigint`.
        is_bigint(type: CLASS_INSTANCE) -> bool
    si

    /// Which types get a displayer, and what each displayer calls: for
    /// each type with no text of its own, a function that writes a value
    /// of it for display through the core library's display state. A
    /// sequence is written as its elements, a tuple as its parts, and
    /// anything else as its type and public properties.
    class DISPLAY_PLAN is
        _target: DisplayTarget
        _core: CoreClasses

        /// A plan for the classes `target` compiles.
        init(target: DisplayTarget, core: CoreClasses) is
            _target = target
            _core = core
        si

        /// The display state's methods a displayer calls, or null where the
        /// program renders nothing for display, or the state lacks any of
        /// them.
        helpers: DISPLAY_HELPERS? =>
            if let state = _target.display_state then DISPLAY_HELPERS.of(state) else null fi

        /// What the displayer of `type` calls, in the order it calls them,
        /// and nothing where `type` has no displayer.
        calls(type: CLASS_INSTANCE, helpers: DISPLAY_HELPERS) -> FUNCTION_INSTANCE[] is
            let result = LIST[FUNCTION_INSTANCE]()

            if let element = element_type(type) then
                result.add(helpers.elements(element))
            elif is_tuple(type) then
                result.add(helpers.begin_parts)

                for part in type.arguments do
                    result.add(helpers.part(part))
                od

                result.add(helpers.end_parts)
            elif _shows_members(type) then
                result.add(helpers.begin_members)

                for member in members(type) do
                    if let getter = member.getter then
                        result.add(getter)
                    fi

                    result.add(helpers.member(member.type))
                od

                result.add(helpers.end_members)
            fi

            return result
        si

        /// The element type of `type` where a value of it is a sequence,
        /// displayed as its elements: an array, or a class with no
        /// `to_string` of its own that implements `Iterable`.
        element_type(type: CLASS_INSTANCE) -> Type? is
            if _target.is_array(type) then
                return _target.array_element(type)
            fi

            if !_target.is_object_type(type) \/ _target.is_box(type) \/ !_has_no_text_of_its_own(type) then
                return null
            fi

            if let iterable = _core.iterable_definition then
                return _iterable_element(type.definition, type.type_map, iterable)
            fi

            return null
        si

        _iterable_element(from: Classy, map: Collections.Map[Symbol, Type], iterable: Symbol) -> Type? is
            for ancestor in from.ancestors do
                let specialized = TYPE_MAPS.specialize(ancestor, map)!

                if let ancestor_class = _target.trait_of(specialized) ?? _target.class_of(specialized) then
                    if ancestor_class.definition == iterable /\ ancestor_class.arguments.count == 1 then
                        return ancestor_class.arguments[0]
                    fi

                    if let element = _iterable_element(ancestor_class.definition, ancestor_class.type_map, iterable) then
                        return element
                    fi
                fi
            od

            return null
        si

        /// Whether `type` is a tuple: a struct the compiler constructs, whose
        /// type arguments are its elements' types. bigint is constructed
        /// too, but answers with its own `to_string`, so is not one.
        is_tuple(type: CLASS_INSTANCE) -> bool =>
            _target.is_struct(type) /\ type.definition.location == Source.LOCATION.internal /\ !_target.is_bigint(type)

        // Whether a value of `type` is displayed as its type and members:
        // a class or struct of the program's own, with no `to_string` of
        // its own or inherited from anything but the root.
        _shows_members(type: CLASS_INSTANCE) -> bool is
            let definition = type.definition

            if !_target.is_object_type(type) \/ _target.is_box(type) \/ _target.is_array(type) \/
                _target.is_string(type) \/ definition.is_trait \/ definition.is_object \/
                definition == _target.display_state?.definition
            then
                return false
            fi

            return _has_no_text_of_its_own(type)
        si

        // Whether neither `type` nor any ancestor but the root declares
        // `to_string`.
        _has_no_text_of_its_own(type: CLASS_INSTANCE) -> bool is
            let current: CLASS_INSTANCE? mut = type

            while current? /\ !current.definition.is_object do
                for method in SRM_MEMBER_ORDER.methods(SRM_EMITTED_TYPE(current.definition)) do
                    if method.name =~ "to_string" /\ method.is_instance /\ method.arguments.count == 0 then
                        return false
                    fi
                od

                current = _target.superclass_of(current)
            od

            return true
        si

        /// The public instance properties of `type` and of its ancestors,
        /// each with the getter that reads it at the class's type arguments,
        /// and then their public instance fields, as .NET lists them.
        members(type: CLASS_INSTANCE) -> (name: string, getter: FUNCTION_INSTANCE?, `field: Symbol?, type: Type)[] is
            let result = LIST[(name: string, getter: FUNCTION_INSTANCE?, `field: Symbol?, type: Type)]()

            let current: CLASS_INSTANCE? mut = type

            while current? /\ !current.definition.is_object do
                for property in SRM_MEMBER_ORDER.properties(SRM_EMITTED_TYPE(current.definition)) do
                    if let getter = property.read_function /\ property.is_instance /\ _is_shown(property.name) then
                        if let member_type = current.specialize(property.type) then
                            result.add((name = property.name, getter = FUNCTION_INSTANCE(getter, current.type_map), `field = null, type = member_type))
                        fi
                    fi
                od

                current = _target.superclass_of(current)
            od

            current = type

            while current? /\ !current.definition.is_object do
                for `field in SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(current.definition)) do
                    if `field.is_instance /\ _is_shown(`field.name) then
                        if let member_type = current.specialize(`field.type) then
                            result.add((name = `field.name, getter = null, `field = `field, type = member_type))
                        fi
                    fi
                od

                current = _target.superclass_of(current)
            od

            return result
        si

        // A member a program names: public, and not one the compiler made
        // up, which carries a `$`.
        _is_shown(name: string) -> bool =>
            name.length > 0 /\ !name.starts_with('_') /\ !name.contains('$')

        /// The type as a program names it: a variant after its union's
        /// name, and the type arguments after a generic's.
        display_name(type: CLASS_INSTANCE) -> string is
            let name mut = type.definition.name

            if type.definition.is_variant then
                if let owner = _target.superclass_of(type) then
                    name = "{owner.definition.name}.{name}"
                fi
            fi

            if type.arguments.count > 0 then
                name = "{name}[{type.arguments |> Ghul.Pipes.map(a => a.short_description) |> Ghul.Pipes.join(", ")}]"
            fi

            return name
        si
    si

    /// The display state's methods a displayer calls, each at the type
    /// arguments a call gives it.
    class DISPLAY_HELPERS is
        state: CLASS_INSTANCE
        begin_members: FUNCTION_INSTANCE
        end_members: FUNCTION_INSTANCE
        begin_parts: FUNCTION_INSTANCE
        end_parts: FUNCTION_INSTANCE

        _member: Function
        _part: Function
        _elements: Function

        init(
            state: CLASS_INSTANCE,
            begin_members: Function,
            member: Function,
            end_members: Function,
            begin_parts: Function,
            part: Function,
            end_parts: Function,
            elements: Function
        ) is
            self.state = state
            self.begin_members = FUNCTION_INSTANCE(begin_members, state.type_map)
            self.end_members = FUNCTION_INSTANCE(end_members, state.type_map)
            self.begin_parts = FUNCTION_INSTANCE(begin_parts, state.type_map)
            self.end_parts = FUNCTION_INSTANCE(end_parts, state.type_map)

            _member = member
            _part = part
            _elements = elements
        si

        /// The helpers `state` declares, or null where it lacks any of
        /// them.
        of(state: CLASS_INSTANCE) -> DISPLAY_HELPERS? static is
            let methods = SRM_MEMBER_ORDER.methods(SRM_EMITTED_TYPE(state.definition))

            let begin_members = _named(methods, "_begin_members")
            let member = _named(methods, "_member")
            let end_members = _named(methods, "_end_members")
            let begin_parts = _named(methods, "_begin_parts")
            let part = _named(methods, "_part")
            let end_parts = _named(methods, "_end_parts")
            let elements = _named(methods, "_elements")

            if begin_members? /\ member? /\ end_members? /\ begin_parts? /\ part? /\ end_parts? /\ elements? then
                return DISPLAY_HELPERS(state, begin_members, member, end_members, begin_parts, part, end_parts, elements)
            fi

            return null
        si

        /// The state's member method, at a member's type.
        member(type: Type) -> FUNCTION_INSTANCE => _at(_member, type)

        /// The state's part method, at a tuple element's type.
        part(type: Type) -> FUNCTION_INSTANCE => _at(_part, type)

        /// The state's elements method, at a sequence's element type.
        elements(type: Type) -> FUNCTION_INSTANCE => _at(_elements, type)

        _at(method: Function, type: Type) -> FUNCTION_INSTANCE is
            let map = MAP[Symbol, Type]()

            map[method.generic_arguments[0].symbol] = type

            return FUNCTION_INSTANCE(method, map)
        si

        _named(methods: Collections.Iterable[Function], name: string) -> Function? static is
            for method in methods do
                if method.name =~ name then
                    return method
                fi
            od

            return null
        si
    si
si
