namespace IR.Program is
    use Collections.LIST

    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function
    use Semantic.Symbols.ENUM_STRUCT
    use Semantic.Types.Type
    use IR.Values.Value

    use Source.LOCATION

    /// The methods an enum's box has on a whole-program target. An enum
    /// value is held as its integer, so a box holding one would otherwise
    /// answer as the integer does; these make it answer as the enum.
    class ENUM_BOX_METHODS is
        /// The `to_string` of `enum`, with the body that gives a value's
        /// member names as .NET does, or null where the core library cannot
        /// name the enum's values. The method overrides the root's, so a
        /// boxed value reached through `object` reads as its members.
        ///
        /// - enum: the enum the box holds a value of
        to_string_for(`enum: ENUM_STRUCT) -> (method: Function, body: LIST[Value])? static is
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup
            let enum_type = Semantic.Types.NAMED(`enum)

            let text = INTERPOLATION_CALLS.enum_text(Values.Load.VALUE_SELF(`enum, enum_type), enum_type)

            if !text? then
                return null
            fi

            let object = cast Classy?(lookup.get_object_type().symbol)
            let overridee = if let o = object then _member(o, "to_string") else null fi

            if !overridee? then
                return null
            fi

            let method = Semantic.Symbols.INSTANCE_METHOD(LOCATION.internal, LOCATION.internal, `enum, "to_string", `enum)

            method.set_arguments(LIST[string](), LIST[Type]())
            method.set_return_type(lookup.get_string_type())
            method.add_overridee(overridee)

            return (method, LIST[Value]([text, Values.RET()]))
        si

        // The method of `owner` named `name` that takes no arguments.
        _member(owner: Classy, name: string) -> Function? static =>
            Semantic.KNOWN_MEMBERS.declared(owner, name, Semantic.KNOWN_SIGNATURE(LIST[Semantic.Types.Type?](), true))
    si
si
