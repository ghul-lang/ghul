namespace IR.Program is
    use Text.StringBuilder

    use Semantic.Types.Type

    /// The names a whole-program target gives its types' descriptors,
    /// as ghūl source writes them, so `get_type()` reports `int`,
    /// `ARRAY[string]` or `Box[int]` rather than .NET's names.
    class TYPE_NAMES is
        /// The name of `type`.
        ///
        /// - type: a class, array or box in `classes`
        /// - classes: the program's classes
        /// - string_type: the string type, or null where the program has none
        /// - scalar: the scalar kind a value of a type is, or null where it is not one
        /// - is_string: whether a type is `string`
        name_of(
            type: CLASS_INSTANCE,
            classes: CLASS_SET,
            string_type: CLASS_INSTANCE?,
            scalar: (Type?) -> Scalar?,
            is_string: (Type?) -> bool
        ) -> string static is
            let name_of_argument = (argument: Type) => name_of(argument, classes, string_type, scalar, is_string)

            if let boxed = classes.boxed_type(type) then
                return name_of_argument(boxed)
            elif type == string_type then
                return "string"
            elif type == classes.root then
                return "object"
            elif classes.is_array(type) then
                return "ARRAY[{name_of_argument(classes.array_element(type))}]"
            elif _is_tuple(type) then
                return "({type.arguments |> Ghul.Pipes.map(name_of_argument) |> Ghul.Pipes.join(", ")})"
            elif type.arguments.count == 0 then
                return _source_name(type.definition)
            fi

            return "{_source_name(type.definition)}[{type.arguments |> Ghul.Pipes.map(name_of_argument) |> Ghul.Pipes.join(", ")}]"
        si

        // Whether `type` is one of the tuple classes a tuple type of its
        // arity is held as.
        _is_tuple(type: CLASS_INSTANCE) -> bool static =>
            type.arguments.count > 1 /\
            (
                if let tuple: Semantic.Symbols.GENERIC = IoC.CONTAINER.instance.innate_symbol_lookup.get_tuple_type(type.arguments, null).symbol then
                    cast Semantic.Symbols.Classy?(tuple.unspecialized_symbol) == type.definition
                else
                    false
                fi
            )

        // A built-in type declared in Ghul.Intrinsics, such as bigint or
        // complex, is named bare, as source writes it. Every other type is
        // named by its qualified name, which leaves out a top-level file's
        // own namespace and carries no arity suffix.
        _source_name(definition: Semantic.Symbols.Classy) -> string static =>
            if definition.owner? /\ definition.owner == IoC.CONTAINER.instance.innate_symbol_lookup.get_bigint_type().symbol?.owner then
                definition.name
            else
                definition.qualified_name
            fi

        /// The name of `type`, any type a descriptor names.
        name_of(
            type: Type,
            classes: CLASS_SET,
            string_type: CLASS_INSTANCE?,
            scalar: (Type?) -> Scalar?,
            is_string: (Type?) -> bool
        ) -> string static is
            // An enum is held as its integer, but is named as itself.
            if let `enum: Semantic.Symbols.ENUM_STRUCT = type.symbol then
                return _source_name(`enum)
            fi

            if let kind = scalar(type) then
                return scalar_name(kind)
            elif is_string(type) then
                return "string"
            elif let held = classes.class_of(type) then
                return name_of(held, classes, string_type, scalar, is_string)
            fi

            return "{type}"
        si

        /// The ghūl name of the scalar kind. byte is the signed 8-bit
        /// kind and ubyte the unsigned one, the opposite of .NET.
        scalar_name(scalar: Scalar) -> string static =>
            case scalar
            when Scalar.BOOL then "bool"
            when Scalar.CHAR then "char"
            when Scalar.INT8 then "byte"
            when Scalar.UINT8 then "ubyte"
            when Scalar.INT16 then "short"
            when Scalar.UINT16 then "ushort"
            when Scalar.INT32 then "int"
            when Scalar.UINT32 then "uint"
            when Scalar.INT64 then "long"
            when Scalar.UINT64 then "ulong"
            when Scalar.INT_NATIVE then "word"
            when Scalar.UINT_NATIVE then "uword"
            when Scalar.FLOAT32 then "single"
            when Scalar.FLOAT64 then "double"
            esac
    si
si
