namespace IR.Program is
    use Collections.LIST
    use Collections.MAP

    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function
    use Semantic.Symbols.GENERIC

    /// A class as a whole-program target compiles it: a declared class at one
    /// choice of its type arguments. Every instantiation a program uses is
    /// compiled separately, and a class that is not generic has one, with no
    /// arguments.
    ///
    /// - definition: the declared class
    /// - arguments: its type arguments, in declaration order
    /// - type_map: each of the definition's type parameters, to its argument
    class CLASS_INSTANCE(definition: Classy, arguments: Type[], type_map: Collections.Map[Symbol, Type]) is
        /// The class with no type arguments.
        of(definition: Classy) -> CLASS_INSTANCE static =>
            CLASS_INSTANCE(definition, LIST[Type](), MAP[Symbol, Type]())

        /// `type`, with the class's type parameters replaced by its
        /// arguments.
        specialize(type: Type?) -> Type? => TYPE_MAPS.specialize(type, type_map)

        =~(other: CLASS_INSTANCE) -> bool pure =>
            definition == other.definition /\ TYPE_MAPS.same(type_map, other.type_map)

        get_hash_code() -> int pure => definition.get_hash_code() * 31 + TYPE_MAPS.hash(type_map)

        to_string() -> string =>
            if arguments.count == 0 then "{definition}" else "{definition}[{arguments |> Ghul.Pipes.join(",")}]" fi
    si

    /// A function as a whole-program target compiles it: a declared function at
    /// one choice of the type arguments its body can name, its class's and
    /// its own.
    ///
    /// - definition: the declared function, whose body is the one compiled
    /// - type_map: each type parameter the body can name, to its argument
    class FUNCTION_INSTANCE(definition: Function, type_map: Collections.Map[Symbol, Type]) is
        /// The function with no type arguments.
        of(definition: Function) -> FUNCTION_INSTANCE static =>
            FUNCTION_INSTANCE(definition, MAP[Symbol, Type]())

        /// `type`, with the type parameters the body can name replaced by
        /// their arguments.
        specialize(type: Type?) -> Type? => TYPE_MAPS.specialize(type, type_map)

        =~(other: FUNCTION_INSTANCE) -> bool pure =>
            definition == other.definition /\ TYPE_MAPS.same(type_map, other.type_map)

        get_hash_code() -> int pure => definition.get_hash_code() * 31 + TYPE_MAPS.hash(type_map)

        to_string() -> string =>
            if type_map.count == 0 then "{definition.qualified_name}" else "{definition.qualified_name}[{type_map.values |> Ghul.Pipes.join(",")}]" fi
    si
si
