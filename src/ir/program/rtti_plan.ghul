namespace IR.Program is
    use Collections.LIST
    use Collections.MAP

    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    use IR.Emitter.SRM_MEMBER_ORDER
    use IR.Emitter.SRM_EMITTED_TYPE

    /// One call a type's description makes on the core library's
    /// description builder: the builder method, at the type arguments the
    /// call gives it, and what else the call passes.
    union RTTI_CALL(method: FUNCTION_INSTANCE) is
        /// Records the type's kind, as flags.
        KIND(flags: int, ..)

        /// Records a type: the base type, a type argument, an array's
        /// element type, or what an optional holds. The method's own type
        /// argument is the type recorded.
        TYPE(..)

        /// Records a field the type declares, read and written through the
        /// functions the target makes for it.
        FIELD(name: string, `field: Symbol, is_public: bool, ..)

        /// Records a property the type declares, read and assigned through
        /// its own accessors, either of which can be absent.
        PROPERTY(
            name: string,
            read: FUNCTION_INSTANCE?,
            read_is_public: bool,
            assign: FUNCTION_INSTANCE?,
            assign_is_public: bool,
            ..)

        /// Records a member of an enum: its name and its value. The method's
        /// own type argument is the enum.
        ENUM_MEMBER(name: string, value: long, ..)

        /// Records an attribute the type carries, made by `constructor` of
        /// `type`: with no arguments, or with one, an array of the types the
        /// TYPE calls since the last attribute recorded.
        ATTRIBUTE(type: CLASS_INSTANCE, constructor: FUNCTION_INSTANCE, ..)

        /// Records a parameter of the constructor the next CONSTRUCTOR call
        /// records. The method's own type argument is the parameter's type.
        PARAMETER(name: string, ..)

        /// Records a constructor the type declares, after a PARAMETER call
        /// for each of its parameters.
        CONSTRUCTOR(constructor: FUNCTION_INSTANCE, is_public: bool, ..)
    si

    /// What a description of each type calls, where the program describes
    /// its types for reflection: the core library's description builder's
    /// methods, each at the type it records, with the names, accessors and
    /// constructor they are passed.
    ///
    /// A description says what the type is and nothing about what it is
    /// for: its kind, base type, type arguments, own fields and properties
    /// under the names it declares them by, and its constructor.
    class RTTI_PLAN is
        _target: DisplayTarget
        _description: CLASS_INSTANCE
        _descriptor_only: () -> Collections.Iterable[CLASS_INSTANCE]
        _methods: MAP[string, Function]

        /// A plan describing the classes `target` compiles through the
        /// builder class `description`.
        ///
        /// - target: the target that compiles the classes
        /// - description: the core library's description builder
        /// - descriptor_only: the types the target describes that no value is
        ///   an instance of
        init(target: DisplayTarget, description: CLASS_INSTANCE, descriptor_only: () -> Collections.Iterable[CLASS_INSTANCE]) is
            _target = target
            _description = description
            _descriptor_only = descriptor_only
            _methods = MAP[string, Function]()

            for method in SRM_MEMBER_ORDER.methods(SRM_EMITTED_TYPE(description.definition)) do
                if method.is_instance then
                    _methods[method.name] = method
                fi
            od
        si

        /// Every type described: `classes`, and the types the target
        /// describes that no value is an instance of.
        ///
        /// - classes: the classes and array types the program uses
        described(classes: Collections.Iterable[CLASS_INSTANCE]) -> CLASS_INSTANCE[] is
            let result = LIST[CLASS_INSTANCE](classes)

            result.add_range(_descriptor_only())

            return result
        si

        /// The builder method recording a type's kind, or null where the
        /// builder has none.
        kind_method: FUNCTION_INSTANCE? =>
            if let kind = _method("_kind") then FUNCTION_INSTANCE.of(kind) else null fi

        /// The description builder class.
        description: CLASS_INSTANCE => _description

        /// The class of the description builder a type object's
        /// two-argument constructor takes, or null where the core library's
        /// type object has no such constructor.
        ///
        /// - class_of: finds the class a type is
        description_class(class_of: (Type) -> CLASS_INSTANCE?) -> CLASS_INSTANCE? static is
            if let constructor = CORE_LIBRARY.constructor(CORE_LIBRARY.type_class(), 2) then
                let describe = constructor.arguments[1]

                if describe.arguments.count > 0 then
                    return class_of(describe.arguments[0])
                fi
            fi

            return null
        si

        /// What the description of `type` calls, in order.
        ///
        /// - type: the type described
        calls(type: CLASS_INSTANCE) -> RTTI_CALL[] is
            let result = LIST[RTTI_CALL]()

            // A closure's or a state machine's frame is the compiler's own,
            // named by no program, so nothing describes it.
            if isa Semantic.Symbols.FRAME(type.definition) \/ isa Semantic.Symbols.STATE_MACHINE_FRAME_BASE(type.definition) then
                return result
            fi

            if let kind = _method("_kind") then
                result.add(RTTI_CALL.KIND(_kind(type), FUNCTION_INSTANCE.of(kind)))
            fi

            if type.definition.is_trait then
                return result
            fi

            if _is_nullable(type.definition) then
                _add_type(result, "_argument", type.arguments[0])
                _add_type(result, "_nullable_of", type.arguments[0])

                return result
            fi

            if IoC.CONTAINER.instance.innate_symbol_lookup.is_maybe_definition(type.definition) /\ type.arguments.count == 1 then
                _add_type(result, "_maybe_of", type.arguments[0])
            fi

            if _target.is_array(type) then
                _add_type(result, "_element", _target.array_element(type))

                return result
            fi

            if !type.definition.is_object /\ !_target.is_box(type) /\ !_target.is_struct(type) then
                _add_type(result, "_base", _superclass_type(type))
            fi

            if _target.is_box(type) /\ type.definition.symbol_kind == Semantic.Symbols.SymbolKind.ENUM then
                _add_enum_members(result, type)
            fi

            if !_target.is_box(type) /\ !_target.is_string(type) then
                for argument in type.arguments do
                    _add_type(result, "_argument", argument)
                od

                _add_fields(result, type)
                _add_properties(result, type)
                _add_constructors(result, type)
                _add_markers(result, type)
            fi

            return result
        si

        /// Every function the description of `type` calls, directly or as a
        /// value: the builder's methods, the accessors and the constructor.
        ///
        /// - type: the type described
        reached(type: CLASS_INSTANCE) -> FUNCTION_INSTANCE[] is
            let result = LIST[FUNCTION_INSTANCE]()

            for call in calls(type) do
                result.add(call.method)

                if let property: RTTI_CALL.PROPERTY = call then
                    if let read = property.read then
                        result.add(read)
                    fi

                    if let assign = property.assign then
                        result.add(assign)
                    fi
                elif let constructor: RTTI_CALL.CONSTRUCTOR = call then
                    result.add(constructor.constructor)
                elif let attribute: RTTI_CALL.ATTRIBUTE = call then
                    result.add(attribute.constructor)
                fi
            od

            return result
        si

        // The kind flags `TYPE_KIND` in the core library defines.
        _kind(type: CLASS_INSTANCE) -> int is
            let definition = type.definition

            if _target.is_array(type) then
                return 1 + 16
            elif _target.is_box(type) then
                return if definition.symbol_kind == Semantic.Symbols.SymbolKind.ENUM then 2 + 4 else 2 fi
            elif _target.is_struct(type) \/ _is_nullable(definition) then
                return 2
            elif definition.is_trait then
                return 8
            fi

            return 1
        si

        // The class `type` extends, at its type arguments: the first ancestor
        // that is not a trait, or the root where it names none.
        _superclass_type(type: CLASS_INSTANCE) -> Type is
            for ancestor in type.definition.ancestors do
                if !ancestor.is_trait then
                    if let specialized = type.specialize(ancestor) then
                        return specialized
                    fi
                fi
            od

            return IoC.CONTAINER.instance.innate_symbol_lookup.get_object_type()
        si

        // Whether `definition` is the carrier of a value-type optional, as
        // `Nullable[T]` is on .NET.
        _is_nullable(definition: Classy) -> bool is
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup
            let optional = lookup.get_optional_type(lookup.get_int_type())

            if let generic: Semantic.Symbols.GENERIC = optional.symbol then
                return generic.unspecialized_symbol == definition
            fi

            return optional.symbol == definition
        si

        _add_type(result: LIST[RTTI_CALL], name: string, type: Type) is
            if let method = _method(name) then
                result.add(RTTI_CALL.TYPE(_at(method, type)))
            fi
        si

        // The markers the compiler gives a union and its variants on .NET,
        // where a library compiled from source declares them: a union's
        // lists its variants where its marker takes them and the union is
        // not generic, since a generic union's variants have no type to name.
        _add_markers(result: LIST[RTTI_CALL], type: CLASS_INSTANCE) is
            let definition = type.definition

            if let `union: Semantic.Symbols.UNION = definition then
                if let marker = _marker("Ghul.Internal.UNION_ATTRIBUTE") then
                    let takes_variants = if definition.is_generic then null else CORE_LIBRARY.constructor(marker.definition, 1) fi

                    if let constructor = takes_variants then
                        for variant in `union.closed_alternatives do
                            _add_type(result, "_attribute_type", Semantic.Types.NAMED(variant))
                        od

                        _add_attribute(result, marker, constructor)
                    elif let constructor = CORE_LIBRARY.constructor(marker.definition, 0) then
                        _add_attribute(result, marker, constructor)
                    fi
                fi
            elif let variant: Semantic.Symbols.VARIANT = definition then
                _add_marker(result, "Ghul.Internal.VARIANT_ATTRIBUTE")

                if let owner: Semantic.Symbols.UNION = variant.owner /\ owner.default_variant == variant then
                    _add_marker(result, "Ghul.Internal.DEFAULT_VARIANT_ATTRIBUTE")
                fi
            fi
        si

        _add_marker(result: LIST[RTTI_CALL], name: string) is
            if let marker = _marker(name), constructor = CORE_LIBRARY.constructor(marker.definition, 0) then
                _add_attribute(result, marker, constructor)
            fi
        si

        _add_attribute(result: LIST[RTTI_CALL], marker: CLASS_INSTANCE, constructor: Function) is
            if let method = _method("_attribute") then
                result.add(RTTI_CALL.ATTRIBUTE(marker, FUNCTION_INSTANCE.of(constructor), FUNCTION_INSTANCE.of(method)))
            fi
        si

        // The marker class a library compiled from source declares under
        // `name`, or null where none does.
        _marker(name: string) -> CLASS_INSTANCE? =>
            if let type = IoC.CONTAINER.instance.innate_symbol_lookup.find_source_declared_type(name) then
                _target.class_of(type)
            else
                null
            fi

        // The members of the enum `type` boxes, in ascending order of value,
        // as .NET lists them.
        _add_enum_members(result: LIST[RTTI_CALL], type: CLASS_INSTANCE) is
            let method = _method("_enum_member")

            if !method? then
                return
            fi

            let enum_type = Semantic.Types.NAMED(type.definition)
            let members = LIST[(name: string, value: long)]()

            for symbol in type.definition.symbols do
                if let member: Semantic.Symbols.ENUM_STRUCT_MEMBER = symbol then
                    if let value = member.numeric_value then
                        members.add((name = member.name, value = long(value)))
                    fi
                fi
            od

            members.sort((a, b) => if a.value < b.value then -1 elif a.value > b.value then 1 else 0 fi)

            for member in members do
                result.add(RTTI_CALL.ENUM_MEMBER(member.name, member.value, _at(method, enum_type)))
            od
        si

        // The instance fields `type` itself declares, at its type arguments.
        _add_fields(result: LIST[RTTI_CALL], type: CLASS_INSTANCE) is
            let method = _method("_field")

            if !method? then
                return
            fi

            for `field in SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(type.definition)) do
                if `field.is_instance /\ !isa Semantic.Symbols.CONSTANT_FIELD(`field) then
                    if let field_type = type.specialize(`field.type) then
                        result.add(RTTI_CALL.FIELD(`field.name, `field, !`field.name.starts_with('_') /\ !`field.name.contains('$'), _at(method, field_type)))
                    fi
                fi
            od
        si

        // The instance properties `type` itself declares, each with the
        // accessors it has at the type's type arguments.
        _add_properties(result: LIST[RTTI_CALL], type: CLASS_INSTANCE) is
            let method = _method("_property")

            if !method? then
                return
            fi

            for property in SRM_MEMBER_ORDER.properties(SRM_EMITTED_TYPE(type.definition)) do
                if !property.is_instance then
                    continue
                fi

                if let property_type = type.specialize(property.type) then
                    let read = if let getter = property.read_function then FUNCTION_INSTANCE(getter, type.type_map) else null fi
                    let assign = if let setter = property.assign_function then FUNCTION_INSTANCE(setter, type.type_map) else null fi

                    result.add(
                        RTTI_CALL.PROPERTY(
                            property.name,
                            read,
                            !(property.read_function?.is_private ?? true),
                            assign,
                            !(property.assign_function?.is_private ?? true),
                            _at(method, property_type)))
                fi
            od
        si

        // The instance constructors of a class that can be made: not
        // abstract and not a trait. A unit variant's constructor gives the
        // one instance the program shares, as its target makes it. Each is
        // preceded by its parameters.
        _add_constructors(result: LIST[RTTI_CALL], type: CLASS_INSTANCE) is
            let definition = type.definition

            if definition.is_abstract \/ definition.is_trait then
                return
            fi

            let method = _method("_constructor")
            let parameter = _method("_parameter")

            if !method? \/ !parameter? then
                return
            fi

            if let group = cast Semantic.Symbols.FUNCTION_GROUP?(definition.find_direct("init")) then
                for constructor in group.functions do
                    if constructor.is_static_constructor then
                        continue
                    fi

                    let instance = FUNCTION_INSTANCE(constructor, type.type_map)

                    for i in 0..constructor.arguments.count do
                        if let parameter_type = instance.specialize(constructor.arguments[i]) then
                            result.add(RTTI_CALL.PARAMETER(constructor.argument_names[i], _at(parameter, parameter_type)))
                        fi
                    od

                    result.add(RTTI_CALL.CONSTRUCTOR(instance, !constructor.is_private, FUNCTION_INSTANCE.of(method)))
                od
            fi
        si

        _method(name: string) -> Function? is
            let method: Function mut

            if _methods.try_get_value(name, method ref) then
                return method
            fi

            return null
        si

        // `method` at the type argument `type`, where it takes one.
        _at(method: Function, type: Type) -> FUNCTION_INSTANCE is
            let map = MAP[Symbol, Type]()

            if method.generic_arguments.count > 0 then
                map[method.generic_arguments[0].symbol] = type
            fi

            return FUNCTION_INSTANCE(method, map)
        si
    si
si
