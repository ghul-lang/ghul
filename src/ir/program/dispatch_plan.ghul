namespace IR.Program is
    use Collections.LIST
    use Collections.MAP
    use Collections.SET

    use Semantic.Scope
    use Semantic.Types.Type
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function
    use Semantic.Symbols.GENERIC

    /// A slot in the vtables of a class and everything derived from it.
    ///
    /// - owner: the class whose vtable first has the slot
    /// - index: the slot's position in that vtable and every vtable derived from it
    /// - signature: the target's handle for the function type every entry in the slot has
    class DISPATCH_SLOT(owner: CLASS_INSTANCE, index: int, signature: int)

    /// A trait method, at one instantiation of its trait, called through the
    /// trait table.
    ///
    /// - method: the trait method, which overrides no other trait method
    /// - signature: the target's handle for the function type every entry in its row has
    class TRAIT_SELECTOR(method: FUNCTION_INSTANCE, signature: int) is
        /// Where the selector's row starts in the table, once packed.
        offset: int public
    si

    /// What a dispatch plan needs to know about the program's classes from
    /// the target that compiles them.
    trait DispatchTarget open is
        /// The root class, or null for a program with no classes.
        root: CLASS_INSTANCE?

        /// The numbers given to the classes.
        numbering: CLASS_ID_NUMBERING[CLASS_INSTANCE]

        /// The class a value of `type` is an instance of, or null where the
        /// program has none.
        class_of(type: Type?) -> CLASS_INSTANCE?

        /// The class `type` extends, or null where that is the root.
        superclass_of(type: CLASS_INSTANCE) -> CLASS_INSTANCE?

        /// The methods `definition` has, including any the target gave it.
        methods_of(definition: Classy) -> Collections.List[Function]

        /// Whether `type` is the root class.
        is_object(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is a class with a representation of its own.
        is_object_type(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is a scalar's box.
        is_box(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is an array type.
        is_array(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is the string type.
        is_string(type: CLASS_INSTANCE) -> bool

        /// Whether `type` is the built-in `bigint`.
        is_bigint(type: CLASS_INSTANCE) -> bool

        /// Whether anything creates an instance of `type`.
        is_instantiated(type: CLASS_INSTANCE) -> bool

        /// The target's handle for the function type of a vtable slot
        /// opened by `method` on `owner`, or null where the target cannot
        /// call it through a vtable.
        slot_signature(owner: CLASS_INSTANCE, method: FUNCTION_INSTANCE) -> int?

        /// The target's handle for the function type of the trait table row
        /// of `method`, or null where the target cannot call it through the
        /// table.
        selector_signature(method: FUNCTION_INSTANCE) -> int?
    si

    /// How a program's virtual and trait calls dispatch: the vtable slots of
    /// each class, and the trait selectors with their packed table.
    ///
    /// A class method that something overrides takes a slot in its class's
    /// vtable; an override fills the same slot. A trait method takes a row
    /// in one table, indexed by the receiver's class number plus the row's
    /// offset, one row for each instantiation of its trait.
    class DISPATCH_PLAN is
        _target: DispatchTarget

        _slots: MAP[CLASS_INSTANCE, LIST[DISPATCH_SLOT]]
        _slot_of: MAP[FUNCTION_INSTANCE, DISPATCH_SLOT]
        _slot_entries: MAP[CLASS_INSTANCE, LIST[FUNCTION_INSTANCE?]]

        _traits: MAP[CLASS_INSTANCE, CLASS_INSTANCE]
        _trait_classes: MAP[CLASS_INSTANCE, LIST[CLASS_INSTANCE]]
        _class_traits: MAP[CLASS_INSTANCE, LIST[CLASS_INSTANCE]]
        _selectors: MAP[FUNCTION_INSTANCE, TRAIT_SELECTOR]
        _rows: MAP[FUNCTION_INSTANCE, MAP[int, FUNCTION_INSTANCE]]
        _generic_calls: MAP[FUNCTION_INSTANCE, (root: Function, owner: CLASS_INSTANCE, arguments: Collections.List[Type])]

        // For each definition, the method it declares that fills each slot
        // it overrides, directly or through what that overrides.
        _fillers: MAP[Classy, MAP[Function, Function]]

        _table_size: int

        /// A plan for the classes `target` compiles.
        init(target: DispatchTarget) is
            _target = target

            _slots = MAP[CLASS_INSTANCE, LIST[DISPATCH_SLOT]]()
            _slot_of = MAP[FUNCTION_INSTANCE, DISPATCH_SLOT]()
            _slot_entries = MAP[CLASS_INSTANCE, LIST[FUNCTION_INSTANCE?]]()

            _traits = MAP[CLASS_INSTANCE, CLASS_INSTANCE]()
            _trait_classes = MAP[CLASS_INSTANCE, LIST[CLASS_INSTANCE]]()
            _class_traits = MAP[CLASS_INSTANCE, LIST[CLASS_INSTANCE]]()
            _selectors = MAP[FUNCTION_INSTANCE, TRAIT_SELECTOR]()
            _rows = MAP[FUNCTION_INSTANCE, MAP[int, FUNCTION_INSTANCE]]()
            _generic_calls = MAP[FUNCTION_INSTANCE, (root: Function, owner: CLASS_INSTANCE, arguments: Collections.List[Type])]()
            _fillers = MAP[Classy, MAP[Function, Function]]()
        si

        /// The trait table's size, once `plan_traits` has packed it.
        table_size: int => _table_size

        /// Every selector's row: the implementation for each class number.
        rows: Collections.Iterable[Collections.KEY_VALUE_PAIR[FUNCTION_INSTANCE, MAP[int, FUNCTION_INSTANCE]]] => _rows

        /// The selector whose row `method` heads.
        selector(method: FUNCTION_INSTANCE) -> TRAIT_SELECTOR => _selectors[method]

        /// Whether `type` has a vtable with at least one slot.
        has_slots(type: CLASS_INSTANCE) -> bool =>
            _slots.contains_key(type) /\ _slots[type].count > 0

        /// The slots of `type`'s vtable, in order.
        slots(type: CLASS_INSTANCE) -> Collections.List[DISPATCH_SLOT] => _slots[type]

        /// The implementation filling each of `type`'s slots, in order.
        slot_entries(type: CLASS_INSTANCE) -> Collections.List[FUNCTION_INSTANCE?] => _slot_entries[type]

        /// Plans the slots of the classes in `ordered`, which lists parents
        /// before children, and finds the traits each implements.
        plan_slots(ordered: Collections.List[CLASS_INSTANCE]) is
            for type in ordered do
                // A box and the string type implement whatever traits an `impl`
                // block gives their built-in type, so they take places in the
                // trait table as a class does.
                if _target.is_object_type(type) \/ _target.is_array(type) \/ _target.is_box(type) \/ _target.is_string(type) then
                    _plan_slots(type)
                    _collect_traits(type)
                else
                    _plan_slots(type)
                fi
            od
        si

        /// Plans the selectors of every trait instance the program uses, and
        /// packs their rows into the table.
        plan_traits() is
            _close_over_variance()

            // A trait instance the program uses that nothing implements has
            // a selector too, with an empty row: a call through it compiles,
            // and can only ever be made on an absent receiver.
            for used in LIST[CLASS_INSTANCE](_traits.values) do
                if !_trait_classes.contains_key(used) then
                    _trait_classes[used] = LIST[CLASS_INSTANCE]()
                fi
            od

            for (trait_type, classes) in _trait_classes do
                _plan_selectors(trait_type, classes)
            od

            for (selector, call) in _generic_calls do
                _plan_generic_selector(selector, call.root, call.owner, call.arguments)
            od

            _pack()
        si

        // Every row takes its place in the table before any body is
        // compiled, since a call bakes its row's offset into the code.
        // Every implementation a row could hold is placed, whether or not
        // anything reaches it: a call through a selector reaches them all.
        _pack() is
            let packing = ROW_DISPLACEMENT[FUNCTION_INSTANCE]()

            for (selector, row) in _rows do
                packing.add(selector, row.keys)
            od

            packing.pack()

            _table_size = packing.size

            for (selector_method, _) in _rows do
                _selectors[selector_method].offset = packing.offset(selector_method)
            od
        si

        /// The class `type`'s vtable extends: its superclass, or the root,
        /// or null for the root itself.
        parent(type: CLASS_INSTANCE) -> CLASS_INSTANCE? is
            if _target.is_object(type) then
                return null
            fi

            if let parent = _target.superclass_of(type) /\ _target.is_object_type(parent) then
                return parent
            fi

            return _target.root
        si

        /// Whether calls to `method` dispatch through a vtable or the table.
        is_dispatched(method: Function) -> bool static =>
            method.is_instance /\ method.is_virtual /\ !method.is_constructor /\ method.generic_arguments.count == 0

        /// Whether `method` is a trait method generic in its own right,
        /// whose calls dispatch through a row of the table for each
        /// instantiation the program calls it at.
        is_dispatched_generic(method: Function) -> bool static =>
            method.is_instance /\ !method.is_constructor /\ method.generic_arguments.count > 0 /\ (cast Classy?(method.owner)?.is_trait ?? false)

        /// The type arguments `call`, the instance a call names, gives its
        /// function's own type parameters, or null where it has none.
        ///
        /// - call: the function and type arguments a call names
        own_type_arguments(call: FUNCTION_INSTANCE) -> LIST[Type]? static is
            if call.definition.generic_arguments.count == 0 then
                return null
            fi

            let result = LIST[Type]()

            for parameter in call.definition.generic_arguments do
                let argument: Type mut

                if !call.type_map.try_get_value(parameter.symbol, argument ref) then
                    return null
                fi

                result.add(argument)
            od

            return result
        si

        /// Records a call to the generic trait method `method` on an
        /// instance of `trait_type`, made at `arguments`, its own type
        /// arguments, so that `plan_traits` gives the instantiation a row.
        /// Answers the selector's method, or null where `trait_type` is not
        /// an instance of the trait that declares it.
        ///
        /// - method: the trait method called
        /// - trait_type: the trait instance the call goes through
        /// - arguments: the method's own type arguments at the call
        note_generic_call(method: Function, trait_type: CLASS_INSTANCE, arguments: Collections.List[Type]) -> FUNCTION_INSTANCE? is
            let root = _root_trait_method(method)
            let owner = _trait_ancestor(trait_type, root.owner)

            if !owner? \/ root.generic_arguments.count != arguments.count then
                return null
            fi

            let key = FUNCTION_INSTANCE(root, _with_arguments(owner.type_map, root, arguments))

            if !_generic_calls.contains_key(key) then
                _generic_calls[key] = (root, owner, arguments)
            fi

            return key
        si

        /// The method a call to the generic trait method `method` runs on an
        /// instance of `type` at `arguments`, its own type arguments: the
        /// class's override or its implementation by name and signature, or
        /// a trait's default, at those arguments. Null where `type` has none.
        ///
        /// - type: the class of the receiver
        /// - method: the trait method called
        /// - arguments: the method's own type arguments at the call
        generic_implementation(type: CLASS_INSTANCE, method: Function, arguments: Collections.List[Type]) -> FUNCTION_INSTANCE? is
            let root = _root_trait_method(method)
            let traits = _traits_of(type)

            if !(traits |> Ghul.Pipes.any(t => t.definition == root.owner)) then
                return null
            fi

            let current: CLASS_INSTANCE? mut = type

            while current? do
                if let candidate = _filler(current.definition, root) /\ _takes_generic_call(candidate, arguments) then
                    return FUNCTION_INSTANCE(candidate, _with_arguments(current.type_map, candidate, arguments))
                fi

                current = parent(current)
            od

            if let merged = _merged_filler(type, root) /\ merged != root then
                return generic_implementation(type, merged, arguments)
            fi

            for trait_type in traits do
                for candidate in _target.methods_of(trait_type.definition) do
                    if _takes_generic_call(candidate, arguments) /\ !candidate.is_abstract /\ (candidate == root \/ _overrides(candidate, root)) then
                        return FUNCTION_INSTANCE(candidate, _with_arguments(trait_type.type_map, candidate, arguments))
                    fi
                od
            od

            return null
        si

        _takes_generic_call(method: Function, arguments: Collections.List[Type]) -> bool =>
            method.is_instance /\ !method.is_constructor /\ method.generic_arguments.count == arguments.count

        // `map` with each of `method`'s own type parameters taking the
        // argument at its position.
        _with_arguments(map: Collections.Map[Symbol, Type], method: Function, arguments: Collections.List[Type]) -> MAP[Symbol, Type] is
            let result = MAP[Symbol, Type]()

            for (parameter, argument) in map do
                result[parameter] = argument
            od

            for i in 0..method.generic_arguments.count do
                result[method.generic_arguments[i].symbol] = arguments[i]
            od

            return result
        si

        // Every trait instance `type` implements, through its own
        // declarations, the traits those derive from, and its superclasses,
        // found without recording anything.
        _traits_of(type: CLASS_INSTANCE) -> LIST[CLASS_INSTANCE] is
            let result = LIST[CLASS_INSTANCE]()

            _traits_of(type.definition, type.type_map, result)

            return result
        si

        _traits_of(from: Classy, map: Collections.Map[Symbol, Type], result: LIST[CLASS_INSTANCE]) is
            for ancestor in from.ancestors do
                let specialized = TYPE_MAPS.specialize(ancestor, map)!

                if ancestor.is_trait then
                    if let trait_type = trait_of(specialized) /\ !result.contains(trait_type) then
                        result.add(trait_type)

                        _traits_of(trait_type.definition, trait_type.type_map, result)
                    fi
                elif let superclass = _target.class_of(specialized) /\ _target.is_object_type(superclass) then
                    _traits_of(superclass.definition, superclass.type_map, result)
                fi
            od
        si

        // The instance of `definition`, one of `type`'s ancestors, that
        // `type` derives from.
        _ancestor(type: CLASS_INSTANCE, definition: Scope?) -> CLASS_INSTANCE? is
            let current: CLASS_INSTANCE? mut = type

            while current? do
                if current.definition == definition then
                    return current
                fi

                current = parent(current)
            od

            return null
        si

        // A class's vtable starts as a copy of its parent's. A method
        // overriding a class method fills that method's slot; one that
        // something overrides and that overrides nothing opens a new slot.
        _plan_slots(type: CLASS_INSTANCE) is
            let slots = LIST[DISPATCH_SLOT]()
            let entries = LIST[FUNCTION_INSTANCE?]()

            if let parent = parent(type) then
                slots.add_range(_slots[parent])
                entries.add_range(_slot_entries[parent])
            fi

            // The root and the classes the program declares bring methods
            // of their own, and the string type overrides the root's; a box
            // answers the root's.
            let is_string = _target.is_string(type)
            let has_own_methods = _target.is_object(type) \/ _target.is_object_type(type) \/ is_string

            for method in if has_own_methods then _target.methods_of(type.definition) else LIST[Function]() fi do
                if !is_dispatched(method) then
                    continue
                fi

                let key = FUNCTION_INSTANCE(method, type.type_map)

                if let slot = _overridden_slot(type, method) then
                    _slot_of[key] = slot
                    entries[slot.index] = key
                elif !is_string /\ !method.has_no_overriders then
                    if let signature = _target.slot_signature(type, key) then
                        let slot = DISPATCH_SLOT(type, slots.count, signature)

                        slots.add(slot)
                        entries.add(key)

                        _slot_of[key] = slot
                    fi
                fi
            od

            // A box answers with its scalar's own methods where they override
            // the root's, as the scalar would on .NET, and so does bigint.
            // Their methods are not the box's own to dispatch, so they only
            // fill the slots they override.
            if _target.is_box(type) \/ _target.is_bigint(type) then
                for method in _target.methods_of(type.definition) do
                    if !method.is_instance \/ method.is_constructor then
                        continue
                    fi

                    if let slot = _overridden_slot(type, method) then
                        let key = FUNCTION_INSTANCE(method, type.type_map)

                        _slot_of[key] = slot
                        entries[slot.index] = key
                    fi
                od
            fi

            _slots[type] = slots
            _slot_entries[type] = entries
        si

        _overridden_slot(type: CLASS_INSTANCE, method: Function) -> DISPATCH_SLOT? is
            if let overridees = method.overridees then
                for overridee in overridees do
                    if let function: Function = overridee then
                        if let owner = _ancestor(type, function.owner) then
                            let slot: DISPATCH_SLOT mut

                            if _slot_of.try_get_value(FUNCTION_INSTANCE(function, owner.type_map), slot ref) then
                                return slot
                            fi
                        fi
                    fi
                od
            fi

            return null
        si

        /// The one instance of the trait a value of `type` is, at its
        /// arguments.
        trait_of(type: Type) -> CLASS_INSTANCE? is
            let definition: Classy mut
            let map: Collections.Map[Symbol, Type] mut

            if let generic: GENERIC = type.symbol /\ isa Classy(generic.unspecialized_symbol) then
                definition = cast Classy?(generic.unspecialized_symbol)!
                map = generic.type_map
            elif let classy: Classy = type.symbol then
                definition = classy
                map = MAP[Symbol, Type]()
            else
                return null
            fi

            if !definition.is_trait then
                return null
            fi

            let key = CLASS_INSTANCE(definition, type.arguments, map)

            let existing: CLASS_INSTANCE mut

            if _traits.try_get_value(key, existing ref) then
                return existing
            fi

            _traits[key] = key

            return key
        si

        /// The one instance of the trait `definition` at the arguments
        /// `type_map` gives its parameters.
        trait_of(definition: Classy, type_map: Collections.Map[Symbol, Type]) -> CLASS_INSTANCE? is
            if !definition.is_trait then
                return null
            fi

            let map = MAP[Symbol, Type]()

            for (parameter, argument) in type_map do
                if parameter.owner == definition then
                    map[parameter] = argument
                fi
            od

            let key = CLASS_INSTANCE(definition, LIST[Type](map.values), map)

            let existing: CLASS_INSTANCE mut

            if _traits.try_get_value(key, existing ref) then
                return existing
            fi

            _traits[key] = key

            return key
        si

        // Each trait instance the program uses takes, as its implementors,
        // the classes implementing any instance of the same trait that
        // converts to it under the trait's declared variance, so a value
        // reached through a variant instantiation dispatches and tests as
        // it does on .NET. A row entry for the variant instance calls the
        // same compiled member as the instance the class implements.
        _close_over_variance() is
            let implemented = LIST[CLASS_INSTANCE](_trait_classes.keys)

            for used in LIST[CLASS_INSTANCE](_traits.values) do
                for trait_type in implemented do
                    if trait_type != used /\ trait_type.definition == used.definition /\ _converts_by_variance(trait_type, used) then
                        if !_trait_classes.contains_key(used) then
                            _trait_classes[used] = LIST[CLASS_INSTANCE]()
                        fi

                        let classes = _trait_classes[used]

                        for type in _trait_classes[trait_type] do
                            if !classes.contains(type) then
                                classes.add(type)
                                _class_traits[type].add(used)
                            fi
                        od
                    fi
                od
            od
        si

        // Whether the trait instance `from` converts to `to`, an instance of
        // the same trait: each type argument is the same, or, where the
        // parameter is declared `out` or `in` and both arguments are
        // reference types, a subtype or a supertype of `to`'s.
        _converts_by_variance(from: CLASS_INSTANCE, to: CLASS_INSTANCE) -> bool is
            if from.arguments.count != to.arguments.count then
                return false
            fi

            for i in 0..from.arguments.count do
                let source = from.arguments[i]
                let target = to.arguments[i]

                if source.is_assignable_from(target) /\ target.is_assignable_from(source) then
                    continue
                fi

                if source.is_value_type \/ target.is_value_type then
                    return false
                fi

                let variance = from.definition.get_argument_variance(i)

                if variance == Semantic.Types.TypeVariance.COVARIANT then
                    if !target.is_assignable_from(source) then
                        return false
                    fi
                elif variance == Semantic.Types.TypeVariance.CONTRAVARIANT then
                    if !source.is_assignable_from(target) then
                        return false
                    fi
                else
                    return false
                fi
            od

            return true
        si

        // Every trait instance a class implements, through its own
        // declarations, the traits those derive from, and its superclasses.
        _collect_traits(type: CLASS_INSTANCE) is
            let seen = SET[CLASS_INSTANCE]()

            _class_traits[type] = LIST[CLASS_INSTANCE]()

            _collect_traits(type, type.definition, type.type_map, seen)
        si

        _collect_traits(type: CLASS_INSTANCE, from: Classy, map: Collections.Map[Symbol, Type], seen: SET[CLASS_INSTANCE]) is
            for ancestor in from.ancestors do
                let specialized = TYPE_MAPS.specialize(ancestor, map)!

                if ancestor.is_trait then
                    if let trait_type = trait_of(specialized) /\ seen.add(trait_type) then
                        if !_trait_classes.contains_key(trait_type) then
                            _trait_classes[trait_type] = LIST[CLASS_INSTANCE]()
                        fi

                        _trait_classes[trait_type].add(type)
                        _class_traits[type].add(trait_type)

                        _collect_traits(type, trait_type.definition, trait_type.type_map, seen)
                    fi
                elif let superclass = _target.class_of(specialized) /\ _target.is_object_type(superclass) then
                    _collect_traits(type, superclass.definition, superclass.type_map, seen)
                fi
            od
        si

        // A trait method that overrides no other trait method is a
        // selector, one for each instantiation of its trait; one that does
        // dispatches through the one it overrides.
        _plan_selectors(trait_type: CLASS_INSTANCE, classes: LIST[CLASS_INSTANCE]) is
            for method in _target.methods_of(trait_type.definition) do
                if !is_dispatched(method) \/ _root_trait_method(method) != method then
                    continue
                fi

                let selector = FUNCTION_INSTANCE(method, trait_type.type_map)

                if _selectors.contains_key(selector) then
                    continue
                fi

                if let signature = _target.selector_signature(selector) then
                    _selectors[selector] = TRAIT_SELECTOR(selector, signature)

                    let row = MAP[int, FUNCTION_INSTANCE]()

                    for type in classes do
                        if let implementation = _implementation(type, method) then
                            row[_target.numbering.id(type)] = implementation
                        fi
                    od

                    _rows[selector] = row
                fi
            od
        si

        // A generic trait method has a selector for each instantiation a
        // call was recorded at, whose row holds each implementor's method
        // at the same arguments.
        _plan_generic_selector(selector: FUNCTION_INSTANCE, root: Function, owner: CLASS_INSTANCE, arguments: Collections.List[Type]) is
            if _selectors.contains_key(selector) then
                return
            fi

            let signature = _target.selector_signature(selector)

            if !signature? then
                return
            fi

            _selectors[selector] = TRAIT_SELECTOR(selector, signature)

            let row = MAP[int, FUNCTION_INSTANCE]()
            let classes: LIST[CLASS_INSTANCE] mut

            if _trait_classes.try_get_value(owner, classes ref) then
                for type in classes do
                    if let implementation = generic_implementation(type, root, arguments) then
                        row[_target.numbering.id(type)] = implementation
                    fi
                od
            fi

            _rows[selector] = row
        si

        _root_trait_method(method: Function) -> Function is
            if let overridees = method.overridees then
                for overridee in overridees do
                    if let function: Function = overridee /\ (cast Classy?(function.owner)?.is_trait ?? false) then
                        return _root_trait_method(function)
                    fi
                od
            fi

            return method
        si

        // The method a call to `selector` on an instance of `type` runs:
        // the nearest one up the class chain that overrides it, else a
        // trait's default.
        _implementation(type: CLASS_INSTANCE, selector: Function) -> FUNCTION_INSTANCE? is
            let current: CLASS_INSTANCE? mut = type

            while current? do
                if let method = _filler(current.definition, selector) /\ is_dispatched(method) then
                    return FUNCTION_INSTANCE(method, current.type_map)
                fi

                current = parent(current)
            od

            if let merged = _merged_filler(type, selector) /\ merged != selector then
                return _implementation(type, merged)
            fi

            for trait_type in _class_traits[type] do
                for method in _target.methods_of(trait_type.definition) do
                    if is_dispatched(method) /\ !method.is_abstract /\ (method == selector \/ _overrides(method, selector)) then
                        return FUNCTION_INSTANCE(method, trait_type.type_map)
                    fi
                od
            od

            return null
        si

        // The member a type `type` is or inherits from kept in place of
        // `slot`, where it inherited two of the same shape, or null.
        _merged_filler(type: CLASS_INSTANCE, slot: Function) -> Function? is
            let current: CLASS_INSTANCE? mut = type

            while current? do
                if let filler: Function = current.definition.merged_slot_filler(slot) then
                    return filler
                fi

                current = parent(current)
            od

            for trait_type in _traits_of(type) do
                if let filler: Function = trait_type.definition.merged_slot_filler(slot) then
                    return filler
                fi
            od

            return null
        si

        // The method `definition` declares that overrides `slot`, directly
        // or through what it overrides, or null where none does.
        _filler(definition: Classy, slot: Function) -> Function? is
            let fillers: MAP[Function, Function] mut

            if !_fillers.try_get_value(definition, fillers ref) then
                fillers = MAP[Function, Function]()

                for method in _target.methods_of(definition) do
                    if method.is_instance /\ !method.is_constructor then
                        _add_fillers(fillers, method, method)
                    fi
                od

                _fillers[definition] = fillers
            fi

            let method: Function mut

            if fillers.try_get_value(slot, method ref) then
                return method
            fi

            return null
        si

        // Records `method` as filling every slot `from` overrides, and
        // every slot those override in turn. The first method to reach a
        // slot keeps it.
        _add_fillers(fillers: MAP[Function, Function], method: Function, from: Function) is
            if let overridees = from.overridees then
                for overridee in overridees do
                    if let function: Function = overridee /\ !fillers.contains_key(function) then
                        fillers[function] = method

                        _add_fillers(fillers, method, function)
                    fi
                od
            fi
        si

        _overrides(method: Function, target: Function) -> bool is
            if let overridees = method.overridees then
                for overridee in overridees do
                    if let function: Function = overridee then
                        if function == target \/ _overrides(function, target) then
                            return true
                        fi
                    fi
                od
            fi

            return false
        si

        /// The vtable slot a call to `method` reads, or null where nothing
        /// overrides it.
        slot_of(method: FUNCTION_INSTANCE) -> DISPATCH_SLOT? is
            let result: DISPATCH_SLOT mut

            if _slot_of.try_get_value(method, result ref) then
                return result
            fi

            return null
        si

        /// The selector a call to the trait method `method` dispatches on,
        /// where `method` is called on an instance of `trait_type`, or null
        /// where it has none.
        selector_of(method: Function, trait_type: CLASS_INSTANCE) -> TRAIT_SELECTOR? is
            let root = _root_trait_method(method)
            let owner = _trait_ancestor(trait_type, root.owner)

            if !owner? then
                return null
            fi

            let result: TRAIT_SELECTOR mut

            if _selectors.try_get_value(FUNCTION_INSTANCE(root, owner.type_map), result ref) then
                return result
            fi

            return null
        si

        /// The selector a call to the generic trait method `method` at
        /// `arguments` dispatches on, where it is called on an instance of
        /// `trait_type`, or null where no call at those arguments was
        /// recorded.
        ///
        /// - method: the trait method called
        /// - trait_type: the trait instance the call goes through
        /// - arguments: the method's own type arguments at the call
        generic_selector_of(method: Function, trait_type: CLASS_INSTANCE, arguments: Collections.List[Type]) -> TRAIT_SELECTOR? is
            let root = _root_trait_method(method)
            let owner = _trait_ancestor(trait_type, root.owner)

            if !owner? \/ root.generic_arguments.count != arguments.count then
                return null
            fi

            let result: TRAIT_SELECTOR mut

            if _selectors.try_get_value(FUNCTION_INSTANCE(root, _with_arguments(owner.type_map, root, arguments)), result ref) then
                return result
            fi

            return null
        si

        // The instance of the trait `definition` that `trait_type` is or
        // derives from.
        _trait_ancestor(trait_type: CLASS_INSTANCE, definition: Scope?) -> CLASS_INSTANCE? is
            if trait_type.definition == definition then
                return trait_type
            fi

            for ancestor in trait_type.definition.ancestors do
                if ancestor.is_trait then
                    if let parent = trait_of(trait_type.specialize(ancestor)!) then
                        if let found = _trait_ancestor(parent, definition) then
                            return found
                        fi
                    fi
                fi
            od

            return null
        si

        /// The one method any call to `selector` can run, or null where the
        /// row has more than one, or none.
        only_implementation(selector: TRAIT_SELECTOR) -> FUNCTION_INSTANCE? =>
            only_implementation(selector, _ => true)

        /// The one method a call to `selector` can run on a value of a class
        /// `can_exist` accepts, or null where those classes run more than
        /// one, or none.
        ///
        /// - selector: the trait method's row
        /// - can_exist: whether a value of a class, by its number, can exist
        only_implementation(selector: TRAIT_SELECTOR, can_exist: (int) -> bool) -> FUNCTION_INSTANCE? =>
            _only(implementations(selector, can_exist))

        /// Every method a call to `selector` can run on a value of a class
        /// `can_exist` accepts.
        ///
        /// - selector: the trait method's row
        /// - can_exist: whether a value of a class, by its number, can exist
        implementations(selector: TRAIT_SELECTOR, can_exist: (int) -> bool) -> SET[FUNCTION_INSTANCE] is
            let implementations = SET[FUNCTION_INSTANCE]()

            for (class_id, implementation) in _rows[selector.method] do
                if can_exist(class_id) then
                    implementations.add(implementation)
                fi
            od

            return implementations
        si

        /// The method a call through `slot` runs on a value of exactly
        /// `type`, or null where `type`'s vtable has no such entry.
        ///
        /// - slot: the vtable slot the call reads
        /// - type: the receiver's exact class
        slot_implementation(slot: DISPATCH_SLOT, type: CLASS_INSTANCE) -> FUNCTION_INSTANCE? is
            let slots: LIST[DISPATCH_SLOT] mut

            if !_slots.try_get_value(type, slots ref) \/ slot.index >= slots.count \/ slots[slot.index] != slot then
                return null
            fi

            return _slot_entries[type][slot.index]
        si

        /// The method a call to `selector` runs on a value of the class
        /// numbered `class_id`, or null where its row has none.
        ///
        /// - selector: the trait method's row
        /// - class_id: the receiver's exact class, by its number
        implementation(selector: TRAIT_SELECTOR, class_id: int) -> FUNCTION_INSTANCE? is
            let row: MAP[int, FUNCTION_INSTANCE] mut
            let implementation: FUNCTION_INSTANCE mut

            if _rows.try_get_value(selector.method, row ref) /\ row.try_get_value(class_id, implementation ref) then
                return implementation
            fi

            return null
        si

        /// The one method a call through `slot` can run on a value of a
        /// class `can_exist` accepts, or null where those classes run more
        /// than one, or none.
        ///
        /// - slot: the vtable slot the call reads
        /// - can_exist: whether a value of a class can exist
        only_slot_implementation(slot: DISPATCH_SLOT, can_exist: (CLASS_INSTANCE) -> bool) -> FUNCTION_INSTANCE? =>
            if let implementations = slot_implementations(slot, can_exist) then _only(implementations) else null fi

        /// Every method a call through `slot` can run on a value of a class
        /// `can_exist` accepts, or null where the slot is the root's, which
        /// values with no class of their own, such as closures, answer too.
        ///
        /// - slot: the vtable slot the call reads
        /// - can_exist: whether a value of a class can exist
        slot_implementations(slot: DISPATCH_SLOT, can_exist: (CLASS_INSTANCE) -> bool) -> SET[FUNCTION_INSTANCE]? is
            if _target.is_object(slot.owner) then
                return null
            fi

            let implementations = SET[FUNCTION_INSTANCE]()

            for (type, slots) in _slots do
                // A class whose entry is empty, as an abstract class's is,
                // has no instance a call could reach.
                if slot.index < slots.count /\ slots[slot.index] == slot /\ can_exist(type) then
                    if let implementation = _slot_entries[type][slot.index] then
                        implementations.add(implementation)
                    fi
                fi
            od

            return implementations
        si

        _only(implementations: SET[FUNCTION_INSTANCE]) -> FUNCTION_INSTANCE? is
            if implementations.count == 1 then
                for implementation in implementations do
                    return implementation
                od
            fi

            return null
        si

        /// The classes implementing `trait_type`, or null where the program
        /// has none.
        implementors(trait_type: CLASS_INSTANCE) -> Collections.List[CLASS_INSTANCE]? is
            let result: LIST[CLASS_INSTANCE] mut

            if _trait_classes.try_get_value(trait_type, result ref) then
                return result
            fi

            return null
        si

        /// Every trait instance `type` implements, through its own
        /// declarations, the traits those derive from, and its superclasses.
        ///
        /// - type: the class
        all_traits_of(type: CLASS_INSTANCE) -> LIST[CLASS_INSTANCE] is
            let result = _traits_of(type)
            let widened: LIST[CLASS_INSTANCE] mut

            // The instances the program widens a trait to, by variance, are
            // ones the class answers to as well.
            if _class_traits.try_get_value(type, widened ref) then
                for used in widened do
                    if !result.contains(used) then
                        result.add(used)
                    fi
                od
            fi

            return result
        si

        /// The methods of `trait_type` a table lists for each class that
        /// implements it, in the order every table lists them: those that
        /// dispatch and override no other trait's method, in declaration
        /// order. A class's table is indexed the same way in every build, so
        /// a class compiled earlier can be called through by one compiled later.
        ///
        /// - trait_type: a trait instance
        table_methods(trait_type: CLASS_INSTANCE) -> LIST[Function] is
            let result = LIST[Function]()

            for method in _target.methods_of(trait_type.definition) do
                if is_dispatched(method) /\ _root_trait_method(method) == method then
                    result.add(method)
                fi
            od

            return result
        si

        /// The trait instance whose table a call to `method` on an instance of
        /// `trait_type` reads, and the method's place in that table, or null
        /// where the method has none.
        ///
        /// - method: the trait method called
        /// - trait_type: the trait instance the call goes through
        table_slot_of(method: Function, trait_type: CLASS_INSTANCE) -> (trait_type: CLASS_INSTANCE, slot: int)? is
            let root = _root_trait_method(method)
            let owner = _trait_ancestor(trait_type, root.owner)

            if !owner? then
                return null
            fi

            let methods = table_methods(owner)

            for i in 0..methods.count do
                if methods[i] == root then
                    return (owner, i)
                fi
            od

            return null
        si

        /// The method an instance of exactly `type` runs for the trait method
        /// `method`: the nearest override up its class chain, else a trait's
        /// default, or null where it has none.
        ///
        /// - type: the class
        /// - method: the root trait method
        implementation_in(type: CLASS_INSTANCE, method: Function) -> FUNCTION_INSTANCE? => _implementation(type, method)

        /// Marks every implementation that can fill `slot` as reached:
        /// `reach` is given each.
        use_slot(slot: DISPATCH_SLOT, reach: (FUNCTION_INSTANCE) -> void) is
            for (type, slots) in _slots do
                if !_target.is_instantiated(type) then
                    continue
                fi

                if slot.index < slots.count /\ slots[slot.index] == slot then
                    if let implementation = _slot_entries[type][slot.index] then
                        reach(implementation)
                    fi
                fi
            od
        si

        /// Marks every implementation in `selector`'s row as reached:
        /// `reach` is given each.
        use_selector(selector: TRAIT_SELECTOR, reach: (FUNCTION_INSTANCE) -> void) is
            for (_, implementation) in _rows[selector.method] do
                reach(implementation)
            od
        si
    si
si
