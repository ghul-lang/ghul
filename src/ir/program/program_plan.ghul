namespace IR.Program is
    use Collections.LIST
    use Collections.MAP
    use Collections.SET

    use Source.LOCATION

    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    /// What finding a program's reach needs from the target that lowers it.
    trait DiscoveryTarget open is
        /// Follows `instance`'s body far enough to find what it reaches: the
        /// functions it calls, the classes it creates or tests for, and the
        /// methods it dispatches on, each recorded on the plan's worklist,
        /// class set and dispatched methods. Nothing it produces is kept.
        reach(instance: FUNCTION_INSTANCE)

        /// Whether a value of `type` can exist: a box only where something
        /// boxes a value in it.
        is_instantiated(type: CLASS_INSTANCE) -> bool

        /// Called once for each class found to be instantiated, before its
        /// dispatched methods are reached.
        note_instantiated(type: CLASS_INSTANCE)

        /// Reports a construct the target cannot compile, declared at
        /// `location`.
        report(location: LOCATION, construct: string)
    si

    /// What a whole program reaches: the function instances to compile, the
    /// classes they use, and the methods they dispatch on, found to a fixed
    /// point from the entry point or, for a library, from every function
    /// that is not generic.
    ///
    /// Following a body finds the functions it calls and the classes it
    /// uses. A class found adds the types its fields hold, since the fields
    /// are laid out wherever the class is, and every instantiated class adds
    /// its implementations of the methods something dispatches on, since
    /// dispatch can reach them. An array type adds every method, since the
    /// trait table reaches them at the element type.
    class PROGRAM_PLAN is
        _classes: CLASS_SET
        _functions: FUNCTION_WORKLIST
        _dispatched: DISPATCHED_METHODS
        _display: DISPLAY_PLAN?
        _methods: MAP[Classy, LIST[Function]]

        /// What each type's description calls, where the program describes
        /// its types for reflection.
        rtti: RTTI_PLAN? public

        /// The function that describes a type, for a target that compiles
        /// its describers as ordinary functions; null for a target that
        /// writes them itself.
        describer_of: ((CLASS_INSTANCE) -> FUNCTION_INSTANCE?)? public

        /// A plan over the bodies `bodies` the program compiles.
        ///
        /// - classes: the classes found, which `reach` adds to
        /// - functions: the worklist of instances to compile, which `reach`
        ///   adds to
        /// - dispatched: the methods calls dispatch on, which `reach` adds to
        /// - display: which types get a displayer, and what each calls, or null
        ///   where the target writes no displayers
        /// - bodies: every function the program has a body for
        init(
            classes: CLASS_SET,
            functions: FUNCTION_WORKLIST,
            dispatched: DISPATCHED_METHODS,
            display: DISPLAY_PLAN?,
            bodies: Collections.Iterable[Function]
        ) is
            _classes = classes
            _functions = functions
            _dispatched = dispatched
            _display = display

            _methods = MAP[Classy, LIST[Function]]()

            for function in bodies do
                if let owner = FUNCTION_BODIES.class_of_body(function) then
                    if !_methods.contains_key(owner) then
                        _methods[owner] = LIST[Function]()
                    fi

                    _methods[owner].add(function)
                fi
            od
        si

        /// The classes the program uses.
        classes: CLASS_SET => _classes

        /// The function instances the program compiles.
        functions: FUNCTION_WORKLIST => _functions

        /// The methods calls dispatch on.
        dispatched: DISPATCHED_METHODS => _dispatched

        /// Finds everything the program reaches from what is already on the
        /// worklist, through `target`, until nothing new is found. A generic
        /// class instantiated more often, or at deeper type arguments, than
        /// `INSTANTIATION_LIMITS` allows is reported once, and the types of
        /// its fields are left out.
        discover(target: DiscoveryTarget) is
            let too_deep = SET[Classy]()
            let instantiations = MAP[Classy, int]()
            let instantiated = SET[CLASS_INSTANCE]()

            let is_done mut = false

            while !is_done do
                is_done = true

                while let instance = _functions.next() do
                    is_done = false

                    target.reach(instance)
                od

                for type in _classes.take_new_classes() do
                    is_done = false

                    let found mut = 0

                    instantiations.try_get_value(type.definition, found ref)
                    instantiations[type.definition] = found + 1

                    if type.definition.is_generic /\ (found >= INSTANTIATION_LIMITS.MAXIMUM_INSTANTIATIONS \/ TYPE_MAPS.depth(type.arguments) > INSTANTIATION_LIMITS.MAXIMUM_TYPE_ARGUMENT_DEPTH) then
                        // A class whose methods or fields instantiate it at
                        // deeper and deeper type arguments would be compiled
                        // without end, so its fields add nothing further.
                        if too_deep.add(type.definition) then
                            if found >= INSTANTIATION_LIMITS.MAXIMUM_INSTANTIATIONS then
                                target.report(type.definition.location, "a generic class instantiated at more than {INSTANTIATION_LIMITS.MAXIMUM_INSTANTIATIONS} type arguments")
                            else
                                target.report(type.definition.location, "a generic class that instantiates itself at ever deeper type arguments")
                            fi
                        fi

                        _classes.leave_field_types(type)
                    else
                        _classes.add_field_types(type)
                    fi
                od

                let count = _functions.count
                let instantiated_count = instantiated.count

                for type in _classes.classes_and_arrays do
                    if !target.is_instantiated(type) then
                        continue
                    fi

                    if instantiated.add(type) then
                        target.note_instantiated(type)
                    fi

                    let class_methods: LIST[Function] mut

                    if _methods.try_get_value(type.definition, class_methods ref) then
                        for method in class_methods do
                            if (method.generic_arguments.count == 0 /\ _dispatched.is_dispatched_to(method)) \/ _classes.is_array(type) then
                                _functions.add(FUNCTION_INSTANCE(method, type.type_map))
                            fi
                        od
                    fi
                od

                // A trait's default method is reached through the table from
                // any implementor that does not override it.
                for (definition, class_methods) in _methods do
                    if definition.is_trait /\ !definition.is_generic then
                        for method in class_methods do
                            if _dispatched.is_dispatched_to(method) then
                                _functions.add(method)
                            fi
                        od
                    fi
                od

                if let display = _display, helpers = display.helpers then
                    for type in _classes.classes_and_arrays do
                        for function in display.calls(type, helpers) do
                            _functions.add(function)
                        od
                    od
                fi

                if let rtti = self.rtti then
                    for type in rtti.described(_classes.classes_and_arrays) do
                        for function in rtti.reached(type) do
                            _functions.add(function)
                        od

                        if let describe = describer_of, describer = describe(type) then
                            _functions.add(describer)
                        fi
                    od
                fi

                if _functions.count != count \/ instantiated.count != instantiated_count then
                    is_done = false
                fi
            od
        si
    si
si
