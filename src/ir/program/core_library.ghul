namespace IR.Program is
    use Semantic.Lookups.RuntimeException

    /// The classes a whole-program backend constructs or reads on the
    /// program's behalf, found through the innate symbol lookup, so each is
    /// the class the target's core library declares for it.
    class CORE_LIBRARY is
        /// The class of the exception compiled code throws for the failure
        /// `kind`, or null where the core library declares none.
        ///
        /// - kind: which failure
        exception_class(kind: RuntimeException) -> Semantic.Symbols.Classy? static =>
            _classy(IoC.CONTAINER.instance.innate_symbol_lookup.find_runtime_exception_type(kind))

        /// The root exception class, or null where the core library
        /// declares none.
        root_exception_class() -> Semantic.Symbols.Classy? static =>
            _classy(IoC.CONTAINER.instance.innate_symbol_lookup.find_exception_type())

        /// The type object class, or null where the core library declares
        /// none.
        type_class() -> Semantic.Symbols.Classy? static =>
            _classy(IoC.CONTAINER.instance.innate_symbol_lookup.find_type_type())

        /// The class the runtime's environment is, or null where the core
        /// library declares none.
        environment_class() -> Semantic.Symbols.Classy? static =>
            _classy(IoC.CONTAINER.instance.innate_symbol_lookup.find_environment_type())

        /// The runtime's Result union, or null where the runtime the build
        /// references declares none.
        result_union_class() -> Semantic.Symbols.Classy? static =>
            IoC.CONTAINER.instance.innate_symbol_lookup.find_result_type()

        /// The runtime's `Ghul.inspect(object?)`, which writes a value as text,
        /// or null where the runtime the build references declares none.
        inspect_function() -> Semantic.Symbols.Function? static is
            let container = IoC.CONTAINER.instance

            if let runtime: Semantic.Symbols.NAMESPACE = container.symbol_table.global_scope.find_direct("Ghul") then
                if let group = cast Semantic.Symbols.FUNCTION_GROUP?(runtime.find_direct("inspect")) then
                    for function in group.functions do
                        if function.arguments.count == 1 /\ (function.arguments[0].type?.is_object ?? false) then
                            return function
                        fi
                    od
                fi
            fi

            return null
        si

        /// The constructor of `type` taking exactly the parameter types
        /// `parameters`, or null where it declares none.
        ///
        /// - type: the class, or null
        /// - parameters: the constructor's parameter types
        constructor(type: Semantic.Symbols.Classy?, parameters: Semantic.Types.Type?[]) -> Semantic.Symbols.Function? static =>
            Semantic.KNOWN_MEMBERS.in_group(
                cast Semantic.Symbols.FUNCTION_GROUP?(type?.find_direct("init")),
                Semantic.KNOWN_SIGNATURE(parameters, true))

        /// The constructor of `type` taking the types of `arguments`.
        ///
        /// - type: the class, or null
        /// - arguments: the values it is to be constructed from
        constructor_for(type: Semantic.Symbols.Classy?, arguments: IR.Values.Value[]) -> Semantic.Symbols.Function? static =>
            constructor(type, Collections.LIST[Semantic.Types.Type?](arguments |> Ghul.Pipes.map(a => a.type)))

        /// The type object constructor that takes the type's name and a
        /// function describing it, or null where the core library's type
        /// object, or `type`, has none. The describing function's type is
        /// the library's own, so it is recognised as a function type.
        ///
        /// - type: the type object class, or null
        describing_constructor(type: Semantic.Symbols.Classy?) -> Semantic.Symbols.Function? static is
            let string_type = IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type()

            if let group = cast Semantic.Symbols.FUNCTION_GROUP?(type?.find_direct("init")) then
                for constructor in group.functions do
                    if
                        constructor.is_instance /\
                        constructor.are_arguments_declared /\
                        constructor.arguments.count == 2 /\
                        string_type.compare(constructor.arguments[0]) == Semantic.Types.MATCH.SAME /\
                        constructor.arguments[1].is_function
                    then
                        return constructor
                    fi
                od
            fi

            return null
        si

        // The core library's string type, for a constructor taking a name
        // or a message.
        string_type: Semantic.Types.Type static => IoC.CONTAINER.instance.innate_symbol_lookup.get_string_type()

        /// The getter of the property `name` that `type` declares, or null
        /// where it declares no readable property of that name.
        find_getter(type: Semantic.Symbols.Classy, name: string) -> Semantic.Symbols.Function? static is
            if let property: Semantic.Symbols.Property = type.find_direct(name) then
                return property.read_function
            fi

            return null
        si

        _classy(type: Semantic.Types.Type?) -> Semantic.Symbols.Classy? static =>
            cast Semantic.Symbols.Classy?(type?.symbol)
    si
si
