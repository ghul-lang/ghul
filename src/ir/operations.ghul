namespace IR is
    // The built-in scalar kinds a numeric conversion, a narrowed literal
    // or a built-in operator works on, named by what they hold rather
    // than by how any one target loads them.
    enum Scalar is
        BOOL,
        CHAR,
        INT8,
        UINT8,
        INT16,
        UINT16,
        INT32,
        UINT32,
        INT64,
        UINT64,
        INT_NATIVE,
        UINT_NATIVE,
        FLOAT32,
        FLOAT64
    si

    // A built-in arithmetic or bitwise operator. Where signed and
    // unsigned operands need different operations, the unsigned one is
    // its own member.
    enum ArithmeticOperation is
        ADD,
        SUBTRACT,
        MULTIPLY,
        DIVIDE,
        DIVIDE_UNSIGNED,
        REMAINDER,
        REMAINDER_UNSIGNED,
        NEGATE,
        COMPLEMENT,
        AND,
        OR,
        XOR,
        SHIFT_LEFT,
        SHIFT_RIGHT,
        SHIFT_RIGHT_UNSIGNED
    si

    // A built-in comparison between two values, answering a bool.
    enum Comparison is
        EQUAL,
        NOT_EQUAL,
        LESS,
        LESS_OR_EQUAL,
        GREATER,
        GREATER_OR_EQUAL
    si
si
