namespace IR is
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function

    /// The backend for the build's target. The target is set from the
    /// command line after the container is built, so the choice is made
    /// at each call rather than once.
    class TARGET_BACKEND: Backend is
        _flags: Compiler.GLOBAL_BUILD_FLAGS
        _backends: Collections.Map[Compiler.Target, Backend]

        _backend: Backend => _backends[_flags.target]

        // The driver installs and resets the backend before anything asks
        // whether code is generated, so for a target with no backend both
        // do nothing.
        _backend_if_any: Backend? =>
            if _backends.contains_key(_flags.target) then _backends[_flags.target] else null fi

        /// - flags: the build flags the target is read from
        /// - backends: the backend for each target
        init(flags: Compiler.GLOBAL_BUILD_FLAGS, backends: Collections.Map[Compiler.Target, Backend]) is
            _flags = flags
            _backends = backends
        si

        install(module_name: string, module_version: string, want_library: bool) is
            _backend_if_any?.install(module_name, module_version, want_library)
        si

        reset() is _backend_if_any?.reset() si
        begin_assembly() is _backend.begin_assembly() si
        end_assembly() is _backend.end_assembly() si
        add_resource(name: string, content: ARRAY[ubyte]) is _backend.add_resource(name, content) si
        write(path: string) is _backend.write(path) si
        begin_body() is _backend.begin_body() si
        begin_body(member: Symbol) is _backend.begin_body(member) si
        write(value: Values.Value) is _backend.write(value) si
        finish_body(function: Function) is _backend.finish_body(function) si
        finish_frame_member_body(frame: Classy, member: FrameMember) is _backend.finish_frame_member_body(frame, member) si
        finish_unit_variant_initializer(variant: Classy) is _backend.finish_unit_variant_initializer(variant) si
        end_body() is _backend.end_body() si
        abandon_bodies() is _backend.abandon_bodies() si
        has_unit_variant_instance(variant: Classy) -> bool => _backend.has_unit_variant_instance(variant)
        mark_entry_point(function: Function) is _backend.mark_entry_point(function) si
        declare_extern(function: Function) is _backend.declare_extern(function) si
        declare_prebuilt(function: Function) is _backend.declare_prebuilt(function) si
    si
si
