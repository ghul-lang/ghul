namespace IR is
    use IO.Std

    use Semantic.Types.Type
    use Values.Value

    class TEMP is
        _block: IR.Values.BLOCK
        _next_id: int static
        _name: string =>
            if suffix > 0 then
                ".{prefix}.{id}.{suffix}"
            else
                ".{prefix}.{id}"
            fi

        local: LOCAL

        id: int
        prefix: string
        suffix: int
        type: Type

        init(block: IR.Values.BLOCK, prefix: string, suffix: int, type: Type) is
            _block = block
            self.prefix = prefix
            self.suffix = suffix

            self.id = get_next_id()
            self.type = type

            local = LOCAL(_name, type)

            declare()
        si

        init(block: IR.Values.BLOCK, prefix: string, value: Value) is
            init(block, prefix, 0, value)
        si

        init(block: IR.Values.BLOCK, prefix: string, suffix: int, value: Value) is
            init(block, prefix, suffix, value.type!)

            store(value)
        si

        init(block: IR.Values.BLOCK, prefix: string, type: Type) is
            init(block, prefix, 0, type)
        si

        reset_id() static is
            _next_id = 0
        si

        get_next_id() -> int static is
            let result = _next_id
            _next_id = _next_id + 1
            return result
        si

        declare() is
            _block.add(Values.DECLARE_LOCAL(local))
        si

        load() -> Values.Load.TEMP => Values.Load.TEMP(local)

        store(value: Value) is
            _block.add(value)

            _block.add(Values.STORE_TEMP(local))
        si
    si
si
