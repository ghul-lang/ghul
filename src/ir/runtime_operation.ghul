namespace IR is
    // What a program needs from the runtime it runs on rather than from
    // the language. Each backend maps these to members of its own
    // runtime.
    enum RuntimeOperation is
        // (string, string) -> string
        CONCAT_STRINGS,

        // (string, string) -> bool, comparing content
        STRINGS_EQUAL,

        // (message) -> the exception a body-less override throws
        NEW_NOT_IMPLEMENTED,

        // () -> the exception a member with no support throws
        NEW_NOT_SUPPORTED,

        // (message) -> the exception a failed assertion throws
        NEW_ASSERT_FAILED,

        // (instance) -> nothing: runs the root constructor on an
        // instance being constructed
        INIT_OBJECT,

        // () -> int, the id of the thread the code is running on
        CURRENT_THREAD_ID,

        // (pipe) -> string, the pipe's elements rendered as a string;
        // the operation's type argument is the element type
        JOIN_PIPE,

        // (from, to) -> a range; the operation's type is the range type
        NEW_RANGE,

        // A string builder accumulates the text of a string
        // interpolation or a join. Its operations take a load of the
        // builder first.

        // (literal length, value count) -> a builder; the counts are
        // sizing hints, and the operation's type is the builder's type
        NEW_STRING_BUILDER,

        // (builder, string) -> nothing
        APPEND_TEXT,

        // (builder, value) -> nothing; the operation's type argument is
        // the value's type
        APPEND_VALUE,

        // (builder, value, alignment) -> nothing
        APPEND_ALIGNED_VALUE,

        // (builder, value, format) -> nothing
        APPEND_FORMATTED_VALUE,

        // (builder, value, alignment, format) -> nothing
        APPEND_ALIGNED_FORMATTED_VALUE,

        // (builder) -> the string built
        BUILD_STRING
    si
si
