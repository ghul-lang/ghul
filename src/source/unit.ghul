namespace Source is
    /// What kind of unit a declaration belongs to.
    enum UnitKind is
        /// The program being built: its own source files.
        PROGRAM,

        /// A source library declared with `--library-source`, compiled in
        /// from its sources.
        LIBRARY,

        /// A cell of a session, named by its place among the cells.
        CELL,

        /// The compiler itself: a declaration it makes, such as the
        /// built-in types and the families it constructs.
        COMPILER,

        /// An assembly read by reflection.
        IMPORTED,

        /// Nowhere the compiler knows.
        UNKNOWN
    si

    /// The unit a declaration belongs to: the program, one source library,
    /// one cell, the compiler, an imported assembly, or nowhere known. Two
    /// units are the same unit when they are the same kind and, for a
    /// library or a cell, the same library or the same cell.
    ///
    /// - kind: what kind of unit it is
    /// - library: the library, for a library's unit, and null otherwise
    /// - cell: the cell's place among the session's cells, for a cell's
    ///   unit, and null otherwise
    class UNIT(kind: UnitKind public, library: SOURCE_LIBRARY? public, cell: int? public): Ghul.Equatable[UNIT] is
        _program: UNIT static
        _compiler: UNIT static
        _imported: UNIT static
        _unknown: UNIT static

        /// The program's own unit.
        program: UNIT static => _program

        /// The compiler's own declarations.
        compiler: UNIT static => _compiler

        /// An assembly read by reflection.
        imported: UNIT static => _imported

        /// Nowhere the compiler knows.
        unknown: UNIT static => _unknown

        init() static is
            _program = UNIT(UnitKind.PROGRAM, null, null)
            _compiler = UNIT(UnitKind.COMPILER, null, null)
            _imported = UNIT(UnitKind.IMPORTED, null, null)
            _unknown = UNIT(UnitKind.UNKNOWN, null, null)
        si

        /// The unit of `library`.
        ///
        /// - library: the source library
        of_library(library: SOURCE_LIBRARY) -> UNIT static => UNIT(UnitKind.LIBRARY, library, null)

        /// The unit of the cell at `cell` among the session's cells.
        ///
        /// - cell: the cell's place, from zero
        of_cell(cell: int) -> UNIT static => UNIT(UnitKind.CELL, null, cell)

        /// Whether the unit is the program's own.
        is_program: bool => kind == UnitKind.PROGRAM

        /// Whether the unit is a source library.
        is_library: bool => kind == UnitKind.LIBRARY

        /// Whether the unit is a cell of a session.
        is_cell: bool => kind == UnitKind.CELL

        /// Whether the unit's sources are the ones the user is building: the
        /// program, or a cell of a session.
        is_users: bool => kind == UnitKind.PROGRAM \/ kind == UnitKind.CELL

        =~(other: UNIT) -> bool =>
            kind == other.kind /\ library == other.library /\ cell =~ other.cell

        get_hash_code() -> int => (cast int(kind)) * 31 + (cell ?? -1)

        to_string() -> string =>
            case kind
            when UnitKind.LIBRARY then "library {library?.name}"
            when UnitKind.CELL then "cell {cell}"
            when UnitKind.PROGRAM then "program"
            when UnitKind.COMPILER then "compiler"
            when UnitKind.IMPORTED then "imported"
            else "unknown"
            esac
    si
si
