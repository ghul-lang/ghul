namespace Source is
    class LOCATION_STACK is
        // A null entry stands for no position at all, for a value built
        // where the one it stands in for was built without one.
        _stack: Collections.STACK[LOCATION?]

        init() is
            _stack = Collections.STACK[LOCATION?]()
        si

        is_empty: bool => _stack.count == 0

        current: LOCATION? =>
            if _stack.count > 0 then
                _stack.peek()
            else
                null
            fi

        push(location: LOCATION?) is
            _stack.push(location)
        si

        pop() is
            assert _stack.count > 0
            _stack.pop()
        si
    si
si
