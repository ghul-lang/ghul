namespace Source is
    use Collections

    use Ghul.Pipes

    // The pre-edit spans of the function bodies an incremental EDIT
    // re-walks. A symbol-use or definition entry inside one of these is
    // re-recorded fresh by the re-walk, so reconciliation discards it
    // rather than translating it.
    //
    // Spans can nest: the entry synthesised from a file's top-level
    // statements spans from the first statement to the last, which
    // encloses the body of any function written between them. So the
    // spans sort by start position, and `contains` asks whether any span
    // starting at or before the position reaches it, which the furthest
    // end among them answers.
    class BODY_SPANS is
        _spans: LIST[LOCATION]
        _furthest_end: LIST[int]
        _prepared: bool

        init() is
            _spans = LIST[LOCATION]()
            _furthest_end = LIST[int]()
        si

        // Internal locations are synthesised — their packed position is
        // (1,1) by construction and would otherwise drop any real symbol
        // declared at line 1 column 1 (a top-level namespace, the first
        // class in the file) when reconciliation calls `contains` with
        // file_name unchecked.
        add(span: LOCATION) is
            if !span.is_internal then
                _spans.add(span)
                _prepared = false
            fi
        si

        // Is a (packed) position inside one of the re-walked bodies?
        contains(position: int) -> bool is
            _prepare()

            // the spans starting at or before `position`
            let lo mut = 0
            let hi mut = _spans.count

            while lo < hi do
                let mid = (lo + hi) / 2

                if _spans[mid].start <= position then
                    lo = mid + 1
                else
                    hi = mid
                fi
            od

            // the same test LOCATION.contains makes of one span
            return lo > 0 /\ _furthest_end[lo - 1] >= position - 1
        si

        _prepare() is
            if _prepared then
                return
            fi

            _spans = LIST[LOCATION](_spans |> sort((a, b) => a.start - b.start))
            _furthest_end = LIST[int]()

            let furthest mut = 0

            for span in _spans do
                if span.end > furthest then
                    furthest = span.end
                fi

                _furthest_end.add(furthest)
            od

            _prepared = true
        si
    si
si
