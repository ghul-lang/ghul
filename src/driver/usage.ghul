namespace Driver is
    // The `--help` text. Kept beside the argument loop in `main.ghul`, which is
    // the authority on what the compiler accepts: a flag added there wants a
    // line here too.
    class USAGE is
        is_requested(arguments: Collections.Iterable[string]) -> bool static is
            for argument in arguments do
                if argument =~ "-h" \/ argument =~ "--help" \/ argument =~ "-?" then
                    return true
                fi
            od

            return false
        si

        text: string static =>
            "usage: ghul-compiler [options] <source.ghul> ...\n"
            "\n"
            "Compiles ghūl source files to a .NET assembly. With no -a or --sdk-ref-path,\n"
            "the .NET reference assemblies are discovered from the installed SDK, so a\n"
            "source file on its own is a complete command line:\n"
            "\n"
            "    ghul-compiler hello.ghul\n"
            "\n"
            "The output is named after the first source file unless -o says otherwise. A\n"
            "program that uses the ghūl runtime needs ghul-runtime.dll beside the binary\n"
            "before it will run; an MSBuild build puts it there for you.\n"
            "\n"
            "modes:\n"
            "  -A, --analyse                serve language-service requests on stdin/stdout\n"
            "      --compile-server         compile one JSON request per line from stdin, replying on stdout\n"
            "  -G, --type-check             parse and type-check only, emitting nothing\n"
            "  -g, --no-type-check          parse only\n"
            "      --check-complete         parse one source and print complete, incomplete or invalid\n"
            "  -S, --assembler              generate code but write no assembly\n"
            "      --format                 reformat the sources to standard output\n"
            "      --format-in-place        reformat the source files themselves\n"
            "      --format-width <cols>    column the formatter wraps at (default 100)\n"
            "      --library                build a library rather than an executable\n"
            "\n"
            "output:\n"
            "  -o, --output <path>          write the assembly here\n"
            "      --debug                  emit debug information\n"
            "      --target-framework <tfm> target framework moniker, e.g. net10.0\n"
            "      --version <version>      version stamped into the assembly\n"
            "      --resource <path>=<name> embed <path> as a managed resource named <name>; repeatable\n"
            "      --assembly-info-string <attribute>=<value>\n"
            "                               apply this attribute to the assembly; a value with a comma\n"
            "                               fills a two-string constructor when there is no one-string one\n"
            "\n"
            "references:\n"
            "  -a, --assembly <name>        reference this assembly; repeatable, and naming any replaces the default set\n"
            "      --reference <name>       reference this assembly as well as the reference set; repeatable\n"
            "      --sdk-ref-path <dir>     directory holding the .NET reference assemblies\n"
            "  -p, --library-prefix <path>  prefix for resolving referenced assemblies\n"
            "      --exclude-runtime-symbols  do not load the ghūl runtime's symbols\n"
            "\n"
            "compilation:\n"
            "      --default-use <names>    what `use default` imports; comma-separated\n"
            "      --define <symbol>        define a conditional compilation symbol\n"
            "      --entry <name>           name of the entry point function\n"
            "      --global-namespace       share one namespace across namespace-less files\n"
            "      --implicit-default-use   give each namespace-less file an implicit `use default`\n"
            "      --library-source <name>@<version>=<root>\n"
            "                               declare a source library rooted at <root>; its files belong to that library; repeatable\n"
            "      --submission <name>      compile one step of an interactive session: the namespace-less file's namespace is <name>, and its entry returns its final expression's value\n"
            "      --target <name>          compile for dotnet or wasm\n"
            "      --underscore-access <m>  underscore visibility: private, protected, legacy\n"
            "  -E, --ignore-errors          carry on emitting after an error\n"
            "\n"
            "diagnostics:\n"
            "      --suppress <slugs>       silence these warnings; comma-separated\n"
            "      --warn-as-error <slugs>  promote these warnings to errors, or all\n"
            "      --warn-as-info <slugs>   demote these warnings to information\n"
            "      --warn-as-hint <slugs>   demote these warnings to editor hints\n"
            "      --msbuild-diagnostics    report diagnostics in MSBuild's format\n"
            "\n"
            "analysis mode:\n"
            "      --incremental-analysis   reuse the symbol table across edits\n"
            "      --analysis-idle-timeout <seconds>  exit after this long without a request\n"
            "      --show-analysis-stats    report timings for each analysis request\n"
            "      --no-analysis-heap-watchdog  do not force collection when the heap grows\n"
            "\n"
            "other:\n"
            "  -h, -?, --help               show this message\n"
            "      @<file>                  read further arguments from this file\n"
            "\n"
            "With no arguments at all the compiler prints its version. There is no flag\n"
            "for that: --version sets the version of the assembly being built.\n"
    si
si
