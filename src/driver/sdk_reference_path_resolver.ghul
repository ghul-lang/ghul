namespace Driver is
    // Locates the .NET reference-assembly directory to compile against when the
    // compiler is invoked with source files but neither `-a` nor
    // `--sdk-ref-path`. The install root comes from DOTNET_ROOT, or is derived
    // from the runtime directory the compiler is itself running on, or failing
    // that from the `dotnet` host on PATH, which is where a natively compiled
    // compiler, running on no shared runtime, finds it; under it,
    // the highest Microsoft.NETCore.App.Ref pack matching the target
    // framework's version supplies `ref/<tfm>/`. Every step answers null rather
    // than throwing, so a layout this doesn't recognise surfaces as the
    // caller's "no reference assemblies supplied" error.
    class SDK_REFERENCE_PATH_RESOLVER is
        init() is si

        resolve(target_framework: string) -> string? is
            let dotnet_root = discover_dotnet_root()

            if !dotnet_root? then
                return null
            fi

            return resolve_under(dotnet_root, target_framework)
        si

        resolve_under(dotnet_root: string, target_framework: string) -> string? is
            let version = framework_version(target_framework)

            if !version? then
                return null
            fi

            let packs_root = IO.Path.join([dotnet_root, "packs", "Microsoft.NETCore.App.Ref"])

            if !IO.Directory.exists(packs_root) then
                return null
            fi

            let pack = latest_ref_pack(packs_root, version)

            if !pack? then
                return null
            fi

            let reference_path = IO.Path.join([pack, "ref", target_framework])

            if !IO.Directory.exists(reference_path) then
                return null
            fi

            return reference_path
        si

        // "net10.0" -> "10.0", matching ref-pack directory names like "10.0.10".
        // A moniker that isn't `net` followed by a version has no pack of this
        // shape to find, so it answers null rather than globbing on a prefix
        // that would match nothing (or, for a short value, indexing off the end).
        framework_version(target_framework: string) -> string? is
            if target_framework.length <= 3 \/ !target_framework.starts_with("net") then
                return null
            fi

            let first = target_framework[3]

            if first < '0' \/ first > '9' then
                return null
            fi

            return target_framework.substring(3, target_framework.length - 3)
        si

        // The runtime directory is `shared/Microsoft.NETCore.App/<version>/`
        // under the install root, so the root is three levels up. Trailing
        // separators have to go first, or get_directory_name consumes one of
        // them instead of a path segment and the walk stops a level short.
        install_root_from_runtime_directory(runtime_directory: string) -> string? is
            let trimmed = strip_trailing_separators(runtime_directory)

            if trimmed.length == 0 then
                return null
            fi

            let current mut = trimmed

            for i in 0..3 do
                let parent = IO.Path.get_directory_name(current)

                if !parent? then
                    return null
                fi

                if parent.length == 0 then
                    return null
                fi

                current = parent
            od

            return current
        si

        strip_trailing_separators(path: string) -> string is
            let result mut = path

            while result.length > 0 /\ is_separator(result[result.length - 1]) do
                result = result.substring(0, result.length - 1)
            od

            return result
        si

        // Both of the running platform's separators: on Windows that covers the
        // native `\` as well as `/`, and on Unix `\` is a legal filename
        // character and deliberately isn't stripped.
        is_separator(c: char) -> bool =>
            c == IO.Path.directory_separator_char \/ c == IO.Path.alt_directory_separator_char

        latest_ref_pack(packs_root: string, framework_version: string) -> string? is
            let best: string? mut = null
            let best_version: System.Version? mut = null

            for directory in IO.Directory.get_directories(packs_root, "{framework_version}.*") do
                let version_text = IO.Path.get_file_name(directory) ?? ""

                try
                    let version = System.Version.parse(version_text)

                    if !best_version? \/ version.compare_to(best_version) > 0 then
                        best_version = version
                        best = directory
                    fi
                catch ex: System.Exception
                    // not a version directory; skip
                yrt
            od

            return best
        si

        discover_dotnet_root() -> string? is
            let env_root = System.Environment.get_environment_variable("DOTNET_ROOT")

            if env_root? /\ env_root.length > 0 /\ IO.Directory.exists(env_root) then
                return env_root
            fi

            let derived =
                install_root_from_runtime_directory(
                    System.Runtime.InteropServices.RuntimeEnvironment.get_runtime_directory())

            if derived? /\ is_install_root(derived) then
                return derived
            fi

            return install_root_from_search_path(System.Environment.get_environment_variable("PATH"))
        si

        // A natively compiled compiler's runtime directory is its own, so the
        // walk up from it lands somewhere that is not an install root at all.
        is_install_root(directory: string) -> bool =>
            IO.Directory.exists(IO.Path.join([directory, "shared", "Microsoft.NETCore.App"]))

        // The directory of the first `dotnet` host on `search_path` that sits
        // in an install root. A package manager's host is usually a symbolic
        // link into the install root, so the link is followed first.
        install_root_from_search_path(search_path: string?) -> string? is
            if !search_path? then
                return null
            fi

            let host_name =
                if System.OperatingSystem.is_windows() then "dotnet.exe" else "dotnet" fi

            for directory in search_path.split([IO.Path.path_separator], System.StringSplitOptions.REMOVE_EMPTY_ENTRIES) do
                let candidate = IO.Path.join(directory, host_name)

                if !IO.File.exists(candidate) then
                    continue
                fi

                let host_path mut = candidate

                try
                    if let target = IO.File.resolve_link_target(candidate, true) then
                        host_path = target.full_name
                    fi
                catch ex: System.Exception
                    // an unresolvable link is tried as it stands
                yrt

                if let root = IO.Path.get_directory_name(IO.Path.get_full_path(host_path)) then
                    if is_install_root(root) then
                        return root
                    fi
                fi
            od

            return null
        si
    si
si
