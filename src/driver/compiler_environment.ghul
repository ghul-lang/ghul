namespace Driver is
    // Every environment variable the compiler reads, including any flag for
    // an experiment, is declared here and read through this class, because
    // Ghul.Environment is the mechanism that works on all three targets.
    // Nothing else in src/ reads the environment. The one System.Environment
    // member used is the working set, which every target provides.

    /// The process environment as the compiler reads it: one accessor for
    /// each environment variable it consults, and the process's own exit
    /// and path.
    class COMPILER_ENVIRONMENT is
        _environment: Ghul.Environment static => Ghul.ENVIRONMENT.instance

        _get(name: string) -> string? static => _environment[name]

        /// Whether builds are being served one after another in this process,
        /// where ending a build must not end the process.
        is_serving_builds: bool static public

        /// The bytes of memory the process occupies: its resident or working
        /// set. Reading it collects nothing. Answers 0 where the host
        /// cannot say.
        working_set_bytes: long static => System.Environment.working_set

        /// Ends the process with `code` as its exit status.
        ///
        /// - code: the exit status
        exit(code: int) static is
            if is_serving_builds then
                throw BUILD_ENDED(code)
            fi

            _environment.exit(code)
        si

        /// The path of the running executable, or null where it is not
        /// known.
        process_path: string? static => _environment.process_path

        /// The version this build of the compiler was given with --version,
        /// or 0.0.0-local; a .NET build reads its version from its assembly.
        @IF.not.dotnet()
        program_version: string static => Ghul.ENVIRONMENT.program_version

        /// `PATH`: where an executable is searched for.
        path: string? static => _get("PATH")

        /// `DOTNET_ROOT`: where the .NET SDK is installed, where it is set.
        dotnet_root: string? static => _get("DOTNET_ROOT")

        /// `GHUL_LLVM`: the ghul-llvm executable to link with, where it is
        /// set.
        llvm_linker: string? static => _get("GHUL_LLVM")

        /// `GHUL_LLVM_RUNTIME`: a directory ghul-llvm searches for libraries
        /// first, where it is set.
        llvm_runtime: string? static => _get("GHUL_LLVM_RUNTIME")

        /// `GHUL_PURE_SLOT_TRACE`: trace the pure-slot check.
        pure_slot_trace: bool static => _get("GHUL_PURE_SLOT_TRACE")?

        /// `GHUL_NARROWING_STUDY`: where to write the narrowing study, where
        /// it is set.
        narrowing_study: string? static => _get("GHUL_NARROWING_STUDY")

        /// `GHUL_TRACE_INFERENCE`: what to trace inference for, where it is
        /// set.
        trace_inference: string? static => _get("GHUL_TRACE_INFERENCE")

        /// `GHUL_PIPE_FUSION_STUDY`: where to write the pipe fusion study,
        /// where it is set.
        pipe_fusion_study: string? static => _get("GHUL_PIPE_FUSION_STUDY")

        /// `GHUL_EFFECTS_TIMING`: time the effect analyses.
        effects_timing: bool static => _get("GHUL_EFFECTS_TIMING")?

        /// `GHUL_EFFECTS_VERIFY`: check a seeded store-free solve against an
        /// unseeded one.
        effects_verify: bool static => _get("GHUL_EFFECTS_VERIFY")?

        /// `GHUL_EMIT_TRACE`: name each function as its body is emitted.
        emit_trace: bool static => _get("GHUL_EMIT_TRACE")?

        /// `GHUL_CROSSING_TRACE`: trace the crossings at locations containing
        /// this text, where it is set.
        crossing_trace: string? static => _get("GHUL_CROSSING_TRACE")

        /// `GHUL_RETRY_STATS`: count compile-expressions retries.
        retry_stats: bool static => _get("GHUL_RETRY_STATS")?

        /// `GHUL_RETRY_STATS_LOG`: where to write the retry counts, where it
        /// is set.
        retry_stats_log: string? static => _get("GHUL_RETRY_STATS_LOG")

        /// `GHUL_NO_ITERATION_CLEAR`: keep compile state between
        /// compile-expressions iterations.
        no_iteration_clear: bool static => _get("GHUL_NO_ITERATION_CLEAR")?

        /// `GHUL_FUSION_LATE_DECLINE`: report each fused pipe stage restored
        /// after a late decline.
        fusion_late_decline: bool static => _get("GHUL_FUSION_LATE_DECLINE")?

        /// `GHUL_SOLVE_FILEWISE`: re-walk whole files rather than single
        /// bodies when the effect solve needs another round.
        solve_filewise: bool static => _get("GHUL_SOLVE_FILEWISE")?

        /// `GHUL_KILL_DUMP`: where to write the narrowing kills, where it is
        /// set.
        kill_dump: string? static => _get("GHUL_KILL_DUMP")
    si
si
