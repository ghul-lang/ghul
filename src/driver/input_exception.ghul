namespace Driver is
    use System.Exception

    // A fault in what the compiler was asked to compile rather than a fault in
    // the compiler: an input file that is not where the command line says it
    // is, and the like. The driver reports the message on its own, where a
    // failure inside the compiler is reported with its stack trace so that the
    // compiler can be debugged from it.
    @suppress("non-pascal-case-name")
    class INPUT_EXCEPTION(message: string): Exception is
        super(message)
    si
si
