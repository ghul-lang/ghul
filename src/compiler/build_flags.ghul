namespace Compiler is
    use IO.Std
    use Syntax.Process.EXPAND_NAMESPACES

    // Accessibility policy for underscore-prefixed declarations. LEGACY keeps
    // the historic emission (methods public, fields assembly, types public).
    // PRIVATE and PROTECTED both make underscore members and types invisible
    // outside the assembly; they differ only in whether a subclass in the same
    // assembly can see them.
    enum UnderscoreAccess is
        LEGACY, PRIVATE, PROTECTED
    si

    class GLOBAL_BUILD_FLAGS is
        is_valid: bool

        underscore_access: UnderscoreAccess public

        /// What the build produces, set by `--target`.
        target: Target public

        /// Where the wasm backend writes the text form of its module, set
        /// by `--wat`. Nothing is written where this is absent.
        wat_output: string? public

        /// The loader a wasm executable is written with, copied beside the
        /// module, set by `--wasm-loader`.
        wasm_loader: string? public

        /// Where the llvm backend writes the text form of its module, set by
        /// `--llvm-output`. The text is otherwise written only for linking,
        /// and deleted afterwards.
        llvm_output: string? public

        /// Whether the text form `--wat` writes carries a `;; file:line`
        /// comment before each statement's instructions, set by `--wat-lines`.
        want_wat_lines: bool public

        /// Whether the text form `--wat` writes holds only the functions
        /// compiled from the program's own sources, leaving out the
        /// source libraries' and the module's declarations, set by
        /// `--wat-program-only`.
        want_wat_program_only: bool public

        /// Whether the text form `--llvm-output` writes holds only the
        /// functions compiled from the program's own sources, leaving out the
        /// source libraries' functions and the module's types, globals and
        /// metadata, set by `--llvm-program-only`. The module linked is whole.
        want_llvm_program_only: bool public

        /// Whether a build for llvm that writes `--llvm-output` writes only
        /// that text and links nothing, set by `--llvm-no-link`.
        want_llvm_no_link: bool public

        /// Whether an llvm build links the collector that marks with several
        /// threads, set by `--llvm-parallel-gc`. Meant for the compiler's own
        /// native build: it costs a small program memory and speed.
        want_llvm_parallel_gc: bool public

        /// The version `--version` gives the program, as written, or null
        /// where none is given. A wasm or llvm program reads it through the
        /// `build.version` intrinsic.
        program_version: string? public

        /// The object files and archives an llvm build links beside the
        /// program, set by `--native-input`.
        native_inputs: Collections.LIST[string] public

        /// The libraries an llvm build links by name, set by
        /// `--native-library`. Each is searched for in the native library
        /// paths.
        native_libraries: Collections.LIST[string] public

        /// The directories searched for a native library, set by
        /// `--native-library-path`.
        native_library_paths: Collections.LIST[string] public

        /// Whether a build for a target compiled against the source core
        /// library describes its types for reflection, set by `--rtti`. On
        /// .NET the runtime describes every type already.
        want_rtti: bool public

        /// Whether a build that describes its types describes only the
        /// types marked `@reflected()` and those their descriptions reach,
        /// set by `--rtti-roots`.
        want_rtti_roots_only: bool public

        /// Whether the values a body compiles to record the source position
        /// they came from: for the debug information `--debug` writes, and
        /// for the comments `--wat-lines` prints.
        want_source_locations: bool => want_debug \/ want_wat_lines

        /// The source libraries `--library-source` declared, which say
        /// which library a source file belongs to.
        library_sources: Source.SOURCE_LIBRARIES? public

        _logger: Logging.Logger?

        want_analyse: bool public
        want_debug: bool public

        /// The optimisation level `--optimise` asked for, 0 to 3, or null
        /// where it was not given.
        optimisation_level: int? public

        /// The level an llvm build is optimised at: the one asked for, or 0
        /// for a debug build and 2 otherwise.
        llvm_optimisation_level: int =>
            optimisation_level ?? (if want_debug then 0 else 2 fi)
        want_declare_symbols: bool public
        want_compile_up_to_expressions: bool public
        want_compile_expressions: bool public
        want_executable: bool public
        // Set by `--library`: emit a DLL rather than an EXE, and
        // require no entry point.
        want_library: bool public
        want_assembler: bool public
        want_analysis_stats: bool public

        // The definite-return / definite-assignment / possible-null-
        // dereference / non-optional-by-default flow warnings are on
        // by default. Each `no_warn_*` getter consults the logger's
        // suppression set, populated by `--no-warn-*` and `--suppress`
        // CLI flags (both routes feed the same set).
        no_warn_definite_return: bool => _logger? /\ _logger.is_suppressed("definite-return")
        no_warn_definite_assignment: bool => _logger? /\ _logger.is_suppressed("definite-assignment")
        no_warn_field_definite_assignment: bool => _logger? /\ _logger.is_suppressed("field-definite-assignment")
        no_warn_non_optional: bool => _logger? /\ _logger.is_suppressed("non-optional")
        no_warn_impossible_cast: bool => _logger? /\ _logger.is_suppressed("impossible-cast")
        no_warn_cast_may_throw: bool => _logger? /\ _logger.is_suppressed("cast-may-throw")
        no_warn_narrowing_always_succeeds: bool => _logger? /\ _logger.is_suppressed("narrowing-always-succeeds")
        no_warn_irrefutable_destructure: bool => _logger? /\ _logger.is_suppressed("irrefutable-destructure")
        no_warn_likely_override_mismatch: bool => _logger? /\ _logger.is_suppressed("likely-override-mismatch")
        no_warn_redundant_unwrap: bool => _logger? /\ _logger.is_suppressed("redundant-unwrap")
        no_warn_impure_function_value: bool => _logger? /\ _logger.is_suppressed("impure-function-value")
        no_warn_impure_function_argument: bool => _logger? /\ _logger.is_suppressed("impure-function-argument")
        ignore_errors: bool public
        exclude_runtime_symbols: bool public

        // Lets a trait outside the core library require a static member,
        // for the compiler's own tests of the mechanism.
        allow_static_trait_members: bool public
        is_test_run: bool public

        // Report every diagnostic a pass makes, including ones that
        // repeat another exactly. On for a test run, and separately
        // available so a test of the analyser can ask for it.
        keep_duplicate_diagnostics: bool public

        // Emit diagnostics in MSBuild's canonical error format
        // (see the `--msbuild-diagnostics` driver flag). MSBuild parses
        // that shape and nothing else, so without it a build reports the
        // compiler's own diagnostics as untyped message text and counts
        // only the non-zero exit as an error.
        want_msbuild_diagnostics: bool public

        // Suppresses the analysis-mode heap watchdog's post-compile heap
        // sampling (see the `--no-analysis-heap-watchdog` driver flag). The
        // sampling forces a full GC after every compile; turning it off is
        // useful when profiling the analyser.
        no_analysis_heap_watchdog: bool public

        // Opts into the incremental body re-walk for interface-preserving
        // single-file EDITs. On by default; `--no-incremental-analysis`
        // turns it off.
        want_incremental_analysis: bool public

        // Seconds an analyser may sit with no request before exiting (see
        // `--analysis-idle-timeout`); 0 disables it. A warm analyser retains
        // the whole symbol table, so an editor window left open overnight
        // holds hundreds of megabytes to answer nothing; the cold rebuild
        // the next request pays is the cheaper side of that trade. Only
        // consulted in analysis mode, where the process is long-lived.
        analysis_idle_timeout_seconds: int public

        // Aggregates definitions outside any namespace into a single unnamed
        // global namespace shared across every file, rather than the default
        // per-file private namespace (see `--global-namespace`). Off by
        // default, so each file's global definitions stay file-private.
        want_global_namespace: bool public

        // Turns whole-file inference off: a file-level function written
        // without types in its signature is an error in every file, rather
        // than having its signature inferred from the file's uses of it
        // (see `--no-whole-file-inference`).
        no_whole_file_inference: bool public

        // The name of the namespace a file with no namespace of its own
        // is given, in place of one derived from the file's path, and
        // the mark of a submission: one step of an interactive session,
        // compiled as a library whose entry returns the value of its
        // final expression (see `--submission`). Null otherwise.
        submission_name: string? public

        // Whether every file with no namespace of its own is a cell of a
        // session built as one program (see `--cells`): its namespace is
        // its file name, its top-level statements are an entry that returns
        // the value of its final expression, and it is never the program's
        // entry point.
        want_cells: bool public

        // Whether a namespace-less file is one step of a session, a
        // submission or a cell: its entry returns its final expression's
        // value, and a top-level `let` may read the earlier step's variable
        // of the same name.
        is_session_step: bool => submission_name? \/ want_cells

        // Whether the build is a session whose code is kept across cells
        // (see `--session`): cells as `--cells` builds them, plus the
        // semantics a retained cell needs, because a later cell can
        // subclass or override against what an earlier cell was compiled
        // to. Implies `want_cells`.
        want_session: bool public

        // Whether the build is one cell of a session whose cells are separate
        // objects loaded into one running process (see `--cell-link`): the
        // cell's own definitions are exported for later cells, the cells
        // before it are type-checked and declared but not emitted, and its
        // entry is the only one that runs. Implies `want_session`.
        want_cell_link: bool public

        // How many of the session's cells, counting from the first given, are
        // earlier cells whose code is already loaded. Meaningful with
        // `want_cell_link`.
        previous_cells: int public

        // Whether the file is a cell of a cell-linked build that is not an
        // earlier one: the cell being compiled, whose entry the host runs.
        is_current_cell(file_name: string) -> bool is
            if !want_cell_link then
                return false
            fi

            if let at = session_cell_at(file_name) then
                return at >= previous_cells
            fi

            return false
        si

        // Whether the file is one of the earlier cells of a cell-linked
        // build, whose definitions are declared here and defined where the
        // cell was compiled.
        is_previous_cell(file_name: string) -> bool is
            if !want_cell_link then
                return false
            fi

            if let at = session_cell_at(file_name) then
                return at < previous_cells
            fi

            return false
        si

        // Whether the build compiles its code against a hierarchy a later
        // step of the same session can extend: a submission, which a later
        // step subclasses through an assembly reference, or a session,
        // whose cells keep their emitted code while later cells add to the
        // hierarchy. The narrow guards, the complement singletons they
        // read, and the exhaustive-`case` throw key on this; an ordinary
        // build knows every alternative and emits none of them.
        wants_session_guards: bool => submission_name? \/ want_session

        // The cells of a session, in the order they were given: the file
        // stems of the namespace-less files, as `--cells` and `--session`
        // name their namespaces. A cell's code was written against the
        // cells before it, so a decision keyed on a closed hierarchy - a
        // narrowing complement, a case's coverage - is made over the
        // alternatives the cells up to that point declare, and the guards
        // carry what a later cell adds. Empty in an ordinary build.
        session_cell_names: Collections.LIST[string] public

        // A file's place among the session's cells, by its name: the
        // zero-based position of its stem in `session_cell_names`, or null
        // when the file is not a cell. A file that is not a cell - the
        // host's own entry, a namespaced file - is compiled with the whole
        // session in view, so its readers treat null as "sees everything".
        session_cell_at(file_name: string) -> int? is
            let stem = IO.Path.get_file_name_without_extension(file_name)

            if !stem? then
                return null
            fi

            // The registry holds namespace names, which spell a file's
            // stem as an identifier the way expand_namespaces does; the
            // same conversion here, or a stem carrying '-' or '.' looks
            // like no cell at all and the view fails open.
            let name = EXPAND_NAMESPACES.convert_file_name_to_identifier(stem)

            let flags = IoC.CONTAINER.instance.build_flags

            for i in 0..flags.session_cell_names.count do
                if flags.session_cell_names[i] =~ name then
                    return i
                fi
            od

            return null
        si

        // The imports `use default` stands for, when the project names
        // its own set with `--default-use`. Empty leaves the curated set
        // in `DEFAULT_USES` in force.
        default_uses: Collections.LIST[string] public

        // Gives every file with no namespace of its own an implicit
        // `use default`, as if the file had written it first (see
        // `--implicit-default-use`). A script run directly wants this;
        // a project, whose files choose their own imports, does not.
        want_implicit_default_use: bool public

        // Default idle timeout, in seconds. Long enough that a user stepping
        // away from an editor and coming back rarely pays the cold rebuild,
        // short enough that an abandoned window gives its memory back within
        // the hour.
        default_analysis_idle_timeout_seconds: int static => 1800

        init() is
            underscore_access = UnderscoreAccess.PRIVATE
            target = Target.DOTNET
            analysis_idle_timeout_seconds = default_analysis_idle_timeout_seconds
            want_incremental_analysis = true
            default_uses = Collections.LIST[string]()
            session_cell_names = Collections.LIST[string]()
            native_inputs = Collections.LIST[string]()
            native_libraries = Collections.LIST[string]()
            native_library_paths = Collections.LIST[string]()
        si

        set_logger(logger: Logging.Logger) is
            _logger = logger
        si

        mark_valid() is
            is_valid = true
        si

        check_valid() is
            assert is_valid else "build flags accessed before being set"
        si
    si
si
