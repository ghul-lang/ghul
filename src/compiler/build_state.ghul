namespace Compiler is
    // The state the compiler keeps outside its container, for a process that
    // runs one build after another: each build must see none of what the
    // last one left, and number what it synthesises from the start, so that
    // it compiles exactly what a process of its own would.
    class BUILD_STATE is
        reset() static is
            IoC.CONTAINER.reset()

            Semantic.Symbols.Symbol.reset_ids()
            Semantic.Symbols.FRAME.reset_ids()
            Semantic.Symbols.STATE_MACHINE_FRAME.reset_ids()
            Semantic.Symbols.ASYNC_STATE_MACHINE_FRAME.reset_ids()
            Syntax.Process.COMPILE_EXPRESSIONS.reset_local_ids()

            Semantic.Types.NAMED.clear_cache()
            Semantic.KNOWN_MEMBERS.clear_cache()
            Semantic.INJECTED_MEMBERS.clear()
            Semantic.HIDEABLE_MEMBERS.clear()
            Semantic.Symbols.STORE_FREE_BITS.clear()
            Syntax.Process.EFFECTS.clear()
            Syntax.Process.MONOTONE_MEMOISER.clear()
            Syntax.Process.SYNTHESISE_TOP_LEVEL_ENTRY.clear()
            IR.LLVMTarget.EXTERN_SYMBOLS.clear()
        si
    si
si
