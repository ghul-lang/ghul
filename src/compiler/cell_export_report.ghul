namespace Compiler is
    use Collections.LIST
    use Semantic.Symbols

    // The report a --cells or --session build writes beside its output,
    // as JSON: one entry a cell, its namespace name and the names a
    // later cell can import from it.
    class CELL_EXPORTS(cells: LIST[CELL_EXPORT] public)

    // One cell's exportable names.
    class CELL_EXPORT(cell: string public, exports: LIST[string] public)

    // What a --cells or --session build tells the session host about each
    // cell: the names a later cell can import. The .NET host reads these
    // off each cell's assembly; a host with no assemblies to read - a
    // wasm engine, a browser - has the compiler report them instead. The
    // shape is the manifest's, so the manifest can carry the same fields
    // when it exists.
    class CELL_EXPORT_REPORT is
        // The report for the cells this build registered: for each cell
        // namespace, the names a later cell can write after `use cellK.` -
        // the types declared directly in the namespace, the global
        // functions and the global variables. Public names always;
        // underscore names too, since a later cell of the same session
        // reaches them as a later part of one file could. The entry a
        // host calls itself is left out, and so is anything the compiler
        // generated: a `$` in a name marks it.
        build(symbol_table: Semantic.SYMBOL_TABLE, cell_names: LIST[string]) -> CELL_EXPORTS static is
            let cells = LIST[CELL_EXPORT]()

            for name in cell_names do
                let cell = cast NAMESPACE?(symbol_table.global_scope.find_direct(name))

                if !cell? then
                    continue
                fi

                let exports = LIST[string]()

                for symbol in cell.symbols do
                    // The cell's global functions and variables sit in
                    // the synthesised `$globals` class rather than the
                    // namespace itself, so its members are the cell's as
                    // much as the namespace's own symbols are.
                    if isa Classy(symbol) /\ symbol.name =~ "$globals" then
                        for member in (cast Classy(symbol)).symbols do
                            if _is_export(member) then
                                _add_once(exports, member.name)
                            fi
                        od
                    elif _is_export(symbol) then
                        _add_once(exports, symbol.name)
                    fi
                od

                exports.sort((a: string, b: string) -> int => string.compare_ordinal(a, b))

                cells.add(CELL_EXPORT(name, exports))
            od

            return CELL_EXPORTS(cells)
        si

        _is_export(symbol: Symbol) -> bool static is
            if symbol.name.length == 0 \/
                symbol.name.contains('$') \/
                symbol.name =~ "entry" \/
                symbol.name =~ "_entry"
            then
                return false
            fi

            if isa GLOBAL_FUNCTION(symbol) then
                return true
            fi

            if isa GLOBAL_VARIABLE(symbol) then
                return true
            fi

            // A name overloaded across arities or argument types is one
            // import: the groups hold the declarations, the name is
            // what a later cell writes.
            if isa TYPE_GROUP(symbol) then
                return true
            fi

            if isa FUNCTION_GROUP(symbol) then
                return true
            fi

            // Types reach a later cell by name; a union's variants sit in
            // the union's own scope and do not appear here, and a nested
            // namespace is not something `use cellK.name` imports.
            return isa Classy(symbol)
        si

        _add_once(exports: LIST[string], name: string) static is
            if !exports.contains(name) then
                exports.add(name)
            fi
        si

        // The report as JSON, written directly: the shape is fixed and
        // small, and a protocol writer that reflects over .NET types has
        // no counterpart on the targets whose hosts need this file most.
        // Cell names are identifiers and export names are user names, so
        // the only escapes a name can carry are quote and backslash.
        write(report: CELL_EXPORTS) -> string static is
            let text = Text.STRING_BUILDER()

            text.append("{{\"cells\":[")

            for i in 0..report.cells.count do
                if i > 0 then
                    text.append(',')
                fi

                let cell = report.cells[i]

                text.append("{{\"cell\":")
                _append_string(text, cell.cell)
                text.append(",\"exports\":[")

                for j in 0..cell.exports.count do
                    if j > 0 then
                        text.append(',')
                    fi

                    _append_string(text, cell.exports[j])
                od

                text.append("]}}")
            od

            text.append("]}}")

            return text.to_string()
        si

        _append_string(text: Text.STRING_BUILDER, value: string) static is
            text.append('"')

            for c in value do
                if c == '\"' then
                    text.append("\\\"")
                elif c == '\\' then
                    text.append("\\\\")
                elif c < ' ' then
                    _append_escaped(text, c)
                else
                    text.append(c)
                fi
            od

            text.append('"')
        si

        _append_escaped(text: Text.STRING_BUILDER, c: char) static is
            let hex = "0123456789abcdef"
            let code = cast int(c)

            text.append('\\')
            text.append('u')
            text.append(hex[code >> 12 & 0xF])
            text.append(hex[code >> 8 & 0xF])
            text.append(hex[code >> 4 & 0xF])
            text.append(hex[code & 0xF])
        si
    si
si
