namespace Compiler is
    // Which function a build's program starts in: the name `--entry`
    // asks for, or the default, and whether one was found.
    class ENTRY_POINT is
        name: string public

        // Whether `--entry` named it. A build that asks for an entry point
        // by name does not want a file's top-level statements instead, so
        // the synthesised entry stops being a candidate when this is set.
        name_is_explicit: bool public

        seen: bool public

        init(name: string) is
            self.name = name
        si
    si
si
