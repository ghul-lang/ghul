namespace Compiler is
    use Collections.LIST
    use Collections.List

    // The imports `use default` stands for. A file that opens with it
    // gets these as if it had written them out, in this order.
    //
    // The set is what a program reaches for before it reaches for
    // anything specific: writing a line, the sequence combinators, the
    // collections, the number theory functions and the function
    // combinators. Everything else stays an explicit import, so the clause
    // keeps meaning something a reader can hold in their head.
    //
    // A name in this set that the referenced runtime doesn't define is
    // skipped, so a runtime older than the set still builds.
    //
    // A project that wants a different set replaces this one with
    // `--default-use`, one per name.
    class DEFAULT_USES is
        _curated: string[] static

        init() static is
            _curated = LIST[string](["IO.Std.write_line", "Ghul.Pipes", "Collections", "Ghul.Numerics", "Ghul.Functional"])
        si

        // The names in force: the project's own set when it declared one,
        // and the curated set otherwise.
        names(flags: GLOBAL_BUILD_FLAGS) -> string[] static =>
            if flags.default_uses.count > 0 then flags.default_uses else _curated fi

        // Whether a name in force that isn't defined is an error: it is
        // when the project chose the set itself.
        is_declared(flags: GLOBAL_BUILD_FLAGS) -> bool static =>
            flags.default_uses.count > 0

        // What the curated set would be, for a project that declares no
        // set of its own.
        curated: string[] static => _curated
    si
si
