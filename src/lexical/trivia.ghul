namespace Lexical is
    use Source

    // A piece of non-token source content the parser discards but the
    // formatter must preserve: a comment, or a run of blank lines collapsed
    // to a single marker. The tokenizer collects these in source order so
    // the formatter can interleave them back into the printed AST by
    // comparing locations.
    union TRIVIA(location: LOCATION) is
        LINE_COMMENT(text: string, ..)
        DOC_COMMENT(text: string, ..)
        BLOCK_COMMENT(text: string, ..)
        BLANK_LINE(..)
        SHEBANG(text: string, ..)
        // Where adjacent string literals were chained into one token: the
        // literal's value up to `offset` characters came from the fragments
        // before this point, and `on_new_line` says whether the next
        // fragment started a line of its own.
        STRING_BREAK(offset: int, on_new_line: bool, ..)
        // Where a numeric literal was written with a `_` digit separator:
        // the literal's text up to `offset` characters came before it.
        DIGIT_SEPARATOR(offset: int, ..)
    si
si
