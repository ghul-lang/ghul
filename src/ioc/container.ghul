namespace IoC is
    use IO.Std

    use Syntax
    use Parsers.LAZY_PARSER

    class CONTAINER is
        _instance: CONTAINER? static

        instance: CONTAINER static is
            let result = _instance ?? CONTAINER()

            _instance = result

            return result
        si

        logger: Logging.Logger
        logger_formatter: Logging.DiagnosticFormatter
        logger_writer: IO.TextWriter

        timers: Logging.TIMERS
        watchdog: Analysis.WATCHDOG

        path_config: Driver.PATH_CONFIG
        build_flags: Compiler.GLOBAL_BUILD_FLAGS

        location_stack: Source.LOCATION_STACK

        precedence_map: Collections.MutableMap[string,Syntax.Parsers.Expressions.PRECEDENCE]
        pragma_precedence: Syntax.Parsers.Definitions.PRAGMA_PRECEDENCE
        identifier_parser: Syntax.Parsers.Parser[Trees.Identifiers.Identifier]
        identifier_qualified_parser: Syntax.Parsers.Parser[Trees.Identifiers.Identifier]
        identifier_function_name_parser: Syntax.Parsers.Parser[Trees.Identifiers.Identifier]
        modifier_parser: Syntax.Parsers.Parser[Trees.Modifiers.Modifier]
        type_parser: LAZY_PARSER[Trees.TypeExpressions.TypeExpression]
        type_list_parser: LAZY_PARSER[Trees.TypeExpressions.LIST]
        variable_parser: LAZY_PARSER[Trees.Variables.VARIABLE]
        variable_list_parser: LAZY_PARSER[Trees.Variables.LIST]
        variable_destructure_left_parser: LAZY_PARSER[Trees.Variables.DESTRUCTURING_VARIABLE_LEFT]
        modifier_list_parser: LAZY_PARSER[Trees.Modifiers.LIST]
        definition_parser: LAZY_PARSER[Trees.Definitions.Definition]
        definition_global_list_parser: LAZY_PARSER[Trees.Definitions.LIST]
        definition_member_list_parser: LAZY_PARSER[Trees.Definitions.LIST]
        definition_namespace_parser: LAZY_PARSER[Trees.Definitions.NAMESPACE]
        definition_class_parser: LAZY_PARSER[Trees.Definitions.CLASS]
        definition_use_parser: LAZY_PARSER[Trees.Definitions.USE]
        definition_trait_parser: LAZY_PARSER[Trees.Definitions.TRAIT]
        definition_struct_parser: LAZY_PARSER[Trees.Definitions.STRUCT]
        definition_partial_parser: LAZY_PARSER[Trees.Definitions.PARTIAL]
        definition_impl_parser: LAZY_PARSER[Trees.Definitions.IMPL]
        definition_union_parser: LAZY_PARSER[Trees.Definitions.UNION]
        definition_variant_parser: LAZY_PARSER[Trees.Definitions.VARIANT]
        definition_variant_list_parser: LAZY_PARSER[Trees.Definitions.LIST]
        definition_enum_parser: LAZY_PARSER[Trees.Definitions.ENUM]
        definition_member_parser: LAZY_PARSER[Trees.Definitions.Definition]
        definition_function_parser: LAZY_PARSER[Trees.Definitions.FUNCTION]
        definition_property_parser: LAZY_PARSER[Trees.Definitions.PROPERTY]
        definition_indexer_parser: LAZY_PARSER[Trees.Definitions.INDEXER]
        definition_pragma_parser: LAZY_PARSER[Trees.Definitions.PRAGMA]
        definition_super_call_parser: LAZY_PARSER[Trees.Definitions.SUPER_CALL]
        pragma_node_parser: LAZY_PARSER[Trees.Pragmas.PRAGMA]
        expression_parser: LAZY_PARSER[Trees.Expressions.Expression]
        expression_list_parser: LAZY_PARSER[Trees.Expressions.LIST]
        expression_primary_parser: LAZY_PARSER[Trees.Expressions.Expression]
        expression_secondary_parser: LAZY_PARSER[Trees.Expressions.Expression]
        expression_tertiary_parser: LAZY_PARSER[Trees.Expressions.Expression]
        expression_tuple_parser: LAZY_PARSER[Trees.Expressions.Expression]
        statement_parser: LAZY_PARSER[Trees.Statements.Statement]
        statement_list_parser: LAZY_PARSER[Trees.Statements.LIST]
        paren_statement_list_parser: LAZY_PARSER[Trees.Statements.LIST]
        statement_pragma_parser: LAZY_PARSER[Trees.Statements.PRAGMA]
        body_parser: LAZY_PARSER[Trees.Bodies.Body]

        type_details_lookup: Semantic.DotNet.TYPE_DETAILS_LOOKUP

        ghul_namespace_creator: Semantic.DotNet.GHUL_NAMESPACE_CREATOR
        referenced_assemblies: Semantic.DotNet.REFERENCED_ASSEMBLIES
        assembly_info: Semantic.DotNet.ASSEMBLY_INFO

        dotnet_symbol_table: System.Lazy[Semantic.DotNet.SYMBOL_TABLE]
        symbol_factory: Semantic.DotNet.SYMBOL_FACTORY
        type_mapper: Semantic.DotNet.TYPE_MAPPER
        type_name_map: Semantic.DotNet.TYPE_NAME_MAP
        assemblies: Semantic.DotNet.ASSEMBLIES

        // Empty, and never added to, outside submission mode.
        complement_singletons: Semantic.Types.COMPLEMENT_SINGLETONS

        symbol_table: Semantic.SYMBOL_TABLE
        namespaces: Semantic.NAMESPACES
        symbol_loader: Semantic.SYMBOL_LOADER
        innate_symbol_lookup: Semantic.Lookups.InnateSymbolLookup
        function_caller: Semantic.FUNCTION_CALLER
        overload_resolver: Semantic.OVERLOAD_RESOLVER
        conversion_lookup: Semantic.USER_DEFINED_CONVERSION_LOOKUP
        type_caster: Semantic.TYPE_CASTER
        task_conversion: Semantic.TASK_CONVERSION

        symbol_use_locations: Semantic.SYMBOL_USE_LOCATIONS
        symbol_definition_locations: Semantic.SYMBOL_DEFINITION_LOCATIONS

        state_store_registry: Syntax.Process.STATE_STORE_REGISTRY
        variable_left_state: Syntax.Process.VARIABLE_LEFT_STATE_STORE
        composite_spill_state: Syntax.Process.COMPOSITE_SPILL_STORE

        value_boxer: IR.VALUE_BOXER
        value_converter: IR.VALUE_CONVERTER
        block_stack: IR.BLOCK_STACK
        entry_point: Compiler.ENTRY_POINT
        cil_context: IR.Emitter.CIL_CONTEXT
        innate_operation_generator: IR.INNATE_OPERATION_GENERATOR
        local_id_generator: IR.LOCAL_ID_GENERATOR

        name_display: Semantic.NAME_DISPLAY

        type_parameter_positions: Semantic.Symbols.TYPE_PARAMETER_POSITIONS

        conditional_compilation: Syntax.Process.CONDITIONAL_COMPILATION
        rewrite_primary_constructors: Syntax.Process.REWRITE_PRIMARY_CONSTRUCTORS
        synthesise_top_level_entry: Syntax.Process.SYNTHESISE_TOP_LEVEL_ENTRY
        synthesise_entry_environment_wrapper: Syntax.Process.SYNTHESISE_ENTRY_ENVIRONMENT_WRAPPER
        expand_namespaces: Syntax.Process.EXPAND_NAMESPACES
        add_accessors_for_properties: Syntax.Process.ADD_ACCESSORS_FOR_PROPERTIES
        spill_awaits: Syntax.Process.SPILL_AWAITS
        collect_suppress_pragmas: Syntax.Process.COLLECT_SUPPRESS_PRAGMAS
        collect_modifier_keyword_locations: Syntax.Process.COLLECT_MODIFIER_KEYWORD_LOCATIONS
        check_name_conventions: Syntax.Process.CHECK_NAME_CONVENTIONS
        definition_virtuality: Syntax.Process.DEFINITION_VIRTUALITY
        select_entry_point: Syntax.Process.SELECT_ENTRY_POINT
        declare_symbols: Syntax.Process.DECLARE_SYMBOLS
        declare_members: Syntax.Process.DECLARE_MEMBERS
        resolve_uses: Syntax.Process.RESOLVE_USES
        resolve_member_uses: Syntax.Process.RESOLVE_USES
        resolve_ancestors: Syntax.Process.RESOLVE_ANCESTORS
        resolve_type_expressions: Syntax.Process.RESOLVE_TYPE_EXPRESSIONS
        resolve_explicit_types: Syntax.Process.RESOLVE_EXPLICIT_TYPES
        synthesize_class_equality: Syntax.Process.SYNTHESIZE_CLASS_EQUALITY
        synthesize_iterator_reset: Syntax.Process.SYNTHESIZE_ITERATOR_RESET
        check_type_argument_bounds: Syntax.Process.CHECK_TYPE_ARGUMENT_BOUNDS
        compile_expressions: Syntax.Process.COMPILE_EXPRESSIONS
        resolve_overrides: Syntax.Process.RESOLVE_OVERRIDES
        infer_store_free: Syntax.Process.INFER_STORE_FREE
        check_pure_overrides: Syntax.Process.CHECK_PURE_OVERRIDES
        verify_compile_state: Syntax.Process.VERIFY_COMPILE_STATE
        register_source_intrinsics: Syntax.Process.REGISTER_SOURCE_INTRINSICS
        record_type_argument_uses: Syntax.Process.RECORD_TYPE_ARGUMENT_USES
        mark_boxed_locals: Syntax.Process.MARK_BOXED_LOCALS
        generate_il: Syntax.Process.GENERATE_IL

        ghul_printer: Syntax.Process.Printer.GHUL => Syntax.Process.Printer.GHUL()

        completer: Syntax.Process.COMPLETER
        signature_help: Syntax.Process.SIGNATURE_HELP

        init() is
            Source.LOCATION.init_static()

            logger = Logging.DIAGNOSTICS_STORE()

            want_human_readable_logger(Std.error)

            timers = Logging.TIMERS()
            watchdog = Analysis.WATCHDOG()

            path_config = Driver.PATH_CONFIG()
            build_flags = Compiler.GLOBAL_BUILD_FLAGS()
            build_flags.set_logger(logger)

            location_stack = Source.LOCATION_STACK()

            value_boxer = IR.VALUE_BOXER(logger)

            entry_point = Compiler.ENTRY_POINT("entry")
            cil_context = IR.Emitter.CIL_CONTEXT(logger)
            block_stack = IR.BLOCK_STACK()
            innate_operation_generator = IR.INNATE_OPERATION_GENERATOR(logger, value_boxer)
            local_id_generator = IR.LOCAL_ID_GENERATOR()

            name_display = Semantic.NAME_DISPLAY()

            type_parameter_positions = Semantic.Symbols.TYPE_PARAMETER_POSITIONS()

            precedence_map = Collections.MAP[string,Syntax.Parsers.Expressions.PRECEDENCE]()

            pragma_precedence = Parsers.Definitions.PRAGMA_PRECEDENCE()

            identifier_parser = Parsers.Identifiers.IDENTIFIER()
            identifier_qualified_parser = Parsers.Identifiers.QUALIFIED()
            identifier_function_name_parser = Parsers.Identifiers.FUNCTION_NAME()
            modifier_parser = Parsers.Modifiers.MODIFIER()
            type_parser = LAZY_PARSER()
            type_list_parser = LAZY_PARSER()
            variable_parser = LAZY_PARSER()
            variable_list_parser = LAZY_PARSER()
            variable_destructure_left_parser = LAZY_PARSER()
            modifier_list_parser = LAZY_PARSER()
            definition_parser = LAZY_PARSER()
            definition_global_list_parser = LAZY_PARSER()
            definition_member_list_parser = LAZY_PARSER()
            definition_namespace_parser = LAZY_PARSER()
            definition_use_parser = LAZY_PARSER()
            definition_class_parser = LAZY_PARSER()
            definition_trait_parser = LAZY_PARSER()
            definition_struct_parser = LAZY_PARSER()
            definition_partial_parser = LAZY_PARSER()
            definition_impl_parser = LAZY_PARSER()
            definition_union_parser = LAZY_PARSER()
            definition_variant_parser = LAZY_PARSER()
            definition_variant_list_parser = LAZY_PARSER()
            definition_enum_parser = LAZY_PARSER()
            definition_member_parser = LAZY_PARSER()
            definition_function_parser = LAZY_PARSER()
            definition_property_parser = LAZY_PARSER()
            definition_indexer_parser = LAZY_PARSER()
            definition_pragma_parser = LAZY_PARSER()
            definition_super_call_parser = LAZY_PARSER()
            pragma_node_parser = LAZY_PARSER()
            expression_parser = LAZY_PARSER()
            expression_list_parser = LAZY_PARSER()
            expression_primary_parser = LAZY_PARSER()
            expression_secondary_parser = LAZY_PARSER()
            expression_tertiary_parser = LAZY_PARSER()
            expression_tuple_parser = LAZY_PARSER()
            statement_parser = LAZY_PARSER()
            statement_list_parser = LAZY_PARSER()
            paren_statement_list_parser = LAZY_PARSER()
            statement_pragma_parser = LAZY_PARSER()
            body_parser = LAZY_PARSER()

            type_parser.create = () =>
                Parsers.TypeExpressions.PRIMARY_TYPE_EXPRESSION(identifier_parser, identifier_qualified_parser, type_list_parser)

            type_list_parser.create = () =>
                Parsers.TypeExpressions.LIST(type_parser)

            variable_parser.create = () =>
                Parsers.Variables.VARIABLE(
                    identifier_parser,
                    variable_destructure_left_parser,
                    type_parser,
                    expression_parser,
                    modifier_list_parser,
                    pragma_node_parser)

            variable_list_parser.create = () =>
                Parsers.Variables.LIST(variable_parser)

            variable_destructure_left_parser.create = () =>
                Parsers.Variables.DESTRUCTURING_VARIABLE_LEFT(identifier_parser, identifier_qualified_parser, type_parser)

            modifier_list_parser.create = () =>
                Parsers.Modifiers.LIST(modifier_parser)

            definition_parser.create = () =>
                Parsers.Definitions.DEFINITION(
                    definition_namespace_parser,
                    definition_use_parser,
                    definition_class_parser,
                    definition_trait_parser,
                    definition_struct_parser,
                    definition_partial_parser,
                    definition_impl_parser,
                    definition_union_parser,
                    definition_enum_parser,
                    definition_member_parser,
                    definition_pragma_parser
                )

            definition_global_list_parser.create = () =>
                Parsers.Definitions.GLOBAL_LIST(pragma_node_parser, definition_parser, statement_parser, precedence_map, pragma_precedence)

            definition_member_list_parser.create = () =>
                Parsers.Definitions.MEMBER_LIST(definition_member_parser)

            definition_namespace_parser.create = () =>
                Parsers.Definitions.NAMESPACE(identifier_qualified_parser, definition_global_list_parser)

            definition_use_parser.create = () =>
                Parsers.Definitions.USE(identifier_qualified_parser, type_parser, type_list_parser)

            definition_class_parser.create = () =>
                Parsers.Definitions.CLASS(
                    identifier_parser,
                    type_parser,
                    type_list_parser,
                    modifier_list_parser,
                    variable_list_parser,
                    definition_member_list_parser
                )

            definition_trait_parser.create = () =>
                Parsers.Definitions.TRAIT(
                    identifier_parser,
                    type_parser,
                    type_list_parser,
                    modifier_list_parser,
                    definition_member_list_parser
                )

            definition_partial_parser.create = () =>
                Parsers.Definitions.PARTIAL(
                    identifier_qualified_parser,
                    type_list_parser,
                    modifier_list_parser,
                    definition_member_list_parser
                )

            definition_impl_parser.create = () =>
                Parsers.Definitions.IMPL(
                    identifier_qualified_parser,
                    type_parser,
                    type_list_parser,
                    modifier_list_parser,
                    definition_member_list_parser
                )

            definition_union_parser.create = () =>
                Parsers.Definitions.UNION(
                    identifier_parser,
                    type_parser,
                    type_list_parser,
                    modifier_list_parser,
                    variable_list_parser,
                    definition_variant_list_parser
                )

            definition_variant_parser.create = () =>
                Parsers.Definitions.VARIANT(
                    identifier_parser,
                    variable_list_parser,
                    modifier_list_parser
                )

            definition_variant_list_parser.create = () =>
                Parsers.Definitions.VARIANT_LIST(definition_variant_parser)

            definition_struct_parser.create = () =>
                Parsers.Definitions.STRUCT(
                    identifier_parser,
                    type_parser,
                    type_list_parser,
                    modifier_list_parser,
                    variable_list_parser,
                    definition_member_list_parser
                )

            definition_enum_parser.create = () =>
                Parsers.Definitions.ENUM(identifier_parser, modifier_list_parser, expression_parser)

            definition_member_parser.create = () =>
                Parsers.Definitions.MEMBER(
                    definition_function_parser,
                    definition_property_parser,
                    definition_indexer_parser,
                    definition_pragma_parser,
                    definition_super_call_parser
                )

            definition_super_call_parser.create = () =>
                Parsers.Definitions.SUPER_CALL(expression_parser)

            definition_function_parser.create = () =>
                Parsers.Definitions.FUNCTION(
                    identifier_function_name_parser,
                    type_parser,
                    type_list_parser,
                    modifier_list_parser,
                    body_parser,
                    variable_list_parser
                )

            definition_property_parser.create = () =>
                Parsers.Definitions.PROPERTY(
                    identifier_parser,
                    type_parser,
                    modifier_list_parser,
                    body_parser
                )

            definition_indexer_parser.create = () =>
                Parsers.Definitions.INDEXER(
                    identifier_parser,
                    type_parser,
                    modifier_list_parser,
                    variable_parser,
                    body_parser
                )

            definition_pragma_parser.create = () =>
                Parsers.Definitions.PRAGMA(pragma_node_parser, definition_parser, precedence_map, pragma_precedence)

            pragma_node_parser.create = () =>
                Parsers.Pragmas.PRAGMA(identifier_qualified_parser, expression_parser)

            expression_parser.create = () =>
                Parsers.Expressions.EXPRESSION(expression_tertiary_parser, expression_secondary_parser, precedence_map)

            expression_list_parser.create = () =>
                Parsers.Expressions.LIST(expression_parser)

            expression_primary_parser.create = () =>
                Parsers.Expressions.PRIMARY(
                    identifier_parser,
                    type_parser,
                    expression_parser,
                    expression_list_parser,
                    expression_tuple_parser,
                    statement_parser,
                    statement_list_parser,
                    variable_list_parser,
                    pragma_node_parser,
                    variable_parser
                )

            expression_secondary_parser.create = () =>
                Parsers.Expressions.SECONDARY(
                    identifier_parser,
                    type_parser,
                    type_list_parser,
                    expression_parser,
                    expression_primary_parser,
                    expression_list_parser,
                    body_parser
                )

            expression_tertiary_parser.create = () =>
                Parsers.Expressions.TERTIARY(
                    expression_secondary_parser
                )

            expression_tuple_parser.create = () =>
                Parsers.Expressions.TUPLE(
                    expression_list_parser,
                    type_parser,
                    expression_parser,
                    paren_statement_list_parser
                )

            paren_statement_list_parser.create = () =>
                Parsers.Statements.LIST(
                    Collections.LIST([
                        Lexical.TOKEN.PAREN_CLOSE,
                        Lexical.TOKEN.ELSE,
                        Lexical.TOKEN.ELIF,
                        Lexical.TOKEN.FI,
                        Lexical.TOKEN.OD,
                        Lexical.TOKEN.CATCH,
                        Lexical.TOKEN.FINALLY,
                        Lexical.TOKEN.YRT,
                        Lexical.TOKEN.WHEN,
                        Lexical.TOKEN.ESAC,
                        Lexical.TOKEN.LAV,
                        Lexical.TOKEN.SI,
                        Lexical.TOKEN.COMMA
                    ]),
                    statement_parser
                )

            statement_parser.create = () =>
                Parsers.Statements.STATEMENT(
                    Collections.LIST([Lexical.TOKEN.FOR, Lexical.TOKEN.WHILE, Lexical.TOKEN.DO]),
                    identifier_parser,
                    expression_parser,
                    expression_list_parser,
                    variable_parser,
                    variable_list_parser,
                    statement_list_parser,
                    statement_pragma_parser
                )

            statement_list_parser.create = () =>
                Parsers.Statements.LIST(
                    Collections.LIST([
                        Lexical.TOKEN.ELSE,
                        Lexical.TOKEN.ELIF,
                        Lexical.TOKEN.FI,
                        Lexical.TOKEN.OD,
                        Lexical.TOKEN.CATCH,
                        Lexical.TOKEN.FINALLY,
                        Lexical.TOKEN.YRT,
                        Lexical.TOKEN.WHEN,
                        Lexical.TOKEN.ESAC,
                        Lexical.TOKEN.LAV,
                        Lexical.TOKEN.SI,
                        Lexical.TOKEN.COMMA
                    ]),
                    statement_parser
                )

            statement_pragma_parser.create = () =>
                Parsers.Statements.PRAGMA(pragma_node_parser, statement_parser)

            body_parser.create = () =>
                Parsers.Bodies.BODY(
                    expression_parser,
                    statement_parser,
                    statement_list_parser,
                    identifier_qualified_parser)

            type_details_lookup = Semantic.DotNet.TYPE_DETAILS_LOOKUP()

            symbol_table = Semantic.SYMBOL_TABLE(logger)
            namespaces = Semantic.NAMESPACES(logger, symbol_table)

            ghul_namespace_creator = Semantic.DotNet.GHUL_NAMESPACE_CREATOR(timers, symbol_table, namespaces, type_details_lookup)

            dotnet_symbol_table =
                System.Lazy[Semantic.DotNet.SYMBOL_TABLE](
                    () =>
                        Semantic.DotNet.SYMBOL_TABLE(type_details_lookup, symbol_factory)
                )

            type_name_map = Semantic.DotNet.TYPE_NAME_MAP(build_flags, type_details_lookup)

            complement_singletons = Semantic.Types.COMPLEMENT_SINGLETONS()

            assemblies = Semantic.DotNet.ASSEMBLIES(
                timers,
                build_flags,
                path_config,
                symbol_table,
                namespaces,
                type_name_map,
                type_details_lookup
            )

            referenced_assemblies = Semantic.DotNet.REFERENCED_ASSEMBLIES(name => assemblies.version_of(name), name => assemblies.public_key_token_of(name))

            innate_symbol_lookup = Semantic.Lookups.LAZY_INNATE_SYMBOL_LOOKUP(
                () =>
                    Semantic.Lookups.REFLECTION_INNATE_SYMBOL_LOOKUP(
                        type_mapper,
                        dotnet_symbol_table.value,
                        Semantic.Lookups.GHUL_INNATE_TYPE_LOOKUP(symbol_table),
                        assemblies
                    )
            )

            type_mapper = Semantic.DotNet.TYPE_MAPPER(dotnet_symbol_table, innate_symbol_lookup, type_name_map, assemblies)

            symbol_factory = Semantic.DotNet.SYMBOL_FACTORY(namespaces, type_name_map, type_mapper, assemblies, type_details_lookup, logger)

            assembly_info = Semantic.DotNet.ASSEMBLY_INFO(cil_context)

            value_converter = IR.VALUE_CONVERTER(logger, innate_symbol_lookup)

            function_caller = Semantic.FUNCTION_CALLER(symbol_table, value_boxer)

            symbol_loader =
                Semantic.SYMBOL_LOADER(
                    logger,
                    symbol_table,
                    function_caller,
                    value_boxer,
                    innate_symbol_lookup)

            function_caller.loader = symbol_loader

            overload_resolver = Semantic.OVERLOAD_RESOLVER(logger)

            conversion_lookup = Semantic.USER_DEFINED_CONVERSION_LOOKUP()

            type_caster =
                Semantic.TYPE_CASTER(
                    block_stack,
                    value_boxer,
                    value_converter,
                    innate_symbol_lookup,
                    conversion_lookup,
                    logger
                )

            task_conversion = Semantic.TASK_CONVERSION(innate_symbol_lookup)

            symbol_use_locations = Semantic.SYMBOL_USE_LOCATIONS()

            symbol_definition_locations = Semantic.SYMBOL_DEFINITION_LOCATIONS(symbol_use_locations)

            state_store_registry = Syntax.Process.STATE_STORE_REGISTRY()
            variable_left_state = Syntax.Process.VARIABLE_LEFT_STATE_STORE(state_store_registry)
            composite_spill_state = Syntax.Process.COMPOSITE_SPILL_STORE(state_store_registry)

            conditional_compilation = Syntax.Process.CONDITIONAL_COMPILATION()

            rewrite_primary_constructors = Syntax.Process.REWRITE_PRIMARY_CONSTRUCTORS(logger)
            synthesise_top_level_entry = Syntax.Process.SYNTHESISE_TOP_LEVEL_ENTRY(entry_point, logger)
            synthesise_entry_environment_wrapper = Syntax.Process.SYNTHESISE_ENTRY_ENVIRONMENT_WRAPPER(entry_point)

            expand_namespaces = Syntax.Process.EXPAND_NAMESPACES(System.IO.Abstractions.FileSystem())

            add_accessors_for_properties = Syntax.Process.ADD_ACCESSORS_FOR_PROPERTIES()

            spill_awaits = Syntax.Process.SPILL_AWAITS()

            collect_suppress_pragmas = Syntax.Process.COLLECT_SUPPRESS_PRAGMAS(logger)

            collect_modifier_keyword_locations = Syntax.Process.COLLECT_MODIFIER_KEYWORD_LOCATIONS()

            check_name_conventions = Syntax.Process.CHECK_NAME_CONVENTIONS(logger, symbol_table)
            definition_virtuality = Syntax.Process.DEFINITION_VIRTUALITY(logger, symbol_table)
            select_entry_point = Syntax.Process.SELECT_ENTRY_POINT(logger, symbol_table, entry_point, build_flags)

            declare_symbols =
                Syntax.Process.DECLARE_SYMBOLS(
                    logger,
                    symbol_table,
                    namespaces,
                    symbol_definition_locations)

            declare_members =
                Syntax.Process.DECLARE_MEMBERS(
                    logger,
                    symbol_table,
                    namespaces,
                    symbol_definition_locations,
                    symbol_use_locations,
                    local_id_generator)

            resolve_uses = Syntax.Process.RESOLVE_USES(logger, symbol_table, namespaces, symbol_use_locations, false)
            resolve_member_uses = Syntax.Process.RESOLVE_USES(logger, symbol_table, namespaces, symbol_use_locations, true)

            resolve_ancestors =
                Syntax.Process.RESOLVE_ANCESTORS(logger, symbol_table, namespaces, innate_symbol_lookup)

            resolve_type_expressions =
                Syntax.Process.RESOLVE_TYPE_EXPRESSIONS(
                    logger,
                    symbol_table,
                    namespaces,
                    symbol_use_locations,
                    innate_symbol_lookup)

            resolve_explicit_types =
                Syntax.Process.RESOLVE_EXPLICIT_TYPES(
                    logger,
                    symbol_table,
                    namespaces,
                    innate_symbol_lookup
                )

            synthesize_class_equality =
                Syntax.Process.SYNTHESIZE_CLASS_EQUALITY(logger, symbol_table, innate_symbol_lookup)

            synthesize_iterator_reset =
                Syntax.Process.SYNTHESIZE_ITERATOR_RESET(symbol_table, innate_symbol_lookup)

            check_type_argument_bounds =
                Syntax.Process.CHECK_TYPE_ARGUMENT_BOUNDS(
                    logger,
                    symbol_table,
                    namespaces
                )

            compile_expressions =
                Syntax.Process.COMPILE_EXPRESSIONS(
                    logger,
                    symbol_table,
                    namespaces,
                    symbol_loader,
                    innate_symbol_lookup,
                    function_caller,
                    type_caster,
                    task_conversion,
                    overload_resolver,
                    symbol_use_locations,
                    cil_context,
                    value_converter,
                    value_boxer,
                    build_flags,
                    variable_left_state,
                    composite_spill_state
                )

            resolve_overrides =
                Syntax.Process.RESOLVE_OVERRIDES(
                    logger,
                    symbol_table,
                    namespaces
                )

            infer_store_free =
                Syntax.Process.INFER_STORE_FREE(
                    logger,
                    symbol_table,
                    namespaces,
                    innate_symbol_lookup
                )

            check_pure_overrides =
                Syntax.Process.CHECK_PURE_OVERRIDES(
                    logger,
                    symbol_table,
                    namespaces
                )

            verify_compile_state =
                Syntax.Process.VERIFY_COMPILE_STATE(
                    logger,
                    symbol_table,
                    namespaces
                )

            register_source_intrinsics =
                Syntax.Process.REGISTER_SOURCE_INTRINSICS(
                    logger,
                    symbol_table,
                    namespaces
                )

            record_type_argument_uses =
                Syntax.Process.RECORD_TYPE_ARGUMENT_USES(
                    logger,
                    symbol_table,
                    namespaces,
                    innate_symbol_lookup
                )

            mark_boxed_locals =
                Syntax.Process.MARK_BOXED_LOCALS(
                    logger,
                    symbol_table,
                    namespaces
                )

            generate_il =
                Syntax.Process.GENERATE_IL(
                    logger,
                    symbol_table,
                    namespaces,
                    symbol_loader,
                    innate_symbol_lookup,
                    function_caller,
                    type_caster,
                    overload_resolver,
                    symbol_use_locations,
                    cil_context,
                    block_stack,
                    value_boxer,
                    build_flags,
                    composite_spill_state,
                    variable_left_state
                )

            completer =
                Syntax.Process.COMPLETER(
                    logger,
                    symbol_table,
                    namespaces,
                    dotnet_symbol_table
                )

            signature_help =
                Syntax.Process.SIGNATURE_HELP(
                    logger,
                    symbol_table,
                    namespaces,
                    overload_resolver
                )
        si

        want_tab_delimited_logger(writer: IO.TextWriter) is
            logger_writer = writer

            logger_formatter = Logging.TAB_DELIMITED_DIAGNOSTIC_FORMATTER()
        si

        // A test run captures diagnostics as a snapshot, so it sees
        // exactly what the passes reported: a pass that reports the
        // same thing four times shows as four lines rather than one.
        want_duplicate_diagnostics() is
            if let store: Logging.DIAGNOSTICS_STORE = logger then
                store.keep_duplicate_diagnostics()
            fi
        si

        want_human_readable_logger(writer: IO.TextWriter) is
            logger_writer = writer

            logger_formatter = Logging.HUMAN_READABLE_DIAGNOSTIC_FORMATTER()
        si

        want_msbuild_logger(writer: IO.TextWriter) is
            logger_writer = writer

            logger_formatter = Logging.MSBUILD_DIAGNOSTIC_FORMATTER()
        si
    si
si
