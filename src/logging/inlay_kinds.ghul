namespace Logging is
    use Ghul.Pipes

    // The kinds an inlay hint belongs to, and the gate that turns each on
    // or off process-wide (`--inlay <kind>` / `--no-inlay <kind>` from the
    // driver). A disabled kind is never recorded, so it costs nothing to
    // collect or serve - narrowing and definition-virtuality are on by
    // default, and the terminator kind (one hint per inferred statement
    // boundary) is off unless asked for.
    class INLAY_KINDS is
        // Every slug in the narrowing family shares this prefix:
        // narrowing-isa, narrowing-killed, narrowing-assign, ...
        NARROWING: string static => "narrowing"
        DEFINITION_VIRTUALITY: string static => "definition-virtuality"
        TERMINATOR: string static => "terminator"

        ALL: string[] static =>
            Collections.LIST([NARROWING, DEFINITION_VIRTUALITY, TERMINATOR])

        // The kind an inlay's code belongs to, by slug prefix. An unknown
        // code has no kind to gate and answers null - such a hint is
        // always collected.
        for_code(code: string?) -> string? static =>
            if !code? then
                null
            elif code.starts_with(NARROWING) then
                NARROWING
            elif code.starts_with(DEFINITION_VIRTUALITY) then
                DEFINITION_VIRTUALITY
            elif code.starts_with(TERMINATOR) then
                TERMINATOR
            else
                null
            fi

        is_known(kind: string) -> bool static => ALL |> any(k => k =~ kind)
    si
si
