namespace Logging is
    /// Thrown when a built-in type the compiler needs is declared nowhere it
    /// looks: the runtime or core library the project references is missing,
    /// or does not match the compiler. Nothing can be analysed without it, so
    /// it is reported as an error rather than as an internal failure.
    @suppress("non-upper-snake-case-name")
    class MissingBuiltInException: System.Exception is
        /// The code of the error that reports the failure.
        CODE: string static => "missing-built-in"

        /// The name of the built-in type that was not found.
        name: string

        /// A failure to find the built-in type `name`.
        ///
        /// - name: the name of the built-in type
        init(name: string) is
            super.init("built-in type {name} is not declared by the runtime or core library this project references")

            self.name = name
        si
    si
si
