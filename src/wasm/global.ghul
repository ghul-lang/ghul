namespace Wasm is
    // A global variable. Its initialiser is a constant expression,
    // which the binary format writes as an instruction run closed by an
    // `end` like any other.
    class GLOBAL is
        value_type: VALUE_TYPE
        is_mutable: bool

        _initialiser: Collections.List[INSTRUCTION]

        init(
            value_type: VALUE_TYPE,
            is_mutable: bool,
            initialiser: Collections.List[INSTRUCTION]
        ) is
            self.value_type = value_type
            self.is_mutable = is_mutable
            _initialiser = initialiser
        si

        write(buffer: BYTE_BUFFER) is
            value_type.write(buffer)

            buffer.write_byte(if is_mutable then 0x01ub else 0x00ub fi)

            write_instructions(buffer, _initialiser)
            buffer.write_byte(cast ubyte(Opcode.END))
        si
    si
si
