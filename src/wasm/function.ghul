namespace Wasm is
    // A defined function: which signature it has, the types of its
    // locals, and its body.
    class FUNCTION is
        _type_index: int
        _locals: ValueType[]
        _body: Collections.List[INSTRUCTION]

        init(
            type_index: int,
            locals: ValueType[],
            body: Collections.List[INSTRUCTION]
        ) is
            _type_index = type_index
            _locals = locals
            _body = body
        si

        type_index() -> int => _type_index

        // A code entry: its own length, then the locals, then the body
        // closed by an `end`.
        write(buffer: BYTE_BUFFER) is
            let entry = BYTE_BUFFER()

            write_locals(entry, _locals)
            write_instructions(entry, _body)
            entry.write_byte(cast ubyte(Opcode.END))

            buffer.write_length(entry.length())
            buffer.write_bytes(entry.to_array())
        si
    si

    // Locals are written as runs of one type rather than one type each,
    // so a body with three `int` locals carries one count and one type
    // where three of each would do.
    write_locals(buffer: BYTE_BUFFER, locals: ValueType[]) is
        buffer.write_length(count_local_runs(locals))

        let i mut = 0

        while i < locals.count do
            let type = locals[i]
            let run mut = 1

            while i + run < locals.count /\ locals[i + run] == type do
                run = run + 1
            od

            buffer.write_u32(run)
            write_value_type(buffer, type)

            i = i + run
        od
    si

    count_local_runs(locals: ValueType[]) -> int is
        let runs mut = 0
        let i mut = 0

        while i < locals.count do
            let type = locals[i]
            let run mut = 1

            while i + run < locals.count /\ locals[i + run] == type do
                run = run + 1
            od

            runs = runs + 1
            i = i + run
        od

        return runs
    si
si
