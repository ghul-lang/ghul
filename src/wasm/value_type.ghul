namespace Wasm is
    // The types a function can take and return, and a local or a global
    // can hold. The member value is the byte the specification encodes
    // the type as, which is not an enumeration of its own: the byte for
    // a reference type is also a valid single byte in other positions,
    // and the GC types added later continue the space rather than
    // replacing it.
    enum ValueType is
        I32 = 0x7F,
        I64 = 0x7E,
        F32 = 0x7D,
        F64 = 0x7C,
        V128 = 0x7B,
        FUNCREF = 0x70,
        EXTERNREF = 0x6F
    si

    // A value type is a single byte.
    write_value_type(buffer: BYTE_BUFFER, type: ValueType) is
        buffer.write_byte(cast ubyte(type))
    si
si
