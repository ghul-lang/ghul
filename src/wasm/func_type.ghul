namespace Wasm is
    // A function's signature. The type section is a vector of these and
    // everything that names a function refers to one by its position
    // there, so the module hands back the index a signature was written
    // at rather than the signature itself.
    class FUNC_TYPE is
        _parameters: ValueType[]
        _results: ValueType[]

        init(parameters: ValueType[], results: ValueType[]) is
            _parameters = parameters
            _results = results
        si

        parameters() -> ValueType[] => _parameters

        results() -> ValueType[] => _results

        write(buffer: BYTE_BUFFER) is
            // The byte that says what follows is a function type, as
            // against a structure or an array in the type section.
            buffer.write_byte(0x60ub)

            buffer.write_length(_parameters.count)

            for type in _parameters do
                write_value_type(buffer, type)
            od

            buffer.write_length(_results.count)

            for type in _results do
                write_value_type(buffer, type)
            od
        si

        // Two signatures are the same when they take and return the same
        // types in the same order, which is what lets the module reuse
        // the entry an earlier signature was written at.
        matches(other: FUNC_TYPE) -> bool is
            return _parameters =~ other._parameters /\ _results =~ other._results
        si
    si
si
