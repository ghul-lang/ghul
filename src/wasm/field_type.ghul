namespace Wasm is
    // What a struct field or an array element holds, which is a value
    // type or one of the two packed types. A packed type has no value
    // type spelling of its own: it is read and written through the
    // instructions that sign or zero extend it.
    enum StorageType is
        I32 = 0x7F,
        I64 = 0x7E,
        F32 = 0x7D,
        F64 = 0x7C,
        V128 = 0x7B,
        FUNCREF = 0x70,
        EXTERNREF = 0x6F,
        I8 = 0x78,
        I16 = 0x77
    si

    // A storage type and whether it can be assigned through.
    class FIELD_TYPE is
        _storage: StorageType
        _mutable: bool

        init(storage: StorageType, mutable: bool) is
            _storage = storage
            _mutable = mutable
        si

        // The mutability byte is written whether or not the field can be
        // assigned through. The format leaves it out for a field that
        // cannot, and that is one byte saved per immutable field, but
        // the omission is not accepted everywhere, and a module an
        // engine rejects is not one worth a byte.
        write(buffer: BYTE_BUFFER) is
            buffer.write_byte(cast ubyte(_storage))
            buffer.write_byte(if _mutable then 0x01ub else 0x00ub fi)
        si

        matches(other: FIELD_TYPE) -> bool is
            return _storage == other._storage /\ _mutable == other._mutable
        si
    si
si
