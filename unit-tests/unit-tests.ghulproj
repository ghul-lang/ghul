<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
    <!-- cast-may-throw is reported at every checked cast, including ones the
         surrounding code has already established; across the compiler and its
         tests that is more noise than signal, so it is a hint here. -->
    <GhulWarnAsHint>cast-may-throw</GhulWarnAsHint>

    <!-- Test names follow the Calling__foo__should_X idiom and the
         MSTest conventions rather than the naming rules. -->
    <GhulNoWarn>non-snake-case-name;non-pascal-case-name;non-upper-snake-case-name</GhulNoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ghul.ghulproj" />
    
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />

    <GhulSources Include="src/**/*.ghul" />
    <!-- The helpers the tests in both projects use, while the tests move
         to unit-tests-native: one copy, compiled into each. -->
    <GhulSources Include="../unit-tests-native/src/shared/**/*.ghul" />

    <!-- Terminator-free sources; an error everywhere so stray `;`
         cannot creep back in. Same arrangement as ghul.ghulproj. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" />

  </ItemGroup>
</Project>