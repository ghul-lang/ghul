namespace Wasm.UnitTests is
    use Collections.LIST

    use Wasm.BYTE_BUFFER
    use Wasm.ELEMENT_SEGMENT
    use Wasm.ElementMode
    use Wasm.INSTRUCTION
    use Wasm.I32_CONSTANT
    use Wasm.INDEX_INSTRUCTION
    use Wasm.Opcode

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // The eight forms an element segment takes. They are not one per
    // combination of mode, element type and table, because the two
    // commonest cases leave the table and the element type out.
    @TestClass()
    class ELEMENT_SEGMENT_TESTS is
        init() is si

        _encoded(segment: ELEMENT_SEGMENT) -> ubyte[] is
            let buffer = BYTE_BUFFER()

            segment.write(buffer)

            return buffer.to_array()
        si

        _offset_at_zero() -> LIST[INSTRUCTION] is
            return LIST[INSTRUCTION]([I32_CONSTANT(0)])
        si

        _ref(index: int) -> LIST[INSTRUCTION] is
            return LIST[INSTRUCTION]([INDEX_INSTRUCTION(Opcode.REF_FUNC, index)])
        si

        @Test()
        write__active_on_the_first_table_by_function__leaves_out_the_table_and_the_kind() is
            BYTES.are(
                [0x00, 0x41, 0x00, 0x0B, 0x02, 0x01, 0x02],
                _encoded(ELEMENT_SEGMENT.of_functions(
                    ElementMode.ACTIVE, 0, _offset_at_zero(), [1, 2])))
        si

        @Test()
        write__active_on_another_table_by_function__carries_both() is
            BYTES.are(
                [0x02, 0x01, 0x41, 0x00, 0x0B, 0x00, 0x01, 0x03],
                _encoded(ELEMENT_SEGMENT.of_functions(
                    ElementMode.ACTIVE, 1, _offset_at_zero(), [3])))
        si

        @Test()
        write__passive_by_function__carries_the_element_kind() is
            BYTES.are(
                [0x01, 0x00, 0x01, 0x03],
                _encoded(ELEMENT_SEGMENT.of_functions(
                    ElementMode.PASSIVE, 0, LIST[INSTRUCTION](), [3])))
        si

        @Test()
        write__declarative_by_function__carries_the_element_kind() is
            BYTES.are(
                [0x03, 0x00, 0x01, 0x00],
                _encoded(ELEMENT_SEGMENT.of_functions(
                    ElementMode.DECLARATIVE, 0, LIST[INSTRUCTION](), [0])))
        si

        @Test()
        write__active_on_the_first_table_by_expression__leaves_out_the_table_and_the_type() is
            BYTES.are(
                [0x04, 0x41, 0x00, 0x0B, 0x02, 0xD2, 0x01, 0x0B, 0xD2, 0x02, 0x0B],
                _encoded(ELEMENT_SEGMENT.of_expressions(
                    ElementMode.ACTIVE,
                    0,
                    _offset_at_zero(),
                    VALUE_TYPES.func_ref(),
                    LIST[LIST[INSTRUCTION]]([_ref(1), _ref(2)]))))
        si

        @Test()
        write__active_on_another_table_by_expression__carries_both() is
            BYTES.are(
                [0x06, 0x01, 0x41, 0x00, 0x0B, 0x70, 0x01, 0xD2, 0x00, 0x0B],
                _encoded(ELEMENT_SEGMENT.of_expressions(
                    ElementMode.ACTIVE,
                    1,
                    _offset_at_zero(),
                    VALUE_TYPES.func_ref(),
                    LIST[LIST[INSTRUCTION]]([_ref(0)]))))
        si

        @Test()
        write__passive_by_expression__carries_the_element_type() is
            BYTES.are(
                [0x05, 0x70, 0x01, 0xD2, 0x00, 0x0B],
                _encoded(ELEMENT_SEGMENT.of_expressions(
                    ElementMode.PASSIVE,
                    0,
                    LIST[INSTRUCTION](),
                    VALUE_TYPES.func_ref(),
                    LIST[LIST[INSTRUCTION]]([_ref(0)]))))
        si

        @Test()
        write__declarative_by_expression__carries_the_element_type() is
            BYTES.are(
                [0x07, 0x70, 0x01, 0xD2, 0x00, 0x0B],
                _encoded(ELEMENT_SEGMENT.of_expressions(
                    ElementMode.DECLARATIVE,
                    0,
                    LIST[INSTRUCTION](),
                    VALUE_TYPES.func_ref(),
                    LIST[LIST[INSTRUCTION]]([_ref(0)]))))
        si

        // The two forms that leave the table out also leave out the
        // element type, and leaving it out fixes it at funcref. Anything
        // else on the first table names its table after all.
        @Test()
        write__an_expression_segment_of_another_type_on_the_first_table__names_the_table() is
            BYTES.are(
                [0x06, 0x00, 0x41, 0x00, 0x0B, 0x6E, 0x01, 0xD2, 0x00, 0x0B],
                _encoded(ELEMENT_SEGMENT.of_expressions(
                    ElementMode.ACTIVE,
                    0,
                    _offset_at_zero(),
                    VALUE_TYPES.any(),
                    LIST[LIST[INSTRUCTION]]([_ref(0)]))))
        si

        @Test()
        write__a_function_segment_of_any_element_type_on_the_first_table__leaves_both_out() is
            BYTES.are(
                [0x00, 0x41, 0x00, 0x0B, 0x01, 0x00],
                _encoded(ELEMENT_SEGMENT.of_functions(
                    ElementMode.ACTIVE, 0, _offset_at_zero(), [0])))
        si

        @Test()
        write__an_empty_run__is_a_zero_count() is
            BYTES.are(
                [0x01, 0x00, 0x00],
                _encoded(ELEMENT_SEGMENT.of_functions(
                    ElementMode.PASSIVE, 0, LIST[INSTRUCTION](), [])))
        si
    si
si
