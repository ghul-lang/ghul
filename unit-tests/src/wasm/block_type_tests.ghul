namespace Wasm.UnitTests is
    use Wasm.BLOCK_TYPE
    use Wasm.BYTE_BUFFER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // The three block types are three different byte sequences rather
    // than one, which is why the index form is not written as the signed
    // LEB128 the specification reads it as.
    @TestClass()
    class BLOCK_TYPE_TESTS is
        init() is si

        _encoded(block_type: BLOCK_TYPE) -> ubyte[] is
            let buffer = BYTE_BUFFER()

            block_type.write(buffer)

            return buffer.to_array()
        si

        @Test()
        write__empty__is_the_absent_byte() is
            BYTES.are([0x40], _encoded(BLOCK_TYPE()))
        si

        @Test()
        write__value_type__is_the_type_byte() is
            BYTES.are([0x7F], _encoded(BLOCK_TYPE.of_value(ValueType.I32)))
        si

        @Test()
        write__reference_value_type__is_the_type_byte() is
            BYTES.are([0x70], _encoded(BLOCK_TYPE.of_value(ValueType.FUNCREF)))
        si

        // 0x70 is 111 as a signed value, so the signed encoding of it
        // would carry on for a second byte. The type byte is one byte.
        @Test()
        write__value_type_above_the_signed_range__is_still_one_byte() is
            BYTES.are([0x6F], _encoded(BLOCK_TYPE.of_value(ValueType.EXTERNREF)))
        si

        @Test()
        write__type_index__is_a_leb128() is
            BYTES.are([0x02], _encoded(BLOCK_TYPE.of_type_index(2)))
        si

        @Test()
        write__type_index_above_one_octet__spans_two() is
            BYTES.are([0x80, 0x01], _encoded(BLOCK_TYPE.of_type_index(128)))
        si
    si
si
