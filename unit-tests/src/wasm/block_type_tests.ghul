namespace Wasm.UnitTests is
    use Wasm.BLOCK_TYPE
    use Wasm.BYTE_BUFFER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // The three block types are three different byte sequences rather
    // than one, which is why the index form is not written as the signed
    // LEB128 the specification reads it as.
    @TestClass()
    class BLOCK_TYPE_TESTS is
        init() is si

        _encoded(block_type: BLOCK_TYPE) -> ubyte[] is
            let buffer = BYTE_BUFFER()

            block_type.write(buffer)

            return buffer.to_array()
        si

        @Test()
        write__empty__is_the_absent_byte() is
            BYTES.are([0x40], _encoded(BLOCK_TYPE()))
        si

        @Test()
        write__value_type__is_the_type_byte() is
            BYTES.are([0x7F], _encoded(BLOCK_TYPE.of_value(VALUE_TYPES.i32())))
        si

        @Test()
        write__reference_value_type__is_the_type_byte() is
            BYTES.are([0x70], _encoded(BLOCK_TYPE.of_value(VALUE_TYPES.func_ref())))
        si

        // A value type byte is a negative signed value read as itself,
        // so it is one byte and never an index.
        @Test()
        write__a_reference_value_type__is_still_one_byte() is
            BYTES.are([0x6F], _encoded(BLOCK_TYPE.of_value(VALUE_TYPES.extern_ref())))
        si

        @Test()
        write__type_index__is_a_signed_leb128() is
            BYTES.are([0x02], _encoded(BLOCK_TYPE.of_type_index(2)))
        si

        @Test()
        write__type_index_above_one_octet__spans_two() is
            BYTES.are([0x80, 0x01], _encoded(BLOCK_TYPE.of_type_index(128)))
        si

        // An index below 64 is one byte whichever way it is written, and
        // above 128 both agree again. These are the indices where the
        // two differ, because these are the bytes a reader takes for a
        // block type.
        @Test()
        write__the_last_index_of_one_byte__is_one_byte() is
            BYTES.are([0x3F], _encoded(BLOCK_TYPE.of_type_index(63)))
        si

        @Test()
        write__index_64__is_two_bytes_not_the_empty_block_byte() is
            BYTES.are([0xC0, 0x00], _encoded(BLOCK_TYPE.of_type_index(64)))
        si

        @Test()
        write__index_111__is_two_bytes_not_the_externref_byte() is
            BYTES.are([0xEF, 0x00], _encoded(BLOCK_TYPE.of_type_index(111)))
        si

        @Test()
        write__index_112__is_two_bytes_not_the_funcref_byte() is
            BYTES.are([0xF0, 0x00], _encoded(BLOCK_TYPE.of_type_index(112)))
        si

        @Test()
        write__index_124__is_two_bytes_not_a_numeric_type_byte() is
            BYTES.are([0xFC, 0x00], _encoded(BLOCK_TYPE.of_type_index(124)))
        si

        @Test()
        write__index_127__is_two_bytes_not_the_i32_byte() is
            BYTES.are([0xFF, 0x00], _encoded(BLOCK_TYPE.of_type_index(127)))
        si
    si
si
