namespace Wasm.UnitTests is
    use Wasm.BYTE_BUFFER
    use Wasm.FIELD_TYPE
    use Wasm.StorageType

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // A field is what it holds and whether it can be assigned through,
    // which is a byte and then a marker for the second.
    @TestClass()
    class FIELD_TYPE_TESTS is
        init() is si

        _encoded(one: FIELD_TYPE) -> ubyte[] is
            let buffer = BYTE_BUFFER()

            one.write(buffer)

            return buffer.to_array()
        si

        // The format leaves the mutability byte out for a field that
        // cannot be assigned through, and an engine rejects that, so it
        // is written either way.
        @Test()
        write__an_immutable_field__carries_a_zero() is
            BYTES.are([0x7F, 0x00], _encoded(FIELD_TYPE(StorageType.I32, false)))
        si

        @Test()
        write__a_mutable_field__adds_the_marker() is
            BYTES.are([0x7F, 0x01], _encoded(FIELD_TYPE(StorageType.I32, true)))
        si

        // A packed type has no value type of its own, and is read and
        // written through the instructions that extend it.
        @Test()
        write__a_packed_byte_field__is_its_own_byte() is
            BYTES.are([0x78, 0x01], _encoded(FIELD_TYPE(StorageType.I8, true)))
        si

        @Test()
        write__a_packed_half_word_field__is_its_own_byte() is
            BYTES.are([0x77, 0x00], _encoded(FIELD_TYPE(StorageType.I16, false)))
        si

        @Test()
        write__a_reference_field__is_its_heap_type_byte() is
            BYTES.are([0x70, 0x00], _encoded(FIELD_TYPE(StorageType.FUNCREF, false)))
        si
    si
si
