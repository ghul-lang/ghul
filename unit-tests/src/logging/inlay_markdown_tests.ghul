namespace Logging.UnitTests is
    use Logging.INLAY_MARKDOWN
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The detail format itself: code fenced, prose outside, and the round
    // trip that lets a merger take the two halves apart again.
    @TestClass()
    class INLAY_MARKDOWN_TESTS is
        init() is si


        @Test()
        a_detail_with_no_prose_is_only_its_fenced_code() is
            are_equal("```ghul\nx\n```", INLAY_MARKDOWN.detail("x", null))
            are_equal("```ghul\nx\n```", INLAY_MARKDOWN.detail("x", ""))
        si

        @Test()
        prose_follows_the_fence_after_a_blank_line() is
            are_equal(
                "```ghul\nx\n```\n\nthe call may change x",
                INLAY_MARKDOWN.detail("x", "the call may change x")
            )
        si

        @Test()
        the_two_halves_read_back_out() is
            let detail = INLAY_MARKDOWN.detail("CONS[int]\n> NIL", "the presence bit is redundant")

            are_equal("CONS[int]\n> NIL", INLAY_MARKDOWN.body_of(detail))
            are_equal("the presence bit is redundant", INLAY_MARKDOWN.prose_of(detail))
        si

        @Test()
        a_detail_with_no_prose_reads_back_as_no_prose() is
            let detail = INLAY_MARKDOWN.detail("LIST[int]", null)

            are_equal("LIST[int]", INLAY_MARKDOWN.body_of(detail))
            is_null(INLAY_MARKDOWN.prose_of(detail), "expected no prose")
        si

        // An unfenced detail, which a merger can still be handed: it is all
        // code, and taking it apart must not lose the blank line inside it.
        @Test()
        an_unfenced_detail_reads_back_as_whole() is
            are_equal("x\n\nbecause", INLAY_MARKDOWN.body_of("x\n\nbecause"))
            is_null(INLAY_MARKDOWN.prose_of("x\n\nbecause"), "expected no prose")
        si

        @Test()
        several_code_lines_join_and_several_notes_become_paragraphs() is
            let body = INLAY_MARKDOWN.body(["Shape", "▼ extended by Square"])
            let prose = INLAY_MARKDOWN.notes(["first note", "second note"])

            are_equal("Shape\n▼ extended by Square", body)
            are_equal("first note\n\nsecond note", prose)
        si
    si
si