namespace Logging.UnitTests is
    use Source.LOCATION
    use Ghul.Pipes

    use Logging.DIAGNOSTIC_DEDUPLICATOR
    use Logging.DIAGNOSTIC_MESSAGE
    use Logging.DiagnosticSeverity

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class DIAGNOSTIC_DEDUPLICATOR_TESTS is
        init() is si

        loc(line: int) -> LOCATION => LOCATION("test.ghul", line, 1, line, 5)

        message(severity: DiagnosticSeverity, line: int, text: string) -> DIAGNOSTIC_MESSAGE =>
            DIAGNOSTIC_MESSAGE(false, false, severity, loc(line), text)

        error(line: int, text: string) -> DIAGNOSTIC_MESSAGE =>
            message(DiagnosticSeverity.ERROR, line, text)

        @Test()
        The_first_report_is_kept() is
            let deduplicator = DIAGNOSTIC_DEDUPLICATOR()

            is_true(deduplicator.is_first(error(1, "symbol not found: x")))
        si

        @Test()
        An_identical_report_is_dropped() is
            let deduplicator = DIAGNOSTIC_DEDUPLICATOR()

            let _ = deduplicator.is_first(error(1, "symbol not found: x"))

            is_false(deduplicator.is_first(error(1, "symbol not found: x")))
        si

        @Test()
        A_report_differing_in_wording_is_kept() is
            let deduplicator = DIAGNOSTIC_DEDUPLICATOR()

            let _ = deduplicator.is_first(error(1, "symbol not found: x"))

            is_true(deduplicator.is_first(error(1, "symbol not found: y")))
        si

        @Test()
        A_report_differing_in_span_is_kept() is
            let deduplicator = DIAGNOSTIC_DEDUPLICATOR()

            let _ = deduplicator.is_first(error(1, "symbol not found: x"))

            is_true(deduplicator.is_first(error(2, "symbol not found: x")))
        si

        // A level that is rolled back takes what it has seen with it, so
        // a report made only inside it is made again by the walk that
        // survives. A flag on the tree would outlive the roll back and
        // silence that second report.
        @Test()
        A_report_rolled_back_and_made_again_appears_once() is
            let store = Logging.DIAGNOSTICS_STORE()

            store.speculate()
            store.error(loc(1), "test-diagnostic", "symbol not found: x")
            let _ = store.roll_back()

            store.error(loc(1), "test-diagnostic", "symbol not found: x")
            store.error(loc(1), "test-diagnostic", "symbol not found: x")

            are_equal(1, store.diagnostics_for("test.ghul") |> count())
        si

        @Test()
        Keeping_duplicates_restores_them() is
            let store = Logging.DIAGNOSTICS_STORE()

            store.keep_duplicate_diagnostics()

            store.error(loc(1), "test-diagnostic", "symbol not found: x")
            store.error(loc(1), "test-diagnostic", "symbol not found: x")

            are_equal(2, store.diagnostics_for("test.ghul") |> count())
        si

        @Test()
        A_report_differing_in_severity_is_kept() is
            let deduplicator = DIAGNOSTIC_DEDUPLICATOR()

            let _ = deduplicator.is_first(error(1, "shadowed"))

            is_true(
                deduplicator.is_first(
                    message(DiagnosticSeverity.WARN, 1, "shadowed")))
        si
    si
si
