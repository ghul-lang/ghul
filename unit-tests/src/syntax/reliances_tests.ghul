namespace Syntax.UnitTests is
    use Collections.LIST
    use Collections.MAP

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Syntax.Process.CROSSING
    use Syntax.Process.EFFECT_FACTS
    use Syntax.Process.EFFECT_SOLVERS
    use Syntax.Process.EFFECTS
    use Syntax.Process.RELIANCES
    use Syntax.Process.STORE_FREE_FACTS

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.INSTANCE_FIELD
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.INSTANCE_PROPERTY
    use Semantic.Symbols.NAMESPACE

    use Function = Semantic.Symbols.Function
    use Symbol = Semantic.Symbols.Symbol
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins the crossing-discharge rules the reliance judge applies: a
    // fact that crossed a call is discharged only when the callee's
    // solved effects provably leave it alone — store-free callees
    // discharge everything, member-granular write and nulling sets
    // judge storage facts, and a getter fact needs the callee's writes
    // disjoint from the getter's read closure.
    @TestClass()
    class RELIANCES_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](), Semantic.BLOCK_SCOPE())

        global_function(name: string) -> GLOBAL_FUNCTION =>
            GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())

        field_symbol(name: string) -> INSTANCE_FIELD => INSTANCE_FIELD(loc(), owner(), name)

        property_symbol(name: string) -> INSTANCE_PROPERTY =>
            INSTANCE_PROPERTY(loc(), loc(), owner(), name, false, false)

        reflected_member(namespace_name: string, class_name: string, member_name: string) -> INSTANCE_METHOD is
            let ns = NAMESPACE(loc(), namespace_name, null, ".{namespace_name}", false)
            let cls = CLASS(LOCATION.reflected, LOCATION.reflected, ns, class_name, LIST[string](), Semantic.BLOCK_SCOPE())
            return INSTANCE_METHOD(LOCATION.reflected, LOCATION.reflected, cls, member_name, Semantic.BLOCK_SCOPE())
        si

        crossing_of(callee: Function?) -> CROSSING => CROSSING(loc(), callee)

        begin() is
            EFFECT_FACTS.collecting = true
            EFFECT_FACTS.begin_generation("test")
        si

        record(f: Function) -> Syntax.Process.FUNCTION_EFFECT_FACTS is
            EFFECT_FACTS.note_function(f, f.name, "", "", "")
            return EFFECT_FACTS.record_for(f)!
        si

        // Solve and install the effect relations over the given
        // walked functions, none disqualified unless the test says so.
        install(facts: MAP[Function, STORE_FREE_FACTS]) is
            let solvers = EFFECT_SOLVERS(facts)
            let writes = solvers.write_sets(false, false)
            let nulls = solvers.may_null_sets(false, false)
            let solved = solvers.solve()
            let reads = solvers.read_sets()

            EFFECTS.install(
                writes.sets, writes.unbounded,
                nulls.sets, nulls.unbounded,
                solved.store_free, solved.constructs_store_free,
                reads.sets, reads.unbounded, reads.reads_elements, reads.writes_elements, true)
        si

        facts_for(functions: Collections.Iterable[Function]) -> MAP[Function, STORE_FREE_FACTS] is
            let result = MAP[Function, STORE_FREE_FACTS]()
            for f in functions do
                result[f] = STORE_FREE_FACTS()
            od
            return result
        si

        @Test()
        Crossing_with_no_callee__is_never_discharged() is
            begin()

            is_false(RELIANCES.crossing_discharged(crossing_of(null), field_symbol("f"), null, false))
        si

        @Test()
        Store_free_callee__discharges_any_fact() is
            begin()

            let callee = global_function("callee")
            record(callee)

            let facts = facts_for([cast Function(callee)])
            install(facts)

            is_true(RELIANCES.crossing_discharged(crossing_of(callee), field_symbol("f"), null, false))
            is_true(RELIANCES.crossing_discharged(crossing_of(callee), field_symbol("f"), null, true))

            EFFECTS.clear()
        si

        @Test()
        Member_granular_writes__block_only_the_written_member() is
            begin()

            let f = field_symbol("f")
            let other = field_symbol("other")
            let callee = global_function("callee")

            record(callee).writes.add(f)

            let facts = facts_for([cast Function(callee)])
            facts[callee].is_disqualified = true
            install(facts)

            is_false(RELIANCES.crossing_discharged(crossing_of(callee), f, null, false))
            is_true(RELIANCES.crossing_discharged(crossing_of(callee), other, null, false))

            EFFECTS.clear()
        si

        @Test()
        Presence_facts__judge_against_the_nulling_set() is
            begin()

            let f = field_symbol("f")
            let callee = global_function("callee")

            // writes f, but never writes an absent value to it
            record(callee).writes.add(f)

            let facts = facts_for([cast Function(callee)])
            facts[callee].is_disqualified = true
            install(facts)

            is_true(RELIANCES.crossing_discharged(crossing_of(callee), f, null, true))
            is_false(RELIANCES.crossing_discharged(crossing_of(callee), f, null, false))

            EFFECTS.clear()
        si

        @Test()
        Receiver_interior_callee__discharges_a_field_fact() is
            begin()

            let add = reflected_member("Collections", "LIST", "add")

            is_true(RELIANCES.crossing_discharged(crossing_of(add), field_symbol("f"), null, false))
        si

        @Test()
        Getter_fact__discharged_when_writes_miss_the_read_closure() is
            begin()

            let backing = field_symbol("backing")
            let elsewhere = field_symbol("elsewhere")

            let property = property_symbol("p")
            let getter = global_function("get_p")
            property.read_function = getter

            let benign = global_function("benign")
            let hostile = global_function("hostile")

            record(getter).reads.add(backing)
            record(benign).writes.add(elsewhere)
            record(hostile).writes.add(backing)

            let facts = facts_for([cast Function(getter), cast Function(benign), cast Function(hostile)])
            facts[benign].is_disqualified = true
            facts[hostile].is_disqualified = true
            install(facts)

            is_true(RELIANCES.crossing_discharged(crossing_of(benign), property, null, false))
            is_false(RELIANCES.crossing_discharged(crossing_of(hostile), property, null, false))

            EFFECTS.clear()
        si

        @Test()
        Getter_with_unboundable_reads__never_discharges_a_storing_callee() is
            begin()

            let property = property_symbol("p")
            // no read function at all: the closure cannot be bounded
            let storing = global_function("storing")

            record(storing).writes.add(field_symbol("f"))

            let facts = facts_for([cast Function(storing)])
            facts[storing].is_disqualified = true
            install(facts)

            is_false(RELIANCES.crossing_discharged(crossing_of(storing), property, null, false))

            EFFECTS.clear()
        si
    si
si
