namespace Syntax.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use NSubstitute.SubstituteExtensions.returns

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Syntax.Process.TRIVIAL_EXPRESSION_TYPER

    use Semantic.BLOCK_SCOPE
    use Semantic.SYMBOL_TABLE
    use Semantic.Lookups.InnateSymbolLookup

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Symbols.FUNCTION_GROUP
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.INSTANCE_FIELD
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.LOCAL_VARIABLE

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins TRIVIAL_EXPRESSION_TYPER's contract: declared types of
    // scope-resolvable symbols, the local-initializer record taking
    // precedence, member lookup over declared receiver types, literal
    // and presence-test typing, operator result types only when every
    // candidate agrees, and null for everything undecidable.
    @TestClass()
    class TRIVIAL_EXPRESSION_TYPER_TESTS is
        init() is
            Fixtures.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        named_class(name: string) -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        build_lookup(int_type: Type?, bool_type: Type?, string_type: Type?) -> InnateSymbolLookup is
            let arguments = System.Array.empty`[object]()
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments)
            lookup.get_int_type() |> returns(int_type, null)
            lookup.get_bool_type() |> returns(bool_type, null)
            lookup.get_string_type() |> returns(string_type, null)
            return lookup
        si

        identifier(name: string) -> Trees.Expressions.IDENTIFIER =>
            Trees.Expressions.IDENTIFIER(loc(), Trees.Identifiers.Identifier(loc(), name))

        member(left: Trees.Expressions.Expression, name: string) -> Trees.Expressions.MEMBER =>
            Trees.Expressions.MEMBER(loc(), left, Trees.Identifiers.Identifier(loc(), name), loc())

        integer_literal() -> Trees.Expressions.Literals.INTEGER =>
            Trees.Expressions.Literals.INTEGER(loc(), "1")

        binary(operation: string, left: Trees.Expressions.Expression, right: Trees.Expressions.Expression) -> Trees.Expressions.BINARY =>
            Trees.Expressions.BINARY(loc(), Trees.Identifiers.Identifier(loc(), operation), operation, left, right)

        unwrap(left: Trees.Expressions.Expression) -> Trees.Expressions.UNWRAP =>
            Trees.Expressions.UNWRAP(loc(), left)

        // A resolved type expression, as resolve-type-expressions would
        // leave it - `type` set, standing in for whatever was written.
        // The written name is irrelevant; only the resolved `type` is
        // ever consulted.
        resolved_type_expression(type: Type) -> Trees.TypeExpressions.TypeExpression is
            let type_expression = Trees.TypeExpressions.NAMED(loc(), Trees.Identifiers.Identifier(loc(), "T"))
            type_expression.type = type
            return type_expression
        si

        cast_of(type: Type?, right: Trees.Expressions.Expression) -> Trees.Expressions.CAST =>
            Trees.Expressions.CAST(
                loc(),
                if type? then resolved_type_expression(type) else null fi,
                right,
                true
            )

        // Argument expressions never affect a call's result type, so
        // every call helper takes an empty argument list.
        call(function: Trees.Expressions.Expression) -> Trees.Expressions.CALL =>
            Trees.Expressions.CALL(loc(), function, Trees.Expressions.LIST(loc(), LIST[Trees.Expressions.Expression]()))

        function_group(name: string, return_types: Collections.Iterable[Type]) -> FUNCTION_GROUP is
            let group = FUNCTION_GROUP(loc(), _scope, name)

            for return_type in return_types do
                let function = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())
                function.return_type = return_type
                group.add(function)
            od

            return group
        si

        // One scope entered on a fresh symbol table; tests declare
        // what they need into it.
        _scope: BLOCK_SCOPE
        _typer: TRIVIAL_EXPRESSION_TYPER
        _int_type: Type
        _bool_type: Type
        _string_type: Type

        build() is
            let symbol_table = SYMBOL_TABLE(DIAGNOSTICS_STORE())

            _scope = BLOCK_SCOPE(null)
            symbol_table.enter_scope(_scope)

            _int_type = named_class("int").type!
            _bool_type = named_class("bool").type!
            _string_type = named_class("string").type!

            _typer = TRIVIAL_EXPRESSION_TYPER(
                symbol_table,
                build_lookup(_int_type, _bool_type, _string_type)
            )
        si

        declare_local(name: string, type: Type?) -> LOCAL_VARIABLE is
            let local = LOCAL_VARIABLE(loc(), _scope, name)

            if type? then
                // The symbol's own type is set — as compile-expressions
                // would — but the typer must never read it for a local;
                // the enclosing walk makes a local's type known only by
                // recording it, which is what set_local_type models here.
                local.set_type(type)
                _typer.set_local_type(local, type)
            fi

            _scope.declare(loc(), local, null)

            return local
        si

        @Test()
        Integer_literal__types_as_int() is
            build()

            are_same(_int_type, _typer.try_type(integer_literal()))
        si

        @Test()
        Has_value_test__types_as_bool() is
            build()

            are_same(_bool_type, _typer.try_type(Trees.Expressions.HAS_VALUE(loc(), identifier("x"))))
        si

        @Test()
        Declared_local__types_as_declared() is
            build()
            declare_local("x", _int_type)

            are_same(_int_type, _typer.try_type(identifier("x")))
        si

        @Test()
        Unresolvable_identifier__types_as_null() is
            build()

            is_null(_typer.try_type(identifier("missing")))
        si

        @Test()
        Local_record__takes_precedence_over_declared_type() is
            build()
            let local = declare_local("x", _int_type)

            _typer.set_local_type(local, _string_type)

            are_same(_string_type, _typer.try_type(identifier("x")))
        si

        // Once its record is dropped a local is unknown again — the typer
        // has no fallback to the local symbol's own `type`, which is the
        // property that keeps the store-free classification independent of
        // the later compile-expressions pass. The symbol here carries a
        // type (set by declare_local) that must not resurface.
        @Test()
        Reset__drops_the_local_record() is
            build()
            let local = declare_local("x", _int_type)

            _typer.set_local_type(local, _string_type)
            _typer.reset()

            is_null(_typer.try_type(identifier("x")))
        si

        @Test()
        Member_over_declared_receiver__types_as_member() is
            build()

            let box = named_class("BOX")
            let member_field = INSTANCE_FIELD(loc(), box, "v")
            member_field.set_type(_int_type)
            box.declare(loc(), member_field, null)

            declare_local("b", box.type)

            are_same(_int_type, _typer.try_type(member(identifier("b"), "v")))
        si

        @Test()
        Member_over_untyped_receiver__types_as_null() is
            build()
            declare_local("b", null)

            is_null(_typer.try_type(member(identifier("b"), "v")))
        si

        @Test()
        Operator_with_agreeing_candidates__types_as_their_return_type() is
            build()

            let group = FUNCTION_GROUP(loc(), _scope, "+")
            let first = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            first.return_type = _int_type
            let second = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            second.return_type = _int_type
            group.add(first)
            group.add(second)
            _scope.declare(loc(), group, null)

            are_same(_int_type, _typer.try_type(binary("+", integer_literal(), integer_literal())))
        si

        @Test()
        Operator_with_disagreeing_candidates__types_as_null() is
            build()

            let group = FUNCTION_GROUP(loc(), _scope, "+")
            let first = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            first.return_type = _int_type
            let second = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            second.return_type = _string_type
            group.add(first)
            group.add(second)
            _scope.declare(loc(), group, null)

            is_null(_typer.try_type(binary("+", integer_literal(), integer_literal())))
        si

        @Test()
        Operator_with_untyped_operand__types_as_null() is
            build()

            let group = FUNCTION_GROUP(loc(), _scope, "+")
            let first = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            first.return_type = _int_type
            group.add(first)
            _scope.declare(loc(), group, null)

            is_null(_typer.try_type(binary("+", integer_literal(), identifier("missing"))))
        si

        @Test()
        Collecting_candidates__from_a_non_function_symbol__is_undecidable() is
            build()

            let candidates = LIST[Semantic.Symbols.Function]()

            is_false(_typer.try_collect_operator_candidates(named_class("BOX"), candidates))
        si

        @Test()
        Collecting_candidates__from_null__is_decidable_and_empty() is
            build()

            let candidates = LIST[Semantic.Symbols.Function]()

            is_true(_typer.try_collect_operator_candidates(null, candidates))
            are_equal(0, candidates.count)
        si

        @Test()
        Call_of_single_function__types_as_its_return_type() is
            build()
            _scope.declare(loc(), function_group("f", [_int_type]), null)

            are_same(_int_type, _typer.try_type(call(identifier("f"))))
        si

        @Test()
        Call_of_agreeing_overloads__types_as_their_return_type() is
            build()
            _scope.declare(loc(), function_group("f", [_int_type, _int_type]), null)

            are_same(_int_type, _typer.try_type(call(identifier("f"))))
        si

        @Test()
        Call_of_disagreeing_overloads__types_as_null() is
            build()
            _scope.declare(loc(), function_group("f", [_int_type, _string_type]), null)

            is_null(_typer.try_type(call(identifier("f"))))
        si

        @Test()
        Member_call_over_declared_receiver__types_as_return_type() is
            build()

            let box = named_class("BOX")
            let method = INSTANCE_METHOD(loc(), loc(), box, "m", Semantic.BLOCK_SCOPE())
            method.return_type = _int_type
            box.declare(loc(), method, null)

            declare_local("b", box.type)

            are_same(_int_type, _typer.try_type(call(member(identifier("b"), "m"))))
        si

        @Test()
        Call_of_unresolvable_callee__types_as_null() is
            build()

            is_null(_typer.try_type(call(identifier("missing"))))
        si

        @Test()
        Call_of_non_function_symbol__types_as_null() is
            build()
            declare_local("x", _int_type)

            is_null(_typer.try_type(call(identifier("x"))))
        si

        @Test()
        Member_call_over_untyped_receiver__types_as_null() is
            build()
            declare_local("b", null)

            is_null(_typer.try_type(call(member(identifier("b"), "m"))))
        si

        // The safety property the store-free analysis relies on: a
        // callee whose return type is a type variable is not usable, so
        // the call types as null rather than a concrete type. Without
        // this the analysis could look up operators on the wrong type
        // and miss a storing member.
        @Test()
        Call_of_function_with_type_variable_return__types_as_null() is
            build()
            let type_variable = FUNCTION_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0).type!
            _scope.declare(loc(), function_group("f", [type_variable]), null)

            is_null(_typer.try_type(call(identifier("f"))))
        si

        @Test()
        Cast_with_explicit_type__types_as_target_type() is
            build()

            are_same(_int_type, _typer.try_type(cast_of(_int_type, identifier("x"))))
        si

        // The context-inferred `cast(x)` form carries no type
        // expression to read a target type from.
        @Test()
        Cast_without_type_expression__types_as_null() is
            build()

            is_null(_typer.try_type(cast_of(null, identifier("x"))))
        si

        // `as_non_optional` clones rather than returning the pre-
        // optional object, so the result is compared by value, not
        // by reference.
        @Test()
        Unwrap__types_as_non_optional_inner_type() is
            build()

            let box_type = named_class("BOX").type!
            declare_local("x", box_type.as_optional())

            let result = _typer.try_type(unwrap(identifier("x")))

            is_true(result? /\ result.is_equivalent_to(box_type) /\ !result.is_optional)
        si

        // Two `Type` objects wrapping the same underlying symbol -
        // reached, for example, through a declared return-type
        // annotation on one candidate and an already-resolved
        // Function.return_type on another - are not one object, so a
        // reference comparison would wrongly disagree. The candidates
        // must still be recognised as agreeing.
        @Test()
        Operator_with_candidates_of_the_same_type_via_different_objects__types_as_their_return_type() is
            build()

            let symbol = named_class("BOX")
            let first_reference = Semantic.Types.NAMED(symbol)
            let second_reference = Semantic.Types.NAMED(symbol)

            are_not_same(first_reference, second_reference)

            let group = FUNCTION_GROUP(loc(), _scope, "+")
            let first = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            first.return_type = first_reference
            let second = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            second.return_type = second_reference
            group.add(first)
            group.add(second)
            _scope.declare(loc(), group, null)

            is_true(_typer.try_type(binary("+", integer_literal(), integer_literal()))?)
        si

        // Candidates that differ only in optionality are still a
        // genuine disagreement - `is_equivalent_to` is `matches` plus
        // the optional flag, so this is not the same case as the
        // different-objects one above.
        @Test()
        Operator_with_candidates_differing_only_by_optionality__types_as_null() is
            build()

            let box_type = named_class("BOX").type!

            let group = FUNCTION_GROUP(loc(), _scope, "+")
            let first = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            first.return_type = box_type
            let second = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "+", Semantic.BLOCK_SCOPE())
            second.return_type = box_type.as_optional()
            group.add(first)
            group.add(second)
            _scope.declare(loc(), group, null)

            is_null(_typer.try_type(binary("+", integer_literal(), integer_literal())))
        si
    si
si
