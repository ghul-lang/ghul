namespace Syntax.UnitTests is
    use Collections.LIST
    use Collections.MAP

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Syntax.Process.STORE_FREE_FACTS
    use Syntax.Process.STORE_FREE_FIXPOINT
    use Syntax.Process.STORE_FREE_INNATES

    use Semantic.Symbols.STORE_FREE_IMPORTS

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.NAMESPACE

    use Function = Semantic.Symbols.Function

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins the store-free fixpoint's graph behaviour: seeding from
    // disqualified bodies and open dispatch, propagation through
    // callee and overrider edges, and the mutual-recursion case that
    // must come out store-free.
    @TestClass()
    class STORE_FREE_FIXPOINT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        global_function(name: string) -> GLOBAL_FUNCTION =>
            GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())

        method(name: string, owner: CLASS) -> INSTANCE_METHOD =>
            INSTANCE_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())

        closed_class(name: string) -> CLASS is
            let result = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())
            result.mark_closed()
            return result
        si

        open_class(name: string) -> CLASS is
            let result = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())
            result.mark_open()
            return result
        si

        facts_for(functions: Collections.Iterable[Function]) -> MAP[Function, STORE_FREE_FACTS] is
            let result = MAP[Function, STORE_FREE_FACTS]()
            for f in functions do
                result[f] = STORE_FREE_FACTS()
            od
            return result
        si

        // Solve and answer for the strict relation: is `f` proven to
        // store nothing at all?
        safe(facts: MAP[Function, STORE_FREE_FACTS], f: Function) -> bool =>
            !STORE_FREE_FIXPOINT().solve(facts).unsafe.contains(f)

        // The construction relation: does `f` write nothing beyond
        // the object it is called to build?
        construction_safe(facts: MAP[Function, STORE_FREE_FACTS], f: Function) -> bool =>
            !STORE_FREE_FIXPOINT().solve(facts).construction_unsafe.contains(f)

        // A reflected function whose owner renders the given ghūl
        // qualified name — the shape STORE_FREE_IMPORTS matches on.
        trusted_import(namespace_name: string, class_name: string, member_name: string) -> INSTANCE_METHOD is
            if !LOCATION.reflected? then
                LOCATION.init_static()
            fi

            let ns = NAMESPACE(loc(), namespace_name, null, ".{namespace_name}", false)
            let owner = CLASS(LOCATION.reflected, LOCATION.reflected, ns, class_name, LIST[string](), Semantic.BLOCK_SCOPE())
            return INSTANCE_METHOD(LOCATION.reflected, LOCATION.reflected, owner, member_name, Semantic.BLOCK_SCOPE())
        si

        @Test()
        Trusted_virtual_import_with_storing_overrider__poisons_the_caller() is
            let to_string_import = trusted_import("Ghul.Intrinsics", "object", "to_string")
            let overrider = method("to_string", closed_class("SHOUTY"))
            to_string_import.add_overrider(overrider)

            let caller = global_function("caller")
            let facts = facts_for([cast Function(caller), cast Function(overrider)])
            facts[caller].add_callee(to_string_import)
            facts[overrider].is_disqualified = true

            is_false(safe(facts, caller))
            is_false(to_string_import.is_store_free)
        si

        @Test()
        Trusted_virtual_import_with_store_free_overrider__keeps_the_caller_safe() is
            let to_string_import = trusted_import("Ghul.Intrinsics", "object", "to_string")
            let overrider = method("to_string", closed_class("QUIET"))
            to_string_import.add_overrider(overrider)

            let caller = global_function("caller")
            let facts = facts_for([cast Function(caller), cast Function(overrider)])
            facts[caller].add_callee(to_string_import)

            is_true(safe(facts, caller))
        si

        @Test()
        Untrusted_import__poisons_the_caller() is
            let mystery = trusted_import("Ghul.Intrinsics", "object", "mystery_method")
            let caller = global_function("caller")
            let facts = facts_for([cast Function(caller)])
            facts[caller].add_callee(mystery)

            is_false(safe(facts, caller))
        si

        @Test()
        Trusted_import_reached_without_a_fixpoint_edge__reads_store_free() is
            // A call in a function-literal body never becomes a fixpoint
            // callee edge, so the import's trust has to hold when
            // is_store_free is queried directly, with no solve run.
            let import_fn = trusted_import("Ghul.Intrinsics", "string", "to_upper")

            is_true(import_fn.is_store_free)
        si

        @Test()
        Curated_bcl_reads__are_trusted_store_free() is
            // Pins the curated entries: a Type.to_string read, the
            // reflected-metadata read on both MemberInfo and
            // ParameterInfo, and the KeyValuePair struct's read-only
            // getters.
            is_true(trusted_import("System", "Type", "to_string").is_store_free)
            is_true(
                trusted_import("System.Reflection", "MemberInfo", "get_custom_attributes_data").is_store_free)
            is_true(
                trusted_import("System.Reflection", "ParameterInfo", "get_custom_attributes_data").is_store_free)
            is_true(trusted_import("Collections", "KEY_VALUE_PAIR", "key").is_store_free)
            is_true(trusted_import("Collections", "KEY_VALUE_PAIR", "value").is_store_free)
        si

        @Test()
        Uncurated_sibling_member__stays_untrusted() is
            // A member sharing the owner with a curated entry but not
            // itself curated must not be swept in by a too-broad match.
            is_false(trusted_import("System", "Type", "get_methods").is_store_free)
        si

        @Test()
        Trusted_import_with_an_overrider__is_not_store_free() is
            // The query-time gate withdraws trust from a virtual import
            // that carries an overrider, deferring to the fixpoint's
            // dispatch-shadow check.
            let import_fn = trusted_import("Ghul.Intrinsics", "object", "to_string")
            import_fn.add_overrider(method("to_string", closed_class("SHOUTY")))

            is_false(import_fn.is_store_free)
        si

        @Test()
        Clean_leaf_function__is_safe() is
            let f = global_function("leaf")
            let facts = facts_for([f])

            is_true(safe(facts, f))
        si

        @Test()
        Disqualified_function__is_not_safe() is
            let f = global_function("storer")
            let facts = facts_for([f])
            facts[f].is_disqualified = true

            is_false(safe(facts, f))
        si

        constructor(name: string) -> INSTANCE_METHOD is
            let result = method(name, closed_class(name))
            result.il_name_override = ".ctor"
            return result
        si

        @Test()
        Constructor_writing_only_its_own_fields__constructs_store_free() is
            // its own-field writes disqualify the strict bit but leave
            // is_construction_disqualified clear, so a construction
            // crossing on it discharges
            let ctor = constructor("BOX")
            let facts = facts_for([cast Function(ctor)])
            facts[ctor].is_disqualified = true

            is_false(safe(facts, ctor))
            is_true(construction_safe(facts, ctor))
        si

        @Test()
        Constructor_writing_a_foreign_slot__does_not_construct_store_free() is
            // a write to something other than the fresh object sets
            // is_construction_disqualified, so construction is not trusted
            let ctor = constructor("LEAK")
            let facts = facts_for([cast Function(ctor)])
            facts[ctor].is_disqualified = true
            facts[ctor].is_construction_disqualified = true

            is_false(construction_safe(facts, ctor))
        si

        // A construction edge is read against the callee's construction
        // bit, so a constructor that writes nothing but the object it is
        // building leaves its caller store-free even though the
        // constructor itself is not.
        @Test()
        Construction_callee_writing_only_its_own_fields__keeps_the_caller_safe() is
            let ctor = constructor("BOX")
            let caller = global_function("make_box")
            let facts = facts_for([cast Function(caller), cast Function(ctor)])
            facts[ctor].is_disqualified = true
            facts[caller].add_construction_callee(ctor)

            is_false(safe(facts, ctor))
            is_true(construction_safe(facts, ctor))
            is_true(safe(facts, caller))
        si

        // The same edge against a constructor that writes something
        // other than the object it is building demotes the caller.
        @Test()
        Construction_callee_writing_a_foreign_slot__demotes_the_caller() is
            let ctor = constructor("LEAK")
            let caller = global_function("make_leak")
            let facts = facts_for([cast Function(caller), cast Function(ctor)])
            facts[ctor].is_disqualified = true
            facts[ctor].is_construction_disqualified = true
            facts[caller].add_construction_callee(ctor)

            is_false(construction_safe(facts, ctor))
            is_false(safe(facts, caller))
        si

        // The construction bit carries its own dispatch shadow, read
        // against the bit under solution rather than the strict one. An
        // override writing nothing but its own state is not store-free,
        // yet reaching it in place of what it overrides still writes
        // only the object under construction — so the construction edge
        // survives it.
        @Test()
        Overrider_writing_only_its_own_fields__keeps_the_construction_edge() is
            let assign = method("$set_x", closed_class("HOLDER"))
            let overrider = method("$set_x", closed_class("SUBHOLDER"))
            assign.add_overrider(overrider)

            let facts = facts_for([cast Function(assign), cast Function(overrider)])
            facts[assign].is_disqualified = true
            facts[overrider].is_disqualified = true

            let ctor = constructor("HOLDER_CTOR")
            facts[ctor] = STORE_FREE_FACTS()
            facts[ctor].is_disqualified = true
            facts[ctor].add_construction_callee(assign)

            is_false(safe(facts, assign))
            is_true(construction_safe(facts, ctor))
        si

        // The soundness half of the same shadow: an override that
        // writes a foreign slot demotes what it overrides, so the
        // construction edge through it goes too.
        @Test()
        Overrider_writing_a_foreign_slot__demotes_the_construction_edge() is
            let assign = method("$set_x", closed_class("HOLDER"))
            let overrider = method("$set_x", closed_class("SUBHOLDER"))
            assign.add_overrider(overrider)

            let facts = facts_for([cast Function(assign), cast Function(overrider)])
            facts[assign].is_disqualified = true
            facts[overrider].is_disqualified = true
            facts[overrider].is_construction_disqualified = true

            let ctor = constructor("LEAKY_HOLDER_CTOR")
            facts[ctor] = STORE_FREE_FACTS()
            facts[ctor].is_disqualified = true
            facts[ctor].add_construction_callee(assign)

            is_false(construction_safe(facts, ctor))
        si

        // The two relations feed each other, so a cycle across
        // construction edges has to converge rather than spin: neither
        // constructor writes anything but the object it is building, so
        // both come out construction-store-free.
        @Test()
        Mutually_constructing_constructors__converge_construction_store_free() is
            let a = constructor("A")
            let b = constructor("B")
            let facts = facts_for([cast Function(a), cast Function(b)])
            facts[a].is_disqualified = true
            facts[b].is_disqualified = true
            facts[a].add_construction_callee(b)
            facts[b].add_construction_callee(a)

            is_true(construction_safe(facts, a))
            is_true(construction_safe(facts, b))
        si

        // The same cycle with one foreign store in it: the demotion has
        // to reach all the way round rather than stopping at the writer.
        @Test()
        Mutually_constructing_constructors_with_a_foreign_store__both_demote() is
            let a = constructor("A_LEAK")
            let b = constructor("B_LEAK")
            let facts = facts_for([cast Function(a), cast Function(b)])
            facts[a].is_disqualified = true
            facts[b].is_disqualified = true
            facts[b].is_construction_disqualified = true
            facts[a].add_construction_callee(b)
            facts[b].add_construction_callee(a)

            is_false(construction_safe(facts, b))
            is_false(construction_safe(facts, a))
        si

        @Test()
        Caller_of_clean_callee__is_safe() is
            let callee = global_function("callee")
            let caller = global_function("caller")
            let facts = facts_for([callee, caller])
            facts[caller].add_callee(callee)

            is_true(safe(facts, caller))
        si

        @Test()
        Caller_of_disqualified_callee__is_not_safe() is
            let callee = global_function("storer")
            let caller = global_function("caller")
            let facts = facts_for([callee, caller])
            facts[callee].is_disqualified = true
            facts[caller].add_callee(callee)

            is_false(safe(facts, caller))
        si

        @Test()
        Unsafety_propagates_through_call_chains() is
            let a = global_function("a")
            let b = global_function("b")
            let c = global_function("c")
            let facts = facts_for([a, b, c])
            facts[a].add_callee(b)
            facts[b].add_callee(c)
            facts[c].is_disqualified = true

            is_false(safe(facts, a))
            is_false(safe(facts, b))
        si

        @Test()
        Caller_of_unwalked_callee__is_not_safe() is
            let external = global_function("imported")
            let caller = global_function("caller")
            let facts = facts_for([caller])
            facts[caller].add_callee(external)

            is_false(safe(facts, caller))
        si

        @Test()
        Mutually_recursive_clean_functions__are_safe() is
            let ping = global_function("ping")
            let pong = global_function("pong")
            let facts = facts_for([ping, pong])
            facts[ping].add_callee(pong)
            facts[pong].add_callee(ping)

            is_true(safe(facts, ping))
            is_true(safe(facts, pong))
        si

        @Test()
        Clean_method_with_storing_override__is_not_safe() is
            let base_owner = closed_class("QUIET")
            let derived_owner = closed_class("NOISY")
            let base_method = method("calm", base_owner)
            let override_method = method("calm", derived_owner)
            base_method.add_overrider(override_method)

            let facts = facts_for([base_method, override_method])
            facts[override_method].is_disqualified = true

            is_false(safe(facts, base_method))
            is_false(safe(facts, override_method))
        si

        @Test()
        Clean_method_with_clean_override__is_safe() is
            let base_owner = closed_class("QUIET")
            let derived_owner = closed_class("CALM")
            let base_method = method("calm", base_owner)
            let override_method = method("calm", derived_owner)
            base_method.add_overrider(override_method)

            let facts = facts_for([base_method, override_method])

            is_true(safe(facts, base_method))
            is_true(safe(facts, override_method))
        si

        @Test()
        Clean_method_on_open_class__is_not_safe() is
            let owner = open_class("LOUD")
            let m = method("shout", owner)

            let facts = facts_for([m])

            is_false(safe(facts, m))
        si

        @Test()
        Clean_method_on_closed_class__is_safe() is
            let owner = closed_class("QUIET")
            let m = method("calm", owner)

            let facts = facts_for([m])

            is_true(safe(facts, m))
        si
    si

    // Pins the innate allowlist: value arithmetic, comparisons,
    // boolean logic and reads are store-free; assignment through a
    // reference or pointer, unqualified names and unknown families
    // are not.
    @TestClass()
    class STORE_FREE_INNATES_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        qualified(family: string, leaf: string) -> Syntax.Trees.Identifiers.Identifier =>
            Syntax.Trees.Identifiers.QUALIFIED(
                loc(),
                Syntax.Trees.Identifiers.Identifier(loc(), family),
                leaf,
                loc(),
                loc()
            )

        @Test()
        Arithmetic_add__is_store_free() is
            is_true(STORE_FREE_INNATES.is_store_free(qualified("arithmetic", "add")))
        si

        @Test()
        Compare_order__is_store_free() is
            is_true(STORE_FREE_INNATES.is_store_free(qualified("compare", "order")))
        si

        @Test()
        Reference_read__is_store_free() is
            is_true(STORE_FREE_INNATES.is_store_free(qualified("reference", "read")))
        si

        @Test()
        Reference_assign__is_not_store_free() is
            is_false(STORE_FREE_INNATES.is_store_free(qualified("reference", "assign")))
        si

        @Test()
        Pointer_assign__is_not_store_free() is
            is_false(STORE_FREE_INNATES.is_store_free(qualified("pointer", "assign")))
        si

        @Test()
        Unknown_family__is_not_store_free() is
            is_false(STORE_FREE_INNATES.is_store_free(qualified("mystery", "op")))
        si

        @Test()
        Unqualified_name__is_not_store_free() is
            is_false(STORE_FREE_INNATES.is_store_free(Syntax.Trees.Identifiers.Identifier(loc(), "add")))
        si

        @Test()
        Null_name__is_not_store_free() is
            is_false(STORE_FREE_INNATES.is_store_free(null))
        si
    si

    // Pins the trusted-import matcher: entries key on the owner's
    // ghūl-side qualified name plus the member name, and only
    // reflected functions can match.
    @TestClass()
    class STORE_FREE_IMPORTS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        import_named(namespace_name: string, class_name: string, member_name: string, reflected: bool) -> INSTANCE_METHOD is
            if !LOCATION.reflected? then
                LOCATION.init_static()
            fi

            let ns = NAMESPACE(loc(), namespace_name, null, ".{namespace_name}", false)
            let location = if reflected then LOCATION.reflected else loc() fi
            let owner = CLASS(location, location, ns, class_name, LIST[string](), Semantic.BLOCK_SCOPE())
            return INSTANCE_METHOD(location, location, owner, member_name, Semantic.BLOCK_SCOPE())
        si

        @Test()
        Listed_reflected_member__is_trusted() is
            let f = import_named("Ghul.Intrinsics", "string", "index_of", true)
            is_true(
                STORE_FREE_IMPORTS.is_store_free(f),
                "key='{f.owner!.qualified_name}.{f.name}' reflected={f.is_reflected}"
            )
        si

        @Test()
        Listed_collection_read__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("Collections", "STACK", "peek", true)))
        si

        @Test()
        Listed_char_classifier__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("Ghul.Intrinsics", "char", "is_digit", true)))
        si

        @Test()
        Listed_string_transform__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("Ghul.Intrinsics", "string", "trim", true)))
        si

        @Test()
        Listed_path_op__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("IO", "Path", "combine", true)))
        si

        @Test()
        Listed_object_get_type__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("Ghul.Intrinsics", "object", "get_type", true)))
        si

        @Test()
        Listed_string_builder_read__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("Text", "STRING_BUILDER", "to_string", true)))
        si

        @Test()
        Listed_reflected_type_name_getter__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("System", "Type", "$get_full_name", true)))
        si

        @Test()
        Listed_keyvaluepair_constructor__is_trusted() is
            is_true(STORE_FREE_IMPORTS.is_store_free(import_named("Collections", "KEY_VALUE_PAIR", "init", true)))
        si

        @Test()
        Unlisted_member__is_not_trusted() is
            is_false(STORE_FREE_IMPORTS.is_store_free(import_named("Ghul.Intrinsics", "string", "normalize", true)))
        si

        // Convert.to_int32 is JetBrains-Pure and looks like a value
        // conversion, but its object overload dispatches through
        // IConvertible on a user-typed argument, which can store. It
        // stays off the list by name.
        @Test()
        Convert_conversion__is_not_trusted() is
            is_false(STORE_FREE_IMPORTS.is_store_free(import_named("System", "Convert", "to_int32", true)))
        si

        @Test()
        Listed_name_on_unreflected_function__is_not_trusted() is
            is_false(STORE_FREE_IMPORTS.is_store_free(import_named("Ghul.Intrinsics", "string", "index_of", false)))
        si

        @Test()
        Null_function__is_not_trusted() is
            is_false(STORE_FREE_IMPORTS.is_store_free(null))
        si
    si
si
