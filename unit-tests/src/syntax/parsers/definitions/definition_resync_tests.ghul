namespace Syntax.Parsers.Definitions.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Syntax.Parsers.CONTEXT
    use Syntax.Parsers.Definitions.DEFINITION_RESYNC

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins where a definition list picks up again after a definition that
    // reported an error: the start of the next line, a keyword that only a
    // definition begins with, or a token an open construct is waiting for.
    @TestClass()
    class DEFINITION_RESYNC_TESTS is
        init() is si

        context_over(source: string) -> CONTEXT is
            let logger = Logging.DIAGNOSTICS_STORE()

            return CONTEXT(
                Lexical.TOKEN_LOOKAHEAD(
                    Lexical.TOKEN_QUEUE(64),
                    Lexical.TOKENIZER(logger, "test.ghul", IO.StringReader(source), false)),
                logger)
        si

        // Consumes `count` tokens as a failed definition attempt would, then
        // reports an error, and recovers from there.
        recover_after(context: CONTEXT, count: int, with_error: bool) is
            let attempt_start = context.location
            let errors_before = context.logger.error_count

            for i in 0..count do
                context.next_token()
            od

            if with_error then
                context.error(context.location, "test-diagnostic", "test error")
            fi

            DEFINITION_RESYNC().recover(context, attempt_start, errors_before)
        si

        @Test()
        recover__without_an_error__skips_nothing() is
            let context = context_over("a b ) c\nd\n")

            recover_after(context, 2, false)

            are_equal(Lexical.TOKEN.PAREN_CLOSE, context.current_token)
        si

        @Test()
        recover__after_an_error__skips_to_the_next_line() is
            let context = context_over("a b ) -> c\nd\n")

            recover_after(context, 2, true)

            are_equal("d", context.current.value_string)
        si

        @Test()
        recover__after_an_error_with_no_progress__moves_past_at_least_one_token() is
            let context = context_over(") ) \nd\n")

            recover_after(context, 0, true)

            are_equal("d", context.current.value_string)
        si

        @Test()
        recover__stops_at_a_keyword_only_a_definition_begins_with() is
            let context = context_over("a b ) class C\n")

            recover_after(context, 2, true)

            are_equal(Lexical.TOKEN.CLASS, context.current_token)
        si

        @Test()
        recover__stops_at_a_token_an_open_construct_awaits() is
            let context = context_over("a b ) si\n")

            context.push_awaited_enders(LIST[Lexical.TOKEN]([Lexical.TOKEN.SI]))

            recover_after(context, 2, true)

            are_equal(Lexical.TOKEN.SI, context.current_token)
        si
    si
si
