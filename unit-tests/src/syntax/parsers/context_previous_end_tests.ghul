namespace Syntax.Parsers.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Collections

    use Source.LOCATION

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    class FAKE_TOKENS: Lexical.TokenSource is
        _tokens: Iterator[Lexical.TOKEN_PAIR]

        init(tokens: Iterable[Lexical.TOKEN_PAIR]) is
            _tokens = tokens.iterator
        si

        read_token() -> Lexical.TOKEN_PAIR is
            if _tokens.move_next() then
                return _tokens.current
            fi

            return Lexical.TOKEN_PAIR(Lexical.TOKEN.END_OF_INPUT, LOCATION("test.ghul", 9, 1, 9, 1), "")
        si

        expect_format_specifier() is si
    si

    // CONTEXT.previous_end is where an inferred statement terminator is
    // recorded, so it has to name the end of the token before `current` at
    // every point a parser might ask - including after a speculation that
    // backtracks, which restores the token stream underneath it.
    @TestClass()
    class CONTEXT_PREVIOUS_END_TESTS is
        init() is si

        // One identifier per line, so each token's end is distinguishable.
        token(line: int) -> Lexical.TOKEN_PAIR =>
            Lexical.TOKEN_PAIR(
                Lexical.TOKEN.IDENTIFIER,
                LOCATION("test.ghul", line, 1, line, 4),
                "t{line}"
            )

        context_over(lines: int[]) -> CONTEXT is
            let queue = Lexical.TOKEN_QUEUE(64)
            let source = FAKE_TOKENS(lines |> Ghul.Pipes.map(l => token(l)) |> Ghul.Pipes.collect())

            return CONTEXT(Lexical.TOKEN_LOOKAHEAD(queue, source), Logging.DIAGNOSTICS_STORE())
        si

        @Test()
        previous_end_names_the_token_before_current() is
            let context = context_over(LIST([1, 2, 3]))

            context.next_token()

            are_equal(1, context.previous_end.end_line, "after one advance, the token before current is line 1")
            are_equal(2, context.location.start_line, "and current is line 2")
        si

        // The bug this pins: recomputing previous_end from the token
        // backtracked *to* names where the parser now is, not where the
        // construct before it ended - so a terminator inferred right after
        // a backtrack was recorded on the following construct.
        @Test()
        previous_end_is_restored_by_a_backtrack_not_recomputed() is
            let context = context_over(LIST([1, 2, 3, 4]))

            // Consume line 1, so previous_end names it.
            context.next_token()

            are_equal(1, context.previous_end.end_line)

            // Speculate forward over two more tokens, then give them back.
            context.tokenizer_speculate()
            context.next_token()
            context.next_token()

            are_equal(3, context.previous_end.end_line, "inside the speculation previous_end moves with it")

            context.tokenizer_backtrack()

            are_equal(
                1,
                context.previous_end.end_line,
                "a backtrack restores the position the speculation started from, rather than naming the restored token itself"
            )
        si

        @Test()
        previous_end_survives_a_committed_speculation() is
            let context = context_over(LIST([1, 2, 3, 4]))

            context.next_token()

            context.tokenizer_speculate()
            context.next_token()
            context.tokenizer_commit()

            are_equal(
                2,
                context.previous_end.end_line,
                "a committed speculation keeps the position it reached"
            )
        si

        @Test()
        nested_speculations_unwind_in_order() is
            let context = context_over(LIST([1, 2, 3, 4, 5]))

            context.next_token()

            context.tokenizer_speculate()
            context.next_token()

            context.tokenizer_speculate()
            context.next_token()

            context.tokenizer_backtrack()
            are_equal(2, context.previous_end.end_line, "the inner backtrack restores the inner mark")

            context.tokenizer_backtrack()
            are_equal(1, context.previous_end.end_line, "the outer backtrack restores the outer mark")
        si
    si
si
