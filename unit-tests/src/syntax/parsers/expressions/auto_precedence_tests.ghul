namespace Syntax.Parsers.Expressions.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Parsers.Expressions.EXPRESSION
    use Syntax.Parsers.Expressions.PRECEDENCE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class AUTO_PRECEDENCE_TESTS is
        init() is si

        @Test()
        Multiplication_first_char_should_be_MULTIPLICATION() is
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("*"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("/"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("%"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("×"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("÷"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("✕"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("⊗"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("⊘"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("⊙"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("⋅"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("∗"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("**"))
            are_equal(PRECEDENCE.MULTIPLICATION, EXPRESSION.auto_precedence_for("*="))
        si

        @Test()
        Addition_first_char_should_be_ADDITION() is
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("+"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("-"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("⊕"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("⊖"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("±"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("∓"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("++"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("+-"))
            are_equal(PRECEDENCE.ADDITION, EXPRESSION.auto_precedence_for("-->"))
        si

        @Test()
        Single_angle_bracket_should_be_RELATIONAL() is
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("<"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for(">"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("<="))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for(">="))
        si

        @Test()
        Doubled_angle_bracket_should_be_SHIFT() is
            are_equal(PRECEDENCE.SHIFT, EXPRESSION.auto_precedence_for("<<"))
            are_equal(PRECEDENCE.SHIFT, EXPRESSION.auto_precedence_for(">>"))
            are_equal(PRECEDENCE.SHIFT, EXPRESSION.auto_precedence_for("<<<"))
            are_equal(PRECEDENCE.SHIFT, EXPRESSION.auto_precedence_for(">>="))
        si

        @Test()
        Equality_family_should_be_RELATIONAL() is
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("=="))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("!="))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("=~"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("!~"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("≈"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("≡"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("≉"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("≢"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("≠"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("≤"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("≥"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("∈"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("∉"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("∋"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("⊂"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("⊃"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("⊆"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("⊇"))
            are_equal(PRECEDENCE.RELATIONAL, EXPRESSION.auto_precedence_for("~"))
        si

        @Test()
        Range_digraphs_should_be_RANGE() is
            are_equal(PRECEDENCE.RANGE, EXPRESSION.auto_precedence_for(".."))
            are_equal(PRECEDENCE.RANGE, EXPRESSION.auto_precedence_for("::"))
        si

        @Test()
        Boolean_digraphs_should_be_BOOLEAN() is
            are_equal(PRECEDENCE.BOOLEAN, EXPRESSION.auto_precedence_for("/\\"))
            are_equal(PRECEDENCE.BOOLEAN, EXPRESSION.auto_precedence_for("\\/"))
            are_equal(PRECEDENCE.BOOLEAN, EXPRESSION.auto_precedence_for("∧"))
            are_equal(PRECEDENCE.BOOLEAN, EXPRESSION.auto_precedence_for("∨"))
        si

        @Test()
        Bitwise_first_char_should_be_BITWISE() is
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("&"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("|"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("¦"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("^"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("∩"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("∪"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("⊻"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("⊼"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("⊽"))
            // doubled `|` falls through to BITWISE since the table lookup
            // happens before the heuristic; tested here for the heuristic
            // case anyway since YIELD only kicks in via _precedence.
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("||"))
            are_equal(PRECEDENCE.BITWISE, EXPRESSION.auto_precedence_for("&&"))
        si

        @Test()
        Unrecognised_first_char_should_default_to_USER_5() is
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("@"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("@@"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("##"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("$$"))
        si

        @Test()
        Unmapped_math_symbols_should_default_to_USER_5() is
            // The boxed family duplicates the circled one, `∘` composes
            // rather than multiplies, and `≪`/`≫` read as a shift to a
            // programmer and as an ordering to a mathematician. Each is
            // left for `@precedence` to place rather than guessed at.
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("⊞"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("⊟"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("⊠"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("⊡"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("∘"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("≪"))
            are_equal(PRECEDENCE.USER_5, EXPRESSION.auto_precedence_for("≫"))
        si

        @Test()
        Question_first_char_should_be_USER_1() is
            are_equal(PRECEDENCE.USER_1, EXPRESSION.auto_precedence_for("??"))
            are_equal(PRECEDENCE.USER_1, EXPRESSION.auto_precedence_for("?>"))
            are_equal(PRECEDENCE.USER_1, EXPRESSION.auto_precedence_for("?|"))
        si
    si
si
