namespace Syntax.Parsers.Expressions.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Parsers.Expressions.ASSOCIATIVITY
    use Syntax.Parsers.Expressions.EXPRESSION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class AUTO_ASSOCIATIVITY_TESTS is
        init() is si

        @Test()
        Question_first_char_should_be_RIGHT() is
            are_equal(ASSOCIATIVITY.RIGHT, EXPRESSION.auto_associativity_for("??"))
            are_equal(ASSOCIATIVITY.RIGHT, EXPRESSION.auto_associativity_for("?>"))
            are_equal(ASSOCIATIVITY.RIGHT, EXPRESSION.auto_associativity_for("?."))
        si

        @Test()
        Other_first_chars_should_be_LEFT() is
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("+"))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("-"))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("*"))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("=="))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("/\\"))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("\\/"))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("::"))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("^"))
            are_equal(ASSOCIATIVITY.LEFT, EXPRESSION.auto_associativity_for("##"))
        si
    si
si
