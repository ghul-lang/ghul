namespace Syntax.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Syntax.Process.NARROW_ENV
    use Syntax.Process.NARROWING_FLOW

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INSTANCE_FIELD
    use Semantic.Symbols.INSTANCE_PROPERTY
    use Semantic.Symbols.LOCAL_VARIABLE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins the flow transfers' kill asymmetry across the three
    // narrowing subject kinds: locals survive everything short of
    // their own reassignment, fields die on calls but survive stores
    // to other slots, properties die on both calls and heap stores.
    @TestClass()
    class NARROWING_FLOW_PROPERTY_TESTS is
        init() is
            Fixtures.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        logger() -> Logging.Logger => Logging.DIAGNOSTICS_STORE()

        owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](), Semantic.BLOCK_SCOPE())

        local_symbol() -> LOCAL_VARIABLE => LOCAL_VARIABLE(loc(), Semantic.BLOCK_SCOPE(), "l")

        field_symbol() -> INSTANCE_FIELD => INSTANCE_FIELD(loc(), owner(), "f")

        property_symbol() -> INSTANCE_PROPERTY =>
            INSTANCE_PROPERTY(loc(), loc(), owner(), "p", false, false)

        flow_with_non_null(symbols: Collections.Iterable[Semantic.Symbols.Symbol]) -> NARROWING_FLOW is
            let flow = NARROWING_FLOW(logger())
            let env = NARROW_ENV()

            for s in symbols do
                env.set_non_null(s)
            od

            flow.set_env(env)

            return flow
        si

        @Test()
        Call_transfer__keeps_facts_and_records_the_crossing() is
            let l = local_symbol()
            let f = field_symbol()
            let p = property_symbol()

            let flow = flow_with_non_null([cast Semantic.Symbols.Symbol(l), cast Semantic.Symbols.Symbol(f), cast Semantic.Symbols.Symbol(p)])

            flow.on_call(loc())

            // narrowing is optimistic: every fact survives the call.
            // A local takes no crossing - a callee cannot reach it -
            // while the heap facts are left unvalidated by the
            // unattributed crossing, so a use would be an error.
            is_true(flow.is_non_null(l))
            is_true(flow.is_non_null(f))
            is_true(flow.is_non_null(p))
            is_true(flow.symbol_fact_validated(cast Semantic.Symbols.Symbol(l)))
            is_false(flow.symbol_fact_validated(cast Semantic.Symbols.Symbol(f)))
            is_false(flow.symbol_fact_validated(cast Semantic.Symbols.Symbol(p)))
        si

        @Test()
        Heap_store_transfer__forgets_properties_only() is
            let l = local_symbol()
            let f = field_symbol()
            let p = property_symbol()

            let flow = flow_with_non_null([cast Semantic.Symbols.Symbol(l), cast Semantic.Symbols.Symbol(f), cast Semantic.Symbols.Symbol(p)])

            flow.on_heap_store(loc())

            is_true(flow.is_non_null(l))
            is_true(flow.is_non_null(f))
            is_false(flow.is_non_null(p))
        si

        @Test()
        Assignment_transfer__forgets_only_the_target() is
            let f = field_symbol()
            let p = property_symbol()

            let flow = flow_with_non_null([cast Semantic.Symbols.Symbol(f), cast Semantic.Symbols.Symbol(p)])

            flow.on_assignment(p, loc(), null)

            is_true(flow.is_non_null(f))
            is_false(flow.is_non_null(p))
        si
    si
si
