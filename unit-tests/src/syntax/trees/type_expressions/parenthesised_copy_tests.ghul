namespace Syntax.Trees.TypeExpressions.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Semantic.Symbols.TypeParameterConstraintKind
    use Syntax.Process.Printer.FORMATTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A type expression's `parenthesised` mark - the source wrapped the
    // type in a group - has to survive copy(), or a copied tree formats
    // to source that parses differently. The other copy() implementations
    // set it by hand; these pin the same for the structured types and the
    // kind constraint, and pin that the formatter writes a marked
    // constraint's parentheses back.
    @TestClass()
    class TYPE_EXPRESSION_PARENTHESISED_COPY_TESTS is
        init() is si

        loc: Source.LOCATION => Source.LOCATION("test.ghul", 1, 1, 1, 1)

        named(s: string) -> NAMED => NAMED(loc, Trees.Identifiers.Identifier(loc, s))

        format(node: Trees.Node) -> string =>
            FORMATTER(Collections.LIST[Lexical.TRIVIA](), 100).format(node)

        @Test()
        a_copied_array_type_keeps_its_parentheses() is
            let t = ARRAY_(loc, named("int"), false)
            t.parenthesised = true

            is_true(t.copy().parenthesised)
        si

        @Test()
        a_copied_optional_type_keeps_its_parentheses() is
            let t = OPTIONAL(loc, named("int"))
            t.parenthesised = true

            is_true(t.copy().parenthesised)
        si

        @Test()
        a_copied_unmarked_type_stays_unmarked() is
            is_false(ARRAY_(loc, named("int"), false).copy().parenthesised)
        si

        @Test()
        a_copied_kind_constraint_keeps_its_parentheses() is
            let t = TYPE_PARAMETER_CONSTRAINT(loc, TypeParameterConstraintKind.REFERENCE)
            t.parenthesised = true

            is_true(t.copy().parenthesised)
        si

        @Test()
        a_marked_kind_constraint_formats_with_parentheses() is
            let element = NAMED_TUPLE_ELEMENT(
                loc,
                Trees.Identifiers.Identifier(loc, "T"),
                TYPE_PARAMETER_CONSTRAINT(loc, TypeParameterConstraintKind.REFERENCE)
            )

            element.type_expression.parenthesised = true

            are_equal("T: (class)\n", format(element))
        si
    si
si
