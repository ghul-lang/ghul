namespace Syntax.Trees.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Trees.Expressions.CALL
    use Trees.Expressions.IDENTIFIER
    use Trees.Expressions.PARTIAL_APPLICATION
    use Trees.Expressions.PLACEHOLDER
    use Trees.Expressions.Expression
    use ExpressionList = Trees.Expressions.LIST
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The AST-level contract of PARTIAL_APPLICATION: it gathers the `*`
    // arguments of its call in order, tells each which application it
    // belongs to and which parameter it stands for, and a `*` is what
    // makes an argument list a partial application at all.
    @TestClass()
    class PARTIAL_APPLICATION_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        name(text: string) -> IDENTIFIER => IDENTIFIER(loc(), Trees.Identifiers.Identifier(loc(), text))

        arguments(elements: Expression[]) -> ExpressionList => ExpressionList(loc(), LIST[Expression](elements))

        call(elements: Expression[]) -> CALL => CALL(loc(), name("f"), arguments(elements))

        @Test()
        has_placeholder__should_be_false_without_a_star() is
            is_false(PARTIAL_APPLICATION.has_placeholder(arguments([name("a"), name("b")])))
        si

        @Test()
        has_placeholder__should_be_true_with_a_star_anywhere() is
            is_true(PARTIAL_APPLICATION.has_placeholder(arguments([name("a"), PLACEHOLDER(loc())])))
        si

        @Test()
        placeholders__should_be_the_stars_in_argument_order() is
            let first = PLACEHOLDER(loc())
            let second = PLACEHOLDER(loc())

            let application = PARTIAL_APPLICATION(loc(), call([first, name("a"), second]))

            are_equal(2, application.placeholders.count)
            is_true(application.placeholders[0] == first)
            is_true(application.placeholders[1] == second)
        si

        @Test()
        placeholders__should_know_their_owner_and_index() is
            let first = PLACEHOLDER(loc())
            let second = PLACEHOLDER(loc())

            let application = PARTIAL_APPLICATION(loc(), call([name("a"), first, second]))

            is_true(first.owner == application)
            is_true(second.owner == application)
            are_equal(0, first.index)
            are_equal(1, second.index)
        si

        @Test()
        placeholder__should_await_its_type_from_the_context() is
            is_true(PLACEHOLDER(loc()).awaits_context_type)
        si

        @Test()
        placeholder_outside_a_call__should_have_no_owner() is
            is_false(PLACEHOLDER(loc()).owner?)
        si
    si
si
