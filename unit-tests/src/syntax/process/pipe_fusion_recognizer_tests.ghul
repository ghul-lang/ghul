namespace Syntax.Process.UnitTests is
    use Collections.Iterable
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION


    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.GLOBAL_FUNCTION

    use Semantic.Types.Type
    use Semantic.Types.GENERIC

    use Syntax.Process.PIPE_FUSION_RECOGNIZER
    use Syntax.Process.NESTED_LITERAL_COLLECTOR
    use Syntax.Trees.Expressions.IDENTIFIER

    use Syntax.Trees.Expressions.Expression
    use Syntax.Trees.Expressions.CALL
    use Syntax.Trees.Expressions.CAST
    use Syntax.Trees.Expressions.FUNCTION
    use Syntax.Trees.Expressions.Literals.BOOLEAN
    use ExpressionList = Syntax.Trees.Expressions.LIST
    use Syntax.Trees.TypeExpressions.NAMED
    use Syntax.Trees.TypeExpressions.INFER
    use Syntax.Trees.Bodies.EXPRESSION
    use Syntax.Trees.Identifiers.Identifier

    use GlobalCall = IR.Values.Call.GLOBAL
    use TempLoad = IR.Values.Load.TEMP
    use IR.Values.Value
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins PIPE_FUSION_RECOGNIZER.recognize_free_function_chain - which
    // calls the peel loop accepts as a fusible stage, and what it leaves as
    // the chain's source. The end-to-end fusion is covered by the execution
    // tests under integration-tests/execution/pipe-fusion-*; this fixture
    // works against stand-in symbols so a change to what counts as a stage
    // cannot drift silently.
    @TestClass()
    class PIPE_FUSION_RECOGNIZER_TESTS is
        // The stage roles the recognizer covers; stand-in functions with
        // these names register into the recognizer's role map below, the
        // way the innate lookup's resolution would for the real symbols.
        FUSIBLE_STAGE_ROLES: LIST[string] static

        _fusion_functions: Collections.MAP[Semantic.Symbols.Symbol, string]

        init() is
            FUSIBLE_STAGE_ROLES = LIST[string](["map", "filter", "take", "skip", "memo"])
            _fusion_functions = Collections.MAP[Semantic.Symbols.Symbol, string]()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]()
            for v in values do result.add(v); od
            return result
        si

        types(values: Iterable[Type]) -> LIST[Type] is
            let result = LIST[Type]()
            for v in values do result.add(v); od
            return result
        si

        recognizer() -> PIPE_FUSION_RECOGNIZER => PIPE_FUSION_RECOGNIZER(_fusion_functions)

        int_class() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", empty_names(), Semantic.BLOCK_SCOPE())

        // The tests below pin recognize_free_function_chain - the peel loop
        // over a `|>`-desugared Ghul.Pipes call chain. `|>` inserts the
        // threaded value as argument 0 and resolves the call like any other
        // before this pass runs, so the recognizer never sees a receiver or
        // a `pipe()` wrap - only a CALL whose compiled `.value` is an
        // IR.Values.Call.GLOBAL naming the resolved function. These fixtures
        // fake that post-compile state directly (compile_expressions_state
        // is a settable field) rather than compiling real source.
        placeholder() -> Expression => BOOLEAN(loc(), "true")

        pipes_namespace() -> NAMESPACE => NAMESPACE(loc(), "Pipes", null, ".Ghul.Pipes", false)

        // A resolved call to Ghul.Pipes.<name>(args...), as `|>` desugaring
        // and overload resolution would leave it - a plain global-function
        // call, never a MEMBER, regardless of what `name` is.
        pipes_call(name: string, arguments: Iterable[Expression]) -> CALL is
            let call = CALL(loc(), placeholder(), ExpressionList(loc(), arguments))
            let function = GLOBAL_FUNCTION(loc(), loc(), pipes_namespace(), name, pipes_namespace())

            if FUSIBLE_STAGE_ROLES.contains(name) then
                _fusion_functions[function] = name
            fi

            call.compile_expressions_state.value = GlobalCall(function, LIST[Value](), int_class().type!)

            return call
        si

        // A chain's base: a plain value with a resolved, non-optional type -
        // stands in for a variable holding an array/list/Iterable.
        source_expression() -> Expression is
            let e = placeholder()

            e.compile_expressions_state.value = TempLoad(IR.LOCAL("source", int_class().type!))

            return e
        si

        // A single covered stage (map) peels to one non-filter, non-guarded
        // fusion rooted at the source.
        @Test()
        Calling__recognize_free_function_chain__with_single_map_call__builds_one_stage() is
            let source = source_expression()
            let call = pipes_call("map", [source, placeholder()])

            let fusion = recognizer().recognize_free_function_chain(call)

            is_true(fusion?)
            are_same(source, fusion!.source)
            are_equal(1, fusion!.stages_outermost_first.count)
            is_false(fusion!.stages_outermost_first[0].is_filter)
        si

        // `xs |> filter(p) |> map(f)` desugars to map(filter(xs, p), f) - the
        // peel loop must walk more than one layer, outermost first.
        @Test()
        Calling__recognize_free_function_chain__with_filter_then_map__peels_both_stages() is
            let source = source_expression()
            let filter_call = pipes_call("filter", [source, placeholder()])
            let map_call = pipes_call("map", [filter_call, placeholder()])

            let fusion = recognizer().recognize_free_function_chain(map_call)

            is_true(fusion?)
            are_same(source, fusion!.source)
            are_equal(2, fusion!.stages_outermost_first.count)
            is_false(fusion!.stages_outermost_first[0].is_filter)
            is_true(fusion!.stages_outermost_first[1].is_filter)
        si

        // take/skip carry a running counter rather than a lambda - a
        // distinct PIPE_FUSION_STAGE shape from map/filter that still needs
        // pinning on the free-function path.
        @Test()
        Calling__recognize_free_function_chain__with_take_call__builds_countdown_stage() is
            let source = source_expression()
            let call = pipes_call("take", [source, placeholder()])

            let fusion = recognizer().recognize_free_function_chain(call)

            is_true(fusion?)
            are_equal(1, fusion!.stages_outermost_first.count)
            is_true(fusion!.stages_outermost_first[0].is_countdown)
        si

        // `zip` is a real Ghul.Pipes function but not one the free-function
        // recognizer covers (a two-source stage) - the peel loop must stop
        // there rather than misclassify it, which leaves the `zip` call
        // itself as the chain's source and the chain carrying no stage.
        // The consumer then drives `zip`'s own result, exactly as an
        // ordinary `for` over it would.
        @Test()
        Calling__recognize_free_function_chain__with_uncovered_pipes_function__stops_at_that_call() is
            let source = source_expression()
            let call = pipes_call("zip", [source, placeholder()])

            let fusion = recognizer().recognize_free_function_chain(call)

            is_true(fusion?)
            are_equal(0, fusion!.stages_outermost_first.count)
            are_same(call, fusion!.source)
        si

        // A call whose resolved value isn't a global-function call at all
        // (e.g. an instance method call) is never a fusible stage, so it
        // ends the peel and becomes the chain's source rather than one of
        // its stages.
        @Test()
        Calling__recognize_free_function_chain__with_non_global_call__stops_at_that_call() is
            let call = CALL(loc(), placeholder(), ExpressionList(loc(), [placeholder()]))

            call.compile_expressions_state.value = TempLoad(IR.LOCAL("not-a-call", int_class().type!))

            let fusion = recognizer().recognize_free_function_chain(call)

            is_true(fusion?)
            are_equal(0, fusion!.stages_outermost_first.count)
            are_same(call, fusion!.source)
        si
    si

    // Pins INLINE_DISQUALIFYING_SCANNER - the guard that keeps Stage-B
    // pipe-fusion inlining away from a lambda body containing `cast`
    // (its placeholder value only gets filled on the delegate-function
    // compilation path, not the harvested-IR inlining path). Covered
    // end-to-end by integration-tests/execution/pipe-fusion-inline-cast-fallback.
    @TestClass()
    class INLINE_DISQUALIFYING_SCANNER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        bool_expr() -> Expression => BOOLEAN(loc(), "true")

        named_type() -> NAMED => NAMED(loc(), Identifier(loc(), "T"))

        // Every literal in the body, at any depth, so each one's captures
        // can be dropped before the body is walked inline.
        @Test()
        Calling__collect__with_a_literal_nested_two_deep__returns_both() is
            let innermost = FUNCTION(loc(), ExpressionList(loc(), Collections.LIST[Expression]()), INFER(loc()), EXPRESSION(loc(), IDENTIFIER(loc(), Identifier(loc(), "k"))), false)
            let outer = FUNCTION(loc(), ExpressionList(loc(), Collections.LIST[Expression]()), INFER(loc()), EXPRESSION(loc(), innermost), false)

            are_equal(2, NESTED_LITERAL_COLLECTOR().collect(EXPRESSION(loc(), outer)).count)
        si

        // A body with no literal in it has nothing to reset.
        @Test()
        Calling__collect__with_no_literal_in_the_body__returns_nothing() is
            let body = EXPRESSION(loc(), IDENTIFIER(loc(), Identifier(loc(), "n")))

            are_equal(0, NESTED_LITERAL_COLLECTOR().collect(body).count)
        si
    si
si
