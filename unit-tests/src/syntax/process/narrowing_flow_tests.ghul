namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.Variable
    use Semantic.Symbols.INSTANCE_FIELD
    use Semantic.Symbols.GLOBAL_VARIABLE
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Types.INTERSECTION
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for NARROWING_FLOW's call transfer and the assignment-receiver
    // shield. A call drops no fact: it is recorded as a crossing against
    // the heap facts live over it, and a later use that leans on one is
    // judged against its crossings. A local takes no crossings (a callee
    // cannot reach it), and a shielded receiver's release reports no hit,
    // since nothing marks the shield any more.
    @TestClass()
    class NARROWING_FLOW_TESTS is
        init() is
            Fixtures.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        logger() -> Logging.Logger => Logging.DIAGNOSTICS_STORE()
        empty_names() -> LIST[string] => LIST[string]()

        make_owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestOwner", empty_names(), Semantic.BLOCK_SCOPE())

        make_field(owner: CLASS, name: string) -> INSTANCE_FIELD =>
            INSTANCE_FIELD(loc(), owner, name)

        make_local(owner: CLASS, name: string) -> LOCAL_VARIABLE =>
            LOCAL_VARIABLE(loc(), owner, name)

        make_global(owner: CLASS, name: string) -> GLOBAL_VARIABLE =>
            GLOBAL_VARIABLE(loc(), owner, name)

        @Test()
        on_call_keeps_field_presence_and_records_a_crossing() is
            let owner = make_owner()
            let f = make_field(owner, "_f")
            let flow = NARROWING_FLOW(logger())

            flow.mark_non_null(f)
            is_true(flow.is_non_null(f))

            let crossings = flow.crossing_mark

            flow.on_call(loc())

            is_true(flow.is_non_null(f))
            is_true(flow.crossing_mark > crossings)
        si

        @Test()
        on_call_keeps_local_presence() is
            let owner = make_owner()
            let x = make_local(owner, "x")
            let flow = NARROWING_FLOW(logger())

            flow.mark_non_null(x)

            flow.on_call(loc())

            is_true(flow.is_non_null(x))
        si

        @Test()
        shielded_field_survives_call_and_release_reports_no_hit() is
            let owner = make_owner()
            let f = make_field(owner, "_f")
            let flow = NARROWING_FLOW(logger())

            flow.mark_non_null(f)

            let frame = flow.push_shield(f)

            flow.on_call(loc())

            is_true(flow.is_non_null(f))

            // Nothing marks a shield hit any more: facts survive a call
            // carrying its crossing, and the assignment's own transfer
            // handles the write the shield surrounded.
            is_false(flow.release_shield(frame))

            flow.forget(f)

            is_false(flow.is_non_null(f))
        si

        make_class_type(name: string) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            c.set_type(Semantic.Types.NAMED(c))
            return c.type!
        si

        make_subclass_type(name: string, base: Type) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            c.set_type(Semantic.Types.NAMED(c))
            c.add_ancestor(base)
            return c.type!
        si

        make_bounded_variable_type(name: string, bound: Type) -> Type is
            let g = Semantic.Symbols.CLASSY_GENERIC_ARGUMENT(loc(), make_owner(), name, 0)
            let bounds = LIST[Type]()
            bounds.add(bound)

            g.set_ancestor_types(bounds)
            return g.type!
        si

        // compose_path_narrow — the shared soundness gate consulted by
        // both `_apply_one` on symbols and the member-load site on
        // paths. Its accepting branches (subtype refine, sibling
        // INTERSECTION) are exercised by the integration fixtures;
        // these unit tests pin the reject / no-op branches so unsound
        // narrows stay out.

        @Test()
        compose_path_narrow_returns_target_when_target_strict_subtypes_loaded() is
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let flow = NARROWING_FLOW(logger())

            let composed = flow.compose_path_narrow(animal, cat)

            are_same(cat, composed)
        si

        @Test()
        compose_path_narrow_narrows_a_bounded_variable_through_its_bound() is
            // A value of `T: Animal` can be a Cat at runtime even though
            // Cat subtypes the bound Animal, not the variable T itself.
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let t = make_bounded_variable_type("T", animal)
            let flow = NARROWING_FLOW(logger())

            are_same(cat, flow.compose_path_narrow(t, cat))
        si

        @Test()
        compose_path_narrow_returns_null_when_target_supertypes_loaded() is
            // Supertype broadening is never sound as a narrow — the
            // loaded value already satisfies the narrower type.
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let flow = NARROWING_FLOW(logger())

            is_null(flow.compose_path_narrow(cat, animal))
        si

        @Test()
        compose_path_narrow_returns_null_when_loaded_equals_effective_target() is
            // No-op when the narrow adds nothing.
            let animal = make_class_type("Animal")
            let flow = NARROWING_FLOW(logger())

            is_null(flow.compose_path_narrow(animal, animal))
        si

        @Test()
        compose_path_narrow_returns_null_on_error_target() is
            let animal = make_class_type("Animal")
            let flow = NARROWING_FLOW(logger())

            is_null(flow.compose_path_narrow(animal, Semantic.Types.ERROR()))
        si

        @Test()
        compose_path_narrow_returns_null_for_null_inputs() is
            let animal = make_class_type("Animal")
            let flow = NARROWING_FLOW(logger())

            is_null(flow.compose_path_narrow(null, animal))
            is_null(flow.compose_path_narrow(animal, null))
            is_null(flow.compose_path_narrow(null, null))
        si

        @Test()
        compose_path_narrow_strips_optional_target_when_loaded_is_present() is
            // If the loaded type is non-optional (path already known
            // present) and the target arrives optional, strip the
            // optional layer: the narrow is from a proven-present value
            // to a more specific type, never re-introducing optionality.
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let optional_cat = cat.as_optional()
            let flow = NARROWING_FLOW(logger())

            let composed = flow.compose_path_narrow(animal, optional_cat)

            assert composed?
            is_false(composed.is_optional)
        si

        make_value_type(name: string) -> Type is
            let s = Semantic.Symbols.STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            s.set_type(Semantic.Types.NAMED(s))
            return s.type!
        si

        @Test()
        compose_path_narrow_rejects_when_either_side_is_a_value_type() is
            // The sibling / class+trait branch only fires when both
            // sides are reference types; a value-type mismatch is
            // rejected because value-type narrowing doesn't share
            // storage with a reference-type view.
            let animal = make_class_type("Animal")
            let a_struct = make_value_type("A")
            let b_struct = make_value_type("B")
            let flow = NARROWING_FLOW(logger())

            is_null(flow.compose_path_narrow(a_struct, animal))
            is_null(flow.compose_path_narrow(animal, a_struct))
            is_null(flow.compose_path_narrow(a_struct, b_struct))
        si

        @Test()
        compose_path_narrow_rejects_unrelated_concrete_classes() is
            // Two unrelated concrete classes have no intersection — a
            // statically-false test on the path composes to nothing
            // rather than a view no value can satisfy.
            let foo = make_class_type("Foo")
            let bar = make_class_type("Bar")
            let flow = NARROWING_FLOW(logger())

            is_null(flow.compose_path_narrow(foo, bar))
        si

        // narrow_to_assigned_value — the assignment transfer's re-narrow
        // to the RHS static type. The accepting branch is exercised by
        // the integration fixtures; these pin the reject guards so
        // unsound or uninformative narrows stay out.

        make_tuple_type(a: Type, b: Type) -> Type is
            let parameter_names = LIST[string]()
            parameter_names.add("T")
            parameter_names.add("U")

            let head = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ValueTuple", parameter_names, Semantic.BLOCK_SCOPE())
            let names = LIST[string]()
            names.add("first")
            names.add("second")

            let arguments = LIST[Type]()
            arguments.add(a)
            arguments.add(b)

            return Semantic.Types.TUPLE(loc(), head, arguments, names)
        si

        @Test()
        narrow_to_assigned_value_narrows_local_to_strict_subtype() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let x = make_local(owner, "x")
            x.set_type(animal)

            let flow = NARROWING_FLOW(logger())

            let narrowed = flow.narrow_to_assigned_value(x, cat)

            are_same(cat, narrowed)
            are_same(cat, x.type)
            are_same(cat, flow.current_env.narrowed_type_of(x))
        si

        @Test()
        narrow_to_assigned_value_rejects_mutually_assignable_rhs() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let x = make_local(owner, "x")
            x.set_type(animal)

            let flow = NARROWING_FLOW(logger())

            is_null(flow.narrow_to_assigned_value(x, animal))
            are_same(animal, x.type)
        si

        @Test()
        narrow_to_assigned_value_rejects_value_type_rhs() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let a_struct = make_value_type("A")
            let x = make_local(owner, "x")
            x.set_type(animal)

            let flow = NARROWING_FLOW(logger())

            is_null(flow.narrow_to_assigned_value(x, a_struct))
            are_same(animal, x.type)
        si

        @Test()
        narrow_to_assigned_value_rejects_null_type_rhs() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let x = make_local(owner, "x")
            x.set_type(animal)

            let flow = NARROWING_FLOW(logger())

            is_null(flow.narrow_to_assigned_value(x, Semantic.Types.NULL()))
            are_same(animal, x.type)
        si

        @Test()
        narrow_to_assigned_value_rejects_tuple_mentioning_rhs() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let x = make_local(owner, "x")
            x.set_type(animal)

            let flow = NARROWING_FLOW(logger())
            let pair = make_tuple_type(cat, cat)

            is_null(flow.narrow_to_assigned_value(x, pair))
            are_same(animal, x.type)
        si

        @Test()
        narrow_to_assigned_value_narrows_a_global_target() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let g = make_global(owner, "g")
            g.set_type(animal)

            let flow = NARROWING_FLOW(logger())

            are_same(cat, flow.narrow_to_assigned_value(g, cat))
            are_same(cat, g.type)
        si

        @Test()
        narrow_to_assigned_value_rejects_a_member_target() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let f = make_field(owner, "_f")
            f.set_type(animal)

            let flow = NARROWING_FLOW(logger())

            is_null(flow.narrow_to_assigned_value(f, cat))
            are_same(animal, f.type)
        si

        @Test()
        narrow_to_assigned_value_rejects_unreachable_edge() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let x = make_local(owner, "x")
            x.set_type(animal)

            let flow = NARROWING_FLOW(logger())
            flow.set_unreachable()

            is_null(flow.narrow_to_assigned_value(x, cat))
            are_same(animal, x.type)
        si
    si
si
