namespace Syntax.Process.UnitTests is
    use Collections.LIST
    use Collections.List

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Process.CASE_PATTERN
    use Syntax.Process.CASE_USEFULNESS
    use Syntax.Process.ConstructorKind
    use Syntax.Process.PATTERN_CONSTRUCTOR
    use Syntax.Process.PATTERN_DOMAIN
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // CASE_USEFULNESS is the whole decision the case exhaustiveness
    // checker rests on: the arms are exhaustive when a row of
    // wildcards escapes none of them, and an arm is redundant when
    // its own row escapes none of the arms before it.
    //
    // The domains here are built by hand rather than classified from
    // real types, so these pin the algorithm rather than the
    // classification — which types produce which alternatives is
    // covered by the integration suite. Nothing here needs a symbol
    // table, which is what makes the product cases cheap to state.
    @TestClass()
    class CASE_EXHAUSTIVENESS_TESTS is
        init() is si

        // === fixtures ===

        no_fields() -> PATTERN_DOMAIN?[] => LIST[PATTERN_DOMAIN?]()

        // A leaf alternative: no fields to descend into.
        leaf(kind: ConstructorKind, name: string) -> PATTERN_CONSTRUCTOR =>
            PATTERN_CONSTRUCTOR(kind, name, no_fields())

        // An alternative carrying one field of the given domain.
        carrying(name: string, field_domain: PATTERN_DOMAIN?) -> PATTERN_CONSTRUCTOR is
            let fields = LIST[PATTERN_DOMAIN?]()

            fields.add(field_domain)

            return PATTERN_CONSTRUCTOR(ConstructorKind.CLASSY, name, fields)
        si

        domain_of(constructors: Collections.Iterable[PATTERN_CONSTRUCTOR]) -> PATTERN_DOMAIN is
            let result = LIST[PATTERN_CONSTRUCTOR]()

            for c in constructors do
                result.add(c)
            od

            return PATTERN_DOMAIN(result)
        si

        bool_domain() -> PATTERN_DOMAIN =>
            domain_of(
                [
                    leaf(ConstructorKind.FALSE, "false"),
                    leaf(ConstructorKind.TRUE, "true")
                ]
            )

        // A product of the given column domains: one irrefutable
        // alternative whose fields are those columns.
        product_domain(columns: Collections.Iterable[PATTERN_DOMAIN?]) -> PATTERN_DOMAIN is
            let fields = LIST[PATTERN_DOMAIN?]()

            for c in columns do
                fields.add(c)
            od

            return domain_of([PATTERN_CONSTRUCTOR(ConstructorKind.PRODUCT, "product", fields)])
        si

        wildcard() -> CASE_PATTERN => CASE_PATTERN()

        of(constructor: PATTERN_CONSTRUCTOR) -> CASE_PATTERN =>
            CASE_PATTERN(constructor, LIST[CASE_PATTERN]())

        of(constructor: PATTERN_CONSTRUCTOR, fields: Collections.Iterable[CASE_PATTERN]) -> CASE_PATTERN is
            let result = LIST[CASE_PATTERN]()

            for f in fields do
                result.add(f)
            od

            return CASE_PATTERN(constructor, result)
        si

        row(pattern: CASE_PATTERN) -> CASE_PATTERN[] is
            let result = LIST[CASE_PATTERN]()

            result.add(pattern)

            return result
        si

        rows(patterns: Collections.Iterable[CASE_PATTERN]) -> LIST[CASE_PATTERN[]] is
            let result = LIST[CASE_PATTERN[]]()

            for p in patterns do
                result.add(row(p))
            od

            return result
        si

        one_column(domain: PATTERN_DOMAIN) -> PATTERN_DOMAIN?[] is
            let result = LIST[PATTERN_DOMAIN?]()

            result.add(domain)

            return result
        si

        // Whether a value escapes every row — the exhaustiveness
        // question, asked as a row of wildcards.
        escapes(domain: PATTERN_DOMAIN, matrix: LIST[CASE_PATTERN[]]) -> bool =>
            missing(domain, matrix).count > 0

        missing(
            domain: PATTERN_DOMAIN,
            matrix: LIST[CASE_PATTERN[]]
        ) -> CASE_PATTERN[][] =>
            CASE_USEFULNESS()
                .find_witnesses(matrix, one_column(domain), row(wildcard()), 8)

        describe_missing(domain: PATTERN_DOMAIN, matrix: LIST[CASE_PATTERN[]]) -> string =>
            missing(domain, matrix)
                |> Ghul.Pipes.map(w => w[0].describe())
                |> Ghul.Pipes.join(", ")

        // === sums ===

        @Test()
        Both_branches_of_a_bool_cover_it() is
            let d = bool_domain()

            is_false(
                escapes(d, rows([of(d.constructors[0]), of(d.constructors[1])]))
            )
        si

        @Test()
        One_branch_of_a_bool_leaves_the_other_open() is
            let d = bool_domain()

            are_equal("false", describe_missing(d, rows([of(d.constructors[1])])))
        si

        @Test()
        A_wildcard_arm_covers_any_domain() is
            let d = bool_domain()

            is_false(escapes(d, rows([wildcard()])))
        si

        @Test()
        No_arms_leaves_every_alternative_open() is
            let d = bool_domain()

            are_equal("false, true", describe_missing(d, LIST[CASE_PATTERN[]]()))
        si

        @Test()
        A_union_is_covered_only_when_every_variant_is() is
            let red = leaf(ConstructorKind.CLASSY, "RED")
            let green = leaf(ConstructorKind.CLASSY, "GREEN")
            let blue = leaf(ConstructorKind.CLASSY, "BLUE")

            let d = domain_of([red, green, blue])

            are_equal("GREEN, BLUE", describe_missing(d, rows([of(red)])))
            is_false(escapes(d, rows([of(red), of(green), of(blue)])))
        si

        @Test()
        An_optional_domain_needs_absence_covered_too() is
            let null_constructor = leaf(ConstructorKind.NULL, "null")
            let red = leaf(ConstructorKind.CLASSY, "RED")
            let green = leaf(ConstructorKind.CLASSY, "GREEN")

            let d = domain_of([null_constructor, red, green])

            are_equal("null", describe_missing(d, rows([of(red), of(green)])))
            is_false(escapes(d, rows([of(null_constructor), of(red), of(green)])))
        si

        @Test()
        Absence_is_named_before_the_alternatives() is
            let d =
                domain_of(
                    [
                        leaf(ConstructorKind.NULL, "null"),
                        leaf(ConstructorKind.CLASSY, "RED"),
                        leaf(ConstructorKind.CLASSY, "GREEN")
                    ]
                )

            are_equal("null, RED, GREEN", describe_missing(d, LIST[CASE_PATTERN[]]()))
        si

        @Test()
        A_constructible_root_is_an_alternative_of_its_own() is
            // The classifier puts a concrete closed root first, ahead
            // of its subclasses, because a bare root instance is
            // constructible and covering the subclasses misses it.
            let animal = leaf(ConstructorKind.CLASSY, "Animal")
            let cat = leaf(ConstructorKind.CLASSY, "Cat")
            let dog = leaf(ConstructorKind.CLASSY, "Dog")

            let d = domain_of([animal, cat, dog])

            are_equal("Animal", describe_missing(d, rows([of(cat), of(dog)])))
        si

        // === beneath an alternative ===

        @Test()
        An_arm_testing_a_field_does_not_cover_its_whole_alternative() is
            // `when (0): WHOLE` reaches only part of WHOLE, because
            // the field it tests is drawn from a domain that cannot be
            // enumerated. WHOLE stays open.
            let whole = carrying("WHOLE", null)
            let frac = carrying("FRAC", null)

            let d = domain_of([whole, frac])

            let literal = of(leaf(ConstructorKind.OPAQUE, "_"))

            are_equal(
                "WHOLE",
                describe_missing(d, rows([of(whole, [literal]), of(frac, [wildcard()])]))
            )
        si

        @Test()
        An_arm_binding_a_field_covers_its_whole_alternative() is
            let whole = carrying("WHOLE", null)
            let frac = carrying("FRAC", null)

            let d = domain_of([whole, frac])

            is_false(
                escapes(d, rows([of(whole, [wildcard()]), of(frac, [wildcard()])]))
            )
        si

        @Test()
        A_field_over_a_closed_domain_can_be_covered_alternative_by_alternative() is
            let inner = bool_domain()
            let some = carrying("SOME", inner)

            let d = domain_of([some])

            are_equal(
                "SOME(true)",
                describe_missing(d, rows([of(some, [of(inner.constructors[0])])]))
            )

            is_false(
                escapes(
                    d,
                    rows(
                        [
                            of(some, [of(inner.constructors[0])]),
                            of(some, [of(inner.constructors[1])])
                        ]
                    )
                )
            )
        si

        // === products ===

        @Test()
        A_product_is_covered_by_covering_the_combinations() is
            let a = bool_domain()
            let b = bool_domain()

            let d = product_domain([a, b])
            let tuple = d.constructors[0]

            is_false(
                escapes(
                    d,
                    rows(
                        [
                            of(tuple, [of(a.constructors[0]), of(b.constructors[0])]),
                            of(tuple, [of(a.constructors[0]), of(b.constructors[1])]),
                            of(tuple, [of(a.constructors[1]), of(b.constructors[0])]),
                            of(tuple, [of(a.constructors[1]), of(b.constructors[1])])
                        ]
                    )
                )
            )
        si

        @Test()
        Coverage_of_a_product_is_over_the_combinations_not_the_columns() is
            // Every column carries a wildcard in some row, so a check
            // that asked whether each column was covered on its own
            // would wrongly accept this.
            let a = bool_domain()
            let b = bool_domain()

            let d = product_domain([a, b])
            let tuple = d.constructors[0]

            are_equal(
                "(false, false)",
                describe_missing(
                    d,
                    rows(
                        [
                            of(tuple, [of(a.constructors[1]), wildcard()]),
                            of(tuple, [wildcard(), of(b.constructors[1])])
                        ]
                    )
                )
            )
        si

        @Test()
        A_wildcard_column_covers_that_columns_whole_domain() is
            // The converse error: a per-column tally would find the
            // first column uncovered, when in fact two rows suffice.
            let a = bool_domain()
            let b = bool_domain()

            let d = product_domain([a, b])
            let tuple = d.constructors[0]

            is_false(
                escapes(
                    d,
                    rows(
                        [
                            of(tuple, [wildcard(), of(b.constructors[0])]),
                            of(tuple, [wildcard(), of(b.constructors[1])])
                        ]
                    )
                )
            )
        si

        @Test()
        Every_open_combination_is_named_not_just_the_first() is
            let a = bool_domain()
            let b = bool_domain()

            let d = product_domain([a, b])
            let tuple = d.constructors[0]

            are_equal(
                "(false, false), (false, true), (true, false)",
                describe_missing(
                    d,
                    rows([of(tuple, [of(a.constructors[1]), of(b.constructors[1])])])
                )
            )
        si

        @Test()
        A_product_column_with_no_domain_leaves_the_product_open() is
            let a = bool_domain()

            let d = product_domain([a, null])
            let tuple = d.constructors[0]

            are_equal(
                "(false, _)",
                describe_missing(
                    d,
                    rows([of(tuple, [of(a.constructors[1]), wildcard()])])
                )
            )
        si

        @Test()
        Products_nest() is
            let a = bool_domain()
            let b = bool_domain()

            let inner = product_domain([a, b])
            let outer = product_domain([a, inner])

            let outer_tuple = outer.constructors[0]
            let inner_tuple = inner.constructors[0]

            is_false(
                escapes(
                    outer,
                    rows(
                        [
                            of(outer_tuple, [of(a.constructors[0]), wildcard()]),
                            of(
                                outer_tuple,
                                [
                                    of(a.constructors[1]),
                                    of(inner_tuple, [of(a.constructors[0]), wildcard()])
                                ]
                            ),
                            of(
                                outer_tuple,
                                [
                                    of(a.constructors[1]),
                                    of(inner_tuple, [of(a.constructors[1]), wildcard()])
                                ]
                            )
                        ]
                    )
                )
            )
        si

        // === redundancy ===

        _adds_anything(
            domain: PATTERN_DOMAIN,
            prior: LIST[CASE_PATTERN[]],
            arm: CASE_PATTERN
        ) -> bool =>
            CASE_USEFULNESS()
                .find_witnesses(prior, one_column(domain), row(arm), 1)
                .count > 0

        @Test()
        An_arm_repeating_a_covered_alternative_adds_nothing() is
            let red = leaf(ConstructorKind.CLASSY, "RED")
            let green = leaf(ConstructorKind.CLASSY, "GREEN")

            let d = domain_of([red, green])

            is_false(_adds_anything(d, rows([of(red)]), of(red)))
        si

        @Test()
        An_arm_reaching_a_new_alternative_adds_something() is
            let red = leaf(ConstructorKind.CLASSY, "RED")
            let green = leaf(ConstructorKind.CLASSY, "GREEN")

            let d = domain_of([red, green])

            is_true(_adds_anything(d, rows([of(red)]), of(green)))
        si

        @Test()
        An_arm_after_a_wildcard_adds_nothing() is
            let d = bool_domain()

            is_false(_adds_anything(d, rows([wildcard()]), of(d.constructors[0])))
        si

        @Test()
        A_wildcard_after_a_covered_domain_adds_nothing() is
            let d = bool_domain()

            is_false(
                _adds_anything(d, rows([of(d.constructors[0]), of(d.constructors[1])]), wildcard())
            )
        si

        @Test()
        A_wildcard_after_a_partly_covered_domain_adds_something() is
            let d = bool_domain()

            is_true(_adds_anything(d, rows([of(d.constructors[0])]), wildcard()))
        si

        @Test()
        An_arm_narrower_than_one_before_it_adds_nothing() is
            let inner = bool_domain()
            let some = carrying("SOME", inner)

            let d = domain_of([some])

            is_false(
                _adds_anything(
                    d,
                    rows([of(some, [wildcard()])]),
                    of(some, [of(inner.constructors[0])])
                )
            )
        si
    si
si
