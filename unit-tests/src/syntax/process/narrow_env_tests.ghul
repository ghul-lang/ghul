namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INSTANCE_FIELD
    use Semantic.Symbols.INSTANCE_PROPERTY
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Symbols.Symbol
    use Semantic.Symbols.Variable
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for NARROW_ENV — the narrowing-environment value type
    // and its `join`. Types are constructed directly; `join` needs
    // genuine subtype relationships, built via CLASS.add_ancestor
    // (see unit-test-fixtures.md).
    @TestClass()
    class NARROW_ENV_TESTS is
        init() is
            Fixtures.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        make_owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestOwner", empty_names(), Semantic.BLOCK_SCOPE())

        make_var(owner: CLASS, name: string, t: Type) -> Variable is
            let v = Semantic.Symbols.LOCAL_VARIABLE(loc(), owner, name)
            v.set_type(t)
            return v
        si

        make_class_type(name: string) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            c.set_type(Semantic.Types.NAMED(c))
            return c.type!
        si

        make_subclass_type(name: string, base: Type) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            c.set_type(Semantic.Types.NAMED(c))
            c.add_ancestor(base)
            return c.type!
        si

        @Test()
        Empty_env_should_report_empty() is
            let e = NARROW_ENV()

            is_true(e.is_empty)
            is_false(e.is_bottom)
            are_equal(0, e.count)
        si

        @Test()
        Bottom_env_should_report_bottom() is
            let e = NARROW_ENV.bottom()

            is_true(e.is_bottom)
            is_false(e.is_empty)
        si

        @Test()
        set_narrow_should_record_and_be_readable() is
            let owner = make_owner()
            let t = make_class_type("T")
            let v = make_var(owner, "v", t)

            let e = NARROW_ENV()
            e.set_narrow(v, t)

            is_true(e.contains(v))
            are_same(t, e.narrowed_type_of(v))
            are_equal(1, e.count)
        si

        @Test()
        narrowed_type_of_should_return_null_for_unrecorded() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("T"))

            is_false(NARROW_ENV().contains(v))
            is_null(NARROW_ENV().narrowed_type_of(v))
        si

        @Test()
        drop_narrow_should_remove_entry() is
            let owner = make_owner()
            let t = make_class_type("T")
            let v = make_var(owner, "v", t)

            let e = NARROW_ENV()
            e.set_narrow(v, t)
            e.drop_narrow(v)

            is_false(e.contains(v))
            are_equal(0, e.count)
        si

        // Composing a subtype-refining narrow keeps the tighter type,
        // exercising the subtype branch of INTERSECTION.create.
        @Test()
        set_narrow_should_refine_to_subtype_on_compose() is
            let owner = make_owner()
            let base = make_class_type("Base")
            let sub = make_subclass_type("Sub", base)
            let v = make_var(owner, "v", base)

            let e = NARROW_ENV()
            e.set_narrow(v, base)
            e.set_narrow(v, sub)

            are_same(sub, e.narrowed_type_of(v))
            are_equal(1, e.count)
        si

        // Composing the same narrow type twice must not grow the map
        // — the short-circuit skips when INTERSECTION.create(existing, t)
        // equals existing.
        @Test()
        set_narrow_should_skip_no_op_compose() is
            let owner = make_owner()
            let base = make_class_type("Base")
            let sub = make_subclass_type("Sub", base)
            let v = make_var(owner, "v", base)

            let e = NARROW_ENV()
            e.set_narrow(v, sub)
            let first = e.narrowed_type_of(v)

            // Re-record the same narrow: no observable change.
            e.set_narrow(v, sub)
            are_same(first, e.narrowed_type_of(v))
            are_equal(1, e.count)
        si

        // Composing a weaker (supertype) narrow on top of a strict-subtype
        // narrow leaves the existing tighter type — the short-circuit
        // fires because INTERSECTION.create returns `existing`.
        @Test()
        set_narrow_should_skip_weaker_compose() is
            let owner = make_owner()
            let base = make_class_type("Base")
            let sub = make_subclass_type("Sub", base)
            let v = make_var(owner, "v", base)

            let e = NARROW_ENV()
            e.set_narrow(v, sub)
            let before = e.narrowed_type_of(v)

            // Weakening to the supertype must not overwrite the tighter
            // narrow; the recorded type stays `sub`.
            e.set_narrow(v, base)
            are_same(before, e.narrowed_type_of(v))
            are_equal(1, e.count)
        si

        // Two unrelated concrete classes have no intersection — the
        // recording edge is statically impossible, and its code is
        // written against the newly tested type, so the new narrow
        // replaces the stale one.
        @Test()
        set_narrow_should_replace_on_unrelated_concrete_compose() is
            let owner = make_owner()
            let cat = make_class_type("Cat")
            let dog = make_class_type("Dog")
            let v = make_var(owner, "v", make_class_type("Animal"))

            let e = NARROW_ENV()
            e.set_narrow(v, cat)
            e.set_narrow(v, dog)

            are_same(dog, e.narrowed_type_of(v))
            are_equal(1, e.count)
        si

        @Test()
        set_narrow_on_bottom_should_be_no_op() is
            let owner = make_owner()
            let t = make_class_type("T")
            let v = make_var(owner, "v", t)

            let e = NARROW_ENV.bottom()
            e.set_narrow(v, t)

            is_false(e.contains(v))
            is_true(e.is_bottom)
        si

        @Test()
        copy_should_be_independent() is
            let owner = make_owner()
            let t = make_class_type("T")
            let a = make_var(owner, "a", t)
            let b = make_var(owner, "b", t)

            let original = NARROW_ENV()
            original.set_narrow(a, t)

            let clone = original.copy()
            clone.set_narrow(b, t)
            clone.drop_narrow(a)

            // original unchanged by clone mutations
            is_true(original.contains(a))
            is_false(original.contains(b))

            is_false(clone.contains(a))
            is_true(clone.contains(b))
        si

        @Test()
        join_with_bottom_should_return_the_other_side() is
            let owner = make_owner()
            let t = make_class_type("T")
            let v = make_var(owner, "v", t)

            let a = NARROW_ENV()
            a.set_narrow(v, t)

            let left = NARROW_ENV.join(NARROW_ENV.bottom(), a)
            are_same(t, left.narrowed_type_of(v))

            let right = NARROW_ENV.join(a, NARROW_ENV.bottom())
            are_same(t, right.narrowed_type_of(v))
        si

        @Test()
        join_should_keep_variable_narrowed_in_both_sides() is
            let owner = make_owner()
            let t = make_class_type("T")
            let v = make_var(owner, "v", t)

            let a = NARROW_ENV()
            a.set_narrow(v, t)
            let b = NARROW_ENV()
            b.set_narrow(v, t)

            let merged = NARROW_ENV.join(a, b)

            is_true(merged.contains(v))
            are_same(t, merged.narrowed_type_of(v))
        si

        @Test()
        join_should_drop_variable_narrowed_in_only_one_side() is
            let owner = make_owner()
            let t = make_class_type("T")
            let v = make_var(owner, "v", t)

            let a = NARROW_ENV()
            a.set_narrow(v, t)
            let b = NARROW_ENV()

            is_false(NARROW_ENV.join(a, b).contains(v))
            is_false(NARROW_ENV.join(b, a).contains(v))
        si

        @Test()
        join_should_lub_when_both_sides_narrow_to_siblings() is
            // a narrows v to Cat, b narrows v to Dog, both <: Animal.
            // The merge keeps v narrowed to a common supertype.
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let dog = make_subclass_type("Dog", animal)

            let v = make_var(owner, "v", animal)

            let a = NARROW_ENV()
            a.set_narrow(v, cat)
            let b = NARROW_ENV()
            b.set_narrow(v, dog)

            let merged = NARROW_ENV.join(a, b).narrowed_type_of(v)

            assert merged?
            is_true(merged.is_assignable_from(cat))
            is_true(merged.is_assignable_from(dog))
        si

        @Test()
        join_should_keep_independent_variables_only_when_in_both() is
            let owner = make_owner()
            let t = make_class_type("T")
            let x = make_var(owner, "x", t)
            let y = make_var(owner, "y", t)

            let a = NARROW_ENV()
            a.set_narrow(x, t)
            let b = NARROW_ENV()
            b.set_narrow(y, t)

            let merged = NARROW_ENV.join(a, b)

            is_false(merged.contains(x))
            is_false(merged.contains(y))
            is_true(merged.is_empty)
        si

        @Test()
        set_non_null_should_record_and_be_readable() is
            let owner = make_owner()
            // Presence facts are filtered when v's type is already
            // non-optional (declaration says it always holds a value),
            // so the fixture uses `T?` — the shape a real caller
            // records against.
            let v = make_var(owner, "v", make_class_type("T").as_optional())

            let e = NARROW_ENV()
            e.set_non_null(v)

            is_true(e.is_non_null(v))
        si

        @Test()
        is_non_null_should_be_false_for_unrecorded() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("T"))

            is_false(NARROW_ENV().is_non_null(v))
        si

        @Test()
        drop_non_null_should_remove_entry() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("T"))

            let e = NARROW_ENV()
            e.set_non_null(v)
            e.drop_non_null(v)

            is_false(e.is_non_null(v))
        si

        @Test()
        set_non_null_on_bottom_should_be_no_op() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("T"))

            let e = NARROW_ENV.bottom()
            e.set_non_null(v)

            is_false(e.is_non_null(v))
        si

        @Test()
        copy_should_carry_non_null_independently() is
            let owner = make_owner()
            let a = make_var(owner, "a", make_class_type("T").as_optional())
            let b = make_var(owner, "b", make_class_type("T").as_optional())

            let original = NARROW_ENV()
            original.set_non_null(a)

            let clone = original.copy()
            clone.set_non_null(b)
            clone.drop_non_null(a)

            is_true(original.is_non_null(a))
            is_false(original.is_non_null(b))
            is_false(clone.is_non_null(a))
            is_true(clone.is_non_null(b))
        si

        @Test()
        join_should_keep_non_null_in_both_sides() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("T").as_optional())

            let a = NARROW_ENV()
            a.set_non_null(v)
            let b = NARROW_ENV()
            b.set_non_null(v)

            is_true(NARROW_ENV.join(a, b).is_non_null(v))
        si

        @Test()
        join_should_drop_non_null_in_only_one_side() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("T"))

            let a = NARROW_ENV()
            a.set_non_null(v)
            let b = NARROW_ENV()

            is_false(NARROW_ENV.join(a, b).is_non_null(v))
            is_false(NARROW_ENV.join(b, a).is_non_null(v))
        si

        // The must-call domain, which credits a constructor with what a
        // method it cannot avoid calling assigns. It joins by
        // intersection, like the definite-assignment domain beside it.
        @Test()
        set_called_should_record_the_method() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let e = NARROW_ENV()

            is_false(e.is_called(f))

            e.set_called(f)

            is_true(e.is_called(f))
        si

        @Test()
        join_should_keep_a_call_made_on_both_sides() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let a = NARROW_ENV()
            a.set_called(f)
            let b = NARROW_ENV()
            b.set_called(f)

            is_true(NARROW_ENV.join(a, b).is_called(f))
        si

        @Test()
        join_should_drop_a_call_made_on_only_one_side() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let a = NARROW_ENV()
            a.set_called(f)
            let b = NARROW_ENV()

            is_false(NARROW_ENV.join(a, b).is_called(f))
            is_false(NARROW_ENV.join(b, a).is_called(f))
        si

        @Test()
        with_only_assigned_should_carry_calls() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let e = NARROW_ENV()
            e.set_called(f)

            is_true(e.with_only_assigned().is_called(f))
        si

        make_root(name: string) -> LOCAL_VARIABLE => LOCAL_VARIABLE(loc(), Semantic.BLOCK_SCOPE(), name)
        make_field(owner: CLASS, name: string) -> INSTANCE_FIELD => INSTANCE_FIELD(loc(), owner, name)
        make_property(owner: CLASS, name: string) -> INSTANCE_PROPERTY => INSTANCE_PROPERTY(loc(), loc(), owner, name, false, false)

        make_path(root: LOCAL_VARIABLE, member: Symbol) -> ACCESS_PATH is
            let list = LIST[Symbol]()
            list.add(member)
            return ACCESS_PATH(root, list)
        si

        make_path2(root: LOCAL_VARIABLE, a: Symbol, b: Symbol) -> ACCESS_PATH is
            let list = LIST[Symbol]()
            list.add(a)
            list.add(b)
            return ACCESS_PATH(root, list)
        si

        @Test()
        set_path_narrow_should_record_and_be_readable() is
            let owner = make_owner()
            let t = make_class_type("T")
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let e = NARROW_ENV()
            e.set_path_narrow(path, t)

            are_same(t, e.narrowed_type_of_path(path))
        si

        @Test()
        narrowed_type_of_path_should_return_null_for_unrecorded() is
            let owner = make_owner()
            let path = make_path(make_root("r"), make_field(owner, "f"))

            is_null(NARROW_ENV().narrowed_type_of_path(path))
        si

        @Test()
        set_path_narrow_on_bottom_should_be_no_op() is
            let owner = make_owner()
            let t = make_class_type("T")
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let e = NARROW_ENV.bottom()
            e.set_path_narrow(path, t)

            is_null(e.narrowed_type_of_path(path))
        si

        @Test()
        set_path_narrow_should_refine_when_stacked_with_subtype() is
            // Stacked narrows on the same path compose via INTERSECTION,
            // which drops the wider member when one narrow strict-subtypes
            // another — mirrors set_narrow's Symbol-keyed behaviour.
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let e = NARROW_ENV()
            e.set_path_narrow(path, animal)
            e.set_path_narrow(path, cat)

            // Cat strict-subtypes Animal — INTERSECTION keeps the tighter.
            are_same(cat, e.narrowed_type_of_path(path))
        si

        @Test()
        set_path_narrow_should_stay_at_tighter_when_widened() is
            // Narrowing to a supertype after a subtype is a no-op — the
            // wider member is dropped by INTERSECTION.
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let e = NARROW_ENV()
            e.set_path_narrow(path, cat)
            e.set_path_narrow(path, animal)

            are_same(cat, e.narrowed_type_of_path(path))
        si

        @Test()
        copy_should_carry_path_narrows_independently() is
            let owner = make_owner()
            let t = make_class_type("T")
            let a_path = make_path(make_root("a"), make_field(owner, "f"))
            let b_path = make_path(make_root("b"), make_field(owner, "f"))

            let original = NARROW_ENV()
            original.set_path_narrow(a_path, t)

            let clone = original.copy()
            clone.set_path_narrow(b_path, t)

            are_same(t, original.narrowed_type_of_path(a_path))
            is_null(original.narrowed_type_of_path(b_path))

            are_same(t, clone.narrowed_type_of_path(a_path))
            are_same(t, clone.narrowed_type_of_path(b_path))
        si

        @Test()
        drop_all_paths_should_clear_path_narrows() is
            let owner = make_owner()
            let t = make_class_type("T")
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let e = NARROW_ENV()
            e.set_path_narrow(path, t)
            e.drop_all_paths()

            is_null(e.narrowed_type_of_path(path))
        si

        @Test()
        drop_getter_paths_should_kill_getter_narrows_but_not_field_only() is
            let owner = make_owner()
            let t = make_class_type("T")
            let field_path = make_path(make_root("r"), make_field(owner, "f"))
            let getter_path = make_path(make_root("r"), make_property(owner, "p"))

            let e = NARROW_ENV()
            e.set_path_narrow(field_path, t)
            e.set_path_narrow(getter_path, t)
            e.drop_getter_paths()

            are_same(t, e.narrowed_type_of_path(field_path))
            is_null(e.narrowed_type_of_path(getter_path))
        si

        @Test()
        drop_paths_through_should_kill_paths_reading_the_member() is
            let owner = make_owner()
            let t = make_class_type("T")
            let f = make_field(owner, "f")
            let g = make_field(owner, "g")
            let path_f = make_path(make_root("r"), f)
            let path_g = make_path(make_root("r"), g)

            let e = NARROW_ENV()
            e.set_path_narrow(path_f, t)
            e.set_path_narrow(path_g, t)
            e.drop_paths_through(f)

            is_null(e.narrowed_type_of_path(path_f))
            are_same(t, e.narrowed_type_of_path(path_g))
        si

        @Test()
        drop_paths_rooted_at_should_kill_paths_from_that_root() is
            let owner = make_owner()
            let t = make_class_type("T")
            let f = make_field(owner, "f")
            let root_a = make_root("a")
            let root_b = make_root("b")
            let path_a = make_path(root_a, f)
            let path_b = make_path(root_b, f)

            let e = NARROW_ENV()
            e.set_path_narrow(path_a, t)
            e.set_path_narrow(path_b, t)
            e.drop_paths_rooted_at(root_a)

            is_null(e.narrowed_type_of_path(path_a))
            are_same(t, e.narrowed_type_of_path(path_b))
        si

        @Test()
        drop_heap_facts_should_clear_path_narrows() is
            let owner = make_owner()
            let t = make_class_type("T")
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let e = NARROW_ENV()
            e.set_path_narrow(path, t)
            e.drop_heap_facts()

            is_null(e.narrowed_type_of_path(path))
        si

        @Test()
        join_should_keep_path_narrows_in_both_sides() is
            let owner = make_owner()
            let animal = make_class_type("Animal")
            let cat = make_subclass_type("Cat", animal)
            let dog = make_subclass_type("Dog", animal)
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let a = NARROW_ENV()
            a.set_path_narrow(path, cat)
            let b = NARROW_ENV()
            b.set_path_narrow(path, dog)

            let merged = NARROW_ENV.join(a, b).narrowed_type_of_path(path)

            assert merged?
            is_true(merged.is_assignable_from(cat))
            is_true(merged.is_assignable_from(dog))
        si

        @Test()
        join_should_drop_path_narrow_present_in_only_one_side() is
            let owner = make_owner()
            let t = make_class_type("T")
            let path = make_path(make_root("r"), make_field(owner, "f"))

            let a = NARROW_ENV()
            a.set_path_narrow(path, t)
            let b = NARROW_ENV()

            is_null(NARROW_ENV.join(a, b).narrowed_type_of_path(path))
            is_null(NARROW_ENV.join(b, a).narrowed_type_of_path(path))
        si

        // ==== creation marks ====
        //
        // A replayed crossing attaches only to facts established at or
        // before it ran; a fact stamped after the crossing's log index
        // skips it. Facts without a stamp take every crossing.

        crossing_at(line: int) -> CROSSING => CROSSING(LOCATION("test.ghul", line, 1, line, 1), null)

        @Test()
        note_crossing_at_should_skip_a_fact_created_after_the_crossing() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let e = NARROW_ENV()
            e.creation_mark = 5
            e.set_non_null(f)

            e.note_crossing_at(crossing_at(3), 3)

            is_false(e.non_null_crossings_of(f)?)

            e.note_crossing_at(crossing_at(7), 7)

            let crossings = e.non_null_crossings_of(f)

            assert crossings?
            are_equal(1, crossings.count)
        si

        @Test()
        note_crossing_at_should_attach_everything_to_an_unmarked_fact() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let e = NARROW_ENV()
            e.set_non_null(f)

            e.note_crossing_at(crossing_at(3), 3)

            let crossings = e.non_null_crossings_of(f)

            assert crossings?
            are_equal(1, crossings.count)
        si

        // Live crossings are time-ordered with the facts already in the
        // environment, so they take no index filter.
        @Test()
        note_crossing_should_ignore_creation_marks() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let e = NARROW_ENV()
            e.creation_mark = 5
            e.set_non_null(f)

            e.note_crossing(crossing_at(1))

            let crossings = e.non_null_crossings_of(f)

            assert crossings?
            are_equal(1, crossings.count)
        si

        @Test()
        copy_should_carry_creation_marks() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let e = NARROW_ENV()
            e.creation_mark = 5
            e.set_non_null(f)

            let clone = e.copy()
            clone.note_crossing_at(crossing_at(3), 3)

            is_false(clone.non_null_crossings_of(f)?)
        si

        @Test()
        join_should_merge_creation_marks_to_the_earlier_side() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let a = NARROW_ENV()
            a.creation_mark = 3
            a.set_non_null(f)

            let b = NARROW_ENV()
            b.creation_mark = 7
            b.set_non_null(f)

            let merged = NARROW_ENV.join(a, b)

            merged.note_crossing_at(crossing_at(2), 2)

            is_false(merged.non_null_crossings_of(f)?)

            merged.note_crossing_at(crossing_at(4), 4)

            let crossings = merged.non_null_crossings_of(f)

            assert crossings?
            are_equal(1, crossings.count)
        si

        // A side with no recorded index may have carried the fact since
        // the start of the log, so the merge falls back to zero and
        // every crossing attaches.
        @Test()
        join_should_drop_the_mark_when_one_side_is_unmarked() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let a = NARROW_ENV()
            a.creation_mark = 3
            a.set_non_null(f)

            let b = NARROW_ENV()
            b.set_non_null(f)

            let merged = NARROW_ENV.join(a, b)
            merged.note_crossing_at(crossing_at(1), 1)

            let crossings = merged.non_null_crossings_of(f)

            assert crossings?
            are_equal(1, crossings.count)
        si

        @Test()
        note_crossing_at_should_filter_the_symbol_narrow_domain() is
            let owner = make_owner()
            let f = make_field(owner, "f")

            let e = NARROW_ENV()
            e.creation_mark = 5
            e.set_narrow(f, make_class_type("T"))

            e.note_crossing_at(crossing_at(3), 3)

            is_false(e.narrow_crossings_of(f)?)

            e.note_crossing_at(crossing_at(7), 7)

            let crossings = e.narrow_crossings_of(f)

            assert crossings?
            are_equal(1, crossings.count)
        si

        @Test()
        note_crossing_at_should_filter_the_path_presence_domain() is
            let owner = make_owner()
            let path = make_path(make_root("r"), make_field(owner, "g"))

            let e = NARROW_ENV()
            e.creation_mark = 5
            e.set_non_null_path(path)

            e.note_crossing_at(crossing_at(3), 3)

            is_false(e.path_presence_crossings_of(path)?)

            e.note_crossing_at(crossing_at(7), 7)

            let crossings = e.path_presence_crossings_of(path)

            assert crossings?
            are_equal(1, crossings.count)
        si

        // A replacement fact derives from the test establishing it, so
        // it re-stamps — crossings between the original establishment
        // and the replacement no longer attach afterwards.
        @Test()
        replace_narrow_should_re_stamp_the_creation_mark() is
            let owner = make_owner()
            let f = make_field(owner, "f")
            let t = make_class_type("T")

            let e = NARROW_ENV()
            e.creation_mark = 2
            e.set_narrow(f, t)

            e.creation_mark = 6
            e.replace_narrow(f, t)

            e.note_crossing_at(crossing_at(4), 4)

            is_false(e.narrow_crossings_of(f)?)
        si

        // A local a closure body assigns shares one heap cell with
        // the closure, so a call can rewrite it: its facts form as
        // any local's do, but take crossings and are judged like a
        // field's. A local only the enclosing scope assigns stays
        // crossing-free - a callee cannot reach a stack slot.
        @Test()
        set_narrow_should_record_a_closure_assigned_local() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("V"))
            let t = make_subclass_type("T", v.type!)

            v.is_closure_assigned = true

            let e = NARROW_ENV()
            e.set_narrow(v, t)

            are_same(t, e.narrowed_type_of(v))
        si

        @Test()
        note_crossing_should_attach_to_a_closure_assigned_local_fact() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("V"))

            v.is_closure_assigned = true

            let e = NARROW_ENV()
            e.set_non_null(v)
            e.note_crossing(CROSSING(loc(), null))

            let crossings = e.non_null_crossings_of(v)

            is_true(crossings?)
            are_equal(1, crossings!.count)
        si

        @Test()
        note_crossing_should_skip_a_plain_local_fact() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("V"))

            v.is_reassigned = true

            let e = NARROW_ENV()
            e.set_non_null(v)
            e.note_crossing(CROSSING(loc(), null))

            is_false(e.non_null_crossings_of(v)?)
        si

        @Test()
        replace_narrow_should_keep_recording_a_closure_assigned_local() is
            let owner = make_owner()
            let v = make_var(owner, "v", make_class_type("V"))
            let t = make_subclass_type("T", v.type!)

            v.is_closure_assigned = true

            let e = NARROW_ENV()
            e.replace_narrow(v, t)

            are_same(t, e.narrowed_type_of(v))
        si
    si
si
