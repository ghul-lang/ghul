namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for PATTERN_CHECKER's value-type narrow gating logic, split
    // across two gates:
    //
    // - `should_emit_value_type_narrow_error` fires the "cannot narrow
    //   {T}" error for an explicit `: T` ascription onto a non-optional
    //   value type over a source that is itself a plain value type, where
    //   the test has nothing to decide. Over an optional or a reference
    //   source the test is real, and `is_lifted_test` says it is made
    //   against the optional of the target.
    // - `should_emit_irrefutable_destructure_warning` fires the
    //   "irrefutable-destructure" warning for a *bare* form (no
    //   ascription anywhere) over a non-optional value type when the
    //   caller demands the bare form be refutable on its own — `if
    //   let`'s contract. `case`-when patterns pass
    //   `bare_form_requires_refutability = false`, so the same bare
    //   destructure there draws neither diagnostic: it is a valid arm
    //   that simply always matches.
    //
    // The behaviour is also pinned end-to-end by
    // `integration-tests/semantic/case-when-pattern-errors` (target
    // ascription over a plain value rejected),
    // `integration-tests/execution/value-type-pattern-ascription`
    // (ascription over an optional or boxed source tested), `integration-tests/semantic/if-let-errors`
    // (bare-form irrefutable destructure warned, ascribed mismatch
    // still errors), and
    // `integration-tests/execution/case-when-pattern-non-optional-destructure`
    // (bare destructure of non-nullable tuple accepted). These unit
    // tests pin each gate's contract directly so a future caller can
    // pick the right arguments without running the full pipeline.
    @TestClass()
    class PATTERN_CHECKER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        make_value_type() -> Type is
            // STRUCT.is_value_type = true; with no `has_value`/`value`
            // members it is the non-option-shape value type both gates
            // are concerned with.
            let s = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestStruct", empty_names(), Semantic.BLOCK_SCOPE())
            return s.type!
        si

        make_reference_type() -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestClass", empty_names(), Semantic.BLOCK_SCOPE())
            return c.type!
        si

        // should_emit_value_type_narrow_error

        @Test()
        Narrow_error_returns_false_when_effective_type_is_null() is
            is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(null, null, null))
            is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(null, make_reference_type(), null))
        si

        @Test()
        Narrow_error_returns_false_when_effective_type_is_a_reference_type() is
            let ref_type = make_reference_type()

            is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(ref_type, null, null))
            is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(ref_type, ref_type, ref_type))
        si

        @Test()
        Narrow_error_returns_true_for_value_type_ascription_over_a_plain_value() is
            // `if let i: int = n` over `n: int` - nothing to test.
            let v = make_value_type()

            is_true(PATTERN_CHECKER.should_emit_value_type_narrow_error(v, v, v))
        si

        @Test()
        Narrow_error_returns_true_for_value_type_ascription_over_an_unknown_source() is
            let v = make_value_type()

            is_true(PATTERN_CHECKER.should_emit_value_type_narrow_error(v, v, null))
        si

        @Test()
        Narrow_error_returns_false_for_value_type_ascription_over_a_reference() is
            // `if let i: int = o` over `o: object` - a boxed value can
            // be tested for.
            let v = make_value_type()

            is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(v, v, make_reference_type()))
        si

        @Test()
        Narrow_error_returns_false_for_bare_value_type() is
            // No ascription — nothing here for this gate to reject;
            // that is `should_emit_irrefutable_destructure_warning`'s
            // job instead.
            let v = make_value_type()

            is_false(PATTERN_CHECKER.should_emit_value_type_narrow_error(v, null, v))
        si

        // is_lifted_test

        @Test()
        Lifted_test_for_value_type_target_over_a_reference_source() is
            is_true(PATTERN_CHECKER.is_lifted_test(make_value_type(), make_reference_type()))
        si

        @Test()
        Lifted_test_for_value_type_target_over_an_unknown_source() is
            // The source is not narrowed before the test when nothing
            // shows it is the target itself.
            is_true(PATTERN_CHECKER.is_lifted_test(make_value_type(), null))
        si

        @Test()
        No_lifted_test_for_a_reference_target() is
            is_false(PATTERN_CHECKER.is_lifted_test(make_reference_type(), make_reference_type()))
        si

        @Test()
        No_lifted_test_over_a_plain_value_source() is
            let v = make_value_type()

            is_false(PATTERN_CHECKER.is_lifted_test(v, v))
        si

        // should_emit_irrefutable_destructure_warning

        @Test()
        Irrefutable_warning_returns_false_when_effective_type_is_null() is
            is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(null, null, true))
        si

        @Test()
        Irrefutable_warning_returns_false_when_effective_type_is_a_reference_type() is
            let ref_type = make_reference_type()

            is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(ref_type, null, true))
        si

        @Test()
        Irrefutable_warning_returns_false_when_an_ascription_is_present() is
            // An ascribed narrow is the other gate's concern —
            // `should_emit_value_type_narrow_error` — even when it
            // happens to be refutability-free too.
            let v = make_value_type()

            is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(v, v, true))
        si

        @Test()
        Irrefutable_warning_returns_true_for_bare_value_type_when_refutability_required() is
            // `if let v = some_int` / `if let (a, b) = pair` — no
            // ascription anywhere, but `if let` requires the bare form
            // be refutable on its own.
            let v = make_value_type()

            is_true(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(v, null, true))
        si

        @Test()
        Irrefutable_warning_returns_false_for_bare_value_type_when_refutability_not_required() is
            // `case y when (a, b) then ...` on a non-nullable tuple —
            // no ascription, caller does not require refutability, so
            // the arm is accepted silently rather than warned about.
            let v = make_value_type()

            is_false(PATTERN_CHECKER.should_emit_irrefutable_destructure_warning(v, null, false))
        si

        // binds_present_source

        @Test()
        Binds_present_source_is_true_for_simple_name_bound_to_the_source() is
            // `if let s = name` over a `string?`: s is the source itself.
            is_true(PATTERN_CHECKER.binds_present_source(true, false))
        si

        @Test()
        Binds_present_source_is_false_for_simple_name_bound_to_a_carrier_value() is
            // `if let s = maybe` over a `MAYBE[string?]`: s is the
            // carrier's `.value`, which can itself be absent.
            is_false(PATTERN_CHECKER.binds_present_source(true, true))
        si

        @Test()
        Binds_present_source_is_false_for_destructure_elements() is
            // `if let (a, b) = pair` over a `(string?, int)?`: a is one
            // element of the source, which can itself be absent.
            is_false(PATTERN_CHECKER.binds_present_source(false, false))
            is_false(PATTERN_CHECKER.binds_present_source(false, true))
        si
    si
si
