namespace Syntax.Process.UnitTests is
    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class REPEAT_SOURCE_TESTS is
        init() is
        si

        int_type() -> Semantic.Types.Type => TEST_INNATE_SYMBOL_LOOKUP().get_int_type()

        a_value() -> IR.Values.Value => IR.Values.Literal.NUMBER(1, int_type())

        // A count can be read a second time, to size a result, only when
        // reading it evaluates nothing new: a literal or a variable read.
        @Test()
        Asking_for_the_known_count_of_a_repeat_with_a_literal_count_gives_the_count() is
            let source = REPEAT_SOURCE(a_value(), IR.Values.Literal.NUMBER(3, int_type()))

            is_not_null(source.known_count())
        si

        @Test()
        Asking_for_the_known_count_of_a_repeat_with_a_variable_read_count_gives_the_count() is
            let count = IR.Values.Load.SYMBOL(null, CLASS(LOCATION("test.ghul", 1, 1, 1, 1), LOCATION("test.ghul", 1, 1, 1, 1), Semantic.BLOCK_SCOPE(), "Count", Collections.LIST[string](), Semantic.BLOCK_SCOPE()))
            let source = REPEAT_SOURCE(a_value(), count)

            is_not_null(source.known_count())
        si

        // Anything else would be evaluated a second time by reading it
        // again for the size, so the count is declined.
        @Test()
        Asking_for_the_known_count_of_a_repeat_with_any_other_count_declines() is
            let source = REPEAT_SOURCE(a_value(), IR.Values.DUMMY(int_type(), LOCATION("test.ghul", 1, 1, 1, 1)))

            is_null(source.known_count())
        si

        // The one-argument overload has no count at all.
        @Test()
        Asking_for_the_known_count_of_an_unbounded_repeat_declines() is
            let source = REPEAT_SOURCE(a_value(), null)

            is_null(source.known_count())
        si
    si
si
