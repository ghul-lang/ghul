namespace Syntax.Process.UnitTests is
    use Source.LOCATION

    use Syntax.Process.SYNTHESISE_TOP_LEVEL_ENTRY
    use Definitions = Trees.Definitions

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the has_top_level_entry query — the structural test for
    // "this file carries top-level statements", consulted to compile the
    // entry's file first and to route its edits to the full rebuild. It
    // has to find the synthesised entry both at the file root and inside
    // the file-private namespace expand-namespaces wraps it into.
    @TestClass()
    class SYNTHESISE_TOP_LEVEL_ENTRY_TESTS is
        init() is si

        location() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        function(is_top_level_entry: bool) -> Definitions.FUNCTION is
            let result = Definitions.FUNCTION(
                location(),
                Trees.Identifiers.Identifier(location(), "entry"),
                Trees.TypeExpressions.LIST(location(), Collections.LIST[Trees.TypeExpressions.TypeExpression](0)),
                Trees.Variables.LIST(location(), Collections.LIST[Trees.Variables.VARIABLE](0)),
                Trees.TypeExpressions.INFER(location()),
                Trees.Modifiers.LIST(location(), null, null),
                null
            )

            result.is_top_level_entry = is_top_level_entry

            return result
        si

        list(definitions: ARRAY[Definitions.Definition]) -> Definitions.LIST =>
            Definitions.LIST(location(), definitions)

        @Test()
        given_a_flagged_function_at_the_root__should_return_true() is
            is_true(SYNTHESISE_TOP_LEVEL_ENTRY.has_top_level_entry(list([function(true)])))
        si

        @Test()
        given_an_unflagged_function_at_the_root__should_return_false() is
            is_false(SYNTHESISE_TOP_LEVEL_ENTRY.has_top_level_entry(list([function(false)])))
        si

        @Test()
        given_a_flagged_function_inside_a_namespace__should_return_true() is
            let `namespace = Definitions.NAMESPACE(
                location(),
                Trees.Identifiers.Identifier(location(), "file_private"),
                list([function(true)]),
                true,
                false
            )

            is_true(SYNTHESISE_TOP_LEVEL_ENTRY.has_top_level_entry(list([`namespace])))
        si

        @Test()
        given_null__should_return_false() is
            is_false(SYNTHESISE_TOP_LEVEL_ENTRY.has_top_level_entry(null))
        si
    si
si
