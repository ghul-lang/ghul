namespace Syntax.Process.UnitTests is
    use Collections.Iterable
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.ENUM_STRUCT
    use Semantic.Symbols.STRUCT
    use Semantic.Types.NULLABLE
    use Semantic.Types.Type

    use Syntax.Process.VALUE_EQUALITY_OPERANDS
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins each arm of VALUE_EQUALITY_OPERANDS.can_compare, the
    // classifier that decides which operand types keep == / != on
    // the compare.value innate. The predicate ordering is
    // load-bearing in two places: the type-variable arm must run
    // before the value-type arm, because every GenericArgument
    // reports is_value_type spuriously; and the reference arm must
    // run before the optional arm, because a reference optional
    // compares by identity and stays accepted while a value-type
    // optional is a Nullable struct and is rejected.
    @TestClass()
    class VALUE_EQUALITY_OPERANDS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]()
            for v in values do result.add(v); od
            return result
        si

        a_class_type() -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", empty_names(), Semantic.BLOCK_SCOPE()).type!

        a_struct_type() -> Type =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Pair", empty_names(), Semantic.BLOCK_SCOPE()).type!

        a_primitive_type() -> Type is
            let symbol = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", empty_names(), Semantic.BLOCK_SCOPE())

            symbol.built_in_type = Semantic.Symbols.BuiltInType.INT

            return symbol.type!
        si

        an_enum_type() -> Type =>
            ENUM_STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Suit", Semantic.BLOCK_SCOPE()).type!

        a_type_variable() -> Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0).type!

        a_nullable_over(inner: Type) -> Type is
            let arguments = LIST[Type]()

            arguments.add(inner)

            // the container must be a struct, as System.Nullable is -
            // the value-type-optional arm keys on is_value_type
            return NULLABLE(loc(), STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Nullable", names_for(["T"]), Semantic.BLOCK_SCOPE()), arguments)
        si

        a_tuple_type() -> Type is
            let arguments = LIST[Type]()

            arguments.add(a_primitive_type())
            arguments.add(a_primitive_type())

            return Semantic.Types.TUPLE(loc(), CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ValueTuple", names_for(["T1", "T2"]), Semantic.BLOCK_SCOPE()), arguments, null)
        si

        @Test()
        can_compare__reference_class__is_true() is
            is_true(VALUE_EQUALITY_OPERANDS.can_compare(a_class_type()))
        si

        @Test()
        can_compare__plain_struct__is_false() is
            is_false(VALUE_EQUALITY_OPERANDS.can_compare(a_struct_type()))
        si

        @Test()
        can_compare__primitive_struct__is_true() is
            is_true(VALUE_EQUALITY_OPERANDS.can_compare(a_primitive_type()))
        si

        @Test()
        can_compare__enum__is_true() is
            is_true(VALUE_EQUALITY_OPERANDS.can_compare(an_enum_type()))
        si

        // The ordering guard: a GenericArgument reports
        // is_value_type but is not a built-in type, so if the
        // value-type arm ran first a bare T would be rejected as a
        // non-primitive struct instead of keeping the operators.
        @Test()
        can_compare__type_variable_reports_value_type__still_true() is
            let t = a_type_variable()

            is_true(t.is_value_type)
            is_true(VALUE_EQUALITY_OPERANDS.can_compare(t))
        si

        @Test()
        can_compare__value_type_optional__is_false() is
            is_false(VALUE_EQUALITY_OPERANDS.can_compare(a_nullable_over(a_primitive_type())))
        si

        @Test()
        can_compare__reference_optional__is_true() is
            let optional_class = a_class_type().as_optional()

            is_true(optional_class.is_optional)
            is_true(VALUE_EQUALITY_OPERANDS.can_compare(optional_class))
        si

        @Test()
        can_compare__tuple__is_true() is
            is_true(VALUE_EQUALITY_OPERANDS.can_compare(a_tuple_type()))
        si
    si
si
