namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Symbols.Symbol
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // DROPPED_NARROWING answers, for a use that failed, which call in
    // this body ended the narrowing it needed - and declines where the
    // fact that was dropped would not have helped.
    @TestClass()
    class DROPPED_NARROWING_TESTS is
        init() is
            Fixtures.enter_function()

            KILL_LEDGER.clear_all()
            KILL_LEDGER.current_file = "test.ghul"
            KILL_LEDGER.current_function = null
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        call_at(line: int) -> LOCATION => LOCATION("test.ghul", line, 1, line, 10)

        use_at(line: int) -> LOCATION => LOCATION("test.ghul", line, 5, line, 15)

        local(name: string) -> LOCAL_VARIABLE => LOCAL_VARIABLE(loc(), Semantic.BLOCK_SCOPE(), name)

        cat_type() -> Type is
            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "CAT", LIST[string](), Semantic.BLOCK_SCOPE())

            cat.declare(loc(), Semantic.Symbols.INSTANCE_METHOD(loc(), loc(), cat, "purr", Semantic.BLOCK_SCOPE()), null)

            return cat.type!
        si

        drop(target: Symbol, is_presence: bool, narrowed: Type?, line: int) is
            let kill = KILL("test.ghul", CROSSING(call_at(line), null), target, null, is_presence, true)

            kill.narrowed_type = narrowed

            KILL_LEDGER.record(kill)
        si

        @Test()
        Calling__for_member__where_the_dropped_narrowing_had_the_member__should_name_the_call() is
            let occupant = local("occupant")

            drop(occupant, false, cat_type(), 7)

            if let kill = DROPPED_NARROWING.for_member(occupant, null, "purr", use_at(20)) then
                are_equal(7, kill.crossing.location.start_line)
            else
                is_true(false, "the call that dropped the narrowing was not found")
            fi
        si

        // The member is missing from the narrowed type as well, so the
        // drop explains nothing about this use.
        @Test()
        Calling__for_member__where_the_dropped_narrowing_lacked_the_member__should_find_nothing() is
            let occupant = local("occupant")

            drop(occupant, false, cat_type(), 7)

            is_null(DROPPED_NARROWING.for_member(occupant, null, "bark", use_at(20)))
        si

        // A presence fact says nothing about which members a value has.
        @Test()
        Calling__for_member__where_only_a_presence_fact_was_dropped__should_find_nothing() is
            let occupant = local("occupant")

            drop(occupant, true, null, 7)

            is_null(DROPPED_NARROWING.for_member(occupant, null, "purr", use_at(20)))
        si

        @Test()
        Calling__for_member__for_a_value_nothing_dropped__should_find_nothing() is
            drop(local("occupant"), false, cat_type(), 7)

            is_null(DROPPED_NARROWING.for_member(local("other"), null, "purr", use_at(20)))
        si

        @Test()
        Calling__for_presence__where_presence_was_dropped__should_name_the_call() is
            let label = local("label")

            drop(label, true, null, 9)

            if let kill = DROPPED_NARROWING.for_presence(label, null, use_at(20)) then
                are_equal(9, kill.crossing.location.start_line)
            else
                is_true(false, "the call that dropped the presence was not found")
            fi
        si

        // A value narrowed more than once has a record per drop, each of
        // a fact re-established since the last, so the use is short of
        // the last one written above it.
        @Test()
        Calling__for_presence__after_two_drops__should_name_the_later_call() is
            let label = local("label")

            drop(label, true, null, 9)
            drop(label, true, null, 14)

            if let kill = DROPPED_NARROWING.for_presence(label, null, use_at(20)) then
                are_equal(14, kill.crossing.location.start_line)
            else
                is_true(false, "the call that dropped the presence was not found")
            fi
        si

        // A drop written below the use belongs to a narrowing the use
        // never had.
        @Test()
        Calling__for_presence__with_the_only_drop_below_the_use__should_find_nothing() is
            let label = local("label")

            drop(label, true, null, 30)

            is_null(DROPPED_NARROWING.for_presence(label, null, use_at(20)))
        si

        // The member is judged against the narrowing the use was short
        // of, not against one an earlier branch dropped.
        @Test()
        Calling__for_member__after_a_drop_of_another_narrowing__should_judge_the_later_one() is
            let occupant = local("occupant")
            let dog = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "DOG", LIST[string](), Semantic.BLOCK_SCOPE())

            drop(occupant, false, dog.type!, 5)
            drop(occupant, false, cat_type(), 12)

            if let kill = DROPPED_NARROWING.for_member(occupant, null, "purr", use_at(20)) then
                are_equal(12, kill.crossing.location.start_line)
            else
                is_true(false, "the call that dropped the narrowing was not found")
            fi
        si

        @Test()
        Calling__message__for_a_type_fact__should_name_the_value_and_the_type() is
            let occupant = local("occupant")

            drop(occupant, false, cat_type(), 7)

            if let kill = DROPPED_NARROWING.for_member(occupant, null, "purr", use_at(20)) then
                are_equal("the narrowing of occupant to CAT ended at this call", DROPPED_NARROWING.message(kill))
            else
                is_true(false, "the call that dropped the narrowing was not found")
            fi
        si

        @Test()
        Calling__message__for_a_presence_fact__should_name_the_value() is
            let label = local("label")

            drop(label, true, null, 9)

            if let kill = DROPPED_NARROWING.for_presence(label, null, use_at(20)) then
                are_equal("the narrowing of label ended at this call", DROPPED_NARROWING.message(kill))
            else
                is_true(false, "the call that dropped the presence was not found")
            fi
        si
    si
si
