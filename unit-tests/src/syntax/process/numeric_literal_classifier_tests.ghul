namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use NSubstitute
    use NSubstitute.SubstituteExtensions.returns

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.Symbols.CLASS
    use Semantic.Types.Type

    use Syntax.Process.NUMERIC_LITERAL_CLASSIFIER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class NUMERIC_LITERAL_CLASSIFIER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        // Numeric-primitive stand-ins for the classifier. Each
        // `get_*_type()` mock returns the same Type instance every
        // call so callers can identity-compare the classifier's
        // chosen type against the expected primitive. The methods
        // the classifier doesn't touch fall through to NSubstitute's
        // default (null) — none of its paths read them.
        build() -> (classifier: NUMERIC_LITERAL_CLASSIFIER, lookup: InnateSymbolLookup, logger: DIAGNOSTICS_STORE) is
            let logger = DIAGNOSTICS_STORE()
            let arguments = System.Array.empty`[object]()
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments)

            let bool_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "bool", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let byte_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "byte", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let ubyte_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ubyte", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let short_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "short", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let int_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let long_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "long", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let ulong_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ulong", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let word_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "word", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let uword_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "uword", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let char_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "char", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            let bigint_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "bigint", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            lookup.get_bool_type() |> returns(bool_type, null)
            lookup.get_byte_type() |> returns(byte_type, null)
            lookup.get_ubyte_type() |> returns(ubyte_type, null)
            lookup.get_short_type() |> returns(short_type, null)
            lookup.get_int_type() |> returns(int_type, null)
            lookup.get_long_type() |> returns(long_type, null)
            lookup.get_ulong_type() |> returns(ulong_type, null)
            lookup.get_word_type() |> returns(word_type, null)
            lookup.get_uword_type() |> returns(uword_type, null)
            lookup.get_char_type() |> returns(char_type, null)
            lookup.get_bigint_type() |> returns(bigint_type, null)

            let classifier = NUMERIC_LITERAL_CLASSIFIER(logger, lookup)
            return (classifier, lookup, logger)
        si

        // === classify_integer: suffix decoding ===

        @Test()
        Calling__classify_integer__with_no_suffix__picks_int_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "42")

            assert result?
            are_same(b.lookup.get_int_type(), result.type)
            are_equal("42", result.rendered)
            is_true(isa IR.Values.Literal.CONSTANT.I4(result.constant))
        si

        @Test()
        Calling__classify_integer__with_b_suffix__picks_byte_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "42b")

            assert result?
            are_same(b.lookup.get_byte_type(), result.type)
            are_equal("42", result.rendered)
        si

        @Test()
        Calling__classify_integer__with_ub_suffix__picks_ubyte_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "200ub")

            assert result?
            are_same(b.lookup.get_ubyte_type(), result.type)
            are_equal("200", result.rendered)
        si

        @Test()
        Calling__classify_integer__on_a_uint_above_int32_max__carries_the_32_bit_pattern() is
            // `ldc.i4` takes a signed 32-bit operand, so a `uint` that is
            // in range for its own type but above int32's maximum is
            // carried as the bit pattern rather than as the magnitude.
            // 4278255360 does not fit; -16711936 is the same 32 bits.
            let b = build()
            let result = b.classifier.classify_integer(loc(), "4278255360u")

            assert result?
            is_true(isa IR.Values.Literal.CONSTANT.I4(result.constant))
            are_equal(-16711936, (cast IR.Values.Literal.CONSTANT.I4(result.constant)).value)
        si

        @Test()
        Calling__classify_integer__with_l_suffix__picks_long_type_and_i8_suffix() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "42L")

            assert result?
            are_same(b.lookup.get_long_type(), result.type)
            is_true(isa IR.Values.Literal.CONSTANT.I8(result.constant))
            are_equal("42", result.rendered)
        si

        @Test()
        Calling__classify_integer__with_w_suffix__picks_word_type_narrowed_to_native_int() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "42w")

            assert result?
            are_same(b.lookup.get_word_type(), result.type)
            is_true(isa IR.Values.Literal.CONSTANT.I8(result.constant))
            are_equal(IR.Scalar.INT_NATIVE, result.narrowing)
        si

        @Test()
        Calling__classify_integer__with_uw_suffix__picks_uword_type_narrowed_to_native_uint() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "42uw")

            assert result?
            are_same(b.lookup.get_uword_type(), result.type)
            are_equal(IR.Scalar.UINT_NATIVE, result.narrowing)
        si

        @Test()
        Calling__classify_integer__with_s_suffix__picks_short_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "42s")

            assert result?
            are_same(b.lookup.get_short_type(), result.type)
        si

        @Test()
        Calling__classify_integer__with_uppercase_suffix__picks_correct_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "42I")

            assert result?
            are_same(b.lookup.get_int_type(), result.type)
        si

        // Structural error: 'c' (character literal) cannot be unsigned.
        // The classifier logs the error and the suffix-decode leaves
        // `type` null, so the entry point returns null.
        @Test()
        Calling__classify_integer__with_uc_suffix__logs_error_and_returns_null() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "65uc")

            is_null(result)
            is_true(b.logger.any_errors)
        si

        // === classify_integer: bounds ===

        @Test()
        Calling__classify_integer__with_value_at_byte_max__succeeds() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "127b")

            assert result?
            are_same(b.lookup.get_byte_type(), result.type)
        si

        @Test()
        Calling__classify_integer__with_value_over_byte_max__logs_error_and_returns_null() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "128b")

            is_null(result)
            is_true(b.logger.any_errors)
        si

        // 0xFF = 255, which exceeds signed-byte max 127 — classifier
        // logs the overflow error and returns null. The suffix needs the
        // backtick: written adjacent, the `b` is a hex digit.
        @Test()
        Calling__classify_integer__with_hex_over_byte_max__returns_null() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0xFF`b")

            is_null(result)
            is_true(b.logger.any_errors)
        si

        // === radix-aware suffix decoding ===

        // `b` and `c` are hex digits before they are size selectors, so a
        // hex literal ending in one is all digits and no suffix.
        @Test()
        Calling__classify_integer__with_hex_ending_in_b__is_all_digits() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0xFFb")

            assert result?
            are_same(b.lookup.get_int_type(), result.type)
        si

        @Test()
        Calling__classify_integer__with_hex_ending_in_c__is_all_digits() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0x20AC")

            assert result?
            are_same(b.lookup.get_int_type(), result.type)
        si

        // A single hex digit that is also a size selector is still a
        // digit: reading it as a suffix would leave no digits at all,
        // and an empty digit string denotes no value.
        @Test()
        Calling__classify_integer__with_hex_single_digit_b__is_all_digits() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0xB")

            assert result?
            are_same(b.lookup.get_int_type(), result.type)
            is_false(b.logger.any_errors)
        si

        @Test()
        Calling__classify_integer__with_backtick_c_suffix__picks_char_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0x20AC`c")

            assert result?
            are_same(b.lookup.get_char_type(), result.type)
        si

        // The backtick marks the boundary and says nothing about the
        // type, so a sign selector still reads as one behind it.
        @Test()
        Calling__classify_integer__with_backtick_ub_suffix__picks_ubyte_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0xFF`ub")

            assert result?
            are_same(b.lookup.get_ubyte_type(), result.type)
        si

        // A selector that is not a digit of the radix needs no backtick.
        @Test()
        Calling__classify_integer__with_hex_l_suffix__picks_long_type() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0x20ACl")

            assert result?
            are_same(b.lookup.get_long_type(), result.type)
        si

        // === suffix_length ===

        @Test()
        Calling__suffix_length__on_hex_ending_in_selector__is_zero() is
            are_equal(0, NUMERIC_LITERAL_CLASSIFIER.suffix_length("0x20AC"))
            are_equal(0, NUMERIC_LITERAL_CLASSIFIER.suffix_length("0xAB"))
            are_equal(0, NUMERIC_LITERAL_CLASSIFIER.suffix_length("0xB"))
        si

        @Test()
        Calling__suffix_length__on_decimal__counts_the_selectors() is
            are_equal(0, NUMERIC_LITERAL_CLASSIFIER.suffix_length("123"))
            are_equal(1, NUMERIC_LITERAL_CLASSIFIER.suffix_length("123b"))
            are_equal(2, NUMERIC_LITERAL_CLASSIFIER.suffix_length("123ub"))
        si

        // A sign is part of the value, not of the suffix. An enum
        // member's initializer reaches strip_suffix with one still
        // attached, and peels it afterwards.
        @Test()
        Calling__suffix_length__on_a_signed_literal__ignores_the_sign() is
            are_equal(0, NUMERIC_LITERAL_CLASSIFIER.suffix_length("-1"))
            are_equal(0, NUMERIC_LITERAL_CLASSIFIER.suffix_length("+1"))
            are_equal(1, NUMERIC_LITERAL_CLASSIFIER.suffix_length("-123b"))
            are_equal(0, NUMERIC_LITERAL_CLASSIFIER.suffix_length("-0x1Fb"))
            are_equal(2, NUMERIC_LITERAL_CLASSIFIER.suffix_length("-0x1F`b"))
        si

        @Test()
        Calling__strip_suffix__on_a_signed_literal__keeps_the_sign() is
            are_equal("-1", NUMERIC_LITERAL_CLASSIFIER.strip_suffix("-1"))
            are_equal("-123", NUMERIC_LITERAL_CLASSIFIER.strip_suffix("-123b"))
            are_equal("-0x1F", NUMERIC_LITERAL_CLASSIFIER.strip_suffix("-0x1F`b"))
        si

        // The backtick counts as part of the suffix, so stripping it
        // leaves the value the literal denotes.
        @Test()
        Calling__suffix_length__with_backtick__counts_the_backtick() is
            are_equal(2, NUMERIC_LITERAL_CLASSIFIER.suffix_length("0x20AC`c"))
            are_equal(3, NUMERIC_LITERAL_CLASSIFIER.suffix_length("0xFF`ub"))
            are_equal("0x20AC", NUMERIC_LITERAL_CLASSIFIER.strip_suffix("0x20AC`c"))
        si

        @Test()
        Calling__classify_integer__with_hex_value_for_ubyte__succeeds() is
            let b = build()
            let result = b.classifier.classify_integer(loc(), "0xFFub")

            assert result?
            are_same(b.lookup.get_ubyte_type(), result.type)
        si

        // === fits ===

        @Test()
        Calling__fits__with_value_inside_int_range__returns_true() is
            let b = build()
            let ok = b.classifier.fits(loc(), "2147483647", b.lookup.get_int_type())

            is_true(ok)
        si

        @Test()
        Calling__fits__with_value_outside_int_range__returns_false_and_logs() is
            let b = build()
            let ok = b.classifier.fits(loc(), "2147483648", b.lookup.get_int_type())

            is_false(ok)
            is_true(b.logger.any_errors)
        si

        @Test()
        Calling__fits__with_value_exceeding_ulong_parse__returns_false() is
            // Larger than 2^64 — ulong.try_parse fails before we even
            // reach the max-unsigned check.
            let b = build()
            let ok = b.classifier.fits(loc(), "99999999999999999999", b.lookup.get_int_type())

            is_false(ok)
        si

        @Test()
        Calling__fits__with_unrecognised_type__skips_bound_check_and_returns_true() is
            // Types not handled by max_unsigned_for (e.g. ulong / uword
            // / float types) return 0 from max_unsigned_for, which the
            // fits check reads as "no narrower bound", so any value
            // that parses as ulong succeeds.
            let b = build()
            let bool_type = b.lookup.get_bool_type()
            let ok = b.classifier.fits(loc(), "12345", bool_type)

            is_true(ok)
        si

        // === parse_hex ===

        @Test()
        Calling__parse_hex__with_valid_hex__returns_correct_value() is
            let b = build()
            let (ok, value) = b.classifier.parse_hex("FF")

            is_true(ok)
            are_equal(255UL, value)
        si

        @Test()
        Calling__parse_hex__with_lowercase__returns_correct_value() is
            let b = build()
            let (ok, value) = b.classifier.parse_hex("deadbeef")

            is_true(ok)
            are_equal(0xdeadbeefUL, value)
        si

        @Test()
        Calling__parse_hex__with_empty__returns_false() is
            let b = build()
            let (ok, value) = b.classifier.parse_hex("")

            is_false(ok)
        si

        @Test()
        Calling__parse_hex__with_more_than_16_digits__returns_false() is
            let b = build()
            let (ok, value) = b.classifier.parse_hex("00000000000000000")

            is_false(ok)
        si

        @Test()
        Calling__parse_hex__with_non_hex_char__returns_false() is
            let b = build()
            let (ok, value) = b.classifier.parse_hex("123G")

            is_false(ok)
        si

        // === max_unsigned_for ===

        @Test()
        Calling__max_unsigned_for__on_byte__returns_127() is
            let b = build()
            are_equal(127UL, b.classifier.max_unsigned_for(b.lookup.get_byte_type()))
        si

        @Test()
        Calling__max_unsigned_for__on_ubyte__returns_255() is
            let b = build()
            are_equal(255UL, b.classifier.max_unsigned_for(b.lookup.get_ubyte_type()))
        si

        @Test()
        Calling__max_unsigned_for__on_int__returns_int_max() is
            let b = build()
            are_equal(2147483647UL, b.classifier.max_unsigned_for(b.lookup.get_int_type()))
        si

        // === bigint literals ===

        @Test()
        Calling__is_bigint__on_an_n_suffixed_literal__is_true() is
            is_true(NUMERIC_LITERAL_CLASSIFIER.is_bigint("42n"))
            is_true(NUMERIC_LITERAL_CLASSIFIER.is_bigint("0xFFn"))
            is_true(NUMERIC_LITERAL_CLASSIFIER.is_bigint("42N"))
        si

        @Test()
        Calling__is_bigint__on_any_other_literal__is_false() is
            is_false(NUMERIC_LITERAL_CLASSIFIER.is_bigint("42"))
            is_false(NUMERIC_LITERAL_CLASSIFIER.is_bigint("42L"))
            is_false(NUMERIC_LITERAL_CLASSIFIER.is_bigint("0x20AC"))
        si

        @Test()
        Calling__classify__on_an_n_suffixed_literal__yields_a_bigint() is
            let b = build()
            let result = b.classifier.classify(loc(), "42n")

            assert result?
            is_true(isa IR.Values.Literal.BIGINT(result))
            are_equal("42", (cast IR.Values.Literal.BIGINT(result)).value)
        si

        // Hex is converted to decimal digits at compile time, because
        // the run-time parse only reads decimal.
        @Test()
        Calling__classify__on_a_hex_bigint__yields_the_decimal_digits() is
            let b = build()
            let result = b.classifier.classify(loc(), "0xDEADBEEFn")

            assert result?
            are_equal("3735928559", (cast IR.Values.Literal.BIGINT(result)).value)
        si

        @Test()
        Calling__classify__on_a_bigint_wider_than_a_long__keeps_every_digit() is
            let b = build()
            let result = b.classifier.classify(loc(), "123456789012345678901234567890n")

            assert result?
            are_equal("123456789012345678901234567890", (cast IR.Values.Literal.BIGINT(result)).value)
        si

        @Test()
        Calling__classify__on_a_bigint_with_leading_zeros__drops_them() is
            let b = build()
            let result = b.classifier.classify(loc(), "000n")

            assert result?
            are_equal("0", (cast IR.Values.Literal.BIGINT(result)).value)
        si

        // bigint has no unsigned counterpart, so the sign selector has
        // nothing to select - the same shape as `uc` on a character.
        @Test()
        Calling__classify__on_an_unsigned_bigint__logs_error_and_returns_null() is
            let b = build()
            let result = b.classifier.classify(loc(), "42un")

            is_null(result)
            is_true(b.logger.any_errors)
        si

        @Test()
        Calling__fits_in_long__at_the_boundary__answers_by_magnitude() is
            let b = build()

            is_true(b.classifier.fits_in_long("9223372036854775807"))
            is_false(b.classifier.fits_in_long("9223372036854775808"))
            is_false(b.classifier.fits_in_long("18446744073709551616"))
        si

        @Test()
        Calling__max_unsigned_for__on_unrecognised_type__returns_zero() is
            // ulong / uword aren't in the map (ulong.try_parse already
            // caps them at 2^64-1), and the caller treats 0 as
            // "skip the narrower-bound check".
            let b = build()
            are_equal(0UL, b.classifier.max_unsigned_for(b.lookup.get_ulong_type()))
        si
    si
si
