namespace Syntax.Process.UnitTests is

    use Semantic.Types.MATCH
    use Assertions

    // Pins how a pattern value chooses between a `~` and a `=~` that
    // both resolve: the score with less conversion wins, `~` takes an
    // exact tie, and a `~` with no `=~` beside it always wins.
    class PATTERN_TEST_TESTS is
        init() is
            super.init()
        si

        score(value: int) -> MATCH => cast MATCH(value)

        @test()
        match_with_no_equality_is_preferred() is
            is_true(PATTERN_TEST.prefers_match(score(4), null))
        si

        @test()
        match_wins_an_exact_tie() is
            is_true(PATTERN_TEST.prefers_match(MATCH.SAME, MATCH.SAME))
            is_true(PATTERN_TEST.prefers_match(score(2), score(2)))
        si

        @test()
        match_needing_less_conversion_wins() is
            is_true(PATTERN_TEST.prefers_match(MATCH.SAME, score(2)))
        si

        @test()
        equality_needing_less_conversion_wins() is
            is_false(PATTERN_TEST.prefers_match(score(2), MATCH.SAME))
            is_false(PATTERN_TEST.prefers_match(score(3), score(1)))
        si
    si
si
