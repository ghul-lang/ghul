namespace Syntax.Process.Printer.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Process.Printer.DOC
    use Syntax.Process.Printer.DOC_BUILDER
    use Syntax.Process.Printer.DOC_RENDERER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the layout engine: DOC_BUILDER assembles a DOC tree,
    // DOC_RENDERER lays it out against a column budget. A GROUP renders
    // flat when its flat form fits the budget, otherwise broken.
    @TestClass()
    class DOC_RENDERER_TESTS is
        init() is si

        render(doc: DOC, width: int) -> string =>
            DOC_RENDERER(width).render(doc)

        @Test()
        plain_text_is_emitted_verbatim() is
            let b = DOC_BUILDER()
            b.text("hello")

            are_equal("hello", render(b.build(), 100))
        si

        @Test()
        a_group_that_fits_renders_flat() is
            let b = DOC_BUILDER()
            b.begin_group()
            b.text("a")
            b.line()
            b.text("b")
            b.end_group()

            are_equal("a b", render(b.build(), 100))
        si

        @Test()
        a_group_that_exceeds_the_budget_breaks() is
            let b = DOC_BUILDER()
            b.begin_group()
            b.text("aaa")
            b.line()
            b.text("bbb")
            b.end_group()

            are_equal("aaa\nbbb", render(b.build(), 4))
        si

        @Test()
        a_broken_group_indents_its_nested_content() is
            let b = DOC_BUILDER()
            b.begin_group()
            b.text("(")
            b.begin_nest(2)
            b.soft_line()
            b.text("x")
            b.end_nest()
            b.soft_line()
            b.text(")")
            b.end_group()

            are_equal("(x)", render(b.build(), 100))
            are_equal("(\n  x\n)", render(b.build(), 1))
        si

        @Test()
        a_hard_line_forces_the_enclosing_group_to_break() is
            let b = DOC_BUILDER()
            b.begin_group()
            b.text("a")
            b.hard_line()
            b.text("b")
            b.end_group()

            // Fits the budget, but the hard line breaks the group anyway.
            are_equal("a\nb", render(b.build(), 100))
        si

        @Test()
        a_soft_line_is_empty_when_flat() is
            let b = DOC_BUILDER()
            b.begin_group()
            b.text("a")
            b.soft_line()
            b.text("b")
            b.end_group()

            are_equal("ab", render(b.build(), 100))
        si

        @Test()
        nested_groups_break_independently() is
            let b = DOC_BUILDER()
            b.begin_group()
            b.text("outer")
            b.line()
            b.begin_group()
            b.text("x")
            b.line()
            b.text("y")
            b.end_group()
            b.end_group()

            // Budget fits the inner group flat but not the outer: the outer
            // breaks, the inner stays flat.
            are_equal("outer\nx y", render(b.build(), 6))
        si

        // `head(` and a group that breaks after it: what the first
        // alternative puts before its own first break is `prefix head(`.
        head_then_broken_group(prefix: string) -> DOC is
            let b = DOC_BUILDER()
            b.text(prefix)
            b.text("head(")
            b.begin_group()
            b.begin_nest(4)
            b.soft_line()
            b.text("argument")
            b.end_nest()
            b.soft_line()
            b.end_group()
            b.text(")")

            return b.build()
        si

        conditional(prefix: string) -> DOC is
            let b = DOC_BUILDER()

            b.conditional_group(
                [
                    head_then_broken_group(prefix),
                    DOC.CONCAT(
                        [DOC.TEXT("!"), head_then_broken_group(prefix)] |>
                            Ghul.Pipes.collect_mutable()
                    )
                ] |> Ghul.Pipes.collect_mutable()
            )

            return b.build()
        si

        // The first alternative is measured only as far as the break its own
        // group would take, so a long argument it would carry below does not
        // count against it.
        @Test()
        a_conditional_group_takes_the_first_alternative_whose_head_fits() is
            are_equal("head(\n    argument\n)", render(conditional(""), 8))
        si

        // The same alternative, with more before it than the width allows,
        // is passed over for the next.
        @Test()
        a_conditional_group_passes_over_an_alternative_whose_head_is_too_wide() is
            are_equal("!xxxxxhead(\n    argument\n)", render(conditional("xxxxx"), 8))
        si

        // Nothing may break in flat mode, so there is no fit to measure and
        // the most preferred alternative is the answer.
        @Test()
        a_conditional_group_in_flat_mode_takes_its_first_alternative() is
            let b = DOC_BUILDER()
            b.begin_group()
            let alternatives: Collections.LIST[DOC] =
                _([DOC.TEXT("first"), DOC.TEXT("second")])

            b.conditional_group(alternatives)
            b.end_flat()

            are_equal("first", render(b.build(), 1))
        si
    si
si
