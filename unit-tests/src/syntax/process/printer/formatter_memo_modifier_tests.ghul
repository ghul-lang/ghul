namespace Syntax.Process.Printer.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Process.Printer.FORMATTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // `memo` is a stand-alone modifier rather than a storage class, so
    // the formatter and a copied modifier list each have to carry it
    // explicitly or it silently disappears.
    @TestClass()
    class FORMATTER_MEMO_MODIFIER_TESTS is
        init() is si

        loc: Source.LOCATION => Source.LOCATION("test.ghul", 1, 1, 1, 1)

        format(node: Trees.Node) -> string =>
            FORMATTER(Collections.LIST[Lexical.TRIVIA](), 100).format(node)

        memo_modifiers(storage_class: Trees.Modifiers.StorageClass?) -> Trees.Modifiers.LIST is
            let modifiers = Trees.Modifiers.LIST(loc, null, storage_class)
            modifiers.is_memo = true
            return modifiers
        si

        function(modifiers: Trees.Modifiers.LIST) -> Trees.Definitions.FUNCTION =>
            Trees.Definitions.FUNCTION(
                loc,
                Trees.Identifiers.Identifier(loc, "fib"),
                Trees.TypeExpressions.LIST(loc, Collections.LIST[Trees.TypeExpressions.TypeExpression]()),
                Trees.Variables.LIST(loc, Collections.LIST[Trees.Variables.VARIABLE]()),
                Trees.TypeExpressions.NAMED(loc, Trees.Identifiers.Identifier(loc, "long")),
                modifiers,
                Trees.Bodies.NULL(loc)
            )

        @Test()
        a_memo_function_keeps_its_modifier() is
            are_equal("fib() -> long memo\n", format(function(memo_modifiers(null))))
        si

        @Test()
        a_static_memo_function_keeps_both_modifiers() is
            are_equal("fib() -> long static memo\n", format(function(memo_modifiers(Trees.Modifiers.STATIC(loc)))))
        si

        @Test()
        a_copied_modifier_list_keeps_memo() is
            is_true(memo_modifiers(null).copy().is_memo)
        si
    si
si
