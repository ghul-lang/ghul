namespace Syntax.Process.Printer.UnitTests is
    use Collections.Iterable

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Process.Printer.FORMATTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Round-trip checks for the formatter, driven from source text rather
    // than from a hand-built tree: each fixture is parsed, formatted, and
    // the result compared against the canonical form, then formatted again
    // to check the formatter is a fixpoint on its own output.
    //
    // Parsing here rather than spawning an analyser is what lets a fixture
    // be written as the source it is about. The analysis-mode suite keeps
    // the cases that are about the analyser - formatting a file whose
    // project has errors elsewhere, and the driver's own flags.
    @TestClass()
    class FORMATTER_SOURCE_ROUND_TRIP_TESTS is
        init() is si

        // The formatter ends its output with a single trailing newline; the
        // helper appends one so a fixture can read as a list of lines
        // without that detail in every case.
        lines(parts: Iterable[string]) -> string is
            let result = System.Text.StringBuilder()

            for part in parts do
                result.append(part)
                result.append('\n')
            od

            return result.to_string()
        si

        // Parse `source` and format it, exactly as the driver's `--format`
        // and the analysis-mode FORMAT handler both do.
        format(source: string) -> string is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_file =
                Compiler.COMPILER().parse(
                    "round_trip.ghul",
                    IO.StringReader(source),
                    false,
                    false,
                    false,
                    logger
                )

            is_false(logger.any_errors, "fixture did not parse")

            return FORMATTER(source_file.trivia, 100).format(source_file.definition)
        si

        // Format `source` and assert the result equals `expected`, then
        // format that result and assert it is unchanged. A formatter that
        // drops or mangles a construct usually trips the second pass too,
        // so the fixpoint check is a cheap second signal.
        assert_round_trips(source: string, expected: string) is
            let first = format(source)

            are_equal(expected, first, "first pass did not match expected output")

            are_equal(first, format(first), "formatter is not a fixpoint")
        si

        @Test()
        primary_constructor_header_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX(value: int) is",
                "        _value",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        file_pragmas_round_trip() is
            let body = lines([
                "@@IF.not.dotnet()",
                "@@suppress(\"non-snake-case-name\")",
                "",
                "namespace Test is",
                "    class BOX is",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        doc_comments_round_trip() is
            let body = lines([
                "namespace Test is",
                "    /// A box.",
                "    ///",
                "    /// Holds one value.",
                "    class BOX is",
                "        /// The value.",
                "        @suppress(\"non-snake-case-name\")",
                "        Value: int",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        doc_comments_on_enum_members_round_trip() is
            let body = lines([
                "namespace Test is",
                "    /// How a value is rendered.",
                "    enum DisplayMode is",
                "        /// The plain rendering.",
                "        CLEAN,",
                "        // an ordinary comment",
                "        /// The detailed rendering.",
                "        DETAILED = 3",
                "        // after the last member",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        doc_comments_on_union_variants_round_trip() is
            let body = lines([
                "namespace Test is",
                "    /// A shape.",
                "    union Shape is",
                "        /// A round one.",
                "        CIRCLE(radius: int)",
                "        /// A point.",
                "        DOT",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        partial_block_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        _value: int",
                "    si",
                "    partial BOX is",
                "        get_value() -> int => _value",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        impl_block_round_trips() is
            let body = lines([
                "namespace Test is",
                "    trait Printer is",
                "        print() -> string => \"?\"",
                "    si",
                "    class BOX is",
                "    si",
                "    impl Printer for BOX is",
                "        print() -> string => \"box\"",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        primary_constructor_semicolon_shorthand_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX(value: int)",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        primary_constructor_with_init_modifier_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class TOKEN_PAIR(token: int, value: string init) is",
                "        get_value() -> string => value",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        struct_with_primary_constructor_round_trips() is
            let body = lines([
                "namespace Test is",
                "    struct POINT(x: int, y: int)",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        super_call_body_declaration_round_trips() is
            // SUPER_CALL is reachable only from inside a primary-ctor
            // class body. Without an explicit FORMATTER override the
            // StrictVisitor base throws and FORMAT echoes the buffer back
            // unchanged — invisible to the user but a pure-regression
            // path.
            let body = lines([
                "namespace Test is",
                "    class ANIMAL is",
                "        init(name: string) is si",
                "    si",
                "",
                "    class DOG(name: string): ANIMAL is",
                "        super(name)",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        secondary_init_splice_marker_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class POINT(x: int, y: int) is",
                "        init(.., label: string) is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        let_mut_modifier_round_trips() is
            // A trailing `mut` on a local declares a reassignable variable;
            // without it the local is immutable. Dropping `mut` on format
            // silently changes the program's meaning.
            let body = lines([
                "namespace Test is",
                "    main() is",
                "        let a mut = 0",
                "        let b: int mut = 1",
                "        a = a + 1",
                "        b = b + 1",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        union_variants_round_trip() is
            let body = lines([
                "namespace Test is",
                "    union COLOUR is",
                "        RED",
                "        GREEN",
                "        BLUE(intensity: int)",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        match_marker_leaf_round_trips() is
            // A `~` leaf and an unmarked one differ only by the marker,
            // and on a bare name the difference is match versus bind —
            // so dropping it in the printer would silently change what
            // the pattern means. The marker is written back wherever it
            // was read, including where it is a no-op.
            let source = lines([
                "namespace Test is",
                "    class Main is",
                "        check(pair: (int, string), expected: int) static is",
                "            if let (~expected, name) = pair then",
                "                IO.Std.write_line(name)",
                "            fi",
                "            case pair",
                "            when (~1, s) then",
                "                IO.Std.write_line(s)",
                "            when (2, s) then",
                "                IO.Std.write_line(s)",
                "            else",
                "                IO.Std.write_line(\"none\")",
                "            esac",
                "        si",
                "    si",
                "si"
            ])

            assert_round_trips(source, source)
        si

        @Test()
        union_with_primary_constructor_round_trips() is
            // A union primary-constructor header `(name: string)` is part
            // of the source the user wrote and must survive a format pass.
            // Variant fields containing `..` round-trip verbatim; a variant
            // with no additional fields round-trips to the bare-`NAME;`
            // form (the implicit splice).
            let source = lines([
                "namespace Test is",
                "    union Color(name: string) is",
                "        RED(..)",
                "        GREEN",
                "        BLUE(intensity: int, ..)",
                "    si",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    union Color(name: string) is",
                "        RED",
                "        GREEN",
                "        BLUE(intensity: int, ..)",
                "    si",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        @Test()
        case_statement_then_else_round_trips() is
            // The inherited base printer emits the legacy `when X :` /
            // `default` arm shape, which the parser does not accept;
            // the formatter must produce `when X then` / `else` for the
            // output to re-parse.
            let body = lines([
                "namespace Test is",
                "    label(value: int) is",
                "        case value",
                "        when 200 then",
                "            let ok = 1",
                "        when 500 then",
                "            let server = 2",
                "        else",
                "            let other = 3",
                "        esac",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        case_expression_round_trips() is
            let source = lines([
                "namespace Test is",
                "    label(value: int) -> string =>",
                "        case value",
                "        when 200 then",
                "            \"ok\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    label(value: int) -> string =>",
                "        case value",
                "        when 200 then",
                "            \"ok\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        @Test()
        case_binding_pattern_round_trips() is
            let source = lines([
                "namespace Test is",
                "    describe(p: int) -> string =>",
                "        case p",
                "        when v: int then",
                "            \"int\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    describe(p: int) -> string =>",
                "        case p",
                "        when v: int then",
                "            \"int\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        @Test()
        case_literal_leaf_pattern_round_trips() is
            let source = lines([
                "namespace Test is",
                "    describe(p: (int, int)) -> string =>",
                "        case p",
                "        when (1, n) then",
                "            \"first\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    describe(p: (int, int)) -> string =>",
                "        case p",
                "        when (1, n) then",
                "            \"first\"",
                "        else",
                "            \"other\"",
                "        esac",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        @Test()
        if_let_chained_guard_round_trips() is
            let body = lines([
                "namespace Test is",
                "    sum(x: int?, y: int) -> int => if let v = x /\\ v > 0 /\\ y > v then v + y else 0 fi",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        generic_kind_constraint_round_trips() is
            let body = lines([
                "namespace Test is",
                "    typed[T: class](x: T) -> T => x",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        generic_new_constraint_round_trips() is
            let body = lines([
                "namespace Test is",
                "    typed[T: class init](x: T) -> T => x",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        generic_variance_constraint_round_trips() is
            let body = lines([
                "namespace Test is",
                "    trait COVARIANT[T: out] is",
                "    si",
                "    trait CONTRAVARIANT[T: in] is",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        optional_type_round_trips() is
            let body = lines([
                "namespace Test is",
                "    length(name: string?) -> int => if name? then name!.length else 0 fi",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        yield_in_iterable_returning_function_round_trips() is
            let body = lines([
                "namespace Test is",
                "    first_three() -> Collections.Iterable[int] is",
                "        yield 1",
                "        yield 2",
                "        yield 3",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        default_expression_round_trips() is
            let body = lines([
                "namespace Test is",
                "    blank() -> int => _",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        thread_first_chain_round_trips() is
            // `|>` is desugared at parse time into an ordinary call with
            // the subject as argument 0, so the formatter has to render
            // the chain back rather than the call it became.
            let body = lines([
                "namespace Test is",
                "    use Collections",
                "    first_big(xs: List[int]) -> int? => xs |> find(x => x > 10)",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // `val ... lav` is a value-producing block. The formatter
        // emits the keyword pair as its own lines so multi-statement
        // bodies stack vertically; each inner statement renders via
        // its own visit.

        @Test()
        val_lav_value_block_round_trips() is
            let source = lines([
                "namespace Test is",
                "    f() -> int => val let y = 5; y * 2 lav",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    f() -> int => val",
                "        let y = 5",
                "        y * 2",
                "    lav",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        @Test()
        val_lav_void_block_round_trips() is
            // Void-tail (LET) block in void position: the formatter
            // emits the same form; semantic context decides void vs
            // value at compile time, not at format time.
            let source = lines([
                "namespace Test is",
                "    f() is",
                "        val write_line(\"hi\"); let unused = 99; lav",
                "    si",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    f() is",
                "        val",
                "            write_line(\"hi\")",
                "            let unused = 99",
                "        lav",
                "    si",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        @Test()
        let_use_disposal_round_trips() is
            // `let use x = e` must keep its `use`: the disposal keyword is
            // load-bearing (it schedules a scope-exit dispose) and trivial
            // for the printer to drop.
            let body = lines([
                "namespace Test is",
                "    f(d: Disposable) is",
                "        let use x = d",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        let_use_in_disposal_round_trips() is
            // The `let use x = e in ...` expression form carries the same
            // `want_dispose` flag as a `let use` statement and must keep its
            // `use` through formatting.
            let body = lines([
                "namespace Test is",
                "    f(d: Disposable) is",
                "        let use x = d in g(x)",
                "    si",
                "    g(d: Disposable) is si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        backtick_escaped_keyword_identifiers_round_trip() is
            // A name that collides with a keyword is only an identifier
            // because it was backtick-escaped in source. The printer must
            // re-emit the backtick in every position - member declaration,
            // member reference, and local variable - or the output tokenises
            // as the keyword and no longer re-parses.
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        `field: int",
                "        `class: string",
                "        value() -> int is",
                "            let `let = `field",
                "            return `let",
                "        si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        backtick_escaped_numeric_identifiers_round_trip() is
            // A name made only of identifier characters but starting with a
            // digit tokenises as a number when bare, so it too can only be an
            // identifier via a backtick escape and must keep it on output.
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        `123: int",
                "        value() -> int => `123",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        backtick_escaped_operator_reference_round_trips() is
            // An operator referred to as a plain value (rather than applied)
            // must keep its backtick, or it re-parses as an operator token.
            // The operator stays bare where it is applied - the binary `f(a, b)`
            // call and any operator definition - so only the value position
            // gains the escape.
            let body = lines([
                "namespace Test is",
                "    apply[T](f: (T, T) -> T, a: T, b: T) -> T => f(a, b)",
                "    add(a: int, b: int) -> int => apply(`+, a, b)",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        trailing_comma_round_trips() is
            // A trailing comma adds no element, so nothing but the span of
            // the list records that the source wrote one. Dropping it would
            // move the cursor's argument slot under the author.
            let body = lines([
                "namespace Test is",
                "    scale(value: int, factor: int, offset: int) -> int => value * factor + offset",
                "    entry() is",
                "        let call = scale(1, 2, 3,)",
                "        let threaded = 1 |> scale(2, 3,)",
                "        let array = [1, 2, 3,]",
                "        let tuple = (1, 2,)",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        trailing_comma_survives_wrapping() is
            // Broken across lines the comma stays hard against the argument
            // it trails, leaving the closing bracket on its own line.
            let source = lines([
                "namespace Test is",
                "    scale(a_long_parameter_name: int, another_long_parameter: int) -> int => 0",
                "    entry() is",
                "        let wrapped = scale(a_very_long_argument_expression_here, another_very_long_argument_expression,)",
                "    si",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    scale(a_long_parameter_name: int, another_long_parameter: int) -> int => 0",
                "    entry() is",
                "        let wrapped = scale(",
                "            a_very_long_argument_expression_here,",
                "            another_very_long_argument_expression,",
                "        )",
                "    si",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        @Test()
        a_bodyless_trait_method_terminates_with_one_semicolon() is
            let body = lines([
                "namespace Test is",
                "    trait Shape is",
                "        area() -> double",
                "        name() -> string",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_bodyless_trait_property_terminates_with_one_semicolon() is
            let body = lines([
                "namespace Test is",
                "    trait Sized is",
                "        count: int",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        an_abstract_class_keeps_the_abstract_modifier() is
            let body = lines([
                "namespace Test is",
                "    class ANIMAL abstract is",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_nested_destructure_group_keeps_its_type_ascription() is
            let body = lines([
                "namespace Test is",
                "    union Tree is",
                "        LEAF(value: int)",
                "        NODE(left: Tree, right: Tree)",
                "    si",
                "    sum(t: Tree) -> int =>",
                "        case t",
                "        when ((ll, lr): NODE, r): NODE then",
                "            sum(ll) + sum(lr) + sum(r)",
                "        when v: LEAF then",
                "            v.value",
                "        esac",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_top_level_let_stays_interleaved_with_the_function_that_follows_it() is
            let body = lines([
                "let LIMIT = 20000",
                "sum(n: int) -> int => n + LIMIT"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_rec_marker_round_trips() is
            let body = lines([
                "let factorial = n rec => if n == 0 then 1 else n * rec(n - 1) fi"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_rec_marker_follows_a_written_return_type() is
            let body = lines([
                "let factorial = (n: int) -> int rec => if n == 0 then 1 else n * rec(n - 1) fi"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        an_await_expression_round_trips() is
            let body = lines([
                "compute() -> Tasks.TASK[int] is",
                "    let a = await double_async(10)",
                "    return a",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_use_of_an_operator_name_keeps_its_backtick() is
            let body = lines([
                "use Ghul.Pipes.`>>"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_sole_destructure_group_argument_keeps_its_parens() is
            let body = lines([
                "let add = ((a, b)) => a + b"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_typed_destructure_lambda_parameter_round_trips() is
            let body = lines([
                "let add = ((a, b): (int, int)) => a + b"
            ])

            assert_round_trips(body, body)
        si

        // A line comment written as the last item of a block belongs inside
        // the block, indented with the statements it follows - not after the
        // block's closing keyword.
        @Test()
        a_trailing_comment_stays_inside_every_block_form() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        while true do",
                "            write_line(\"x\")",
                "            // while note",
                "        od",
                "",
                "        do",
                "            write_line(\"x\")",
                "            // do note",
                "        od",
                "",
                "        for i in 1::2 do",
                "            write_line(\"x\")",
                "            // for note",
                "        od",
                "",
                "        case 1",
                "        when 1 then",
                "            write_line(\"x\")",
                "            // arm note",
                "        else",
                "            write_line(\"x\")",
                "            // else note",
                "        esac",
                "",
                "        try",
                "            write_line(\"x\")",
                "            // try note",
                "        catch e: System.Exception",
                "            write_line(\"x\")",
                "            // catch note",
                "        finally",
                "            write_line(\"x\")",
                "            // finally note",
                "        yrt",
                "",
                "        if true then",
                "            write_line(\"x\")",
                "            // then note",
                "        else",
                "            write_line(\"x\")",
                "            // else-arm note",
                "        fi",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A bare `assert` ending an arm leaves a dedented `else` to the
        // enclosing `if` or `case`.
        @Test()
        a_bare_assert_before_an_arm_else_round_trips() is
            let body = lines([
                "namespace Test is",
                "    entry(flag: bool) is",
                "        if flag then",
                "            assert flag",
                "        else",
                "            assert !flag",
                "        fi",
                "        case flag",
                "        when true then",
                "            assert flag",
                "        else",
                "            assert !flag",
                "        esac",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A comment after a block's closing keyword is the next statement's
        // leading comment, and a blank line after it is a separator: neither
        // may be pulled back inside the block.
        @Test()
        a_comment_after_a_closing_keyword_stays_outside_the_block() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        if true then",
                "            write_line(\"x\")",
                "        fi",
                "        // leads the next statement",
                "        write_line(\"y\")",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_blank_line_after_a_closing_keyword_stays_outside_the_block() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        if true then",
                "            write_line(\"x\")",
                "            // note",
                "        fi",
                "",
                "        write_line(\"y\")",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A comment between one case arm and the next arm's keyword belongs
        // to the arm it trails, not to the next arm's body.
        @Test()
        a_trailing_comment_precedes_the_next_case_arm_keyword() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        case 1",
                "        when 1 then",
                "            write_line(\"x\")",
                "            // one and done",
                "        else",
                "            write_line(\"y\")",
                "        esac",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A range prints without spaces around the operator, except where
        // that would run it into an operator beside it: `..-` scans as one
        // operator.
        @Test()
        a_range_prints_tight_unless_an_operator_would_run_into_it() is
            let source = lines([
                "namespace Test is",
                "    entry(xs: int[]) is",
                "        let a = 1 .. 10",
                "        let b = xs[0] .. xs[1]",
                "        let c = (1 + 0) .. (2 + 0)",
                "        let d = xs[0 ..< 1]",
                "        let e = x .. y + 1",
                "        let f = x + 1 .. y",
                "        let g = 0 .. -1",
                "    si",
                "si"
            ])

            let expected = lines([
                "namespace Test is",
                "    entry(xs: int[]) is",
                "        let a = 1..10",
                "        let b = xs[0]..xs[1]",
                "        let c = (1 + 0)..(2 + 0)",
                "        let d = xs[0..<1]",
                "        let e = x..y + 1",
                "        let f = x + 1..y",
                "        let g = 0 .. -1",
                "    si",
                "si"
            ])

            assert_round_trips(source, expected)
        si

        // Each of the fixtures below is a defect that made the compiler's
        // own formatted source fail to parse or fail to build, found by
        // formatting the whole of src/ and building the result.

        @Test()
        assign_accessor_body_keyword_is_separated() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        _value: int",
                "        value: int public",
                "            => _value,",
                "            = v is",
                "                _value = v",
                "            si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        statement_after_a_block_terminator_is_not_run_on() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        total(xs: int[]) -> int is",
                "            let t mut = 0",
                "            for x in xs do",
                "                t = t + x",
                "            od",
                "            t",
                "        si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        throw_expression_body_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        stub() -> int => throw System.Exception(\"nope\")",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        literal_escaping_round_trips() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        quote: char => '\\''",
                "        double_quote: char => '\"'",
                "        braces: string => \"a {{{{ b }}}} c\"",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        prefix_operator_stays_tight_against_its_operand() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        name: string?",
                "        anonymous: bool => !name?",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        tuple_literal_keeps_the_space_after_its_comma() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        pair: (int, int) => (1, 2)",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        empty_body_stays_on_one_line() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        trait_modifiers_are_separated_from_its_name() is
            let body = lines([
                "namespace Test is",
                "    trait Named open is",
                "        name: string",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_pragma_survives_formatting() is
            let body = lines([
                "namespace Test is",
                "    @System.Obsolete(\"old\")",
                "    class BOX is",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A postfix type constructor binds to a function type's result, so
        // dropping the parens changes what the type means.
        @Test()
        a_function_type_under_a_postfix_constructor_keeps_its_parens() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        callback: (() -> int)?",
                "        predicates: ((int) -> bool)[]",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A block comment's continuation lines carry the indentation they
        // were written at, and the renderer indents them again, so the
        // indent has to be stripped before they are re-emitted or the
        // comment moves four columns right on every pass.
        @Test()
        a_block_comment_does_not_drift_right() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        /*",
                "            indented continuation",
                "                deeper still",
                "        */",
                "        init() is si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A line break stands in for the terminator, so the formatter
        // writes none - except between two adjacent string literals, which
        // would otherwise chain into one literal across the break.
        @Test()
        the_string_separating_terminator_is_kept() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        let band = \"top\";",
                "        \"{{band}} band\"",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A statement ending in a block terminator leaves the line open,
        // and the next statement's leading comment must not be written
        // onto it.
        @Test()
        a_comment_after_a_block_terminator_starts_its_own_line() is
            let body = lines([
                "namespace Test is",
                "    class BOX is",
                "        total(xs: int[]) -> int is",
                "            let result mut = 0",
                "            for x in xs do",
                "                result = x",
                "            od",
                "            // the answer",
                "            result",
                "        si",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // Comments are transparent to string chaining, so a block comment
        // between two adjacent literals does not break the chain and the
        // terminator that separates them has to survive.
        @Test()
        a_block_comment_does_not_hide_the_string_separating_terminator() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        let a = \"one\";",
                "        /* why */",
                "        \"two\".length",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A leading `#!...` line is trivia the tokenizer only recognises as
        // the file's first two bytes, so the formatter has to carry it
        // through like any other comment rather than dropping it.
        @Test()
        a_leading_shebang_line_round_trips() is
            let body = lines([
                "#!/usr/bin/env ghul",
                "entry() is",
                "    IO.Std.write_line(\"hello\")",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // A by-name destructure names the field each leaf reads, and
        // written positionally it reads a different element or none.
        @Test()
        a_by_name_destructure_round_trips() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        let (a, (bb = b, cc: int = d), e) = triple",
                "        if let (\"Alice\" = name, v = value): NODE = next(t) then",
                "            write_line(v)",
                "        fi",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        named_arguments_round_trip() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        b.describe(scale = 3, label = \"again\")",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        multiple_type_parameter_bounds_round_trip() is
            let body = lines([
                "namespace Test is",
                "    measure[T: Named /\\ Sized class](x: T) -> int => x.size",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // An operator reached as a member is an identifier only under its
        // backtick: `a.=~(b)` scans `.=~` as one operator.
        @Test()
        an_operator_called_as_a_member_keeps_its_backtick() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        let same = a.`=~(b)",
                "        let sum = int.`+(1, 2)",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        parameter_attributes_round_trip() is
            let body = lines([
                "namespace Test is",
                "    first(@SIMPLE() x: int) -> int => x",
                "    entry() is",
                "        let h = (@SIMPLE() y: int) -> int => y",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // `123.get_type()` scans `123.` as the start of a float.
        @Test()
        a_member_of_an_integer_literal_keeps_its_space() is
            let body = lines([
                "namespace Test is",
                "    entry() is",
                "        let t = 123 .get_type()",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        isa_on_a_generic_variant_round_trips() is
            let body = lines([
                "namespace Test is",
                "    ok(a: RESULT[int, string]) -> bool => isa RESULT[int, string].OK(a)",
                "si"
            ])

            assert_round_trips(body, body)
        si

        // An arm ending in a block terminator leaves the line open, and the
        // `esac` after it must not run onto it.
        @Test()
        a_case_arm_ending_in_a_loop_round_trips() is
            let body = lines([
                "namespace Test is",
                "    leaves(tree: Tree) -> Pipe[int] is",
                "        case tree",
                "        when (value): LEAF then",
                "            yield value",
                "        when (left, right): NODE then",
                "            for v in leaves(left) do",
                "                yield v",
                "            od",
                "        esac",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si


        // `|>` and `~>` sit between range and relational, so a subject
        // gathered from a tighter operator prints without parentheses, a
        // chain under a prefix operator or a tighter operator keeps the
        // ones written around it, and an operator after the call applies
        // to the whole chain.
        @Test()
        thread_first_precedence_round_trips() is
            let body = lines([
                "namespace Test is",
                "    f(xs: int[], n: int) is",
                "        let a = 1 + n |> twice()",
                "        let b = 0..n |> map(i => i * i) |> count()",
                "        let c = !(xs |> any(x => x > 3))",
                "        let d = 2 * (xs |> count())",
                "        let e = (1 + n) * 2 |> twice()",
                "        let g = xs |> count() % 2",
                "        let h = xs |> count() > 3 /\\ n |> twice() == 6",
                "        let i = xs |> collect_list()[0]",
                "        let j = xs |> collect_list().count + 1",
                "        let k = maybe() ~> lookup() ?? 7",
                "        let l = await get() |> twice()",
                "        let m = -n |> twice()",
                "    si",
                "si"
            ])

            assert_round_trips(body, body)
        si

        @Test()
        a_wrapped_thread_first_chain_round_trips() is
            let body = lines([
                "namespace Test is",
                "    f(xs: int[]) -> int =>",
                "        xs",
                "            |> filter(x => x % 2 == 0)",
                "            |> map(x => x * 10)",
                "            |> reduce(0, (a, x) => a + x)",
                "si"
            ])

            let first = format(body)

            are_equal(first, format(first), "formatter is not a fixpoint")
        si

    si
si
