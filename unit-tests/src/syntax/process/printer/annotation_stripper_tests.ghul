namespace Syntax.Process.Printer.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Syntax.Process.Printer.ANNOTATION_STRIPPER
    use Syntax.Process.Printer.FORMATTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class ANNOTATION_STRIPPER_TESTS is
        init() is si

        location() -> Source.LOCATION => Source.LOCATION("test.ghul", 1, 1, 1, 1)

        @Test()
        Stripping__with_all__should_take_every_site_and_number_them() is
            let stripper = ANNOTATION_STRIPPER("all")

            is_true(stripper.strip("local", location(), "type", location(), location()))
            is_true(stripper.strip("parameter", location(), "type", location(), location()))
            are_equal(2, stripper.sites.count)
            is_true(stripper.sites[1].starts_with("1 parameter "))
        si

        @Test()
        Stripping__with_list__should_number_every_site_and_take_none() is
            let stripper = ANNOTATION_STRIPPER("list")

            is_false(stripper.strip("local", location(), "type", location(), location()))
            is_false(stripper.strip("return", location(), "type", location(), location()))
            are_equal(2, stripper.sites.count)
        si

        @Test()
        Stripping__with_numbers_and_a_range__should_take_only_those_sites() is
            let stripper = ANNOTATION_STRIPPER("0,2-3")

            is_true(stripper.strip("local", location(), "type", location(), location()))
            is_false(stripper.strip("local", location(), "type", location(), location()))
            is_true(stripper.strip("local", location(), "type", location(), location()))
            is_true(stripper.strip("local", location(), "type", location(), location()))
            is_false(stripper.strip("local", location(), "type", location(), location()))
        si

        // A lambda parameter written with a type prints without it when
        // the stripper takes the site, and with it otherwise.
        parameter() -> Trees.Node =>
            Trees.Expressions.VARIABLE(
                location(),
                Trees.Identifiers.Identifier(location(), "x"),
                Trees.TypeExpressions.NAMED(location(), Trees.Identifiers.Identifier(location(), "int")),
                null
            )

        format(node: Trees.Node, selection: string?) -> string is
            let formatter = FORMATTER(Collections.LIST[Lexical.TRIVIA](), 100)

            if let s = selection then
                formatter.stripper = ANNOTATION_STRIPPER(s)
            fi

            formatter.format(node).trim()
        si

        @Test()
        Stripping__should_list_the_span_the_annotation_occupies() is
            let stripper = ANNOTATION_STRIPPER("list")

            stripper.strip("local", Source.LOCATION("test.ghul", 3, 5, 3, 9), "type", Source.LOCATION("test.ghul", 3, 11, 3, 13), Source.LOCATION("test.ghul", 3, 11, 3, 13))

            are_equal("0 local 3,5 type 3,11,3,13 3,13", stripper.sites[0])
        si

        // The sites listed for `source`, parsed and printed as the driver's
        // `--strip-annotations list` does.
        list_sites(source: string) -> Collections.LIST[string] => list_sites(source, "list")

        list_sites(source: string, selection: string) -> Collections.LIST[string] is
            let logger = Logging.DIAGNOSTICS_STORE()
            let source_file = Compiler.COMPILER().parse("strip.ghul", IO.StringReader(source), false, false, false, logger)

            is_false(logger.any_errors, "fixture did not parse")

            let formatter = FORMATTER(source_file.trivia, 100)
            let stripper = ANNOTATION_STRIPPER(selection)

            formatter.stripper = stripper
            formatter.format(source_file.definition)

            stripper.sites
        si

        @Test()
        Listing__a_single_type_argument__should_give_the_brackets_after_the_name() is
            let sites = list_sites("let xs = LIST[int]()\n")

            // The listed end is the call's, one past the closing ']' at column
            // 18; a consumer takes the span up to that ']'.
            are_equal(1, sites.count)
            are_equal("0 type-arguments 1,10 after 1,10,1,13 1,19", sites[0])
        si

        @Test()
        Listing__two_type_arguments__should_give_the_brackets_after_the_name() is
            let sites = list_sites("let m = MAP[int, string]()\n")

            are_equal(1, sites.count)
            is_true(sites[0].starts_with("0 type-arguments 1,9 after 1,9,1,11 "))
        si

        @Test()
        Listing__a_typed_local__should_give_the_written_type() is
            let sites = list_sites("let count: int = 0\n")

            are_equal(1, sites.count)
            are_equal("0 local 1,5 type 1,12,1,14 1,14", sites[0])
        si

        @Test()
        Formatting__a_typed_parameter_with_no_stripper__should_keep_its_type() is
            are_equal("x: int", format(parameter(), null))
        si

        @Test()
        Formatting__a_typed_parameter_stripping_all__should_leave_the_type_out() is
            are_equal("x", format(parameter(), "all"))
        si

        @Test()
        Formatting__a_typed_parameter_stripping_another_site__should_keep_its_type() is
            are_equal("x: int", format(parameter(), "5"))
        si

        @Test()
        Listing__with_the_cast_prefix__should_give_only_the_cast_target() is
            let sites = list_sites("let n = 3\nlet d: double = cast double(n)\n", "cast:list")

            are_equal(1, sites.count)
            are_equal("0 cast 2,17 type 2,22,2,27 2,27", sites[0])
        si

        @Test()
        Listing__without_the_cast_prefix__should_leave_cast_targets_out() is
            let sites = list_sites("let d: double = cast double(3)\n")

            are_equal(1, sites.count)
            is_true(sites[0].contains(" local "))
        si

        @Test()
        Formatting__a_cast_stripping_its_target__should_print_the_untyped_cast() is
            let logger = Logging.DIAGNOSTICS_STORE()
            let source_file = Compiler.COMPILER().parse("strip.ghul", IO.StringReader("let d: double = cast double(3)\n"), false, false, false, logger)
            let formatter = FORMATTER(source_file.trivia, 100)

            formatter.stripper = ANNOTATION_STRIPPER("cast:all")

            is_true(formatter.format(source_file.definition).contains("let d: double = cast(3)"))
        si
    si
si
