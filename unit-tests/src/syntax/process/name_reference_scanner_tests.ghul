namespace Syntax.Process.UnitTests is
    use Collections.LIST

    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for NAME_REFERENCE_SCANNER - the scan that decides whether a
    // nested named function refers to itself, and so whether its closure
    // recurses. The answer is fixed when the closure is built, before any
    // name is resolved, so the scan reads written names and walks into
    // nested literals rather than stopping at them. Builds plain
    // expression trees; no semantic resolution required.
    @TestClass()
    class NAME_REFERENCE_SCANNER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        ident_expr(name: string) -> Trees.Expressions.IDENTIFIER =>
            Trees.Expressions.IDENTIFIER(loc(), Trees.Identifiers.Identifier(loc(), name))

        expression_body(expression: Trees.Expressions.Expression) -> Trees.Bodies.EXPRESSION =>
            Trees.Bodies.EXPRESSION(loc(), expression)

        call(callee: string, arguments: Trees.Expressions.Expression[]) -> Trees.Expressions.CALL =>
            Trees.Expressions.CALL(
                loc(),
                ident_expr(callee),
                Trees.Expressions.LIST(loc(), LIST[Trees.Expressions.Expression](arguments))
            )

        no_arguments() -> Trees.Expressions.Expression[] =>
            LIST[Trees.Expressions.Expression]()

        @Test()
        Body_that_never_names_the_function_should_not_reference_it() is
            let body = expression_body(call("other", no_arguments()))

            is_false(NAME_REFERENCE_SCANNER().body_references(body, "f"))
        si

        @Test()
        Body_that_calls_the_function_should_reference_it() is
            let body = expression_body(call("f", no_arguments()))

            is_true(NAME_REFERENCE_SCANNER().body_references(body, "f"))
        si

        @Test()
        Name_read_as_a_value_should_reference_it() is
            let body = expression_body(call("apply", LIST[Trees.Expressions.Expression]([ident_expr("f")])))

            is_true(NAME_REFERENCE_SCANNER().body_references(body, "f"))
        si

        // A literal written inside the function can call it, and reaches
        // it the same way, so the scan must not stop at the boundary the
        // await and yield scanners stop at.
        @Test()
        Name_inside_a_nested_literal_should_reference_it() is
            let inner =
                Trees.Expressions.FUNCTION(
                    loc(),
                    Trees.Expressions.LIST(loc(), LIST[Trees.Expressions.Expression]()),
                    Trees.TypeExpressions.INFER(loc()),
                    expression_body(call("f", no_arguments())),
                    false
                )

            is_true(NAME_REFERENCE_SCANNER().body_references(expression_body(inner), "f"))
        si

        @Test()
        Scanning_a_second_body_should_not_carry_the_first_result() is
            let scanner = NAME_REFERENCE_SCANNER()

            is_true(scanner.body_references(expression_body(call("f", no_arguments())), "f"))
            is_false(scanner.body_references(expression_body(call("other", no_arguments())), "f"))
        si

        @Test()
        Absent_body_should_not_reference_the_name() is
            is_false(NAME_REFERENCE_SCANNER().body_references(null, "f"))
        si
    si
si
