namespace Compiler.UnitTests is
    use Semantic.Symbols

    class BUILD_STATE_TESTS is
        init() is si

        @test()
        reset__numbers_synthesised_frames_from_the_start_again() is
            FRAME.next_id
            STATE_MACHINE_FRAME.next_id
            ASYNC_STATE_MACHINE_FRAME.next_id

            Compiler.BUILD_STATE.reset()

            assert FRAME.next_id == 0
            assert STATE_MACHINE_FRAME.next_id == 0
            assert ASYNC_STATE_MACHINE_FRAME.next_id == 0
        si
    si
si
