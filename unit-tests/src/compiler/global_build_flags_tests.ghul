namespace Compiler.UnitTests is
    use Compiler.GLOBAL_BUILD_FLAGS
    use Compiler.Target

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins when a build is refused for want of a wasm loader: only a wasm
    // executable needs one, since the loader ships with the core library.
    @TestClass()
    class GLOBAL_BUILD_FLAGS_TESTS is
        init() is si

        flags(target: Target, want_executable: bool, want_library: bool, loader: string?) -> GLOBAL_BUILD_FLAGS is
            let result = GLOBAL_BUILD_FLAGS()

            result.target = target
            result.want_executable = want_executable
            result.want_library = want_library
            result.wasm_loader = loader

            return result
        si

        @Test()
        is_missing_wasm_loader__a_wasm_executable_without_a_loader__is_true() is
            is_true(flags(Target.WASM, true, false, null).is_missing_wasm_loader)
        si

        @Test()
        is_missing_wasm_loader__a_wasm_executable_with_a_loader__is_false() is
            is_false(flags(Target.WASM, true, false, "loader.mjs").is_missing_wasm_loader)
        si

        @Test()
        is_missing_wasm_loader__a_wasm_library__is_false() is
            is_false(flags(Target.WASM, true, true, null).is_missing_wasm_loader)
        si

        @Test()
        is_missing_wasm_loader__a_wasm_build_that_writes_nothing__is_false() is
            is_false(flags(Target.WASM, false, false, null).is_missing_wasm_loader)
        si

        @Test()
        is_missing_wasm_loader__another_target__is_false() is
            is_false(flags(Target.LLVM, true, false, null).is_missing_wasm_loader)
            is_false(flags(Target.DOTNET, true, false, null).is_missing_wasm_loader)
        si
    si
si
