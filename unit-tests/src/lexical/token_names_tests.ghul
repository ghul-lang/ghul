namespace Lexical.UnitTests is
    use Collections

    class TOKEN_NAMES_TESTS is
        init() is si

        @test()
        a_keyword_is_quoted() is
            Assertions.are_equal("'si'", TOKEN_NAMES.quoted(TOKEN.SI))
        si

        @test()
        punctuation_is_quoted() is
            Assertions.are_equal("'('", TOKEN_NAMES.quoted(TOKEN.PAREN_OPEN))
        si

        @test()
        a_category_of_token_is_bare() is
            Assertions.are_equal("identifier", TOKEN_NAMES.quoted(TOKEN.IDENTIFIER))
            Assertions.are_equal("int literal", TOKEN_NAMES.quoted(TOKEN.INT_LITERAL))
            Assertions.are_equal("end of input", TOKEN_NAMES.quoted(TOKEN.END_OF_INPUT))
        si

        @test()
        an_unknown_token_is_a_category_and_bare() is
            Assertions.are_equal("unknown", TOKEN_NAMES.quoted(TOKEN.UNKNOWN))
        si

        @test()
        the_plain_name_carries_no_quotes() is
            Assertions.are_equal("si", TOKEN_NAMES[TOKEN.SI])
        si

        @test()
        a_list_quotes_each_keyword_and_leaves_categories_bare() is
            let listed = TOKEN_NAMES.quoted(LIST[TOKEN]([TOKEN.SI, TOKEN.IDENTIFIER, TOKEN.PAREN_OPEN]))

            Assertions.are_equal("'(', identifier or 'si'", listed)
        si
    si
si
