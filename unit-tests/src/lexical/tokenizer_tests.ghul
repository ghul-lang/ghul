namespace Lexical.UnitTests is
    use Collections

    use Logging
    use Assertions

    class TOKENIZER_TESTS is
        init() is si

        split_at_white_space(source_string: string) -> Iterable[string]
            => source_string.split([' ', '\t', '\r', '\n'], System.StringSplitOptions.REMOVE_EMPTY_ENTRIES)

        @test()
        Given_a_list_of_space_separated_identifiers__next__should_return_one_non_eof_token_for_each_identifier() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si

        @test()
        Given_a_list_of_multi_white_space_separated_identifiers__next__should_return_one_non_eof_token_for_each_identifier() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "a    list  \n of \r\n identifier tokens    "

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si

        @test()
        Given_a_list_of_space_separated_identifiers__next__should_return_eof_after_the_last_identifier() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si

        @test()
        Given_a_list_of_multi_white_space_separated_identifiers__next__should_return_eof_after_the_last_identifier() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "\t\ta \t\t\tlist of \r\n identifier\n tokens\n\t\t"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()
                assert result.token != TOKEN.END_OF_INPUT
            od

            let result = tokenizer.read_token()
            assert result.token == TOKEN.END_OF_INPUT
        si

        @test()
        Given_a_list_of_space_separated_identifiers__current_token__should_be_IDENTIFIER_for_each_identifier() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in split_at_white_space(source_string) do
                let result = tokenizer.read_token()

                assert result.token == TOKEN.IDENTIFIER
            od
        si

        @test()
        Given_a_list_of_space_separated_identifiers__current_value_string__should_be_each_identifier_in_turn() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "a list of identifier tokens"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            for expected_identifier in source_string.split([' ']) do
                let result = tokenizer.read_token()

                assert result.value_string =~ expected_identifier
            od
        si

        @test()
        Given_a_list_of_space_separated_identifiers__current__should_be_IDENTIFIER_for_each_identifier() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let reader = IO.StringReader("a list of identifier tokens")

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            let expected_tokens = [TOKEN.IDENTIFIER, TOKEN.IDENTIFIER, TOKEN.IDENTIFIER, TOKEN.IDENTIFIER, TOKEN.IDENTIFIER].iterator

            do
                let result = tokenizer.read_token()

                if result.token == TOKEN.END_OF_INPUT then
                    break
                fi

                is_true(expected_tokens.move_next())

                are_equal(result.token, expected_tokens.current)
            od

            is_false(expected_tokens.move_next())
        si

        @test()
        is_reserved_word__is_true_for_a_keyword() is
            is_true(TOKENIZER.is_reserved_word("class"))
            is_true(TOKENIZER.is_reserved_word("field"))
        si

        @test()
        is_reserved_word__is_false_for_a_plain_identifier() is
            is_false(TOKENIZER.is_reserved_word("value"))
            is_false(TOKENIZER.is_reserved_word("field_count"))
        si

        @test()
        is_reserved_word__is_false_for_null_or_empty() is
            is_false(TOKENIZER.is_reserved_word(null))
            is_false(TOKENIZER.is_reserved_word(""))
        si

        @test()
        is_numeric_identifier__is_true_for_a_digit_led_word() is
            is_true(TOKENIZER.is_numeric_identifier("123"))
            is_true(TOKENIZER.is_numeric_identifier("1st"))
        si

        @test()
        is_numeric_identifier__is_false_for_a_letter_led_name() is
            is_false(TOKENIZER.is_numeric_identifier("v1"))
            is_false(TOKENIZER.is_numeric_identifier("field"))
        si

        @test()
        is_numeric_identifier__is_false_when_escaping_would_not_round_trip() is
            // A dotted or symbol-bearing name cannot survive a backtick escape
            // (the escape consumes only identifier characters), so it must not
            // be reported as escapable.
            is_false(TOKENIZER.is_numeric_identifier("12.5"))
            is_false(TOKENIZER.is_numeric_identifier(""))
        si

        @test()
        is_operator_name__is_true_for_operator_character_runs() is
            is_true(TOKENIZER.is_operator_name("+"))
            is_true(TOKENIZER.is_operator_name("##"))
            is_true(TOKENIZER.is_operator_name("=~"))
        si

        @test()
        is_operator_name__is_false_for_names_and_empty() is
            is_false(TOKENIZER.is_operator_name("plus"))
            is_false(TOKENIZER.is_operator_name("a+b"))
            is_false(TOKENIZER.is_operator_name(""))
        si

        @test()
        is_operator_name__is_true_for_a_non_ascii_symbol() is
            is_true(TOKENIZER.is_operator_name("\u00D7"))
            is_true(TOKENIZER.is_operator_name("\u222A"))
        si

        // These classification tests run on every target the unit tests
        // build for, so a compiler built for wasm or llvm reads identifiers
        // as one built for .NET does: an integration test is compiled by
        // the .NET-hosted compiler and so can't tell them apart.
        @test()
        is_identifier_start__accepts_a_letter_of_any_script() is
            is_true(TOKENIZER.is_identifier_start('a'))
            is_true(TOKENIZER.is_identifier_start('_'))
            is_true(TOKENIZER.is_identifier_start('\u00EF'))
            is_true(TOKENIZER.is_identifier_start('\u03A9'))
            is_true(TOKENIZER.is_identifier_start('\u0414'))
            is_true(TOKENIZER.is_identifier_start('\u6F22'))
            is_true(TOKENIZER.is_identifier_start('\u2167'))
        si

        @test()
        is_identifier_start__rejects_digits_symbols_and_format_characters() is
            is_false(TOKENIZER.is_identifier_start('0'))
            is_false(TOKENIZER.is_identifier_start('+'))
            is_false(TOKENIZER.is_identifier_start('\u00D7'))
            is_false(TOKENIZER.is_identifier_start('\u200D'))
            is_false(TOKENIZER.is_identifier_start('\u093F'))
        si

        @test()
        is_identifier_part__adds_digits_and_marks_to_the_start_set() is
            is_true(TOKENIZER.is_identifier_part('0'))
            is_true(TOKENIZER.is_identifier_part('\u0661'))
            is_true(TOKENIZER.is_identifier_part('\u0308'))
            is_true(TOKENIZER.is_identifier_part('\u093F'))
            is_true(TOKENIZER.is_identifier_part('\u6F22'))
        si

        @test()
        is_identifier_part__rejects_symbols_and_format_characters() is
            is_false(TOKENIZER.is_identifier_part('+'))
            is_false(TOKENIZER.is_identifier_part('\u00D7'))
            is_false(TOKENIZER.is_identifier_part('\u200D'))
        si

        // A letter is never a symbol, so no character is both an
        // operator character and an identifier character.
        @test()
        an_operator_character_is_never_an_identifier_character() is
            is_true(TOKENIZER.is_operator_char('\u00D7'))
            is_false(TOKENIZER.is_identifier_part('\u00D7'))
            is_true(TOKENIZER.is_identifier_start('\u03A9'))
            is_false(TOKENIZER.is_operator_char('\u03A9'))
        si

        @test()
        is_format_char__is_true_only_for_non_ascii_format_characters() is
            is_true(TOKENIZER.is_format_char('\u200D'))
            is_true(TOKENIZER.is_format_char('\u202E'))
            is_false(TOKENIZER.is_format_char('a'))
            is_false(TOKENIZER.is_format_char('\u00EF'))
        si

        @test()
        a_leading_shebang_line_is_recorded_as_trivia_and_does_not_produce_tokens() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "#!/usr/bin/env ghul\nentry"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            let result = tokenizer.read_token()

            are_equal(TOKEN.IDENTIFIER, result.token)
            are_equal("entry", result.value_string)

            let trivia = Collections.LIST[TRIVIA]()
            for t in tokenizer.trivia do
                trivia.add(t)
            od

            are_equal(1, trivia.count)

            if let sb: TRIVIA.SHEBANG = trivia[0] then
                are_equal("#!/usr/bin/env ghul", sb.text)
            else
                is_true(false, "expected a SHEBANG trivia entry")
            fi
        si

        // `#` on its own, at the very start of the file, is not a shebang -
        // only `#!` is - so it must still tokenise as an ordinary operator
        // character rather than being swallowed.
        @test()
        a_leading_hash_not_followed_by_bang_is_not_treated_as_a_shebang() is
            let logger = Logging.DIAGNOSTICS_STORE()

            let source_string = "#(a, b)"

            let reader = IO.StringReader(source_string)

            let tokenizer = TOKENIZER(logger, "dummy.ghul", reader, false)

            let result = tokenizer.read_token()

            are_equal(TOKEN.OPERATOR, result.token)
            are_equal("#", result.value_string)

            let trivia = Collections.LIST[TRIVIA]()
            for t in tokenizer.trivia do
                trivia.add(t)
            od

            are_equal(0, trivia.count)
        si
        @test()
        Given_decimal_digits_with_an_r_or_j_suffix__read_token__should_return_one_float_literal_holding_the_suffix() is
            for source_string in ["2r", "2j", "2.5r", "2.5J", "1.5e3j", "1_000R"] do
                let tokenizer = TOKENIZER(Logging.DIAGNOSTICS_STORE(), "dummy.ghul", IO.StringReader(source_string), false)

                let result = tokenizer.read_token()

                assert result.token == TOKEN.FLOAT_LITERAL
                assert result.value_string =~ source_string.replace("_", "")
                assert tokenizer.read_token().token == TOKEN.END_OF_INPUT
            od
        si

        @test()
        Given_hex_digits_followed_by_j__read_token__should_not_read_the_j_as_a_suffix() is
            let tokenizer = TOKENIZER(Logging.DIAGNOSTICS_STORE(), "dummy.ghul", IO.StringReader("0x1j"), false)

            let literal = tokenizer.read_token()

            assert literal.token == TOKEN.INT_LITERAL
            assert literal.value_string =~ "0x1"
            assert tokenizer.read_token().token == TOKEN.IDENTIFIER
        si
    si
si
