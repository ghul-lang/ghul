namespace Fixtures is
    // Enters a function on the container's local id generator. Every local
    // variable takes its IL name from the generator, which has a counter
    // only inside a function, so a test that makes one enters a function
    // first.
    enter_function() is
        let container = IoC.CONTAINER.instance

        if !container.local_id_generator? then
            container.local_id_generator = IR.LOCAL_ID_GENERATOR()
        fi

        container.local_id_generator.enter_function()
    si

    // Installs the unit tests' own innate symbol lookup, for a test that
    // reaches the built-in types without loading the .NET assemblies the
    // compiler's own lookup reads them from.
    use_test_innate_symbol_lookup() is
        let container = IoC.CONTAINER.instance

        if !isa Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP(container.innate_symbol_lookup) then
            container.innate_symbol_lookup = Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP()
        fi
    si
si
