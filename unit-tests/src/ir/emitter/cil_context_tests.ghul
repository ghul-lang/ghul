namespace IR.Emitter.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Collections.LIST

    use Semantic.Types.INFERRED_RETURN_TYPE
    use Semantic.Types.Type

    use Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // CONTEXT.contains_sentinel decides whether an invocation on a
    // function value can be encoded at all: any inference sentinel in
    // the type, at the root or nested in a composite's arguments,
    // means inference never settled and the call must be reported
    // rather than emitted.
    @TestClass()
    class CIL_CONTEXT_TESTS is
        init() is si

        lookup() -> Semantic.Lookups.InnateSymbolLookup => TEST_INNATE_SYMBOL_LOOKUP()

        @Test()
        contains_sentinel_is_true_for_a_sentinel_at_the_root() is
            is_true(IR.Emitter.CIL_CONTEXT.contains_sentinel(INFERRED_RETURN_TYPE()))
            is_true(IR.Emitter.CIL_CONTEXT.contains_sentinel(Semantic.Types.ERROR()))
        si

        @Test()
        contains_sentinel_is_true_for_a_sentinel_nested_in_a_function_return() is
            let l = lookup()
            let arguments = LIST[Type]([l.get_int_type(), cast Type(INFERRED_RETURN_TYPE())])

            is_true(IR.Emitter.CIL_CONTEXT.contains_sentinel(l.get_function_type(arguments)))
        si

        @Test()
        contains_sentinel_is_true_for_a_sentinel_nested_two_levels_down() is
            let l = lookup()
            let inner = LIST[Type]([l.get_int_type(), cast Type(INFERRED_RETURN_TYPE())])
            let outer = LIST[Type]([l.get_int_type(), l.get_function_type(inner)])

            is_true(IR.Emitter.CIL_CONTEXT.contains_sentinel(l.get_function_type(outer)))
        si

        @Test()
        contains_sentinel_is_false_for_null() is
            is_false(IR.Emitter.CIL_CONTEXT.contains_sentinel(null))
        si

        @Test()
        contains_sentinel_is_false_for_a_concrete_type() is
            is_false(IR.Emitter.CIL_CONTEXT.contains_sentinel(lookup().get_int_type()))
        si

        @Test()
        contains_sentinel_is_false_for_a_settled_function_type() is
            let l = lookup()
            let arguments = LIST[Type]([l.get_int_type(), l.get_int_type()])

            is_false(IR.Emitter.CIL_CONTEXT.contains_sentinel(l.get_function_type(arguments)))
        si
    si
si
