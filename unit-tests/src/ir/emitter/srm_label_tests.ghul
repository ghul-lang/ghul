namespace IR.Emitter.UnitTests is
    use System.Reflection.Metadata.ILOpCode

    use IR.Emitter.SRM_METHOD_BODY_EMITTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Labels in a method body: each IR label is its own encoder label,
    // whatever its name.
    @TestClass()
    class SRM_LABEL_TESTS is
        init() is si

        // A label is told apart from another by identity, not by name:
        // ids restart per pass, so two labels can render alike. Keyed
        // by name, a branch to an unmarked label would resolve to a
        // marked label of the same name instead of being reported.
        @Test()
        flushing__should_report_a_branch_to_an_unmarked_label_whose_name_another_label_shares() is
            let context =
                IR.Emitter.CIL_CONTEXT(
                    NSubstitute.Substitute.`for`[Logging.Logger](System.Array.empty`[object]()))

            context.install_srm_assembly_emitter("test", "0:0:0:0", true)

            let body = SRM_METHOD_BODY_EMITTER()

            LABEL.reset_id()
            let marked = LABEL()

            LABEL.reset_id()
            let unmarked = LABEL()

            are_equal("{marked}", "{unmarked}")

            body.mark_label(marked)
            body.branch(ILOpCode.BR, unmarked)
            body.ret()

            let reported mut = false

            try
                body.flush(context.srm_assembly_emitter)
            catch e: System.InvalidOperationException
                reported = true
            yrt

            is_true(reported, "a branch to an unmarked label resolved to another label of the same name")
        si
    si
si
