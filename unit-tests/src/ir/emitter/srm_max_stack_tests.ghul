namespace IR.Emitter.UnitTests is
    use System.Reflection.Metadata.ILOpCode

    use IR.Emitter.SRM_METHOD_BODY_EMITTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The max stack a body declares: an upper bound on the evaluation
    // stack depth that stays small for a small body, since the JIT does
    // not inline a body that declares a large one.
    @TestClass()
    class SRM_MAX_STACK_TESTS is
        init() is si

        @Test()
        Calling__max_stack__on_an_empty_body__should_return_zero() is
            let body = SRM_METHOD_BODY_EMITTER()

            body.ret()

            are_equal(0, body.max_stack)
        si

        @Test()
        Calling__max_stack__on_a_size_of__should_count_it() is
            let body = SRM_METHOD_BODY_EMITTER()

            body.size_of(System.Reflection.Metadata.Ecma335.MetadataTokens.entity_handle(0x1B000001))
            body.ret()

            are_equal(1, body.max_stack)
        si

        // Only what is encoded counts: an instruction after the return is
        // never reached, and is dropped.
        @Test()
        Calling__max_stack__should_not_count_unreachable_instructions() is
            let body = SRM_METHOD_BODY_EMITTER()

            body.ldarg(0)
            body.ret()
            body.ldarg(1)
            body.ret()

            are_equal(1, body.max_stack)
        si

        @Test()
        Calling__max_stack__on_an_array_length_getter__should_return_one() is
            let body = SRM_METHOD_BODY_EMITTER()

            body.ldarg(0)
            body.op(ILOpCode.LDLEN)
            body.ret()

            are_equal(1, body.max_stack)
        si

        @Test()
        Calling__max_stack__should_count_each_instruction_that_can_push() is
            let body = SRM_METHOD_BODY_EMITTER()

            // two loads and a dup can reach a depth of three
            body.ldarg(1)
            body.ldc_i4(3)
            body.op(ILOpCode.DUP)
            body.op(ILOpCode.MUL)
            body.op(ILOpCode.MUL)
            body.ret()

            is_true(body.max_stack >= 3, "the bound must not be below the true depth of 3")
            are_equal(3, body.max_stack)
        si

        @Test()
        Calling__max_stack__should_not_count_instructions_that_pop_at_least_what_they_push() is
            let body = SRM_METHOD_BODY_EMITTER()

            body.ldarg(0)
            body.ldarg(1)
            body.op(ILOpCode.ADD)
            body.op(ILOpCode.CONV_I8)
            body.op(ILOpCode.POP)
            body.ret()

            are_equal(2, body.max_stack)
        si

        @Test()
        Calling__max_stack__should_count_opcodes_passed_through_op_that_push() is
            let body = SRM_METHOD_BODY_EMITTER()

            body.op(ILOpCode.LDARG_0)
            body.op(ILOpCode.LDC_I4_1)
            body.op(ILOpCode.LDNULL)
            body.op(ILOpCode.POP)
            body.op(ILOpCode.ADD)
            body.ret()

            are_equal(3, body.max_stack)
        si
    si
si
