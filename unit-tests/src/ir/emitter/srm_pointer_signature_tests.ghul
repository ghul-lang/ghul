namespace IR.Emitter.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // ECMA-335 II.23.2.4: a pointer is its own element type in a
    // signature. Encoding one as the generic it is modelled by names a
    // type the runtime has never heard of, and a slot declared that way
    // holds an object reference where its readers expect a native
    // integer — which loads and then fails to JIT.
    @TestClass()
    class SRM_POINTER_SIGNATURE_TESTS is
        init() is si

        ELEMENT_TYPE_PTR: ubyte static => 0x0Fub
        FIELD_SIGNATURE: ubyte static => 0x06ub

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        names_for(values: Collections.Iterable[string]) -> LIST[string] is
            let result = LIST[string]()

            for v in values do
                result.add(v)
            od

            return result
        si

        make_class_type(name: string) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            c.set_type(Semantic.Types.NAMED(c))
            return c.type!
        si

        // A primitive pointee, so the encoding under test is reached
        // without the pointee itself needing a reference row.
        make_primitive_type(name: string, built_in_type: Semantic.Symbols.BuiltInType) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            c.set_type(Semantic.Types.NAMED(c))
            c.built_in_type = built_in_type
            return c.type!
        si

        make_pointer(pointee: Type) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "POINTER", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let arguments = LIST[Type]()

            arguments.add(pointee)

            return Semantic.Types.POINTER(loc(), c, arguments)
        si

        encoder() -> SRM_SIGNATURE_ENCODER =>
            SRM_SIGNATURE_ENCODER(SRM_ASSEMBLY_EMITTER("test", "test", "1:0:0:0", true))

        @Test()
        Encoding_a_pointer_field__emits_the_pointer_element_type() is
            let signature = encoder().field_signature(make_pointer(make_primitive_type("int", Semantic.Symbols.BuiltInType.INT32)))

            are_equal(FIELD_SIGNATURE, signature[0])
            are_equal(ELEMENT_TYPE_PTR, signature[1])
        si

        @Test()
        Encoding_a_non_pointer_field__does_not_emit_the_pointer_element_type() is
            let signature = encoder().field_signature(make_primitive_type("int", Semantic.Symbols.BuiltInType.INT32))

            are_equal(FIELD_SIGNATURE, signature[0])
            are_not_equal(ELEMENT_TYPE_PTR, signature[1])
        si
    si
si
