namespace IR.Emitter.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INSTANCE_FIELD
    use Semantic.Symbols.STATIC_FIELD
    use Semantic.Symbols.INSTANCE_PROPERTY

    use IR.Emitter.SRM_EMITTED_TYPE
    use IR.Emitter.SRM_MEMBER_ORDER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The two metadata passes both take their sequence from
    // SRM_MEMBER_ORDER, and a run written in a different order than it
    // was numbered reparents members onto the wrong type without
    // failing to load. What the order has to survive is the scope
    // yielding its members in map order, which is neither declaration
    // order nor stable against unrelated edits.
    @TestClass()
    class SRM_MEMBER_ORDER_TESTS is
        init() is
            if !LOCATION.internal? then
                LOCATION.init_static()
            fi
        si

        at(line: int) -> LOCATION => LOCATION("test.ghul", line, 1, line, 8)

        // Declared late in the file but early in the alphabet, so a
        // scope keyed by name yields it first and declaration order
        // demands it last.
        _class_with_fields_declared_out_of_name_order() -> CLASS is
            let owner = CLASS(at(1), at(1), Semantic.BLOCK_SCOPE(), "OWNER", Collections.LIST[string](), Semantic.BLOCK_SCOPE())

            let zulu = INSTANCE_FIELD(at(10), owner, "zulu")
            let alpha = INSTANCE_FIELD(at(20), owner, "alpha")

            owner.declare(zulu.location, zulu, null)
            owner.declare(alpha.location, alpha, null)

            return owner
        si

        @Test()
        Fields__declared_out_of_name_order__come_back_in_declaration_order() is
            let owner = _class_with_fields_declared_out_of_name_order()

            let fields = SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(owner))

            are_equal(2, fields.count)
            are_equal("zulu", fields[0].name)
            are_equal("alpha", fields[1].name)
        si

        // An auto-property's backing field is declared at the internal
        // location, which every such field shares, so on position alone
        // they tie and fall back to name order. Each takes its property's
        // position instead, which is what a sequential struct layout
        // follows.
        @Test()
        Fields__backing_auto_properties__come_back_in_property_declaration_order() is
            let owner = CLASS(at(1), at(1), Semantic.BLOCK_SCOPE(), "OWNER", Collections.LIST[string](), Semantic.BLOCK_SCOPE())

            for (name, line) in [("kind", 10), ("length", 20), ("checksum", 30)] do
                let property = INSTANCE_PROPERTY(at(line), at(line), owner, name, false, false)
                let backing = INSTANCE_FIELD(LOCATION.internal, owner, "${name}")

                owner.declare(property.location, property, null)
                owner.declare(backing.location, backing, null)
            od

            let fields = SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(owner))

            are_equal(3, fields.count)
            are_equal("$kind", fields[0].name)
            are_equal("$length", fields[1].name)
            are_equal("$checksum", fields[2].name)
        si

        // A struct's sequential layout is this order, so the answer has
        // to be the same however the scope's map chose to enumerate.
        // Asking twice is the cheapest check that nothing in the walk
        // depends on enumeration order surviving.
        @Test()
        Fields__asked_twice__answers_the_same_order() is
            let owner = _class_with_fields_declared_out_of_name_order()
            let type = SRM_EMITTED_TYPE(owner)

            let first = SRM_MEMBER_ORDER.fields(type)
            let second = SRM_MEMBER_ORDER.fields(type)

            are_equal(first.count, second.count)

            for i in 0..first.count do
                are_same(first[i], second[i])
            od
        si

        // A scope holds members it does not declare - pulling a super's
        // symbols down puts them here - and those belong to the owner's
        // rows rather than to these.
        @Test()
        Fields__member_owned_elsewhere__is_excluded() is
            let elsewhere = CLASS(at(1), at(1), Semantic.BLOCK_SCOPE(), "ELSEWHERE", Collections.LIST[string](), Semantic.BLOCK_SCOPE())
            let owner = CLASS(at(2), at(2), Semantic.BLOCK_SCOPE(), "OWNER", Collections.LIST[string](), Semantic.BLOCK_SCOPE())

            let own = INSTANCE_FIELD(at(10), owner, "own")
            let borrowed = INSTANCE_FIELD(at(11), elsewhere, "borrowed")

            owner.declare(own.location, own, null)
            owner.declare(borrowed.location, borrowed, null)

            let fields = SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(owner))

            are_equal(1, fields.count)
            are_equal("own", fields[0].name)
        si

        // Static and instance fields share one run, so the order has to
        // be declaration order across both rather than a grouping.
        @Test()
        Fields__static_and_instance__share_one_declaration_order() is
            let owner = CLASS(at(1), at(1), Semantic.BLOCK_SCOPE(), "OWNER", Collections.LIST[string](), Semantic.BLOCK_SCOPE())

            let first_instance = INSTANCE_FIELD(at(10), owner, "b_instance")
            let a_static = STATIC_FIELD(at(20), owner, "a_static")
            let last_instance = INSTANCE_FIELD(at(30), owner, "c_instance")

            owner.declare(first_instance.location, first_instance, null)
            owner.declare(a_static.location, a_static, null)
            owner.declare(last_instance.location, last_instance, null)

            let fields = SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(owner))

            are_equal(3, fields.count)
            are_equal("b_instance", fields[0].name)
            are_equal("a_static", fields[1].name)
            are_equal("c_instance", fields[2].name)
        si

        @Test()
        Fields__on_a_type_with_none__is_empty() is
            let owner = CLASS(at(1), at(1), Semantic.BLOCK_SCOPE(), "EMPTY", Collections.LIST[string](), Semantic.BLOCK_SCOPE())

            are_equal(0, SRM_MEMBER_ORDER.fields(SRM_EMITTED_TYPE(owner)).count)
        si
    si
si
