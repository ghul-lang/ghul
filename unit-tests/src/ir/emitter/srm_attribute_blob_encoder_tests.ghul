namespace IR.Emitter.UnitTests is
    use Collections.LIST
    use Collections.List

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use IR.Emitter.SRM_ATTRIBUTE_BLOB_ENCODER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the value blobs the compiler builds for the attributes
    // it applies itself — the ones whose arguments are known here, and
    // so need no symbol table to encode.
    //
    // Byte-for-byte assertions, because a blob is only ever read by the
    // CLR: a wrong length prefix or a missing named-argument count
    // produces an assembly that loads and then throws
    // CustomAttributeFormatException wherever something reflects over
    // it, a long way from the mistake. The general pragma-driven path
    // needs resolved argument values, and is covered by
    // `integration-tests/execution/attribute-*`.
    //
    // Every blob opens with the two-byte prolog `01 00` and closes with
    // a named-argument count, zero throughout here: the compiler names
    // no field or property on the attributes it applies itself.
    @TestClass()
    class SRM_ATTRIBUTE_BLOB_ENCODER_TESTS is
        init() is si

        @Test()
        a_string_argument_is_a_length_prefixed_utf8_run() is
            expect(
                [1ub, 0ub, 3ub, 97ub, 98ub, 99ub, 0ub, 0ub],
                SRM_ATTRIBUTE_BLOB_ENCODER.encode_string_argument("abc"))
        si

        // A null string is a single `ff` rather than a zero length: an
        // empty string is a different value and encodes as `00`.
        @Test()
        a_null_string_argument_is_not_an_empty_one() is
            expect(
                [1ub, 0ub, 255ub, 0ub, 0ub],
                SRM_ATTRIBUTE_BLOB_ENCODER.encode_string_argument(null))

            expect(
                [1ub, 0ub, 0ub, 0ub, 0ub],
                SRM_ATTRIBUTE_BLOB_ENCODER.encode_string_argument(""))
        si

        @Test()
        a_byte_argument_is_a_single_byte() is
            expect(
                [1ub, 0ub, 2ub, 0ub, 0ub],
                SRM_ATTRIBUTE_BLOB_ENCODER.encode_byte_argument(2))
        si

        // An array's element count is a full four bytes, not the
        // compressed integer a length prefix elsewhere in metadata uses.
        @Test()
        an_array_argument_counts_its_elements_in_four_bytes() is
            let bytes = LIST[int]()

            bytes.add(1)
            bytes.add(2)

            expect(
                [1ub, 0ub, 2ub, 0ub, 0ub, 0ub, 1ub, 2ub, 0ub, 0ub],
                SRM_ATTRIBUTE_BLOB_ENCODER.encode_byte_array_argument(bytes))
        si

        @Test()
        an_empty_array_argument_is_a_zero_count() is
            expect(
                [1ub, 0ub, 0ub, 0ub, 0ub, 0ub, 0ub, 0ub],
                SRM_ATTRIBUTE_BLOB_ENCODER.encode_byte_array_argument(LIST[int]()))
        si

        // An unnamed tuple element is a null entry, and has to stay
        // distinct from one actually named "" — the read side walks the
        // array positionally and takes a null to mean "no name here".
        @Test()
        an_unnamed_string_array_element_is_null_rather_than_empty() is
            let names = LIST[string?]()

            names.add("x")
            names.add(null)

            expect(
                [1ub, 0ub, 2ub, 0ub, 0ub, 0ub, 1ub, 120ub, 255ub, 0ub, 0ub],
                SRM_ATTRIBUTE_BLOB_ENCODER.encode_string_array_argument(names))
        si

        expect(expected: List[ubyte], actual: ubyte[]) is
            are_equal(expected.count, actual.count, "blob length")

            for i in 0..expected.count do
                are_equal(expected[i], actual[i], "byte {i}")
            od
        si
    si
si
