namespace IR.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use NSubstitute
    use NSubstitute.SubstituteExtensions.returns

    use Source.LOCATION

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.Symbols.CLASS
    use Semantic.Types.Type

    use IR.VALUE_CONVERTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class VALUE_CONVERTER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        // Numeric-primitive stand-ins for the decimal-conversion path.
        // Each `get_*_type()` mock returns the same Type instance every
        // call so callers can identity-compare. Distinct names keep the
        // decimal tables' qualified_name keys from colliding. Other
        // members on `InnateSymbolLookup` aren't touched by the
        // decimal-conversion path; NSubstitute auto-stubs them.
        build() -> (converter: VALUE_CONVERTER, lookup: InnateSymbolLookup) is
            let arguments = System.Array.empty`[object]()
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments)

            // VALUE_CONVERTER walks every numeric primitive at init
            // time to register its decimal-conversion neighbour, so
            // each one needs a distinct Type with a non-null symbol.
            let bool_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "bool", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let char_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "char", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let byte_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "byte", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let ubyte_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ubyte", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let short_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "short", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let ushort_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ushort", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let int_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let uint_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "uint", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let long_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "long", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let ulong_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ulong", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let word_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "word", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let uword_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "uword", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let single_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "single", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let double_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "double", LIST[string](), Semantic.BLOCK_SCOPE()).type
            let decimal_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "decimal", LIST[string](), Semantic.BLOCK_SCOPE()).type

            lookup.get_bool_type() |> returns(bool_type, null)
            lookup.get_char_type() |> returns(char_type, null)
            lookup.get_byte_type() |> returns(byte_type, null)
            lookup.get_ubyte_type() |> returns(ubyte_type, null)
            lookup.get_short_type() |> returns(short_type, null)
            lookup.get_ushort_type() |> returns(ushort_type, null)
            lookup.get_int_type() |> returns(int_type, null)
            lookup.get_uint_type() |> returns(uint_type, null)
            lookup.get_long_type() |> returns(long_type, null)
            lookup.get_ulong_type() |> returns(ulong_type, null)
            lookup.get_word_type() |> returns(word_type, null)
            lookup.get_uword_type() |> returns(uword_type, null)
            lookup.get_single_type() |> returns(single_type, null)
            lookup.get_double_type() |> returns(double_type, null)
            lookup.get_decimal_type() |> returns(decimal_type, null)

            let logger =
                NSubstitute.Substitute.`for`[Logging.Logger](System.Array.empty`[object]())

            let converter = VALUE_CONVERTER(logger, lookup)
            return (converter, lookup)
        si

        // Conversions that don't touch decimal don't go through the
        // decimal call path — the built-in scalar conversion covers
        // them. A non-null return here would
        // make TYPE_CASTER emit a decimal call for, say,
        // `cast int(some_double)`, which is wrong.
        @Test()
        get_decimal_conversion__no_decimal__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_int_type(), b.lookup.get_double_type()))
        si

        // Widening integral -> decimal uses op_Implicit. Catches a
        // regression that flipped to op_Explicit (which exists for
        // float source but not for ints), making the call fail to
        // resolve at JIT.
        @Test()
        get_decimal_conversion__int_to_decimal__uses_op_Implicit_int32() is
            let b = build()
            let c = b.converter.get_decimal_conversion(b.lookup.get_int_type(), b.lookup.get_decimal_type())!

            are_equal("op_Implicit", c.method_name)
            are_same(b.lookup.get_int_type(), c.parameter_type)
        si

        @Test()
        get_decimal_conversion__long_to_decimal__uses_op_Implicit_int64() is
            let b = build()
            let c = b.converter.get_decimal_conversion(b.lookup.get_long_type(), b.lookup.get_decimal_type())!

            are_equal("op_Implicit", c.method_name)
            are_same(b.lookup.get_long_type(), c.parameter_type)
        si

        // Lossy float -> decimal uses op_Explicit, not op_Implicit
        // (there's no implicit float -> decimal in .NET). Flipping to
        // op_Implicit here would emit a methodref the loader rejects.
        @Test()
        get_decimal_conversion__double_to_decimal__uses_op_Explicit_float64() is
            let b = build()
            let c = b.converter.get_decimal_conversion(b.lookup.get_double_type(), b.lookup.get_decimal_type())!

            are_equal("op_Explicit", c.method_name)
            are_same(b.lookup.get_double_type(), c.parameter_type)
        si

        // decimal -> any numeric always uses op_Explicit (no implicit
        // narrowing exists). Return type drives overload selection on
        // the Decimal class.
        @Test()
        get_decimal_conversion__decimal_to_int__uses_op_Explicit_returning_int32() is
            let b = build()
            let c = b.converter.get_decimal_conversion(b.lookup.get_decimal_type(), b.lookup.get_int_type())!

            are_equal("op_Explicit", c.method_name)
            are_same(b.lookup.get_int_type(), c.return_type)
        si

        // decimal -> decimal is the identity. We emit `nop` rather
        // than null so TYPE_CASTER can still wrap with CONVERT
        // (keeping the stack-type annotation consistent) but the
        // result is no IL work at runtime.
        @Test()
        get_decimal_conversion__decimal_to_decimal__emits_nop() is
            let b = build()
            let c = b.converter.get_decimal_conversion(b.lookup.get_decimal_type(), b.lookup.get_decimal_type())!

            is_true(c.is_identity)
        si

        // A target Decimal has no op_*(bool) overload — bool is
        // simply not in the convertible set. Null is the contract
        // for "decimal involved but no conversion"; TYPE_CASTER's
        // decimal-touches-decimal gate then promotes that to an
        // explicit "cannot convert" error rather than falling
        // through to `conv.u1` on a 128-bit struct (unverifiable IL).
        @Test()
        get_decimal_conversion__decimal_to_bool__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_decimal_type(), b.lookup.get_bool_type()))
        si

        @Test()
        get_decimal_conversion__bool_to_decimal__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_bool_type(), b.lookup.get_decimal_type()))
        si

        // System.Decimal has no op_*(char) overload (char <-> decimal
        // is routed through int in .NET). Registering char as a
        // neighbour would emit a methodref the loader rejects, so the
        // converter must report no-conversion for char in both
        // directions and let TYPE_CASTER surface a clean error.
        @Test()
        get_decimal_conversion__char_to_decimal__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_char_type(), b.lookup.get_decimal_type()))
        si

        @Test()
        get_decimal_conversion__decimal_to_char__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_decimal_type(), b.lookup.get_char_type()))
        si

        // The pointer-sized types are scalars. Both source and target
        // have to be scalars for a built-in conversion, so their absence
        // made word and uword unreachable from every scalar - including
        // from themselves.
        @Test()
        scalar__word__is_the_native_signed_integer() is
            let b = build()

            are_equal(IR.Scalar.INT_NATIVE, b.converter.scalar(b.lookup.get_word_type()))
        si

        @Test()
        scalar__uword__is_the_native_unsigned_integer() is
            let b = build()

            are_equal(IR.Scalar.UINT_NATIVE, b.converter.scalar(b.lookup.get_uword_type()))
        si

        @Test()
        scalar__decimal__is_not_a_scalar() is
            let b = build()

            is_null(b.converter.scalar(b.lookup.get_decimal_type()))
        si

        // System.Decimal has no op_*(IntPtr) overload in either
        // direction, so - as for char above - the converter reports
        // no-conversion. That null is what POINTER_SIZED_DECIMAL_BRIDGE
        // answers instead of, by routing through the 64-bit integer of
        // the same signedness.
        @Test()
        get_decimal_conversion__word_to_decimal__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_word_type(), b.lookup.get_decimal_type()))
        si

        @Test()
        get_decimal_conversion__decimal_to_word__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_decimal_type(), b.lookup.get_word_type()))
        si

        @Test()
        get_decimal_conversion__uword_to_decimal__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_uword_type(), b.lookup.get_decimal_type()))
        si

        @Test()
        get_decimal_conversion__decimal_to_uword__returns_null() is
            let b = build()

            is_null(b.converter.get_decimal_conversion(b.lookup.get_decimal_type(), b.lookup.get_uword_type()))
        si
    si
si
