namespace IR.Values.UnitTests is
    use System.Reflection.Metadata.ILOpCode

    use IR.UnitTests.EMITTED_IL

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A runtime operation lowers its operands and then the member the
    // CIL backend maps it to.
    @TestClass()
    class RUNTIME_TESTS is
        init() is si

        type_int() -> Semantic.Types.Type =>
            Semantic.Symbols.CLASSY_GENERIC_ARGUMENT(Source.LOCATION.internal, Semantic.BLOCK_SCOPE(), "int", 0).type!

        byte_of(op_code: ILOpCode) -> ubyte => cast ubyte(cast int(op_code))

        @Test()
        an_operation_with_no_operands__should_lower_to_its_member_alone() is
            let encoded = EMITTED_IL.encoded(RUNTIME(IR.RuntimeOperation.NEW_NOT_SUPPORTED, null))

            are_equal(5, encoded.count)
            are_equal(byte_of(ILOpCode.NEWOBJ), encoded[0])
        si

        @Test()
        an_operation__should_lower_its_operands_before_its_member() is
            let encoded = EMITTED_IL.encoded(RUNTIME(IR.RuntimeOperation.INIT_OBJECT, NULL(type_int()), null))

            are_equal(6, encoded.count)
            are_equal(byte_of(ILOpCode.LDNULL), encoded[0])
            are_equal(byte_of(ILOpCode.CALL), encoded[1])
        si
    si
si
