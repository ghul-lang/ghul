namespace IR.Values.UnitTests is
    use System.Reflection.Metadata.ILOpCode

    use IR.UnitTests.EMITTED_IL

    use Source.LOCATION

    use IR.Values.TYPE_TEST_OPERAND
    use IR.Values.TypeTestOperandMode

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class TYPE_TEST_OPERAND_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        class_named(name: string, type_parameters: Collections.List[string]) -> CLASS is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, type_parameters, Semantic.BLOCK_SCOPE())

            c.set_type(Semantic.Types.NAMED(c))

            return c
        si

        test_target() -> Semantic.Types.Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 1).type!

        reference_value() -> Value =>
            DUMMY(class_named("R", Collections.LIST[string]()).type!, loc())

        // A generic argument reports itself as a value type, and encodes
        // as an index rather than needing a resolvable type reference.
        value_type_value() -> Value =>
            DUMMY(CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "V", 0).type!, loc())

        maybe_value() -> Value =>
            DUMMY(
                Semantic.Types.MAYBE(
                    loc(),
                    class_named("MAYBE", Collections.LIST[string](["T"])),
                    Collections.LIST[Semantic.Types.Type]([class_named("R", Collections.LIST[string]()).type!])),
                loc())

        // A MAYBE boxes as the carrier struct, which no type test can
        // match, so it is unwrapped rather than boxed - even though it is
        // a value type like any other.
        @Test()
        mode__of_a_MAYBE__is_unwrap() is
            are_equal(TypeTestOperandMode.UNWRAP_MAYBE, TYPE_TEST_OPERAND.mode(maybe_value()))
        si

        @Test()
        mode__of_a_value_type__is_box() is
            are_equal(TypeTestOperandMode.BOX, TYPE_TEST_OPERAND.mode(value_type_value()))
        si

        @Test()
        mode__of_a_reference__is_as_is() is
            are_equal(TypeTestOperandMode.AS_IS, TYPE_TEST_OPERAND.mode(reference_value()))
        si

        @Test()
        operand__of_a_reference__is_the_value_itself() is
            let value = reference_value()

            are_same(value, TYPE_TEST_OPERAND.operand(value))
        si

        @Test()
        operand__of_a_value_type__is_the_value_boxed() is
            let value = value_type_value()
            let operand = TYPE_TEST_OPERAND.operand(value)

            is_true(isa BOX(operand))
            are_same(value, cast BOX(operand).value)
        si

        // `isa` over a value type boxes before the test, as a cast does:
        // `isinst` on an unboxed struct is invalid IL.
        @Test()
        Calling__gen__on_isa_of_a_value_type__should_box_before_isinst() is
            let value = ISA(class_named("bool", Collections.LIST[string]()).type!, test_target(), value_type_value())

            let emitted = EMITTED_IL.encoded(value)
            let box = EMITTED_IL.bytes_of([ILOpCode.BOX])
            let isinst = EMITTED_IL.bytes_of([ILOpCode.ISINST])

            are_equal(box[0], emitted[0])
            are_equal(isinst[0], emitted[5])
        si

        @Test()
        Calling__gen__on_isa_of_a_reference__should_not_box() is
            let value = ISA(class_named("bool", Collections.LIST[string]()).type!, test_target(), reference_value())

            let emitted = EMITTED_IL.encoded(value)
            let isinst = EMITTED_IL.bytes_of([ILOpCode.ISINST])

            are_equal(isinst[0], emitted[0])
        si
    si
si
