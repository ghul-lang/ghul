namespace IR.Values.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use IR.UnitTests.Support.STUB_VALUE
    use IR.Values.COMPARE_ORDER_TO_ZERO

    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the comparison made by COMPARE_ORDER_TO_ZERO, the value
    // that wraps a non-innate `<>` (compare-order) call so its int result is
    // mapped back to a bool. Issue #283 / PR #1235 — without this wrapper,
    // user-defined `<>(other) -> int` returned the raw int and every `>`,
    // `>=`, `<`, `<=` against the type evaluated as True. Each operator's
    // mapping below is the contract, with the instructions each
    // comparison is encoded as pinned in CIL_OPERATIONS_TESTS: regression here would re-open #283
    // without any high-level test failing immediately (the bug surfaces as
    // wrong booleans, not crashes).
    @TestClass()
    class COMPARE_ORDER_TO_ZERO_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        type_bool() -> Semantic.Types.Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "bool", 0).type!


        @Test()
        Calling__comparison__for_greater_than__should_be_greater() is
            let value = COMPARE_ORDER_TO_ZERO(STUB_VALUE(), ">", type_bool())

            // x > 0
            are_equal(IR.Comparison.GREATER, value.comparison)
        si

        @Test()
        Calling__comparison__for_less_than__should_be_less() is
            let value = COMPARE_ORDER_TO_ZERO(STUB_VALUE(), "<", type_bool())

            // x < 0
            are_equal(IR.Comparison.LESS, value.comparison)
        si

        @Test()
        Calling__comparison__for_greater_or_equal__should_be_greater_or_equal() is
            let value = COMPARE_ORDER_TO_ZERO(STUB_VALUE(), ">=", type_bool())

            // x >= 0
            are_equal(IR.Comparison.GREATER_OR_EQUAL, value.comparison)
        si

        @Test()
        Calling__comparison__for_less_or_equal__should_be_less_or_equal() is
            let value = COMPARE_ORDER_TO_ZERO(STUB_VALUE(), "<=", type_bool())

            // x <= 0
            are_equal(IR.Comparison.LESS_OR_EQUAL, value.comparison)
        si

        @Test()
        Calling__comparison__with_unrecognised_operation__should_throw() is
            let value = COMPARE_ORDER_TO_ZERO(STUB_VALUE(), "?!", type_bool())

            try
                value.comparison
                fail("expected exception for unrecognised operation")
            catch ex: System.Exception
                is_true(ex.message.contains("?!"))
            yrt
        si

        @Test()
        is_value_type__should_be_true() is
            // The value the wrapper produces is an int->bool comparison
            // result, always a value type. (The is_value_type override is
            // load-bearing because the wrapper would otherwise inherit
            // Value's default, which derives from the inner value's type
            // and could mis-classify when the source `<>` is on a class.)
            let value = COMPARE_ORDER_TO_ZERO(STUB_VALUE(), ">", type_bool())

            is_true(value.is_value_type)
        si
    si
si
