namespace IR.Values.UnitTests is
    use System.Reflection.Metadata.ILOpCode

    use IR.UnitTests.EMITTED_IL
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use IR.UnitTests.Support.STUB_VALUE
    use IR.Values.CONSTRAINED

    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // CONSTRAINED is the receiver of a constrained instance call - a call
    // to a member through a type parameter's bound. The `constrained.`
    // prefix it carries must land immediately before the `callvirt`,
    // after the arguments are on the stack, or the runtime rejects the IL
    // at JIT time. So the receiver lowers to its address only, and the
    // enclosing call emits the prefix separately, through the lowering's
    // `constrained_prefix`, once the arguments are generated.
    @TestClass()
    class CONSTRAINED_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        receiver() -> CONSTRAINED =>
            CONSTRAINED(STUB_VALUE(CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "E", 0).type!))

        @Test()
        Calling__constrained_prefix__should_emit_the_constrained_prefix_for_the_receiver_type() is
            EMITTED_IL.assert_encoded_by(
                [ILOpCode.CONSTRAINED],
                (context: IR.Emitter.CIL_CONTEXT) -> void is context.lowering.constrained_prefix(receiver()); si)
        si
    si
si
