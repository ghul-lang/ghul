namespace IR.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Collections.LIST

    use Semantic.Types.INFERRED_RETURN_TYPE
    use Semantic.Types.Type

    use Logging.Logger

    use Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Invoking a function value whose type still contains an
    // inference sentinel is reported and skipped rather than encoded:
    // the signature encoder refuses sentinels, so emitting would
    // surface an internal error deep in the back end instead.
    @TestClass()
    class CALL_CLOSURE_TESTS is
        init() is si

        lookup() -> Semantic.Lookups.InnateSymbolLookup => TEST_INNATE_SYMBOL_LOOKUP()

        stub_logger() -> Logger =>
            NSubstitute.Substitute.`for`[Logger](System.Array.empty`[object]())

        // A closure call whose function type carries a sentinel emits
        // nothing — not the receiver, not the arguments, not the
        // Invoke — so the body's encoded stream stays empty.
        @Test()
        gen_with_a_sentinel_function_type_emits_nothing() is
            let l = lookup()
            let func_type = l.get_function_type(
                LIST[Type]([l.get_int_type(), cast Type(INFERRED_RETURN_TYPE())]))

            let context = IR.Emitter.CIL_CONTEXT(stub_logger())
            let body = IR.Emitter.SRM_METHOD_BODY_EMITTER()

            context.install_srm_assembly_emitter("test", "0:0:0:0", true)
            context.current_srm_body_emitter = body

            context.lowering.gen(
                IR.Values.Call.CLOSURE(
                    IR.UnitTests.Support.STUB_VALUE(func_type),
                    Semantic.Types.ERROR(),
                    false,
                    func_type,
                    LIST[IR.Values.Value]()
                ))

            are_equal(0, body.encoded.count)
        si
    si
si
