namespace IR.Values.UnitTests is
    use IR.UnitTests.Support.STUB_VALUE
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Lookups.InnateSymbolLookup

    use Semantic.Symbols.CLASS
    use Semantic.Types.NAMED
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Focused tests for the IR values backing `?.` coalescing access:
    // STACK_TOP / STACK_TOP_ADDRESS as receiver stand-ins for already-
    // on-stack values, and COALESCE_LOAD emitting the dup / null-test
    // / load / null-sentinel sequence. Type-system fixtures follow
    // the patterns in narrow_env_tests / condition_analysis_tests.
    @TestClass()
    class COALESCE_LOAD_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        make_class_type(name: string) -> Type is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())
            c.set_type(NAMED(c))
            return c.type!
        si

        @Test()
        STACK_TOP_should_type_as_the_underlying_value() is
            let t = make_class_type("Foo")
            let st = STACK_TOP(t)

            is_true(st.type?)
            are_same(t, st.type)
        si

        @Test()
        STACK_TOP_should_not_report_address() is
            let t = make_class_type("Foo")
            let st = STACK_TOP(t)

            is_false(st.has_address)
        si

        @Test()
        STACK_TOP_should_be_lightweight_pure() is
            let t = make_class_type("Foo")
            let st = STACK_TOP(t)

            is_true(st.is_lightweight_pure)
        si

        @Test()
        STACK_TOP_ADDRESS_should_report_address() is
            let t = make_class_type("Foo")
            let sta = STACK_TOP_ADDRESS(t)

            is_true(sta.has_address)
        si

        @Test()
        STACK_TOP_ADDRESS_should_type_as_the_underlying_value() is
            let t = make_class_type("Foo")
            let sta = STACK_TOP_ADDRESS(t)

            is_true(sta.type?)
            are_same(t, sta.type)
        si

        @Test()
        COALESCE_LOAD_should_type_as_the_result_type() is
            let recv_t = make_class_type("FooOptional")
            let result_t = make_class_type("BarOptional")
            let recv = STACK_TOP(recv_t)
            let member_load = STACK_TOP(make_class_type("Bar"))
            let null_value = STUB_VALUE(result_t)

            let coalesce = COALESCE_LOAD(recv, member_load, null_value, result_t, true)

            is_true(coalesce.type?)
            are_same(result_t, coalesce.type)
        si

        @Test()
        COALESCE_LOAD_value_type_overload_should_type_as_the_result_type() is
            let recv_t = make_class_type("FooOptional")
            let inner_t = make_class_type("FooInner")
            let bool_t = make_class_type("bool")
            let result_t = make_class_type("BarOptional")

            let recv = STACK_TOP(recv_t)
            let presence_test = STACK_TOP(bool_t)
            let value_extract = STACK_TOP(inner_t)
            let member_load = STACK_TOP(make_class_type("Bar"))
            let null_value = STUB_VALUE(result_t)

            let coalesce =
                COALESCE_LOAD(
                    recv,
                    presence_test,
                    value_extract,
                    member_load,
                    null_value,
                    result_t,
                    true
                )

            is_true(coalesce.type?)
            are_same(result_t, coalesce.type)
        si

        @Test()
        COALESCE_LOAD_should_accept_absent_null_value_for_void_member() is
            // A coalesced call to a void method pushes no value on
            // either arm: no null sentinel, result type stays the
            // callee's void type.
            let recv_t = make_class_type("FooOptional")
            let void_t = make_class_type("void")
            let recv = STACK_TOP(recv_t)
            let member_call = STACK_TOP(void_t)

            let coalesce = COALESCE_LOAD(recv, member_call, null, void_t, true)

            is_true(coalesce.type?)
            are_same(void_t, coalesce.type)
        si

        @Test()
        COALESCE_LOAD_should_expose_receiver_kind_for_rewrap() is
            // rewrap_coalesce_call re-seats an invocation inside the
            // arm of an existing wrap and needs to know which
            // constructor shape to rebuild with.
            let recv_t = make_class_type("FooOptional")
            let result_t = make_class_type("BarOptional")
            let recv = STACK_TOP(recv_t)
            let member_load = STACK_TOP(make_class_type("Bar"))
            let null_value = STUB_VALUE(result_t)

            let reference_shape = COALESCE_LOAD(recv, member_load, null_value, result_t, true)

            let value_shape =
                COALESCE_LOAD(
                    recv,
                    STACK_TOP(make_class_type("bool")),
                    STACK_TOP(make_class_type("FooInner")),
                    member_load,
                    null_value,
                    result_t,
                    true
                )

            is_false(reference_shape.receiver_is_value_type)
            is_true(value_shape.receiver_is_value_type)
        si

        @Test()
        COALESCE_LOAD_should_not_be_lightweight_pure() is
            // Coalesce composes branching IL and a stack-top
            // null-sentinel — never short-circuited away.
            let recv_t = make_class_type("FooOptional")
            let result_t = make_class_type("BarOptional")
            let recv = STACK_TOP(recv_t)
            let member_load = STACK_TOP(make_class_type("Bar"))
            let null_value = STUB_VALUE(result_t)

            let coalesce = COALESCE_LOAD(recv, member_load, null_value, result_t, true)

            is_false(coalesce.is_lightweight_pure)
        si

        @Test()
        build_optional_type_should_return_already_optional_unchanged() is
            // Already-optional → identity; widening is a no-op and
            // never reaches the InnateSymbolLookup, which the substitute
            // below pins.
            let t = make_class_type("Foo")
            let optional = t.as_optional()

            let result = Syntax.Process.COMPILE_ACCESS.build_optional_type(optional, unused_lookup())

            are_same(optional, result)
        si

        @Test()
        build_optional_type_should_flag_reference_type() is
            // Reference T → T flagged optional via NAMED.as_optional —
            // IL identity, the type system carries the `?` view, and the
            // lookup is again bypassed.
            let t = make_class_type("Foo")

            let result = Syntax.Process.COMPILE_ACCESS.build_optional_type(t, unused_lookup())

            is_true(result.is_optional)
        si

        @Test()
        build_optional_type_should_lower_unconstrained_type_parameter_to_maybe() is
            // A type parameter reports is_value_type whatever its kind,
            // so an unconstrained one must not reach the NULLABLE maker:
            // Nullable[U] violates the CLR's struct constraint.
            let t = Semantic.Symbols.CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "U", 0).type!
            let maybe = make_class_type("$maybe")
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](System.Array.empty`[object]())

            lookup.get_maybe_type(t) |> NSubstitute.SubstituteExtensions.returns_for_any_args(maybe, null)

            let result = Syntax.Process.COMPILE_ACCESS.build_optional_type(t, lookup)

            are_same(maybe, result)
        si

        // The widening paths under test never consult the lookup. A
        // substitute says so and stays a valid argument, where a null
        // would only have been one by accident.
        unused_lookup() -> InnateSymbolLookup =>
            NSubstitute.Substitute.`for`[InnateSymbolLookup](System.Array.empty`[object]())
    si
si
