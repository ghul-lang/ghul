namespace IR.Values.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use IR.UnitTests.Support.STUB_VALUE

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.TRAIT
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.PRIVATE_METHOD
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // How an instance call reaches the function it runs, which a backend
    // turns into its own call instruction.
    @TestClass()
    class CALL_DISPATCH_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_class() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C", LIST[string](), Semantic.BLOCK_SCOPE())

        a_trait() -> TRAIT => TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), "T", LIST[string](), Semantic.BLOCK_SCOPE())

        call(from: Value, function: Semantic.Symbols.Function) -> Call.INSTANCE =>
            Call.INSTANCE(from, function, LIST[Value](), Semantic.Types.ERROR())

        @Test()
        dispatch__of_an_overridable_class_method__is_virtual() is
            let method = INSTANCE_METHOD(loc(), loc(), a_class(), "m", Semantic.BLOCK_SCOPE())

            are_equal(IR.Dispatch.VIRTUAL, call(STUB_VALUE(), method).dispatch)
        si

        @Test()
        dispatch__of_a_trait_member__is_interface() is
            let method = INSTANCE_METHOD(loc(), loc(), a_trait(), "m", Semantic.BLOCK_SCOPE())

            are_equal(IR.Dispatch.INTERFACE, call(STUB_VALUE(), method).dispatch)
        si

        @Test()
        dispatch__of_a_method_nothing_can_override__is_direct() is
            let method = PRIVATE_METHOD(loc(), loc(), a_class(), "_m", Semantic.BLOCK_SCOPE())

            are_equal(IR.Dispatch.DIRECT, call(STUB_VALUE(), method).dispatch)
        si

        @Test()
        dispatch__on_a_constrained_receiver__is_constrained() is
            let method = INSTANCE_METHOD(loc(), loc(), a_trait(), "m", Semantic.BLOCK_SCOPE())
            let receiver = CONSTRAINED(STUB_VALUE(CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "E", 0).type!))

            are_equal(IR.Dispatch.CONSTRAINED, call(receiver, method).dispatch)
        si
    si
si
