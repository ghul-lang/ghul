namespace IR.Values.UnitTests is
    use System.Reflection.Metadata.ILOpCode

    use IR.UnitTests.EMITTED_IL
    use IR.UnitTests.Support.STUB_VALUE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Records which visit each value reached.
    class RECORDING_VISITOR: Visitor is
        visited: Collections.LIST[string]

        init() is
            visited = Collections.LIST[string]()
        si

        visit_value(value: Value) is visited.add("value"); si
        visit_address_of_value(value: Value) is visited.add("address"); si

        visit(number: Literal.NUMBER) is visited.add("number"); si
        visit(string: Literal.STRING) is visited.add("string"); si
        visit(decimal: Literal.DECIMAL) is visited.add("decimal"); si
        visit(bigint: Literal.BIGINT) is visited.add("bigint"); si
    si

    @TestClass()
    class VISITOR_TESTS is
        init() is si

        type_int() -> Semantic.Types.Type =>
            Semantic.Symbols.CLASSY_GENERIC_ARGUMENT(Source.LOCATION.internal, Semantic.BLOCK_SCOPE(), "int", 0).type!

        @Test()
        accept__should_reach_the_visit_for_a_value_that_has_one() is
            let visitor = RECORDING_VISITOR()

            Literal.NUMBER(1, type_int()).accept(visitor)

            are_equal(1, visitor.visited.count)
            are_equal("number", visitor.visited[0])
        si

        @Test()
        accept__should_fall_back_for_a_value_without_a_visit() is
            let visitor = RECORDING_VISITOR()

            STUB_VALUE(type_int()).accept(visitor)
            STUB_VALUE(type_int()).accept_address(visitor)

            are_equal("value", visitor.visited[0])
            are_equal("address", visitor.visited[1])
        si

        @Test()
        generating__should_lower_a_moved_value_through_the_cil_lowering() is
            let encoded = EMITTED_IL.encoded(Literal.NUMBER(0, type_int()))

            are_equal(1, encoded.count)
            are_equal(cast ubyte(cast int(ILOpCode.LDC_I4_0)), encoded[0])
        si
    si
si
