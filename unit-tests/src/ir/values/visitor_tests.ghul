namespace IR.Values.UnitTests is
    use System.Reflection.Metadata.ILOpCode

    use IR.UnitTests.EMITTED_IL

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Generating a value lowers it through the CIL lowering, whether it
    // has a visit of its own or still lowers itself.
    @TestClass()
    class VISITOR_TESTS is
        init() is si

        type_int() -> Semantic.Types.Type =>
            Semantic.Symbols.CLASSY_GENERIC_ARGUMENT(Source.LOCATION.internal, Semantic.BLOCK_SCOPE(), "int", 0).type!

        assert_encodes_one(op_code: ILOpCode, value: Value) is
            let encoded = EMITTED_IL.encoded(value)

            are_equal(1, encoded.count)
            are_equal(cast ubyte(cast int(op_code)), encoded[0])
        si

        @Test()
        generating__should_lower_a_value_with_a_visit_through_the_cil_lowering() is
            assert_encodes_one(ILOpCode.LDC_I4_0, Literal.NUMBER(0, type_int()))
        si

        @Test()
        generating__should_lower_a_value_without_a_visit_through_its_own_gen() is
            assert_encodes_one(ILOpCode.LDNULL, NULL(type_int()))
        si

        @Test()
        generating_an_address__should_lower_through_the_cil_lowering() is
            let local = IR.LOCAL("local", type_int())

            let encoded =
                EMITTED_IL.encoded_by(
                    (context: IR.CONTEXT) -> void is
                        context.current_srm_body_emitter!.declare_local(local)
                        Load.TEMP(local).gen_address(context)
                    si)

            are_equal(cast ubyte(cast int(ILOpCode.LDLOCA_S)), encoded[0])
        si
    si
si
