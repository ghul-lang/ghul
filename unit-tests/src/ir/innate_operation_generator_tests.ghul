namespace IR.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The intrinsic operation name carries the signedness of the shift,
    // rather than it being re-derived from the operand types, matching
    // how `compare.order` and `compare.uorder` separate signed from
    // unsigned comparison. A right shift that reaches the signed shift
    // on an unsigned operand propagates the sign bit and silently
    // returns a wrong value, so the two names are pinned here.
    @TestClass()
    class INNATE_OPERATION_GENERATOR_TESTS is
        init() is si

        @Test()
        Calling__arithmetic_operation__with_shr__gives_the_signed_shift() is
            are_equal(IR.ArithmeticOperation.SHIFT_RIGHT, INNATE_OPERATION_GENERATOR._arithmetic_operation("shr"))
        si

        @Test()
        Calling__arithmetic_operation__with_ushr__gives_the_unsigned_shift() is
            are_equal(IR.ArithmeticOperation.SHIFT_RIGHT_UNSIGNED, INNATE_OPERATION_GENERATOR._arithmetic_operation("ushr"))
        si

        @Test()
        Calling__arithmetic_operation__with_shl__gives_the_left_shift() is
            are_equal(IR.ArithmeticOperation.SHIFT_LEFT, INNATE_OPERATION_GENERATOR._arithmetic_operation("shl"))
        si
    si
si
