namespace IR.WasmGC.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class CLASS_ID_NUMBERING_TESTS is
        init() is si

        // object
        //   Shape
        //     SQUARE
        //     CIRCLE
        //   Tree
        //     LEAF
        //     NODE
        //     EMPTY
        hierarchy() -> CLASS_ID_NUMBERING[string] is
            let numbering = CLASS_ID_NUMBERING[string]()

            numbering.add_root("object")
            numbering.add("Shape", "object")
            numbering.add("SQUARE", "Shape")
            numbering.add("Tree", "object")
            numbering.add("CIRCLE", "Shape")
            numbering.add("LEAF", "Tree")
            numbering.add("NODE", "Tree")
            numbering.add("EMPTY", "Tree")

            numbering.number()

            return numbering
        si

        @Test()
        number__numbers_depth_first_with_children_in_the_order_added() is
            let numbering = hierarchy()

            are_equal(0, numbering.id("object"))
            are_equal(1, numbering.id("Shape"))
            are_equal(2, numbering.id("SQUARE"))
            are_equal(3, numbering.id("CIRCLE"))
            are_equal(4, numbering.id("Tree"))
            are_equal(5, numbering.id("LEAF"))
            are_equal(6, numbering.id("NODE"))
            are_equal(7, numbering.id("EMPTY"))
        si

        @Test()
        last_descendant__is_the_highest_number_in_the_subtree() is
            let numbering = hierarchy()

            are_equal(7, numbering.last_descendant("object"))
            are_equal(3, numbering.last_descendant("Shape"))
            are_equal(2, numbering.last_descendant("SQUARE"))
            are_equal(7, numbering.last_descendant("Tree"))
            are_equal(7, numbering.last_descendant("EMPTY"))
        si

        @Test()
        is_within__holds_for_a_node_and_everything_derived_from_it() is
            let numbering = hierarchy()

            is_true(numbering.is_within("SQUARE", "Shape"))
            is_true(numbering.is_within("CIRCLE", "Shape"))
            is_true(numbering.is_within("Shape", "Shape"))
            is_true(numbering.is_within("NODE", "object"))
        si

        @Test()
        is_within__does_not_hold_across_siblings_or_upwards() is
            let numbering = hierarchy()

            is_false(numbering.is_within("LEAF", "Shape"))
            is_false(numbering.is_within("SQUARE", "CIRCLE"))
            is_false(numbering.is_within("Shape", "SQUARE"))
            is_false(numbering.is_within("object", "Tree"))
        si

        @Test()
        number__gives_a_union_s_variants_consecutive_numbers() is
            let numbering = hierarchy()

            are_equal(numbering.id("LEAF") + 1, numbering.id("NODE"))
            are_equal(numbering.id("NODE") + 1, numbering.id("EMPTY"))
        si

        @Test()
        in_order__lists_parents_before_children_in_number_order() is
            let order = hierarchy().in_order()

            are_equal(8, order.count)

            for i in 0..order.count do
                are_equal(i, hierarchy().id(order[i]))
            od
        si

        @Test()
        has_children__is_false_only_for_leaves() is
            let numbering = hierarchy()

            is_true(numbering.has_children("Shape"))
            is_false(numbering.has_children("SQUARE"))
            is_false(numbering.has_children("EMPTY"))
        si
    si
si
