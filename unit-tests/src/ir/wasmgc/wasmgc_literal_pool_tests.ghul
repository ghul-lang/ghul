namespace IR.WasmGC.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class WASMGC_LITERAL_POOL_TESTS is
        init() is si

        @Test()
        add__the_same_text_twice__gives_the_same_position() is
            let pool = WASMGC_LITERAL_POOL()

            are_equal(0, pool.add("hello"))
            are_equal(1, pool.add("world"))
            are_equal(0, pool.add("hello"))
            are_equal(2, pool.entries.count)
        si

        @Test()
        add__places_each_text_after_the_one_before() is
            let pool = WASMGC_LITERAL_POOL()

            pool.add("ab")
            pool.add("c")

            are_equal(0, pool.entries[0].offset)
            are_equal(4, pool.entries[1].offset)
        si

        @Test()
        bytes__are_utf16_code_units_low_byte_first() is
            let pool = WASMGC_LITERAL_POOL()

            pool.add("A€")

            let bytes = pool.bytes

            are_equal(4, bytes.count)
            are_equal(0x41, int(bytes[0]))
            are_equal(0x00, int(bytes[1]))
            are_equal(0xAC, int(bytes[2]))
            are_equal(0x20, int(bytes[3]))
        si

        @Test()
        add__an_empty_text__takes_a_position_and_no_bytes() is
            let pool = WASMGC_LITERAL_POOL()

            are_equal(0, pool.add(""))
            are_equal(0, pool.bytes.count)
        si
    si
si
