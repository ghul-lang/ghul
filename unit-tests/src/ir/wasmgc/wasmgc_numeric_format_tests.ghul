namespace IR.WasmGC.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class WASMGC_NUMERIC_FORMAT_TESTS is
        init() is si

        @Test()
        is_covered__standard_formats_with_and_without_precision__are_covered() is
            for format in ["", "F", "F2", "f10", "N0", "n", "E6", "e", "G", "G17", "R", "r"] do
                is_true(WASMGC_NUMERIC_FORMAT.is_covered(format, false), format)
                is_true(WASMGC_NUMERIC_FORMAT.is_covered(format, true), format)
            od
        si

        @Test()
        is_covered__integer_only_formats__are_covered_for_integers_only() is
            for format in ["D", "D4", "d2", "X", "X8", "x2"] do
                is_true(WASMGC_NUMERIC_FORMAT.is_covered(format, true), format)
                is_false(WASMGC_NUMERIC_FORMAT.is_covered(format, false), format)
            od
        si

        @Test()
        is_covered__custom_placeholder_patterns__are_covered() is
            for format in ["0", "00", "0.#", "0.000", "#,##0.00", "#.##", "00000.000"] do
                is_true(WASMGC_NUMERIC_FORMAT.is_covered(format, false), format)
            od
        si

        @Test()
        is_covered__other_formats__are_not_covered() is
            for format in ["C", "P2", "yyyy-MM-dd", "0.00%", "0.0e+0", "F2x", "0,000.0,", "0.0.0", "0.#,#"] do
                is_false(WASMGC_NUMERIC_FORMAT.is_covered(format, false), format)
                is_false(WASMGC_NUMERIC_FORMAT.is_covered(format, true), format)
            od
        si
    si
si
