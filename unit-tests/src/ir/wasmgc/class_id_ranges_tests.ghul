namespace IR.WasmGC.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class CLASS_ID_RANGES_TESTS is
        init() is si

        @Test()
        of__joins_consecutive_numbers_into_one_run() is
            let ranges = CLASS_ID_RANGES.of([5, 3, 4, 9, 10, 1])

            are_equal(3, ranges.count)
            are_equal(1, ranges[0].low)
            are_equal(1, ranges[0].high)
            are_equal(3, ranges[1].low)
            are_equal(5, ranges[1].high)
            are_equal(9, ranges[2].low)
            are_equal(10, ranges[2].high)
        si

        @Test()
        of__counts_a_repeated_number_once() is
            let ranges = CLASS_ID_RANGES.of([2, 2, 3])

            are_equal(1, ranges.count)
            are_equal(2, ranges[0].low)
            are_equal(3, ranges[0].high)
        si

        @Test()
        of__answers_no_runs_for_no_numbers() is
            are_equal(0, CLASS_ID_RANGES.of(Collections.LIST[int]()).count)
        si
    si
si
