namespace IR.WasmGC.UnitTests is
    use IR.Values.BREAK
    use IR.Values.CONTINUE
    use IR.Values.LOOP
    use IR.Values.REGION

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class WASMGC_FINALLY_EXITS_TESTS is
        init() is si

        @Test()
        number__should_start_at_one_since_zero_is_no_exit() is
            are_equal(1, WASMGC_FINALLY_EXITS(0).number(BREAK(REGION(LABEL(), Semantic.Types.ERROR()))))
        si

        @Test()
        number__should_be_shared_by_exits_to_the_same_place() is
            let exits = WASMGC_FINALLY_EXITS(0)
            let region = REGION(LABEL(), Semantic.Types.ERROR())

            exits.number(BREAK(region))

            are_equal(1, exits.number(BREAK(region)))
            are_equal(1, exits.exits.count)
        si

        @Test()
        number__should_differ_for_a_break_and_a_continue_of_one_loop() is
            let exits = WASMGC_FINALLY_EXITS(0)
            let loop = LOOP(LABEL(), LABEL(), Semantic.Types.ERROR())

            are_equal(1, exits.number(BREAK(loop)))
            are_equal(2, exits.number(CONTINUE(loop)))
        si
    si
si
