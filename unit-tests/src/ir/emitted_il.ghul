namespace IR.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use System.Reflection.Metadata.ILOpCode

    use Collections.LIST
    use Assertions

    // Drives a value down the binary path and answers with the
    // instruction bytes it encoded.
    //
    // Asserting on the bytes rather than on a rendering of them means
    // the test reads what the runtime will: an expectation is written as
    // the opcodes it expects, and the comparison happens after both
    // sides have been encoded the one way SRM encodes them. Nothing here
    // decodes, so nothing here can disagree with the encoder about what
    // a byte means.
    class EMITTED_IL is
        // The bytes a call to `emit` encodes, for something that is not
        // a whole value - a prefix, say.
        encoded_by(emit: (IR.Emitter.CIL_CONTEXT) -> void) -> ubyte[] static is
            let context =
                IR.Emitter.CIL_CONTEXT(
                    NSubstitute.Substitute.`for`[Logging.Logger](System.Array.empty`[object]()))
            let body = IR.Emitter.SRM_METHOD_BODY_EMITTER()

            context.install_srm_assembly_emitter("test", "0:0:0:0", true)

            context.current_srm_body_emitter = body

            emit(context)

            return body.encoded
        si

        assert_encoded_by(
            op_codes: Collections.Iterable[ILOpCode],
            emit: (IR.Emitter.CIL_CONTEXT) -> void
        ) static is
            let actual = encoded_by(emit)
            let expected = bytes_of(op_codes)

            is_true(
                _describe(actual).starts_with(_describe(expected)),
                "expected IL beginning {_describe(expected)}, got {_describe(actual)}")
        si

        // The bytes a value encodes. An assembly emitter is present
        // because a value naming a type or a member resolves a token
        // through one.
        encoded(value: IR.Values.Value) -> ubyte[] static is
            let context =
                IR.Emitter.CIL_CONTEXT(
                    NSubstitute.Substitute.`for`[Logging.Logger](System.Array.empty`[object]()))
            let body = IR.Emitter.SRM_METHOD_BODY_EMITTER()

            // A value naming a type or a member resolves a token through
            // the assembly emitter, so one has to be here even for a
            // value that names nothing.
            context.install_srm_assembly_emitter("test", "0:0:0:0", true)

            context.current_srm_body_emitter = body

            value.gen(context)

            return body.encoded
        si

        // An expected sequence, encoded the way the instruction encoder
        // encodes it: one byte, or the two-byte form's `0xFE` prefix and
        // its low byte.
        bytes_of(op_codes: Collections.Iterable[ILOpCode]) -> ubyte[] static is
            let result = LIST[ubyte]()

            for op_code in op_codes do
                let value = cast int(op_code)

                if value > 0xFF then
                    result.add(cast ubyte(value >> 8))
                fi

                result.add(cast ubyte(value & 0xFF))
            od

            return result.to_array()
        si

        // For instructions that carry a metadata token. Which row a
        // token lands on is a property of the assembly being built
        // rather than of the value, so each instruction is asserted and
        // the four operand bytes after it are stepped over.
        assert_emits_token_instructions(
            op_codes: Collections.Iterable[ILOpCode],
            value: IR.Values.Value
        ) static is
            let actual = encoded(value)
            let cursor mut = 0

            for op_code in op_codes do
                let expected = bytes_of([op_code])

                for b in expected do
                    is_true(
                        cursor < actual.count,
                        "IL ended before {op_code}: {_describe(actual)}")

                    are_equal(
                        _describe([b]),
                        _describe([actual[cursor]]),
                        "at byte {cursor} of {_describe(actual)}")

                    cursor = cursor + 1
                od

                cursor = cursor + 4
            od

            are_equal(
                cursor,
                actual.count,
                "unexpected trailing IL in {_describe(actual)}")
        si

        assert_emits(op_codes: Collections.Iterable[ILOpCode], value: IR.Values.Value) static is
            let expected = bytes_of(op_codes)
            let actual = encoded(value)

            are_equal(_describe(expected), _describe(actual))
        si

        // Compared as text so a mismatch names the bytes rather than
        // reporting that two arrays differ.
        _describe(bytes: ubyte[]) -> string static is
            let result = System.Text.StringBuilder()

            for b in bytes do
                if result.length > 0 then
                    result.append(' ')
                fi

                result.append("{b:X2}")
            od

            return "{result}"
        si
    si
si
