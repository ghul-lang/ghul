namespace IR.Program.UnitTests is
    use Collections.LIST
    use Collections.MAP

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.TRAIT
    use Semantic.Symbols.Classy
    use Semantic.Symbols.Function
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.Symbol

    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class DISPATCH_PLAN_TESTS is
        _object: CLASS
        _animal: CLASS
        _cat: CLASS
        _named: TRAIT

        _animal_speak: INSTANCE_METHOD
        _animal_sleep: INSTANCE_METHOD
        _cat_speak: INSTANCE_METHOD
        _named_name: INSTANCE_METHOD
        _cat_name: INSTANCE_METHOD

        _methods: MAP[Classy, LIST[Function]]

        init() is
            _object = declare("object")
            _object.mark_is_object()

            _named = TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Named", LIST[string](), Semantic.BLOCK_SCOPE())

            _animal = declare("animal")
            _animal.add_ancestor(_object.type!)

            _cat = declare("cat")
            _cat.add_ancestor(_animal.type!)
            _cat.add_ancestor(_named.type!)

            _animal_speak = method(_animal, "speak")
            _animal_sleep = method(_animal, "sleep")
            _cat_speak = method(_cat, "speak")

            _cat_speak.add_overridee(_animal_speak)
            _animal_speak.add_overrider(_cat_speak)

            _named_name = method(_named, "name")
            _cat_name = method(_cat, "name")

            _cat_name.add_overridee(_named_name)
            _named_name.add_overrider(_cat_name)

            _methods = MAP[Classy, LIST[Function]]()
            _methods[_object] = LIST[Function]()
            _methods[_animal] = LIST[Function]([_animal_speak, _animal_sleep])
            _methods[_cat] = LIST[Function]([_cat_speak, _cat_name])
            _methods[_named] = LIST[Function]([_named_name])
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        declare(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        method(owner: Classy, name: string) -> INSTANCE_METHOD =>
            INSTANCE_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())

        // Plans the root, animal and cat, parents first.
        planned() -> (plan: DISPATCH_PLAN, target: STUB_DISPATCH_TARGET) is
            let target = STUB_DISPATCH_TARGET(_object, _methods)
            let animal = target.classes.class_of(_animal, MAP[Symbol, Type]())!
            let cat = target.classes.class_of(_cat, MAP[Symbol, Type]())!

            target.classes.number()

            let plan = DISPATCH_PLAN(target)

            plan.plan_slots(LIST[CLASS_INSTANCE]([target.root!, animal, cat]))
            plan.plan_traits()

            return (plan, target)
        si

        instance(definition: Classy, target: STUB_DISPATCH_TARGET) -> CLASS_INSTANCE =>
            target.classes.class_of(definition, MAP[Symbol, Type]())!

        @Test()
        plan_slots__a_method_something_overrides__opens_a_slot_the_override_fills() is
            let (plan, target) = planned()

            let animal_slot = plan.slot_of(FUNCTION_INSTANCE.of(_animal_speak))!
            let cat_slot = plan.slot_of(FUNCTION_INSTANCE.of(_cat_speak))!

            is_true(animal_slot == cat_slot)
            is_true(plan.slot_entries(instance(_cat, target))[cat_slot.index]!.definition == _cat_speak)
            is_true(plan.slot_entries(instance(_animal, target))[animal_slot.index]!.definition == _animal_speak)
        si

        @Test()
        plan_slots__a_method_nothing_overrides__takes_no_slot() is
            let (plan, _) = planned()

            is_false(plan.slot_of(FUNCTION_INSTANCE.of(_animal_sleep))?)
        si

        @Test()
        plan_traits__a_trait_method__has_a_row_holding_each_implementation() is
            let (plan, target) = planned()

            let named = plan.trait_of(_named.type!)!
            let selector = plan.selector_of(_named_name, named)!

            is_true(plan.only_implementation(selector)!.definition == _cat_name)

            let implementors = plan.implementors(named)!

            are_equal(1, implementors.count)
            is_true(implementors[0] == instance(_cat, target))
        si

        @Test()
        use_selector__reaches_every_implementation_in_the_row() is
            let (plan, _) = planned()

            let selector = plan.selector_of(_named_name, plan.trait_of(_named.type!)!)!
            let reached = LIST[FUNCTION_INSTANCE]()

            plan.use_selector(selector, implementation => reached.add(implementation))

            are_equal(1, reached.count)
            is_true(reached[0].definition == _cat_name)
        si
    si

    class STUB_DISPATCH_TARGET: DispatchTarget is
        _methods: MAP[Classy, LIST[Function]]
        _signatures: int

        classes: CLASS_SET

        init(object: Classy, methods: MAP[Classy, LIST[Function]]) is
            _methods = methods
            classes = CLASS_SET(object, element => true, NO_CORE_CLASSES())
        si

        root: CLASS_INSTANCE? => classes.root
        numbering: CLASS_ID_NUMBERING[CLASS_INSTANCE] => classes.numbering
        class_of(type: Type?) -> CLASS_INSTANCE? => classes.class_of(type)
        superclass_of(type: CLASS_INSTANCE) -> CLASS_INSTANCE? => classes.superclass_of(type)
        methods_of(definition: Classy) -> Function[] => _methods[definition]
        is_object(type: CLASS_INSTANCE) -> bool => type == classes.root
        is_object_type(type: CLASS_INSTANCE) -> bool => type != classes.root
        is_box(type: CLASS_INSTANCE) -> bool => false
        is_array(type: CLASS_INSTANCE) -> bool => false
        is_string(type: CLASS_INSTANCE) -> bool => false
        is_bigint(type: CLASS_INSTANCE) -> bool => false
        is_instantiated(type: CLASS_INSTANCE) -> bool => true

        slot_signature(owner: CLASS_INSTANCE, method: FUNCTION_INSTANCE) -> int? => _next_signature()
        selector_signature(method: FUNCTION_INSTANCE) -> int? => _next_signature()

        _next_signature() -> int is
            _signatures = _signatures + 1

            return _signatures
        si
    si
si
