namespace IR.Program.UnitTests is
    use Collections.LIST
    use Collections.MAP

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.Symbol

    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class CLASS_SET_TESTS is
        _object: CLASS
        _animal: CLASS
        _cat: CLASS
        _dog: CLASS

        init() is
            _object = declare("object")
            _object.mark_is_object()

            _animal = declare("animal")
            _animal.add_ancestor(_object.type!)

            _cat = declare("cat")
            _cat.add_ancestor(_animal.type!)

            _dog = declare("dog")
            _dog.add_ancestor(_animal.type!)
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        declare(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        set() -> CLASS_SET => CLASS_SET(_object, element => true, NO_CORE_CLASSES())

        no_arguments() -> MAP[Symbol, Type] => MAP[Symbol, Type]()

        @Test()
        class_of__the_same_class_twice__answers_the_one_instance() is
            let classes = set()

            let first = classes.class_of(_animal, no_arguments())!
            let second = classes.class_of(_animal, no_arguments())!

            is_true(first == second)
        si

        @Test()
        class_of__a_subclass__adds_its_superclass_too() is
            let classes = set()

            classes.take_new_classes()
            classes.class_of(_cat, no_arguments())

            let added = classes.take_new_classes() |> Ghul.Pipes.map(c => c.definition.name) |> ARRAY()

            are_equal(2, added.count)
            is_true(added |> Ghul.Pipes.any(n => n =~ "cat"))
            is_true(added |> Ghul.Pipes.any(n => n =~ "animal"))
        si

        @Test()
        superclass_of__a_class_extending_the_root__is_null() is
            let classes = set()

            let animal = classes.class_of(_animal, no_arguments())!

            is_false(classes.superclass_of(animal)?)
        si

        @Test()
        number__places_subclasses_within_their_superclass_range() is
            let classes = set()

            let cat = classes.class_of(_cat, no_arguments())!
            let dog = classes.class_of(_dog, no_arguments())!
            let animal = classes.class_of(_animal, no_arguments())!

            classes.number()

            is_true(classes.numbering.is_within(cat, animal))
            is_true(classes.numbering.is_within(dog, animal))
            is_false(classes.numbering.is_within(cat, dog))
        si

        @Test()
        class_of__a_class_first_asked_for_after_numbering__is_null() is
            let classes = set()

            classes.class_of(_animal, no_arguments())
            classes.number()

            is_false(classes.class_of(_cat, no_arguments())?)
        si
    si

    class NO_CORE_CLASSES: CoreClasses is
        init() is si

        array_definition: Semantic.Symbols.Classy? => null
        bigint: Symbol? => null
        iterable_definition: Symbol? => null
    si
si
