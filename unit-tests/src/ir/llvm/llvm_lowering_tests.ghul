namespace IR.LLVMTarget.UnitTests is
    use Collections.LIST
    use Collections.List

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Types.Type

    use IR.Values.ARITHMETIC
    use IR.Values.BLOCK
    use IR.Values.BREAK
    use IR.Values.CONTINUE
    use IR.Values.LOOP
    use IR.Values.REGION
    use IR.Values.RET
    use IR.Values.STORE_TEMP
    use IR.Values.Value
    use IR.Values.Literal.NUMBER

    use LLVM.FUNCTION
    use LLVM.MODULE
    use LLVM.Operation
    use LLVM.PARAMETER
    use LLVM.Types
    use LLVM.WRITER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class LLVM_LOWERING_TESTS is
        _int: Type
        _byte: Type

        init() is
            _int = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _byte = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "byte", LIST[string](), Semantic.BLOCK_SCOPE()).type!
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        scalar(type: Type?) -> Scalar? =>
            if type == _int then
                Scalar.INT32
            elif type == _byte then
                Scalar.INT8
            else
                null
            fi

        // Lowers `values` into a function returning `void`, or an `int` where
        // `returns_int`, taking one `int` argument.
        lower(values: Value[], returns_int: bool) -> (function: FUNCTION, lowering: LLVM_LOWERING) is
            let module = MODULE()
            let function = FUNCTION("f", if returns_int then Types.i32 else LLVM.Type.VOID fi, [PARAMETER(Types.i32, "a0")])

            module.add_function(function)

            let lowering =
                LLVM_LOWERING(
                    module,
                    function,
                    null,
                    if returns_int then _int else null fi,
                    i => null,
                    null,
                    null,
                    null,
                    t => scalar(t),
                    t => false)

            lowering.lower(values)

            return (function, lowering)
        si

        lower(value: Value) -> (function: FUNCTION, lowering: LLVM_LOWERING) => lower([value], false)

        block_named(function: FUNCTION, name: string) -> LLVM.BLOCK is
            for block in function.blocks do
                if block.name =~ name then
                    return block
                fi
            od

            fail("no block {name}")

            throw System.InvalidOperationException("unreachable")
        si

        // The blocks the terminator of block `name` can go to.
        targets_of(function: FUNCTION, name: string) -> string[] is
            let instructions = block_named(function, name).instructions

            return LIST[string](instructions[instructions.count - 1].targets)
        si

        text_of(function: FUNCTION) -> string is
            let module = MODULE()

            module.add_function(function)

            return WRITER.module_text(module)
        si

        new_region() -> REGION => REGION(LABEL(), Semantic.Types.ERROR())

        new_loop() -> LOOP => LOOP(LABEL(), LABEL(), Semantic.Types.ERROR())

        closed(region: REGION) -> REGION is
            region.close()

            return region
        si

        closed(loop: LOOP) -> LOOP is
            loop.close()

            return loop
        si

        @Test()
        a_lowered_body__should_be_well_formed_and_report_nothing() is
            let (function, lowering) = lower(closed(new_region()))

            function.check()

            are_equal(0, lowering.unsupported.count)
        si

        @Test()
        the_entry_block__should_hold_the_slots_and_branch_to_the_body() is
            let (function, _) = lower(closed(new_region()))

            let entry = function.blocks[0]

            are_equal("entry", entry.name)
            is_true(isa Operation.ALLOCA(entry.instructions[0].operation))
            are_equal("b0", targets_of(function, "entry")[0])
        si

        @Test()
        break_from_a_nested_region__should_go_to_where_the_outer_region_continues() is
            let outer = new_region()
            let inner = new_region()

            inner.body.add(BREAK(outer))
            outer.body.add(closed(inner))

            let (function, lowering) = lower(closed(outer))

            function.check()

            are_equal(0, lowering.unsupported.count)

            // b0 is the body, b1 where the outer region continues, b2 where
            // the inner one does.
            are_equal(1, targets_of(function, "b0").count)
            are_equal("b1", targets_of(function, "b0")[0])
        si

        @Test()
        code_after_an_unconditional_break__should_start_a_fresh_block() is
            let region = new_region()

            region.body.add(BREAK(region))
            region.body.add(NUMBER(1, _int))
            region.body.add(STORE_TEMP(LOCAL("x", _int)))

            let (function, _) = lower(closed(region))

            function.check()

            are_equal("b1", targets_of(function, "b0")[0])
            are_equal(4, function.blocks.count)
        si

        @Test()
        continue__should_go_to_the_loop_header() is
            let loop = new_loop()

            loop.body.add(CONTINUE(loop))

            let (function, lowering) = lower(closed(loop))

            function.check()

            are_equal(0, lowering.unsupported.count)

            // b1 is the header, b2 where the loop continues.
            are_equal("b1", targets_of(function, "b0")[0])
            are_equal("b1", targets_of(function, "b1")[0])
        si

        @Test()
        reaching_the_end_of_a_loop_body__should_go_round_again() is
            let (function, _) = lower(closed(new_loop()))

            function.check()

            are_equal("b1", targets_of(function, "b1")[0])
        si

        @Test()
        break_from_a_loop__should_go_to_where_it_continues() is
            let loop = new_loop()

            loop.body.add(BREAK(loop))

            let (function, _) = lower(closed(loop))

            function.check()

            are_equal("b2", targets_of(function, "b1")[0])
        si

        @Test()
        a_conditional_break__should_branch_to_the_target_or_on_to_a_fresh_block() is
            let local = LOCAL("x", _int)
            let region = new_region()

            region.body.add(BREAK(region, BRANCH.NZ, local.load()))

            let (function, lowering) = lower(closed(region))

            function.check()

            are_equal(0, lowering.unsupported.count)

            let targets = targets_of(function, "b0")

            are_equal(2, targets.count)
            are_equal("b1", targets[0])
            are_equal("b2", targets[1])
        si

        // `if x != 0 then 1 else 2 fi`, as the value of a block.
        @Test()
        a_value_producing_conditional__should_store_each_arm_and_return_the_value_read_back() is
            let local = LOCAL("x", _int)

            let result = new_region()
            let then_arm = new_region()

            then_arm.body.add(BREAK(then_arm, BRANCH.Z, local.load()))
            then_arm.body.add(NUMBER(1, _int))
            then_arm.body.add(BREAK(result))

            result.body.add(closed(then_arm))
            result.body.add(NUMBER(2, _int))

            let block = BLOCK(_int)

            block.add(closed(result))

            let (function, lowering) = lower([block, RET()]: Value, true)

            function.check()

            are_equal(0, lowering.unsupported.count)

            let text = text_of(function)

            is_true(text.contains("store i32 1, ptr"))
            is_true(text.contains("store i32 2, ptr"))
            is_true(text.contains("ret i32 %t"))
        si

        @Test()
        a_value_left_on_the_stack_across_a_region__should_be_reported() is
            let region = new_region()

            region.body.add(NUMBER(1, _int))

            let (_, lowering) = lower(closed(region))

            is_true((lowering.unsupported |> Ghul.Pipes.any(u => u =~ "a value left on the stack across a region")))
        si

        @Test()
        a_body_that_falls_off_its_end__should_return_the_default_value() is
            let (function, _) = lower(LIST[Value](), true)

            function.check()

            is_true(text_of(function).contains("ret i32 0"))
        si

        @Test()
        narrow_arithmetic__should_wrap_the_result_back_to_the_kind() is
            let local = LOCAL("b", _byte)

            let sum = ARITHMETIC(ArithmeticOperation.ADD, local.load(), local.load(), _byte)

            let (function, lowering) = lower([sum, STORE_TEMP(local)]: Value, false)

            function.check()

            are_equal(0, lowering.unsupported.count)

            let text = text_of(function)

            is_true(text.contains("trunc i32"))
            is_true(text.contains("sext i8"))
        si

        @Test()
        a_shift__should_use_only_the_low_bits_of_its_count() is
            let local = LOCAL("x", _int)

            let shifted = ARITHMETIC(ArithmeticOperation.SHIFT_LEFT, local.load(), local.load(), _int)

            let (function, _) = lower([shifted, STORE_TEMP(local)]: Value, false)

            function.check()

            is_true(text_of(function).contains(", 31"))
        si

        @Test()
        a_construct_the_target_does_not_handle__should_be_reported_once() is
            let (_, lowering) = lower([IR.Values.Literal.STRING("a", _int), IR.Values.Literal.STRING("b", _int)]: Value, false)

            are_equal(1, lowering.unsupported.count)
        si
    si
si
