namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.Types.Type

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STATIC_METHOD
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.FUNCTION_GROUP

    // Bare-minimum InnateSymbolLookup: real, distinguishable types for
    // the handful of primitives these tests reference, a real (if
    // simplified) get_function_type so get_full_type can build a
    // function's native call shape, and NotImplementedException for
    // everything else these tests never touch.
    class TEST_INNATE_SYMBOL_LOOKUP: Lookups.InnateSymbolLookup is

        get_join_separator() -> Symbols.Function? => null
        find_unspecialized_matrix_type(rank: int) -> Type? => null
        // Shared so DELEGATE_SHAPE's symbol-identity
        // ancestry test matches a fixture ancestor wherever the lookup
        // came from.
        multicast_delegate: CLASS static

        _fn_owner: CLASS
        // A generator frame declares itself an Iterable/Iterator over its
        // element type, so a test that runs declare() needs both.
        _iterable_type: Type
        _iterator_type: Type
        _int_type: Type
        _string_type: Type
        _bool_type: Type
        _void_type: Type
        // An async frame reads its result off the return type, so a
        // test that settles one needs both task spellings.
        _task_type: CLASS
        _void_task_type: Type

        init() static is
            let loc = LOCATION("test.ghul", 1, 1, 1, 1)
            multicast_delegate = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "System.MulticastDelegate", LIST[string](), Semantic.BLOCK_SCOPE())
        si

        init() is
            let loc = LOCATION("test.ghul", 1, 1, 1, 1)
            _fn_owner = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Fn", LIST[string](["T", "U"]), Semantic.BLOCK_SCOPE())
            _iterable_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Iterable", LIST[string](["T"]), Semantic.BLOCK_SCOPE()).type!
            _iterator_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Iterator", LIST[string](["T"]), Semantic.BLOCK_SCOPE()).type!
            _int_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Int", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _string_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "String", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _bool_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Bool", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _void_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Void", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _task_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Task", LIST[string](["T"]), Semantic.BLOCK_SCOPE())
            _void_task_type = CLASS(loc, loc, Semantic.BLOCK_SCOPE(), "Task", LIST[string](), Semantic.BLOCK_SCOPE()).type!
        si

        get_function_type(types: Type[]) -> Type => Semantic.Types.FUNCTION(_fn_owner.location, _fn_owner, types)
        get_function_type(types: Type[], is_pure: bool) -> Type =>
            if is_pure then
                Semantic.Types.PURE_FUNCTION(_fn_owner.location, _fn_owner, types)
            else
                get_function_type(types)
            fi

        get_int_type() -> Type => _int_type
        get_string_type() -> Type => _string_type
        get_void_type() -> Type => _void_type

        get_enum_type() -> Type => throw Ghul.NotImplementedException()
        get_tuple_type(types: Type[], names: string?[]?) -> Type => throw Ghul.NotImplementedException()
        get_array_type(type: Type) -> Type => throw Ghul.NotImplementedException()
        get_optional_type(type: Type) -> Type => throw Ghul.NotImplementedException()
        get_maybe_type(type: Type) -> Type? => throw Ghul.NotImplementedException()
        get_equality_comparer_type(type: Type) -> Type? => throw Ghul.NotImplementedException()
        get_list_type(type: Type) -> Type? => throw Ghul.NotImplementedException()
        get_pointer_type(type: Type) -> Type => throw Ghul.NotImplementedException()
        get_reference_type(type: Type) -> Type => throw Ghul.NotImplementedException()
        get_bool_type() -> Type => _bool_type
        get_char_type() -> Type => throw Ghul.NotImplementedException()
        get_byte_type() -> Type => throw Ghul.NotImplementedException()
        get_ubyte_type() -> Type => throw Ghul.NotImplementedException()
        get_short_type() -> Type => throw Ghul.NotImplementedException()
        get_ushort_type() -> Type => throw Ghul.NotImplementedException()
        get_uint_type() -> Type => throw Ghul.NotImplementedException()
        get_long_type() -> Type => throw Ghul.NotImplementedException()
        get_ulong_type() -> Type => throw Ghul.NotImplementedException()
        get_word_type() -> Type => throw Ghul.NotImplementedException()
        get_uword_type() -> Type => throw Ghul.NotImplementedException()
        get_single_type() -> Type => throw Ghul.NotImplementedException()
        get_double_type() -> Type => throw Ghul.NotImplementedException()
        get_decimal_type() -> Type => throw Ghul.NotImplementedException()
        get_bigint_type() -> Type => throw Ghul.NotImplementedException()
        get_complex_type() -> Type => throw Ghul.NotImplementedException()
        get_object_type() -> Type => _fn_owner.type!
        get_value_type() -> Type => throw Ghul.NotImplementedException()
        get_exception_type() -> Type => throw Ghul.NotImplementedException()
        find_exception_type() -> Type? => throw Ghul.NotImplementedException()
        find_unspecialized_list_type() -> Type? => throw Ghul.NotImplementedException()
        get_invalid_cast_exception_type() -> Type => throw Ghul.NotImplementedException()
        get_overflow_exception_type() -> Type => throw Ghul.NotImplementedException()
        get_type_type() -> Type => throw Ghul.NotImplementedException()
        find_type_type() -> Type? => throw Ghul.NotImplementedException()
        find_environment_type() -> Type? => throw Ghul.NotImplementedException()
        find_result_type() -> Semantic.Symbols.Classy? => throw Ghul.NotImplementedException()
        find_runtime_exception_type(kind: Semantic.Lookups.RuntimeException) -> Type? => throw Ghul.NotImplementedException()
        get_unspecialized_iterable_type() -> Type => _iterable_type
        get_unspecialized_list_type() -> Type => throw Ghul.NotImplementedException()
        get_unspecialized_mutable_list_type() -> Type => throw Ghul.NotImplementedException()
        get_int_range_types() -> (exclusive: Type, inclusive: Type)? => null
        get_unspecialized_iterator_type() -> Type => _iterator_type
        get_unspecialized_pipe_type() -> Type? => throw Ghul.NotImplementedException()
        get_unspecialized_task_type() -> Type? => _task_type.type!
        get_interpolated_string_handler_type() -> Type => throw Ghul.NotImplementedException()
        get_idisposable_type() -> Type => throw Ghul.NotImplementedException()
        get_multicast_delegate_type() -> Type? => multicast_delegate.type!

        get_pipes_fusion_functions() -> Collections.MAP[Symbols.Symbol, string] => Collections.MAP[Symbols.Symbol, string]()
        get_constructor_fusion_kind(constructor: Semantic.Symbols.Function) -> string? => null
        get_pipes_unbounded_sources() -> Collections.SET[Symbols.Symbol] => Collections.SET[Symbols.Symbol]()
        is_pipes_function(function: Symbols.Function) -> bool => false
        stops_early(function: Symbols.Function) -> bool => false
        reads_whole_source(function: Symbols.Function) -> bool => false
        holds_resource(function: Symbols.Function) -> bool => false
        get_box_type(type: Type) -> Type => throw Ghul.NotImplementedException()
        get_range_type() -> Type => throw Ghul.NotImplementedException()
        get_int_range_type() -> Type => throw Ghul.NotImplementedException()
        get_int_range_inclusive_type() -> Type => throw Ghul.NotImplementedException()

        get_slice_functions() -> Semantic.Symbols.FUNCTION_GROUP? => throw Ghul.NotImplementedException()
        get_reverse_iterator_functions() -> Semantic.Symbols.FUNCTION_GROUP? => null

        get_join_functions() -> Semantic.Symbols.FUNCTION_GROUP? => throw Ghul.NotImplementedException()
        get_buffered_pipe_classes() -> Collections.LIST[Semantic.Symbols.Classy?]? => throw Ghul.NotImplementedException()
        find_unspecialized_iterable_type() -> Semantic.Types.Type? => throw Ghul.NotImplementedException()
        get_display_functions() -> Semantic.Symbols.FUNCTION_GROUP? => throw Ghul.NotImplementedException()
        get_enum_text_functions() -> Semantic.Symbols.FUNCTION_GROUP? => throw Ghul.NotImplementedException()
        get_enum_text_group(name: string) -> Semantic.Symbols.FUNCTION_GROUP? => throw Ghul.NotImplementedException()
        get_system_enum_group(name: string) -> Semantic.Symbols.FUNCTION_GROUP? => throw Ghul.NotImplementedException()
        get_formattable_symbol() -> Semantic.Symbols.Symbol? => throw Ghul.NotImplementedException()
        get_render_elements_functions() -> Semantic.Symbols.FUNCTION_GROUP? => throw Ghul.NotImplementedException()
        get_task_type(type: Type) -> Type? =>
            Semantic.Types.GENERIC(_task_type.location, _task_type, LIST[Type]([type]))

        get_void_task_type() -> Type? => _void_task_type
        get_async_task_method_builder_type(type: Type) -> Type? =>
            // An async frame's declare() mints its builder field from
            // this; a stand-in named type is enough for symbol-level
            // tests, which never encode the field's signature.
            _string_type

        get_async_task_method_builder_void_type() -> Type? => throw Ghul.NotImplementedException()
        get_async_state_machine_interface_type() -> Type? =>
            // An async frame's declare() lists this among its ancestors;
            // a stand-in named type is enough for symbol-level tests.
            _fn_owner.type!
        get_notify_completion_type() -> Type? => throw Ghul.NotImplementedException()
        get_critical_notify_completion_type() -> Type? => throw Ghul.NotImplementedException()
    si
si
