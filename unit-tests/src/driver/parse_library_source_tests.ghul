namespace Driver.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // MAIN.parse_library_source splits a --library-source value into its
    // name, version and root: the root is everything after the first `=`,
    // so a Windows path with a drive letter needs no escaping.
    @TestClass()
    class PARSE_LIBRARY_SOURCE_TESTS is
        init() is si

        @Test()
        a_value_splits_into_name_version_and_root() is
            let (name, version, root) = MAIN.parse_library_source("testlib@1.0.0=/sources/testlib")

            are_equal("testlib", name)
            are_equal("1.0.0", version)
            are_equal("/sources/testlib", root)
        si

        @Test()
        a_windows_root_keeps_its_drive_letter() is
            let (name, version, root) = MAIN.parse_library_source(
                "testlib@1.0.0=C:\\sources\\testlib"
            )

            are_equal("testlib", name)
            are_equal("1.0.0", version)
            are_equal("C:\\sources\\testlib", root)
        si

        @Test()
        a_value_with_no_equals_is_rejected() is
            expects_bad_input("testlib@1.0.0")
        si

        @Test()
        a_value_with_no_at_sign_is_rejected() is
            expects_bad_input("testlib1.0.0=/sources/testlib")
        si

        @Test()
        an_empty_name_is_rejected() is
            expects_bad_input("@1.0.0=/sources/testlib")
        si

        @Test()
        an_empty_version_is_rejected() is
            expects_bad_input("testlib@=/sources/testlib")
        si

        @Test()
        an_empty_root_is_rejected() is
            expects_bad_input("testlib@1.0.0=")
        si

        expects_bad_input(value: string) is
            try
                MAIN.parse_library_source(value)

                fail("expected an INPUT_EXCEPTION for '{value}'")
            catch e: INPUT_EXCEPTION
                are_equal(
                    "--library-source expects <name>@<version>=<root>, not '{value}'",
                    e.message
                )
            yrt
        si
    si
si
