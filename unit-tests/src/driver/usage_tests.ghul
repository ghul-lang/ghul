namespace Driver.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Collections.LIST
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class USAGE_TESTS is
        init() is si

        arguments(values: string[]) -> LIST[string] is
            let result = LIST[string]()

            for value in values do
                result.add(value)
            od

            return result
        si

        @Test()
        long_form_is_recognised() is
            is_true(Driver.USAGE.is_requested(arguments(["--help"])))
        si

        @Test()
        short_forms_are_recognised() is
            is_true(Driver.USAGE.is_requested(arguments(["-h"])))
            is_true(Driver.USAGE.is_requested(arguments(["-?"])))
        si

        @Test()
        request_is_recognised_after_other_arguments() is
            // help wins wherever it appears, including behind sources
            is_true(Driver.USAGE.is_requested(arguments(["a.ghul", "-o", "out.exe", "--help"])))
        si

        @Test()
        ordinary_arguments_are_not_a_request() is
            is_false(Driver.USAGE.is_requested(arguments(["a.ghul"])))
            is_false(Driver.USAGE.is_requested(arguments([])))
        si

        // `--help` must not be confused with the flags it shares a prefix with,
        // nor `-?` with the presence-test operator appearing in a source name
        @Test()
        similar_arguments_are_not_a_request() is
            is_false(Driver.USAGE.is_requested(arguments(["--helpful"])))
            is_false(Driver.USAGE.is_requested(arguments(["-help"])))
            is_false(Driver.USAGE.is_requested(arguments(["help"])))
        si

        @Test()
        text_describes_the_invocation_and_the_help_flag() is
            let text = Driver.USAGE.text

            is_true(text.contains("usage: ghul-compiler"))
            is_true(text.contains("--help"))
            is_true(text.contains("hello.ghul"))
        si

        // the flag that most needs saying, since --version means something else
        @Test()
        text_explains_how_to_get_the_compiler_version() is
            is_true(Driver.USAGE.text.contains("prints its version"))
        si
    si
si
