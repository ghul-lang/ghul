namespace Analysis.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Collections.LIST
    use Collections.List

    use Source.LOCATION

    use Analysis.OUTER_SPAN_FILTER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class OUTER_SPAN_FILTER_TESTS is
        init() is si

        span(start: int, end: int) -> LOCATION static => LOCATION("test.ghul", start, end)

        // The kept spans as "start-end,start-end", in ascending order, so
        // an assertion reads as the answer rather than as a walk over it.
        kept(spans: LOCATION[]) -> string static is
            let result = OUTER_SPAN_FILTER().apply(spans, s => s)

            let rendered = LIST[string]()

            for s in result do
                rendered.add("{s.start}-{s.end}")
            od

            rendered.sort()

            return string.join(",", rendered)
        si

        // The definition the filter implements, spelled out: a span is
        // dropped exactly when some other span in the set is properly
        // inside it. Quadratic, which is the whole reason the filter does
        // something cleverer - so the tests check the two against each
        // other rather than trusting either alone.
        kept_by_definition(spans: LOCATION[]) -> string static is
            let rendered = LIST[string]()

            for outer in spans do
                let contains_another mut = false

                for inner in spans do
                    if outer.strictly_contains(inner) then
                        contains_another = true
                    fi
                od

                if !contains_another then
                    rendered.add("{outer.start}-{outer.end}")
                fi
            od

            rendered.sort()

            return string.join(",", rendered)
        si

        @Test()
        no_spans__keeps_nothing() is
            are_equal("", kept(LIST[LOCATION]()))
        si

        @Test()
        disjoint_spans__all_kept() is
            are_equal(
                "10-15,20-25,30-35",
                kept([span(10, 15), span(20, 25), span(30, 35)])
            )
        si

        @Test()
        nested_span__outer_dropped() is
            are_equal("12-14", kept([span(10, 20), span(12, 14)]))
        si

        @Test()
        three_deep__only_innermost_kept() is
            are_equal(
                "12-14",
                kept([span(10, 20), span(11, 16), span(12, 14)])
            )
        si

        // The two ways a span can be properly contained while sharing an
        // edge with its container - the cases an implementation that
        // orders by one coordinate alone gets wrong.
        @Test()
        shared_start__wider_dropped() is
            are_equal("10-14", kept([span(10, 20), span(10, 14)]))
        si

        @Test()
        shared_end__wider_dropped() is
            are_equal("16-20", kept([span(10, 20), span(16, 20)]))
        si

        // Two uses recorded at the same identifier - an overload group and
        // the member it resolved to. Neither is inside the other, so the
        // filter must not treat either as an outer span.
        @Test()
        identical_spans__both_kept() is
            are_equal("10-20,10-20", kept([span(10, 20), span(10, 20)]))
        si

        @Test()
        identical_spans_inside_a_wider_one__only_the_pair_kept() is
            are_equal(
                "12-14,12-14",
                kept([span(10, 20), span(12, 14), span(12, 14)])
            )
        si

        // Spans arrive in whatever order the use map yields them, so the
        // answer must not depend on it.
        @Test()
        input_order__does_not_change_the_answer() is
            let forwards = [span(10, 20), span(11, 16), span(12, 14), span(30, 35)]
            let backwards = [span(30, 35), span(12, 14), span(11, 16), span(10, 20)]

            are_equal(kept(forwards), kept(backwards))
        si

        // A spread of overlapping, nested, touching and duplicated spans,
        // checked against the definition above. The generator is a plain
        // linear congruence so the set is the same on every run.
        @Test()
        many_spans__agrees_with_the_definition() is
            let spans = LIST[LOCATION]()

            let seed mut = 12345

            for i in 0..400 do
                seed = (seed * 1103 + 12345) % 30011

                let start = seed % 200
                let length = (seed / 200) % 30

                spans.add(span(start, start + length))
            od

            are_equal(kept_by_definition(spans), kept(spans))
        si
    si
si
