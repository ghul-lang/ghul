namespace Source.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A pushed null stands for no position, hiding whatever is beneath
    // it until it is popped.
    @TestClass()
    class LOCATION_STACK_TESTS is
        init() is si

        @Test()
        push__of_no_position_should_hide_the_position_beneath() is
            let stack = LOCATION_STACK()
            let outer = LOCATION("a.ghul", 1, 1, 1, 5)

            stack.push(outer)
            stack.push(null)

            is_null(stack.current)

            stack.pop()

            are_same(outer, stack.current)
        si
    si
si
