namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.GENERATOR_YIELD_JOIN
    use Semantic.Symbols.CLASS
    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class GENERATOR_YIELD_JOIN_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        build() -> (generator: CLASS, animal: Type, cat: Type, dog: Type) is
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", LIST[string](), Semantic.BLOCK_SCOPE())
            object_class.mark_is_object()

            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Animal", LIST[string](), Semantic.BLOCK_SCOPE())
            animal.add_ancestor(object_class.type!)

            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "CAT", LIST[string](), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            let dog = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "DOG", LIST[string](), Semantic.BLOCK_SCOPE())
            dog.add_ancestor(animal.type!)

            // Any symbol serves as the key a generator is recorded under.
            let generator = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "generator", LIST[string](), Semantic.BLOCK_SCOPE())

            return (generator, animal.type!, cat.type!, dog.type!)
        si

        @Test()
        Calling__widened__with_a_yield_the_element_type_accepts__should_return_null() is
            let h = build()
            let join = GENERATOR_YIELD_JOIN()

            join.first(h.generator, h.animal)

            is_null(join.widened(h.generator, h.animal, h.cat))
        si

        @Test()
        Calling__widened__with_a_sibling_of_the_first_yield__should_return_their_join() is
            let h = build()
            let join = GENERATOR_YIELD_JOIN()

            join.first(h.generator, h.cat)

            are_same(h.animal, join.widened(h.generator, h.cat, h.dog))
        si

        @Test()
        Calling__widened__with_no_first_yield_on_record__should_return_null() is
            let h = build()

            is_null(GENERATOR_YIELD_JOIN().widened(h.generator, h.cat, h.dog))
        si

        @Test()
        Calling__first__again__should_forget_the_previous_walks_yields() is
            // A later walk starts its record at its own first yield, so a
            // yield an earlier walk saw does not widen it.
            let h = build()
            let join = GENERATOR_YIELD_JOIN()

            join.first(h.generator, h.cat)
            join.widened(h.generator, h.cat, h.dog)

            join.first(h.generator, h.cat)

            is_null(join.widened(h.generator, h.cat, h.cat))
        si
    si
si
