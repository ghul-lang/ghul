namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Types.Type

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INSTANCE_METHOD
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for DELEGATE_SHAPE.could_take_arity, which keeps a function
    // literal from counting as a candidate for a named delegate whose
    // parameter count it cannot have - `Thread(ThreadStart)` against
    // `Thread(ParameterizedThreadStart)` for a literal of no parameters.
    @TestClass()
    class DELEGATE_SHAPE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        lookup() -> Lookups.InnateSymbolLookup => TEST_INNATE_SYMBOL_LOOKUP()

        delegate_type(name: string, argument_types: Type[], return_type: Type) -> CLASS is
            let d = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

            d.add_ancestor(TEST_INNATE_SYMBOL_LOOKUP.multicast_delegate.type!)

            let invoke = INSTANCE_METHOD(loc(), loc(), d, "invoke", Semantic.BLOCK_SCOPE())
            invoke.arguments = argument_types
            invoke.return_type = return_type
            d.add_member(invoke)

            return d
        si

        @Test()
        Calling__could_take_arity__with_the_delegates_own_parameter_count__returns_true() is
            let l = lookup()
            let d = delegate_type("ParameterizedStart", LIST[Type]([l.get_int_type()]), l.get_void_type())

            is_true(Semantic.DELEGATE_SHAPE().could_take_arity(d.type!, 1, l))
        si

        @Test()
        Calling__could_take_arity__with_a_different_parameter_count__returns_false() is
            let l = lookup()
            let d = delegate_type("ParameterizedStart", LIST[Type]([l.get_int_type()]), l.get_void_type())

            is_false(Semantic.DELEGATE_SHAPE().could_take_arity(d.type!, 0, l))
        si

        @Test()
        Calling__could_take_arity__on_a_delegate_of_no_parameters__takes_only_none() is
            let l = lookup()
            let d = delegate_type("Start", LIST[Type](), l.get_void_type())

            is_true(Semantic.DELEGATE_SHAPE().could_take_arity(d.type!, 0, l))
            is_false(Semantic.DELEGATE_SHAPE().could_take_arity(d.type!, 1, l))
        si
    si
si
