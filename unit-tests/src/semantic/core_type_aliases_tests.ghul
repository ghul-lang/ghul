namespace Semantic.UnitTests is
    use Semantic.CORE_TYPE_ALIASES

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class CORE_TYPE_ALIASES_TESTS is
        init() is si

        @Test()
        renamed_in_source__an_old_exception_name__gives_its_ghul_name() is
            are_equal("Ghul.Exception", CORE_TYPE_ALIASES.renamed_in_source("System.Exception"))
        si

        @Test()
        renamed_in_source__an_old_name_in_a_nested_namespace__gives_its_ghul_name() is
            are_equal("Text.STRING_BUILDER", CORE_TYPE_ALIASES.renamed_in_source("System.Text.StringBuilder"))
        si

        @Test()
        renamed_in_source__an_old_name_only_source_declares__gives_its_ghul_name() is
            are_equal("Ghul.Type", CORE_TYPE_ALIASES.renamed_in_source("System.Type"))
        si

        @Test()
        renamed_in_source__a_name_that_is_not_old__gives_null() is
            is_null(CORE_TYPE_ALIASES.renamed_in_source("Ghul.Exception"))
            is_null(CORE_TYPE_ALIASES.renamed_in_source("System"))
        si

        @Test()
        is_namespace_in_source__a_namespace_an_old_name_lies_in__is_true() is
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System"))
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System.Text"))
        si

        @Test()
        is_namespace_in_source__an_old_name_itself__is_false() is
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("System.Exception"))
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("Sys"))
        si

        @Test()
        homes__a_type_that_moved__gives_its_new_name_then_its_earlier_home() is
            let homes = CORE_TYPE_ALIASES.homes("Text.STRING_BUILDER")

            are_equal(2, homes.count)
            are_equal("Text.STRING_BUILDER", homes[0])
            are_equal("Ghul.STRING_BUILDER", homes[1])
        si

        @Test()
        homes__a_type_that_never_moved__gives_only_its_name() is
            let homes = CORE_TYPE_ALIASES.homes("Ghul.Exception")

            are_equal(1, homes.count)
            are_equal("Ghul.Exception", homes[0])
        si

        @Test()
        all__leaves_out_names_only_source_declares() is
            for alias in CORE_TYPE_ALIASES.all do
                are_not_equal("System.Type", alias.old_name)
            od
        si
    si
si
