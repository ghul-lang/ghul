namespace Semantic.UnitTests is
    use Semantic.CORE_TYPE_ALIASES

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class CORE_TYPE_ALIASES_TESTS is
        init() is si

        @Test()
        renamed_in_source__an_old_exception_name__gives_its_ghul_name() is
            are_equal("Ghul.Exception", CORE_TYPE_ALIASES.renamed_in_source("System.Exception"))
        si

        @Test()
        renamed_in_source__an_old_name_in_a_nested_namespace__gives_its_ghul_name() is
            are_equal("Text.STRING_BUILDER", CORE_TYPE_ALIASES.renamed_in_source("System.Text.StringBuilder"))
        si

        @Test()
        renamed_in_source__system_type__gives_ghul_type() is
            are_equal("Ghul.Type", CORE_TYPE_ALIASES.renamed_in_source("System.Type"))
        si

        @Test()
        renamed_in_source__a_name_that_is_not_old__gives_null() is
            is_null(CORE_TYPE_ALIASES.renamed_in_source("Ghul.Exception"))
            is_null(CORE_TYPE_ALIASES.renamed_in_source("System"))
        si

        @Test()
        renamed_in_source__system_math__gives_null_because_ghul_math_is_the_runtime_namespace() is
            is_null(CORE_TYPE_ALIASES.renamed_in_source("System.Math"))
        si

        @Test()
        is_namespace_in_source__a_namespace_an_old_name_lies_in__is_true() is
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System"))
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System.Text"))
        si

        @Test()
        is_namespace_in_source__an_old_name_itself__is_false() is
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("System.Exception"))
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("Sys"))
        si

        @Test()
        homes__a_type_that_moved__gives_its_new_name_then_its_earlier_home() is
            let homes = CORE_TYPE_ALIASES.homes("Text.STRING_BUILDER")

            are_equal(2, homes.count)
            are_equal("Text.STRING_BUILDER", homes[0])
            are_equal("Ghul.STRING_BUILDER", homes[1])
        si

        @Test()
        homes__a_type_that_never_moved__gives_only_its_name() is
            let homes = CORE_TYPE_ALIASES.homes("Ghul.Exception")

            are_equal(1, homes.count)
            are_equal("Ghul.Exception", homes[0])
        si

        @Test()
        all__aliases_system_type_to_ghul_type_on_every_target() is
            let found: string? mut = null

            for alias in CORE_TYPE_ALIASES.all do
                if alias.old_name =~ "System.Type" then
                    found = alias.new_name
                fi
            od

            are_equal("Ghul.Type", found)
        si

        @Test()
        is_namespace_in_source__a_namespace_a_type_is_moving_to__is_true() is
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("Time"))
        si

        @Test()
        has_earlier_home__a_type_that_moved_out_of_system__is_true() is
            is_true(CORE_TYPE_ALIASES.has_earlier_home("Time.DATE_TIME"))
            is_true(CORE_TYPE_ALIASES.has_earlier_home("Time.STOPWATCH"))
        si

        @Test()
        has_earlier_home__a_type_that_never_moved__is_false() is
            is_false(CORE_TYPE_ALIASES.has_earlier_home("Ghul.Exception"))
        si

        @Test()
        renamed_in_source__a_string_option_enum_under_either_old_name__is_its_text_name() is
            are_equal("Text.StringComparison", CORE_TYPE_ALIASES.renamed_in_source("System.StringComparison"))
            are_equal("Text.StringComparison", CORE_TYPE_ALIASES.renamed_in_source("Ghul.StringComparison"))
            are_equal("Text.StringSplitOptions", CORE_TYPE_ALIASES.renamed_in_source("Ghul.StringSplitOptions"))
        si

        @Test()
        homes__a_text_type__gives_its_new_name_then_its_old_one() is
            let homes = CORE_TYPE_ALIASES.homes("Text.CULTURE")

            are_equal(2, homes.count)
            are_equal("Text.CULTURE", homes[0])
            are_equal("System.Globalization.CultureInfo", homes[1])
        si

        @Test()
        homes__a_time_type__gives_its_new_name_then_its_old_one() is
            let homes = CORE_TYPE_ALIASES.homes("Time.DATE_TIME")

            are_equal(2, homes.count)
            are_equal("Time.DATE_TIME", homes[0])
            are_equal("System.DateTime", homes[1])
        si
    si
si
