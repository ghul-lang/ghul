namespace Semantic.UnitTests is
    use Semantic.CORE_TYPE_ALIASES

    use Assertions

    class CORE_TYPE_ALIASES_TESTS is
        init() is si

        @test()
        renamed_in_source__an_old_exception_name__gives_its_ghul_name() is
            are_equal("Ghul.Exception", CORE_TYPE_ALIASES.renamed_in_source("System.Exception"))
        si

        @test()
        renamed_in_source__an_old_name_in_a_nested_namespace__gives_its_ghul_name() is
            are_equal("Text.StringBuilder", CORE_TYPE_ALIASES.renamed_in_source("System.Text.StringBuilder"))
        si

        @test()
        renamed_in_source__an_upper_snake_old_name__gives_its_pascal_case_name() is
            are_equal("Text.StringBuilder", CORE_TYPE_ALIASES.renamed_in_source("Text.STRING_BUILDER"))
            are_equal("Text.Regex", CORE_TYPE_ALIASES.renamed_in_source("Text.REGEX"))
            are_equal("Text.Rune", CORE_TYPE_ALIASES.renamed_in_source("Text.RUNE"))
            are_equal("Ghul.Box", CORE_TYPE_ALIASES.renamed_in_source("Ghul.BOX"))
            are_equal("Collections.PriorityQueue", CORE_TYPE_ALIASES.renamed_in_source("Collections.PRIORITY_QUEUE"))
        si

        @test()
        renamed_in_source__system_type__gives_ghul_type() is
            are_equal("Ghul.Type", CORE_TYPE_ALIASES.renamed_in_source("System.Type"))
        si

        @test()
        renamed_in_source__a_name_that_is_not_old__gives_null() is
            is_null(CORE_TYPE_ALIASES.renamed_in_source("Ghul.Exception"))
            is_null(CORE_TYPE_ALIASES.renamed_in_source("System"))
        si

        @test()
        renamed_in_source__system_math__gives_null_because_ghul_math_is_the_runtime_namespace() is
            is_null(CORE_TYPE_ALIASES.renamed_in_source("System.Math"))
        si

        @test()
        is_namespace_in_source__a_namespace_an_old_name_lies_in__is_true() is
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System"))
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System.Text"))
        si

        @test()
        is_namespace_in_source__an_old_name_itself__is_false() is
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("System.Exception"))
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("Sys"))
        si

        @test()
        homes__a_type_that_moved__gives_its_new_name_then_its_earlier_home() is
            let homes = CORE_TYPE_ALIASES.homes("Text.StringBuilder")

            are_equal(3, homes.count)
            are_equal("Text.StringBuilder", homes[0])
            are_equal("Ghul.STRING_BUILDER", homes[1])
            are_equal("Text.STRING_BUILDER", homes[2])
        si

        @test()
        homes__a_type_that_never_moved__gives_only_its_name() is
            let homes = CORE_TYPE_ALIASES.homes("Ghul.Exception")

            are_equal(1, homes.count)
            are_equal("Ghul.Exception", homes[0])
        si

        @test()
        all__aliases_system_type_to_ghul_type_on_every_target() is
            let found: string? mut = null

            for alias in CORE_TYPE_ALIASES.all do
                if alias.old_name =~ "System.Type" then
                    found = alias.new_name
                fi
            od

            are_equal("Ghul.Type", found)
        si

        @test()
        is_namespace_in_source__a_namespace_a_type_is_moving_to__is_true() is
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("Time"))
        si

        @test()
        has_earlier_home__a_type_that_moved_out_of_system__is_true() is
            is_true(CORE_TYPE_ALIASES.has_earlier_home("Time.DateTime"))
            is_true(CORE_TYPE_ALIASES.has_earlier_home("Time.Stopwatch"))
        si

        @test()
        has_earlier_home__a_type_that_never_moved__is_false() is
            is_false(CORE_TYPE_ALIASES.has_earlier_home("Ghul.Exception"))
        si

        @test()
        renamed_in_source__a_string_option_enum_under_either_old_name__is_its_text_name() is
            are_equal("Text.StringComparison", CORE_TYPE_ALIASES.renamed_in_source("System.StringComparison"))
            are_equal("Text.StringComparison", CORE_TYPE_ALIASES.renamed_in_source("Ghul.StringComparison"))
            are_equal("Text.StringSplitOptions", CORE_TYPE_ALIASES.renamed_in_source("Ghul.StringSplitOptions"))
        si

        @test()
        homes__a_text_type__gives_its_new_name_then_its_old_one() is
            let homes = CORE_TYPE_ALIASES.homes("Text.Locale")

            are_equal(2, homes.count)
            are_equal("Text.Locale", homes[0])
            are_equal("System.Globalization.CultureInfo", homes[1])
        si

        @test()
        renamed_in_source__an_encoding_or_text_info_type__is_its_text_name() is
            are_equal("Text.UTF8_ENCODING", CORE_TYPE_ALIASES.renamed_in_source("System.Text.UTF8Encoding"))
            are_equal("Text.ASCII_ENCODING", CORE_TYPE_ALIASES.renamed_in_source("System.Text.ASCIIEncoding"))
            are_equal("Text.UTF32_ENCODING", CORE_TYPE_ALIASES.renamed_in_source("System.Text.UTF32Encoding"))
            are_equal("Text.UTF16_ENCODING", CORE_TYPE_ALIASES.renamed_in_source("System.Text.UnicodeEncoding"))
            are_equal("Text.StringInfo", CORE_TYPE_ALIASES.renamed_in_source("System.Globalization.StringInfo"))
            are_equal("Text.TextInfo", CORE_TYPE_ALIASES.renamed_in_source("System.Globalization.TextInfo"))
        si

        @test()
        homes__an_encoding__gives_its_text_name_then_its_system_one() is
            let homes = CORE_TYPE_ALIASES.homes("Text.UTF8_ENCODING")

            are_equal(2, homes.count)
            are_equal("Text.UTF8_ENCODING", homes[0])
            are_equal("System.Text.UTF8Encoding", homes[1])
        si

        @test()
        renamed_in_source__a_numeric_type__is_its_ghul_math_name() is
            are_equal("Ghul.Math.BitOperations", CORE_TYPE_ALIASES.renamed_in_source("System.Numerics.BitOperations"))
            are_equal("Ghul.Math.BitConverter", CORE_TYPE_ALIASES.renamed_in_source("System.BitConverter"))
        si

        @test()
        homes__a_numeric_type__gives_its_ghul_math_name_then_its_system_one() is
            let homes = CORE_TYPE_ALIASES.homes("Ghul.Math.BitOperations")

            are_equal(2, homes.count)
            are_equal("Ghul.Math.BitOperations", homes[0])
            are_equal("System.Numerics.BitOperations", homes[1])
        si

        @test()
        renamed_in_source__a_reflection_type__is_its_ghul_reflection_name() is
            are_equal("Ghul.Reflection.MethodInfo", CORE_TYPE_ALIASES.renamed_in_source("System.Reflection.MethodInfo"))
            are_equal("Ghul.Reflection.BindingFlags", CORE_TYPE_ALIASES.renamed_in_source("System.Reflection.BindingFlags"))
            are_equal("Ghul.Reflection.Activator", CORE_TYPE_ALIASES.renamed_in_source("System.Activator"))
        si

        @test()
        homes__a_reflection_type__gives_its_ghul_reflection_name_then_its_system_one() is
            let homes = CORE_TYPE_ALIASES.homes("Ghul.Reflection.Assembly")

            are_equal(2, homes.count)
            are_equal("Ghul.Reflection.Assembly", homes[0])
            are_equal("System.Reflection.Assembly", homes[1])
        si

        @test()
        renamed_in_source__a_language_type__is_its_ghul_name() is
            are_equal("Ghul.GC", CORE_TYPE_ALIASES.renamed_in_source("System.GC"))
            are_equal("Ghul.ObsoleteAttribute", CORE_TYPE_ALIASES.renamed_in_source("System.ObsoleteAttribute"))
            are_equal("Ghul.MethodImplAttribute", CORE_TYPE_ALIASES.renamed_in_source("System.Runtime.CompilerServices.MethodImplAttribute"))
            are_equal("Ghul.MethodImplOptions", CORE_TYPE_ALIASES.renamed_in_source("System.Runtime.CompilerServices.MethodImplOptions"))
            are_equal("Ghul.Formattable", CORE_TYPE_ALIASES.renamed_in_source("System.IFormattable"))
            are_equal("Tasks.Thread", CORE_TYPE_ALIASES.renamed_in_source("System.Threading.Thread"))
        si

        @test()
        renamed_in_source__uri__is_io_uri() is
            are_equal("IO.Uri", CORE_TYPE_ALIASES.renamed_in_source("System.Uri"))
        si

        @test()
        homes__uri__gives_its_io_name_then_its_system_one() is
            let homes = CORE_TYPE_ALIASES.homes("IO.Uri")

            are_equal(2, homes.count)
            are_equal("IO.Uri", homes[0])
            are_equal("System.Uri", homes[1])
        si

        @test()
        renamed_in_source__a_cryptography_type__is_its_crypto_name() is
            are_equal("Crypto.MD5", CORE_TYPE_ALIASES.renamed_in_source("System.Security.Cryptography.MD5"))
            are_equal("Crypto.SHA1", CORE_TYPE_ALIASES.renamed_in_source("System.Security.Cryptography.SHA1"))
            are_equal("Crypto.SHA256", CORE_TYPE_ALIASES.renamed_in_source("System.Security.Cryptography.SHA256"))
            are_equal("Crypto.RandomNumberGenerator", CORE_TYPE_ALIASES.renamed_in_source("System.Security.Cryptography.RandomNumberGenerator"))
        si

        @test()
        homes__a_hash__gives_its_crypto_name_then_its_cryptography_one() is
            let homes = CORE_TYPE_ALIASES.homes("Crypto.SHA256")

            are_equal(2, homes.count)
            are_equal("Crypto.SHA256", homes[0])
            are_equal("System.Security.Cryptography.SHA256", homes[1])
        si

        @test()
        a_name_that_is_neither_old_nor_moved__is_unknown_to_every_question() is
            is_null(CORE_TYPE_ALIASES.renamed_in_source("Collections.LIST"))
            is_false(CORE_TYPE_ALIASES.has_earlier_home("Collections.LIST"))
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("Collections.LIST"))
            is_null(CORE_TYPE_ALIASES.renamed_in_source(""))
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source(""))
        si

        @test()
        is_namespace_in_source__every_enclosing_namespace_of_a_deep_old_name__is_true() is
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System.Security"))
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System.Security.Cryptography"))
            is_true(CORE_TYPE_ALIASES.is_namespace_in_source("System.Runtime.CompilerServices"))
        si

        @test()
        is_namespace_in_source__part_of_a_segment_or_a_moved_type_itself__is_false() is
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("System.Sec"))
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("System.Security.Cryptography.MD5"))
            is_false(CORE_TYPE_ALIASES.is_namespace_in_source("Time.DateTime"))
        si

        @test()
        homes__a_time_type__gives_its_new_name_then_its_old_one() is
            let homes = CORE_TYPE_ALIASES.homes("Time.DateTime")

            are_equal(3, homes.count)
            are_equal("Time.DateTime", homes[0])
            are_equal("System.DateTime", homes[1])
            are_equal("Time.DATE_TIME", homes[2])
        si
    si
si
