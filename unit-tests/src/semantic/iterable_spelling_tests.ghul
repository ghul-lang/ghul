namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Only the reflected iterable trait with its one type argument is
    // shown as `T{}`; everything else keeps its written name, and is
    // turned away before the reflected trait is looked up at all.
    @TestClass()
    class ITERABLE_SPELLING_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        class_named(name: string) -> Semantic.Symbols.CLASS =>
            Semantic.Symbols.CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](["T"]), Semantic.BLOCK_SCOPE())

        @Test()
        Calling__applies_to__for_another_generic__should_be_false() is
            is_false(ITERABLE_SPELLING.applies_to(class_named("BOX"), 1))
        si

        @Test()
        Calling__applies_to__with_other_than_one_argument__should_be_false() is
            is_false(ITERABLE_SPELLING.applies_to(class_named("Iterable"), 2))
        si
    si
si
