namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A tuple type is a value tuple whatever its symbol came from: the
    // ValueTuple a .NET build reflects, or the tuple class a wasm build
    // compiles from the core library's source.
    @TestClass()
    class TUPLE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        int_type() -> Type => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

        tuple_of(names: LIST[string?]?) -> Semantic.Types.TUPLE =>
            Semantic.Types.TUPLE(
                loc(),
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TUPLE_2", LIST[string](["T1", "T2"]), Semantic.BLOCK_SCOPE()),
                LIST[Type]([int_type(), int_type()]),
                names)

        @Test()
        Calling__is_value_tuple__on_a_tuple_built_from_a_source_class__should_be_true() is
            is_true(tuple_of(null).is_value_tuple)
        si

        @Test()
        Calling__is_value_tuple__on_a_named_tuple__should_be_true_and_keep_its_names() is
            let tuple = tuple_of(LIST[string?](["x", "y"]))

            is_true(tuple.is_value_tuple)
            are_equal("x", tuple.tuple_element_names![0])
            are_equal("y", tuple.tuple_element_names![1])
        si
    si
si
