namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS

    use Semantic.Types.FUNCTION
    use Semantic.Types.NULL
    use Semantic.Types.NULL_ELEMENT
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // NULL_ELEMENT answers whether a type holds a bare `null` type inside
    // it, which no runtime type can represent. The type of `null` itself is
    // not such a type: it is the ordinary type of a `null` value.
    @TestClass()
    class NULL_ELEMENT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        names(count: int) -> LIST[string] is
            let result = LIST[string]()

            for i in 0..count do
                result.add("T{i}")
            od

            return result
        si

        int_type() -> Type => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!

        function_class() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "function", names(2), Semantic.BLOCK_SCOPE())

        function_of(argument: Type, result: Type) -> Type => FUNCTION(loc(), function_class(), LIST[Type]([argument, result]))

        @Test()
        Calling__within__on_a_generic_with_a_null_argument__should_be_true() is
            is_true(NULL_ELEMENT.within(function_of(NULL(), int_type())))
        si

        @Test()
        Calling__within__on_a_generic_with_a_null_argument_nested_inside_another__should_be_true() is
            is_true(NULL_ELEMENT.within(function_of(int_type(), function_of(NULL(), int_type()))))
        si

        @Test()
        Calling__within__on_a_generic_without_a_null_argument__should_be_false() is
            is_false(NULL_ELEMENT.within(function_of(int_type(), int_type())))
        si

        @Test()
        Calling__within__on_the_null_type_itself__should_be_false() is
            is_false(NULL_ELEMENT.within(NULL()))
        si

        tuple_of(first: Type, second: Type) -> Type =>
            Semantic.Types.TUPLE(
                loc(),
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "ValueTuple", names(2), Semantic.BLOCK_SCOPE()),
                LIST[Type]([first, second]),
                null)

        @Test()
        Calling__fits__with_an_actual_holding_no_null__should_be_true_whatever_the_formal() is
            is_true(NULL_ELEMENT.fits(int_type(), tuple_of(int_type(), int_type())))
        si

        @Test()
        Calling__fits__with_a_null_element_and_a_formal_that_is_not_a_tuple__should_be_false() is
            is_false(NULL_ELEMENT.fits(int_type(), tuple_of(int_type(), NULL())))
        si

        @Test()
        Calling__fits__with_a_null_element_and_a_tuple_formal__should_be_true() is
            is_true(NULL_ELEMENT.fits(tuple_of(int_type(), int_type()), tuple_of(int_type(), NULL())))
        si
    si
si
