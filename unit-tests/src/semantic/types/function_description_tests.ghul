namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS

    use Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A function type with one parameter writes that parameter bare,
    // unless it is itself a tuple or a function, whose own
    // parentheses are what keep it apart from a multi-parameter or a
    // curried function type.
    @TestClass()
    class FUNCTION_DESCRIPTION_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        lookup() -> Semantic.Lookups.InnateSymbolLookup => TEST_INNATE_SYMBOL_LOOKUP()

        owner(name: string, parameters: LIST[string]) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, parameters, Semantic.BLOCK_SCOPE())

        tuple_of(a: Type, b: Type) -> Type =>
            TUPLE(loc(), owner("ValueTuple", LIST[string](["T1", "T2"])), LIST[Type]([a, b]), null)

        @Test()
        Reading__short_description__of_a_function_taking_one_tuple__should_parenthesise_the_tuple() is
            let l = lookup()
            let int = l.get_int_type()

            let function = l.get_function_type(LIST[Type]([tuple_of(int, int), int]))

            are_equal("((Int, Int)) -> Int", function.short_description)
        si

        @Test()
        Reading__short_description__of_a_function_taking_two_parameters__should_write_them_as_a_list() is
            let l = lookup()
            let int = l.get_int_type()

            let function = l.get_function_type(LIST[Type]([int, int, int]))

            are_equal("(Int, Int) -> Int", function.short_description)
        si

        @Test()
        Reading__short_description__of_a_function_taking_one_function__should_parenthesise_the_function() is
            let l = lookup()
            let int = l.get_int_type()

            let inner = l.get_function_type(LIST[Type]([int, int]))
            let function = l.get_function_type(LIST[Type]([inner, int]))

            are_equal("(Int -> Int) -> Int", function.short_description)
        si

        @Test()
        Reading__short_description__of_an_action_taking_one_tuple__should_parenthesise_the_tuple() is
            let l = lookup()
            let int = l.get_int_type()

            let action = ACTION(loc(), owner("Action", LIST[string](["T"])), LIST[Type]([tuple_of(int, int)]))

            are_equal("((Int, Int)) -> void", action.short_description)
        si
        @Test()
        Reading__short_description__of_a_function_taking_one_array__should_not_parenthesise_the_array() is
            let l = lookup()
            let int = l.get_int_type()

            let array = Semantic.Types.ARRAY(loc(), owner("Array", LIST[string](["T"])), [int])
            let function = l.get_function_type(LIST[Type]([array, int]))

            are_equal("ARRAY[Int] -> Int", function.short_description)
        si

        @Test()
        Reading__short_description__of_a_function_returning_a_pure_function__should_parenthesise_the_returned_function() is
            let l = lookup()
            let int = l.get_int_type()

            let inner = PURE_FUNCTION(loc(), owner("Func", LIST[string](["T", "TResult"])), LIST[Type]([int, int]))
            let function = PURE_FUNCTION(loc(), owner("Func", LIST[string](["T", "TResult"])), LIST[Type]([int, inner]))

            are_equal("Int -> (Int -> Int pure) pure", function.short_description)
        si

        @Test()
        Reading__short_description__of_a_function_returning_an_impure_function__should_leave_it_bare() is
            let l = lookup()
            let int = l.get_int_type()

            let inner = l.get_function_type(LIST[Type]([int, int]))
            let function = l.get_function_type(LIST[Type]([int, inner]))

            are_equal("Int -> Int -> Int", function.short_description)
        si

        @Test()
        Reading__short_description__of_a_tuple_with_a_positional_name__should_leave_that_element_bare() is
            let l = lookup()
            let int = l.get_int_type()

            let names = LIST[string?]()

            names.add("count")
            names.add("1")

            let tuple = TUPLE(loc(), owner("ValueTuple", LIST[string](["T1", "T2"])), LIST[Type]([int, int]), names)

            are_equal("(count: Int, Int)", tuple.short_description)
        si
        @Test()
        Reading__short_description__of_an_optional_function__should_parenthesise_the_shape_before_the_question_mark() is
            let l = lookup()
            let int = l.get_int_type()

            let function = l.get_function_type(LIST[Type]([int])).as_optional()

            are_equal("(() -> Int)?", function.short_description)
        si

        @Test()
        Reading__short_description__of_an_array_of_functions__should_bracket_the_element() is
            let l = lookup()
            let int = l.get_int_type()

            let element = l.get_function_type(LIST[Type]([int, int]))
            let array = Semantic.Types.ARRAY(loc(), owner("Array", LIST[string](["T"])), [element])

            are_equal("ARRAY[Int -> Int]", array.short_description)
        si

        @Test()
        Reading__short_description__of_a_tuple_with_a_keyword_element_name__should_escape_the_name() is
            let l = lookup()
            let int = l.get_int_type()

            let names = LIST[string?]()

            names.add("namespace")
            names.add("count")

            let tuple = TUPLE(loc(), owner("ValueTuple", LIST[string](["T1", "T2"])), LIST[Type]([int, int]), names)

            are_equal("(`namespace: Int, count: Int)", tuple.short_description)
        si
    si
si
