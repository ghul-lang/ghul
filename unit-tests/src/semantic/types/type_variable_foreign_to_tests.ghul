namespace Semantic.Types.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Types.GENERIC
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Type.has_type_variable_foreign_to answers whether a type names a
    // type parameter - a function's or a class's - that is neither the
    // owner's nor in scope from it, such as a callee's own parameter
    // before it is bound.
    @TestClass()
    class TYPE_VARIABLE_FOREIGN_TO_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        make_owner(name: string) -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())

        @Test()
        a_class_parameter_of_another_class_is_foreign() is
            let declaring = make_owner("ARRAY")
            let compiling = make_owner("compiling")
            let e = CLASSY_GENERIC_ARGUMENT(loc(), declaring, "E", 0)

            is_true(e.type!.has_type_variable_foreign_to(compiling))
        si

        @Test()
        a_class_parameter_nested_in_a_generic_is_foreign() is
            let declaring = make_owner("ARRAY")
            let compiling = make_owner("compiling")
            let e = CLASSY_GENERIC_ARGUMENT(loc(), declaring, "E", 0)
            let iterable = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Iterable", ["T"], Semantic.BLOCK_SCOPE())
            let e_iterable = GENERIC(loc(), iterable, LIST[Type]([e.type!]))

            is_true(e_iterable.has_type_variable_foreign_to(compiling))
        si

        @Test()
        a_parameter_of_the_owner_is_not_foreign() is
            let declaring = make_owner("ARRAY")
            let e = CLASSY_GENERIC_ARGUMENT(loc(), declaring, "E", 0)

            is_false(e.type!.has_type_variable_foreign_to(declaring))
        si

        @Test()
        a_parameter_in_scope_from_an_enclosing_scope_is_not_foreign() is
            let enclosing = make_owner("enclosing")
            let nested = make_owner("nested")
            nested.enclosing_scope = enclosing

            let t = FUNCTION_GENERIC_ARGUMENT(loc(), enclosing, "T", 0)
            enclosing.add_member(t)

            is_false(t.type!.has_type_variable_foreign_to(nested))
        si

        @Test()
        a_type_with_no_type_parameter_is_never_foreign() is
            let compiling = make_owner("compiling")

            is_false(make_owner("animal").type!.has_type_variable_foreign_to(compiling))
        si
    si
si
