namespace Semantic.UnitTests is
    use Collections.Iterable
    use Collections.LIST
    use Ghul.Pipes

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.Types.Type

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.STATIC_CONSTRUCTOR
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.FUNCTION_GROUP
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class OVERLOAD_RESOLVER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]()
            for v in values do result.add(v); od
            return result
        si

        // Regression: OVERLOAD_RESOLVER._resolve must tolerate a null actual
        // argument type. In analysis mode an expression's type can still be
        // unresolved when overload resolution runs (e.g. resolving `==` on the
        // result of calling a function destructured from a tuple whose element
        // type was inferred), so a null reaches the actual-argument list even
        // though its element type is not declared optional. Resolution used to
        // dereference the null; resolve() caught the resulting exception, logged
        // it and returned null.
        @Test()
        Resolving_a_group_with_a_null_actual_argument_type_should_not_throw() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let t = CLASSY_GENERIC_ARGUMENT(loc(), owner, "T", 0)

            let foo = INSTANCE_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE())
            let foo_arguments = LIST[Type]()
            foo_arguments.add(t.type!)
            foo.arguments = foo_arguments

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "foo")
            group.add(foo)

            // A single null actual argument type — the analysis-mode reality
            // the strict-optional List[Type] element type does not express.
            let arguments = LIST[Type]()
            arguments.add(cast Type(null))

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            resolver.resolve(loc(), group, arguments, false, true, false)

            // resolve() swallows any exception from _resolve into a null result
            // plus a logged EXCEPTION diagnostic; a clean run logs nothing.
            are_equal(
                0,
                logger.error_count,
                "overload resolution logged a diagnostic — the null actual argument type was not tolerated"
            )
        si

        // A call that fits no candidate by argument count is reported
        // with the candidates that take that count. One declaring an
        // argument pack is listed whatever count it takes, since the call
        // may have been written with the pack spread out.
        @Test()
        Reporting_no_overload_lists_a_pack_declaring_candidate_of_another_arity() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let int_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", names_for([]), Semantic.BLOCK_SCOPE()).type!

            let plain = INSTANCE_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE())
            plain.arguments = LIST[Type]([int_type, int_type, int_type])
            plain.argument_names = names_for(["a", "b", "c"])

            let packed = INSTANCE_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE())
            let pack = CLASSY_GENERIC_ARGUMENT(loc(), packed, "T", 0)
            pack.set_is_argument_pack(true)
            packed.generic_argument_names = names_for(["T"])
            packed.generic_arguments = LIST[Type]([pack.type!])
            packed.arguments = LIST[Type]([pack.type!])
            packed.argument_names = names_for(["v"])

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "foo")
            group.add(plain)
            group.add(packed)

            let string_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "string", names_for([]), Semantic.BLOCK_SCOPE()).type!

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            resolver.resolve(loc(), group, LIST[Type]([string_type, string_type]), false, true, false)

            let message = logger.diagnostics_for("test.ghul") |> map(d => d.text) |> join(" | ")

            is_true(message.contains("tried"), "expected a candidate list, got: {message}")
            is_true(message.contains("foo[T..](v: T)"), "expected the pack-declaring candidate listed, got: {message}")
            is_false(message.contains("a: int"), "expected the three-parameter candidate left out, got: {message}")
        si

        // A static constructor shares the `init` group with the instance
        // constructors but is invoked by the CLR, never resolved. When
        // both a parameterless instance `init` and a static `init` are
        // present, construction must pick the instance one.
        @Test()
        Constructing_excludes_the_static_constructor_from_the_init_group() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE())

            let instance_init = INSTANCE_METHOD(loc(), loc(), owner, "init", Semantic.BLOCK_SCOPE())
            let static_init = STATIC_CONSTRUCTOR(loc(), loc(), owner, "init", Semantic.BLOCK_SCOPE())

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "init")
            group.add(instance_init)
            group.add(static_init)

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, LIST[Type](), false, true, true)

            assert result? else "construction found no init overload"
            is_false(result.function.is_static_constructor, "construction resolved to the static constructor")
        si

        @Test()
        Only_a_static_constructor_leaves_no_constructor_to_resolve() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE())

            let static_init = STATIC_CONSTRUCTOR(loc(), loc(), owner, "init", Semantic.BLOCK_SCOPE())

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "init")
            group.add(static_init)

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, LIST[Type](), false, true, true)

            is_null(result)
        si

        // The per-argument match scores are summed for candidate
        // ranking, so several coerced arguments can land on the same
        // value as the MATCH.PARTIAL constant (three ASSIGNABLE
        // arguments: 1+1+1 = 3). That collision must not read as the
        // retry marker: needs_retry requests an argument re-walk,
        // which is only useful when resolution ran on incomplete
        // information.
        @Test()
        Coercion_scores_summing_to_partial_do_not_set_needs_retry() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE())
            let base = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Base", LIST[string](), Semantic.BLOCK_SCOPE())
            let derived = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Derived", LIST[string](), Semantic.BLOCK_SCOPE())

            derived.add_ancestor(base.type!)

            let foo = INSTANCE_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE())
            let foo_arguments = LIST[Type]()
            foo_arguments.add(base.type!)
            foo_arguments.add(base.type!)
            foo_arguments.add(base.type!)
            foo.arguments = foo_arguments

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "foo")
            group.add(foo)

            let arguments = LIST[Type]()
            arguments.add(derived.type!)
            arguments.add(derived.type!)
            arguments.add(derived.type!)

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, arguments, false, true, false)

            assert result? else "no overload resolved"
            are_equal(cast int(Semantic.Types.MATCH.PARTIAL), cast int(result.score), "three ASSIGNABLE arguments should sum to the PARTIAL constant - the collision this test pins")
            is_false(result.needs_retry, "a coercion-score sum must not request an argument re-walk")
        si

        // A function-literal actual with implicit parameter types
        // matches through its inference placeholder rather than its
        // real signature, so the result must request the
        // constraint-push argument re-walk.
        @Test()
        A_function_actual_with_implicit_argument_types_sets_needs_retry() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE())
            let a = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "A", LIST[string](), Semantic.BLOCK_SCOPE())
            let b = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "B", LIST[string](), Semantic.BLOCK_SCOPE())
            let fn_symbol = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Fn", names_for(["T", "U"]), Semantic.BLOCK_SCOPE())

            let formal_arguments = LIST[Type]()
            formal_arguments.add(a.type!)
            formal_arguments.add(b.type!)

            let actual_arguments = LIST[Type]()
            actual_arguments.add(Semantic.Types.INFERRED_RETURN_TYPE())
            actual_arguments.add(b.type!)

            let foo = INSTANCE_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE())
            let foo_arguments = LIST[Type]()
            foo_arguments.add(Semantic.Types.FUNCTION(loc(), fn_symbol, formal_arguments))
            foo.arguments = foo_arguments

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "foo")
            group.add(foo)

            let arguments = LIST[Type]()
            arguments.add(Semantic.Types.FUNCTION(loc(), fn_symbol, actual_arguments))

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, arguments, false, true, false)

            assert result? else "no overload resolved"
            is_true(result.needs_retry, "a function actual with an implicit argument type should request an argument re-walk")
        si

        // A global function's owner is a namespace, not a Classy.
        // Owner generic-argument binding is attempted for every
        // matching-arity candidate regardless of instance / static /
        // generic, so resolution must tolerate a non-Classy owner
        // rather than force-casting it.
        @Test()
        Resolving_a_global_function_candidate_should_not_throw() is
            let a = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "A", LIST[string](), Semantic.BLOCK_SCOPE())

            let foo = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "foo", Semantic.BLOCK_SCOPE())
            let foo_arguments = LIST[Type]()
            foo_arguments.add(a.type!)
            foo.arguments = foo_arguments

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "foo")
            group.add(foo)

            let arguments = LIST[Type]()
            arguments.add(a.type!)

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, arguments, false, false, false)

            are_equal(
                0,
                logger.error_count,
                "overload resolution logged a diagnostic — a global function candidate's non-Classy owner was not tolerated"
            )
            is_true(result?, "no overload resolved")
        si

        // Two concrete candidates whose only difference from each
        // other is which formal is `object` — every actual formal
        // compares ASSIGNABLE against an unresolved placeholder
        // actual, so the tie is real, and the object-excluding
        // tie-break would otherwise pick the non-`object` candidate
        // on no information at all.
        two_candidates_tied_on_a_placeholder_actual() -> (group: FUNCTION_GROUP, arguments: LIST[Type]) is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE())
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", LIST[string](), Semantic.BLOCK_SCOPE())
            object_class.mark_is_object()
            let other = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Other", LIST[string](), Semantic.BLOCK_SCOPE())

            let takes_object = INSTANCE_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE())
            let takes_object_arguments = LIST[Type]()
            takes_object_arguments.add(object_class.type!)
            takes_object.arguments = takes_object_arguments

            let takes_other = INSTANCE_METHOD(loc(), loc(), owner, "foo", Semantic.BLOCK_SCOPE())
            let takes_other_arguments = LIST[Type]()
            takes_other_arguments.add(other.type!)
            takes_other.arguments = takes_other_arguments

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "foo")
            group.add(takes_object)
            group.add(takes_other)

            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "x")
            let arguments = LIST[Type]()
            arguments.add(cast Type(INFERRED_VARIABLE_TYPE(origin)))

            return (group = group, arguments = arguments)
        si

        @Test()
        A_tie_from_a_placeholder_actual_declines_silently_when_not_inferring() is
            let (group, arguments) = two_candidates_tied_on_a_placeholder_actual()

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, arguments, false, true, false)

            is_null(result, "an uninformative tie should decline rather than pick a candidate")
            are_equal(0, logger.error_count, "declining an uninformative tie should log nothing")
        si

        // An inferring caller keeps the pre-existing tie-break instead:
        // resolving still picks the non-`object` candidate on the same
        // uninformative tie, and logs nothing while doing it.
        @Test()
        A_tie_from_a_placeholder_actual_still_picks_a_candidate_when_inferring() is
            let (group, arguments) = two_candidates_tied_on_a_placeholder_actual()

            let logger = DIAGNOSTICS_STORE()
            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, arguments, true, true, false)

            assert result? else "an inferring caller should still resolve the tie"
            are_equal(0, logger.error_count, "picking the tie-break candidate should log nothing")
        si

        // A constructor the runtime supplies for a type with no type
        // parameters, such as string's from a sequence, has type parameters
        // of its own, and constructing binds them from the arguments.
        @Test()
        Constructing_binds_a_generic_constructors_own_type_parameter_from_its_argument() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", LIST[string](), Semantic.BLOCK_SCOPE())
            let int_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE())

            let generic_init = INSTANCE_METHOD(loc(), loc(), owner, "init", Semantic.BLOCK_SCOPE())
            let t = Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT(loc(), generic_init, "T", 0)

            generic_init.is_generic = true
            generic_init.generic_argument_names = names_for(["T"])
            generic_init.generic_arguments = LIST[Type]([t.type!])
            generic_init.arguments = LIST[Type]([t.type!])
            generic_init.argument_names = names_for(["value"])
            generic_init.return_type = int_class.type!

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "init")
            group.add(generic_init)

            let logger = DIAGNOSTICS_STORE()

            IoC.CONTAINER.instance.symbol_table = Semantic.SYMBOL_TABLE(logger)

            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, LIST[Type]([int_class.type!]), false, true, true)

            assert result? else "construction found no init overload"
            are_same(int_class.type!, result.function.arguments[0])
            are_same(int_class.type!, result.function.generic_arguments[0])
        si

        // A no-argument generic whose only mention of its type
        // parameter is the return type: nothing in the call can bind it,
        // so the type the call site expects is the only source.
        make_group(name: string) -> (group: FUNCTION_GROUP, t: Type) is
            let make = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())
            let t = Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT(loc(), make, "T", 0)

            make.is_generic = true
            make.generic_arguments = LIST[Type]([t.type!])
            make.arguments = LIST[Type]()
            make.return_type = t.type!

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), name)
            group.add(make)

            return (group = group, t = t.type!)
        si

        @Test()
        Resolving_a_no_argument_generic_against_a_return_constraint_should_bind_its_type_parameter() is
            let (group, t) = make_group("make")
            let int_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE())

            let logger = DIAGNOSTICS_STORE()

            IoC.CONTAINER.instance.symbol_table = Semantic.SYMBOL_TABLE(logger)

            let resolver = OVERLOAD_RESOLVER(logger)

            let result = resolver.resolve(loc(), group, LIST[Type](), true, false, false, null, int_class.type!)

            assert result? else "the single candidate should resolve"
            are_same(int_class.type!, result.function.return_type)
        si

        // Without one there is nothing to bind it from, and the
        // candidate keeps its own type parameter rather than guessing.
        @Test()
        Resolving_a_no_argument_generic_with_no_return_constraint_should_leave_its_type_parameter() is
            let (group, t) = make_group("make")

            let resolver = OVERLOAD_RESOLVER(DIAGNOSTICS_STORE())

            let result = resolver.resolve(loc(), group, LIST[Type](), true, false, false)

            assert result? else "the single candidate should resolve"
            are_same(t, result.function.return_type)
        si

        // A global over `A?` - the shape a null-safe comparison resolves
        // to - chosen for a placeholder actual, returning the origin the
        // placeholder reports to.
        resolve_optional_formal_for_placeholder(name: string) -> INFERRED_TYPE_ARG_ORIGIN is
            let a = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "A", LIST[string](), Semantic.BLOCK_SCOPE())
            let optional_a = a.type!.as_optional()

            let function = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())
            function.arguments = LIST[Type]([optional_a, optional_a])

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), name)
            group.add(function)

            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "v")

            let arguments = LIST[Type]([cast Type(INFERRED_VARIABLE_TYPE(origin)), a.type!])

            let resolver = OVERLOAD_RESOLVER(DIAGNOSTICS_STORE())

            is_true(resolver.resolve(loc(), group, arguments, true, false, false)?, "the single candidate should resolve")

            return origin
        si

        // `=~` resolves over `T?` exactly when it resolves over `T`, so
        // its optional formals are no evidence the operand is optional.
        @Test()
        Choosing_an_equality_operator_for_a_placeholder_actual__should_record_no_bound() is
            let origin = resolve_optional_formal_for_placeholder("=~")

            is_null(origin.try_get_inferred_type())
        si

        // Any other function's optional formal bounds the placeholder.
        @Test()
        Choosing_another_function_for_a_placeholder_actual__should_bound_it_by_the_formal() is
            let origin = resolve_optional_formal_for_placeholder("equal")

            let inferred = origin.try_get_inferred_type()

            is_true(inferred?)
            is_true(inferred!.is_optional)
        si

        // `NODE(value)` written inside `NODE[T]`, with `value: T`: the
        // constructor's formal and the actual are the same type variable,
        // so they compare as an exact match rather than as wild. The
        // class's type arguments are still bound from it, so the call
        // constructs `NODE[T]` rather than choosing the open class's
        // constructor with nothing to pin its type argument.
        @Test()
        Constructing_from_the_class_own_type_parameter_binds_the_type_argument() is
            let node = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "NODE", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let t = node.type_parameter_at(0)!.type!

            let init = INSTANCE_METHOD(loc(), loc(), node, "init", Semantic.BLOCK_SCOPE())
            let init_arguments = LIST[Type]()
            init_arguments.add(t)
            init.arguments = init_arguments
            init.return_type = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "RESULT", LIST[string](), Semantic.BLOCK_SCOPE()).type!

            node.add_member(init)
            node.mark_overrides_resolved()

            let group = FUNCTION_GROUP(loc(), Semantic.BLOCK_SCOPE(), "init")
            group.add(init)

            let arguments = LIST[Type]()
            arguments.add(t)

            let resolver = OVERLOAD_RESOLVER(DIAGNOSTICS_STORE())

            let result = resolver.resolve(loc(), group, arguments, false, true, true)

            assert result? else "construction found no init overload"

            let owner = cast Semantic.Symbols.GENERIC?(result.function.owner)

            assert owner? else "construction chose the open class's constructor"

            are_equal(1, owner.arguments.count)
            is_true(owner.arguments[0].matches(t), "construction is not of NODE[T]")
        si
    si
si
