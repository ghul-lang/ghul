namespace Semantic.UnitTests is
    use Collections.Iterable
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Ghul.Pipes

    use Semantic.CLOSURE_ARG_RESOLVER

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.Closure
    use Semantic.Symbols.Symbol

    use Semantic.Types.GENERIC
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for CLOSURE_ARG_RESOLVER — extracted from
    // compile_expressions._visit(function) to focus the closure
    // arg-resolution loop and its in-scope-typevar guard.
    //
    // The branches `resolve()` itself selects between (symbol-
    // already-typed, written-type-expression, implied-usable,
    // inference-fallback) are exercised end-to-end by integration
    // tests under `integration-tests/execution/`. This unit fixture
    // pins the load-bearing predicate underneath:
    // `_is_implied_type_usable` / `_is_type_variable_in_scope`.
    // Those gate whether an implied type from the outer context
    // can be installed as-is or must fall through to iterative
    // inference, and the in-scope-vs-foreign distinction is the
    // reason `expect_func_T_U(null, s => s + 1)` infers s = int
    // from the body while `compose[T,U,V](f, g) => x => g(f(x))`
    // accepts T as the lambda's arg type.
    @TestClass()
    class CLOSURE_ARG_RESOLVER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]()
            for v in values do result.add(v); od
            return result
        si

        types(values: Iterable[Type]) -> LIST[Type] is
            let result = LIST[Type]()
            for v in values do result.add(v); od
            return result
        si

        int_type() -> Type is
            let int_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE())
            return int_class.type!
        si

        // Build a CLASS named `host` with one type-arg `T` registered
        // in its scope via `declare`. The Closure under test will use
        // this class as its enclosing scope, so `find_enclosing("T")`
        // walks closure → host (find_direct) → returns this `t`.
        build_host_with_T() -> (host: CLASS, t: CLASSY_GENERIC_ARGUMENT) is
            let host = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Host", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let t = CLASSY_GENERIC_ARGUMENT(loc(), host, "T", 0)
            host.declare(loc(), t, null)
            return (host, t)
        si

        // Construct a Closure whose `enclosing_scope` is the host.
        // Mimics the AST shape `class Host[T] is foo() => (x => x); si`
        // — the lambda visited by _visit(function: FUNCTION) has a
        // chain back to the surrounding generic class.
        closure_in(host: CLASS) -> Closure is
            return Semantic.Symbols.STATIC_CLOSURE(loc(), host, "$anon_0", host, false)
        si

        // A foreign type-variable: same name "T" but owned by a
        // DIFFERENT class. Models the overload-resolution case where
        // a constraint carries the candidate's own type-vars; the
        // closure's enclosing scope doesn't know about them.
        build_foreign_T() -> CLASSY_GENERIC_ARGUMENT is
            let other_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OtherClass", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let foreign_t = CLASSY_GENERIC_ARGUMENT(loc(), other_class, "T", 0)
            other_class.declare(loc(), foreign_t, null)
            return foreign_t
        si

        // === destructured parameter over a placeholder aggregate ===

        // A destructured parameter nothing has typed yet: the aggregate is
        // a placeholder, so the destructure records an obligation on it
        // rather than reporting, and the leaves are defined for the body.
        @Test()
        Calling__resolve__with_a_destructured_parameter_of_placeholder_type__records_an_obligation_and_defines_the_leaves() is
            if !IoC.CONTAINER.instance.local_id_generator? then
                IoC.CONTAINER.instance.local_id_generator = IR.LOCAL_ID_GENERATOR()
            fi

            IoC.CONTAINER.instance.local_id_generator.enter_function()

            let logger = DIAGNOSTICS_STORE()
            IoC.CONTAINER.instance.logger = logger

            let (host, _) = build_host_with_T()
            let closure = closure_in(host)

            closure.declare_variable(loc(), "$arg_0", false, null)
            closure.declare_variable(loc(), "a", false, null)
            closure.declare_variable(loc(), "b", false, null)

            let argument =
                Syntax.Trees.Expressions.VARIABLE(
                    loc(),
                    Syntax.Trees.Identifiers.Identifier(loc(), "$arg_0"),
                    Syntax.Trees.TypeExpressions.INFER(loc()),
                    null
                )

            argument.set_left(
                Syntax.Trees.Variables.DESTRUCTURING_VARIABLE_LEFT(
                    loc(),
                    LIST[Syntax.Trees.Variables.VariableLeft]([
                        Syntax.Trees.Variables.SIMPLE_VARIABLE_LEFT(loc(), Syntax.Trees.Identifiers.Identifier(loc(), "a")),
                        Syntax.Trees.Variables.SIMPLE_VARIABLE_LEFT(loc(), Syntax.Trees.Identifiers.Identifier(loc(), "b"))
                    ])
                )
            )

            Semantic.OBLIGATIONS.begin_body()

            let resolved = CLOSURE_ARG_RESOLVER(logger).resolve(LIST[Syntax.Trees.Expressions.Expression]([argument]), closure, null)

            is_true(resolved)
            is_false(logger.any_errors)
            is_true(Semantic.OBLIGATIONS.standing |> any(o => o.rule =~ "destructure"))

            let a = cast Semantic.Symbols.Variable?(closure.find_direct("a"))

            is_true(a? /\ a.is_defined)

            Semantic.OBLIGATIONS.end_body()
        si

        // A parameter whose inferred type is settled takes it and owes
        // nothing; one whose inferred type still holds a part to be
        // inferred takes it but keeps its obligation standing, so the
        // fixing step can report the parameter if nothing settles it.
        _resolve_parameter_bounded_by(bound: Type) -> (type: Type, owes: bool) is
            let (host, _) = build_host_with_T()
            let closure = closure_in(host)

            let symbol = cast Semantic.Symbols.Variable(closure.declare_variable(loc(), "pick", false, null))

            symbol.add_lower_bound(bound)

            let argument =
                Syntax.Trees.Expressions.VARIABLE(
                    loc(),
                    Syntax.Trees.Identifiers.Identifier(loc(), "pick"),
                    Syntax.Trees.TypeExpressions.INFER(loc()),
                    null
                )

            Semantic.OBLIGATIONS.begin_body()

            let type = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())._resolve_from_inference_or_placeholder(argument, symbol)
            let owes = Semantic.OBLIGATIONS.standing |> any(o => o.rule =~ "parameter")

            Semantic.OBLIGATIONS.end_body()

            return (type, owes)
        si

        @Test()
        Calling__resolve_from_inference_or_placeholder__with_a_settled_bound__takes_it_and_owes_nothing() is
            let int = int_type()
            let (type, owes) = _resolve_parameter_bounded_by(int)

            are_same(int, type)
            is_false(owes)
        si

        @Test()
        Calling__resolve_from_inference_or_placeholder__with_an_unsettled_bound__keeps_its_obligation() is
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "BOX", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let unsettled = GENERIC(loc(), box, types([Semantic.Types.INFERRED_RETURN_TYPE()]))

            is_false(unsettled.is_settled)

            let (_, owes) = _resolve_parameter_bounded_by(unsettled)

            is_true(owes)
        si

        // === _is_type_variable_in_scope ===

        // Null type-variable / null closure are noops returning false.
        // The lambda-arg-resolution path passes a closure that is
        // always non-null, but the helper guards anyway so the
        // contract is total.
        @Test()
        Calling__is_type_variable_in_scope__with_null_type_variable__returns_false() is
            let h = build_host_with_T()
            let closure = closure_in(h.host)
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            is_false(resolver._is_type_variable_in_scope(null, closure))
        si

        @Test()
        Calling__is_type_variable_in_scope__with_null_closure__returns_false() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            is_false(resolver._is_type_variable_in_scope(t, null))
        si

        // In-scope: the type-variable's name resolves to the SAME
        // symbol via the closure's enclosing-scope chain. This is
        // the compose / box-factory case — the outer formal carries
        // its own type variable as the lambda arg's type.
        @Test()
        Calling__is_type_variable_in_scope__with_enclosing_class_T__returns_true() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            is_true(resolver._is_type_variable_in_scope(t, closure))
        si

        // Foreign: same NAME "T" but a different symbol. find_
        // enclosing returns null (or a different-named symbol),
        // so the helper rejects. This is the overload-resolution-
        // constraint case where the candidate's type-vars leaked
        // into the implied type.
        @Test()
        Calling__is_type_variable_in_scope__with_foreign_T__returns_false() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let foreign_t = build_foreign_T()
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            is_false(resolver._is_type_variable_in_scope(foreign_t, closure))
        si

        // === _is_implied_type_usable ===

        // Concrete types always usable — there's nothing to scope-
        // check. This is the canonical "Func[int,bool] formal pushes
        // int onto lambda arg" case.
        @Test()
        Calling__is_implied_type_usable__with_concrete_type__returns_true() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            is_true(resolver._is_implied_type_usable(int_type(), closure))
        si

        // An in-scope type-variable is usable. The implied type IS
        // a type variable, and it's declared by an ancestor of the
        // closure. Installing it on the symbol lets IL emission
        // generate the corresponding `!!N` slot.
        @Test()
        Calling__is_implied_type_usable__with_in_scope_type_variable__returns_true() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            is_true(resolver._is_implied_type_usable(t.type!, closure))
        si

        // A foreign type-variable is rejected — the resolver falls
        // through to the iterative-inference path. Without this
        // rejection, expect_func_T_U(null, s => s + 1) would lock
        // `s` to the candidate's foreign T instead of inferring
        // int from the body.
        @Test()
        Calling__is_implied_type_usable__with_foreign_type_variable__returns_false() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let foreign_t = build_foreign_T()
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            is_false(resolver._is_implied_type_usable(foreign_t.type!, closure))
        si

        // The walk recurses into generic type-arguments — a generic
        // containing only in-scope type-vars is usable.
        @Test()
        Calling__is_implied_type_usable__with_generic_of_in_scope_T__returns_true() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            // Construct LIST[T] using the host's T as the arg. Any
            // generic owner shape works for the walk.
            let list_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "List", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let list_of_t = cast Type(GENERIC(loc(), list_class, types([t.type!])))

            is_true(resolver._is_implied_type_usable(list_of_t, closure))
        si

        // The walk recurses into generic type-arguments — a generic
        // containing a foreign type-var is rejected. Without the
        // recursion, only direct type-variable-typed args would be
        // gated; an implied type like `Func[ForeignT, bool]` would
        // slip through.
        @Test()
        Calling__is_implied_type_usable__with_generic_of_foreign_T__returns_false() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let foreign_t = build_foreign_T()
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            let list_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "List", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let list_of_foreign = cast Type(GENERIC(loc(), list_class, types([foreign_t.type!])))

            is_false(resolver._is_implied_type_usable(list_of_foreign, closure))
        si

        // === resolve() ===

        // A plain (non-destructured) parameter is marked defined as soon
        // as `resolve()` sees it, whatever its type turns out to be.
        // Without this, `is_defined` stays false for the rest of the
        // parameter's life, and a reference to it from within its own
        // body reads as the self-referencing-`let`-initializer case to
        // `COMPILE_ACCESS._try_find_shadowed_callable` — which then
        // spuriously falls back past the parameter to any identically-
        // named callable in an enclosing scope.
        @Test()
        Calling__resolve__with_a_plain_parameter__marks_it_defined() is
            let h = build_host_with_T()
            let host = h.host
            let closure = closure_in(host)
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            let name = Syntax.Trees.Identifiers.Identifier(loc(), "x")
            let argument = Symbols.LOCAL_ARGUMENT(loc(), closure, "x")
            closure.declare(loc(), argument, null)

            let node = Syntax.Trees.Expressions.VARIABLE(loc(), name, Syntax.Trees.TypeExpressions.INFER(loc()), null)
            let arguments = LIST[Syntax.Trees.Expressions.Expression]([cast Syntax.Trees.Expressions.Expression(node)])

            resolver.resolve(arguments, closure, null)

            is_true(argument.is_defined)
        si

        // A generic mixing in-scope and foreign type-vars is
        // rejected — the walk only needs to find ONE foreign T to
        // reject. Pinned because a regression that exited the walk
        // on first in-scope hit would let the foreign side through.
        @Test()
        Calling__is_implied_type_usable__with_generic_mixing_in_scope_and_foreign__returns_false() is
            let h = build_host_with_T()
            let host = h.host
            let t = h.t
            let closure = closure_in(host)
            let foreign_t = build_foreign_T()
            let resolver = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())

            // Func[T, ForeignT] — both type-vars present in arg slots.
            let func_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Func", names_for(["A", "B"]), Semantic.BLOCK_SCOPE())
            let mixed = cast Type(GENERIC(loc(), func_class, types([t.type!, foreign_t.type!])))

            is_false(resolver._is_implied_type_usable(mixed, closure))
        si

        // A parameter that settled from its first call's argument, and has
        // since taken a wider argument as another bound, is retyped to the
        // join of the two when it joins assignments; without that, it keeps
        // the type it settled to first.
        _resolve_settled_parameter_given_a_wider_bound(joins: bool) -> (type: Type, animal: Type) is
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", LIST[string](), Semantic.BLOCK_SCOPE())
            object_class.mark_is_object()
            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "animal", LIST[string](), Semantic.BLOCK_SCOPE())
            animal.add_ancestor(object_class.type!)
            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "cat", LIST[string](), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            let (host, _) = build_host_with_T()
            let closure = closure_in(host)

            let symbol = cast Semantic.Symbols.Variable(closure.declare_variable(loc(), "pet", false, null))

            symbol.add_lower_bound(cat.type!)
            symbol.add_lower_bound(animal.type!)
            symbol.set_type(cat.type!)
            symbol.joins_assignments = joins

            let argument =
                Syntax.Trees.Expressions.VARIABLE(
                    loc(),
                    Syntax.Trees.Identifiers.Identifier(loc(), "pet"),
                    Syntax.Trees.TypeExpressions.INFER(loc()),
                    null
                )

            let type = CLOSURE_ARG_RESOLVER(DIAGNOSTICS_STORE())._resolve_one(argument, argument, symbol, 0, null, false, closure)

            return (type, animal.type!)
        si

        @Test()
        Calling__resolve_one__on_a_settled_parameter_that_joins_assignments__takes_the_join_of_its_bounds() is
            let (type, animal) = _resolve_settled_parameter_given_a_wider_bound(true)

            is_true(type.is_equivalent_to(animal))
        si

        @Test()
        Calling__resolve_one__on_a_settled_parameter_that_does_not_join_assignments__keeps_its_type() is
            let (type, animal) = _resolve_settled_parameter_given_a_wider_bound(false)

            is_false(type.is_equivalent_to(animal))
        si
    si
si
