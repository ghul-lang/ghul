namespace Semantic.UnitTests is
    use Collections.LIST
    use Collections.List

    use Source.LOCATION

    use Semantic.AGREED_LITERAL_PARAMETERS
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.Function
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use Semantic.Types.MATCH
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The shape a function literal is typed against when candidates tie
    // only on what the literal returns: the parameters every candidate
    // gives it, with the result left to the literal's own body.
    @TestClass()
    class AGREED_LITERAL_PARAMETERS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        lookup() -> Lookups.InnateSymbolLookup => TEST_INNATE_SYMBOL_LOOKUP()

        a_type(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE()).type!

        a_wild_type() -> Type is
            let owner =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](["T"]), Semantic.BLOCK_SCOPE())

            return CLASSY_GENERIC_ARGUMENT(loc(), owner, "T", 0).type!
        si

        a_placeholder(name: string) -> Type =>
            INFERRED_VARIABLE_TYPE(INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), name))

        a_function_type(parameter: Type, result: Type) -> Type =>
            lookup().get_function_type(LIST[Type]([parameter, result]))

        // What an untyped literal `w => ...` is before it has been walked
        // against a formal: neither its parameter nor its result is known.
        a_literal() -> Type => a_function_type(a_placeholder("w"), a_placeholder("result"))

        a_candidate(formals: ARRAY[Type]) -> Function is
            let result = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), "total", Semantic.BLOCK_SCOPE())

            result.arguments = LIST[Type](formals)

            return result
        si

        candidates(functions: ARRAY[Function]) -> Function[] => LIST[Function](functions)

        actuals(types: ARRAY[Type]) -> Type[] => LIST[Type](types)

        @Test()
        given_candidates_agreeing_on_a_literal_parameter__shapes_the_literal_with_that_parameter() is
            let source = a_type("SOURCE")
            let word = a_type("WORD")

            let whole = a_candidate([source, a_function_type(word, a_type("INT"))])
            let real = a_candidate([source, a_function_type(word, a_type("DOUBLE"))])

            let shapes = AGREED_LITERAL_PARAMETERS.shapes(candidates([whole, real]), actuals([source, a_literal()]), lookup())

            assert shapes? else "the candidates agree on the literal's parameter"
            are_equal(2, shapes.count)
            is_null(shapes[0])

            let shape = shapes[1]

            assert shape? else "the literal argument has a shape"
            is_true(shape.is_function)
            are_equal(2, shape.arguments.count)
            are_equal(MATCH.SAME, shape.arguments[0].compare(word))
            is_true(shape.arguments[1].is_error)
        si

        @Test()
        given_candidates_disagreeing_on_a_literal_parameter__declines() is
            let source = a_type("SOURCE")
            let result = a_type("INT")

            let first = a_candidate([source, a_function_type(a_type("WORD"), result)])
            let second = a_candidate([source, a_function_type(a_type("NUMBER"), result)])

            is_null(AGREED_LITERAL_PARAMETERS.shapes(candidates([first, second]), actuals([source, a_literal()]), lookup()))
        si

        // Re-walking a literal whose result is already known types it no
        // differently, so the tie it is part of stands.
        @Test()
        given_a_literal_whose_result_is_known__declines() is
            let word = a_type("WORD")

            let whole = a_candidate([a_function_type(word, a_type("INT"))])
            let real = a_candidate([a_function_type(word, a_type("DOUBLE"))])

            let typed_result = a_function_type(a_placeholder("w"), a_type("INT"))

            is_null(AGREED_LITERAL_PARAMETERS.shapes(candidates([whole, real]), actuals([typed_result]), lookup()))
        si

        @Test()
        given_a_parameter_still_carrying_a_type_variable__declines() is
            let wild = a_wild_type()

            let whole = a_candidate([a_function_type(wild, a_type("INT"))])
            let real = a_candidate([a_function_type(wild, a_type("DOUBLE"))])

            is_null(AGREED_LITERAL_PARAMETERS.shapes(candidates([whole, real]), actuals([a_literal()]), lookup()))
        si

        @Test()
        given_no_literal_argument__declines() is
            let source = a_type("SOURCE")

            let first = a_candidate([source])
            let second = a_candidate([source])

            is_null(AGREED_LITERAL_PARAMETERS.shapes(candidates([first, second]), actuals([source]), lookup()))
        si

        @Test()
        given_a_formal_that_is_not_a_function__declines() is
            let word = a_type("WORD")

            let function = a_candidate([a_function_type(word, a_type("INT"))])
            let plain = a_candidate([a_type("OBJECT")])

            is_null(AGREED_LITERAL_PARAMETERS.shapes(candidates([function, plain]), actuals([a_literal()]), lookup()))
        si

        @Test()
        given_a_single_candidate__declines() is
            let only = a_candidate([a_function_type(a_type("WORD"), a_type("INT"))])

            is_null(AGREED_LITERAL_PARAMETERS.shapes(candidates([only]), actuals([a_literal()]), lookup()))
        si
    si
si
