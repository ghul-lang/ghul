namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A declared constructor keeps its ghūl name, and the CIL backend
    // names it `.ctor`. An imported method carries the name its assembly
    // gives it, which alone says whether it is a constructor: a .NET
    // method called Init is imported as `init` without being one.
    @TestClass()
    class CONSTRUCTOR_NAMING_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](), Semantic.BLOCK_SCOPE())

        method(name: string) -> INSTANCE_METHOD =>
            INSTANCE_METHOD(loc(), loc(), owner(), name, Semantic.BLOCK_SCOPE())

        @Test()
        a_declared_init__should_be_a_constructor_named_ctor_by_the_backend() is
            let constructor = method("init")

            is_true(constructor.is_constructor)
            is_null(constructor.il_name_override)
            are_equal(".ctor", IR.Emitter.SRM_FLAGS.method_name(constructor))
        si

        @Test()
        an_imported_constructor__should_be_a_constructor() is
            let constructor = method("init")

            constructor.il_name_override = ".ctor"

            is_true(constructor.is_constructor)
        si

        @Test()
        an_imported_method_named_init__should_not_be_a_constructor() is
            let imported = method("init")

            imported.il_name_override = "Init"

            is_false(imported.is_constructor)
            are_equal("Init", IR.Emitter.SRM_FLAGS.method_name(imported))
        si

        @Test()
        a_declared_method__should_keep_its_name() is
            let declared = method("frob")

            is_false(declared.is_constructor)
            are_equal("frob", IR.Emitter.SRM_FLAGS.method_name(declared))
        si
    si
si
