namespace Semantic.Symbols.UnitTests is
    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Types.Type

    // A type alias is transparent, so what it owns is the substitution
    // from its own type parameters to the arguments a use site supplies.
    // Everything else about it - that a name resolving to one expands to
    // its target - is the resolve-type-expressions pass's business.
    @TestClass()
    class TYPE_ALIAS_TESTS is
        _scope: Semantic.BLOCK_SCOPE

        init() is
            if !LOCATION.internal? then
                LOCATION.init_static()
            fi

            _scope = Semantic.BLOCK_SCOPE()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        make_alias(argument_names: string[]) -> TYPE_ALIAS is
            let result = TYPE_ALIAS(loc(), _scope, "Alias", _scope)

            for name in argument_names do
                result.declare_argument(loc(), name, null)
            od

            return result
        si

        make_class(name: string) -> Type is
            NAMED_TYPE(CLASS(loc(), loc(), _scope, name, System.Array.empty[string](), Semantic.BLOCK_SCOPE()))
        si

        NAMED_TYPE(symbol: Symbol) -> Type => Types.NAMED(symbol)

        @Test()
        Declaring_type_parameters__should_number_them_in_declaration_order() is
            let alias = make_alias(["A", "B"])

            are_equal(2, alias.argument_count)
            are_equal("A", alias.type_parameters[0].name)
            are_equal(0, alias.type_parameters[0].index)
            are_equal("B", alias.type_parameters[1].name)
            are_equal(1, alias.type_parameters[1].index)
        si

        @Test()
        A_declared_type_parameter__should_be_found_in_the_aliases_own_scope() is
            let alias = make_alias(["T"])

            is_true(alias.find_direct("T")?)
            is_false(alias.find_direct("U")?)
        si

        @Test()
        Building_an_argument_map__should_key_on_the_parameter_symbols() is
            let alias = make_alias(["A", "B"])

            let first = make_class("FIRST")
            let second = make_class("SECOND")

            let map = alias.argument_map(Collections.LIST[Type]([first, second]))

            are_same(first, map[alias.type_parameters[0]])
            are_same(second, map[alias.type_parameters[1]])
        si

        // A use site that supplies too few arguments is reported by the
        // pass, so the map is built from whatever did arrive rather than
        // throwing on the way to the diagnostic.
        @Test()
        Building_an_argument_map_from_too_few_arguments__should_map_the_supplied_ones() is
            let alias = make_alias(["A", "B"])

            let only = make_class("ONLY")

            let map = alias.argument_map(Collections.LIST[Type]([only]))

            are_same(only, map[alias.type_parameters[0]])
            is_false(map.contains_key(alias.type_parameters[1]))
        si

        @Test()
        Specializing_a_target_through_the_argument_map__should_substitute_the_parameters() is
            let alias = make_alias(["T"])

            let parameter_type = alias.type_parameters[0].type!
            let argument = make_class("ARGUMENT")

            let substituted = parameter_type.specialize(alias.argument_map(Collections.LIST[Type]([argument])))

            are_same(argument, substituted)
        si
    si
si
