namespace Semantic.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Semantic.METHOD_OVERRIDE_CLASS

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins METHOD_OVERRIDE_CLASS.function_results_differing_from: the
    // positions at which two argument lists differ only in what a function
    // argument returns, which a call can then push as parameters alone. An
    // empty set means the lists are alike; null means they differ in
    // something more, which a push can't paper over.
    @TestClass()
    class METHOD_OVERRIDE_CLASS_FUNCTION_RESULTS_TESTS is
        init() is si

        loc() -> Source.LOCATION => Source.LOCATION("test.ghul", 1, 1, 1, 1)

        lookup() -> TEST_INNATE_SYMBOL_LOOKUP => TEST_INNATE_SYMBOL_LOOKUP()

        override_class(arguments: ARRAY[Type]) -> METHOD_OVERRIDE_CLASS =>
            METHOD_OVERRIDE_CLASS(LIST[Type](arguments))

        @Test()
        Formals_differing_only_in_a_function_result_name_that_position() is
            let l = lookup()
            let int_type = l.get_int_type()
            let first = override_class([int_type, l.get_function_type(LIST[Type]([int_type, int_type]))])
            let second = override_class([int_type, l.get_function_type(LIST[Type]([int_type, l.get_string_type()]))])

            let differing = first.function_results_differing_from(second)

            is_true(differing?)
            are_equal(1, differing!.count)
            is_true(differing.contains(1))
        si

        @Test()
        Alike_formals_have_no_differing_positions() is
            let l = lookup()
            let int_type = l.get_int_type()
            let shape = l.get_function_type(LIST[Type]([int_type, int_type]))

            let differing = override_class([shape]).function_results_differing_from(override_class([shape]))

            is_true(differing?)
            are_equal(0, differing!.count)
        si

        @Test()
        Function_formals_taking_different_parameters_differ_in_more_than_their_result() is
            let l = lookup()
            let int_type = l.get_int_type()
            let first = override_class([l.get_function_type(LIST[Type]([int_type, int_type]))])
            let second = override_class([l.get_function_type(LIST[Type]([l.get_string_type(), int_type]))])

            is_null(first.function_results_differing_from(second))
        si

        @Test()
        Function_formals_taking_different_numbers_of_parameters_differ_in_more_than_their_result() is
            let l = lookup()
            let int_type = l.get_int_type()
            let first = override_class([l.get_function_type(LIST[Type]([int_type, int_type]))])
            let second = override_class([l.get_function_type(LIST[Type]([int_type, int_type, int_type]))])

            is_null(first.function_results_differing_from(second))
        si

        // A pure function and an impure one are different shapes whatever
        // they return.
        @Test()
        A_pure_and_an_impure_function_formal_differ_in_more_than_their_result() is
            let l = lookup()
            let int_type = l.get_int_type()
            let first = override_class([l.get_function_type(LIST[Type]([int_type, int_type]), true)])
            let second = override_class([l.get_function_type(LIST[Type]([int_type, l.get_string_type()]), false)])

            is_null(first.function_results_differing_from(second))
        si

        // An action has no result to leave open, so one beside a function
        // of the same parameters is a difference a push can't cover.
        @Test()
        An_action_formal_beside_a_function_formal_differs_in_more_than_its_result() is
            let l = lookup()
            let int_type = l.get_int_type()
            let owner = Symbols.CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Action", LIST[string](["T"]), Semantic.BLOCK_SCOPE())
            let action = Semantic.Types.ACTION(loc(), owner, LIST[Type]([int_type]))
            let first = override_class([action])
            let second = override_class([l.get_function_type(LIST[Type]([int_type, int_type]))])

            is_null(first.function_results_differing_from(second))
            is_null(second.function_results_differing_from(first))
        si

        @Test()
        Formals_differing_outside_a_function_differ_in_more_than_a_result() is
            let l = lookup()

            is_null(override_class([l.get_int_type()]).function_results_differing_from(override_class([l.get_string_type()])))
        si
    si
si
