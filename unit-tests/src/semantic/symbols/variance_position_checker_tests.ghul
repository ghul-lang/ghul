namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.Types.TypeVariance
    use Assertions

    // Tests for VARIANCE_POSITION_CHECKER's variance algebra — `compose`
    // (the required variance of a position descended through a generic
    // argument's own variance) and `flip`. The end-to-end position
    // checking is covered by the variance integration tests.
    class VARIANCE_POSITION_CHECKER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        checker() -> VARIANCE_POSITION_CHECKER =>
            VARIANCE_POSITION_CHECKER(
                TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), "A_TRAIT", LIST[string](), Semantic.BLOCK_SCOPE()),
                DIAGNOSTICS_STORE()
            )

        @test()
        Composing_covariant_through_covariant_stays_covariant() is
            is_true(checker().compose(TypeVariance.COVARIANT, TypeVariance.COVARIANT) == TypeVariance.COVARIANT)
        si

        @test()
        Composing_covariant_through_contravariant_flips_to_contravariant() is
            is_true(checker().compose(TypeVariance.COVARIANT, TypeVariance.CONTRAVARIANT) == TypeVariance.CONTRAVARIANT)
        si

        @test()
        Composing_contravariant_through_contravariant_flips_to_covariant() is
            is_true(checker().compose(TypeVariance.CONTRAVARIANT, TypeVariance.CONTRAVARIANT) == TypeVariance.COVARIANT)
        si

        @test()
        Composing_through_an_invariant_argument_is_invariant() is
            is_true(checker().compose(TypeVariance.COVARIANT, TypeVariance.INVARIANT) == TypeVariance.INVARIANT)
        si

        @test()
        Composing_within_an_invariant_position_stays_invariant() is
            is_true(checker().compose(TypeVariance.INVARIANT, TypeVariance.COVARIANT) == TypeVariance.INVARIANT)
        si

        @test()
        Flipping_covariant_gives_contravariant() is
            is_true(checker().flip(TypeVariance.COVARIANT) == TypeVariance.CONTRAVARIANT)
        si

        @test()
        Flipping_contravariant_gives_covariant() is
            is_true(checker().flip(TypeVariance.CONTRAVARIANT) == TypeVariance.COVARIANT)
        si

        @test()
        Flipping_invariant_stays_invariant() is
            is_true(checker().flip(TypeVariance.INVARIANT) == TypeVariance.INVARIANT)
        si
    si
si
