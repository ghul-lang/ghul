namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A state machine frame mirrors the type parameters visible inside
    // the function it was lowered from. The mirrored parameters answer
    // for the constraints at IL, so what the original declared has to
    // reach them: a frame that mirrors only the names emits a class the
    // runtime rejects as soon as the body names a type constrained the
    // same way.
    @TestClass()
    class STATE_MACHINE_FRAME_CONSTRAINTS_TESTS is
        _scope: Semantic.BLOCK_SCOPE

        init() is
            _scope = Semantic.BLOCK_SCOPE()

            if !isa Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP(
                IoC.CONTAINER.instance.innate_symbol_lookup)
            then
                IoC.CONTAINER.instance.innate_symbol_lookup =
                    Semantic.UnitTests.TEST_INNATE_SYMBOL_LOOKUP()
            fi
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        make_bound() -> CLASS =>
            CLASS(
                loc(),
                loc(),
                _scope,
                "Bound",
                System.Array.empty[string](),
                Semantic.BLOCK_SCOPE())

        make_frame(bound: CLASS?, kind: TypeParameterConstraintKind, wants_constructor: bool)
            -> STATE_MACHINE_FRAME
        is
            let owner =
                CLASS(
                    loc(),
                    loc(),
                    _scope,
                    "Owner",
                    System.Array.empty[string](),
                    Semantic.BLOCK_SCOPE())

            let function =
                STATIC_METHOD(loc(), loc(), owner, "drain", Semantic.BLOCK_SCOPE())

            function.is_generic = true

            let t = FUNCTION_GENERIC_ARGUMENT(loc(), function, "T", 0)

            if let declared = bound then
                let bounds = LIST[Type]()
                bounds.add(declared.type!)

                t.set_ancestor_types(bounds)
            fi

            t.set_constraint_kind(kind)
            t.set_has_constructor_constraint(wants_constructor)

            function.declare(loc(), t, null)

            let names = LIST[string]()
            names.add("T")
            function.generic_argument_names = names

            let arguments = LIST[Type]()
            arguments.add(t.type!)
            function.generic_arguments = arguments

            let frame = STATE_MACHINE_FRAME(owner, function, t.type!)

            frame.declare()

            return frame
        si

        make_frame_in_generic_owner(bound: CLASS) -> STATE_MACHINE_FRAME is
            let owner =
                CLASS(
                    loc(),
                    loc(),
                    _scope,
                    "OWNER",
                    ["T"],
                    Semantic.BLOCK_SCOPE())

            let t = CLASSY_GENERIC_ARGUMENT(loc(), owner, "T", 0)

            let bounds = LIST[Type]()
            bounds.add(bound.type!)

            t.set_ancestor_types(bounds)
            t.set_constraint_kind(TypeParameterConstraintKind.REFERENCE)

            owner.declare(loc(), t, null)

            let function =
                STATIC_METHOD(loc(), loc(), owner, "drain", Semantic.BLOCK_SCOPE())

            let frame = STATE_MACHINE_FRAME(owner, function, t.type!)

            frame.declare()

            return frame
        si

        @Test()
        Declaring_a_frame_in_a_generic_owner__should_mirror_the_owners_constraints() is
            let bound = make_bound()
            let frame = make_frame_in_generic_owner(bound)

            let bounds = frame.get_argument_type_bounds(0)

            are_equal(1, bounds.count)
            are_same(bound, bounds[0].symbol)
            are_equal(
                TypeParameterConstraintKind.REFERENCE,
                frame.get_argument_constraint_kind(0))
        si

        @Test()
        Declaring_a_frame_for_a_bounded_generator__should_mirror_the_bound() is
            let bound = make_bound()
            let frame = make_frame(bound, TypeParameterConstraintKind.NONE, false)

            let bounds = frame.get_argument_type_bounds(0)

            are_equal(1, bounds.count)
            are_same(bound, bounds[0].symbol)
        si

        @Test()
        Declaring_a_frame_for_a_kind_constrained_generator__should_mirror_the_kind() is
            let frame =
                make_frame(null, TypeParameterConstraintKind.REFERENCE, false)

            are_equal(
                TypeParameterConstraintKind.REFERENCE,
                frame.get_argument_constraint_kind(0))
        si

        @Test()
        Declaring_a_frame_for_a_constructible_generator__should_mirror_the_constraint() is
            let frame = make_frame(null, TypeParameterConstraintKind.NONE, true)

            is_true(frame.get_argument_has_constructor_constraint(0))
        si

        @Test()
        Declaring_a_frame_for_an_unconstrained_generator__should_mirror_nothing() is
            let frame = make_frame(null, TypeParameterConstraintKind.NONE, false)

            are_equal(0, frame.get_argument_type_bounds(0).count)
            are_equal(
                TypeParameterConstraintKind.NONE,
                frame.get_argument_constraint_kind(0))
            is_false(frame.get_argument_has_constructor_constraint(0))
        si
    si
si
