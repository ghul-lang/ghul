namespace Semantic.Symbols.UnitTests is
    use Assertions

    class FORMER_NAMES_TESTS is
        init() is si

        @test()
        former_name_finds_current_name() is
            are_equal("Future", FORMER_NAMES.other_name("Tasks", "TASK"))
            are_equal("Completer", FORMER_NAMES.other_name("Tasks", "TaskCompletionSource"))
        si

        @test()
        current_name_finds_former_name() is
            are_equal("TASK", FORMER_NAMES.other_name("Tasks", "Future"))
            are_equal("TaskCompletionSource", FORMER_NAMES.other_name("Tasks", "Completer"))
        si

        @test()
        name_in_another_namespace_has_no_other_name() is
            assert !FORMER_NAMES.other_name("Ghul", "TASK")?
            assert !FORMER_NAMES.other_name("", "Future")?
        si

        @test()
        name_never_renamed_has_no_other_name() is
            assert !FORMER_NAMES.other_name("Tasks", "ValueTask")?
            assert !FORMER_NAMES.other_name("Tasks", "TASK_AWAITER")?
        si
    si
si
