namespace Semantic.Symbols.UnitTests is
    use Assertions
    use Ghul.Pipes.any

    class FORMER_NAMES_TESTS is
        init() is si

        @test()
        former_name_finds_every_other_place_of_the_type() is
            let others = FORMER_NAMES.other_places(".Tasks", "TASK")

            are_equal(2, others.count)
            assert _holds(others, ".Concurrency", "Future")
            assert _holds(others, ".Tasks", "Future")
        si

        @test()
        current_place_finds_the_former_places() is
            let others = FORMER_NAMES.other_places(".Concurrency", "Future")

            are_equal(2, others.count)
            assert _holds(others, ".Tasks", "Future")
            assert _holds(others, ".Tasks", "TASK")
        si

        @test()
        renamed_and_moved_type_finds_its_new_name() is
            let others = FORMER_NAMES.other_places(".Tasks", "TaskCompletionSource")

            assert _holds(others, ".Concurrency", "Completer")
            assert _holds(FORMER_NAMES.other_places(".Concurrency", "Completer"), ".Tasks", "TaskCompletionSource")
        si

        @test()
        moved_function_finds_its_new_namespace_and_back() is
            assert _holds(FORMER_NAMES.other_places(".Ghul.Threads", "run"), ".Concurrency", "run")
            assert _holds(FORMER_NAMES.other_places(".Concurrency", "run"), ".Ghul.Threads", "run")
        si

        @test()
        a_place_never_lists_itself() is
            assert !_holds(FORMER_NAMES.other_places(".Tasks", "Future"), ".Tasks", "Future")
            assert !_holds(FORMER_NAMES.other_places(".Concurrency", "Future"), ".Concurrency", "Future")
        si

        @test()
        name_in_another_namespace_has_no_other_place() is
            are_equal(0, FORMER_NAMES.other_places(".Ghul", "TASK").count)
            are_equal(0, FORMER_NAMES.other_places("", "Future").count)
        si

        @test()
        name_never_moved_has_no_other_place() is
            are_equal(0, FORMER_NAMES.other_places(".Tasks", "ValueTask").count)
            are_equal(0, FORMER_NAMES.other_places(".Tasks", "TaskExtensions").count)
            are_equal(0, FORMER_NAMES.other_places(".Tasks", "Thread").count)
        si

        _holds(places: Collections.LIST[Place], namespace_name: string, name: string) -> bool =>
            places |> any(p => p.namespace_name =~ namespace_name /\ p.name =~ name)
    si
si
