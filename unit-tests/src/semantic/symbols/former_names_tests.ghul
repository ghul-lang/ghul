namespace Semantic.Symbols.UnitTests is
    use Assertions
    use Ghul.Pipes.any

    class FORMER_NAMES_TESTS is
        init() is
            FORMER_NAMES.add_for_testing([Place(".FormerNamesTest.New", "Widget"), Place(".FormerNamesTest.Old", "Widget"), Place(".FormerNamesTest.Old", "WIDGET")])
            FORMER_NAMES.add_for_testing([Place(".FormerNamesTest.New", "Gadget"), Place(".FormerNamesTest.Old", "OldGadget")])
            FORMER_NAMES.add_for_testing([Place(".FormerNamesTest.New", "act"), Place(".FormerNamesTest.Gone", "act")])
            FORMER_NAMES.add_moved_namespace_for_testing("FormerNamesTest.Gone", "FormerNamesTest.New")
        si

        @test()
        the_compiler_records_no_former_names() is
            are_equal(0, FORMER_NAMES.other_places(".Tasks", "TASK").count)
            are_equal(0, FORMER_NAMES.other_places(".Tasks", "Future").count)
            are_equal(0, FORMER_NAMES.other_places(".Concurrency", "Future").count)
            assert !FORMER_NAMES.moved_namespace("Ghul.Threads")?
        si

        @test()
        former_name_finds_every_other_place_of_the_type() is
            let others = FORMER_NAMES.other_places(".FormerNamesTest.Old", "WIDGET")

            are_equal(2, others.count)
            assert _holds(others, ".FormerNamesTest.New", "Widget")
            assert _holds(others, ".FormerNamesTest.Old", "Widget")
        si

        @test()
        current_place_finds_the_former_places() is
            let others = FORMER_NAMES.other_places(".FormerNamesTest.New", "Widget")

            are_equal(2, others.count)
            assert _holds(others, ".FormerNamesTest.Old", "Widget")
            assert _holds(others, ".FormerNamesTest.Old", "WIDGET")
        si

        @test()
        renamed_and_moved_type_finds_its_new_name() is
            assert _holds(FORMER_NAMES.other_places(".FormerNamesTest.Old", "OldGadget"), ".FormerNamesTest.New", "Gadget")
            assert _holds(FORMER_NAMES.other_places(".FormerNamesTest.New", "Gadget"), ".FormerNamesTest.Old", "OldGadget")
        si

        @test()
        moved_function_finds_its_new_namespace_and_back() is
            assert _holds(FORMER_NAMES.other_places(".FormerNamesTest.Gone", "act"), ".FormerNamesTest.New", "act")
            assert _holds(FORMER_NAMES.other_places(".FormerNamesTest.New", "act"), ".FormerNamesTest.Gone", "act")
        si

        @test()
        a_place_never_lists_itself() is
            assert !_holds(FORMER_NAMES.other_places(".FormerNamesTest.Old", "Widget"), ".FormerNamesTest.Old", "Widget")
            assert !_holds(FORMER_NAMES.other_places(".FormerNamesTest.New", "Widget"), ".FormerNamesTest.New", "Widget")
        si

        @test()
        name_in_another_namespace_has_no_other_place() is
            are_equal(0, FORMER_NAMES.other_places(".FormerNamesTest", "Widget").count)
            are_equal(0, FORMER_NAMES.other_places("", "Widget").count)
        si

        @test()
        name_never_moved_has_no_other_place() is
            are_equal(0, FORMER_NAMES.other_places(".FormerNamesTest.Old", "Sprocket").count)
        si

        @test()
        namespace_whose_members_all_moved_names_where_they_went() is
            are_equal("FormerNamesTest.New", FORMER_NAMES.moved_namespace("FormerNamesTest.Gone")!)
            assert !FORMER_NAMES.moved_namespace("FormerNamesTest.Old")?
            assert !FORMER_NAMES.moved_namespace("FormerNamesTest")?
        si

        _holds(places: Collections.LIST[Place], namespace_name: string, name: string) -> bool =>
            places |> any(p => p.namespace_name =~ namespace_name /\ p.name =~ name)
    si
si
