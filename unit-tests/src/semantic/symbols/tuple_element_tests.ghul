namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.TUPLE
    use Semantic.Symbols.TUPLE_ELEMENT

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A tuple element is the same element where its tuple type, its index
    // and its name are the same, whichever lookup made it, so that its
    // uses gather as one symbol's references.
    @TestClass()
    class TUPLE_ELEMENT_TESTS is
        _template: CLASS
        _int: Type
        _string: Type

        init() is
            _template = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TUPLE_2", LIST[string](["T1", "T2"]), Semantic.BLOCK_SCOPE())
            _int = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _string = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "string", LIST[string](), Semantic.BLOCK_SCOPE()).type!
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        tuple_of(second: Type, names: string?[]?) -> TUPLE =>
            TUPLE(loc(), _template, [_int, second], names)

        element(tuple: TUPLE, index: int) -> TUPLE_ELEMENT =>
            TUPLE_ELEMENT(tuple, index, Semantic.Symbols.STRUCT_FIELD(loc(), tuple, "{index}"))

        @Test()
        Elements_at_the_same_index_of_the_same_tuple_type__should_be_equal_and_hash_alike() is
            let a = element(tuple_of(_int, ["x", "y"]), 0)
            let b = element(tuple_of(_int, ["x", "y"]), 0)

            is_true(a =~ b)
            are_equal(a.get_hash_code(), b.get_hash_code())
        si

        @Test()
        Elements_at_different_indexes__should_not_be_equal() is
            let tuple = tuple_of(_int, ["x", "y"])

            is_false(element(tuple, 0) =~ element(tuple, 1))
        si

        @Test()
        Elements_of_tuple_types_with_different_element_types__should_not_be_equal() is
            is_false(element(tuple_of(_int, null), 0) =~ element(tuple_of(_string, null), 0))
        si

        @Test()
        Elements_with_different_names__should_not_be_equal() is
            is_false(element(tuple_of(_int, ["x", "y"]), 0) =~ element(tuple_of(_int, ["a", "b"]), 0))
        si

        @Test()
        An_unnamed_element__should_take_the_default_name() is
            are_equal("`1", element(tuple_of(_int, null), 1).name)
            are_equal("`1", element(tuple_of(_int, ["x", "1"]), 1).name)
        si

        @Test()
        A_positional_name_or_default_name__should_give_its_index() is
            are_equal(1, TUPLE.positional_index("1"))
            are_equal(1, TUPLE.positional_index("`1"))
            are_equal(-1, TUPLE.positional_index("x"))
            are_equal(-1, TUPLE.positional_index("12"))
        si
    si
si
