namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.TRAIT
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // `depth` is how far a type sits from the root of the inheritance
    // graph, and it is what ranks a candidate against its alternatives -
    // in overload resolution's last tie-break and in the least-upper-bound
    // map's choice of common type. Both read the same number, so what it
    // counts has to be one thing.
    //
    // It counts every ancestor, traits included. Counting only the
    // superclass chain would put a concrete type below the traits it
    // implements, which is the wrong way round: a type that implements a
    // trait is more derived than the trait, not less.
    @TestClass()
    class CLASSY_DEPTH_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        object_class() -> CLASS is
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", empty_names(), Semantic.BLOCK_SCOPE())

            c.mark_is_object()

            return c
        si

        a_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())

        a_trait(name: string) -> TRAIT =>
            TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())

        @Test()
        given_the_root__depth_is_zero() is
            are_equal(0, object_class().depth)
        si

        @Test()
        given_a_superclass_chain__depth_counts_the_steps() is
            let root = object_class()

            let animal = a_class("animal")
            animal.add_ancestor(root.type!)

            let cat = a_class("cat")
            cat.add_ancestor(animal.type!)

            are_equal(1, animal.depth)
            are_equal(2, cat.depth)
        si

        @Test()
        given_a_trait_chain__depth_counts_the_steps() is
            let named = a_trait("named")

            let described = a_trait("described")
            described.add_ancestor(named.type!)

            are_equal(1, named.depth)
            are_equal(2, described.depth)
        si

        // The case the metric turns on: a class whose superclass is the
        // root but which implements a trait several steps down. Counting
        // the superclass chain alone would measure it as 1 and rank it
        // below a trait it implements.
        @Test()
        given_a_trait_deeper_than_the_superclass_chain__depth_follows_the_trait() is
            let root = object_class()

            let named = a_trait("named")

            let described = a_trait("described")
            described.add_ancestor(named.type!)

            let thing = a_class("thing")
            thing.add_ancestor(root.type!)
            thing.add_ancestor(described.type!)

            are_equal(3, thing.depth)
            is_true(thing.depth > described.depth)
        si

        // A synthesised type is measured the same way as a declared one.
        // A kind that answered the base default instead ranked alongside
        // object, which both loses it a comparison it should win and
        // reads as ambiguous against anything else sitting at zero.
        @Test()
        given_a_synthesised_frame__depth_is_measured_from_its_ancestry() is
            let owner = a_class("Owner")
            let function = STATIC_METHOD(loc(), loc(), owner, "do_async", Semantic.BLOCK_SCOPE())

            let frame = ASYNC_STATE_MACHINE_FRAME(owner, function, null, false)

            are_equal(1, frame.depth)
            is_true(frame.depth > object_class().depth)
        si

        @Test()
        given_several_ancestors__depth_follows_the_deepest() is
            let root = object_class()

            let shallow = a_trait("shallow")

            let deep = a_trait("deep")
            deep.add_ancestor(a_trait("middle").type!)

            let thing = a_class("thing")
            thing.add_ancestor(root.type!)
            thing.add_ancestor(shallow.type!)
            thing.add_ancestor(deep.type!)

            are_equal(3, thing.depth)
        si
    si
si
