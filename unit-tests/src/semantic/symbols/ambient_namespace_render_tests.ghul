namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // What a name reads as where no scope is given: a diagnostic assembled
    // outside any scope, and the hover a generated example is rendered
    // from. A name the ambient namespace holds resolves bare from anywhere,
    // so it reads bare here too; every other namespace still qualifies,
    // since there its qualified spelling is what resolves it.
    @TestClass()
    class AMBIENT_NAMESPACE_RENDER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_namespace(name: string) -> NAMESPACE =>
            NAMESPACE(loc(), name, null, ".{name}", false)

        a_type(owner: NAMESPACE, name: string) -> CLASS =>
            CLASS(loc(), loc(), owner, name, LIST[string](0), Semantic.BLOCK_SCOPE())

        @Test()
        given_no_scope__a_name_in_the_ambient_namespace_reads_bare() is
            let ambient = a_namespace("Intrinsics")

            ambient.mark_implicitly_imported()

            are_equal("void", a_type(ambient, "void").render_name(null))
        si

        @Test()
        given_no_scope__a_name_in_any_other_namespace_stays_qualified() is
            let other = a_namespace("Collections")

            are_equal("Collections.LIST", a_type(other, "LIST").render_name(null))
        si

        @Test()
        given_a_scope__a_name_in_the_ambient_namespace_still_reads_bare() is
            let ambient = a_namespace("Intrinsics")

            ambient.mark_implicitly_imported()

            are_equal("void", a_type(ambient, "void").render_name(Semantic.BLOCK_SCOPE()))
        si
    si
si
