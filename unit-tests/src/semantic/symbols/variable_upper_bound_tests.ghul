namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for the upper-bound bucket on Variable. Upper bounds
    // are recorded when a placeholder is passed AS a concretely-
    // typed argument slot — they validate the eventual lower-
    // bound LUB without polluting it. F07's failure mode:
    // treating an upper-bound `object` as a peer LUB candidate
    // dominates a `bool` assignment and widens the variable to
    // object. The fix recorded behaviour pinned here.
    @TestClass()
    class VARIABLE_UPPER_BOUND_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)
        empty_names() -> LIST[string] => LIST[string]()

        // First add of an upper bound carries information and
        // signals progress to the retry loop.
        @Test()
        Adding_a_new_upper_bound__should_return_true() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C", empty_names(), Semantic.BLOCK_SCOPE())

            is_true(origin.add_upper_bound(c.type!))
        si

        // Duplicate add (same Type instance) is rejected as
        // non-information. Pins the dedup-by-`=~` contract so
        // the retry loop doesn't churn forever on stable upper-
        // bound propagation.
        @Test()
        Adding_the_same_upper_bound_twice__should_return_false_the_second_time() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C", empty_names(), Semantic.BLOCK_SCOPE())

            is_true(origin.add_upper_bound(c.type!))
            is_false(origin.add_upper_bound(c.type!))
        si

        // Null bound never carries information.
        @Test()
        Adding_a_null_upper_bound__should_return_false() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")

            is_false(origin.add_upper_bound(null))
        si

        // An upper bound recorded through an invariant slot names the one
        // type the placeholder can be, so a lower bound that converts to
        // it settles to the bound itself: `add(1)` into a list returned
        // as `int?[]` makes the list `LIST[int?]`.
        @Test()
        With_a_lower_bound_assignable_to_an_exact_upper_bound__try_get_inferred_type__should_return_the_upper_bound() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Animal", empty_names(), Semantic.BLOCK_SCOPE())
            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Cat", empty_names(), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            origin.add_lower_bound(cat.type!)
            is_true(origin.add_upper_bound(animal.type!, true))

            are_same(animal.type!, origin.try_get_inferred_type())
        si

        // A bound recorded through a covariant slot only has to admit the
        // candidate, so the lower-bound join stands.
        @Test()
        With_a_lower_bound_assignable_to_an_upper_bound_that_is_not_exact__try_get_inferred_type__should_return_the_lower_bound() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Animal", empty_names(), Semantic.BLOCK_SCOPE())
            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Cat", empty_names(), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            origin.add_lower_bound(cat.type!)
            is_true(origin.add_upper_bound(animal.type!))

            are_same(cat.type!, origin.try_get_inferred_type())
        si

        // Marking a bound already recorded as exact is new information.
        @Test()
        Adding_an_exact_upper_bound_already_recorded_as_not_exact__should_return_true() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C", empty_names(), Semantic.BLOCK_SCOPE())

            is_true(origin.add_upper_bound(c.type!))
            is_true(origin.add_upper_bound(c.type!, true))
            is_false(origin.add_upper_bound(c.type!, true))
        si

        // No lower-bound LUB candidate, single upper bound:
        // falls back to the upper bound. Pins the "only signal
        // is an upper bound" preservation case — without this,
        // `let v; g(v)` where g takes object would stop inferring
        // and break otherwise-working code that has only an
        // upper-bound signal.
        @Test()
        With_no_lower_bound_and_a_single_upper_bound__try_get_inferred_type__should_return_the_upper_bound() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C", empty_names(), Semantic.BLOCK_SCOPE())

            is_true(origin.add_upper_bound(c.type!))
            are_same(c.type!, origin.try_get_inferred_type())
        si

        // An upper bound over a function's type parameter - recorded
        // when the placeholder is passed to a `count[T](source:
        // Iterable[T])` still being inferred - does not reject a
        // settled lower-bound candidate: nothing is assignable to the
        // unbound parameter, so as a check it would reject them all.
        @Test()
        With_a_lower_bound_and_an_upper_bound_over_a_function_type_parameter__try_get_inferred_type__should_return_the_lower_bound() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", LIST[string](["U"]), Semantic.BLOCK_SCOPE())
            let element = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "E", empty_names(), Semantic.BLOCK_SCOPE())
            let callee = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Callee", empty_names(), Semantic.BLOCK_SCOPE())

            let t = Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT(loc(), callee, "T", 0).type!

            let lower = cast Type(Semantic.Types.GENERIC(loc(), box, LIST[Type]([element.type!])))
            let upper = cast Type(Semantic.Types.GENERIC(loc(), box, LIST[Type]([t])))

            origin.add_lower_bound(lower)
            is_true(origin.add_upper_bound(upper))

            are_same(lower, origin.try_get_inferred_type())
        si

        // A lone upper bound over a function's type parameter is not
        // a type the placeholder can take: with no lower bound the
        // placeholder stays unresolved for a later walk rather than
        // settling on `Box[T]` and refusing the lower bound that walk
        // records.
        @Test()
        With_no_lower_bound_and_a_single_upper_bound_over_a_function_type_parameter__try_get_inferred_type__should_return_null() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", LIST[string](["U"]), Semantic.BLOCK_SCOPE())
            let callee = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Callee", empty_names(), Semantic.BLOCK_SCOPE())

            let t = Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT(loc(), callee, "T", 0).type!

            is_true(origin.add_upper_bound(cast Type(Semantic.Types.GENERIC(loc(), box, LIST[Type]([t])))))

            is_null(origin.try_get_inferred_type())
        si

        // The same bound over a type parameter of the function the
        // variable is declared in names a definite type there - a local
        // returned from a generic function takes the declared return
        // type - so it is taken like any other lone upper bound.
        @Test()
        With_no_lower_bound_and_a_single_upper_bound_over_its_own_function_type_parameter__try_get_inferred_type__should_return_the_upper_bound() is
            let box = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Box", LIST[string](["U"]), Semantic.BLOCK_SCOPE())
            let enclosing = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Enclosing", empty_names(), Semantic.BLOCK_SCOPE())
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), enclosing, "V")

            let t = Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT(loc(), enclosing, "T", 0).type!
            let upper = cast Type(Semantic.Types.GENERIC(loc(), box, LIST[Type]([t])))

            is_true(origin.add_upper_bound(upper))

            are_same(upper, origin.try_get_inferred_type())
        si

        // No lower-bound LUB candidate, multiple upper bounds:
        // returns null. Conservative — no narrowest-of-uppers
        // heuristic yet. Surfaces if a future change adds GLB-
        // style multi-upper resolution.
        @Test()
        With_no_lower_bound_and_multiple_upper_bounds__try_get_inferred_type__should_return_null() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let c1 = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C1", empty_names(), Semantic.BLOCK_SCOPE())
            let c2 = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C2", empty_names(), Semantic.BLOCK_SCOPE())

            is_true(origin.add_upper_bound(c1.type!))
            is_true(origin.add_upper_bound(c2.type!))

            is_null(origin.try_get_inferred_type())
        si

        // Lower-bound LUB candidate matches its own upper-bound
        // entry (same type both directions): validation accepts.
        // Trivial case but pins the "no spurious rejection" path.
        @Test()
        With_matching_lower_and_upper_bound__try_get_inferred_type__should_return_the_candidate() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let c = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C", empty_names(), Semantic.BLOCK_SCOPE())

            is_true(origin.add_lower_bound(c.type!))
            is_true(origin.add_upper_bound(c.type!))

            are_same(c.type!, origin.try_get_inferred_type())
        si

        // LUB candidate NOT assignable to an upper bound:
        // returns null. The F07 failure-mode test in fixture
        // form: a placeholder asked to be both C1 (lower) and
        // C2 (upper) when the two are unrelated must surface as
        // unresolved rather than picking either silently.
        @Test()
        With_lower_bound_not_assignable_to_upper_bound__try_get_inferred_type__should_return_null() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let c1 = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C1", empty_names(), Semantic.BLOCK_SCOPE())
            let c2 = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "C2", empty_names(), Semantic.BLOCK_SCOPE())

            is_true(origin.add_lower_bound(c1.type!))
            is_true(origin.add_upper_bound(c2.type!))

            is_null(origin.try_get_inferred_type())
        si

        // An upper bound the lower-bound join does not meet holds the
        // inferred type back, but the join is still what the values that
        // reach the variable are: the fixing step types a literal's
        // parameter from it, so the use that asked for the narrower type
        // reports its own error.
        @Test()
        With_a_lower_bound_an_upper_bound_rejects__lower_bound_type__should_return_the_lower_bound() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Animal", empty_names(), Semantic.BLOCK_SCOPE())
            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Cat", empty_names(), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            origin.add_lower_bound(animal.type!)
            origin.add_upper_bound(cat.type!)

            is_null(origin.try_get_inferred_type())
            are_same(animal.type!, origin.lower_bound_type())
        si

        // With no lower bound there is no type of the values to take.
        @Test()
        With_only_an_upper_bound__lower_bound_type__should_return_null() is
            let origin = INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "T")
            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Cat", empty_names(), Semantic.BLOCK_SCOPE())

            origin.add_upper_bound(cat.type!)

            is_null(origin.lower_bound_type())
        si
    si
si
