namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Collections.LIST

    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT
    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.STATIC_CLOSURE
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins that a closure captures the type parameters its own
    // parameter and return types name, whichever kind they are.
    //
    // A closure emitted on the enclosing class reaches that class's
    // parameters through the instance, so nothing captures them
    // earlier. One with captured values is emitted on a frame, which
    // carries none of them, and the frame declares whatever this
    // records.
    @TestClass()
    class CLOSURE_SIGNATURE_TYPE_ARGUMENT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false)

        closure(owner: NAMESPACE) -> STATIC_CLOSURE =>
            STATIC_CLOSURE(loc(), owner, "$anon", owner, false)

        names(count: int) -> LIST[string] is
            let result = LIST[string]()

            for i in 0..count do
                result.add("a{i}")
            od

            return result
        si

        types(elements: Type[]) -> LIST[Type] => LIST[Type](elements)

        @Test()
        A_class_level_parameter_in_an_argument_should_be_captured() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            let x = CLASSY_GENERIC_ARGUMENT(loc(), shared_owner, "X", 0)

            subject.set_arguments(names(1), types([x.type!]))

            subject.capture_signature_type_arguments()

            are_equal(1, subject.captured_type_arguments!.count)
        si

        @Test()
        A_method_level_parameter_in_an_argument_should_be_captured() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            let y = FUNCTION_GENERIC_ARGUMENT(loc(), shared_owner, "Y", 0)

            subject.set_arguments(names(1), types([y.type!]))

            subject.capture_signature_type_arguments()

            are_equal(1, subject.captured_type_arguments!.count)
        si

        @Test()
        A_parameter_in_the_return_type_should_be_captured() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            let x = CLASSY_GENERIC_ARGUMENT(loc(), shared_owner, "X", 0)

            subject.set_arguments(names(0), types([]))
            subject.set_return_type(x.type!)

            subject.capture_signature_type_arguments()

            are_equal(1, subject.captured_type_arguments!.count)
        si

        @Test()
        Parameters_of_both_kinds_should_take_a_slot_each() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            // Distinct owners: two parameters are the same parameter
            // when the same symbol declared them, so a class's and a
            // method's are told apart by their owners rather than by
            // their positions, which both start at zero.
            let x = CLASSY_GENERIC_ARGUMENT(loc(), owner(), "X", 0)
            let y = FUNCTION_GENERIC_ARGUMENT(loc(), owner(), "Y", 0)

            subject.set_arguments(names(2), types([x.type!, y.type!]))
            subject.set_return_type(x.type!)

            subject.capture_signature_type_arguments()

            are_equal(2, subject.captured_type_arguments!.count)
        si

        @Test()
        A_signature_naming_no_parameter_should_capture_nothing() is
            let shared_owner = owner()
            let subject = closure(shared_owner)

            subject.set_arguments(names(0), types([]))

            subject.capture_signature_type_arguments()

            is_null(subject.captured_type_arguments)
        si
    si
si
