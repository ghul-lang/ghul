namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for GENERIC_CONSTRAINT_CHECKER — whether a type argument
    // satisfies a `class` / `struct` / `optional` kind constraint, an
    // `init` constructor constraint, and a `[T: SomeBase]` type bound.
    // For an ordinary actual the kind and constructor constraints are
    // checked together (check_argument_kinds) and the type bound
    // separately (check_argument_type_bounds), since at type-expression
    // positions the bound is not yet attached when the kinds are checked.
    // A type-variable actual has all three checked by the latter, whose
    // answers read the bound, so it is exercised through
    // satisfies_kind_as_type_variable rather than through is_satisfied.
    // Uncheckable actuals (error types) must report "satisfied" so no
    // spurious constraint error cascades from them.
    @TestClass()
    class GENERIC_CONSTRAINT_CHECKER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        no_names() -> LIST[string] => LIST[string]()

        reference_type() -> Semantic.Types.Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "RefThing", no_names(), Semantic.BLOCK_SCOPE()).type!

        value_type() -> Semantic.Types.Type =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "ValThing", no_names(), Semantic.BLOCK_SCOPE()).type!

        type_variable() -> Semantic.Types.Type =>
            CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0).type!

        type_variable_of_kind(kind: TypeParameterConstraintKind) -> Semantic.Types.Type is
            let symbol = CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0)

            symbol.set_constraint_kind(kind)

            return symbol.type!
        si

        type_variable_with_constructor_constraint() -> Semantic.Types.Type is
            let symbol = CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0)

            symbol.set_has_constructor_constraint(true)

            return symbol.type!
        si

        type_variable_bounded_by(bound: Semantic.Types.Type) -> Semantic.Types.Type is
            let symbol = CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0)

            let bounds = LIST[Semantic.Types.Type]()
            bounds.add(bound)

            symbol.set_ancestor_types(bounds)

            return symbol.type!
        si

        // A reference type's `T?` form — the same NAMED carrying the
        // optional flag.
        optional_reference_type() -> Semantic.Types.Type =>
            reference_type().as_optional()

        error_type() -> Semantic.Types.Type => Semantic.Types.ERROR()

        // A value type's `T?` form — `Nullable[T]`, itself a value
        // type carrying the optional flag. Built over a struct
        // container so is_value_type reports true, exercising the
        // struct constraint's `!is_optional` clause rather than its
        // value-type clause.
        value_optional_type() -> Semantic.Types.Type is
            let container = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Nullable", ["T"], Semantic.BLOCK_SCOPE())
            let inner = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Inner", no_names(), Semantic.BLOCK_SCOPE())
            let arguments = LIST[Semantic.Types.Type]()
            arguments.add(inner.type!)
            return Semantic.Types.NULLABLE(loc(), container, arguments)
        si

        @Test()
        A_class_constraint_is_satisfied_by_a_reference_type() is
            is_true(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.REFERENCE, reference_type()))
        si

        @Test()
        A_class_constraint_is_not_satisfied_by_a_value_type() is
            is_false(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.REFERENCE, value_type()))
        si

        @Test()
        A_struct_constraint_is_satisfied_by_a_value_type() is
            is_true(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.VALUE, value_type()))
        si

        @Test()
        A_struct_constraint_is_not_satisfied_by_a_reference_type() is
            is_false(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.VALUE, reference_type()))
        si

        @Test()
        A_struct_constraint_is_not_satisfied_by_a_value_optional() is
            // The struct constraint is non-nullable-value-type, matching
            // the CLR: `Nullable[T]` is a value type but does not satisfy
            // it. This is what stops the generic order comparison from
            // binding its `struct`-constrained parameter to a value
            // optional and silently comparing a possibly-absent value.
            let value_optional = value_optional_type()
            is_true(value_optional.is_value_type)
            is_true(value_optional.is_optional)
            is_false(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.VALUE, value_optional))
        si

        @Test()
        The_unconstrained_kind_is_satisfied_by_any_type() is
            let checker = GENERIC_CONSTRAINT_CHECKER()
            is_true(checker.is_satisfied(TypeParameterConstraintKind.NONE, reference_type()))
            is_true(checker.is_satisfied(TypeParameterConstraintKind.NONE, value_type()))
        si

        @Test()
        An_optional_constraint_is_satisfied_by_an_optional_type() is
            is_true(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.OPTIONAL, optional_reference_type()))
        si

        @Test()
        An_optional_constraint_is_not_satisfied_by_a_non_optional_reference_type() is
            is_false(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.OPTIONAL, reference_type()))
        si

        @Test()
        An_optional_constraint_is_not_satisfied_by_a_non_optional_value_type() is
            is_false(GENERIC_CONSTRAINT_CHECKER().is_satisfied(TypeParameterConstraintKind.OPTIONAL, value_type()))
        si

        @Test()
        An_error_type_satisfies_any_constraint_so_no_cascade() is
            let checker = GENERIC_CONSTRAINT_CHECKER()
            is_true(checker.is_satisfied(TypeParameterConstraintKind.REFERENCE, error_type()))
            is_true(checker.is_satisfied(TypeParameterConstraintKind.VALUE, error_type()))
            is_true(checker.is_satisfied(TypeParameterConstraintKind.OPTIONAL, error_type()))
        si

        // is_satisfied defers a type variable rather than deciding it, so a
        // call site - where both checks run - reports the violation once.
        @Test()
        Is_satisfied_defers_a_type_variable_to_the_bound_check() is
            let checker = GENERIC_CONSTRAINT_CHECKER()
            is_true(checker.is_satisfied(TypeParameterConstraintKind.REFERENCE, type_variable()))
            is_true(checker.is_satisfied(TypeParameterConstraintKind.VALUE, type_variable()))
        si

        @Test()
        An_unbounded_type_variable_satisfies_no_kind_constraint() is
            let checker = GENERIC_CONSTRAINT_CHECKER()
            is_false(checker.satisfies_kind_as_type_variable(TypeParameterConstraintKind.REFERENCE, type_variable()))
            is_false(checker.satisfies_kind_as_type_variable(TypeParameterConstraintKind.VALUE, type_variable()))
            is_false(checker.satisfies_kind_as_type_variable(TypeParameterConstraintKind.OPTIONAL, type_variable()))
        si

        @Test()
        A_type_variable_satisfies_the_kind_it_declares() is
            let checker = GENERIC_CONSTRAINT_CHECKER()

            is_true(
                checker.satisfies_kind_as_type_variable(
                    TypeParameterConstraintKind.REFERENCE,
                    type_variable_of_kind(TypeParameterConstraintKind.REFERENCE)
                )
            )

            is_true(
                checker.satisfies_kind_as_type_variable(
                    TypeParameterConstraintKind.VALUE,
                    type_variable_of_kind(TypeParameterConstraintKind.VALUE)
                )
            )
        si

        @Test()
        A_type_variable_does_not_satisfy_a_kind_it_does_not_declare() is
            is_false(
                GENERIC_CONSTRAINT_CHECKER().satisfies_kind_as_type_variable(
                    TypeParameterConstraintKind.VALUE,
                    type_variable_of_kind(TypeParameterConstraintKind.REFERENCE)
                )
            )
        si

        // A CLR `where T : SomeClass` satisfies a `where U : class`, so a
        // reference-typed bound stands in for the reference kind. An
        // unbounded parameter's `object` ancestor must not, since a value
        // type is an object too — that is the case above.
        @Test()
        A_type_variable_bounded_by_a_reference_type_satisfies_the_reference_kind() is
            is_true(
                GENERIC_CONSTRAINT_CHECKER().satisfies_kind_as_type_variable(
                    TypeParameterConstraintKind.REFERENCE,
                    type_variable_bounded_by(reference_type())
                )
            )
        si

        // `[TBase: RefThing, TDerived: TBase]` — TDerived's effective bound
        // is a reference type, reached by walking the chain.
        @Test()
        A_type_variable_bounded_by_a_reference_bounded_type_variable_satisfies_the_reference_kind() is
            is_true(
                GENERIC_CONSTRAINT_CHECKER().satisfies_kind_as_type_variable(
                    TypeParameterConstraintKind.REFERENCE,
                    type_variable_bounded_by(type_variable_bounded_by(reference_type()))
                )
            )
        si

        @Test()
        A_type_variable_bounded_by_an_unbounded_type_variable_satisfies_no_kind() is
            is_false(
                GENERIC_CONSTRAINT_CHECKER().satisfies_kind_as_type_variable(
                    TypeParameterConstraintKind.REFERENCE,
                    type_variable_bounded_by(type_variable())
                )
            )
        si

        // A cyclic declaration must terminate rather than recurse forever.
        @Test()
        A_type_variable_bounded_by_itself_satisfies_no_kind() is
            let symbol = CLASSY_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0)

            let self_bound = LIST[Semantic.Types.Type]()
            self_bound.add(symbol.type!)

            symbol.set_ancestor_types(self_bound)

            is_false(
                GENERIC_CONSTRAINT_CHECKER().satisfies_kind_as_type_variable(
                    TypeParameterConstraintKind.REFERENCE,
                    symbol.type!
                )
            )
        si

        @Test()
        An_imported_type_with_no_argument_type_bounds_reports_none() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["T"], Semantic.BLOCK_SCOPE())
            are_equal(0, owner.get_argument_type_bounds(0).count)
        si

        @Test()
        An_imported_type_with_an_argument_type_bound_reports_it() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["T"], Semantic.BLOCK_SCOPE())
            let bound = reference_type()
            owner.argument_type_bounds = [[bound]]
            are_equal(1, owner.get_argument_type_bounds(0).count)
            are_same(bound, owner.get_argument_type_bounds(0)[0])
        si

        @Test()
        A_value_type_always_has_a_parameterless_constructor() is
            is_true(GENERIC_CONSTRAINT_CHECKER().has_accessible_parameterless_constructor(value_type()))
        si

        @Test()
        A_reference_type_with_no_constructor_has_no_parameterless_constructor() is
            is_false(GENERIC_CONSTRAINT_CHECKER().has_accessible_parameterless_constructor(reference_type()))
        si

        @Test()
        A_reference_type_that_declares_a_parameterless_constructor_has_one() is
            let the_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "HasCtor", no_names(), Semantic.BLOCK_SCOPE())
            the_class.has_parameterless_constructor = true
            is_true(GENERIC_CONSTRAINT_CHECKER().has_accessible_parameterless_constructor(the_class.type!))
        si

        // A type variable's `is_value_type` is unconditionally true, so it
        // must not be the thing consulted here - a type parameter has a
        // constructor only where it was declared to.
        @Test()
        An_unbounded_type_variable_has_no_parameterless_constructor() is
            is_false(GENERIC_CONSTRAINT_CHECKER().has_accessible_parameterless_constructor(type_variable()))
        si

        @Test()
        A_type_variable_declaring_a_constructor_constraint_has_one() is
            is_true(
                GENERIC_CONSTRAINT_CHECKER().has_accessible_parameterless_constructor(
                    type_variable_with_constructor_constraint()
                )
            )
        si

        @Test()
        A_type_variable_of_struct_kind_has_one() is
            is_true(
                GENERIC_CONSTRAINT_CHECKER().has_accessible_parameterless_constructor(
                    type_variable_of_kind(TypeParameterConstraintKind.VALUE)
                )
            )
        si

        @Test()
        check_arguments_reports_a_type_argument_with_no_parameterless_constructor() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Factory", ["T"], Semantic.BLOCK_SCOPE())
            owner.argument_has_constructor_constraint = [true]

            let logger = DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_arguments(loc(), logger, owner, ["T"], [reference_type()])

            is_true(logger.any_errors)
        si

        @Test()
        check_arguments_accepts_a_type_argument_with_a_parameterless_constructor() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Factory", ["T"], Semantic.BLOCK_SCOPE())
            owner.argument_has_constructor_constraint = [true]

            let logger = DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_arguments(loc(), logger, owner, ["T"], [value_type()])

            is_false(logger.any_errors)
        si

        @Test()
        check_arguments_rejects_a_type_argument_that_does_not_satisfy_an_imported_type_bound() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["T"], Semantic.BLOCK_SCOPE())
            let bound = reference_type()
            owner.argument_type_bounds = [[bound]]

            let logger = DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_arguments(loc(), logger, owner, ["T"], [value_type()])

            is_true(logger.any_errors)
        si

        @Test()
        check_arguments_accepts_a_type_argument_that_satisfies_an_imported_type_bound() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["T"], Semantic.BLOCK_SCOPE())
            let bound = reference_type()
            owner.argument_type_bounds = [[bound]]

            let logger = DIAGNOSTICS_STORE()

            // Same reference_type instance — trivially assignable to itself.
            GENERIC_CONSTRAINT_CHECKER().check_arguments(loc(), logger, owner, ["T"], [bound])

            is_false(logger.any_errors)
        si

        @Test()
        check_argument_type_bounds_rejects_a_type_argument_that_does_not_satisfy_a_bound() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["T"], Semantic.BLOCK_SCOPE())
            owner.argument_type_bounds = [[reference_type()]]

            let logger = DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_argument_type_bounds(loc(), logger, owner, ["T"], [value_type()])

            is_true(logger.any_errors)
        si

        @Test()
        check_argument_type_bounds_accepts_a_type_argument_that_satisfies_a_bound() is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["T"], Semantic.BLOCK_SCOPE())
            let bound = reference_type()
            owner.argument_type_bounds = [[bound]]

            let logger = DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_argument_type_bounds(loc(), logger, owner, ["T"], [bound])

            is_false(logger.any_errors)
        si

        @Test()
        check_argument_type_bounds_ignores_the_constructor_constraint() is
            // A `new()` violation is the kinds pass's job, not the bounds
            // pass — the bound-only check must not report it.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Factory", ["T"], Semantic.BLOCK_SCOPE())
            owner.argument_has_constructor_constraint = [true]

            let logger = DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_argument_type_bounds(loc(), logger, owner, ["T"], [reference_type()])

            is_false(logger.any_errors)
        si

        @Test()
        check_argument_kinds_ignores_the_type_bound() is
            // A bound violation is the bounds pass's job, not the kinds
            // pass — the kinds-only check must not report it.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["T"], Semantic.BLOCK_SCOPE())
            owner.argument_type_bounds = [[reference_type()]]

            let logger = DIAGNOSTICS_STORE()

            GENERIC_CONSTRAINT_CHECKER().check_argument_kinds(loc(), logger, owner, ["T"], [value_type()])

            is_false(logger.any_errors)
        si

        @Test()
        check_arguments_substitutes_sibling_parameter_in_a_type_bound() is
            // Models a method like `M[TBase, TDerived](where TDerived: TBase)`.
            // The bound on TDerived references TBase by name; the checker must
            // substitute TBase → actual[0] before assigning. Passing the same
            // class for both should satisfy; a value type for TDerived should
            // not (TBase is the reference-type actual).
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Holder", ["TBase", "TDerived"], Semantic.BLOCK_SCOPE())
            let tbase_var = owner.declare_type(loc(), "TBase", 0, null).type
            owner.declare_type(loc(), "TDerived", 1, null)
            let first = LIST[Semantic.Types.Type]()

            let second = LIST[Semantic.Types.Type]()
            second.add(tbase_var!)

            let bounds = Collections.LIST[Semantic.Types.Type[]]()
            bounds.add(first)
            bounds.add(second)

            owner.argument_type_bounds = bounds

            let actual_base = reference_type()

            let pass_logger = DIAGNOSTICS_STORE()
            GENERIC_CONSTRAINT_CHECKER().check_arguments(
                loc(), pass_logger, owner, ["TBase", "TDerived"], [actual_base, actual_base])
            is_false(pass_logger.any_errors)

            let fail_logger = DIAGNOSTICS_STORE()
            GENERIC_CONSTRAINT_CHECKER().check_arguments(
                loc(), fail_logger, owner, ["TBase", "TDerived"], [actual_base, value_type()])
            is_true(fail_logger.any_errors)
        si
    si
si
