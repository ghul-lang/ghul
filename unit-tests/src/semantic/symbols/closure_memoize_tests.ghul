namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.STATIC_CLOSURE

    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins `Closure.is_memoizable_delegate`, the gate that decides whether
    // a function literal's delegate can be built once and cached in a
    // static field. Two shapes qualify:
    //
    //   - a static/global anonymous function (ldnull target, no captures),
    //     cached on the enclosing namespace's `$globals`;
    //   - a self-bound delegate that captures no values AND never loads
    //     self in its body, cached on its enclosing (non-generic) class or
    //     struct.
    //
    // Both need no captured type arguments and a fully-settled, ground
    // function type. Each negative branch is pinned because letting any one
    // through would cache a literal that is not interchangeable across
    // evaluations (a captured value, an unresolved type, or a self-
    // dependent result such as `() => self`).
    @TestClass()
    class CLOSURE_MEMOIZE_TESTS is
        init() is
            // LOCAL_VARIABLE's init reads the local id generator; wire it
            // up so the unsettled-type fixture can build a placeholder.
            if !IoC.CONTAINER.instance.local_id_generator? then
                IoC.CONTAINER.instance.local_id_generator = IR.LOCAL_ID_GENERATOR()
            fi
            IoC.CONTAINER.instance.local_id_generator.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        namespace_owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false)

        settled_type() -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Concrete", System.Array.empty[string](), Semantic.BLOCK_SCOPE()).type!

        // A ground static closure owned by a namespace: memoizable unless
        // a test perturbs one of the gate's inputs.
        memoizable_closure() -> STATIC_CLOSURE is
            let owner = namespace_owner()
            let closure = STATIC_CLOSURE(loc(), owner, "$anon_0", owner, false)
            closure.type = settled_type()
            return closure
        si

        @Test()
        Calling__is_memoizable_delegate__for_ground_static_closure__returns_true() is
            is_true(memoizable_closure().is_memoizable_delegate)
        si

        @Test()
        Calling__is_memoizable_delegate__for_a_bare_delegate__returns_false() is
            // A delegate that is not marked stateless carries captured
            // state, so it is not interchangeable across loads.
            let closure = memoizable_closure()
            closure.is_delegate = true

            is_false(closure.is_memoizable_delegate)
        si

        // A stateless self-bound delegate owned by a non-generic class:
        // memoizable unless a test perturbs one of the gate's inputs.
        stateless_instance_delegate() -> STATIC_CLOSURE is
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            let closure = STATIC_CLOSURE(loc(), owner, "$anon_0", owner, false)
            closure.type = settled_type()
            closure.is_delegate = true
            closure.is_stateless_delegate = true
            return closure
        si

        @Test()
        Calling__is_memoizable_delegate__for_stateless_instance_delegate__returns_true() is
            is_true(stateless_instance_delegate().is_memoizable_delegate)
        si

        @Test()
        Calling__is_memoizable_delegate__for_self_loading_delegate__returns_false() is
            // `() => self` returns the receiver, so its result depends on
            // self even with no captured values; it must not be shared.
            let closure = stateless_instance_delegate()
            closure.note_delegate_body_loads_self()

            is_false(closure.is_memoizable_delegate)
        si

        // The same shape owned by a struct. A struct's instance member
        // holds self as a managed pointer, which cannot be a delegate's
        // target, so the literal has to reach the static shape this gate
        // selects rather than fall through to the receiver-bound one.
        stateless_struct_delegate(arguments: string[]) -> STATIC_CLOSURE is
            let owner = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", arguments, Semantic.BLOCK_SCOPE())
            let closure = STATIC_CLOSURE(loc(), owner, "$anon_0", owner, false)
            closure.type = settled_type()
            closure.is_delegate = true
            closure.is_stateless_delegate = true
            return closure
        si

        @Test()
        Calling__is_memoizable_delegate__for_stateless_struct_delegate__returns_true() is
            is_true(stateless_struct_delegate(System.Array.empty[string]()).is_memoizable_delegate)
        si

        @Test()
        Calling__is_memoizable_delegate__for_generic_struct_delegate__returns_false() is
            // A generic owner is out of scope for the same reason a generic
            // class is: the cache field's reference needs its instantiation.
            is_false(stateless_struct_delegate(["T"]).is_memoizable_delegate)
        si

        @Test()
        Calling__is_memoizable_delegate__for_generic_class_delegate__returns_false() is
            // A static field on a generic class needs the owner's
            // instantiation in its reference, which is out of scope here.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", ["T"], Semantic.BLOCK_SCOPE())
            let closure = STATIC_CLOSURE(loc(), owner, "$anon_0", owner, false)
            closure.type = settled_type()
            closure.is_delegate = true
            closure.is_stateless_delegate = true

            is_false(closure.is_memoizable_delegate)
        si

        @Test()
        Calling__is_memoizable_delegate__with_captured_type_arguments__returns_false() is
            // A literal carrying method-level type arguments has no single
            // ground delegate to cache.
            let closure = memoizable_closure()
            closure.add_type_argument_reference(namespace_owner())

            is_false(closure.is_memoizable_delegate)
        si

        @Test()
        Calling__is_memoizable_delegate__with_unsettled_type__returns_false() is
            // An unresolved function type would render placeholder comments
            // into the cache field's declaration.
            let closure = memoizable_closure()
            closure.type = INFERRED_VARIABLE_TYPE(LOCAL_VARIABLE(loc(), namespace_owner(), "v"))

            is_false(closure.is_memoizable_delegate)
        si

        @Test()
        Calling__is_memoizable_delegate__without_enclosing_namespace__returns_false() is
            // No namespace in the owner chain means nowhere to host the
            // static cache field.
            let owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Owner", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            let closure = STATIC_CLOSURE(loc(), owner, "$anon_0", owner, false)
            closure.type = settled_type()

            is_false(closure.is_memoizable_delegate)
        si

        // A demoted delegate is emitted as a static method: no `instance`
        // in its calling convention and `static` in its flags, matching
        // the null target the load site binds.
    si
si
