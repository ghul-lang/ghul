namespace Semantic.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STATIC_METHOD
    use Semantic.Symbols.TYPE_HOMED_OPERATORS

    use Semantic.Types.Type

    @TestClass()
    class TYPE_HOMED_OPERATORS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        new_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        operator(owner: CLASS, arguments: Type[]) -> STATIC_METHOD is
            let f = STATIC_METHOD(loc(), loc(), owner, "<<", Semantic.BLOCK_SCOPE())
            f.arguments = arguments
            return f
        si

        @Test()
        Arithmetic_bitwise_and_shift_operators__are_homed_on_their_operand_type() is
            for name in ["+", "-", "*", "/", "%", "&", "|", "^", "\\", "<<", ">>", ">>>"] do
                is_true(TYPE_HOMED_OPERATORS.contains(name), "expected {name} to be a type-homed operator")
            od
        si

        @Test()
        Equality_order_boolean_and_range_operators__stay_global() is
            for name in ["==", "=~", "<>", "/\\", "\\/", "!", "¬", "..", "::"] do
                is_false(TYPE_HOMED_OPERATORS.contains(name), "expected {name} to stay global")
            od
        si

        // An intrinsic operator is registered on every distinct type among
        // its parameters, first parameter first, so an asymmetric shift is
        // reachable from its count's type as well as from the value's.
        @Test()
        Calling__homes__on_an_operator_with_one_parameter_type__should_list_it_once() is
            let int_class = new_class("int")

            let homes = TYPE_HOMED_OPERATORS.homes(operator(int_class, LIST[Type]([int_class.type!, int_class.type!])))

            are_equal(1, homes.count)
            are_same(int_class, homes[0])
        si

        @Test()
        Calling__homes__on_an_operator_with_two_parameter_types__should_list_both_first_parameter_first() is
            let long_class = new_class("long")
            let int_class = new_class("int")

            let homes = TYPE_HOMED_OPERATORS.homes(operator(long_class, LIST[Type]([long_class.type!, int_class.type!])))

            are_equal(2, homes.count)
            are_same(long_class, homes[0])
            are_same(int_class, homes[1])
        si
    si
si
