namespace Semantic.Symbols.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Position is the only thing relating one declaration's type
    // parameters to another's, so the alignment answers for what it
    // can line up and leaves everything else as it found it.
    @TestClass()
    class GENERIC_PARAMETER_ALIGNMENT_TESTS is
        _scope: Semantic.BLOCK_SCOPE

        init() is
            if !LOCATION.internal? then
                LOCATION.init_static()
            fi

            _scope = Semantic.BLOCK_SCOPE()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        // A method's type parameters are distinct symbols in every
        // declaration, which is the whole difficulty; two functions
        // stand in for two declarations of one method.
        parameters_of(name: string, names: string[]) -> Collections.List[Type] is
            let function =
                STATIC_METHOD(loc(), loc(), _scope, name, Semantic.BLOCK_SCOPE())

            let result = LIST[Type]()

            for i in 0..names.count do
                result.add(
                    FUNCTION_GENERIC_ARGUMENT(loc(), function, names[i], i).type!)
            od

            return result
        si

        @Test()
        Rewriting_a_type_parameter__should_answer_with_ours_at_the_same_position() is
            let ours = parameters_of("mine", ["T"])
            let theirs = parameters_of("theirs", ["T"])

            are_same(
                ours[0],
                GENERIC_PARAMETER_ALIGNMENT.rewrite(theirs[0], ours, theirs))
        si

        @Test()
        Rewriting_the_second_of_two__should_answer_with_ours_at_that_position() is
            let ours = parameters_of("mine", ["A", "B"])
            let theirs = parameters_of("theirs", ["A", "B"])

            are_same(
                ours[1],
                GENERIC_PARAMETER_ALIGNMENT.rewrite(theirs[1], ours, theirs))
        si

        @Test()
        Rewriting_against_a_different_count__should_change_nothing() is
            let ours = parameters_of("mine", ["T"])
            let theirs = parameters_of("theirs", ["A", "B"])

            are_same(
                theirs[0],
                GENERIC_PARAMETER_ALIGNMENT.rewrite(theirs[0], ours, theirs))
        si

        @Test()
        Rewriting_with_no_parameters_at_all__should_change_nothing() is
            let none = LIST[Type]()
            let theirs = parameters_of("theirs", ["T"])

            are_same(
                theirs[0],
                GENERIC_PARAMETER_ALIGNMENT.rewrite(theirs[0], none, none))
        si
    si
si
