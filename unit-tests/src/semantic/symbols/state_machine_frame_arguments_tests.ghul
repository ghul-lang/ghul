namespace Semantic.Symbols.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A generator frame carries a pristine copy of each constructor
    // argument, so a rewind can restore what the body started from after
    // the body has written the working field. The IL that stores the
    // copies and the IL that restores from them both walk the two lists
    // in lockstep, so the copies have to be one per argument field, at
    // the same index, and at the same type - including after a
    // re-declare re-derives an argument type that was captured as an
    // inference placeholder. An async frame declares no copies at all,
    // since an async method body runs once.
    @TestClass()
    class STATE_MACHINE_FRAME_ARGUMENTS_TESTS is
        // The frame takes its own owner from the owner's owner, so the
        // class it hangs off needs a scope of its own.
        _scope: Semantic.BLOCK_SCOPE

        init() is
            _scope = Semantic.BLOCK_SCOPE()

            // A completed declare() mints its $state field against the
            // container's innate lookup; the reflection-backed default
            // needs loaded assemblies a unit test does not have.
            Fixtures.use_test_innate_symbol_lookup()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, System.Array.empty[string](), Semantic.BLOCK_SCOPE())

        // A generator whose single argument holds `argument_type`.
        make_generator_frame(argument_type: Types.Type) -> STATE_MACHINE_FRAME is
            let owner = CLASS(loc(), loc(), _scope, "Owner", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            let function = STATIC_METHOD(loc(), loc(), owner, "counting", Semantic.BLOCK_SCOPE())

            function.start_declaring_arguments()
            let argument = cast Variable?(function.declare_variable(loc(), "n", false, null))
            function.end_declaring_arguments()

            function.argument_names = Collections.LIST[string](["n"])

            argument!.set_type(argument_type)

            return STATE_MACHINE_FRAME(owner, function, a_class("Element").type!)
        si

        fields(source: Collections.Iterable[Field]) -> Collections.LIST[Field] is
            let result = Collections.LIST[Field]()

            for f in source do
                result.add(f)
            od

            return result
        si

        @Test()
        A_generator_frames_argument_copies__should_be_one_per_argument_field_at_the_same_type() is
            let argument_type = a_class("Argument").type!
            let frame = make_generator_frame(argument_type)

            frame.declare()

            let working = fields(frame.argument_fields)
            let pristine = frame.argument_initial_fields

            is_true(frame.has_argument_initial_fields)
            are_equal(1, working.count)
            are_equal(working.count, pristine.count)

            for i in 0..working.count do
                are_equal(working[i].type, pristine[i].type)
                are_not_same(working[i], pristine[i])
            od
        si

        // The re-declare at IL-emission time re-derives an argument type
        // captured as a not-yet-settled placeholder. The copy has to be
        // re-derived with it, or a rewind stores the settled type into a
        // field still declared at the placeholder.
        @Test()
        Redeclaring_a_generator_frame_whose_argument_placeholder_settled__should_rederive_both_copies() is
            let owner = CLASS(loc(), loc(), _scope, "Owner", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            let function = STATIC_METHOD(loc(), loc(), owner, "counting", Semantic.BLOCK_SCOPE())

            function.start_declaring_arguments()
            let argument = cast Variable?(function.declare_variable(loc(), "n", false, null))
            function.end_declaring_arguments()

            function.argument_names = Collections.LIST[string](["n"])

            argument!.set_type(Types.INFERRED_VARIABLE_TYPE(argument))

            let frame = STATE_MACHINE_FRAME(owner, function, a_class("Element").type!)

            frame.declare()

            is_true(isa Types.INFERRED_VARIABLE_TYPE(frame.argument_initial_fields[0].type))

            let settled = a_class("Settled").type!

            argument.set_type(settled)

            frame.declare()

            let working = fields(frame.argument_fields)

            are_equal(working[0].type, frame.argument_initial_fields[0].type)
            is_false(isa Types.INFERRED_VARIABLE_TYPE(frame.argument_initial_fields[0].type))
        si

        // The copy's name is derived from the argument's, so it has to be
        // derived in a way that cannot land on another argument's name.
        @Test()
        A_generator_frame_taking_an_argument_named_like_a_copy__should_declare_four_distinct_fields() is
            let owner = CLASS(loc(), loc(), _scope, "Owner", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            let function = STATIC_METHOD(loc(), loc(), owner, "counting", Semantic.BLOCK_SCOPE())

            let argument_type = a_class("Argument").type!

            function.start_declaring_arguments()
            let n = cast Variable?(function.declare_variable(loc(), "n", false, null))
            let n_initial = cast Variable?(function.declare_variable(loc(), "n_initial", false, null))
            function.end_declaring_arguments()

            function.argument_names = Collections.LIST[string](["n", "n_initial"])

            n!.set_type(argument_type)
            n_initial!.set_type(argument_type)

            let frame = STATE_MACHINE_FRAME(owner, function, a_class("Element").type!)

            frame.declare()

            let names = Collections.SET[string]()

            for f in frame.argument_fields do
                names.add(f.name)
            od

            for f in frame.argument_initial_fields do
                names.add(f.name)
            od

            are_equal(4, names.count)
        si

        @Test()
        An_async_frame__should_declare_no_argument_copies() is
            let owner = CLASS(loc(), loc(), _scope, "Owner", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            let function = STATIC_METHOD(loc(), loc(), owner, "do_async", Semantic.BLOCK_SCOPE())

            function.start_declaring_arguments()
            let argument = cast Variable?(function.declare_variable(loc(), "n", false, null))
            function.end_declaring_arguments()

            function.argument_names = Collections.LIST[string](["n"])

            argument!.set_type(a_class("Argument").type!)

            let frame = ASYNC_STATE_MACHINE_FRAME(owner, function, a_class("Result").type!, false)

            frame.declare()

            is_false(frame.has_argument_initial_fields)
            are_equal(0, frame.argument_initial_fields.count)
        si
    si
si
