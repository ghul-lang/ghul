namespace Tests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use NSubstitute

    use Source.LOCATION

    use Semantic.Capability
    use Semantic.CAPABILITY_CHECKER
    use Semantic.DOTNET_TARGET_CAPABILITIES
    use Semantic.WASM_TARGET_CAPABILITIES
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class CAPABILITY_CHECKER_TESTS is
        init() is
        si

        _logger() -> Logging.Logger =>
            NSubstitute.Substitute.`for`[Logging.Logger](System.Array.empty`[object]())

        @Test()
        DotNetTarget_SupportsEverything() is
            let capabilities = DOTNET_TARGET_CAPABILITIES()

            is_true(capabilities.is_supported(Capability.IL_PRAGMA))
            are_equal("dotnet", capabilities.target_name)
        si

        @Test()
        WasmTarget_SupportsNothingInTheEnum() is
            let capabilities = WASM_TARGET_CAPABILITIES()

            is_false(capabilities.is_supported(Capability.IL_PRAGMA))
            are_equal("wasm", capabilities.target_name)
        si

        @Test()
        Check_Unsupported_ReportsAndReturnsFalse() is
            let logger = _logger()
            let checker = CAPABILITY_CHECKER(WASM_TARGET_CAPABILITIES(), logger)

            // One instance shared by the check and the assertion, since a
            // LOCATION compares by identity.
            let location = LOCATION("test.ghul", 1, 1, 1, 1)

            is_false(checker.check(Capability.IL_PRAGMA, location, "pragma IL.name"))

            NSubstitute.SubstituteExtensions.received[Logging.Logger](logger).error(location, "pragma IL.name not supported on the wasm target")
        si

        @Test()
        Check_Supported_ReturnsTrueAndReportsNothing() is
            let logger = _logger()
            let checker = CAPABILITY_CHECKER(DOTNET_TARGET_CAPABILITIES(), logger)

            let location = LOCATION("test.ghul", 1, 1, 1, 1)

            is_true(checker.check(Capability.IL_PRAGMA, location, "pragma IL.name"))

            NSubstitute.SubstituteExtensions.did_not_receive[Logging.Logger](logger).error(location, "pragma IL.name not supported on the dotnet target")
        si
    si
si
