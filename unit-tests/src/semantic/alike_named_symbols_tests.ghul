namespace Semantic.UnitTests is
    use Collections.LIST
    use Ghul.Pipes

    use NSubstitute
    use NSubstitute.SubstituteExtensions.returns

    use Source.LOCATION

    use Semantic.Scope

    use Semantic.Symbols.Symbol
    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.GENERIC

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class ALIKE_NAMED_SYMBOLS_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        a_namespace(name: string) -> NAMESPACE =>
            NAMESPACE(loc(), name, null, ".{name}", false)

        a_class(owner: Scope, name: string) -> CLASS =>
            CLASS(loc(), loc(), owner, name, LIST[string](), Semantic.BLOCK_SCOPE())

        a_generic_head(owner: Scope, name: string) -> CLASS is
            let parameters = LIST[string]()
            parameters.add("T")

            return CLASS(loc(), loc(), owner, name, parameters, Semantic.BLOCK_SCOPE())
        si

        a_generic(owner: Scope, name: string, argument: Type) -> Type =>
            constructed(a_generic_head(owner, name), argument)

        constructed(head: CLASS, argument: Type) -> Type is
            let arguments = LIST[Type]()
            arguments.add(argument)

            return GENERIC(loc(), head, arguments).type
        si

        scope_resolving(name: string, symbol: Symbol) -> Scope is
            let scope = Substitute.`for`[Scope](System.Array.empty`[object]())
            scope.find_enclosing(name) |> returns(symbol, null)
            return scope
        si

        contains(symbols: Symbol[], symbol: Symbol) -> bool =>
            symbols |> any(s => s == symbol)

        @Test()
        Calling__add__with_two_distinct_types_of_the_same_name__finds_both() is
            let alpha = a_class(a_namespace("Alpha"), "POINT")
            let beta = a_class(a_namespace("Beta"), "POINT")

            let alike = ALIKE_NAMED_SYMBOLS()

            alike.add(alpha.type)
            alike.add(beta.type)

            are_equal(2, alike.symbols.count)
            is_true(contains(alike.symbols, alpha))
            is_true(contains(alike.symbols, beta))
        si

        @Test()
        Calling__add__with_the_same_type_twice__finds_nothing() is
            let alpha = a_class(a_namespace("Alpha"), "POINT")

            let alike = ALIKE_NAMED_SYMBOLS()

            alike.add(alpha.type)
            alike.add(alpha.type)

            are_equal(0, alike.symbols.count)
        si

        @Test()
        Calling__add__with_differently_named_types__finds_nothing() is
            let alpha = a_class(a_namespace("Alpha"), "POINT")
            let beta = a_class(a_namespace("Beta"), "LINE")

            let alike = ALIKE_NAMED_SYMBOLS()

            alike.add(alpha.type)
            alike.add(beta.type)

            are_equal(0, alike.symbols.count)
        si

        @Test()
        Calling__add__with_a_clash_inside_a_type_argument__finds_both() is
            let alpha = a_class(a_namespace("Alpha"), "POINT")
            let beta = a_class(a_namespace("Beta"), "POINT")

            let alike = ALIKE_NAMED_SYMBOLS()

            alike.add(a_generic(a_namespace("Gamma"), "BOX", alpha.type!))
            alike.add(beta.type)

            are_equal(2, alike.symbols.count)
            is_true(contains(alike.symbols, alpha))
            is_true(contains(alike.symbols, beta))
        si

        @Test()
        Calling__add__with_two_constructions_of_one_generic__finds_nothing() is
            let head = a_generic_head(a_namespace("Gamma"), "BOX")
            let alpha = a_class(a_namespace("Alpha"), "POINT")
            let line = a_class(a_namespace("Alpha"), "LINE")
            let box = constructed(head, alpha.type!)
            let other_box = constructed(head, line.type!)

            let alike = ALIKE_NAMED_SYMBOLS()

            alike.add(box)
            alike.add(other_box)

            are_equal(0, alike.symbols.count)
        si

        @Test()
        Calling__name_for__while_qualifying__renders_only_the_alike_symbols_qualified() is
            let alpha = a_class(a_namespace("Alpha"), "POINT")
            let beta = a_class(a_namespace("Beta"), "POINT")
            let line = a_class(a_namespace("Alpha"), "LINE")

            let display = NAME_DISPLAY()

            let use render_scope = display.with_scope(scope_resolving("POINT", alpha))

            let alike = ALIKE_NAMED_SYMBOLS()

            alike.add(alpha.type)
            alike.add(beta.type)

            _assert_qualified(display, alike, alpha, line)

            are_equal("POINT", display.name_for(alpha))
            are_equal("POINT", display.short_name_for(alpha))
        si

        _assert_qualified(display: NAME_DISPLAY, alike: ALIKE_NAMED_SYMBOLS, alpha: Symbol, line: Symbol) is
            let use qualified = display.qualifying(alike)

            are_equal("Alpha.POINT", display.name_for(alpha))
            are_equal("Alpha.POINT", display.short_name_for(alpha))
            are_equal("LINE", display.short_name_for(line))
        si
    si
si
