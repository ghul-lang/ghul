namespace Semantic.DotNet.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Semantic.DotNet.SCALAR_CONVERSION_SOURCES
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Ghul.Pipes

    @TestClass()
    class SCALAR_CONVERSION_SOURCES_TESTS is
        init() is si

        _scalars() -> System.Type[] =>
            [
                typeof byte, typeof ubyte, typeof short, typeof ushort,
                typeof int, typeof uint, typeof long, typeof ulong,
                typeof single, typeof double, typeof decimal, typeof char,
                typeof bigint
            ]

        @Test()
        Int_needs_a_constructor_from_every_scalar() is
            let sources = SCALAR_CONVERSION_SOURCES.needing_constructor(typeof int, _scalars())

            are_equal(_scalars().count, sources.count)
        si

        @Test()
        Decimal_keeps_its_own_constructors_from_the_wider_numeric_types() is
            let sources = SCALAR_CONVERSION_SOURCES.needing_constructor(typeof decimal, _scalars())

            for own in [typeof int, typeof uint, typeof long, typeof ulong, typeof single, typeof double] do
                is_false(sources |> any(s => s == own), "decimal should keep its own constructor from {own}")
            od

            for added in [typeof byte, typeof short, typeof char, typeof bigint, typeof decimal] do
                is_true(sources |> any(s => s == added), "decimal needs a constructor from {added}")
            od
        si

        @Test()
        Bigint_keeps_its_own_constructors_from_the_wider_numeric_types() is
            let sources = SCALAR_CONVERSION_SOURCES.needing_constructor(typeof bigint, _scalars())

            for own in [typeof int, typeof uint, typeof long, typeof ulong, typeof single, typeof double, typeof decimal] do
                is_false(sources |> any(s => s == own), "bigint should keep its own constructor from {own}")
            od

            is_true(sources |> any(s => s == typeof char), "bigint needs a constructor from char")
        si
    si
si
