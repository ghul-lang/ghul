namespace Semantic.DotNet.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Semantic.DotNet.ASSEMBLY_INFO

    // Pins how an --assembly-info-string value is matched to an
    // attribute's string-only constructors.
    @TestClass()
    class ASSEMBLY_INFO_ARGUMENTS_TESTS is
        init() is si

        _arities(values: int[]) -> Collections.LIST[int] => Collections.LIST[int](values)

        @Test()
        A_one_string_constructor_takes_the_whole_value_commas_and_all() is
            let arguments = ASSEMBLY_INFO.arguments_for(_arities([1]), "one, two")

            is_true(arguments?)

            if let found = arguments then
                are_equal(1, found.count)
                are_equal("one, two", found[0])
            fi
        si

        @Test()
        A_two_string_constructor_takes_the_value_split_at_its_first_comma() is
            let arguments = ASSEMBLY_INFO.arguments_for(_arities([2]), "RepositoryUrl, https://example.com/a,b")

            is_true(arguments?)

            if let found = arguments then
                are_equal(2, found.count)
                are_equal("RepositoryUrl", found[0])
                are_equal("https://example.com/a,b", found[1])
            fi
        si

        @Test()
        The_one_string_constructor_is_preferred_where_both_exist() is
            let arguments = ASSEMBLY_INFO.arguments_for(_arities([2, 1]), "a,b")

            if let found = arguments then
                are_equal(1, found.count)
            else
                is_true(false)
            fi
        si

        @Test()
        A_value_with_no_comma_fits_no_two_string_constructor() is
            is_true(!ASSEMBLY_INFO.arguments_for(_arities([2]), "no comma")?)
        si

        @Test()
        No_string_only_constructor_fits_nothing() is
            is_true(!ASSEMBLY_INFO.arguments_for(_arities([]), "anything")?)
        si

        @Test()
        The_string_only_constructors_of_AssemblyMetadataAttribute_take_two_strings() is
            let arities = ASSEMBLY_INFO.string_constructor_arities(typeof System.Reflection.AssemblyMetadataAttribute, typeof string)

            are_equal(1, arities.count)
            are_equal(2, arities[0])
        si
    si
si
