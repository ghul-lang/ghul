namespace Semantic.DotNet.UnitTests is
    use Semantic.DotNet.REFERENCED_ASSEMBLIES
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class REFERENCED_ASSEMBLIES_TESTS is
        init() is si

        _references() -> REFERENCED_ASSEMBLIES =>
            REFERENCED_ASSEMBLIES(
                name => if name =~ "System.Runtime" then "10:0:0:0" else null fi,
                name => if name =~ "System.Runtime" then _TOKEN else null fi)

        _TOKEN: ubyte[] static => [0xB0ub, 0x3Fub, 0x5Fub, 0x7Fub, 0x11ub, 0xD5ub, 0x0Aub, 0x3Aub]

        @Test()
        A_loaded_assembly_is_referenced_at_its_own_version() is
            are_equal("10:0:0:0", _references().version_of("System.Runtime"))
        si

        @Test()
        A_name_no_loaded_assembly_answers_to_takes_the_default() is
            are_equal(REFERENCED_ASSEMBLIES.DEFAULT_VERSION, _references().version_of("Not.Loaded"))
        si

        @Test()
        A_loaded_assembly_is_referenced_with_its_own_public_key_token() is
            let token = _references().public_key_token_of("System.Runtime")

            is_true(token?)

            if let found = token then
                are_equal(_TOKEN.count, found.count)

                for at in 0..found.count do
                    are_equal(_TOKEN[at], found[at])
                od
            fi
        si

        @Test()
        A_name_no_loaded_assembly_answers_to_has_no_token() is
            is_true(!_references().public_key_token_of("Not.Loaded")?)
        si

        @Test()
        Asking_records_nothing_that_changes_a_later_answer() is
            let references = _references()

            references.version_of("Not.Loaded")

            are_equal(REFERENCED_ASSEMBLIES.DEFAULT_VERSION, references.version_of("Not.Loaded"))
            are_equal("10:0:0:0", references.version_of("System.Runtime"))
        si
    si
si
