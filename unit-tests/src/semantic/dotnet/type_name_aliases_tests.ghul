namespace Semantic.DotNet.UnitTests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Semantic.DotNet.TYPE_NAME_ALIASES

    @TestClass()
    class TYPE_NAME_ALIASES_TESTS is
        init() is si

        @Test()
        An_old_name_is_renamed_to_the_name_it_was_added_with() is
            let aliases = TYPE_NAME_ALIASES()

            aliases.add("System.Exception", "Ghul.Exception")

            are_equal("Ghul.Exception", aliases.renamed("System.Exception"))
        si

        @Test()
        A_new_name_is_not_renamed() is
            let aliases = TYPE_NAME_ALIASES()

            aliases.add("System.Exception", "Ghul.Exception")

            is_null(aliases.renamed("Ghul.Exception"))
        si

        @Test()
        A_name_that_was_never_added_is_not_renamed() is
            let aliases = TYPE_NAME_ALIASES()

            aliases.add("System.Exception", "Ghul.Exception")

            is_null(aliases.renamed("System.Text.Encoding"))
        si

        // The match is the whole qualified name: a member of a renamed
        // type, or a type in a namespace sharing the old name's prefix,
        // is reached through the type's symbol rather than by renaming.
        @Test()
        A_longer_name_starting_with_an_old_name_is_not_renamed() is
            let aliases = TYPE_NAME_ALIASES()

            aliases.add("System.Text.StringBuilder", "Text.STRING_BUILDER")

            is_null(aliases.renamed("System.Text.StringBuilder.append"))
            is_null(aliases.renamed("System.Text"))
        si

        @Test()
        Names_are_matched_with_their_case() is
            let aliases = TYPE_NAME_ALIASES()

            aliases.add("Collections.KeyValuePair", "Collections.KEY_VALUE_PAIR")

            is_null(aliases.renamed("Collections.keyvaluepair"))
            are_equal("Collections.KEY_VALUE_PAIR", aliases.renamed("Collections.KeyValuePair"))
        si

        @Test()
        Aliasing_a_name_to_itself_is_refused() is
            let aliases = TYPE_NAME_ALIASES()

            is_true(_refuses(() -> void => aliases.add("Ghul.Exception", "Ghul.Exception")))
        si

        // A chain would make the new name of one alias the old name of
        // another; one rewrite has to reach the type's own name.
        @Test()
        Aliasing_to_another_old_name_is_refused() is
            let aliases = TYPE_NAME_ALIASES()

            aliases.add("Old.Name", "Middle.Name")

            is_true(_refuses(() -> void => aliases.add("Older.Name", "Old.Name")))
        si

        @Test()
        Aliasing_from_another_alias_target_is_refused() is
            let aliases = TYPE_NAME_ALIASES()

            aliases.add("Older.Name", "Old.Name")

            is_true(_refuses(() -> void => aliases.add("Old.Name", "Middle.Name")))
        si

        _refuses(add: () -> void) -> bool is
            try
                add()
            catch e: Ghul.AssertFailedException
                return true
            yrt

            return false
        si
    si
si
