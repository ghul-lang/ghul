namespace Semantic.DotNet.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Semantic.DotNet.TYPE_DETAILS_LOOKUP
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    use Ghul.Pipes

    @TestClass()
    class TYPE_DETAILS_LOOKUP_TESTS is
        init() is si

        _method(name: string) -> System.Reflection.MethodInfo =>
            (typeof System.Linq.Enumerable).get_methods() |> filter(m => m.name =~ name) |> first()!

        @Test()
        Constructor_intrinsic_is_found_under_the_generic_definition_of_its_return_type() is
            let lookup = TYPE_DETAILS_LOOKUP()
            let to_list = _method("ToList")

            lookup.register_constructor_intrinsic(to_list)

            are_equal(1, lookup.constructor_intrinsics_for(typeof Collections.LIST[_]) |> count())
            are_equal(0, lookup.array_constructor_intrinsics |> count())
        si

        @Test()
        Constructor_intrinsic_returning_an_array_is_found_among_the_array_constructors() is
            let lookup = TYPE_DETAILS_LOOKUP()

            lookup.register_constructor_intrinsic(_method("ToArray"))

            are_equal(1, lookup.array_constructor_intrinsics |> count())
            are_equal(0, lookup.constructor_intrinsics_for(typeof Collections.LIST[_]) |> count())
        si

        @Test()
        Type_with_no_constructor_intrinsics_has_none() is
            let lookup = TYPE_DETAILS_LOOKUP()

            are_equal(0, lookup.constructor_intrinsics_for(typeof string) |> count())
        si
    si
si
