namespace Semantic.UnitTests is
    use Source.LOCATION

    use Semantic.Symbols.INFERRED_RESULT_ORIGIN
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class AWAITED_LOCAL_TESTS is
        init() is
            if !IoC.CONTAINER.instance.local_id_generator? then
                IoC.CONTAINER.instance.local_id_generator = IR.LOCAL_ID_GENERATOR()
            fi

            IoC.CONTAINER.instance.local_id_generator.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        @Test()
        Calling__is_awaited_local__with_a_local_variable_placeholder__should_be_true() is
            is_true(AWAITED_LOCAL.is_awaited_local(INFERRED_VARIABLE_TYPE(LOCAL_VARIABLE(loc(), Semantic.BLOCK_SCOPE(), "d"))))
        si

        @Test()
        Calling__is_awaited_local__with_a_result_origin_placeholder__should_be_false() is
            is_false(AWAITED_LOCAL.is_awaited_local(INFERRED_VARIABLE_TYPE(INFERRED_RESULT_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "$f"))))
        si

        @Test()
        Calling__is_awaited_local__with_a_type_argument_placeholder__should_be_false() is
            is_false(AWAITED_LOCAL.is_awaited_local(INFERRED_VARIABLE_TYPE(INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "B"))))
        si

        @Test()
        Calling__is_awaited_local__with_nothing__should_be_false() is
            is_false(AWAITED_LOCAL.is_awaited_local(null))
        si
    si
si
