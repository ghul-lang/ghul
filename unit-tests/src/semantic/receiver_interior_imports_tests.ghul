namespace Semantic.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.NAMESPACE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class RECEIVER_INTERIOR_IMPORTS_TESTS is
        init() is si

        loc() -> LOCATION is
            if !LOCATION.reflected? then
                LOCATION.init_static()
            fi

            return LOCATION.reflected
        si

        // A reflected member whose owner renders the given ghūl
        // qualified name — the shape the curation matches on. The
        // fixture declares no parameters, which is what keeps the
        // scalar-argument entries answerable without an innate lookup.
        reflected_member(namespace_name: string, class_name: string, member_name: string) -> INSTANCE_METHOD is
            let ns = NAMESPACE(loc(), namespace_name, null, ".{namespace_name}", false)
            let owner = CLASS(loc(), loc(), ns, class_name, LIST[string](), Semantic.BLOCK_SCOPE())

            return INSTANCE_METHOD(loc(), loc(), owner, member_name, Semantic.BLOCK_SCOPE())
        si

        @Test()
        Curated_collection_mutators__write_only_receiver_interior() is
            is_true(reflected_member("Collections", "LIST", "add").writes_only_receiver_interior)
            is_true(reflected_member("Collections", "LIST", "clear").writes_only_receiver_interior)
            is_true(reflected_member("Collections", "STACK", "push").writes_only_receiver_interior)
            is_true(reflected_member("Collections", "STACK", "pop").writes_only_receiver_interior)
        si

        @Test()
        Curated_scalar_argument_mutator__writes_only_receiver_interior() is
            is_true(
                reflected_member("Text", "STRING_BUILDER", "append").writes_only_receiver_interior)
        si

        @Test()
        Uncurated_sibling_member__is_not_receiver_interior() is
            // `remove` and `add_range` share their owner with curated
            // entries but run user code — the element type's equality
            // and an arbitrary sequence respectively — so a too-broad
            // match would sweep them in.
            is_false(reflected_member("Collections", "LIST", "remove").writes_only_receiver_interior)
            is_false(reflected_member("Collections", "LIST", "add_range").writes_only_receiver_interior)
        si

        @Test()
        Store_free_member__is_receiver_interior_too() is
            // The weaker question must answer yes wherever the
            // stronger one does, so a call site can ask it alone.
            let read = reflected_member("Collections", "LIST", "count")

            is_true(read.is_store_free)
            is_true(read.writes_only_receiver_interior)
        si

        @Test()
        Member_declared_in_source__is_not_receiver_interior() is
            // Curation applies to imports. A ghūl-declared member of
            // the same name is analysed, not trusted.
            let source_location = LOCATION("test.ghul", 1, 1, 1, 1)
            let ns = NAMESPACE(loc(), "Collections", null, ".Collections", false)
            let owner = CLASS(loc(), loc(), ns, "LIST", LIST[string](), Semantic.BLOCK_SCOPE())

            let declared =
                INSTANCE_METHOD(source_location, source_location, owner, "add", Semantic.BLOCK_SCOPE())

            is_false(declared.writes_only_receiver_interior)
        si
    si
si
