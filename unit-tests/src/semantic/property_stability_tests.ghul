namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.INSTANCE_PROPERTY
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The declared-stable contract on the property symbol: where the
    // mark lives (the read accessor when there is one, the property
    // itself for a body-less declaration) and what it does to the
    // narrowing gate.
    @TestClass()
    class PROPERTY_STABILITY_TESTS is
        init() is si

        loc() -> LOCATION is
            return LOCATION.reflected
        si

        make_owner() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestOwner", LIST[string](), Semantic.BLOCK_SCOPE())

        make_property(owner: CLASS, name: string) -> INSTANCE_PROPERTY => INSTANCE_PROPERTY(loc(), loc(), owner, name, false, false)

        make_getter(owner: CLASS) -> INSTANCE_METHOD => INSTANCE_METHOD(loc(), loc(), owner, "$get_v", Semantic.BLOCK_SCOPE())

        @Test()
        Is_declared_stable__reports_the_read_functions_mark() is
            let owner = make_owner()
            let property = make_property(owner, "v")
            let getter = make_getter(owner)

            property.read_function = getter
            getter.mark_declared_stable()

            is_true(property.is_declared_stable)
        si

        @Test()
        Is_declared_stable__falls_back_to_the_property_mark_without_getter() is
            let owner = make_owner()
            let property = make_property(owner, "v")

            property.mark_declared_stable()

            is_true(property.is_declared_stable)
        si

        @Test()
        Is_declared_stable__false_when_neither_side_is_marked() is
            let owner = make_owner()
            let property = make_property(owner, "v")
            let getter = make_getter(owner)

            property.read_function = getter

            is_false(property.is_declared_stable)
        si

        @Test()
        Narrowable_getter__accepts_a_declared_stable_getter() is
            let owner = make_owner()
            let property = make_property(owner, "v")
            let getter = make_getter(owner)

            property.read_function = getter
            getter.mark_declared_stable()

            is_true(property.narrowable_getter)
        si

        @Test()
        Narrowable_getter__refuses_an_unmarked_getter() is
            let owner = make_owner()
            let property = make_property(owner, "v")
            let getter = make_getter(owner)

            property.read_function = getter

            is_false(property.narrowable_getter)
        si
    si
si
