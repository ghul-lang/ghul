namespace Semantic.UnitTests is
    use Collections.LIST

    use NSubstitute
    use NSubstitute.SubstituteExtensions.returns

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.AWAITABLE_RESOLVER

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.STATIC_METHOD
    use Semantic.Symbols.INSTANCE_PROPERTY

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins AWAITABLE_RESOLVER's decision table: which members make a
    // type awaitable, which of them are refused, and how the notify
    // interface picks the builder registration. The IL the resolved
    // members drive is covered by the `await-*` integration tests.
    @TestClass()
    class AWAITABLE_RESOLVER_TESTS is
        _bool_type: Type
        _int_type: Type
        _void_type: Type
        _notify: CLASS
        _critical: CLASS
        _logger: DIAGNOSTICS_STORE
        _resolver: AWAITABLE_RESOLVER

        init() is
            _bool_type = new_class("bool").type!
            _int_type = new_class("int").type!
            _void_type = Semantic.Symbols.VOID_STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "void", LIST[string](), Semantic.BLOCK_SCOPE()).type!
            _notify = new_class("INotifyCompletion")
            _critical = new_class("ICriticalNotifyCompletion")
            _critical.add_ancestor(_notify.type!)

            let arguments = System.Array.empty`[object]()
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments)
            lookup.get_bool_type() |> returns(_bool_type, null)
            lookup.get_notify_completion_type() |> returns(_notify.type!, null)
            lookup.get_critical_notify_completion_type() |> returns(_critical.type!, null)

            _logger = DIAGNOSTICS_STORE()
            _resolver = AWAITABLE_RESOLVER(lookup, _logger)
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        new_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        add_method(owner: CLASS, name: string, argument_types: Type[], return_type: Type?) -> INSTANCE_METHOD is
            let f = INSTANCE_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())
            f.arguments = argument_types
            f.return_type = return_type
            owner.add_member(f)
            return f
        si

        add_static_method(owner: CLASS, name: string, return_type: Type) -> STATIC_METHOD is
            let f = STATIC_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())
            f.arguments = LIST[Type]()
            f.return_type = return_type
            owner.add_member(f)
            return f
        si

        // A readable property whose getter returns `type`; `type` null
        // makes it write-only, with no getter at all.
        add_property(owner: CLASS, name: string, type: Type?) -> INSTANCE_PROPERTY is
            let p = INSTANCE_PROPERTY(loc(), loc(), owner, name, false, false)
            if type? then
                let getter = INSTANCE_METHOD(loc(), loc(), owner, "get_{name}", Semantic.BLOCK_SCOPE())
                getter.arguments = LIST[Type]()
                getter.return_type = type
                p.read_function = getter
                p.set_type(type)
            fi
            owner.add_member(p)
            return p
        si

        // A complete awaiter: `is_completed: bool`, `get_result() -> result`,
        // implementing `interface` when given.
        awaiter(result: Type?, interface: CLASS?) -> CLASS is
            let a = new_class("AWAITER")
            add_property(a, "is_completed", _bool_type)
            add_method(a, "get_result", LIST[Type](), result)
            if interface? then
                a.add_ancestor(interface.type!)
            fi
            return a
        si

        awaitable(awaiter_type: Type?) -> CLASS is
            let t = new_class("AWAITABLE")
            add_method(t, "get_awaiter", LIST[Type](), awaiter_type)
            return t
        si

        first_error() -> string is
            for d in _logger.diagnostics_for("test.ghul") do
                return d.text
            od
            return ""
        si

        @Test()
        Resolving__a_complete_critical_awaitable__yields_its_members() is
            let a = awaiter(_int_type, _critical)
            let t = awaitable(a.type)

            let result = _resolver.resolve(loc(), t.type!)

            assert result? else "expected an awaitable"
            are_same(a.type!, result.awaiter_type)
            are_same(_int_type, result.result_type)
            are_equal("get_awaiter", result.get_awaiter.name)
            are_equal("get_result", result.get_result.name)
            is_true(result.is_critical, "ICriticalNotifyCompletion selects the unsafe registration")
            are_equal(0, _logger.error_count)
        si

        @Test()
        Resolving__an_awaiter_that_is_only_INotifyCompletion__is_not_critical() is
            let t = awaitable(awaiter(_int_type, _notify).type)

            let result = _resolver.resolve(loc(), t.type!)

            assert result? else "expected an awaitable"
            is_false(result.is_critical, "INotifyCompletion alone selects the safe registration")
        si

        @Test()
        Resolving__an_awaiter_with_a_void_get_result__yields_a_void_result_type() is
            let t = awaitable(awaiter(_void_type, _critical).type)

            let result = _resolver.resolve(loc(), t.type!)

            assert result? else "expected an awaitable"
            is_true(result.result_type.is_void, "void get_result makes the await void")
        si

        @Test()
        Resolving__an_awaiter_implementing_neither_interface__reports_it() is
            let t = awaitable(awaiter(_int_type, null).type)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            are_equal(1, _logger.error_count)
            is_true(first_error().contains("INotifyCompletion"), first_error())
        si

        @Test()
        Resolving__a_type_with_no_get_awaiter__reports_it() is
            let t = new_class("PLAIN")

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("no get_awaiter method"), first_error())
        si

        // A static `get_awaiter` is not the pattern: the member is
        // called on the operand as its receiver, which a static has
        // no slot for.
        @Test()
        Resolving__a_type_whose_only_get_awaiter_is_static__reports_no_get_awaiter() is
            let t = new_class("STATIC_ONLY")
            add_static_method(t, "get_awaiter", awaiter(_int_type, _critical).type!)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("no get_awaiter method"), first_error())
        si

        // With several overloads, the parameterless instance one is
        // the awaiter accessor; the others are unrelated.
        @Test()
        Resolving__an_overloaded_get_awaiter__picks_the_parameterless_instance_overload() is
            let a = awaiter(_int_type, _critical)
            let t = new_class("OVERLOADED")
            add_method(t, "get_awaiter", LIST[Type]([_int_type]), _int_type)
            let wanted = add_method(t, "get_awaiter", LIST[Type](), a.type)

            let result = _resolver.resolve(loc(), t.type!)

            assert result? else "expected an awaitable"
            are_same(wanted, result.get_awaiter)
        si

        @Test()
        Resolving__a_get_awaiter_returning_void__reports_it() is
            let t = awaitable(_void_type)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("get_awaiter returns no value"), first_error())
        si

        @Test()
        Resolving__an_awaiter_with_no_is_completed__reports_it() is
            let a = new_class("AWAITER")
            add_method(a, "get_result", LIST[Type](), _int_type)
            a.add_ancestor(_critical.type!)
            let t = awaitable(a.type)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("has no is_completed property"), first_error())
        si

        // A write-only `is_completed` has no getter to call, so it is
        // reported the same way as a missing property.
        @Test()
        Resolving__an_awaiter_whose_is_completed_is_write_only__reports_no_is_completed() is
            let a = new_class("AWAITER")
            add_property(a, "is_completed", null)
            add_method(a, "get_result", LIST[Type](), _int_type)
            a.add_ancestor(_critical.type!)
            let t = awaitable(a.type)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("has no is_completed property"), first_error())
        si

        @Test()
        Resolving__an_awaiter_whose_is_completed_is_not_bool__reports_it() is
            let a = new_class("AWAITER")
            add_property(a, "is_completed", _int_type)
            add_method(a, "get_result", LIST[Type](), _int_type)
            a.add_ancestor(_critical.type!)
            let t = awaitable(a.type)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("is_completed is not bool"), first_error())
        si

        @Test()
        Resolving__an_awaiter_with_no_get_result__reports_it() is
            let a = new_class("AWAITER")
            add_property(a, "is_completed", _bool_type)
            a.add_ancestor(_critical.type!)
            let t = awaitable(a.type)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("has no get_result method"), first_error())
        si

        // A `get_result` whose return type never resolved is refused
        // rather than typing the await as nothing.
        @Test()
        Resolving__an_awaiter_whose_get_result_has_no_return_type__reports_it() is
            let a = new_class("AWAITER")
            add_property(a, "is_completed", _bool_type)
            add_method(a, "get_result", LIST[Type](), null)
            a.add_ancestor(_critical.type!)
            let t = awaitable(a.type)

            let result = _resolver.resolve(loc(), t.type!)

            is_null(result)
            is_true(first_error().contains("get_result has no return type"), first_error())
        si
    si
si
