namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.MUT_LOCAL_JOIN
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Symbols.TRAIT
    use Semantic.Types.Type

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class MUT_LOCAL_JOIN_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        build() -> (object_type: Type, animal: Type, cat: Type, dog: Type, named: Type, point: Type) is
            let object_class = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "object", LIST[string](), Semantic.BLOCK_SCOPE())
            object_class.mark_is_object()

            let animal = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Animal", LIST[string](), Semantic.BLOCK_SCOPE())
            animal.add_ancestor(object_class.type!)

            let cat = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "CAT", LIST[string](), Semantic.BLOCK_SCOPE())
            cat.add_ancestor(animal.type!)

            let dog = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "DOG", LIST[string](), Semantic.BLOCK_SCOPE())
            dog.add_ancestor(animal.type!)

            let named = TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Named", LIST[string](), Semantic.BLOCK_SCOPE())

            let point = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "POINT", LIST[string](), Semantic.BLOCK_SCOPE())

            return (object_class.type!, animal.type!, cat.type!, dog.type!, named.type!, point.type!)
        si

        @Test()
        Calling__type_for__with_a_common_class_ancestor__should_return_the_join() is
            let h = build()

            let result = MUT_LOCAL_JOIN().type_for(h.cat, h.animal, LIST[Type]([h.cat, h.dog]))

            are_same(h.animal, result)
        si

        @Test()
        Calling__type_for__with_no_join__should_return_the_initializer() is
            let h = build()

            are_same(h.cat, MUT_LOCAL_JOIN().type_for(h.cat, null, LIST[Type]([h.cat])))
        si

        @Test()
        Calling__type_for__when_the_join_is_object__should_return_the_initializer() is
            let h = build()

            are_same(h.cat, MUT_LOCAL_JOIN().type_for(h.cat, h.object_type, LIST[Type]([h.cat, h.dog])))
        si

        @Test()
        Calling__type_for__when_a_contributor_is_a_value_type__should_return_the_initializer() is
            let h = build()

            are_same(h.cat, MUT_LOCAL_JOIN().type_for(h.cat, h.animal, LIST[Type]([h.cat, h.point])))
        si

        @Test()
        Calling__type_for__when_the_join_is_a_trait_no_contributor_names__should_return_the_trait() is
            // The trait is what the values share: `LIST[int]` and an array
            // joining to `int[]`, or a `Cat` and a `Dog` to `Named`.
            let h = build()

            are_same(h.named, MUT_LOCAL_JOIN().type_for(h.cat, h.named, LIST[Type]([h.cat, h.dog])))
        si

        @Test()
        Calling__type_for__when_the_join_is_a_trait_a_contributor_names__should_return_the_trait() is
            let h = build()

            are_same(h.named, MUT_LOCAL_JOIN().type_for(h.cat, h.named, LIST[Type]([h.cat, h.named])))
        si
    si
si
