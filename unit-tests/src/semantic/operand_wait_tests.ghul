namespace Semantic.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.OPERAND_WAIT
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.INFERRED_RESULT_ORIGIN
    use Semantic.Symbols.INFERRED_TYPE_ARG_ORIGIN
    use Semantic.Symbols.LOCAL_ARGUMENT
    use Semantic.Types.INFERRED_JOIN_TYPE
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Tests for OPERAND_WAIT - which unsettled operand a rule has to wait
    // for, and whether a type holds such a wait.
    //
    // The distinction it draws is the substance of the deferral: a
    // placeholder standing for an argument is typed by the call site on a
    // later walk, so the rule waits; a placeholder standing for a local is
    // settled by that local's own later uses in the same body, and the
    // rule's failure is part of what drives the walk that reaches them.
    @TestClass()
    class OPERAND_WAIT_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        a_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())

        an_argument() -> INFERRED_VARIABLE_TYPE =>
            INFERRED_VARIABLE_TYPE(LOCAL_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "n"))

        // Any origin that is not an argument: what settles it is
        // elsewhere in the body rather than the call site.
        a_local() -> INFERRED_VARIABLE_TYPE =>
            INFERRED_VARIABLE_TYPE(INFERRED_TYPE_ARG_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "a"))

        @Test()
        Calling__is_typed_by_the_call_site__on_an_argument_placeholder__should_return_true() is
            is_true(OPERAND_WAIT.is_typed_by_the_call_site(an_argument()))
        si

        @Test()
        Calling__is_typed_by_the_call_site__on_a_local_placeholder__should_return_false() is
            is_false(OPERAND_WAIT.is_typed_by_the_call_site(a_local()))
        si

        // A call's result waiting on one of its arguments: whatever
        // types the argument types the result.
        a_result_waiting_on_an_input() -> INFERRED_VARIABLE_TYPE is
            let origin = INFERRED_RESULT_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "$call")

            origin.is_reported_by_its_input = true

            return INFERRED_VARIABLE_TYPE(origin)
        si

        @Test()
        Calling__is_typed_by_the_call_site__on_a_result_waiting_on_an_input__should_return_true() is
            is_true(OPERAND_WAIT.is_typed_by_the_call_site(a_result_waiting_on_an_input()))
        si

        @Test()
        Calling__is_typed_by_the_call_site__on_a_result_the_body_settles__should_return_false() is
            let origin = INFERRED_RESULT_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "$return")

            is_false(OPERAND_WAIT.is_typed_by_the_call_site(INFERRED_VARIABLE_TYPE(origin)))
        si

        @Test()
        Calling__is_typed_by_the_call_site__on_a_settled_type__should_return_false() is
            is_false(OPERAND_WAIT.is_typed_by_the_call_site(a_class("cat").type))
        si

        @Test()
        Calling__for_operands__with_an_argument_placeholder_on_the_left__should_return_it() is
            let left = an_argument()

            are_same(cast Semantic.Types.Type?(left), OPERAND_WAIT.for_operands(left, a_class("cat").type))
        si

        @Test()
        Calling__for_operands__with_an_argument_placeholder_on_the_right__should_return_it() is
            let right = an_argument()

            are_same(cast Semantic.Types.Type?(right), OPERAND_WAIT.for_operands(a_class("cat").type, right))
        si

        @Test()
        Calling__for_operands__with_two_local_placeholders__should_return_null() is
            is_null(OPERAND_WAIT.for_operands(a_local(), a_local()))
        si

        @Test()
        Calling__for_operands__with_two_settled_operands__should_return_null() is
            is_null(OPERAND_WAIT.for_operands(a_class("cat").type, a_class("dog").type))
        si

        @Test()
        Calling__is_held_by__on_a_waiting_result__should_return_true() is
            is_true(OPERAND_WAIT.is_held_by(INFERRED_JOIN_TYPE(an_argument())))
        si

        @Test()
        Calling__is_held_by__on_a_variables_own_placeholder__should_return_false() is
            is_false(OPERAND_WAIT.is_held_by(a_local()))
        si

        @Test()
        Calling__is_waiting__on_a_result_waiting_on_an_input__should_return_true() is
            is_true(OPERAND_WAIT.is_waiting(a_result_waiting_on_an_input()))
        si

        @Test()
        Calling__is_waiting__on_a_waiting_join__should_return_true() is
            is_true(OPERAND_WAIT.is_waiting(INFERRED_JOIN_TYPE(an_argument())))
        si

        @Test()
        Calling__is_waiting__on_a_literal_return_still_being_inferred__should_return_false() is
            // A literal's own return is what its body is deciding, not a
            // result waiting on something else.
            let origin = INFERRED_RESULT_ORIGIN(loc(), Semantic.BLOCK_SCOPE(), "$return")

            origin.is_literal_return = true

            is_false(OPERAND_WAIT.is_waiting(INFERRED_VARIABLE_TYPE(origin)))
        si

        @Test()
        Calling__is_waiting__on_a_local_placeholder__should_return_false() is
            is_false(OPERAND_WAIT.is_waiting(a_local()))
        si

        @Test()
        Calling__is_held_by__on_a_settled_type__should_return_false() is
            is_false(OPERAND_WAIT.is_held_by(a_class("cat").type!))
        si
    si
si
