namespace Semantic.UnitTests is
    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Symbols.LOCAL_VARIABLE
    use Semantic.Symbols.NAMESPACE
    use Semantic.Types.INFERRED_VARIABLE_TYPE
    use Semantic.Types.MAYBE
    use Semantic.Types.NULLABLE
    use Semantic.Types.Type
    use Semantic.VALUE_RETURN_PIN

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins VALUE_RETURN_PIN, which decides where a function literal's
    // inferred return settles. A body producing a value type cannot reach
    // a reference-typed slot by the delegate assignment alone - that needs
    // return covariance, which a value-type instantiation does not have -
    // so the conversion is made inside the literal and the return settles
    // at the slot's type. A body producing a reference type is left alone
    // and keeps the more precise type it produced. A slot returning the
    // value-type optional of what the body produced is pinned the same
    // way: a delegate returning `int` is not one returning `int?`.
    @TestClass()
    class VALUE_RETURN_PIN_TESTS is
        init() is
            // LOCAL_VARIABLE's init reads the local id generator; the
            // unsettled-type fixture needs one to build a placeholder.
            if !IoC.CONTAINER.instance.local_id_generator? then
                IoC.CONTAINER.instance.local_id_generator = IR.LOCAL_ID_GENERATOR()
            fi
            IoC.CONTAINER.instance.local_id_generator.enter_function()
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        namespace_owner() -> NAMESPACE => NAMESPACE(loc(), "Test", null, ".Test", false)

        a_class(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, System.Array.empty[string](), Semantic.BLOCK_SCOPE()).type!

        a_struct(name: string) -> Type =>
            STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), name, System.Array.empty[string](), Semantic.BLOCK_SCOPE()).type!

        nullable_over(inner: Type) -> Type =>
            NULLABLE(loc(), STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "Nullable", ["T"], Semantic.BLOCK_SCOPE()), Collections.LIST[Type]([inner]))

        maybe_over(inner: Type) -> Type =>
            MAYBE(loc(), STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "MAYBE", ["T"], Semantic.BLOCK_SCOPE()), Collections.LIST[Type]([inner]))

        @Test()
        Calling__applies_to_slot__for_a_value_type_optional_slot__returns_true() is
            is_true(VALUE_RETURN_PIN.applies_to_slot(nullable_over(a_struct("PRODUCED"))))
        si

        @Test()
        Calling__applies_to_slot__for_a_maybe_slot__returns_false() is
            // MAYBE_RETURN_PIN settles a literal going into a `MAYBE` slot.
            is_false(VALUE_RETURN_PIN.applies_to_slot(maybe_over(a_struct("PRODUCED"))))
        si

        @Test()
        Calling__of__for_a_value_body_into_its_value_type_optional__returns_the_slot() is
            let produced = a_struct("PRODUCED")
            let slot = nullable_over(produced)

            are_same(slot, VALUE_RETURN_PIN.of(slot, produced))
        si

        @Test()
        Calling__of__for_a_value_body_into_another_types_optional__returns_null() is
            is_null(VALUE_RETURN_PIN.of(nullable_over(a_struct("OTHER")), a_struct("PRODUCED")))
        si

        @Test()
        Calling__of__for_an_optional_body_into_a_value_type_optional__returns_null() is
            // Already optional: the body's type needs no pin to be returned.
            let produced = a_struct("PRODUCED")
            let slot = nullable_over(produced)

            is_null(VALUE_RETURN_PIN.of(slot, nullable_over(produced)))
        si

        @Test()
        Calling__applies_to_slot__for_a_class_slot__returns_true() is
            is_true(VALUE_RETURN_PIN.applies_to_slot(a_class("SLOT")))
        si

        @Test()
        Calling__applies_to_slot__for_a_struct_slot__returns_false() is
            // A value-typed slot takes the body's value as it stands:
            // there is no reference for it to be converted to.
            is_false(VALUE_RETURN_PIN.applies_to_slot(a_struct("SLOT")))
        si

        @Test()
        Calling__applies_to_slot__with_no_slot__returns_false() is
            is_false(VALUE_RETURN_PIN.applies_to_slot(null))
        si

        @Test()
        Calling__of__with_no_slot__returns_null() is
            is_null(VALUE_RETURN_PIN.of(null, a_struct("PRODUCED")))
        si

        @Test()
        Calling__of__with_no_produced_type__returns_null() is
            is_null(VALUE_RETURN_PIN.of(a_class("SLOT"), null))
        si

        @Test()
        Calling__of__for_a_reference_body__returns_null() is
            // The body's own type is the more precise one and converts to
            // the slot's by assignment, which is sound for a reference.
            is_null(VALUE_RETURN_PIN.of(a_class("SLOT"), a_class("PRODUCED")))
        si

        @Test()
        Calling__of__for_a_value_body_that_does_not_implement_the_slot__returns_null() is
            // Nothing to settle at: the question of how to convert is the
            // assignability check's, and it reports where it always did.
            is_null(VALUE_RETURN_PIN.of(a_class("SLOT"), a_struct("PRODUCED")))
        si

        // A struct implementing the slot's type, which is the shape the
        // whole class exists for: INT_RANGE implementing Iterable[int]
        // reached through a flat_map slot.
        implementing_struct(slot: Semantic.Symbols.CLASS) -> Semantic.Symbols.STRUCT is
            let produced = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "PRODUCED", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            produced.add_ancestor(slot.type!)
            return produced
        si

        @Test()
        Calling__of__for_a_value_body_implementing_the_slot__returns_the_slot_it_implements() is
            // The case the class is for: the return settles here rather
            // than at the struct, so the box is emitted inside the literal.
            let slot = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "SLOT", System.Array.empty[string](), Semantic.BLOCK_SCOPE())
            let produced = implementing_struct(slot)

            are_same(slot.type, VALUE_RETURN_PIN.of(slot.type, produced.type))
        si

        @Test()
        Calling__of__for_an_unsettled_value_body__returns_null() is
            // Declining while the body's type is unsettled is deliberate:
            // the walk comes round again once it settles, and until then
            // the body keeps the type it had before this rule existed.
            // Nothing is lost, so there is no obligation to record.
            let slot = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "SLOT", System.Array.empty[string](), Semantic.BLOCK_SCOPE())

            let boxed = STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "BOXED", ["T"], Semantic.BLOCK_SCOPE())
            boxed.add_ancestor(slot.type!)

            let arguments = Collections.LIST[Type]()
            arguments.add(INFERRED_VARIABLE_TYPE(LOCAL_VARIABLE(loc(), namespace_owner(), "v")))

            let unsettled = Semantic.Types.GENERIC(loc(), boxed, arguments)

            is_false(unsettled.is_settled)
            is_null(VALUE_RETURN_PIN.of(slot.type, unsettled))
        si
    si
si
