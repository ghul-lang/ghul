namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.TRAIT
    use Semantic.Symbols.STATIC_METHOD
    use Semantic.Symbols.STATIC_SLOT_RESOLVER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class STATIC_SLOT_RESOLVER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        trait_named(name: string) -> TRAIT =>
            TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        class_named(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        slot_in(owner: TRAIT) -> STATIC_METHOD is
            let slot = STATIC_METHOD(loc(), loc(), owner, "try_named", Semantic.BLOCK_SCOPE())

            slot.is_static_interface_virtual = true

            return slot
        si

        @Test()
        A_static_member_a_source_trait_requires_is_a_source_slot() is
            is_true(STATIC_SLOT_RESOLVER.is_source_slot(slot_in(trait_named("Named"))))
        si

        @Test()
        An_ordinary_static_method_is_not_a_source_slot() is
            let ordinary = STATIC_METHOD(loc(), loc(), class_named("Kelvin"), "try_named", Semantic.BLOCK_SCOPE())

            is_false(STATIC_SLOT_RESOLVER.is_source_slot(ordinary))
        si

        // The implementation is the static recorded as filling the slot
        // that the implementing type declares; another type's is not it.
        @Test()
        The_implementation_in_a_type_is_the_static_recorded_for_the_slot_that_the_type_declares() is
            let slot = slot_in(trait_named("Named"))

            let kelvin = class_named("Kelvin")
            let celsius = class_named("Celsius")

            let kelvin_static = STATIC_METHOD(loc(), loc(), kelvin, "try_named", Semantic.BLOCK_SCOPE())
            let celsius_static = STATIC_METHOD(loc(), loc(), celsius, "try_named", Semantic.BLOCK_SCOPE())

            slot.add_overrider(kelvin_static)
            slot.add_overrider(celsius_static)

            are_same(kelvin_static, STATIC_SLOT_RESOLVER.implementation_in(slot, kelvin))
            are_same(celsius_static, STATIC_SLOT_RESOLVER.implementation_in(slot, celsius))
        si

        @Test()
        A_type_that_records_no_static_for_the_slot_has_no_implementation() is
            let slot = slot_in(trait_named("Named"))

            is_null(STATIC_SLOT_RESOLVER.implementation_in(slot, class_named("Kelvin")))
        si
    si
si
