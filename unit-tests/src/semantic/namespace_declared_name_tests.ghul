namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.Symbol
    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.CLASS

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A namespace declared in source takes its name over from a symbol a
    // referenced assembly contributes: what the namespace itself declares
    // is what a redeclaration conflicts with, never what find_direct adds
    // to it.
    @TestClass()
    class NAMESPACE_DECLARED_NAME_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        the_namespace() -> NAMESPACE =>
            NAMESPACE(loc(), "Ghul", null, ".Ghul", false)

        a_class(owner: Semantic.Scope, name: string) -> CLASS =>
            CLASS(loc(), loc(), owner, name, LIST[string](), Semantic.BLOCK_SCOPE())

        @Test()
        find_declared__a_symbol_the_namespace_declares__answers_it() is
            let space = the_namespace()
            let declared = a_class(space, "Math")

            space.put_direct("Math", declared)

            are_same(declared, space.find_declared("Math"))
        si

        @Test()
        find_declared__no_symbol_under_the_name__answers_null() is
            is_null(the_namespace().find_declared("Math"))
        si

        @Test()
        declare_namespace__name_nothing_declares__declares_the_namespace() is
            let space = the_namespace()
            let inner = NAMESPACE(loc(), "Math", space, ".Ghul.Math", false)

            space.declare_namespace(loc(), "Math", inner, null)

            are_same(inner, space.find_declared("Math"))
        si

        @Test()
        declare_namespace__a_declared_symbol_under_the_name__leaves_it_in_place() is
            IoC.CONTAINER.instance.logger = Logging.DIAGNOSTICS_STORE()

            let space = the_namespace()
            let declared = a_class(space, "Math")

            space.put_direct("Math", declared)

            space.declare_namespace(loc(), "Math", NAMESPACE(loc(), "Math", space, ".Ghul.Math", false), null)

            are_same(declared, space.find_declared("Math"))
        si
    si
si
