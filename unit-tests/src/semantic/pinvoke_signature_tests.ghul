namespace Semantic.UnitTests is
    use Collections.LIST

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.PINVOKE_SIGNATURE
    use Semantic.Symbols.CLASS
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A lookup whose scalars answer rather than throwing, which is what
    // a question about which types can cross into a library asks for.
    class PINVOKE_TEST_LOOKUP: TEST_INNATE_SYMBOL_LOOKUP is
        _bool: Type
        _char: Type
        _byte: Type
        _ubyte: Type
        _short: Type
        _ushort: Type
        _uint: Type
        _long: Type
        _ulong: Type
        _word: Type
        _uword: Type
        _single: Type
        _double: Type

        init() is
            super.init()

            _bool = _a_type("Bool")
            _char = _a_type("Char")
            _byte = _a_type("Byte")
            _ubyte = _a_type("UByte")
            _short = _a_type("Short")
            _ushort = _a_type("UShort")
            _uint = _a_type("UInt")
            _long = _a_type("Long")
            _ulong = _a_type("ULong")
            _word = _a_type("Word")
            _uword = _a_type("UWord")
            _single = _a_type("Single")
            _double = _a_type("Double")
        si

        _a_type(name: string) -> Type static is
            let loc = LOCATION("test.ghul", 1, 1, 1, 1)

            return CLASS(loc, loc, Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE()).type!
        si

        get_bool_type() -> Type => _bool
        get_char_type() -> Type => _char
        get_byte_type() -> Type => _byte
        get_ubyte_type() -> Type => _ubyte
        get_short_type() -> Type => _short
        get_ushort_type() -> Type => _ushort
        get_uint_type() -> Type => _uint
        get_long_type() -> Type => _long
        get_ulong_type() -> Type => _ulong
        get_word_type() -> Type => _word
        get_uword_type() -> Type => _uword
        get_single_type() -> Type => _single
        get_double_type() -> Type => _double
    si

    // Tests for PINVOKE_SIGNATURE - which types a call into a shared
    // library may carry.
    //
    // The boundary is laid out by the machine rather than by the
    // runtime, so the answer is: the scalars, a pointer, a ref to a
    // scalar, and a string going in. A string coming back is refused
    // because freeing the buffer is the library's business, and
    // anything the runtime would have to be told how to marshal is
    // refused as well.
    @TestClass()
    class PINVOKE_SIGNATURE_TESTS is
        init() is si

        signature() -> PINVOKE_SIGNATURE => PINVOKE_SIGNATURE(PINVOKE_TEST_LOOKUP())

        lookup() -> PINVOKE_TEST_LOOKUP => PINVOKE_TEST_LOOKUP()

        a_class(name: string) -> Type is
            let loc = LOCATION("test.ghul", 1, 1, 1, 1)

            return CLASS(loc, loc, Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE()).type!
        si

        @Test()
        Calling__can_take__with_a_scalar__should_return_true() is
            let l = lookup()

            is_true(PINVOKE_SIGNATURE(l).can_take(l.get_int_type()))
            is_true(PINVOKE_SIGNATURE(l).can_take(l.get_double_type()))
            is_true(PINVOKE_SIGNATURE(l).can_take(l.get_bool_type()))
        si

        @Test()
        Calling__can_take__with_a_string__should_return_true() is
            let l = lookup()

            is_true(PINVOKE_SIGNATURE(l).can_take(l.get_string_type()))
        si

        @Test()
        Calling__can_take__with_a_class__should_return_false() is
            is_false(signature().can_take(a_class("BOX")))
        si

        @Test()
        Calling__can_take__with_nothing__should_return_false() is
            is_false(signature().can_take(null))
        si

        @Test()
        Calling__can_return__with_a_scalar__should_return_true() is
            let l = lookup()

            is_true(PINVOKE_SIGNATURE(l).can_return(l.get_int_type()))
        si

        @Test()
        Calling__can_return__with_void__should_return_true() is
            let l = lookup()

            is_true(PINVOKE_SIGNATURE(l).can_return(l.get_void_type()))
        si

        @Test()
        Calling__can_return__with_a_string__should_return_false() is
            let l = lookup()

            is_false(PINVOKE_SIGNATURE(l).can_return(l.get_string_type()))
        si

        @Test()
        Calling__can_return__with_a_class__should_return_false() is
            is_false(signature().can_return(a_class("BOX")))
        si

        @Test()
        Calling__can_take_on__with_a_scalar_or_string__should_return_true_on_every_target() is
            let l = lookup()
            let signature = PINVOKE_SIGNATURE(l)

            for target in [Compiler.Target.DOTNET, Compiler.Target.WASM, Compiler.Target.LLVM] do
                is_true(signature.can_take_on(l.get_int_type(), target), "int on {target}")
                is_true(signature.can_take_on(l.get_double_type(), target), "double on {target}")
                is_true(signature.can_take_on(l.get_string_type(), target), "string on {target}")
            od
        si

        a_wrapper(name: string, argument: Type) -> Semantic.Symbols.Classy is
            let loc = LOCATION("test.ghul", 1, 1, 1, 1)

            return CLASS(loc, loc, Semantic.BLOCK_SCOPE(), name, LIST[string](["T"]), Semantic.BLOCK_SCOPE())
        si

        a_ref(pointee: Type) -> Type =>
            Semantic.Types.REFERENCE(LOCATION("test.ghul", 1, 1, 1, 1), a_wrapper("REFERENCE", pointee), LIST[Type]([pointee]))

        an_array(element: Type) -> Type =>
            Semantic.Types.ARRAY(LOCATION("test.ghul", 1, 1, 1, 1), a_wrapper("Array", element), [element])

        @Test()
        refusal_on__a_reference_to_a_scalar__crosses_on_dotnet_and_llvm_but_not_wasm() is
            let l = lookup()
            let signature = PINVOKE_SIGNATURE(l)
            let reference = a_ref(l.get_int_type())

            is_true(!signature.refusal_on(reference, Compiler.Target.DOTNET)?)
            is_true(!signature.refusal_on(reference, Compiler.Target.LLVM)?)
            is_true(signature.refusal_on(reference, Compiler.Target.WASM) =~ Semantic.ExternRefusal.REFERENCE_ON_WASM)
        si

        @Test()
        refusal_on__a_reference_to_a_class__is_refused_on_every_target() is
            let signature = signature()
            let reference = a_ref(a_class("BOX"))

            for target in [Compiler.Target.DOTNET, Compiler.Target.WASM, Compiler.Target.LLVM] do
                is_true(signature.refusal_on(reference, target) =~ Semantic.ExternRefusal.REFERENCE_TO_NON_SCALAR, "on {target}")
            od
        si

        @Test()
        refusal_on__a_byte_array__crosses_on_dotnet_and_llvm_but_not_wasm() is
            let l = lookup()
            let signature = PINVOKE_SIGNATURE(l)
            let bytes = an_array(l.get_ubyte_type())

            is_true(!signature.refusal_on(bytes, Compiler.Target.DOTNET)?)
            is_true(!signature.refusal_on(bytes, Compiler.Target.LLVM)?)
            is_true(signature.refusal_on(bytes, Compiler.Target.WASM) =~ Semantic.ExternRefusal.ARRAY_ON_WASM)
        si

        @Test()
        refusal_on__an_array_of_ints__is_refused_as_not_bytes() is
            let l = lookup()
            let signature = PINVOKE_SIGNATURE(l)
            let ints = an_array(l.get_int_type())

            for target in [Compiler.Target.DOTNET, Compiler.Target.WASM, Compiler.Target.LLVM] do
                is_true(signature.refusal_on(ints, target) =~ Semantic.ExternRefusal.ARRAY_OF_NON_BYTE, "on {target}")
            od
        si

        @Test()
        Calling__can_take_on__with_a_class__should_return_false_on_every_target() is
            let signature = signature()
            let box = a_class("BOX")

            is_false(signature.can_take_on(box, Compiler.Target.DOTNET))
            is_false(signature.can_take_on(box, Compiler.Target.WASM))
            is_false(signature.can_take_on(box, Compiler.Target.LLVM))
        si

        @Test()
        Calling__can_return_on__with_a_string__should_need_ownership_except_on_wasm() is
            let l = lookup()
            let signature = PINVOKE_SIGNATURE(l)
            let text = l.get_string_type()

            is_false(signature.can_return_on(text, Compiler.Target.DOTNET, true))
            is_false(signature.can_return_on(text, Compiler.Target.LLVM, false))
            is_true(signature.can_return_on(text, Compiler.Target.LLVM, true))
            is_true(signature.can_return_on(text, Compiler.Target.WASM, false))
        si

        @Test()
        Calling__can_return_on__with_a_scalar_or_void__should_return_true_on_every_target() is
            let l = lookup()
            let signature = PINVOKE_SIGNATURE(l)

            for target in [Compiler.Target.DOTNET, Compiler.Target.WASM, Compiler.Target.LLVM] do
                is_true(signature.can_return_on(l.get_long_type(), target, false), "long on {target}")
                is_true(signature.can_return_on(l.get_void_type(), target, false), "void on {target}")
            od
        si

        @Test()
        Calling__is_string__should_answer_for_the_string_type_only() is
            let l = lookup()
            let signature = PINVOKE_SIGNATURE(l)

            is_true(signature.is_string(l.get_string_type()))
            is_false(signature.is_string(l.get_int_type()))
            is_false(signature.is_string(null))
        si
    si
si
