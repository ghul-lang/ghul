namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.STRUCT
    use Semantic.Symbols.TRAIT
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // The type-level purity flag on Classy: off for a freshly declared
    // type, set by mark_pure from the `pure` header modifier during
    // declare-symbols, and independent between symbol instances.
    @TestClass()
    class CLASSY_PURITY_TESTS is
        init() is si

        loc() -> LOCATION is
            return LOCATION.reflected
        si

        make_class() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestType", LIST[string](), Semantic.BLOCK_SCOPE())

        make_struct() -> STRUCT => STRUCT(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestStruct", LIST[string](), Semantic.BLOCK_SCOPE())

        make_trait() -> TRAIT => TRAIT(loc(), loc(), Semantic.BLOCK_SCOPE(), "TestTrait", LIST[string](), Semantic.BLOCK_SCOPE())

        @Test()
        Is_pure__false_for_a_freshly_declared_type() is
            is_false(make_class().is_pure)
            is_false(make_struct().is_pure)
            is_false(make_trait().is_pure)
        si

        @Test()
        Mark_pure__sets_the_flag_on_a_class() is
            let c = make_class()

            c.mark_pure()

            is_true(c.is_pure)
        si

        @Test()
        Mark_pure__applies_to_structs_and_traits_alike() is
            let s = make_struct()
            let t = make_trait()

            s.mark_pure()
            t.mark_pure()

            is_true(s.is_pure)
            is_true(t.is_pure)
        si

        @Test()
        Mark_pure__does_not_leak_between_instances() is
            let marked = make_class()
            let other = make_class()

            marked.mark_pure()

            is_true(marked.is_pure)
            is_false(other.is_pure)
        si
    si
si
