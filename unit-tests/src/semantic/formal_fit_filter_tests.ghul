namespace Semantic.UnitTests is
    use Collections.LIST
    use Collections.List

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.FORMAL_FIT_FILTER
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.Function
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Which of two candidates the resolver keeps once their type
    // arguments are bound. The filter answers only where one candidate
    // fits every actual at least as closely as the other; where it
    // cannot separate them it returns null and the caller keeps the
    // ambiguity it had.
    @TestClass()
    class FORMAL_FIT_FILTER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        a_type(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE()).type!

        a_child(name: string, parent: Type) -> Type is
            let result =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())

            result.push_ancestor(parent)

            return result.type!
        si

        a_wild_type() -> Type is
            let owner =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "OWNER", LIST[string](["T"]), Semantic.BLOCK_SCOPE())

            return CLASSY_GENERIC_ARGUMENT(loc(), owner, "T", 0).type!
        si

        a_function(name: string, formals: Type[]) -> Function is
            let result = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())

            let arguments = LIST[Type]()

            for formal in formals do
                arguments.add(formal)
            od

            result.arguments = arguments

            return result
        si

        candidates(functions: Function[]) -> List[Function] is
            let result = LIST[Function]()

            for f in functions do
                result.add(f)
            od

            return result
        si

        actuals(types: Type[]) -> List[Type] is
            let result = LIST[Type]()

            for t in types do
                result.add(t)
            od

            return result
        si

        @Test()
        given_a_non_optional_actual__prefers_the_non_optional_formal() is
            let cat = a_type("CAT")

            let bare = a_function("f", [cat])
            let optional = a_function("f", [cat.as_optional()])

            let picked = FORMAL_FIT_FILTER.pick(candidates([bare, optional]), actuals([cat]))

            assert picked? else "the two formals fit the actual differently"
            are_equal(1, picked.count)
            are_same(bare, picked[0])
        si

        @Test()
        given_a_subtype_actual__prefers_the_exact_formal() is
            let parent = a_type("PARENT")
            let child = a_child("CHILD", parent)

            let exact = a_function("f", [child])
            let widening = a_function("f", [parent])

            let picked = FORMAL_FIT_FILTER.pick(candidates([exact, widening]), actuals([child]))

            assert picked? else "the two formals fit the actual differently"
            are_equal(1, picked.count)
            are_same(exact, picked[0])
        si

        // A candidate the actual cannot reach at all is not one the
        // filter picks against: the resolver would have dropped it
        // before the tie, so seeing one here means the fit question
        // was asked of something it does not describe.
        @Test()
        given_a_formal_the_actual_cannot_reach__declines() is
            let cat = a_type("CAT")

            let optional = a_function("f", [cat.as_optional()])
            let bare = a_function("f", [cat])

            is_null(FORMAL_FIT_FILTER.pick(candidates([optional, bare]), actuals([cat.as_optional()])))
        si

        @Test()
        given_formals_that_fit_alike__declines() is
            let cat = a_type("CAT")

            let first = a_function("f", [cat])
            let second = a_function("f", [cat])

            is_null(FORMAL_FIT_FILTER.pick(candidates([first, second]), actuals([cat])))
        si

        @Test()
        given_a_formal_still_carrying_a_type_variable__declines() is
            let cat = a_type("CAT")

            let bare = a_function("f", [cat])
            let wild = a_function("f", [a_wild_type()])

            is_null(FORMAL_FIT_FILTER.pick(candidates([bare, wild]), actuals([cat])))
        si

        @Test()
        given_a_single_candidate__declines() is
            let cat = a_type("CAT")

            is_null(FORMAL_FIT_FILTER.pick(candidates([a_function("f", [cat])]), actuals([cat])))
        si

        @Test()
        given_a_formal_that_cannot_accept_its_actual__rejects() is
            let cat = a_type("CAT")
            let dog = a_type("DOG")

            is_true(FORMAL_FIT_FILTER.rejects(a_function("f", [dog]), actuals([cat])))
        si

        @Test()
        given_formals_that_accept_their_actuals__does_not_reject() is
            let animal = a_type("ANIMAL")
            let cat = a_child("CAT", animal)

            is_false(FORMAL_FIT_FILTER.rejects(a_function("f", [cat]), actuals([cat])))
            is_false(FORMAL_FIT_FILTER.rejects(a_function("f", [animal]), actuals([cat])))
        si

        // A formal still carrying a type variable says nothing about fit
        // yet, so it never rejects.
        @Test()
        given_a_formal_still_carrying_a_type_variable__does_not_reject() is
            let cat = a_type("CAT")

            is_false(FORMAL_FIT_FILTER.rejects(a_function("f", [a_wild_type()]), actuals([cat])))
        si

        @Test()
        given_a_different_number_of_actuals__does_not_reject() is
            let cat = a_type("CAT")
            let dog = a_type("DOG")

            is_false(FORMAL_FIT_FILTER.rejects(a_function("f", [dog]), actuals([cat, cat])))
        si
    si
si
