namespace Semantic.UnitTests is
    use IoC

    use Semantic.Symbols.NAMESPACE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // `Ghul.Intrinsics` is materialised before any pass runs, so the
    // ambient `use` every namespace block carries resolves against a
    // namespace that already exists. These pin that it exists, that it
    // is the symbol the namespace map aggregates source declarations
    // onto, and that materialising again declares nothing new.
    @TestClass()
    class INTRINSICS_NAMESPACE_TESTS is
        init() is si

        @Test()
        materialise__creates_the_namespace_reachable_from_the_global_scope() is
            let container = IoC.CONTAINER.instance

            Semantic.INTRINSICS_NAMESPACE.materialise(container.symbol_table, container.namespaces)

            let ghul = cast NAMESPACE?(container.symbol_table.global_scope.find_direct("Ghul"))

            is_true(ghul?)

            let intrinsics = cast NAMESPACE?(ghul?.find_direct("Intrinsics"))

            is_true(intrinsics?)
        si

        @Test()
        materialise__is_the_symbol_source_declarations_join() is
            let container = IoC.CONTAINER.instance

            Semantic.INTRINSICS_NAMESPACE.materialise(container.symbol_table, container.namespaces)

            let from_scope =
                cast NAMESPACE?(
                    cast NAMESPACE?(container.symbol_table.global_scope.find_direct("Ghul"))?
                        .find_direct("Intrinsics"))

            let from_map = container.namespaces.try_find_namespace(".Ghul.Intrinsics")

            is_true(from_map?)
            are_same(from_map, from_scope)
        si

        @Test()
        materialise__twice_declares_one_namespace() is
            let container = IoC.CONTAINER.instance

            Semantic.INTRINSICS_NAMESPACE.materialise(container.symbol_table, container.namespaces)

            let first =
                cast NAMESPACE?(
                    cast NAMESPACE?(container.symbol_table.global_scope.find_direct("Ghul"))?
                        .find_direct("Intrinsics"))

            Semantic.INTRINSICS_NAMESPACE.materialise(container.symbol_table, container.namespaces)

            let second =
                cast NAMESPACE?(
                    cast NAMESPACE?(container.symbol_table.global_scope.find_direct("Ghul"))?
                        .find_direct("Intrinsics"))

            is_true(first?)
            are_same(first, second)
        si
    si
si
