namespace Semantic.UnitTests is
    use Collections.LIST

    use NSubstitute
    use NSubstitute.SubstituteExtensions.returns

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.ASYNC_LITERAL_CANDIDATES
    use Semantic.TASK_LIKE_RESOLVER
    use Semantic.Lookups.InnateSymbolLookup

    use Semantic.Symbols.CLASS
    use Semantic.Symbols.FUNCTION_GROUP
    use Semantic.Symbols.INSTANCE_METHOD
    use Semantic.Symbols.INSTANCE_PROPERTY
    use Semantic.Symbols.STATIC_METHOD

    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // Pins how an asynchronous literal with no declared return type
    // settles between same-arity overloads: what a formal is read as
    // asking for, and which candidate the literals' bodies leave
    // standing.
    @TestClass()
    class ASYNC_LITERAL_CANDIDATES_TESTS is
        _int_type: Type
        _ref_carrier: CLASS
        _function_owner: CLASS
        _action_owner: CLASS
        _void_task: CLASS
        _result_task_like: CLASS
        _unit_task_like: CLASS
        _candidates: ASYNC_LITERAL_CANDIDATES
        _logger: DIAGNOSTICS_STORE

        init() is
            _int_type = new_class("int").type!
            _ref_carrier = new_generic("Ref")
            _function_owner = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Function", LIST[string](["A", "R"]), Semantic.BLOCK_SCOPE())
            _action_owner = new_generic("Action")
            _void_task = new_class("Task")
            _result_task_like = new_generic("COROUTINE")
            _result_task_like.async_builder = generic_builder().type
            _unit_task_like = new_class("UNIT_COROUTINE")
            _unit_task_like.async_builder = unit_builder(_unit_task_like).type

            let arguments = System.Array.empty`[object]()
            let lookup = NSubstitute.Substitute.`for`[InnateSymbolLookup](arguments)
            lookup.get_void_task_type() |> returns(_void_task.type, null)

            _logger = DIAGNOSTICS_STORE()
            _candidates = ASYNC_LITERAL_CANDIDATES(lookup, TASK_LIKE_RESOLVER(_logger))
        si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        new_class(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](), Semantic.BLOCK_SCOPE())

        new_generic(name: string) -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, LIST[string](["T"]), Semantic.BLOCK_SCOPE())

        add_member(owner: CLASS, name: string, argument_count: int, return_type: Type?) is
            let f = INSTANCE_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())
            let arguments = LIST[Type]()
            for i in 0..argument_count do
                arguments.add(_int_type)
            od
            f.arguments = arguments
            f.return_type = return_type
            owner.add_member(f)
        si

        add_ref_member(owner: CLASS, name: string, argument_count: int) is
            let f = INSTANCE_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())
            let arguments = LIST[Type]()
            arguments.add(
                Semantic.Types.REFERENCE(
                    loc(), cast Semantic.Symbols.Classy(_ref_carrier), LIST[Type]([_int_type])))
            for i in 1..argument_count do
                arguments.add(_int_type)
            od
            f.arguments = arguments
            f.return_type = null
            owner.add_member(f)
        si

        add_property(owner: CLASS, name: string, type: Type) is
            let p = INSTANCE_PROPERTY(loc(), loc(), owner, name, false, false)
            let getter = INSTANCE_METHOD(loc(), loc(), owner, "get_{name}", Semantic.BLOCK_SCOPE())
            getter.arguments = LIST[Type]()
            getter.return_type = type
            p.read_function = getter
            p.set_type(type)
            owner.add_member(p)
        si

        generic_builder() -> CLASS is
            let b = new_generic("BUILDER")
            add_member(b, "create", 0, b.type!)
            add_ref_member(b, "start", 1)
            add_property(b, "task", new_generic("TASK_LIKE").type!)
            add_member(b, "set_result", 1, null)
            add_member(b, "set_exception", 1, null)
            add_ref_member(b, "await_on_completed", 2)
            add_ref_member(b, "await_unsafe_on_completed", 2)
            return b
        si

        unit_builder(task_like: CLASS) -> CLASS is
            let b = new_class("UNIT_BUILDER")
            add_member(b, "create", 0, b.type!)
            add_ref_member(b, "start", 1)
            add_property(b, "task", task_like.type!)
            add_member(b, "set_result", 0, null)
            add_member(b, "set_exception", 1, null)
            add_ref_member(b, "await_on_completed", 2)
            add_ref_member(b, "await_unsafe_on_completed", 2)
            return b
        si

        // `(int) -> return_type`
        function_returning(return_type: Type) -> Type =>
            Semantic.Types.FUNCTION(loc(), _function_owner, LIST[Type]([_int_type, return_type]))

        // `(int) -> void`
        action() -> Type =>
            Semantic.Types.ACTION(loc(), _action_owner, LIST[Type]([_int_type]))

        result_task_like() -> Type =>
            Semantic.Types.GENERIC(loc(), _result_task_like, LIST[Type]([_int_type]))

        static_method(owner: CLASS, name: string, argument_types: Type[]) -> STATIC_METHOD is
            let f = STATIC_METHOD(loc(), loc(), owner, name, Semantic.BLOCK_SCOPE())
            f.arguments = argument_types
            f.return_type = null
            return f
        si

        literals(values: Collections.Iterable[(index: int, produces_value: bool)]) -> LIST[(index: int, produces_value: bool)] is
            let result = LIST[(index: int, produces_value: bool)]()
            for v in values do result.add(v); od
            return result
        si

        // === formal_asks_for_result ===

        @Test()
        Formal_returning_a_task_like_with_a_result__asks_for_one() is
            is_true(_candidates.formal_asks_for_result(function_returning(result_task_like())) =~ true)
        si

        @Test()
        Formal_returning_a_task_like_without_a_result__asks_for_none() is
            is_true(_candidates.formal_asks_for_result(function_returning(_unit_task_like.type!)) =~ false)
        si

        // Task is not marked with the builder attribute, so it is
        // known by identity rather than resolved.
        @Test()
        Formal_returning_Task__asks_for_none() is
            is_true(_candidates.formal_asks_for_result(function_returning(_void_task.type!)) =~ false)
        si

        @Test()
        Formal_returning_a_plain_type__is_not_a_candidate() is
            is_null(_candidates.formal_asks_for_result(function_returning(_int_type)))
        si

        // A probe of a formal reports nothing, whatever the type: a
        // two-argument generic is refused as a task-like with a
        // diagnostic when it is the chosen return type, and silently
        // when it is only a candidate's formal being looked at.
        @Test()
        Formal_returning_a_two_argument_generic__is_not_a_candidate_and_reports_nothing() is
            let pair = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "MAP", LIST[string](["K", "V"]), Semantic.BLOCK_SCOPE())
            pair.async_builder = generic_builder().type
            let two = Semantic.Types.GENERIC(loc(), pair, LIST[Type]([_int_type, _int_type]))

            is_null(_candidates.formal_asks_for_result(function_returning(two)))

            let reported mut = 0
            for d in _logger.diagnostics_for("test.ghul") do
                reported = reported + 1
            od
            are_equal(0, reported)
        si

        @Test()
        Action_formal__is_not_a_candidate() is
            is_null(_candidates.formal_asks_for_result(action()))
        si

        @Test()
        Non_function_formal__is_not_a_candidate() is
            is_null(_candidates.formal_asks_for_result(_int_type))
        si

        // === pick ===

        @Test()
        Pick__with_a_valued_body__takes_the_result_carrying_overload() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "spawn")
            let unit = static_method(owner, "spawn", LIST[Type]([function_returning(_unit_task_like.type!)]))
            let valued = static_method(owner, "spawn", LIST[Type]([function_returning(result_task_like())]))
            group.add(unit)
            group.add(valued)

            are_same(valued, _candidates.pick(group, literals([(0, true)]), 1, false))
        si

        @Test()
        Pick__with_a_valueless_body__takes_the_result_less_overload() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "spawn")
            let unit = static_method(owner, "spawn", LIST[Type]([function_returning(_unit_task_like.type!)]))
            let valued = static_method(owner, "spawn", LIST[Type]([function_returning(result_task_like())]))
            group.add(unit)
            group.add(valued)

            are_same(unit, _candidates.pick(group, literals([(0, false)]), 1, false))
        si

        @Test()
        Pick__with_no_literal__returns_null() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "spawn")
            group.add(static_method(owner, "spawn", LIST[Type]([function_returning(_unit_task_like.type!)])))

            is_null(_candidates.pick(group, literals([]), 1, false))
        si

        @Test()
        Pick__where_two_candidates_agree__returns_null() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "spawn")
            group.add(static_method(owner, "spawn", LIST[Type]([function_returning(_unit_task_like.type!)])))
            group.add(static_method(owner, "spawn", LIST[Type]([function_returning(_void_task.type!)])))

            is_null(_candidates.pick(group, literals([(0, false)]), 1, false))
        si

        @Test()
        Pick__where_no_candidate_agrees__returns_null() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "spawn")
            group.add(static_method(owner, "spawn", LIST[Type]([function_returning(_unit_task_like.type!)])))
            group.add(static_method(owner, "spawn", LIST[Type]([function_returning(_int_type)])))

            is_null(_candidates.pick(group, literals([(0, true)]), 1, false))
        si

        // A formal that takes no asynchronous literal at all rules its
        // candidate out, whatever the body does.
        @Test()
        Pick__where_the_formal_is_not_a_task_like_function__rules_the_candidate_out() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "run")
            let plain = static_method(owner, "run", LIST[Type]([action()]))
            let unit = static_method(owner, "run", LIST[Type]([function_returning(_unit_task_like.type!)]))
            group.add(plain)
            group.add(unit)

            are_same(unit, _candidates.pick(group, literals([(0, false)]), 1, false))
        si

        @Test()
        Pick__with_two_literals__needs_every_formal_to_agree() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "pair")
            let both_unit = static_method(owner, "pair", LIST[Type]([function_returning(_unit_task_like.type!), function_returning(_unit_task_like.type!)]))
            let mixed = static_method(owner, "pair", LIST[Type]([function_returning(_unit_task_like.type!), function_returning(result_task_like())]))
            group.add(both_unit)
            group.add(mixed)

            are_same(mixed, _candidates.pick(group, literals([(0, false), (1, true)]), 2, false))
            are_same(both_unit, _candidates.pick(group, literals([(0, false), (1, false)]), 2, false))
        si

        @Test()
        Pick__skips_arity_mismatches_and_instance_members_when_not_wanted() is
            let owner = new_class("Owner")
            let group = FUNCTION_GROUP(loc(), owner, "spawn")
            let wrong_arity = static_method(owner, "spawn", LIST[Type]([function_returning(result_task_like()), _int_type]))
            let instance = INSTANCE_METHOD(loc(), loc(), owner, "spawn", Semantic.BLOCK_SCOPE())
            instance.arguments = LIST[Type]([function_returning(result_task_like())])
            instance.return_type = null
            group.add(wrong_arity)
            group.add(instance)

            is_null(_candidates.pick(group, literals([(0, true)]), 1, false))
            are_same(cast Semantic.Symbols.Function(instance), _candidates.pick(group, literals([(0, true)]), 1, true))
        si
    si
si
