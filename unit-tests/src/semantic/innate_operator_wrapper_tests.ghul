namespace Semantic.UnitTests is
    use Collections.LIST

    use Source.LOCATION

    use Logging.DIAGNOSTICS_STORE

    use Semantic.Types.Type

    use Semantic.Symbols.NAMESPACE
    use Semantic.Symbols.INNATE_FUNCTION
    use Semantic.Symbols.INNATE_OPERATOR_WRAPPER
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // A built-in operator named as a value is stood in for by a
    // wrapper method held by the namespace that uses it.
    @TestClass()
    class INNATE_OPERATOR_WRAPPER_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        test_namespace() -> NAMESPACE =>
            NAMESPACE(loc(), "Example", null, ".Example", false)

        operator(name: string, innate_name: string, argument_types: Collections.List[Type], return_type: Type) -> INNATE_FUNCTION is
            let scope = Semantic.BLOCK_SCOPE()
            let result = INNATE_FUNCTION(loc(), scope, name, scope, innate_name)

            let names = LIST[string]()

            for i in 0..argument_types.count do
                names.add("a{i}")
            od

            result.set_arguments(names, argument_types)
            result.return_type = return_type

            return result
        si

        @Test()
        Calling__can_wrap__on_an_operator_over_concrete_types__returns_true() is
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let int_type = lookup.get_int_type()

            let add = operator("+", "arithmetic.add", LIST[Type]([int_type, int_type]), int_type)

            is_true(INNATE_OPERATOR_WRAPPER.can_wrap(add))
        si

        // The wrapper is an ordinary non-generic method, so it cannot
        // take an operand whose type is a type parameter.
        @Test()
        Calling__can_wrap__on_an_operator_over_a_type_parameter__returns_false() is
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let t = Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0).type!

            let equal = operator("==", "compare.value", LIST[Type]([t, t]), lookup.get_bool_type())

            is_false(INNATE_OPERATOR_WRAPPER.can_wrap(equal))
        si

        @Test()
        Calling__innate_operator_wrapper_for__takes_the_operator_signature() is
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let int_type = lookup.get_int_type()
            let bool_type = lookup.get_bool_type()

            let order = operator("<>", "compare.order", LIST[Type]([int_type, bool_type]), int_type)

            let wrapper = test_namespace().innate_operator_wrapper_for(order)

            are_same(order, wrapper.operator)
            are_equal(2, wrapper.arguments.count)
            are_same(int_type, wrapper.arguments[0])
            are_same(bool_type, wrapper.arguments[1])
            are_same(int_type, wrapper.return_type)
            is_false(wrapper.is_public_readable, "expected the wrapper hidden from other assemblies")
            are_equal(order.to_string(), wrapper.to_string(), "expected the wrapper shown as the operator it stands in for")
        si

        // Two symbols for the same operator over the same types - a
        // generic operator specialized at two sites, or a body walked
        // twice - share one wrapper.
        @Test()
        Calling__innate_operator_wrapper_for__twice_with_one_operator__returns_one_wrapper() is
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let int_type = lookup.get_int_type()
            let ns = test_namespace()

            let first = ns.innate_operator_wrapper_for(operator("*", "arithmetic.mul", LIST[Type]([int_type, int_type]), int_type))
            let second = ns.innate_operator_wrapper_for(operator("*", "arithmetic.mul", LIST[Type]([int_type, int_type]), int_type))

            are_same(first, second)
            are_equal(1, ns.innate_operator_wrappers.count)
        si

        @Test()
        Calling__innate_operator_wrapper_for__with_different_operand_types__returns_distinct_wrappers() is
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let int_type = lookup.get_int_type()
            let string_type = lookup.get_string_type()
            let ns = test_namespace()

            let over_int = ns.innate_operator_wrapper_for(operator("-", "arithmetic.sub", LIST[Type]([int_type, int_type]), int_type))
            let over_string = ns.innate_operator_wrapper_for(operator("-", "arithmetic.sub", LIST[Type]([string_type, string_type]), string_type))
            let negate = ns.innate_operator_wrapper_for(operator("-", "arithmetic.neg", LIST[Type]([int_type]), int_type))

            are_not_same(over_int, over_string)
            are_not_same(over_int, negate)
            are_equal(3, ns.innate_operator_wrappers.count)
        si

        // The wrapper captures nothing, so each delegate type it is
        // built as needs one cached delegate.
        @Test()
        Calling__delegate_cache_for__caches_once_per_delegate_type() is
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let int_type = lookup.get_int_type()
            let wrapper = test_namespace().innate_operator_wrapper_for(operator("+", "arithmetic.add", LIST[Type]([int_type, int_type]), int_type))

            let function_type = lookup.get_function_type(LIST[Type]([int_type, int_type, int_type]))
            let other_type = lookup.get_function_type(LIST[Type]([int_type, int_type, lookup.get_bool_type()]))

            let first = wrapper.delegate_cache_for(function_type)
            let second = wrapper.delegate_cache_for(function_type)
            let other = wrapper.delegate_cache_for(other_type)

            are_same(first, second)
            are_not_same(first, other)
            are_equal(2, wrapper.delegate_caches.count)
            are_same(function_type, first.type)
        si

        @Test()
        Calling__clear__on_a_namespace__drops_its_wrappers() is
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let int_type = lookup.get_int_type()
            let ns = test_namespace()

            ns.innate_operator_wrapper_for(operator("+", "arithmetic.add", LIST[Type]([int_type, int_type]), int_type))

            ns.clear()

            are_equal(0, ns.innate_operator_wrappers.count)
        si

        // The value is built from the wrapper, where it used to be
        // rejected with an error.
        @Test()
        Calling__try_load__on_an_innate_operator__builds_a_value_from_its_wrapper() is
            let logger = DIAGNOSTICS_STORE()
            let symbol_table = SYMBOL_TABLE(logger)
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let symbol_loader = SYMBOL_LOADER(logger, symbol_table, FUNCTION_CALLER(symbol_table, IR.VALUE_BOXER(logger)), IR.VALUE_BOXER(logger), lookup)
            let resolver = FUNCTION_REFERENCE_RESOLVER(logger, symbol_table, symbol_loader, lookup, OVERLOAD_RESOLVER(logger))

            let ns = test_namespace()
            symbol_table.enter_scope(ns)

            let int_type = lookup.get_int_type()
            let add = operator("+", "arithmetic.add", LIST[Type]([int_type, int_type]), int_type)

            let result = resolver.try_load(loc(), add, null, null, false)

            assert result? else "expected a value"
            are_equal(0, logger.error_count, "no diagnostic expected")
            are_equal(1, ns.innate_operator_wrappers.count)
            are_same(cast Semantic.Symbols.Function(ns.innate_operator_wrappers[0]), result.referenced_function)
            is_true(isa IR.Values.MEMOIZED_DELEGATE(result), "expected the delegate built once and cached")
            are_equal(1, ns.innate_operator_wrappers[0].delegate_caches.count)
        si

        @Test()
        Calling__try_load__on_an_innate_operator_over_a_type_parameter__reports_an_error() is
            let logger = DIAGNOSTICS_STORE()
            let symbol_table = SYMBOL_TABLE(logger)
            let lookup = TEST_INNATE_SYMBOL_LOOKUP()
            let symbol_loader = SYMBOL_LOADER(logger, symbol_table, FUNCTION_CALLER(symbol_table, IR.VALUE_BOXER(logger)), IR.VALUE_BOXER(logger), lookup)
            let resolver = FUNCTION_REFERENCE_RESOLVER(logger, symbol_table, symbol_loader, lookup, OVERLOAD_RESOLVER(logger))

            let t = Semantic.Symbols.FUNCTION_GENERIC_ARGUMENT(loc(), Semantic.BLOCK_SCOPE(), "T", 0).type!
            let equal = operator("==", "compare.value", LIST[Type]([t, t]), lookup.get_bool_type())

            let result = resolver.try_load(loc(), equal, null, null, false)

            assert result? else "expected a value"
            is_true(result.type!.is_error, "expected an error value")
            are_equal(1, logger.error_count, "expected one diagnostic")
        si
    si
si
