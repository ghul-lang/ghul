namespace Semantic.UnitTests is
    use Collections.LIST
    use Collections.List

    use Microsoft.VisualStudio.TestTools.UnitTesting.Assert

    use Source.LOCATION

    use Semantic.NON_GENERIC_PREFERENCE
    use Semantic.Symbols.CLASS
    use Semantic.Symbols.CLASSY_GENERIC_ARGUMENT
    use Semantic.Symbols.Function
    use Semantic.Symbols.GLOBAL_FUNCTION
    use Semantic.Types.Type
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    // When a non-generic overload counts as at least as specific as a
    // specialized generic one: each of its formals converts to the
    // generic's formal in the same position.
    @TestClass()
    class NON_GENERIC_PREFERENCE_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()

        a_type(name: string) -> Type =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE()).type!

        a_child(name: string, parent: Type) -> Type is
            let result =
                CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), name, empty_names(), Semantic.BLOCK_SCOPE())

            result.push_ancestor(parent)

            return result.type!
        si

        a_function(name: string, formals: Type[]) -> Function is
            let result = GLOBAL_FUNCTION(loc(), loc(), Semantic.BLOCK_SCOPE(), name, Semantic.BLOCK_SCOPE())

            let arguments = LIST[Type]()

            for formal in formals do
                arguments.add(formal)
            od

            result.arguments = arguments

            return result
        si

        candidates(functions: Function[]) -> List[Function] is
            let result = LIST[Function]()

            for f in functions do
                result.add(f)
            od

            return result
        si

        actuals(types: Type[]) -> List[Type] is
            let result = LIST[Type]()

            for t in types do
                result.add(t)
            od

            return result
        si

        @Test()
        given_the_same_formal__converts() is
            let cat = a_type("CAT")

            is_true(NON_GENERIC_PREFERENCE.converts_to(a_function("f", [cat]), a_function("f", [cat])))
        si

        @Test()
        given_a_more_derived_formal__converts() is
            let parent = a_type("PARENT")
            let child = a_child("CHILD", parent)

            is_true(NON_GENERIC_PREFERENCE.converts_to(a_function("f", [child]), a_function("f", [parent])))
        si

        // The catch-all case: a formal that is an ancestor of the
        // generic's is less specific, so the non-generic doesn't win.
        @Test()
        given_a_less_derived_formal__does_not_convert() is
            let parent = a_type("PARENT")
            let child = a_child("CHILD", parent)

            is_false(NON_GENERIC_PREFERENCE.converts_to(a_function("f", [parent]), a_function("f", [child])))
        si

        @Test()
        given_an_unrelated_formal__does_not_convert() is
            is_false(NON_GENERIC_PREFERENCE.converts_to(a_function("f", [a_type("CAT")]), a_function("f", [a_type("DOG")])))
        si

        @Test()
        given_a_different_formal_count__does_not_convert() is
            let cat = a_type("CAT")

            is_false(NON_GENERIC_PREFERENCE.converts_to(a_function("f", [cat, cat]), a_function("f", [cat])))
        si

        // Every position has to convert: being more specific in one
        // formal doesn't pay for being less specific in another.
        @Test()
        given_one_formal_that_does_not_convert__does_not_convert() is
            let parent = a_type("PARENT")
            let child = a_child("CHILD", parent)

            is_false(NON_GENERIC_PREFERENCE.converts_to(a_function("f", [child, parent]), a_function("f", [parent, child])))
        si

        // A candidate list with no specialized generic in it leaves the
        // non-generic where it is.
        @Test()
        given_no_generic_candidate__is_not_less_specific() is
            let parent = a_type("PARENT")
            let child = a_child("CHILD", parent)

            let non_generic = a_function("f", [parent])
            let other = a_function("f", [child])

            is_false(NON_GENERIC_PREFERENCE.is_less_specific_than_a_generic(non_generic, candidates([non_generic, other])))
        si

        a_specialized_generic(formal: Type) -> Function is
            let specialized = a_function("f", [formal])

            specialized.specialized_from = a_function("f", [formal])

            return specialized
        si

        // The catch-all case the class exists for: the non-generic takes an
        // ancestor of the generic's formal, so it is less specific.
        @Test()
        given_a_generic_whose_formal_it_does_not_convert_to__is_less_specific() is
            let parent = a_type("PARENT")
            let child = a_child("CHILD", parent)

            let catch_all = a_function("f", [parent])
            let generic = a_specialized_generic(child)

            is_true(NON_GENERIC_PREFERENCE.is_less_specific_than_a_generic(catch_all, candidates([catch_all, generic])))
        si

        @Test()
        given_a_generic_whose_formal_it_converts_to__is_not_less_specific() is
            let parent = a_type("PARENT")
            let child = a_child("CHILD", parent)

            let specific = a_function("f", [child])
            let generic = a_specialized_generic(parent)

            is_false(NON_GENERIC_PREFERENCE.is_less_specific_than_a_generic(specific, candidates([specific, generic])))
        si
    si
si
