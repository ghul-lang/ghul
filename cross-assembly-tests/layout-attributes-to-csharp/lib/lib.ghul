namespace LayoutAttributesToCSharp is
    use System.Runtime.InteropServices.LayoutKind

    // Two views of the same four bytes.
    @System.Runtime.InteropServices.StructLayout(LayoutKind.EXPLICIT)
    struct OVERLAY is
        @System.Runtime.InteropServices.FieldOffset(0)
        whole: int field

        @System.Runtime.InteropServices.FieldOffset(0)
        low: short field

        @System.Runtime.InteropServices.FieldOffset(2)
        high: short field

        init(whole: int) is
            self.low = 0s
            self.high = 0s
            self.whole = whole
        si
    si

    // Packed to single bytes, so b follows a with no padding.
    @System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL, pack = 1)
    struct PACKED is
        a: byte field
        b: int field

        init(a: byte, b: int) is
            self.a = a
            self.b = b
        si
    si

    // Padded out to a fixed size.
    @System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL, size = 16)
    struct SIZED is
        a: int field

        init(a: int) is
            self.a = a
        si
    si

    // A class laid out sequentially, which a class otherwise is not.
    @System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL)
    class RECORD is
        first: int field
        second: long field

        init(first: int, second: long) is
            self.first = first
            self.second = second
        si
    si
si
