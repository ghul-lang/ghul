use IO.Std.write_line

use Lib.Failure
use Lib.Lookup
use Lib.Holding

union Local: Failure is
    QUIET
    LOUD(message: string)
si

through_trait(f: Failure) -> string => f.message

through_union(l: Lookup) -> string => l.message

write_line("imported union, through the trait: {through_trait(Lookup.OTHER("disk full"))}")
write_line("imported union, variant without field: {through_trait(Lookup.NOT_FOUND("ghul"))}")
write_line("imported union, through the union: {through_union(Lookup.OTHER("permission denied"))}")
write_line("imported variant: {Lookup.OTHER("timed out").message}")
write_line("imported generic union: {through_trait(Holding.HELD[int](1, "held one"))}")
write_line("imported generic union, variant without field: {through_trait(Holding.EMPTY[int]())}")
write_line("local union over an imported trait: {through_trait(Local.LOUD("shouting"))}")
write_line("local union, variant without field: {through_trait(Local.QUIET)}")
