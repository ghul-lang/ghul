use Ghul.Math.root
use Ghul.Math.power
use Ghul.Math.round_up
use IO.Std.write_line

entry() is
    // The intrinsics a referenced library declares lower to System.Math
    // members in the consumer, reconstructed from the library's own
    // declarations.
    write_line("{root(2.0)} {power(2.0, 10.0)} {round_up(2.5)}");
si
