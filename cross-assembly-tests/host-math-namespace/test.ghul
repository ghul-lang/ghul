use Ghul.Math.sqrt
use Ghul.Math.pow
use Ghul.Math.ceiling
use IO.Std.write_line

entry() is
    // The intrinsics a referenced library declares lower to System.Math
    // members in the consumer, reconstructed from the library's own
    // declarations.
    write_line("{sqrt(2.0)} {pow(2.0, 10.0)} {ceiling(2.5)}");
si
