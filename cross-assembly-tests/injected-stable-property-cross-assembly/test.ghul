use IO.Std.write_line

takes(s: string) is
    write_line(s)
si

let c = "x"

// Declared stable: the fact narrowed in the condition is backed, so the
// read in the branch is a string.
if c.declared_name? then
    takes(c.declared_name)
fi

// Not declared stable: the read in the branch is still optional.
if c.plain_name? then
    takes(c.plain_name)
fi
