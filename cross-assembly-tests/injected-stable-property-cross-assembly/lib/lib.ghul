// Two optional properties a runtime-library build adds to string, with
// bodies the classifier cannot prove self-stable. Only the one declared
// `stable` carries the contract to an importer, through the
// STABLE_ATTRIBUTE on the static that implements it.
namespace Ghul.Internal is
    partial string is
        declared_name: string? stable => if self =~ "x" then "{self}" else null fi

        plain_name: string? => if self =~ "x" then "{self}" else null fi
    si
si
