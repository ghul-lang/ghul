use default

// A .NET indexer taking two arguments is read and assigned as `b[i, j]`,
// and its overloads are chosen over both arguments.
let board = TwoArgumentIndexer.Board()

board[1, 2] = "x"
board[0, 0] = "{board[1, 2]}{board[1, 2]}"

write_line("{board[0, 0]} {board[1, 2]} {board[2, 3]} {board["four", 1]}")
