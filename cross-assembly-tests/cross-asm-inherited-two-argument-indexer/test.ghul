use IO.Std.write_line
use Collections.LIST

// Tests: a class imported from another assembly keeps the two-argument
// indexer it inherits from its base class, beside the one-argument one
// a trait it implements also declares.
entry() is
    let rows = LIST[int[]]()
    rows.add([1, 2, 3])
    rows.add([4, 5, 6])

    let g = Grids.GRID[int](rows)
    write_line("{g[1, 2]} {g[0][1]}")

    let v: Grids.VIEW[int] = g
    write_line("{v[1, 0]}")
si
