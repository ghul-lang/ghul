namespace Grids is
    use Collections.List
    use Collections.Iterator
    use Collections.LIST

    trait Grid[T: out]: List[T[]] is
        lengths: (rows: int, columns: int)

        [row: int, column: int]: T => self[row][column]
    si

    class VIEW[T]: Grid[T] is
        _rows: LIST[T[]]

        init(rows: LIST[T[]]) is
            _rows = rows
        si

        lengths: (rows: int, columns: int) => (_rows.count, _rows[0].count)

        count: int => _rows.count
        iterator: Iterator[T[]] => _rows.iterator

        [row: int]: T[] => _rows[row]
    si

    class GRID[T]: VIEW[T] is
        init(rows: LIST[T[]]) is
            super.init(rows)
        si
    si
si
