namespace StructLayoutToCSharp is
    use System.Runtime.InteropServices.LayoutKind

    // Members declared so that their name order differs from their
    // declaration order: a layout that followed names would put checksum
    // first.
    @System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL)
    struct HEADER is
        kind: int
        length: short
        checksum: byte

        init(kind: int, length: short, checksum: byte) is
            self.kind = kind
            self.length = length
            self.checksum = checksum
        si
    si

    // HEADER with its first member renamed to sort last by name. The
    // layout must not move.
    @System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL)
    struct RENAMED_HEADER is
        variety: int
        length: short
        checksum: byte

        init(variety: int, length: short, checksum: byte) is
            self.variety = variety
            self.length = length
            self.checksum = checksum
        si
    si

    // A property and a field declared in between them.
    struct MIXED is
        zebra: int
        apple: long field
        mango: short

        init(zebra: int, apple: long, mango: short) is
            self.zebra = zebra
            self.apple = apple
            self.mango = mango
        si
    si
si
