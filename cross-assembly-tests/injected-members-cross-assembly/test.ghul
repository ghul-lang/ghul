use IO.Std.write_line

entry() is
    let s = "hi"

    write_line(s.shout())
    write_line("ab".doubled)
    write_line(s.surround("[", "]"))
    write_line(s.loud())
    write_line("{"banana".has('n')} {"banana".has('z')}")

    let c = 'x'

    write_line(c.twice)
    write_line('y'.repeat(3))
si
