// Members a runtime-library build adds to imported types: compiled as
// statics of this namespace's globals carrier, presented to an importing
// assembly as members of string and char.
namespace Ghul.Internal is
    use Ghul.Pipes

    partial string is
        /// The text with an exclamation mark after it.
        shout() -> string => "{self}!"

        doubled: string => "{self}{self}"

        surround(left: string, right: string) -> string => "{left}{self}{right}"

        // A call to another added member, and to one the type declares.
        loud() -> string => shout().to_upper()

        // A closure that captures an argument.
        count_of(c: char) -> int => self |> filter(x => x == c) |> count()
    si

    partial char is
        // A value-type receiver arrives by value.
        twice: string => "{self}{self}"

        repeat(count: int) -> string => string(self, count)
    si
si
