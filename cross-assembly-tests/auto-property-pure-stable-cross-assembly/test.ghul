use IO.Std.write_line
use AutoPropertyLib

takes(s: string) is
    write_line(s)
si

let r = RECORD("a", "b")
let p = POINT("t")
let o = RECORD("c", "d")

// Imported auto properties of a closed class back their facts, whether
// or not they are assignable, and a fact survives a call to another of
// them.
if r.name? then
    let _ = o.label
    let _ = o.count
    takes(r.name)
fi

if r.label? then
    takes(r.label)
fi

// An argument that only reads them, or a struct's, is proven pure.
let names = [r, o] |> Ghul.Pipes.filter(x => x.name? /\ x.count == 0) |> Ghul.Pipes.count()
let tags = [p] |> Ghul.Pipes.filter(x => x.tag?) |> Ghul.Pipes.count()
write_line("{names} {tags}")

// An open class's auto property and a hand-written getter are still not
// trusted: the reads in the branches stay optional.
let b = BASE("e")

if b.name? then
    takes(b.name)
fi

let c = COMPUTED()

if c.name? then
    takes(c.name)
fi
