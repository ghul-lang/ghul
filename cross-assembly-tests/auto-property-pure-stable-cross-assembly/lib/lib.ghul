namespace AutoPropertyLib is
    // Auto properties of a closed class: each getter reads its backing
    // field and nothing else, and nothing can override it.
    class RECORD(name: string?, label: string? public) is
        count: int public
    si

    struct POINT(tag: string?) is si

    // An open class: an override in another assembly could stand behind
    // the getter, so it is not trusted.
    class BASE(name: string?) open is si

    // A hand-written getter with nothing declared.
    class COMPUTED is
        init() is si

        name: string? => "computed"
    si
si
