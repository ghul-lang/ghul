// Comparers from another assembly reach the renamed interfaces under their
// new names and their old ones alike.
use IO.Std.write_line
use Ghul.Pipes
use Collections

entry() is
    write_line(Lib.sorted([3, 1, 2], Lib.DESCENDING()) |> join(","))

    let by_length: IComparer[string] = Lib.BY_LENGTH()
    write_line(Lib.sorted(["ccc", "a", "bb"], by_length) |> join(","))

    let words = LIST(["bb", "a"])
    let comparer: Comparer[string] = Lib.BY_LENGTH()
    words.sort(comparer)
    write_line(words |> join(","))

    let seen = SET[string](Lib.FOLDED())
    seen.add("Hello")
    let folded: IEqualityComparer[string] = Lib.FOLDED()
    write_line("{seen.contains("HELLO")} {folded.equals("X", "x")}")

    write_line("{ComparerBase[int].default.compare(1, 2)} {EqualityComparerBase[string].default.equals("a", "a")}")
si
