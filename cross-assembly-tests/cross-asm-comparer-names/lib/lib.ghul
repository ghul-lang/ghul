// Comparers declared against the renamed interfaces under both spellings,
// and a function that takes one, for another assembly to use.
namespace Lib is
    use Collections

    class DESCENDING: Comparer[int] is
        init() is si
        compare(a: int, b: int) -> int => b - a
    si

    class BY_LENGTH: IComparer[string] is
        init() is si
        compare(a: string?, b: string?) -> int => a!.length - b!.length
    si

    class FOLDED: EqualityComparer[string] is
        init() is si
        equals(a: string?, b: string?) -> bool => a!.to_lower() =~ b!.to_lower()
        get_hash_code(s: string) -> int => s.to_lower().get_hash_code()
    si

    sorted[T](items: Iterable[T], comparer: Comparer[T]) -> LIST[T] is
        let result = LIST[T](items)
        result.sort(comparer)
        return result
    si
si
