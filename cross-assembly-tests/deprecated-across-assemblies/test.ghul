namespace Test is
    use IO.Std.write_line

    // A deprecation carried in another assembly's metadata is reported at
    // the use, whether the assembly was written in C# or in ghūl.
    entry() is
        write_line("{CsLib.Tools.plus(1, 2)}")
        write_line("{CsLib.Tools.add(1, 2)}")
        write_line("{CsLib.OldThing().value}")
        write_line("{GLib.doubled(3)}")
        write_line("{GLib.scaled(3, 2)}")
    si
si
