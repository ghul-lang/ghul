namespace Host is
    use IO.Std.write_line

    use System.Reflection.Assembly
    use System.Reflection.BindingFlags

    // What a session's host does: run each step's entry once, in order,
    // which is what gives the step's variables their values.
    run_step(assembly_name: string, step: string) is
        let flags = cast BindingFlags(cast int(BindingFlags.STATIC) + cast int(BindingFlags.PUBLIC) + cast int(BindingFlags.NON_PUBLIC))

        let globals = Assembly.load(assembly_name).get_type("{step}.$globals")!
        let arguments: ARRAY[object] = [cast object(System.Array.empty[string]())]

        let _ = globals.get_method("_entry", flags)!.invoke(null, arguments)
    si

    entry() is
        run_step("submission-let-earlier", "earlier")
        run_step("submission-let-later", "later")

        write_line("earlier: {earlier.count} {earlier.label}")
        write_line("later: {later.count} {later.label}")
    si
si
