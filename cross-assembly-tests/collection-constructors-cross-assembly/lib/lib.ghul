namespace Lib is
    use Collections
    use Ghul.Pipes

    class PRICE(item: string, pence: int);

    prices() -> Pipe[PRICE] => [PRICE("tea", 180), PRICE("cake", 250)] |> map(p => p)

    price_pairs() -> Pipe[(string, int)] => prices() |> map(p => (p.item, p.pence))

    items() -> Pipe[string] => prices() |> map(p => p.item)

    price_list() -> MAP[string, int] => MAP(price_pairs())

    menu() -> string => items() |> string(", ")
si
