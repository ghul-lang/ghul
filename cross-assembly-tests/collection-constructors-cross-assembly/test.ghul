namespace Test is
    use IO.Std.write_line
    use Collections
    use Ghul.Pipes

    use Lib

    entry() is
        let built_in_library = price_list()
        write_line("library built: tea {built_in_library["tea"]}")

        let built_here = MAP(price_pairs())
        write_line("consumer built: cake {built_here["cake"]}")

        let names = ARRAY(items())
        write_line("array: {names}")
    si
si
