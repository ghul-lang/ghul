namespace Test is
    use IO.Std.write_line;
    use FieldPublicLib;

    bump(value: int ref) is
        value! = value! + 1
    si

    class Main is
        entry() static is
            let settings = SETTINGS()

            // assignable from here: declared field public
            settings.open = 5
            bump(settings.open ref)

            let point mut = POINT(1)
            point.x = 7

            // not assignable from here: declared without public
            settings.closed = 5

            write_line("{settings.open} {point.x}")
        si
    si
si
