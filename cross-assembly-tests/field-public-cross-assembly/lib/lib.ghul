namespace FieldPublicLib is
    // A field declared `field public` is assignable from another assembly;
    // one declared without `public` is not, though both are emitted public.
    class SETTINGS is
        open: int field public
        closed: int field

        init() is
            open = 1
            closed = 1
        si
    si

    struct POINT is
        x: int field public

        init(x: int) is
            self.x = x
        si
    si
si
