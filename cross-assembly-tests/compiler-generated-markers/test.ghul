namespace Test is
    use IO.Std.write_line;

    use GeneratedMarkers;

    // What the compiler synthesises in one assembly - property accessors,
    // their backing fields, lambda bodies compiled onto the enclosing
    // type, a generator's state-machine frame, the carrier hosting a
    // namespace's globals - is marked with the BCL's
    // CompilerGeneratedAttribute so another compilation importing the
    // assembly can tell it from anything a user wrote, without guessing
    // from names. Nothing authored carries the marker.
    class MARKER_TESTS is
        // Synthesised members are emitted assembly-visible, so the
        // default lookup, which reads the public surface, does not find
        // them.
        ANY_MEMBER: System.Reflection.BindingFlags static =>
            System.Reflection.BindingFlags.PUBLIC |
            System.Reflection.BindingFlags.NON_PUBLIC |
            System.Reflection.BindingFlags.INSTANCE |
            System.Reflection.BindingFlags.STATIC;

        marked(member: System.Reflection.MemberInfo) -> bool static is
            for a in member.get_custom_attributes(false) do
                if let cg: System.Runtime.CompilerServices.CompilerGeneratedAttribute = a then
                    return true;
                fi
            od

            return false;
        si

        find_type(types: System.Type[], prefix: string) -> System.Type? static is
            for t in types do
                if t.name.starts_with(prefix) then
                    return t;
                fi
            od

            return null;
        si

        find_method(ty: System.Type, prefix: string) -> System.Reflection.MethodInfo? static is
            for m in ty.get_methods() do
                if m.name.starts_with(prefix) then
                    return m;
                fi
            od

            return null;
        si

        check_field_visibility(what: string, `field: System.Reflection.FieldInfo?) static is
            if !`field? then
                write_line("{what}: MISSING");
                return;
            fi

            write_line("{what}: public {`field.is_public}");
        si

        check_type_visibility(what: string, ty: System.Type?) static is
            if !ty? then
                write_line("{what}: MISSING");
                return;
            fi

            write_line("{what}: public {ty.is_public \/ ty.is_nested_public}");
        si

        check(what: string, member: System.Reflection.MemberInfo?, expect_marked: bool) static is
            if !member? then
                write_line("{what}: MISSING");
                return;
            fi

            let m = member;
            let is_marked mut = false;

            for a in m.get_custom_attributes(false) do
                if let cg: System.Runtime.CompilerServices.CompilerGeneratedAttribute = a then
                    is_marked = true;
                fi
            od

            let verdict = if is_marked == expect_marked then "ok" else "WRONG" fi;

            write_line("{what}: {is_marked} {verdict}");
        si

        entry() static is
            let widget = typeof WIDGET;

            check("widget.get", widget.get_method("$get_label"), true);
            check("widget.set", widget.get_method("$set_label"), true);
            check("widget.field", widget.get_field("$label", ANY_MEMBER), true);
            check("widget.describe", widget.get_method("describe"), false);

            let types = widget.assembly.get_types();

            // The lambda above compiles onto WIDGET itself as a method
            // under an $anon name, and a generator's frame as a type under
            // one derived from its function; each carries a synthesis
            // counter, so find by prefix.
            check("widget.anon", find_method(widget, "$anon"), true);
            check("frame.type", find_type(types, "$StateMachine_counting"), true);

            let frame = find_type(types, "$StateMachine_counting")!;

            check("frame.move_next", frame.get_method("MoveNext"), true);
            check("frame.get_current", frame.get_method("get_Current"), true);
            check("frame.dispose", frame.get_method("Dispose"), true);

            let carrier = widget.assembly.get_type("GeneratedMarkers.$globals");

            check("carrier.type", carrier, true);
            check("carrier.field", carrier?.get_field("$total", ANY_MEMBER), true);
            check("carrier.bump", carrier?.get_method("bump"), false);

            check_type_visibility("widget.type visibility", widget);
            check_type_visibility("carrier.type visibility", carrier);
            check_type_visibility("frame.type visibility", frame);
            check_field_visibility("widget.field visibility", widget.get_field("$label", ANY_MEMBER));
            check_field_visibility("carrier.field visibility", carrier?.get_field("$total", ANY_MEMBER));

            return;
        si
    si
si
