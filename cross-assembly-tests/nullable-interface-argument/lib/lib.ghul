namespace Probe is
    use Collections

    // Implements a generic BCL interface with a nullable reference type
    // argument. Compiling this file alone never exercised the bug: the
    // class satisfying its own header is checked within this assembly,
    // where the compiler holds the ghūl `Type` directly rather than
    // reconstructing it from reflected metadata — the mismatch only
    // shows up from a different assembly (`test.ghul`), which is why
    // this test needs its own referenced library rather than living in
    // `integration-tests/`.
    class THING: MutableMap[string, string?] is
        _stored: string?;

        init() is
        si

        [key: string]: string? =>
            _stored,
            = value is
                _stored = value;
            si

        count: int => if _stored? then 1 else 0 fi
        is_read_only: bool => false
        keys: MutableBag[string] => LIST[string]()
        values: MutableBag[string?] => LIST[string?]()
        iterator: Iterator[KeyValuePair[string, string?]] => LIST[KeyValuePair[string, string?]]().iterator
        contains_key(key: string) -> bool => _stored?
        try_get_value(key: string, value: string? ref) -> bool is
            value! = _stored;
            return _stored?;
        si
        add(key: string, value: string?) is _stored = value; si
        add(item: KeyValuePair[string, string?]) is _stored = item.value; si
        remove(key: string) -> bool => false
        remove(item: KeyValuePair[string, string?]) -> bool => false
        contains(item: KeyValuePair[string, string?]) -> bool => false
        clear() is _stored = null; si
        copy_to(array: ARRAY[KeyValuePair[string, string?]], array_index: int) is si
    si

    entry() is si
si
