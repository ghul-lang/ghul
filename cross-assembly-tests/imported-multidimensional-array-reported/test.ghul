use default

// ghūl has no type for a .NET multidimensional array yet, so a member
// whose signature has one is reported where it is used, rather than
// compiled against a one-dimensional array and failing when it runs.
let made = Rectangular.Grids.make()
write_line("{Rectangular.Grids.rank(made)}")
write_line("{Rectangular.Grids.field}")

// A jagged array is an array of arrays, which ghūl does have.
write_line("{Rectangular.Grids.jagged()[0][0]}")
