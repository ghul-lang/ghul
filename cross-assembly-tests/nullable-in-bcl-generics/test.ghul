// `int?` as a type argument of BCL generics reached by reflection: values
// built in C# read from ghūl, and values built in ghūl passed to C#.

use IO.Std.write_line
use Collections.LIST
use Collections.MAP
use NullableGenerics.Source
use NullableGenerics.Sink

text(v: int?) -> string => if v? then "{v}" else "null" fi


let numbers = Source.numbers()
write_line("numbers {numbers.count} first {text(numbers[0])} second {text(numbers[1])}")

let scores = Source.scores()
write_line("alice {text(scores["alice"])} bob {text(scores["bob"])}")

for v in Source.stream() do
    write_line("streamed {text(v)}")
od

let mine = LIST[int?]()
mine.add(4)
mine.add(null)
write_line(Sink.count(mine))
write_line("sum {Sink.sum(mine)}")

let map = MAP[string, int?]()
map["x"] = null
map["y"] = 2
write_line(Sink.keys(map))

write_line(Sink.count(numbers))
write_line(Sink.count(Source.stream()))
