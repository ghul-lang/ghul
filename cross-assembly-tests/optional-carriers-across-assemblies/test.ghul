// ghūl consuming a ghūl library's `T?` and `int?` slots, and the same slots
// reached through C#, which sees the first as `MAYBE<T>` and the second as
// `Nullable<int>`.

use IO.Std.write_line
use CarrierLib.SLOTS
use CarrierLib.MIXED

show[T](label: string, x: T?) -> string => if x? then "{label} {x}" else "{label} absent" fi

let box = SLOTS[string]("held", 3)
write_line("{show("item", box.item)} {show("slot", box.slot)} {show("count", box.count)} {show("get", box.get())}")

box.set(null)
box.slot = null
box.count = null
write_line("{show("item", box.item)} {show("slot", box.slot)} {show("count", box.count)}")

let ints = SLOTS[int](null, null)
ints.set(7)
ints.count = 8
write_line("{show("item", ints.get())} {show("count", ints.count)}")

write_line(MIXED.describe[int](1, null))
write_line(MIXED.describe[string](null, 2))

let (x, y) = MIXED.pair[int](3, null)
write_line("pair {show("x", x)} {show("y", y)}")

write_line(show("apply", MIXED.apply[int](v => if v? then v + 1 else null fi, 9)))
write_line(show("apply", MIXED.apply[string](v => if v? then v.length else null fi, null)))

write_line("C# {Relay.Relay.describe(null, 6)}")
write_line("C# {Relay.Relay.read_box(SLOTS[string]("from ghul", null))}")
write_line("C# {Relay.Relay.read_box(SLOTS[string](null, 4))}")

let made = Relay.Relay.make_box(10, null)
write_line("C# made {show("item", made.get())} {show("count", made.count)}")
let empty = Relay.Relay.make_empty_box()
write_line("C# empty {show("item", empty.get())} {show("count", empty.count)}")
