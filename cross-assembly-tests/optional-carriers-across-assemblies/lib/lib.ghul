namespace CarrierLib is
    // `T?` over an unconstrained type parameter, beside `int?`, in every
    // kind of slot another assembly can reach.
    class SLOTS[T] is
        item: T? public;
        slot: T? field public;
        count: int? field public;

        init(item: T?, count: int?) is
            self.item = item;
            slot = item;
            self.count = count;
        si

        get() -> T? => item;
        set(value: T?) is item = value; si
    si

    class MIXED is
        init() is si

        describe[T](x: T?, y: int?) -> string static =>
            "{if x? then "x={x}" else "x absent" fi} {if y? then "y={y}" else "y absent" fi}"

        pair[T](x: T?, y: int?) -> (T?, int?) static => (x, y)

        apply[T](f: (T?) -> int?, x: T?) -> int? static => f(x)
    si
si
