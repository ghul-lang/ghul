// A library that declares the store-free marker itself carries it on what
// its effect solve proved, as the runtime does: SOURCE.describe() stores
// nothing, so a field narrow survives calling it here, and passing it as a
// pure function draws no warning.

use Std = IO.Std
use DeclaringLib

class HOLDER is
    _tag: string?

    init(t: string?) is
        _tag = t
    si

    probe(source: DeclaringLib.SOURCE) is
        if _tag? then
            let n = source.describe()

            Std.write_line("kept: {_tag.length} {n}")
        fi
    si
si

apply(f: () -> int pure) -> int => f()

entry() is
    let source = DeclaringLib.SOURCE(1)

    HOLDER("hi").probe(source)
    Std.write_line("{apply(() => source.describe())}")
si
