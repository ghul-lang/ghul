// The store-free marker, declared here as the runtime declares it. This
// library is built against a runtime that predates the marker, so the
// only declaration of it is this one, and the members this assembly's
// effect solve proves store-free carry it.
namespace Ghul.Internal is
    class INFERRED_STORE_FREE_ATTRIBUTE: System.Attribute is
        init() is si
    si
si

namespace DeclaringLib is
    entry() is
    si

    // Not declared pure: what an importer knows about describe() is what
    // this assembly's effect solve proved.
    class SOURCE is
        _base: int

        init(base: int) is
            _base = base
        si

        describe() -> int => _base + 1
    si
si
