<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AssemblyName>inferred-store-free-declared-by-library-lib</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="ghul.runtime" VersionOverride="44.0.0" />
  </ItemGroup>

  <ItemGroup>
    <GhulSources Include="**/*.ghul" />
  </ItemGroup>
</Project>
