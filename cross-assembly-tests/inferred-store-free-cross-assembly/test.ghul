// What a referenced assembly's effect solve proved crosses with the
// assembly: SOURCE.describe() stores nothing, which lib's solve proved, so
// a field narrow survives calling it here, and passing it as a pure
// function draws no warning. Calls that can reach a body lib's marker
// doesn't speak for are still not trusted: through the open class BASE
// and the open trait Describer, whose implementations here store, and
// through the closed trait Counter, whose implementation in lib stores.

use Std = IO.Std
use InferredLib

class HOLDER is
    _tag: string?

    init(t: string?) is
        _tag = t
    si

    probe(source: InferredLib.SOURCE) is
        if _tag? then
            let n = source.describe()

            Std.write_line("kept: {_tag.length} {n}")
        fi
    si
si

apply(f: () -> int pure) -> int => f()

class COUNTING_DESCRIBER: InferredLib.Describer is
    count: int public

    init() is si

    describe() -> int is
        count = count + 1

        return count
    si

    fallback() -> int is
        count = count + 10

        return count
    si
si

class DERIVED: InferredLib.BASE is
    count: int public

    init() is
        super.init()
    si

    describe() -> int is
        count = count + 1

        return count
    si
si

entry() is
    let source = InferredLib.SOURCE(1)

    HOLDER("hi").probe(source)
    Std.write_line("{apply(() => source.describe())}")
    Std.write_line("{source.bump()}")

    let base: InferredLib.BASE = DERIVED()
    Std.write_line("{apply(() => base.describe())}")

    let describer: InferredLib.Describer = COUNTING_DESCRIBER()
    Std.write_line("{apply(() => describer.describe())}")
    Std.write_line("{apply(() => describer.fallback())}")

    let counter = InferredLib.stepper()
    Std.write_line("{apply(() => counter.next())}")
si
