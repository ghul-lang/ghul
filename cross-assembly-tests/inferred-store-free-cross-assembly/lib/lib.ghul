namespace InferredLib is
    entry() is
    si

    // Nothing here is declared pure: what the importer knows about these
    // members is what this assembly's effect solve proved.
    class SOURCE is
        _base: int

        init(base: int) is
            _base = base
        si

        describe() -> int => _base + 1

        bump() -> int is
            _base = _base + 1

            return _base
        si
    si

    // An open class: an assembly referencing this one can override
    // describe(), so what the solve proved about this body isn't
    // exported for it.
    class BASE open is
        init() is si

        describe() -> int => 1
    si

    // An open trait: an assembly referencing this one can implement it,
    // so its members aren't trusted, whether abstract or with a default
    // body.
    trait Describer open is
        describe() -> int;

        fallback() -> int => 2
    si

    // A closed trait whose implementation here stores: a call through
    // the trait can reach that body, which an importer can't see, so the
    // trait's members aren't trusted either.
    trait Counter is
        next() -> int;
    si

    class STEPPER: Counter is
        _at: int

        init() is si

        next() -> int is
            _at = _at + 1

            return _at
        si
    si

    stepper() -> Counter => STEPPER()
si
