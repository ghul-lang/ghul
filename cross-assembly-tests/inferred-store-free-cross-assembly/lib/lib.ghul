namespace InferredLib is
    entry() is
    si

    // Nothing here is declared pure: what the importer knows about these
    // members is what this assembly's effect solve proved.
    class SOURCE is
        _base: int

        init(base: int) is
            _base = base
        si

        describe() -> int => _base + 1

        bump() -> int is
            _base = _base + 1

            return _base
        si
    si
si
