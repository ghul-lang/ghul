{
    // The compiler's own source as its native build compiles it, for an
    // editor analysing it with a compiler that is not hosted on .NET. The
    // ghul.ghulproj beside it is taken first unless the editor is told to
    // take this manifest. build/manifest-check.sh keeps the two in step.
    "name": "ghul",
    "kind": "program",
    "targets": ["llvm"],
    "sources": [
        "src/**/*.ghul",
        "wasm/src/**/*.ghul",
        "llvm/src/**/*.ghul",
        "analysis-protocol/src/**/*.ghul"
    ],
    "requires": { "compiler": ">=71.12.6" },
    "dependencies": { "ghul-runtime": { "version": ">=38.12.0" } },
    "language": { "underscore-access": "legacy" },
    "diagnostics": {
        "warn-as-hint": ["cast-may-throw", "shadowed-non-callable", "impure-function-argument"],
        "warn": ["redundant-semicolon"],
        "warn-as-error": ["redundant-semicolon"]
    }
}
