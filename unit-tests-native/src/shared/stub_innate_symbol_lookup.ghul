namespace Semantic.UnitTests is
    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.Lookups.RuntimeException
    use Type = Semantic.Types.Type

    // An innate symbol lookup whose every answer a test sets: each member
    // returns what its `_answer` slot holds, or, for a member that takes
    // arguments, what the function in its slot answers for them. A member
    // the test has not set answers null where its result is optional and
    // false where it is a bool, and otherwise throws, naming the member,
    // so a test that reaches one it did not set says which. `calls` names
    // each member called, in order, for a test that checks what was asked.
    class STUB_INNATE_SYMBOL_LOOKUP: InnateSymbolLookup is
        calls: Collections.LIST[string] public

        init() is
            calls = Collections.LIST[string]()
        si


        get_enum_type_answer: Type? public

        get_enum_type() -> Type is
            calls.add("get_enum_type")

            if let answer = get_enum_type_answer then
                return answer
            fi

            throw Ghul.InvalidOperationException("get_enum_type is not stubbed")
        si

        get_tuple_type_answer: ((Type[], string?[]?) -> Type?)? public

        get_tuple_type(types: Type[], names: string?[]?) -> Type is
            calls.add("get_tuple_type")

            if let answer = get_tuple_type_answer then
                if let result = answer(types, names) then
                    return result
                fi
            fi

            throw Ghul.InvalidOperationException("get_tuple_type is not stubbed")
        si

