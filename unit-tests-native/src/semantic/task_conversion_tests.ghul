namespace Semantic.UnitTests is
    use Collections.Iterable
    use Collections.LIST


    use Source.LOCATION

    use Semantic.Lookups.InnateSymbolLookup
    use Semantic.TASK_CONVERSION

    use Semantic.Symbols.CLASS

    use Semantic.Types.Type
    use Assertions

    // Pins for TASK_CONVERSION.try_get_task_element_type — the
    // predicate compile-lambdas now uses to recognise a slot
    // expecting `Tasks.TASK[T]` and flip the inferred-return wrap on.
    // The wrap mechanism itself is exercised end-to-end by the
    // integration tests under
    // `integration-tests/execution/async-lambda-task-slot-wrap` and
    // `async-return-wrap-*`; this fixture pins the predicate's
    // contract against a stand-in InnateSymbolLookup so changes to
    // the underlying Task-detection shape can't silently break the
    // wrap gate.
    class TASK_CONVERSION_TESTS is
        init() is si

        loc() -> LOCATION => LOCATION("test.ghul", 1, 1, 1, 1)

        empty_names() -> LIST[string] => LIST[string]()
        names_for(values: Iterable[string]) -> LIST[string] is
            let result = LIST[string]()
            for v in values do result.add(v); od
            return result
        si

        types(values: Iterable[Type]) -> LIST[Type] is
            let result = LIST[Type]()
            for v in values do result.add(v); od
            return result
        si

        // Build a CLASS playing the role of the open-generic
        // `System.Threading.Tasks.Task`1` — single type parameter,
        // referred to by its symbol identity from inside
        // `try_get_task_element_type`.
        build_task_class() -> CLASS =>
            CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Task", names_for(["T"]), Semantic.BLOCK_SCOPE())

        // Mock `InnateSymbolLookup` whose `get_unspecialized_task_type`
        // returns the supplied unspecialized Task type. Every other
        // member falls through to the stub's default (null) — only
        // the Task accessor is consumed by the predicate under test.
        build_task_lookup(unspecialized_task: Type?) -> Semantic.UnitTests.STUB_INNATE_SYMBOL_LOOKUP is
            let lookup = Semantic.UnitTests.STUB_INNATE_SYMBOL_LOOKUP()
            lookup.get_unspecialized_task_type_answer = unspecialized_task
            return lookup
        si

        int_class() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "int", empty_names(), Semantic.BLOCK_SCOPE())
        string_class() -> CLASS => CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "string", empty_names(), Semantic.BLOCK_SCOPE())

        // Constructed Task[T] over the supplied element type, using
        // the same Task class symbol that the test lookup will hand
        // back from `get_unspecialized_task_type` — the predicate
        // compares the underlying classy by reference identity.
        constructed_task(task: CLASS, element: Type) -> Semantic.Types.GENERIC =>
            Semantic.Types.GENERIC(loc(), task, types([element]))

        // === async_return_type_for ===
        //
        // The return type an async closure with an inferred return
        // settles to: the closure's slot-named task-like applied to the
        // body's value when one was recorded, Task[value] otherwise.

        @test()
        Calling__async_return_type_for__with_a_template__applies_it_to_the_element() is
            let task = build_task_class()
            let coroutine = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "COROUTINE", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let int_t = int_class().type!

            let lookup = build_task_lookup(constructed_task(task, int_t))
            let conversion = TASK_CONVERSION(lookup)

            let owner = string_class()
            let closure = Semantic.Symbols.INSTANCE_METHOD(loc(), loc(), owner, "body", Semantic.BLOCK_SCOPE())
            closure.async_task_like_template = coroutine

            let result = cast Semantic.Types.GENERIC?(conversion.async_return_type_for(closure, int_t))

            is_true(result?)
            are_same(cast Semantic.Symbols.Symbol(coroutine), result!.symbol.unspecialized_symbol)
            are_equal(1, result.arguments.count)
            are_same(int_t, result.arguments[0])
        si

        @test()
        Calling__async_return_type_for__without_a_template__returns_the_lookups_task() is
            let task = build_task_class()
            let int_t = int_class().type!
            let task_of_int = constructed_task(task, int_t)

            let lookup = build_task_lookup(constructed_task(task, int_t))
            lookup.get_task_type_answer = (t: Type) -> Type? => if t == int_t then task_of_int else null fi
            let conversion = TASK_CONVERSION(lookup)

            let owner = string_class()
            let closure = Semantic.Symbols.INSTANCE_METHOD(loc(), loc(), owner, "body", Semantic.BLOCK_SCOPE())

            are_same(cast Type(task_of_int), conversion.async_return_type_for(closure, int_t))
        si

        // === Task[T] -> T ===

        @test()
        Calling__try_get_task_element_type__with_constructed_task_int__returns_int() is
            let task = build_task_class()
            let int_t = int_class().type!
            let task_of_int = constructed_task(task, int_t)

            let lookup = build_task_lookup(constructed_task(task, int_class().type!))
            let conversion = TASK_CONVERSION(lookup)

            are_same(int_t, conversion.try_get_task_element_type(task_of_int))
        si

        // A library source declaring the task type hands back the class
        // itself rather than a generic over its own type parameter.
        @test()
        Calling__try_get_task_element_type__with_task_declared_in_source__returns_int() is
            let task = build_task_class()
            let int_t = int_class().type!
            let task_of_int = constructed_task(task, int_t)

            let lookup = build_task_lookup(Semantic.Types.NAMED(task))
            let conversion = TASK_CONVERSION(lookup)

            are_same(int_t, conversion.try_get_task_element_type(task_of_int))
        si

        // === non-Task generic returns null ===
        //
        // Same construction shape but a different underlying classy
        // symbol — the predicate must reject by symbol identity, not
        // by name, arity, or generic-ness.
        @test()
        Calling__try_get_task_element_type__with_unrelated_generic__returns_null() is
            let task = build_task_class()
            let other = CLASS(loc(), loc(), Semantic.BLOCK_SCOPE(), "Other", names_for(["T"]), Semantic.BLOCK_SCOPE())
            let int_t = int_class().type!

            let lookup = build_task_lookup(constructed_task(task, int_class().type!))
            let conversion = TASK_CONVERSION(lookup)

            is_null(conversion.try_get_task_element_type(constructed_task(other, int_t)))
        si

        // === non-generic type returns null ===

        @test()
        Calling__try_get_task_element_type__with_non_generic_type__returns_null() is
            let task = build_task_class()
            let int_t = int_class().type!

            let lookup = build_task_lookup(constructed_task(task, int_class().type!))
            let conversion = TASK_CONVERSION(lookup)

            is_null(conversion.try_get_task_element_type(int_t))
        si

        // === null guard ===

        @test()
        Calling__try_get_task_element_type__with_null_type__returns_null() is
            let task = build_task_class()

            let lookup = build_task_lookup(constructed_task(task, int_class().type!))
            let conversion = TASK_CONVERSION(lookup)

            is_null(conversion.try_get_task_element_type(null))
        si

        // === lookup with no Task type returns null ===
        //
        // A lookup with no Task type (`get_unspecialized_task_type
        // -> Type?` is optional) leaves the predicate disabled: every
        // call returns null so the wrap stays off.
        @test()
        Calling__try_get_task_element_type__with_absent_unspecialized_task__returns_null() is
            let task = build_task_class()
            let int_t = int_class().type!
            let task_of_int = constructed_task(task, int_t)

            let lookup = build_task_lookup(null)
            let conversion = TASK_CONVERSION(lookup)

            is_null(conversion.try_get_task_element_type(task_of_int))
        si
    si

si
