namespace Assertions is
    // The assertions the unit tests are written with, under the names they
    // had on MSTest, each an `assert`: a failure throws AssertFailedException,
    // which the runner reports as a failed test, with the location and the
    // values the message names.

    are_equal[T](expected: T, actual: T) => are_equal(expected, actual, "")

    are_equal[T](expected: T, actual: T, message: string) is
        assert _same_value(cast object?(expected), cast object?(actual)) else "expected <{expected}>, got <{actual}> {message}"
    si

    are_not_equal[T](expected: T, actual: T) => are_not_equal(expected, actual, "")

    are_not_equal[T](expected: T, actual: T, message: string) is
        assert !_same_value(cast object?(expected), cast object?(actual)) else "expected anything but <{expected}> {message}"
    si

    are_same[T](expected: T, actual: T) => are_same(expected, actual, "")

    are_same[T](expected: T, actual: T, message: string) is
        assert cast object?(expected) == cast object?(actual) else "expected the same object as <{expected}>, got <{actual}> {message}"
    si

    are_not_same[T](expected: T, actual: T) => are_not_same(expected, actual, "")

    are_not_same[T](expected: T, actual: T, message: string) is
        assert cast object?(expected) != cast object?(actual) else "expected another object than <{expected}> {message}"
    si

    is_true(condition: bool) => is_true(condition, "")

    is_true(condition: bool, message: string) is
        assert condition else "expected true {message}"
    si

    is_false(condition: bool) => is_false(condition, "")

    is_false(condition: bool, message: string) is
        assert !condition else "expected false {message}"
    si

    is_null(value: object?) => is_null(value, "")

    is_null(value: object?, message: string) is
        assert !value? else "expected null, got <{value}> {message}"
    si

    is_not_null(value: object?) => is_not_null(value, "")

    is_not_null(value: object?, message: string) is
        assert value? else "expected a value {message}"
    si

    fail() => fail("")

    fail(message: string) is
        throw Ghul.AssertFailedException("fail: {message}")
    si

    // Equality as MSTest's are_equal reads it: both absent, or the first's
    // `equals` accepting the second.
    _same_value(a: object?, b: object?) -> bool =>
        if let present = a then present.equals(b) else !b? fi
si
