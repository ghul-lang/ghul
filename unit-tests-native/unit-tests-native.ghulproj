<Project Sdk="Microsoft.NET.Sdk">
  <!-- The compiler's unit tests on the ghul-testing runner, while they move
       here from unit-tests/ a batch at a time: each test file is in exactly
       one of the two projects. The same sources also build for llvm, with
       the compiler's own, by build/llvm-unit-tests.sh. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
    <GhulWarnAsHint>cast-may-throw</GhulWarnAsHint>
    <GhulNoWarn>non-snake-case-name;non-pascal-case-name;non-upper-snake-case-name</GhulNoWarn>
  </PropertyGroup>

  <!-- ghul-testing, from CI's checkout under libraries/, or else beside
       this checkout or beside the primary checkout of a worktree. -->
  <PropertyGroup>
    <GhulTestingRoot Condition="'$(GhulTestingRoot)' == '' And Exists('$(MSBuildThisFileDirectory)../libraries/ghul-testing/src')">$(MSBuildThisFileDirectory)../libraries/ghul-testing</GhulTestingRoot>
    <GhulTestingRoot Condition="'$(GhulTestingRoot)' == '' And Exists('$(MSBuildThisFileDirectory)../../ghul-testing/src')">$(MSBuildThisFileDirectory)../../ghul-testing</GhulTestingRoot>
    <GhulTestingRoot Condition="'$(GhulTestingRoot)' == '' And Exists('$(MSBuildThisFileDirectory)../../../../ghul-testing/src')">$(MSBuildThisFileDirectory)../../../../ghul-testing</GhulTestingRoot>
    <GhulTestingVersion>$([System.IO.File]::ReadAllText('$(GhulTestingRoot)/VERSION').Trim())</GhulTestingVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ghul.ghulproj" />
    <GhulSources Include="src/**/*.ghul" />
    <GhulSources Include="$(GhulTestingRoot)/src/**/*.ghul" />
    <GhulOptions Include="--library-source ghul-testing@$(GhulTestingVersion)=$(GhulTestingRoot)" />
    <GhulOptions Include="--entry unit_tests_entry" />
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" />
  </ItemGroup>
</Project>
