namespace Driver is
    use Ghul.Pipes
    use IO.Std.write_line;

    class Main is
        entry(arguments: ARRAY[string]) -> int static is
            if arguments.count < 1 then
                write_line("usage: mdump [--verify] <assembly> [<assembly> ...]");

                return 1;
            fi

            let verify = arguments[0] =~ "--verify";

            let paths = if verify then arguments |> skip(1) else arguments |> skip(0) fi;

            if verify then
                return _verify(paths);
            fi

            for path in paths do
                write_line("=== {path} ===");

                MetadataDump.DUMP(path).write();
            od

            return 0;
        si

        // Reports what ILVerify does not. ILVerify checks the IL a
        // method contains; it says nothing about a method that contains
        // none, and reports an assembly whose every method row points
        // at nothing as fully verified.
        _verify(paths: Collections.Iterable[string]) -> int static is
            let violations mut = 0;

            for path in paths do
                for violation in MetadataDump.VERIFY(path).violations() do
                    write_line("{path}: {violation}");

                    violations = violations + 1;
                od
            od

            return if violations > 0 then 1 else 0 fi;
        si
    si
si
