namespace ArgumentPackGrid is
    use default

    // A way of writing the function that fills a pack-callable formal
    // (`f: T.. -> U`). `callable` renders it for a given arity, `preamble` any
    // statement the cell body needs before it, and `declaration` any global
    // function it names. The `explicit_` forms write out every type the
    // compiler would otherwise infer. `result` is the type the function
    // returns, and `read` the member access that turns a call's result into
    // the cell's int.
    class SHAPE(
        slug: string,
        is_literal: bool,
        passes_tuple: bool,
        result: string,
        read: string,
        callable: (int) -> string,
        explicit_callable: (int) -> string,
        preamble: (int) -> string,
        explicit_preamble: (int) -> string,
        declaration: (int) -> string
    )

    // What a position needs to write the function into its formal: the
    // function as written, the type it has, and whether every type is to be
    // written out.
    class WRAPPING(
        callable: string,
        function_type: string,
        explicit: bool
    )

    // Where the function sits relative to the pack. A position declares two
    // combinators: one that takes the pack's arguments beside the function,
    // and one that hands the pack back out as the function's return, so a
    // later call of the result supplies the arguments.
    //
    // The declarations and the calls take the text to write in each inferred
    // slot: a lambda's parameter and return annotation, and a call's type
    // arguments. The inferred program passes empty text, the explicit program
    // the types. The calls also take the receiver to call the combinator on,
    // empty for a global one.
    //
    // `wrap` turns the function into what the formal is given, and
    // `maker_declaration` and `maker_preamble` write any global function or
    // local variable that wrapping names.
    class POSITION(
        slug: string,
        parenthesises_literal: bool,
        passes_arguments_as_tuple: bool,
        // Whether the cell reaches the combinator through a receiver as well
        // as as a global function.
        crosses_callees: bool,
        // Whether the function is wrapped in a global function, which cannot
        // name a local variable of the cell.
        wraps_in_global: bool,
        sibling_declaration: (bool) -> string,
        presenting_declaration: (bool) -> string,
        wrap: (WRAPPING) -> string,
        maker_declaration: (WRAPPING) -> string,
        maker_preamble: (WRAPPING) -> string,
        sibling_call: (string, string, string, string) -> string,
        presenting_call: (string, string, string) -> string,
        presenting_adjustment: int,
        // How many type parameters the presenting combinator declares after
        // the pack's two.
        presenting_extra_type_arguments: int
    )

    // What pins the pack to a concrete tuple: the arguments written beside the
    // function, the declared type of the local the result goes into, or
    // nothing but the later call of that local.
    class PINNING(
        slug: string,
        is_sibling: bool,
        is_context: bool
    )

    enum CalleeKind is
        GLOBAL,
        STATIC_METHOD,
        INSTANCE_METHOD,
        SELF_CALL,
        GENERIC_OWNER
    si

    // How the combinators are declared and reached: as global functions, as
    // static or instance methods of a class, called on `self` from a method of
    // that class, or as instance methods of a class whose own type parameter
    // is the pack.
    class CALLEE(
        slug: string,
        kind: CalleeKind
    )

    class CELL(
        callee: CALLEE,
        shape: SHAPE,
        position: POSITION,
        pinning: PINNING,
        arity: int
    ) is
        slug: string =>
            if callee.kind == CalleeKind.GLOBAL then
                "{shape.slug}-{position.slug}-{pinning.slug}-arity-{arity}"
            else
                "{callee.slug}-{shape.slug}-{position.slug}-{pinning.slug}-arity-{arity}"
            fi
    si

    // The edges of the pack: no arguments, which a pack has no reading for;
    // one, where the pack is the value itself; two, the smallest tuple; seven,
    // the largest tuple; and eight, past it, which has to fail cleanly.
    ARITIES: ARRAY[int] static => [0, 1, 2, 7, 8]

    MAX_ARITY: int static => 8

    PARAMETER_NAMES: ARRAY[string] static => ["a", "b", "c", "d", "e", "f", "g", "h"]

    TASK_RESULT: string static => "Tasks.TASK[int]"

    parameters(arity: int) -> LIST[string] =>
        LIST[string](PARAMETER_NAMES |> take(arity))

    weight(index: int) -> int is
        let result mut = 1

        for _ in 0..index do
            result = result * 10
        od

        result
    si

    // Each argument is weighted by its position, so a result built from
    // arguments in the wrong order, or from too few of them, is visible.
    body(arity: int) -> string is
        let terms = LIST[string]()

        for i in 0..arity do
            let name = PARAMETER_NAMES[i]

            if i == 0 then
                terms.add(name)
            else
                terms.add("{name} * {weight(i)}")
            fi
        od

        if arity == 0 then "42" else terms |> join(" + ") fi
    si

    expected(arity: int) -> int is
        if arity == 0 then
            return 42
        fi

        let result mut = 0

        for i in 0..arity do
            result = result + (i + 1) * weight(i)
        od

        result
    si

    typed_parameters(arity: int) -> string =>
        "({parameters(arity) |> map(p => "{p}: int") |> join(", ")})"

    // An untyped literal's parameter list: the bare name for one parameter,
    // the parenthesised names otherwise.
    untyped_parameters(arity: int) -> string =>
        if arity == 1 then "a" else "({parameters(arity) |> join(", ")})" fi

    typed_literal(arity: int) -> string =>
        "{typed_parameters(arity)} -> int => {body(arity)}"

    untyped_literal(arity: int) -> string =>
        if arity == 1 then
            "a => a"
        else
            "({parameters(arity) |> join(", ")}) => {body(arity)}"
        fi

    block_body(arity: int, explicit: bool) -> string =>
        "let t{if explicit then ": int" else "" fi} = {body(arity)}; t"

    block_literal(arity: int) -> string =>
        "{untyped_parameters(arity)} is {block_body(arity, false)} si"

    typed_block_literal(arity: int) -> string =>
        "{typed_parameters(arity)} -> int is {block_body(arity, true)} si"

    async_body(arity: int) -> string =>
        "await Tasks.TASK.yield(); return {body(arity)};"

    async_literal(arity: int) -> string =>
        "{untyped_parameters(arity)} is {async_body(arity)} si"

    typed_async_literal(arity: int) -> string =>
        "{typed_parameters(arity)} -> {TASK_RESULT} is {async_body(arity)} si"

    weigh_declaration(arity: int) -> string =>
        "weigh({parameters(arity) |> map(p => "{p}: int") |> join(", ")}) -> int => {body(arity)}"

    spread_arguments(arity: int) -> string =>
        LIST[string]((1::arity) |> map(i => "{i}")) |> join(", ")

    with_arguments(callable: string, arguments: string) -> string =>
        if arguments.length == 0 then callable else "{callable}, {arguments}" fi

    tuple_arguments(arity: int) -> string =>
        if arity == 1 then "1" else "({spread_arguments(arity)})" fi

    function_type(arity: int, result: string) -> string =>
        "({LIST[string]((1::arity) |> map(i => "int")) |> join(", ")}) -> {result}"

    // The type a pack of this arity binds to: the value itself for one
    // argument, the tuple of them otherwise.
    pack_type(arity: int) -> string =>
        if arity == 1 then
            "int"
        else
            "({LIST[string]((1::arity) |> map(i => "int")) |> join(", ")})"
        fi

    // The annotation a combinator's own lambda is written with: its
    // parameter alone when inferred, its parameter and return type when
    // explicit.
    lambda_head(explicit: bool, result: string) -> string =>
        if explicit then "(v: T) -> {result}" else "v" fi

    SHAPES: LIST[SHAPE] static =>
        LIST[SHAPE]([
            SHAPE("typed-literal", true, false, "int", "", typed_literal, typed_literal, n => "", n => "", n => ""),
            SHAPE("untyped-literal", true, false, "int", "", untyped_literal, typed_literal, n => "", n => "", n => ""),
            SHAPE("named-function", false, false, "int", "", n => "weigh", n => "weigh", n => "", n => "", weigh_declaration),
            SHAPE(
                "stored-value", false, false, "int", "", n => "stored", n => "stored",
                n => "let stored = {typed_literal(n)}",
                n => "let stored: {function_type(n, "int")} pure = {typed_literal(n)}",
                n => ""
            ),
            SHAPE("written-out-tuple", false, true, "int", "", n => "weigh", n => "weigh", n => "", n => "", weigh_declaration),
            SHAPE("block-literal", true, false, "int", "", block_literal, typed_block_literal, n => "", n => "", n => ""),
            SHAPE("async-literal", true, false, TASK_RESULT, ".result", async_literal, typed_async_literal, n => "", n => "", n => "")
        ])

    apply_declaration(explicit: bool) -> string => "apply_n[T.., U](f: T.. -> U, v: T..) -> U => f(v)"

    once_declaration(explicit: bool) -> string =>
        "once[T.., U](f: T.. -> U) -> T.. -> U => {lambda_head(explicit, "U")} => f(v)"

    delegate_apply_declaration(explicit: bool) -> string =>
        "apply_d[T.., U](f: System.Converter[T, U], v: T..) -> U => f.invoke(v)"

    delegate_once_declaration(explicit: bool) -> string =>
        "once_d[T.., U](f: System.Converter[T, U]) -> T.. -> U => {lambda_head(explicit, "U")} => f.invoke(v)"

    run_1_declaration(explicit: bool) -> string =>
        "run_1[T.., U](make: (int) -> T.. -> U, v: T..) -> U => make(10)(v)"

    once_1_declaration(explicit: bool) -> string =>
        "once_1[T.., U](make: (int) -> T.. -> U) -> T.. -> U => {lambda_head(explicit, "U")} => make(10)(v)"

    run_2_declaration(explicit: bool) -> string =>
        "run_2[T.., U](make: (int) -> (int) -> T.. -> U, v: T..) -> U => make(10)(20)(v)"

    once_2_declaration(explicit: bool) -> string =>
        "once_2[T.., U](make: (int) -> (int) -> T.. -> U) -> T.. -> U => {lambda_head(explicit, "U")} => make(10)(20)(v)"

    // The function written as the result of a literal taking one int, the
    // shape a depth-one return-spine formal asks for.
    spine_1(w: WRAPPING) -> string =>
        if w.explicit then "(k: int) -> {w.function_type} pure => {w.callable}" else "k => {w.callable}" fi

    spine_2(w: WRAPPING) -> string =>
        if w.explicit then
            "(j: int) -> ((int) -> {w.function_type} pure) pure => (k: int) -> {w.function_type} pure => {w.callable}"
        else
            "j => k => {w.callable}"
        fi

    // As the spine literals, with the N-ary return each hop licenses written
    // out. The returns are declared rather than inferred, so the explicit
    // program writes them exactly as the inferred one does.
    declared_spine_1(w: WRAPPING) -> string =>
        "(k: int) -> {w.function_type} => {w.callable}"

    declared_spine_2(w: WRAPPING) -> string =>
        "(j: int) -> (int) -> {w.function_type} => (k: int) -> {w.function_type} => {w.callable}"

    named_maker_1(w: WRAPPING) -> string =>
        "make_1(k: int) -> {w.function_type} => {w.callable}"

    named_maker_2(w: WRAPPING) -> string =>
        "make_2(j: int) -> (int) -> {w.function_type} => {spine_1(w)}"

    stored_maker_1(w: WRAPPING) -> string =>
        if w.explicit then
            "let make: ((int) -> {w.function_type} pure) pure = (k: int) -> {w.function_type} pure => {w.callable}"
        else
            "let make = (k: int) => {w.callable}"
        fi

    stored_maker_2(w: WRAPPING) -> string =>
        if w.explicit then
            "let make: ((int) -> ((int) -> {w.function_type} pure) pure) pure = "
            "(j: int) -> ((int) -> {w.function_type} pure) pure => (k: int) -> {w.function_type} pure => {w.callable}"
        else
            "let make = (j: int) => (k: int) => {w.callable}"
        fi

    none(w: WRAPPING) -> string => ""

    direct_sibling_call(name: string) -> (string, string, string, string) -> string =>
        (c, a, t, q) => "{q}{name}{t}({with_arguments(c, a)})"

    direct_presenting_call(name: string) -> (string, string, string) -> string =>
        (c, t, q) => "{q}{name}{t}({c})"

    pipe_sibling_call(name: string) -> (string, string, string, string) -> string =>
        (c, a, t, q) => "{c} |> {q}{name}{t}({a})"

    pipe_presenting_call(name: string) -> (string, string, string) -> string =>
        (c, t, q) => "{c} |> {q}{name}{t}()"

    POSITIONS: LIST[POSITION] static =>
        LIST[POSITION]([
            POSITION(
                "direct-call", false, false, true, false, apply_declaration, once_declaration,
                w => w.callable, none, none,
                direct_sibling_call("apply_n"), direct_presenting_call("once"),
                0, 0
            ),
            POSITION(
                "return-spine-depth-1", false, false, false, false, run_1_declaration, once_1_declaration,
                spine_1, none, none,
                direct_sibling_call("run_1"), direct_presenting_call("once_1"),
                0, 0
            ),
            POSITION(
                "return-spine-depth-2", false, false, false, false, run_2_declaration, once_2_declaration,
                spine_2, none, none,
                direct_sibling_call("run_2"), direct_presenting_call("once_2"),
                0, 0
            ),
            POSITION(
                "pipe", true, false, true, false, apply_declaration, once_declaration,
                w => w.callable, none, none,
                pipe_sibling_call("apply_n"), pipe_presenting_call("once"),
                0, 0
            ),
            // An operator has one operand for the pack, so the arguments
            // beside the function are always the tuple. The presenting
            // operator composes with `inc`, which adds one to the result.
            // An operator use has nowhere to write type arguments, so the
            // explicit program calls the operator by name.
            POSITION(
                "operator", true, true, false, false,
                x => "<*>[T.., U](f: T.. -> U, v: T) -> U => f(v)",
                x => ">=>[T.., U, V](f: T.. -> U, g: (U) -> V) -> T.. -> V => {lambda_head(x, "V")} => g(f(v));\n\n    inc(n: int) -> int => n + 1",
                w => w.callable, none, none,
                (c, a, t, q) => if t.length == 0 then "{c} <*> {a}" else "`<*>{t}({c}, {a})" fi,
                (c, t, q) => if t.length == 0 then "{c} >=> inc" else "`>=>{t}({c}, inc)" fi,
                1, 1
            ),
            // A combinator taking an argument that says nothing about the
            // pack, beside the function.
            POSITION(
                "extra-argument", false, false, false, false,
                x => "apply_after[T.., U](count: int, f: T.. -> U, v: T..) -> U => f(v)",
                x => "retry_n[T.., U](f: T.. -> U, attempts: int) -> T.. -> U => {lambda_head(x, "U")} => f(v)",
                w => w.callable, none, none,
                (c, a, t, q) => "{q}apply_after{t}(3, {with_arguments(c, a)})",
                (c, t, q) => "{q}retry_n{t}({c}, 3)",
                0, 0
            ),
            POSITION(
                "return-spine-depth-1-declared-return", false, false, false, false, run_1_declaration, once_1_declaration,
                declared_spine_1, none, none,
                direct_sibling_call("run_1"), direct_presenting_call("once_1"),
                0, 0
            ),
            POSITION(
                "return-spine-depth-2-declared-return", false, false, false, false, run_2_declaration, once_2_declaration,
                declared_spine_2, none, none,
                direct_sibling_call("run_2"), direct_presenting_call("once_2"),
                0, 0
            ),
            // The function returning the pack function is a global function
            // with a declared return, named in the call.
            POSITION(
                "return-spine-depth-1-named-maker", false, false, false, true, run_1_declaration, once_1_declaration,
                w => "make_1", named_maker_1, none,
                direct_sibling_call("run_1"), direct_presenting_call("once_1"),
                0, 0
            ),
            POSITION(
                "return-spine-depth-2-named-maker", false, false, false, true, run_2_declaration, once_2_declaration,
                w => "make_2", named_maker_2, none,
                direct_sibling_call("run_2"), direct_presenting_call("once_2"),
                0, 0
            ),
            // The function returning the pack function is a literal held in a
            // local variable, named in the call.
            POSITION(
                "return-spine-depth-1-stored-maker", false, false, false, false, run_1_declaration, once_1_declaration,
                w => "make", none, stored_maker_1,
                direct_sibling_call("run_1"), direct_presenting_call("once_1"),
                0, 0
            ),
            POSITION(
                "return-spine-depth-2-stored-maker", false, false, false, false, run_2_declaration, once_2_declaration,
                w => "make", none, stored_maker_2,
                direct_sibling_call("run_2"), direct_presenting_call("once_2"),
                0, 0
            ),
            // The formal is a named delegate, whose call shape takes the pack
            // as its one parameter.
            POSITION(
                "direct-call-delegate", false, false, false, false, delegate_apply_declaration, delegate_once_declaration,
                w => w.callable, none, none,
                direct_sibling_call("apply_d"), direct_presenting_call("once_d"),
                0, 0
            ),
            POSITION(
                "pipe-delegate", true, false, false, false, delegate_apply_declaration, delegate_once_declaration,
                w => w.callable, none, none,
                pipe_sibling_call("apply_d"), pipe_presenting_call("once_d"),
                0, 0
            )
        ])

    PINNINGS: LIST[PINNING] static =>
        LIST[PINNING]([
            PINNING("sibling-pinned", true, false),
            PINNING("context-pinned", false, true),
            PINNING("unpinned", false, false)
        ])

    CALLEES: LIST[CALLEE] static =>
        LIST[CALLEE]([
            CALLEE("global", CalleeKind.GLOBAL),
            CALLEE("static-method", CalleeKind.STATIC_METHOD),
            CALLEE("instance-method", CalleeKind.INSTANCE_METHOD),
            CALLEE("self-call", CalleeKind.SELF_CALL),
            CALLEE("generic-owner", CalleeKind.GENERIC_OWNER)
        ])

    // Cells the language itself rules out, rather than ones that fail today.
    skip_reason(cell: CELL) -> string? is
        if cell.arity == 0 /\ cell.pinning.is_sibling /\ cell.position.passes_arguments_as_tuple then
            // An operator's operand is one expression, and an empty pack has
            // no expression to write there.
            return "an operator has no operand for an empty pack"
        fi

        if cell.arity == 0 /\ cell.callee.kind == CalleeKind.GENERIC_OWNER then
            // The class is instantiated with the pack's type, and there is no
            // empty tuple type to write.
            return "an empty pack has no type argument to write"
        fi

        if cell.position.wraps_in_global /\ cell.shape.preamble(cell.arity).length > 0 then
            return "a global function cannot name a local variable of the cell"
        fi

        if cell.shape.read.length > 0 /\ !cell.pinning.is_sibling /\ cell.position.presenting_adjustment != 0 then
            // The presenting operator composes with `inc`, which takes the
            // function's result, and a task is not an int.
            return "inc does not take a task"
        fi

        if !cell.shape.passes_tuple then
            return null
        fi

        if cell.arity == 0 then
            return "there is no empty tuple to write out"
        fi

        if cell.arity == 1 then
            // There are no one-element tuples: a single argument is the
            // value itself, which is the named-function cell.
            return "no one-element tuples"
        fi

        if !cell.pinning.is_sibling then
            // The arguments are supplied by the call of the presented
            // result, which is an N-ary function, so one tuple argument is
            // an arity error by definition.
            return "the presented result is N-ary"
        fi

        if cell.position.passes_arguments_as_tuple then
            // The operand already is the written-out tuple, so the cell is
            // the named-function cell.
            return "an operator operand is already the tuple"
        fi

        return null
    si

    // Every cell, grouped so that the cells differing only in arity are
    // adjacent. Only the positions that cross callees are reached through a
    // receiver.
    all_cells() -> LIST[CELL] is
        let result = LIST[CELL]()

        for callee in CALLEES do
            for shape in SHAPES do
                for position in POSITIONS do
                    if callee.kind != CalleeKind.GLOBAL /\ !position.crosses_callees then
                        continue
                    fi

                    for pinning in PINNINGS do
                        for arity in ARITIES do
                            result.add(CELL(callee, shape, position, pinning, arity))
                        od
                    od
                od
            od
        od

        result
    si

    // A combinator declaration as a member of the class holding the
    // combinators: static where the callee is, and without its own type
    // parameters where the class declares them.
    member_declaration(declaration: string, kind: CalleeKind) -> string is
        if kind == CalleeKind.STATIC_METHOD then
            let arrow = declaration.index_of(" => ")

            return "{declaration.substring(0, arrow)} static{declaration.substring(arrow)}"
        fi

        if kind == CalleeKind.GENERIC_OWNER then
            let open = declaration.index_of('[')
            let close = declaration.index_of(']')

            return "{declaration.substring(0, open)}{declaration.substring(close + 1)}"
        fi

        declaration
    si

    // The cell's program. With `explicit` set, every type the compiler would
    // otherwise infer is written out: lambda parameters and returns, local
    // variable types, and the type arguments of every generic call. The two
    // programs are otherwise the same text, so they should compile to the
    // same IL.
    program(cell: CELL, explicit: bool) -> string is
        let shape = cell.shape
        let position = cell.position
        let arity = cell.arity
        let kind = cell.callee.kind

        let callable mut = if explicit then shape.explicit_callable(arity) else shape.callable(arity) fi

        if shape.is_literal /\ position.parenthesises_literal then
            callable = "({callable})"
        fi

        let wrapping = WRAPPING(callable, function_type(arity, shape.result), explicit)

        callable = position.wrap(wrapping)

        let declarations = LIST[string]()
        let members = LIST[string]()

        let shape_declaration = shape.declaration(arity)

        if shape_declaration.length > 0 then
            declarations.add(shape_declaration)
        fi

        let maker_declaration = position.maker_declaration(wrapping)

        if maker_declaration.length > 0 then
            declarations.add(maker_declaration)
        fi

        let statements = LIST[string]()

        let receiver =
            case kind
            when CalleeKind.GLOBAL then ""
            when CalleeKind.STATIC_METHOD then "COMBINATORS."
            when CalleeKind.SELF_CALL then "self."
            else "combinators."
            esac

        if kind == CalleeKind.INSTANCE_METHOD then
            statements.add("let combinators{if explicit then ": COMBINATORS" else "" fi} = COMBINATORS()")
        elif kind == CalleeKind.GENERIC_OWNER then
            let owner = "COMBINATORS[{pack_type(arity)}, {shape.result}]"

            statements.add("let combinators{if explicit then ": {owner}" else "" fi} = {owner}()")
        fi

        let preamble = if explicit then shape.explicit_preamble(arity) else shape.preamble(arity) fi

        if preamble.length > 0 then
            statements.add(preamble)
        fi

        let maker_preamble = position.maker_preamble(wrapping)

        if maker_preamble.length > 0 then
            statements.add(maker_preamble)
        fi

        let want mut = expected(arity)

        let combinator_declaration =
            if cell.pinning.is_sibling then
                position.sibling_declaration(explicit)
            else
                position.presenting_declaration(explicit)
            fi

        if kind == CalleeKind.GLOBAL then
            declarations.add(combinator_declaration)
        else
            members.add(member_declaration(combinator_declaration, kind))
        fi

        // A generic owner's methods take no type arguments of their own.
        let writes_type_arguments = explicit /\ kind != CalleeKind.GENERIC_OWNER

        let read_result = (call: string) -> string =>
            if shape.read.length == 0 then call else "({call}){shape.read}" fi

        if cell.pinning.is_sibling then
            let arguments =
                if shape.passes_tuple \/ position.passes_arguments_as_tuple then
                    tuple_arguments(arity)
                else
                    spread_arguments(arity)
                fi

            let type_arguments = if writes_type_arguments then "[{pack_type(arity)}, {shape.result}]" else "" fi

            statements.add("return {read_result(position.sibling_call(callable, arguments, type_arguments, receiver))}")
        else
            want = want + position.presenting_adjustment

            let presented_type = function_type(arity, shape.result)

            let annotation = if cell.pinning.is_context \/ explicit then ": {presented_type}" else "" fi

            let type_arguments =
                if writes_type_arguments then
                    let extra = LIST[string]((1::position.presenting_extra_type_arguments) |> map(i => ", int"))

                    "[{pack_type(arity)}, {shape.result}{extra |> join("")}]"
                else
                    ""
                fi

            statements.add("let g{annotation} = {position.presenting_call(callable, type_arguments, receiver)}")
            statements.add("return {read_result("g({spread_arguments(arity)})")}")
        fi

        let text = System.Text.StringBuilder()

        text
            .append("// Generated by tools/argument-pack-grid: regenerate\n")
            .append("// rather than edit.\n")
            .append("//\n")

        if kind != CalleeKind.GLOBAL then
            text.append("// callee:   {cell.callee.slug}\n")
        fi

        text
            .append("// shape:    {shape.slug}\n")
            .append("// position: {position.slug}\n")
            .append("// pinning:  {cell.pinning.slug}\n")
            .append("// arity:    {arity}\n")

        if explicit then
            text.append("// types:    explicit\n")
        fi

        text
            .append("\n")
            .append("namespace Grid is\n")
            .append("    use IO.Std.write_line;\n")

        for declaration in declarations do
            text.append("\n    {declaration};\n")
        od

        if kind != CalleeKind.GLOBAL then
            let type_parameters = if kind == CalleeKind.GENERIC_OWNER then "[T.., U]" else "" fi

            text.append("\n    class COMBINATORS{type_parameters} is\n")

            if kind != CalleeKind.STATIC_METHOD then
                text.append("        init() is si\n")
            fi

            for member in members do
                text.append("\n        {member};\n")
            od

            if kind == CalleeKind.SELF_CALL then
                text.append("\n        run() -> int is\n")

                for statement in statements do
                    text.append("            {statement};\n")
                od

                text.append("        si\n")
            fi

            text.append("    si\n")
        fi

        if kind == CalleeKind.SELF_CALL then
            let receiver_annotation = if explicit then ": COMBINATORS" else "" fi

            text
                .append("\n    cell() -> int is\n")
                .append("        let combinators{receiver_annotation} = COMBINATORS();\n")
                .append("        return combinators.run();\n")
        else
            text.append("\n    cell() -> int is\n")

            for statement in statements do
                text.append("        {statement};\n")
            od
        fi

        let result_annotation = if explicit then ": int" else "" fi

        text
            .append("    si\n")
            .append("\n")
            .append("    entry() is\n")
            .append("        try\n")
            .append("            let result{result_annotation} = cell();\n")
            .append("\n")
            .append("            if result == {want} then\n")
            .append("                write_line(\"ok {{result}}\");\n")
            .append("            else\n")
            // Not the value itself: a cell that reads memory it never set
            // gets a different one on every run.
            .append("                write_line(\"wrong result, expected {want}\");\n")
            .append("            fi\n")
            .append("        catch e: System.Exception\n")
            .append("            write_line(\"exception {{e.get_type()}}\");\n")
            .append("        yrt\n")
            .append("    si\n")
            .append("si\n")

        text.to_string()
    si
si
