namespace ArgumentPackGrid is
    use default

    use IO.File
    use IO.Directory
    use IO.Path

    GHUL_JSON: string static =>
        "\{\n    \"compiler\": \"../../../../publish/ghul.dll\",\n    \"binary\": \"binary.exe\"\n\}\n"

    generate(root: string) -> int is
        Directory.create_directory(root)

        let wanted = SET[string]()
        let skipped mut = 0

        for cell in all_cells() do
            if skip_reason(cell)? then
                skipped = skipped + 1
                continue
            fi

            let directory = Path.combine(root, cell.slug)

            wanted.add(cell.slug)

            Directory.create_directory(directory)

            File.write_all_text(Path.combine(directory, "test.ghul"), program(cell, false))
            File.write_all_text(Path.combine(directory, "ghulflags"), "")
            File.write_all_text(Path.combine(directory, "ghul.json"), GHUL_JSON)
            File.write_all_text(Path.combine(directory, "tags"), "generics inference lambdas\n")
        od

        // A cell no longer in the grid would otherwise keep running with
        // whatever it was last generated as.
        for directory in Directory.get_directories(root) do
            let name = Path.get_file_name(directory)!

            if !wanted.contains(name) /\ File.exists(Path.combine(directory, "ghulflags")) then
                Directory.delete(directory, true)
                write_line("removed stale cell {name}")
            fi
        od

        write_line("generated {wanted.count} cells under {root}, skipped {skipped} the language rules out")

        0
    si

    outcome(root: string, cell: CELL) -> string is
        if skip_reason(cell)? then
            return "·"
        fi

        let directory = Path.combine(root, cell.slug)

        if File.exists(Path.combine(directory, "fail.expected")) then
            return "C"
        fi

        let run = Path.combine(directory, "run.expected")

        if !File.exists(run) then
            return "?"
        fi

        let text = File.read_all_text(run)

        if text.starts_with("ok ") then
            "✓"
        elif text.starts_with("wrong ") then
            "W"
        elif text.starts_with("exception ") then
            "X"
        else
            "?"
        fi
    si

    // The first error each failing cell records, with its location removed,
    // so the table can be read beside what the compiler says.
    first_error(root: string, cell: CELL) -> string? is
        let path = Path.combine(Path.combine(root, cell.slug), "err.expected")

        if !File.exists(path) then
            return null
        fi

        let lines = File.read_all_lines(path)

        if lines.count == 0 then
            return null
        fi

        let line = lines[0]
        let marker = ": error: "
        let at = line.index_of(marker)

        let message = if at < 0 then line else line.substring(at + marker.length) fi

        // Arity shows up in a message as the length of a tuple of ints, so
        // collapsing those lets one gap across every arity count as one.
        let without_arity = System.Text.RegularExpressions.Regex.replace(message, "\\(int(, int)+\\)", "(int, ...)")

        System.Text.RegularExpressions.Regex.replace(without_arity, "( pure)+", " pure")
    si

    report(root: string) -> int is
        let cells = all_cells()

        let counts = MAP[string, int]()
        let errors = MAP[string, int]()

        write_line("| callee | shape | position | pinning | {ARITIES |> map(i => "{i}") |> join(" | ")} |")
        write_line("|---|---|---|---|{ARITIES |> map(i => "---") |> join("|")}|")

        let row = LIST[string]()

        for cell in cells do
            let result = outcome(root, cell)

            counts[result] = if counts.contains_key(result) then counts[result] + 1 else 1 fi

            if result =~ "C" then
                if let message = first_error(root, cell) then
                    errors[message] = if errors.contains_key(message) then errors[message] + 1 else 1 fi
                fi
            fi

            row.add(result)

            if cell.arity == MAX_ARITY then
                write_line("| {cell.callee.slug} | {cell.shape.slug} | {cell.position.slug} | {cell.pinning.slug} | {row |> join(" | ")} |")
                row.clear()
            fi
        od

        write_line("")

        for (key, value) in counts do
            write_line("- `{key}`: {value}")
        od

        write_line("")

        for (key, value) in errors do
            write_line("- {value} x `{key}`")
        od

        0
    si

    entry(args: ARRAY[string]) -> int is
        if args.count == 2 /\ args[0] =~ "generate" then
            return generate(args[1])
        elif args.count == 2 /\ args[0] =~ "report" then
            return report(args[1])
        fi

        write_line("usage: argument-pack-grid generate|report <grid-directory>")

        1
    si
si
