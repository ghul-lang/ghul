namespace InferenceStrip is
    use default

    // Whether a local's written type says more than its initializer does,
    // and so stays even where inference would recover a type: a local
    // declared at a trait, an abstract base or a union, which ghūl names
    // in PascalCase, or at an optional it is not initialized absent. The
    // program's output is the same without the annotation; what is lost
    // is the reader being told the variable is meant to hold the wider
    // type.
    class WIDER_ANNOTATION is
        // `site` is a line of the compiler's `--strip-annotations list`
        // output: number, kind, position, mode, then the written type's
        // span as start line, start column, end line, end column.
        declares(text: string, site: string) -> bool static is
            let fields = site.split([' '])

            if fields.count < 5 \/ !(fields[1] =~ "local") \/ !(fields[3] =~ "type") then
                return false
            fi

            let span = fields[4].split([',']) |> map(f => int.parse(f)) |> collect_mutable()

            if span[0] != span[2] then
                return false
            fi

            let lines = text.split(['\n'])
            let line = lines[span[0] - 1]
            let written = line.substring(span[1] - 1, span[3] - span[1] + 1)

            if written.ends_with("?") then
                let rest = line.substring(span[3]).trim_start()
                let initializer = if rest.starts_with("mut") then rest.substring(3).trim_start() else rest fi

                return !(initializer.starts_with("= null") \/ initializer.length == 0)
            fi

            names_a_wider_type(written)
        si

        // A type whose name, or whose element or first type argument's
        // name, is PascalCase: an upper-case letter followed somewhere by
        // a lower-case one. A concrete class is written in upper case and
        // a primitive in lower case, so neither matches.
        names_a_wider_type(written: string) -> bool static is
            let name = written.trim_end(['[', ']'])
            let bracket = name.index_of('[')
            let head = if bracket > 0 then name.substring(0, bracket) else name fi
            let last = head.substring(head.last_index_of('.') + 1)

            if last.length > 1 /\ char.is_upper(last[0]) /\ (last |> any(c => char.is_lower(c))) then
                return true
            fi

            bracket > 0 /\ names_a_wider_type(name.substring(bracket + 1).trim_end([']']).split([','])[0].trim())
        si
    si
si
