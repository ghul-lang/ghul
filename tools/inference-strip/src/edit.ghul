namespace InferenceStrip is
    use default

    use System.Text.RegularExpressions.Regex

    // Takes the selected annotations out of a source file's text, leaving
    // everything else as its author wrote it. Each site is a line of the
    // compiler's `--strip-annotations list` output, which gives the span
    // the annotation occupies: `type` spans are a written type, taken out
    // with the ':' or '->' before it, and `after` spans run from the end of
    // one location to the end of another, as a call's type arguments do.
    class SOURCE_EDIT is
        apply(text: string, sites: Iterable[string]) -> string static is
            let line_starts = LIST[int]()

            line_starts.add(0)

            for i in 0..text.length do
                if text[i] == '\n' then
                    line_starts.add(i + 1)
                fi
            od

            let offset = (line: int, column: int) => line_starts[line - 1] + column - 1

            let ranges = LIST[(start: int, end: int)]()
            let any_parameter mut = false

            for site in sites do
                let fields = site.split([' '])

                if fields.count >= 6 then
                    let from = fields[4].split([',']) |> map(f => int.parse(f)) |> collect_mutable()
                    let to = fields[5].split([',']) |> map(f => int.parse(f)) |> collect_mutable()

                    if fields[3] =~ "type" then
                        let start mut = offset(from[0], from[1])

                        // The introducing token can sit on the line
                        // before the annotation, so the search for it
                        // crosses the break and the removal takes it.
                        start = _back_over_layout(text, start)

                        if start >= 2 /\ text[start - 2] == '-' /\ text[start - 1] == '>' then
                            start = start - 2
                        elif start >= 1 /\ text[start - 1] == ':' then
                            start = start - 1
                        fi

                        start = _back_over_layout(text, start)

                        ranges.add((start, offset(to[0], to[1]) + 1))

                        if fields[1] =~ "parameter" then
                            any_parameter = true
                        fi
                    elif fields[3] =~ "after" then
                        // A type argument list ends at its closing ']'; the
                        // location it is read from can run on past it.
                        let start = offset(from[2], from[3]) + 1
                        let close = text.last_index_of(']', offset(to[0], to[1]))

                        if close >= start then
                            ranges.add((start, close + 1))
                        fi
                    fi
                fi
            od

            ranges.sort((a, b) -> int => b.start - a.start)

            let result = System.Text.StringBuilder(text)

            for r in ranges do
                result.remove(r.start, r.end - r.start)
            od

            let edited = result.to_string()

            // A function literal left with one bare parameter drops its
            // parentheses, as it would have been written without the type.
            if any_parameter then
                Regex.replace(edited, "(?<![A-Za-z0-9_\\]\\)])\\(([a-z_][A-Za-z0-9_]*)\\)(\\s*=>)", "$1$2")
            else
                edited
            fi
        si

        _back_over_layout(text: string, position: int) -> int static is
            let p mut = position

            while
                p > 0 /\
                (text[p - 1] == ' ' \/ text[p - 1] == '\t' \/ text[p - 1] == '\n' \/ text[p - 1] == '\r')
            do
                p = p - 1
            od

            p
        si
    si
si
