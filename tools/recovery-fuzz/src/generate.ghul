namespace RecoveryFuzz is
    use default

    // Builds a well-formed program around one or more damage sites. The
    // program is compiled before it is damaged as well as after, so a
    // generator bug shows up as a baseline failure rather than as a
    // recovery finding.
    //
    // The shapes it varies are the ones an editor holds half-written. A
    // half-finished method is the ordinary case in an IDE, not the
    // exceptional one, so the contexts are weighted evenly rather than
    // towards the tidy ones.
    contexts() -> LIST[string] =>
        LIST[string]([
            "top-level",
            "global-block",
            "global-expression",
            "method-block",
            "method-expression",
            "trait-default",
            "nested-literal",
            "generator",
            "async",
            "property-accessor",
            "operator",
            "union-impl",
            "struct-method",
            "primary-constructor",
            "namespaced",
            "lambda-argument",
            "case-expression"
        ])

    // How much program to wrap around the damage. The small end matters as
    // much as the large: a three-line file gives recovery almost nothing to
    // resynchronise on, and a file of one expression has no statement list
    // at all.
    scales() -> LIST[string] => LIST[string](["tiny", "small", "medium", "large"])

    class SCALE(name: string) is
        // Nesting depth around the damage, extra sibling definitions, and
        // how many statements a body carries.
        depth: int =>
            case name
            when "tiny" then 0
            when "small" then 1
            when "medium" then 2
            else 4
            esac

        siblings: int =>
            case name
            when "tiny" then 0
            when "small" then 1
            when "medium" then 2
            else 5
            esac

        leaves: int =>
            case name
            when "tiny" then 1
            when "small" then 1
            when "medium" then 2
            else 4
            esac
    si

    class GENERATOR(rng: RNG) is
        _lines: LIST[LINE];
        _next_name: int;
        _has_tail: bool;
        _wrap_namespace: bool;
        _scale: SCALE;

        init(..) is
            _lines = LIST[LINE]()
            _next_name = 0
            _has_tail = false
            _scale = SCALE("medium")
        si

        generate(seed: int, context: string, scale: string) -> PROGRAM is
            _lines = LIST[LINE]()
            _next_name = 0
            _has_tail = false
            _wrap_namespace = false
            _scale = SCALE(scale)

            _plain(0, "use default")
            _plain(0, "")

            _canary(0, "before_canary", before_marker())
            _plain(0, "")

            // Sibling definitions ahead of the damaged one, so recovery has
            // something to lose on both sides of it.
            for i in 0.._scale.siblings do
                _plain(0, "spare_{i}(n: int) -> int => n + {i}")
                _plain(0, "")
            od

            case context
            when "top-level" then _top_level()
            when "global-block" then _global_block()
            when "global-expression" then _global_expression()
            when "method-block" then _classy("class", "CARRIER", false)
            when "method-expression" then _classy("class", "CARRIER", true)
            when "trait-default" then _classy("trait", "Carrier", false)
            when "nested-literal" then _nested_literal()
            when "generator" then _generator()
            when "async" then _async()
            when "property-accessor" then _property_accessor()
            when "operator" then _operator()
            when "union-impl" then _union_impl()
            when "struct-method" then _struct_method()
            when "primary-constructor" then _primary_constructor()
            when "namespaced" then _namespaced()
            when "lambda-argument" then _lambda_argument()
            when "case-expression" then _case_expression()
            esac

            _plain(0, "")
            _canary(0, "after_canary", after_marker())

            if _wrap_namespace then
                _wrap()
            fi

            let program = PROGRAM(seed, context, _lines)
            program.has_tail = _has_tail

            program
        si

        // Contexts

        _top_level() is
            _body(0, true)
        si

        _global_block() is
            _opener(0, "worker(n: int) -> int is")
            _body(4, true)
            _statement(4, "return n")
            _closer(0, "si")
        si

        // An expression body has nowhere to put a tail marker, so its
        // damage site is the expression itself and only the outer canaries
        // stand.
        _global_expression() is
            _opener(0, "worker(n: int) -> int =>")
            _statement(4, "if n > 0 then n * 2 else n + {rng.next(9) + 1} fi")
        si

        _classy(kind: string, name: string, expression_bodied: bool) is
            _opener(0, "{kind} {name} is")

            if kind =~ "class" then
                _plain(4, "init() is si")
                _plain(4, "")
            fi

            if expression_bodied then
                _opener(4, "measure(n: int) -> int =>")
                _statement(8, "if n > 0 then n * 2 else n + {rng.next(9) + 1} fi")
            else
                _opener(4, "measure(n: int) -> int is")
                _body(8, true)
                _statement(8, "return n")
                _closer(4, "si")
            fi

            _closer(0, "si")
        si

        _nested_literal() is
            _opener(0, "worker(n: int) -> int is")
            _opener(4, "let inner = (m: int) -> int is")
            _body(8, true)
            _statement(8, "return m")
            _closer(4, "si")
            _statement(4, "return inner(n)")
            _closer(0, "si")
        si

        _generator() is
            _opener(0, "worker(n: int) -> Pipe[int] is")
            _body(4, true)
            _statement(4, "yield n")
            _closer(0, "si")
        si

        _async() is
            _opener(0, "worker(n: int) -> Tasks.TASK[int] is")
            _body(4, true)
            _statement(4, "await Tasks.TASK.yield()")
            _statement(4, "return n")
            _closer(0, "si")
        si

        _property_accessor() is
            _opener(0, "class CARRIER is")
            _plain(4, "_stored: int;")
            _plain(4, "")
            _plain(4, "init() is _stored = 0; si")
            _plain(4, "")
            _opener(4, "measure: int is")
            _body(8, true)
            _statement(8, "return _stored")
            _closer(4, "si")
            _closer(0, "si")
        si

        _operator() is
            _opener(0, "class CARRIER is")
            _plain(4, "value: int;")
            _plain(4, "")
            _plain(4, "init(value: int) is self.value = value; si")
            _plain(4, "")
            _opener(4, "+(other: CARRIER) -> int is")
            _body(8, true)
            _statement(8, "return value + other.value")
            _closer(4, "si")
            _closer(0, "si")
        si

        _union_impl() is
            _opener(0, "union Shape is")
            _plain(4, "CIRCLE(radius: int);")
            _plain(4, "SQUARE(side: int);")
            _closer(0, "si")
            _plain(0, "")
            _opener(0, "partial Shape is")
            _opener(4, "measure() -> int is")
            _body(8, true)
            _statement(8, "return 0")
            _closer(4, "si")
            _closer(0, "si")
        si

        _struct_method() is
            _opener(0, "struct POINT is")
            _plain(4, "x: int;")
            _plain(4, "")
            _plain(4, "init(x: int) is self.x = x; si")
            _plain(4, "")
            _opener(4, "measure() -> int is")
            _body(8, true)
            _statement(8, "return x")
            _closer(4, "si")
            _closer(0, "si")
        si

        _primary_constructor() is
            _opener(0, "class CARRIER(first: int, second: int) is")
            _opener(4, "measure() -> int is")
            _body(8, true)
            _statement(8, "return first + second")
            _closer(4, "si")
            _closer(0, "si")
        si

        // A file cannot mix global definitions with a namespace, so this
        // context moves the whole file inside one rather than adding a
        // namespace beside the canaries.
        _namespaced() is
            _wrap_namespace = true

            _opener(0, "worker(n: int) -> int is")
            _body(4, true)
            _statement(4, "return n")
            _closer(0, "si")
        si

        _wrap() is
            let wrapped = LIST[LINE]()

            wrapped.add(LINE(0, "namespace Generated is"))

            for line in _lines do
                let moved = LINE(if line.text.length == 0 then 0 else line.indent + 4 fi, line.text)
                moved.role = line.role
                wrapped.add(moved)
            od

            wrapped.add(LINE(0, "si"))

            _lines = wrapped
        si

        _lambda_argument() is
            _opener(0, "worker(n: int) -> int is")
            _statement(4, "let total mut = 0")
            _opener(4, "let doubled = LIST[int]([1, 2, 3]) |> map(m is")
            _body(8, true)
            _statement(8, "return m * 2")
            _closer(4, "si) |> collect_mutable()")
            _statement(4, "return n + doubled.count")
            _closer(0, "si")
        si

        _case_expression() is
            _opener(0, "worker(n: int) -> int is")
            _statement(4, "let total mut = 0")
            _opener(4, "let picked =")
            _opener(8, "case n")
            _opener(8, "when 0 then")
            _statement(12, "total + 1")
            _opener(8, "else")
            _statement(12, "total + 2")
            _closer(8, "esac")
            _canary_statement(4, tail_marker())
            _statement(4, "return picked")
            _closer(0, "si")
        si

        // Bodies

        // A run of statements with a damage site somewhere in it, then the
        // tail marker, so that everything the recovery drops is measurable.
        _body(indent: int, want_tail: bool) is
            _statement(indent, "let total mut = 0")

            _nest(indent, _scale.depth)

            if want_tail then
                _canary_statement(indent, tail_marker())
            fi
        si

        _nest(indent: int, depth: int) is
            if depth <= 0 then
                for i in 0.._scale.leaves do
                    _leaf(indent)
                od

                return
            fi

            case rng.next(6)
            when 0 then
                _opener(indent, "if total < {rng.next(9) + 1} then")
                _nest(indent + 4, depth - 1)
                _closer(indent, "fi")
            when 1 then
                _opener(indent, "while total < {rng.next(9) + 1} do")
                _nest(indent + 4, depth - 1)
                _statement(indent + 4, "total = total + 1")
                _closer(indent, "od")
            when 2 then
                _opener(indent, "for step in 1..{rng.next(5) + 2} do")
                _nest(indent + 4, depth - 1)
                _statement(indent + 4, "total = total + step")
                _closer(indent, "od")
            when 3 then
                _opener(indent, "case total")
                _opener(indent, "when {rng.next(4)} then")
                _nest(indent + 4, depth - 1)
                _opener(indent, "else")
                _statement(indent + 4, "total = total - 1")
                _closer(indent, "esac")
            when 4 then
                _opener(indent, "if total < {rng.next(9) + 1} then")
                _nest(indent + 4, depth - 1)
                _opener(indent, "elif total > 20 then")
                _statement(indent + 4, "total = total - 2")
                _opener(indent, "else")
                _statement(indent + 4, "total = total + 2")
                _closer(indent, "fi")
            else
                _opener(indent, "try")
                _nest(indent + 4, depth - 1)
                _opener(indent, "catch caught: System.Exception")
                _statement(indent + 4, "total = total + caught.message.length")
                _opener(indent, "finally")
                _statement(indent + 4, "total = total + 1")
                _closer(indent, "yrt")
            esac
        si

        // The innermost statements, and where a damage site lands most
        // often: an assignment with a value, which is the shape a
        // half-written line takes.
        _leaf(indent: int) is
            let a = _name()
            let b = _name()

            _statement(indent, "let {a} = total + {rng.next(20)}")
            _statement(indent, "total = {a} * {rng.next(5) + 1}")
            _statement(indent, "let {b} =")
            _statement(indent + 4, "{a} + total * {rng.next(7) + 1}")
            _statement(indent, "write_line(\"{{{b}}} and {{{a}}}\")")
        si

        // Lines

        _name() -> string is
            _next_name = _next_name + 1

            "value_{_next_name}"
        si

        _add(indent: int, text: string, role: string) is
            let line = LINE(indent, text)
            line.role = role
            _lines.add(line)
        si

        _plain(indent: int, text: string) is _add(indent, text, "plain") si
        _statement(indent: int, text: string) is _add(indent, text, "statement") si
        _opener(indent: int, text: string) is _add(indent, text, "opener") si
        _closer(indent: int, text: string) is _add(indent, text, "closer") si

        _canary(indent: int, name: string, marker: string) is
            _plain(indent, "{name}() -> int => {marker}")
        si

        _canary_statement(indent: int, marker: string) is
            _has_tail = true
            _plain(indent, "total = total + {marker}")
        si
    si
si
