namespace RecoveryFuzz is
    use default

    // The ways a program under an editor's cursor is broken. Each one names
    // the markers it leaves reachable: a mutation that deletes the rest of
    // the file cannot be asked to preserve what it deleted, and the oracle
    // reads the expectation rather than assuming it.
    mutations() -> LIST[string] =>
        LIST[string]([
            "truncate-file",
            "drop-value",
            "drop-line-tail",
            "drop-closer",
            "swap-closer",
            "duplicate-closer",
            "drop-opener-keyword",
            "drop-open-bracket",
            "drop-close-bracket",
            "insert-stray",
            "delete-token",
            "replace-with-keyword",
            "unterminated-string",
            "unterminated-interpolation",
            "drop-type-annotation",
            "drop-arrow",
            "drop-comma",
            "duplicate-line",
            "swap-lines",
            "reindent-block",
            "paste-block",
            "join-lines",
            "split-token"
        ])

    strays() -> LIST[string] =>
        LIST[string]([")", "]", "=", ",", "fi", "od", ".", "|>", "si", "esac", "then", "}}", "\"", "{{", "for", "in", "use", "yield"])

    keywords() -> LIST[string] =>
        LIST[string](["if", "then", "else", "fi", "while", "do", "od", "case", "esac", "try", "yrt", "is", "si", "let", "return", "for", "in", "use", "yield"])

    class MUTATOR(rng: RNG) is
        apply(program: PROGRAM, mutation: string) -> bool is
            case mutation
            when "truncate-file" then return _truncate_file(program)
            when "drop-value" then return _drop_value(program)
            when "drop-line-tail" then return _drop_line_tail(program)
            when "drop-closer" then return _drop_closer(program)
            when "swap-closer" then return _swap_closer(program)
            when "duplicate-closer" then return _duplicate_closer(program)
            when "drop-opener-keyword" then return _drop_opener_keyword(program)
            when "drop-open-bracket" then return _drop_bracket(program, true)
            when "drop-close-bracket" then return _drop_bracket(program, false)
            when "insert-stray" then return _insert_stray(program)
            when "delete-token" then return _delete_token(program)
            when "replace-with-keyword" then return _replace_with_keyword(program)
            when "unterminated-string" then return _unterminated_string(program)
            when "unterminated-interpolation" then return _unterminated_interpolation(program)
            when "drop-type-annotation" then return _drop_text(program, ": int", "drop-type-annotation")
            when "drop-arrow" then return _drop_arrow(program)
            when "drop-comma" then return _drop_text(program, ",", "drop-comma")
            when "duplicate-line" then return _duplicate_line(program)
            when "swap-lines" then return _swap_lines(program)
            when "reindent-block" then return _reindent_block(program)
            when "paste-block" then return _paste_block(program)
            when "join-lines" then return _join_lines(program)
            when "split-token" then return _split_token(program)
            esac

            false
        si

        // A method whose second half has not been written yet: everything
        // from a line inside the body onwards is simply gone, closers
        // included. Nothing after the cut can be expected to survive, so
        // only the leading canary stands.
        _truncate_file(program: PROGRAM) -> bool is
            let at = _pick(program, "statement")

            if at < 0 then
                return false
            fi

            while program.lines.count > at do
                program.lines.remove_at(program.lines.count - 1)
            od

            _record(program, "truncate-file", at, false, false)
        si

        // `x = ` with nothing after it - the line the cursor is sitting on.
        _drop_value(program: PROGRAM) -> bool is
            let at = _pick_containing(program, "=")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let cut = line.text.index_of("=")

            line.text = line.text[0..cut + 1]

            _record(program, "drop-value", at, program.has_tail, true)
        si

        // Half a line, cut at a random column: the state of a line being
        // typed left to right.
        _drop_line_tail(program: PROGRAM) -> bool is
            let at = _pick(program, "statement")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]

            if line.text.length < 3 then
                return false
            fi

            line.text = line.text[0..rng.between(1, line.text.length - 1)]

            _record(program, "drop-line-tail", at, program.has_tail, true)
        si

        _drop_closer(program: PROGRAM) -> bool is
            let at = _pick(program, "closer")

            if at < 0 then
                return false
            fi

            program.lines.remove_at(at)

            _record(program, "drop-closer", at, program.has_tail, true)
        si

        // A closer that belongs to a different construct - what a rename or
        // a bad paste leaves behind.
        _swap_closer(program: PROGRAM) -> bool is
            let at = _pick(program, "closer")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let others = LIST[string]()

            for candidate in LIST[string](["fi", "od", "si", "esac", "yrt"]) do
                if candidate !~ line.text then
                    others.add(candidate)
                fi
            od

            line.text = rng.pick(others)

            _record(program, "swap-closer", at, program.has_tail, true)
        si

        _duplicate_closer(program: PROGRAM) -> bool is
            let at = _pick(program, "closer")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]

            program.lines.insert(at, LINE(line.indent, line.text))

            _record(program, "duplicate-closer", at, program.has_tail, true)
        si

        // `if c` with no `then`, `while c` with no `do`, a header with no
        // `is`: the keyword that has not been typed yet.
        _drop_opener_keyword(program: PROGRAM) -> bool is
            let at = _pick(program, "opener")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let dropped mut = false

            for keyword in LIST[string]([" then", " do", " is", " =>"]) do
                if !dropped /\ line.text.ends_with(keyword) then
                    line.text = line.text[0..line.text.length - keyword.length]
                    dropped = true
                fi
            od

            if !dropped then
                return false
            fi

            _record(program, "drop-opener-keyword", at, program.has_tail, true)
        si

        _drop_bracket(program: PROGRAM, opening: bool) -> bool is
            let kind = rng.next(3)
            let bracket =
                if opening then
                    if kind == 0 then "(" elif kind == 1 then "[" else "{{" fi
                else
                    if kind == 0 then ")" elif kind == 1 then "]" else "}}" fi
                fi
            let at = _pick_containing(program, bracket)

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let cut = line.text.index_of(bracket)

            line.text = "{line.text[0..cut]}{line.text[cut + 1..<0]}"

            _record(
                program,
                if opening then "drop-open-bracket" else "drop-close-bracket" fi,
                at,
                program.has_tail,
                true
            )
        si

        _insert_stray(program: PROGRAM) -> bool is
            let at = _pick(program, "statement")

            if at < 0 then
                return false
            fi

            program.lines.insert(at, LINE(program.lines[at].indent, rng.pick(strays())))

            _record(program, "insert-stray", at, program.has_tail, true)
        si


        // A single token gone, which is what a stray backspace leaves.
        _delete_token(program: PROGRAM) -> bool is
            let at = _pick_any(program)

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let words = LIST[string](line.text.split([' ']))

            if words.count < 2 then
                return false
            fi

            words.remove_at(rng.next(words.count))

            line.text = words |> join(" ")

            _record(program, "delete-token", at, program.has_tail, true)
        si

        // A keyword where a name belongs - the state of a line being typed
        // over, or a completion accepted in the wrong place.
        _replace_with_keyword(program: PROGRAM) -> bool is
            let at = _pick_any(program)

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let words = LIST[string](line.text.split([' ']))

            if words.count == 0 then
                return false
            fi

            words[rng.next(words.count)] = rng.pick(keywords())

            line.text = words |> join(" ")

            _record(program, "replace-with-keyword", at, program.has_tail, true)
        si

        // A string with no closing quote runs to the end of the line at
        // best and swallows the rest of the file at worst, so it is the
        // sharpest test of how far damage travels.
        _unterminated_string(program: PROGRAM) -> bool is
            let at = _pick_containing(program, "\"")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let cut = line.text.last_index_of("\"")

            line.text = "{line.text[0..cut]}{line.text[cut + 1..<0]}"

            _record(program, "unterminated-string", at, false, true)
        si

        _unterminated_interpolation(program: PROGRAM) -> bool is
            let at = _pick_containing(program, "}}")

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let cut = line.text.index_of("}}")

            line.text = "{line.text[0..cut]}{line.text[cut + 1..<0]}"

            _record(program, "unterminated-interpolation", at, false, true)
        si

        _drop_text(program: PROGRAM, text: string, mutation: string) -> bool is
            let at = _pick_containing(program, text)

            if at < 0 then
                return false
            fi

            let line = program.lines[at]
            let cut = line.text.index_of(text)

            line.text = "{line.text[0..cut]}{line.text[cut + text.length..<0]}"

            _record(program, mutation, at, program.has_tail, true)
        si

        _drop_arrow(program: PROGRAM) -> bool is
            if _drop_text(program, " -> int", "drop-arrow") then
                return true
            fi

            _drop_text(program, " =>", "drop-arrow")
        si

        _duplicate_line(program: PROGRAM) -> bool is
            let at = _pick_any(program)

            if at < 0 then
                return false
            fi

            let line = program.lines[at]

            program.lines.insert(at, LINE(line.indent, line.text))

            _record(program, "duplicate-line", at, program.has_tail, true)
        si

        _swap_lines(program: PROGRAM) -> bool is
            let at = _pick_any(program)

            if at < 0 \/ at + 1 >= program.lines.count then
                return false
            fi

            let first = program.lines[at]

            program.lines.remove_at(at)
            program.lines.insert(at + 1, first)

            _record(program, "swap-lines", at, program.has_tail, true)
        si

        // A block left at the wrong indentation by a botched reformat. The
        // program is still well formed, so this one tests that layout
        // heuristics have not quietly become load-bearing.
        _reindent_block(program: PROGRAM) -> bool is
            let at = _pick(program, "opener")

            if at < 0 then
                return false
            fi

            let shift = rng.pick(LIST[int]([-4, 4, 8]))
            let last = System.Math.min(at + rng.between(1, 4), program.lines.count - 1)

            for i in at..last + 1 do
                let line = program.lines[i]

                program.lines[i] = LINE(System.Math.max(0, line.indent + shift), line.text)
                program.lines[i].role = line.role
            od

            _record(program, "reindent-block", at, program.has_tail, true)
        si

        // A run of lines pasted in a second time, closers and all.
        _paste_block(program: PROGRAM) -> bool is
            let at = _pick(program, "opener")

            if at < 0 then
                return false
            fi

            let last = System.Math.min(at + rng.between(1, 5), program.lines.count - 1)
            let copied = LIST[LINE]()

            for i in at..last + 1 do
                copied.add(LINE(program.lines[i].indent, program.lines[i].text))
            od

            let into mut = at

            for line in copied do
                program.lines.insert(into, line)
                into = into + 1
            od

            _record(program, "paste-block", at, program.has_tail, true)
        si

        // Two statements run together, which is what deleting a line break
        // leaves and what the inferred terminators have to cope with.
        _join_lines(program: PROGRAM) -> bool is
            let at = _pick(program, "statement")

            if at < 0 \/ at + 1 >= program.lines.count then
                return false
            fi

            let first = program.lines[at]
            let second = program.lines[at + 1]

            first.text = "{first.text} {second.text}"

            program.lines.remove_at(at + 1)

            _record(program, "join-lines", at, program.has_tail, true)
        si

        // A line break in the middle of a token.
        _split_token(program: PROGRAM) -> bool is
            let at = _pick_any(program)

            if at < 0 then
                return false
            fi

            let line = program.lines[at]

            if line.text.length < 4 then
                return false
            fi

            let cut = rng.between(2, line.text.length - 2)
            let rest = line.text[cut..<0]

            line.text = line.text[0..cut]

            program.lines.insert(at + 1, LINE(line.indent + 4, rest))

            _record(program, "split-token", at, program.has_tail, true)
        si

        _pick_any(program: PROGRAM) -> int is
            let candidates = LIST[int]()

            for i in 0..program.lines.count do
                let line = program.lines[i]

                if line.role !~ "plain" /\ line.text.length > 0 then
                    candidates.add(i)
                fi
            od

            if candidates.count == 0 then
                return -1
            fi

            rng.pick(candidates)
        si

        // Picking

        _pick(program: PROGRAM, role: string) -> int is
            let candidates = LIST[int]()

            for i in 0..program.lines.count do
                if program.lines[i].role =~ role then
                    candidates.add(i)
                fi
            od

            if candidates.count == 0 then
                return -1
            fi

            rng.pick(candidates)
        si

        _pick_containing(program: PROGRAM, text: string) -> int is
            let candidates = LIST[int]()

            for i in 0..program.lines.count do
                let line = program.lines[i]

                if (line.role =~ "statement" \/ line.role =~ "opener") /\ line.text.contains(text) then
                    candidates.add(i)
                fi
            od

            if candidates.count == 0 then
                return -1
            fi

            rng.pick(candidates)
        si

        _record(program: PROGRAM, mutation: string, at: int, tail: bool, after: bool) -> bool is
            program.mutation = mutation
            program.damage_line = at + 1
            program.expect_tail = tail
            program.expect_after = after

            true
        si
    si
si
