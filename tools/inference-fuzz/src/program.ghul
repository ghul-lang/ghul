namespace InferenceFuzz is
    use default

    use System.Text.StringBuilder

    // One generated program: top-level statements declaring locals with
    // as few annotations as the generator can get away with, and a final
    // line printing every one of them. `intended` records the type the
    // generator meant each local to have, for comparison with what the
    // annotator writes back.
    class PROGRAM(seed: int, source: string, intended: LIST[(name: string, type: Type)]);

    class PROGRAMS(rng: RNG, names: NAMES, prelude: PRELUDE, expressions: EXPRESSIONS) is
        statement_count: int public;
        depth: int public;

        init(..) is
            statement_count = 8
            depth = 3
        si

        generate(seed: int) -> PROGRAM is
            let scope = SCOPE(null)
            let out = StringBuilder()
            let intended = LIST[(name: string, type: Type)]()
            let functions = 0

            out.append_line("use default")
            out.append_line("use Ghul.apply")
            out.append_line("use Ghul.`>>")
            out.append_line("")
            out.append(prelude.source())

            for i in 0..statement_count do
                let roll = rng.next(25)

                if roll < 2 then
                    delayed_local(scope, out, intended)
                elif roll < 4 then
                    destructure(scope, out)
                elif roll < 6 then
                    named_function(scope, out)
                elif roll < 8 then
                    if_let(scope, out)
                elif roll < 10 then
                    if_let_type(scope, out)
                elif roll < 12 then
                    pack_statement(scope, out, intended)
                elif roll < 15 then
                    later_pinned(scope, out, intended)
                elif roll < 17 then
                    cast_local(scope, out, intended)
                else
                    local(scope, out, intended)
                fi
            od

            out.append_line("")
            out.append(print_all(scope))

            PROGRAM(seed, out.to_string(), intended)
        si

        // The types a fresh local is drawn from.
        pool() -> LIST[Type] =>
            LIST[Type]([
                TYPES.int, TYPES.bool, TYPES.string, TYPES.double,
                ARRAY(TYPES.int), ARRAY(TYPES.string), LIST_OF(TYPES.int),
                TYPES.tuple(TYPES.int, TYPES.string), TYPES.tuple(TYPES.int, TYPES.int),
                TYPES.func(TYPES.int, TYPES.int), TYPES.func(TYPES.int, TYPES.bool),
                TYPES.func(TYPES.string, TYPES.int), TYPES.func(TYPES.string, TYPES.string),
                TYPES.func(TYPES.int, TYPES.int, TYPES.int),
                TYPES.func(ARRAY(TYPES.int), TYPES.int),
                TYPES.func(TYPES.tuple(TYPES.int, TYPES.int), TYPES.int),
                OPTIONAL(TYPES.int), OPTIONAL(TYPES.string),
                TYPES.tuple(TYPES.int, TYPES.tuple(TYPES.int, TYPES.string)),
                ARRAY(TYPES.tuple(TYPES.int, TYPES.int)), LIST_OF(ARRAY(TYPES.int)),
                prelude.animal, prelude.cat, prelude.dog, prelude.shape, prelude.circle, prelude.colour,
                OPTIONAL(prelude.animal), ARRAY(prelude.animal), ARRAY(prelude.shape), LIST_OF(prelude.animal),
                TYPES.func(prelude.animal, TYPES.string), TYPES.tuple(prelude.cat, prelude.shape)
            ])

        // `let v = e`, or `let v: T = e` one time in four - the annotated
        // form is what lets a literal on the right leave its parameters
        // unannotated.
        local(scope: SCOPE, out: StringBuilder, intended: LIST[(name: string, type: Type)]) is
            for attempt in 0..4 do
                let type = rng.pick(pool())
                let annotate = rng.chance(1, 4)

                if let value = expressions.gen(scope, type, depth, annotate) then
                    let name = names.fresh()

                    if annotate then
                        out.append_line("let {name}: {type.spell()} = {value}")
                        scope.add(BINDING(name, type, true))
                    else
                        out.append_line("let {name} = {value}")
                        intended.add((name = name, type = value.type))
                        scope.add(BINDING(name, value.type, true))
                    fi

                    return
                fi
            od

            let name = names.fresh()

            out.append_line("let {name} = {rng.next(10)}")
            intended.add((name = name, type = TYPES.int))
            scope.add(BINDING(name, TYPES.int, true))
        si

        // A local the generator annotates, initialized by a cast that names
        // no target: the annotation is the only thing saying what to convert
        // to.
        cast_local(scope: SCOPE, out: StringBuilder, intended: LIST[(name: string, type: Type)]) is
            let type = rng.pick(LIST[Type]([TYPES.int, TYPES.double]))

            if let p: PRIM = type then
                if let text = expressions.targetless_cast(p) then
                    let name = names.fresh()

                    out.append_line("let {name}: {p.name} = {text}")
                    intended.add((name = name, type = type))
                    scope.add(BINDING(name, type, true))
                fi
            fi
        si

        // `let v mut` and a later assignment: the assignment is what fixes
        // the type.
        delayed_local(scope: SCOPE, out: StringBuilder, intended: LIST[(name: string, type: Type)]) is
            let type = rng.pick(pool())

            if let value = expressions.gen(scope, type, depth, false) then
                let name = names.fresh()

                out.append_line("let {name} mut")
                out.append_line("{name} = {value}")
                intended.add((name = name, type = value.type))
                scope.add(BINDING(name, value.type, false))
            fi
        si

        // `let (a, b) = pair`: the elements take the tuple's element types.
        destructure(scope: SCOPE, out: StringBuilder) is
            let type = rng.pick(LIST[Type]([
                TYPES.tuple(TYPES.int, TYPES.string), TYPES.tuple(TYPES.int, TYPES.int),
                TYPES.tuple(TYPES.int, TYPES.tuple(TYPES.int, TYPES.string)), TYPES.tuple(prelude.cat, prelude.shape)
            ]))

            if let value = expressions.gen(scope, type, depth, false) then
                out.append_line("let {pattern(scope, cast TUPLE(value.type))} = {value}")
            fi
        si

        // A destructure pattern for the tuple, nesting where an element is
        // a tuple, declaring each leaf into the scope.
        pattern(scope: SCOPE, tuple: TUPLE) -> string is
            let leaves = LIST[string]()

            for e in tuple.elements do
                if let inner: TUPLE = e then
                    leaves.add(pattern(scope, inner))
                else
                    let name = names.fresh()

                    leaves.add(name)
                    scope.add(BINDING(name, e, true))
                fi
            od

            "({leaves |> join(", ")})"
        si

        // A stream held in a local and consumed later, or an each over
        // zipped pairs with a spread lambda: the shapes that chain two
        // pack instantiations through a local.
        pack_statement(scope: SCOPE, out: StringBuilder, intended: LIST[(name: string, type: Type)]) is
            let a = names.fresh()
            let b = names.fresh()

            if rng.coin() then
                let name = names.fresh()
                let advance = rng.pick(LIST[string](["({a}, {b}) => {a} || ({b}, {a} + {b})", "(({a}, {b})) => {a} || ({b}, {a} + {b})"]))

                out.append_line("let {name} = stream((0, 1), {advance})")
                out.append_line("{name} |> take(5) |> index() |> each(({a}, {b}) => write_line(\"{name} {{{a}}} {{{b}}}\"))")
            else
                if let xs = expressions.gen(scope, ARRAY(TYPES.int), depth, true) then
                    out.append_line("{xs} |> zip([\"a\", \"b\"]) |> each(({a}, {b}) => write_line(\"{{{a}}} {{{b}}}\"))")
                fi
            fi
        si

        // A literal whose parameters only a later call pins, wrapping a
        // pack shape: a spread literal over a tuple of the parameter, a
        // stream whose state carries it, or a stored literal composed or
        // passed through a pack-returning function and called afterwards;
        // and a rec literal destructuring a recursive union.
        later_pinned(scope: SCOPE, out: StringBuilder, intended: LIST[(name: string, type: Type)]) is
            let x = names.fresh()
            let p = names.fresh()
            let q = names.fresh()
            let name = names.fresh()
            let roll = rng.next(3)

            if roll == 0 then
                let bodies = LIST[string]([
                    "[({x}, 1)] |> filter(({p}, {q}) => {p} < 100) |> count()",
                    "[{x}, 19] |> zip([{x}]) |> take_while(({p}, {q}) => {p} < 100) |> count()",
                    "stream(({x}, {x}), (({p}, {q})) => {p} || ({q}, {p} + {q})) |> take(4) |> reduce(0, ({p}, {q}) => {p} + {q})",
                    "apply(({p}, {q}) => {p} + {q}, {x}, {x})",
                    "pack_apply(({p}, {q}) => {p} * {q}, {x}, 2)",
                    "apply((({p}: int, {q}: int) => {p} - {q}) >> ({p} => {p} * 2), {x}, 1)"
                ])

                let arg = expressions.gen(scope, TYPES.int, depth, true) ?? "{rng.next(10)}"

                out.append_line("let {name} = {x} => {rng.pick(bodies)}")
                out.append_line("write_line(\"{name} {{{name}({arg})}}\")")
                intended.add((name = name, type = TYPES.func(TYPES.int, TYPES.int)))
                scope.add(BINDING(name, TYPES.func(TYPES.int, TYPES.int), true))
            elif roll == 1 then
                let stored = names.fresh()
                let a = expressions.gen(scope, TYPES.int, depth, true) ?? "{rng.next(10)}"
                let b = expressions.gen(scope, TYPES.int, depth, true) ?? "{rng.next(10)}"
                let composed = rng.pick(LIST[string](["{stored} >> ({x} => {x} * 2)", "pack_retry({stored})", "`>>({stored}, {x} => {x} + 1)"]))

                out.append_line("let {stored} = ({p}, {q}) => {p} + {q}")
                out.append_line("let {name} = {composed}")
                out.append_line("write_line(\"{name} {{{name}({a}, {b})}}\")")
                intended.add((name = stored, type = TYPES.func(TYPES.int, TYPES.int, TYPES.int)))
                intended.add((name = name, type = TYPES.func(TYPES.int, TYPES.int, TYPES.int)))
                scope.add(BINDING(stored, TYPES.func(TYPES.int, TYPES.int, TYPES.int), true))
                scope.add(BINDING(name, TYPES.func(TYPES.int, TYPES.int, TYPES.int), true))
            else
                let c = names.fresh()
                let seed = expressions.gen(scope, TYPES.int, depth, true) ?? "{rng.next(10)}"

                out.append_line("let {name} = {c} rec => if let ({p}, {q}): Chain.LINK = {c} then {p} + rec({q}) else 0 fi")
                out.append_line("write_line(\"{name} {{{name}(Chain.LINK({seed}, Chain.LINK(2, Chain.END)))}}\")")
                intended.add((name = name, type = TYPES.func(prelude.chain, TYPES.int)))
            fi
        si

        // `if let c: CAT = animal then ... fi`: a type test that narrows.
        if_let_type(scope: SCOPE, out: StringBuilder) is
            if let value = expressions.gen(scope, prelude.animal, depth, false) then
                let name = names.fresh()
                let sub = rng.pick(LIST[NAMED]([prelude.cat, prelude.dog]))

                out.append_line("if let {name}: {sub.name} = {value} then")
                out.append_line("    write_line(\"{name} {{{name}.describe()}}\")")
                out.append_line("fi")
            fi
        si

        // A named function among the statements is a namespace-scope
        // function, so its signature is written out; what is left to
        // inference is the reference to it as a value.
        named_function(scope: SCOPE, out: StringBuilder) is
            let shapes = LIST[Type]([
                TYPES.func(TYPES.int, TYPES.int), TYPES.func(TYPES.string, TYPES.int),
                TYPES.func(TYPES.int, TYPES.int, TYPES.int), TYPES.func(TYPES.int, TYPES.string)
            ])
            let f = cast FUNC(rng.pick(shapes))
            let inner = SCOPE(null)
            let parameters = LIST[string]()

            for p in f.parameters do
                let n = names.fresh()

                parameters.add("{n}: {p.spell()}")
                inner.add(BINDING(n, p, true))
            od

            if let body = expressions.gen(inner, f.result, depth, true) then
                let name = "f{names.fresh()}"

                out.append_line("{name}({parameters |> join(", ")}) -> {f.result.spell()} => {body}")
                scope.add(BINDING(name, f, true))
            fi
        si

        // `if let x = optional then ... fi`, printing inside the arm.
        if_let(scope: SCOPE, out: StringBuilder) is
            let type = rng.pick(LIST[Type]([OPTIONAL(TYPES.int), OPTIONAL(TYPES.string)]))

            if let value = expressions.gen(scope, type, depth, false) then
                let name = names.fresh()

                out.append_line("if let {name} = {value} then")
                out.append_line("    write_line(\"{name} {{{name}}}\")")
                out.append_line("fi")
            fi
        si

        // Prints every local, calling the function-typed ones with a
        // literal argument, so each is read at least once and the
        // program's output describes every value.
        print_all(scope: SCOPE) -> string is
            let out = StringBuilder()

            for b in scope.all() do
                if let f: FUNC = b.type then
                    let arguments = LIST[string]()

                    for p in f.parameters do
                        if let argument = expressions.closed(p, 0) then
                            arguments.add(argument.text)
                        fi
                    od

                    if arguments.count == f.parameters.count then
                        out.append_line("write_line(\"{b.name} {{{b.name}({arguments |> join(", ")})}}\")")
                    fi
                elif let a: ARRAY = b.type /\ isa PRIM(a.element) then
                    out.append_line("write_line(\"{b.name} {{{b.name} |> join(\",\")}}\")")
                elif let l: LIST_OF = b.type /\ isa PRIM(l.element) then
                    out.append_line("write_line(\"{b.name} {{{b.name} |> join(\",\")}}\")")
                elif isa ARRAY(b.type) \/ isa LIST_OF(b.type) then
                    out.append_line("write_line(\"{b.name} {{{b.name}.count}}\")")
                elif let n: NAMED = b.type /\ n.is_subtype_of(prelude.animal) then
                    out.append_line("write_line(\"{b.name} {{{b.name}.describe()}}\")")
                else
                    out.append_line("write_line(\"{b.name} {{{b.name}}}\")")
                fi
            od

            out.to_string()
        si
    si
si
