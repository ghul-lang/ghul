namespace InferenceFuzz is
    use default

    use IO.Directory
    use IO.Path

    usage() -> int is
        write_line("usage: inference-fuzz fuzz <work-directory> [--count <n>] [--start <seed>] [--statements <n>] [--depth <n>] [--compiler <ghul.dll>] [--json <file>]")
        write_line("       inference-fuzz generate <directory> [--count <n>] [--start <seed>] [--statements <n>] [--depth <n>]")
        write_line("       inference-fuzz shrink <program-directory> [--compiler <ghul.dll>]")

        1
    si

    entry(args: ARRAY[string]) -> int is
        if args.count < 2 \/ !(args[0] =~ "fuzz" \/ args[0] =~ "generate" \/ args[0] =~ "shrink") then
            return usage()
        fi

        let directory = Path.get_full_path(args[1])
        let count mut = 100
        let start mut = 1
        let statements mut = 8
        let depth mut = 3
        let compiler mut = "publish/ghul.dll"
        let json: string? mut = null
        let i mut = 2

        while i + 1 < args.count do
            if args[i] =~ "--count" then
                count = int.parse(args[i + 1])
            elif args[i] =~ "--start" then
                start = int.parse(args[i + 1])
            elif args[i] =~ "--statements" then
                statements = int.parse(args[i + 1])
            elif args[i] =~ "--depth" then
                depth = int.parse(args[i + 1])
            elif args[i] =~ "--compiler" then
                compiler = args[i + 1]
            elif args[i] =~ "--json" then
                json = Path.get_full_path(args[i + 1])
            else
                write_line("unknown option {args[i]}")
                return 1
            fi

            i = i + 2
        od

        let harness = HARNESS(Path.get_full_path(compiler))

        if args[0] =~ "shrink" then
            write_line(SHRINKER(harness).shrink(directory))
            write_line(IO.File.read_all_text(Path.combine(directory, "test.ghul")))

            return 0
        fi

        let results = LIST[RESULT]()

        Directory.create_directory(directory)

        for seed in start..start + count do
            let rng = RNG(seed)
            let names = NAMES()
            let prelude = PRELUDE(rng)
            let programs = PROGRAMS(rng, names, prelude, EXPRESSIONS(rng, names, prelude))

            programs.statement_count = statements
            programs.depth = depth

            results.add(harness.place(programs.generate(seed), directory))
        od

        if args[0] =~ "generate" then
            write_line("wrote {count} programs under {directory}")

            return 0
        fi

        write_line("checking {count} programs with {compiler}")

        harness.check(results)

        report(results, json)
    si
si
