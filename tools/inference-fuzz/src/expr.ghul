namespace InferenceFuzz is
    use default

    use System.Text.StringBuilder

    // A generated expression and the type the generator says it has:
    // the type inference is expected to find, which is the constructed
    // subtype for a constructor, the join of the arms for a conditional,
    // and so on, rather than the type that was asked for.
    class EXPR(text: string, type: Type) is
        to_string() -> string => text
    si

    // Writes expressions of a wanted type, choosing among the forms that
    // can produce it at random. `depth` is a budget the recursive forms
    // spend; leaves cost nothing. Returns null when no form fits. The
    // expression's own type is assignable to the wanted one and can be
    // narrower.
    //
    // `typed` says whether the position the expression goes into already
    // states its type - a typed local, a call argument - so a literal
    // written there can leave its parameters unannotated and be inferred
    // from the context. Elsewhere a literal annotates them, or constrains
    // them from its own body.
    class EXPRESSIONS(rng: RNG, names: NAMES, prelude: PRELUDE) is
        gen(scope: SCOPE, target: Type, depth: int, typed: bool) -> EXPR? is
            let candidates = LIST[(item: EXPR, weight: int)]()

            leaves(scope, target, typed, candidates)

            if depth > 0 then
                recursive(scope, target, depth, typed, candidates)
            fi

            if candidates.count == 0 then
                return null
            fi

            rng.pick_weighted(candidates)
        si

        // A value that is safe to print and to call with: literals only,
        // no reads of the program's own locals.
        closed(target: Type, depth: int) -> EXPR? => gen(SCOPE(null), target, depth, true)

        exact(text: string, type: Type) -> EXPR => EXPR(text, type)

        leaves(scope: SCOPE, target: Type, typed: bool, into: LIST[(item: EXPR, weight: int)]) is
            let variables = scope.of_type(target)

            if variables.count > 0 then
                let v = rng.pick(variables)

                into.add((item = EXPR(v.name, v.type), weight = 30))
            fi

            if let p: PRIM = target then
                prim_leaf(p, into)
            elif let a: ARRAY = target then
                if let elements = literal_elements(scope, a.element, rng.between(1, 3), 0) then
                    into.add((item = EXPR("[{elements.text}]", ARRAY(elements.type)), weight = 10))
                fi
            elif let l: LIST_OF = target then
                if let elements = list_elements(scope, l.element, 0) then
                    into.add((item = EXPR("[{elements.text}] |> collect_mutable()", LIST_OF(elements.type)), weight = 10))
                fi
            elif let f: FUNC = target then
                if let literal = lambda(scope, f, 0, typed) then
                    into.add((item = literal, weight = 10))
                fi
            elif let t: TUPLE = target then
                if let literal = tuple_literal(scope, t, 0) then
                    into.add((item = literal, weight = 10))
                fi
            elif let n: NAMED = target then
                if let value = construct(scope, rng.pick(concrete_subtypes(n))) then
                    into.add((item = value, weight = 15))
                fi
            fi
        si

        // The declared types a value of `n` can be constructed as: `n`
        // itself where it is concrete, and every declared subtype.
        concrete_subtypes(n: NAMED) -> LIST[NAMED] is
            if n.name =~ "Shape" then
                prelude.variants()
            elif n.name =~ "Colour" then
                LIST[NAMED]([n])
            elif n.parent? /\ n.parent.name =~ "Shape" then
                LIST[NAMED]([n])
            else
                LIST[NAMED](prelude.classes() |> filter(c => c.is_subtype_of(n)))
            fi
        si

        // A constructor call, variant construction or enum member of the
        // concrete type, which is the type the value then has.
        construct(scope: SCOPE, n: NAMED) -> EXPR? is
            if n.name =~ "Shape.CIRCLE" then
                if let r = gen(scope, TYPES.int, 0, true) then EXPR("Shape.CIRCLE({r})", n) else null fi
            elif n.name =~ "Shape.SQUARE" then
                let side = gen(scope, TYPES.int, 0, true)
                let label = gen(scope, TYPES.string, 0, true)

                if side? /\ label? then EXPR("Shape.SQUARE({side}, {label})", n) else null fi
            elif n.name =~ "Shape.DOT" then
                EXPR("Shape.DOT", n)
            elif n.name =~ "Colour" then
                EXPR("Colour.{rng.pick(LIST[string](["RED", "GREEN", "BLUE"]))}", n)
            else
                EXPR("{n.name}()", n)
            fi
        si

        prim_leaf(p: PRIM, into: LIST[(item: EXPR, weight: int)]) is
            if p.name =~ "int" then
                into.add((item = exact("{rng.next(20)}", p), weight = 20))
            elif p.name =~ "bool" then
                into.add((item = exact(if rng.coin() then "true" else "false" fi, p), weight = 20))
            elif p.name =~ "string" then
                into.add((item = exact("\"{rng.pick(LIST[string](["hello", "world", "ghul", "a", ""]))}\"", p), weight = 20))
            elif p.name =~ "double" then
                into.add((item = exact("{rng.next(20)}.5", p), weight = 20))
            fi
        si

        // Elements for an array literal, with the type they join at.
        literal_elements(scope: SCOPE, element: Type, count: int, depth: int) -> EXPR? is
            let parts = LIST[EXPR]()

            for i in 0..count do
                if let e = gen(scope, element, depth, true) then
                    parts.add(e)
                else
                    return null
                fi
            od

            EXPR(parts |> map(p => p.text) |> join(", "), join_of(parts))
        si

        // A list's element type is invariant, so a list meant to be of a
        // declared type is built from every concrete subtype at once,
        // which is what makes the elements join at exactly that type.
        list_elements(scope: SCOPE, element: Type, depth: int) -> EXPR? is
            if let n: NAMED = element then
                let subtypes = concrete_subtypes(n)

                if subtypes.count > 1 then
                    return mixed_elements(scope, subtypes, depth)
                fi
            fi

            literal_elements(scope, element, rng.between(1, 3), depth)
        si

        mixed_elements(scope: SCOPE, subtypes: LIST[NAMED], depth: int) -> EXPR? is
            let parts = LIST[EXPR]()

            for sub in subtypes do
                if let part = gen(scope, sub, depth, true) then
                    parts.add(part)
                else
                    return null
                fi
            od

            EXPR(parts |> map(p => p.text) |> join(", "), join_of(parts))
        si

        join_of(parts: LIST[EXPR]) -> Type is
            let result mut = parts[0].type

            for p in parts do
                result = lub(result, p.type)
            od

            result
        si

        tuple_literal(scope: SCOPE, t: TUPLE, depth: int) -> EXPR? is
            let parts = LIST[EXPR]()

            for e in t.elements do
                if let part = gen(scope, e, depth, true) then
                    parts.add(part)
                else
                    return null
                fi
            od

            EXPR("({parts |> map(p => p.text) |> join(", ")})", TUPLE(LIST[Type](parts |> map(p => p.type))))
        si

        recursive(scope: SCOPE, target: Type, depth: int, typed: bool, into: LIST[(item: EXPR, weight: int)]) is
            // Forms any type has: a conditional, a block, a call of a
            // function in scope that returns the type.
            if let condition = gen(scope, TYPES.bool, depth - 1, true) then
                let a = gen(scope, target, depth - 1, typed)
                let b = gen(scope, target, depth - 1, typed)

                if a? /\ b? then
                    into.add((item = EXPR("(if {condition} then {a} else {b} fi)", lub(a.type, b.type)), weight = 5))
                fi
            fi

            // The block's own local is not a typed position, whatever the
            // block's is, and nothing need read it; so a function literal,
            // whose parameter types come from its uses, is not written
            // there.
            if !isa FUNC(target) then
                if let value = gen(scope, target, depth - 1, false) then
                    let t = names.fresh()
                    let inner = scope.child()

                    inner.add(BINDING(t, value.type, true))

                    if let tail = gen(inner, target, depth - 1, typed) then
                        into.add((item = EXPR("(let {t} = {value}; {tail})", tail.type), weight = 4))
                    fi
                fi
            fi

            for b in scope.all() do
                if let f: FUNC = b.type /\ f.result.same(target) then
                    if let arguments = call_arguments(scope, f, depth - 1) then
                        into.add((item = EXPR("{b.name}({arguments})", f.result), weight = 8))

                        if f.parameters.count == 1 then
                            into.add((item = EXPR("({arguments} |> {b.name}())", f.result), weight = 3))
                        fi
                    fi
                fi
            od

            if let p: PRIM = target then
                prim_recursive(scope, p, depth, into)
            elif let a: ARRAY = target then
                pipe_recursive(scope, a.element, depth, "collect", into)

                if let elements = literal_elements(scope, a.element, rng.between(1, 3), depth - 1) then
                    into.add((item = EXPR("[{elements.text}]", ARRAY(elements.type)), weight = 6))
                fi

                if let n: NAMED = a.element then
                    let subtypes = concrete_subtypes(n)

                    if subtypes.count > 1 then
                        if let elements = mixed_elements(scope, subtypes, depth - 1) then
                            into.add((item = EXPR("[{elements.text}]", ARRAY(elements.type)), weight = 8))
                        fi
                    fi
                fi
            elif let l: LIST_OF = target then
                pipe_recursive(scope, l.element, depth, "collect_mutable", into)
            elif let t: TUPLE = target then
                if let literal = tuple_literal(scope, t, depth - 1) then
                    into.add((item = literal, weight = 8))
                fi
            elif let f: FUNC = target then
                if let literal = lambda(scope, f, depth - 1, typed) then
                    into.add((item = literal, weight = 8))
                fi
            elif let o: OPTIONAL = target then
                let condition = gen(scope, TYPES.bool, depth - 1, true)
                let value = gen(scope, o.inner, depth - 1, typed)

                if condition? /\ value? then
                    into.add((item = EXPR("(if {condition} then {value} fi)", optional_of(value.type)), weight = 8))
                fi
            elif let n: NAMED = target then
                join(scope, n, depth, into)
            fi
        si

        // An optional of a type, which is the type itself when that is
        // already optional: there is no `T??`.
        optional_of(type: Type) -> Type => if isa OPTIONAL(type) then type else OPTIONAL(type) fi

        call_arguments(scope: SCOPE, f: FUNC, depth: int) -> string? is
            let parts = LIST[string]()

            for p in f.parameters do
                if let argument = gen(scope, p, depth, true) then
                    parts.add(argument.text)
                else
                    return null
                fi
            od

            parts |> join(", ")
        si

        // A conditional whose arms are two different subtypes whose least
        // upper bound is exactly the target, so the join is what the
        // compiler has to find; and a `??` over an optional of one.
        join(scope: SCOPE, n: NAMED, depth: int, into: LIST[(item: EXPR, weight: int)]) is
            let candidates = concrete_subtypes(n)

            for a in candidates do
                for b in candidates do
                    if !a.same(b) /\ lub(a, b).same(n) then
                        let condition = gen(scope, TYPES.bool, depth - 1, true)
                        let left = gen(scope, a, depth - 1, true)
                        let right = gen(scope, b, depth - 1, true)

                        if condition? /\ left? /\ right? then
                            into.add((item = EXPR("(if {condition} then {left} else {right} fi)", lub(left.type, right.type)), weight = 8))
                        fi
                    fi
                od
            od

            if let optional = gen(scope, OPTIONAL(n), depth - 1, true) then
                if let fallback = gen(scope, n, depth - 1, true) then
                    let inner = if let o: OPTIONAL = optional.type then o.inner else optional.type fi

                    into.add((item = EXPR("({optional} ?? {fallback})", lub(inner, fallback.type)), weight = 4))
                fi
            fi
        si

        prim_recursive(scope: SCOPE, p: PRIM, depth: int, into: LIST[(item: EXPR, weight: int)]) is
            if p.name =~ "int" then
                let a = gen(scope, TYPES.int, depth - 1, true)
                let b = gen(scope, TYPES.int, depth - 1, true)

                if a? /\ b? then
                    into.add((item = exact("({a} {rng.pick(LIST[string](["+", "-", "*"]))} {b})", p), weight = 10))
                fi

                for sequence in sequences(scope) do
                    into.add((item = exact("{sequence}.count", p), weight = 3))
                od

                if let s = gen(scope, TYPES.string, depth - 1, true) then
                    into.add((item = exact("{s}.length", p), weight = 3))
                fi

                for element in [TYPES.int, TYPES.string] do
                    if let xs = gen(scope, ARRAY(element), depth - 1, true) then
                        into.add((item = exact("({xs} |> count())", p), weight = 3))
                    fi
                od

                if let xs = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                    let a = names.fresh()
                    let b = names.fresh()

                    into.add((item = exact("({xs} |> reduce(0, ({a}, {b}) => {a} + {b}))", p), weight = 5))
                fi

                if let o = gen(scope, OPTIONAL(TYPES.int), depth - 1, true) then
                    into.add((item = exact("({o} ?? {rng.next(10)})", p), weight = 4))
                fi

                if let animal = gen(scope, prelude.animal, depth - 1, true) then
                    into.add((item = exact("{animal}.legs", p), weight = 3))
                fi

                pack_recursive(scope, depth, into)

                if let shape = gen(scope, prelude.shape, depth - 1, true) then
                    let s = names.fresh()

                    into.add((item = exact("(case {shape} when {s}: Shape.CIRCLE then {s}.radius when {s}: Shape.SQUARE then {s}.side else 0 esac)", p), weight = 4))
                fi
            elif p.name =~ "bool" then
                if let animal = gen(scope, prelude.animal, depth - 1, true) then
                    into.add((item = exact("(isa {rng.pick(LIST[string](["CAT", "DOG"]))}({animal}))", p), weight = 4))
                fi

                if let colour = gen(scope, prelude.colour, depth - 1, true) then
                    into.add((item = exact("({colour} == Colour.{rng.pick(LIST[string](["RED", "GREEN", "BLUE"]))})", p), weight = 4))
                fi

                if let shape = gen(scope, prelude.shape, depth - 1, true) then
                    into.add((item = exact("(isa Shape.DOT({shape}))", p), weight = 3))
                fi

                let operand = rng.pick(LIST[Type]([TYPES.int, TYPES.string, TYPES.bool]))
                let a = gen(scope, operand, depth - 1, true)
                let b = gen(scope, operand, depth - 1, true)

                if a? /\ b? then
                    let operators =
                        if operand.same(TYPES.string) then
                            LIST[string](["=~", "!~"])
                        elif operand.same(TYPES.int) then
                            LIST[string](["==", "!=", "<", ">", "<=", ">="])
                        else
                            LIST[string](["==", "!="])
                        fi

                    into.add((item = exact("({a} {rng.pick(operators)} {b})", p), weight = 10))
                fi

                if let inner = gen(scope, TYPES.bool, depth - 1, true) then
                    into.add((item = exact("!({inner})", p), weight = 3))
                fi

                let l = gen(scope, TYPES.bool, depth - 1, true)
                let r = gen(scope, TYPES.bool, depth - 1, true)

                if l? /\ r? then
                    into.add((item = exact("({l} {rng.pick(LIST[string](["/\\", "\\/"]))} {r})", p), weight = 5))
                fi

                if let xs = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                    let x = names.fresh()

                    into.add((item = exact("({xs} |> any({x} => {x} > {rng.next(10)}))", p), weight = 4))
                fi

                if let o = gen(scope, OPTIONAL(TYPES.string), depth - 1, true) then
                    into.add((item = exact("{o}?", p), weight = 3))
                fi
            elif p.name =~ "string" then
                if let animal = gen(scope, prelude.animal, depth - 1, true) then
                    into.add((item = exact("{animal}.describe()", p), weight = 5))
                fi

                if let shape = gen(scope, prelude.shape, depth - 1, true) then
                    let s = names.fresh()

                    into.add((item = exact("(case {shape} when {s}: Shape.SQUARE then {s}.label when {s}: Shape.CIRCLE then \"circle\" else \"dot\" esac)", p), weight = 4))
                fi

                let shown = rng.pick(LIST[Type]([TYPES.int, TYPES.bool, TYPES.string, TYPES.double]))

                if let inner = gen(scope, shown, depth - 1, true) then
                    into.add((item = exact("\"<{{{inner}}}>\"", p), weight = 6))
                fi

                let a = gen(scope, TYPES.string, depth - 1, true)
                let b = gen(scope, TYPES.string, depth - 1, true)

                if a? /\ b? then
                    into.add((item = exact("\"{{{a}}}-{{{b}}}\"", p), weight = 4))
                fi

                if let xs = gen(scope, ARRAY(TYPES.string), depth - 1, true) then
                    into.add((item = exact("({xs} |> join(\",\"))", p), weight = 4))
                fi
            elif p.name =~ "double" then
                let a = gen(scope, TYPES.double, depth - 1, true)
                let b = gen(scope, TYPES.double, depth - 1, true)

                if a? /\ b? then
                    into.add((item = exact("({a} {rng.pick(LIST[string](["+", "-", "*"]))} {b})", p), weight = 10))
                fi
            fi
        si

        // Forms through the argument-pack combinators, each yielding an
        // int: apply and the program's own pack functions over a spread
        // literal, a named function or a written-out tuple; composition
        // with >>; a stream of ints consumed by take; zip and index
        // feeding spread and bound-tuple lambdas.
        pack_recursive(scope: SCOPE, depth: int, into: LIST[(item: EXPR, weight: int)]) is
            let a = gen(scope, TYPES.int, depth - 1, true)
            let b = gen(scope, TYPES.int, depth - 1, true)

            if !(a? /\ b?) then
                return
            fi

            let x = names.fresh()
            let y = names.fresh()
            let combinators = LIST[string](["apply", "pack_apply"])
            let combinator = rng.pick(combinators)

            // A two-parameter literal, spread, typed or not, and the tuple
            // written out.
            let bodies = LIST[string](["({x}, {y}) => {x} + {y}", "({x}: int, {y}: int) => {x} * {y}", "({x}, {y}) is {x} - {y} si"])

            into.add((item = exact("{combinator}({rng.pick(bodies)}, {a}, {b})", TYPES.int), weight = 6))
            into.add((item = exact("{combinator}({rng.pick(bodies)}, ({a}, {b}))", TYPES.int), weight = 3))
            into.add((item = exact("{combinator}({x} => {x} + 1, {a})", TYPES.int), weight = 3))

            // A named two-parameter function in scope, by name.
            for f in scope.all() do
                if let t: FUNC = f.type /\ t.parameters.count == 2 /\ t.result.same(TYPES.int) /\ t.parameters[0].same(TYPES.int) /\ t.parameters[1].same(TYPES.int) then
                    into.add((item = exact("{combinator}({f.name}, {a}, {b})", TYPES.int), weight = 5))
                    into.add((item = exact("({f.name} >> ({x} => {x} * 2))({a}, {b})", TYPES.int), weight = 4))
                    into.add((item = exact("(pack_twice({f.name}, ({a}, {b}))).`0", TYPES.int), weight = 3))
                fi
            od

            // Composition of a typed spread literal with a one-parameter one.
            // The first literal's types are written: nothing else pins the
            // pack, and an untyped one is rejected by the rule that a pack
            // bound from a literal alone needs the literal to say its types.
            into.add((item = exact("((({x}: int, {y}: int) => {x} + {y}) >> ({x} => {x} + 1))({a}, {b})", TYPES.int), weight = 4))

            // A stream of ints from a one-, two- or three-element state,
            // its advance written spread, as a bound tuple, or annotated.
            let advance_two = LIST[string](["({x}, {y}) => {x} || ({y}, {x} + {y})", "(({x}, {y})) => {x} || ({y}, {x} + {y})", "({x}: int, {y}: int) => {x} || ({y}, {x} + {y})"])
            let z = names.fresh()

            into.add((item = exact("(stream({a}, {x} => {x} || {x} + 1) |> take(3) |> reduce(0, ({x}, {y}) => {x} + {y}))", TYPES.int), weight = 5))
            into.add((item = exact("(stream(({a}, {b}), {rng.pick(advance_two)}) |> take(4) |> reduce(0, ({x}, {y}) => {x} + {y}))", TYPES.int), weight = 6))
            into.add((item = exact("(stream(({a}, {b}, 1), ({x}, {y}, {z}) => {x} || ({y}, {z}, {x} + {y})) |> take(4) |> count())", TYPES.int), weight = 3))

            // zip and index produce tuples that each, take_while and a
            // bound-tuple map consume.
            if let xs = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                if let ys = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                    into.add((item = exact("({xs} |> zip({ys}) |> take_while(({x}, {y}) => {x} < 100) |> count())", TYPES.int), weight = 4))
                    into.add((item = exact("({xs} |> zip({ys}) |> map((({x}, {y})) => {x} + {y}) |> reduce(0, ({x}, {y}) => {x} + {y}))", TYPES.int), weight = 4))
                fi

                into.add((item = exact("({xs} |> index() |> map((({x}, {y})) => {x} * {y}) |> reduce(0, ({x}, {y}) => {x} + {y}))", TYPES.int), weight = 4))
                into.add((item = exact("({xs} |> flat_map({x} => [{x}, {x}]) |> count())", TYPES.int), weight = 3))
            fi
        si

        sequences(scope: SCOPE) -> LIST[string] =>
            LIST[string](scope.all() |> filter(b => isa ARRAY(b.type) \/ isa LIST_OF(b.type)) |> map(b => b.name))

        // A pipe over a sequence of the element type, ending in the named
        // collector: a map, a filter, or both.
        pipe_recursive(scope: SCOPE, element: Type, depth: int, collector: string, into: LIST[(item: EXPR, weight: int)]) is
            let collect = (elements: Type) -> Type => if collector =~ "collect_mutable" then LIST_OF(elements) else ARRAY(elements) fi

            if !(element.same(TYPES.int) \/ element.same(TYPES.string)) then
                return
            fi

            if let source = gen(scope, ARRAY(element), depth - 1, true) then
                let x = names.fresh()
                let inner = scope.capturable()

                inner.add(BINDING(x, element, true))

                if let mapped = gen(inner, element, 1, true) then
                    into.add((item = EXPR("({source} |> map({x} => {mapped}) |> {collector}())", collect(mapped.type)), weight = 6))
                fi

                if let kept = gen(inner, TYPES.bool, 1, true) then
                    into.add((item = EXPR("({source} |> filter({x} => {kept}) |> {collector}())", collect(element)), weight = 6))
                fi

                if element.same(TYPES.int) then
                    let y = names.fresh()

                    into.add((item = EXPR("({source} |> map({x} => {x} * 2) |> filter({y} => {y} > {rng.next(10)}) |> {collector}())", collect(element)), weight = 4))
                fi
            fi

            if element.same(TYPES.string) then
                if let source = gen(scope, ARRAY(TYPES.int), depth - 1, true) then
                    let x = names.fresh()

                    into.add((item = EXPR("({source} |> map({x} => \"n{{{x}}}\") |> {collector}())", collect(TYPES.string)), weight = 4))
                fi
            fi
        si

        // A function literal of the shape. In a typed position the
        // parameters go unannotated; elsewhere they are annotated, unless
        // a body that constrains them on its own is available. Its type
        // is the shape's parameters over the body's own type.
        lambda(scope: SCOPE, f: FUNC, depth: int, typed: bool) -> EXPR? is
            let inner = scope.capturable()
            let parameters = LIST[string]()

            for p in f.parameters do
                let n = names.fresh()

                parameters.add(n)
                inner.add(BINDING(n, p, true))
            od

            let annotate = !typed

            if annotate /\ f.parameters.count == 1 then
                if let constrained = constrained_body(parameters[0], f.parameters[0], f.result) then
                    return EXPR("{parameters[0]} => {constrained}", f)
                fi
            fi

            let heads = LIST[string]()

            for i in 0..parameters.count do
                heads.add(if annotate then "{parameters[i]}: {f.parameters[i].spell()}" else parameters[i] fi)
            od

            let head =
                if parameters.count == 1 /\ !annotate then
                    heads[0]
                else
                    "({heads |> join(", ")})"
                fi

            if let body = gen(inner, f.result, depth, true) then
                let type = FUNC(f.parameters, if typed then f.result else body.type fi)

                if rng.chance(1, 3) then
                    EXPR("{head} is {body} si", type)
                else
                    EXPR("{head} => {body}", type)
                fi
            else
                null
            fi
        si

        // A body whose operations fix the parameter's type without an
        // annotation, for the shapes where one exists.
        constrained_body(parameter: string, from: Type, to: Type) -> string? is
            if from.same(TYPES.int) /\ to.same(TYPES.int) then
                "{parameter} + {rng.next(10)}"
            elif from.same(TYPES.int) /\ to.same(TYPES.bool) then
                "{parameter} > {rng.next(10)}"
            elif from.same(TYPES.string) /\ to.same(TYPES.int) then
                "{parameter}.length"
            elif from.same(TYPES.string) /\ to.same(TYPES.string) then
                "{parameter}.to_upper()"
            elif from.same(ARRAY(TYPES.int)) /\ to.same(TYPES.int) then
                "(if {parameter}.count > 0 then {parameter}[0] else 0 fi)"
            elif from.same(TYPES.tuple(TYPES.int, TYPES.int)) /\ to.same(TYPES.int) then
                let a = names.fresh()
                let b = names.fresh()

                "(let ({a}, {b}) = {parameter}; {a} + {b})"
            else
                null
            fi
        si
    si
si
