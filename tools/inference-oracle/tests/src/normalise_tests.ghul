namespace InferenceOracle.Tests is
    use default

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Assertions

    @TestClass()
    class NORMALISE_TESTS is
        init() is si

        // A disassembly holding one method, with `parameter_lines` written
        // between its generated-code attribute and its body.
        disassembly(name: string, parameter_lines: ARRAY[string]) -> string is
            let lines = LIST[string]()

            lines.add("// =============== CLASS MEMBERS DECLARATION ===================")
            lines.add("  .method public hidebysig specialname static ")
            lines.add("          class YIELD<int32,valuetype [System.Runtime]System.ValueTuple`2<int32,int32>> ")
            lines.add("          {name}(valuetype [System.Runtime]System.ValueTuple`2<int32,int32> group) cil managed")
            lines.add("  {{")
            lines.add("    .custom instance void [System.Runtime]System.Runtime.CompilerServices.CompilerGeneratedAttribute::.ctor() = ( 01 00 00 00 ) ")

            for line in parameter_lines do
                lines.add(line)
            od

            lines.add("    // Code size       56 (0x38)")
            lines.add("    .maxstack  64")
            lines.add("    IL_0000:  ret")
            lines.add("  }} // end of method $globals::{name}")

            lines |> join("\n")
        si

        tuple_names() -> ARRAY[string] => [
            "    .param [1]",
            "    .custom instance void [System.Runtime]System.Runtime.CompilerServices.TupleElementNamesAttribute::.ctor(string[]) = ( 01 00 02 00 00 00 07 63 75 72 72 65 6E 74 01 31 ",
            "                                                                                                                          00 00 ) "
        ]

        @Test()
        Normalising__a_packed_method__should_ignore_tuple_element_names_on_its_parameter() is
            are_equal(
                normalise(disassembly("$packed_0", [])),
                normalise(disassembly("$packed_0", tuple_names()))
            )
        si

        @Test()
        Normalising__any_other_method__should_keep_tuple_element_names_on_its_parameter() is
            are_not_equal(
                normalise(disassembly("describe", [])),
                normalise(disassembly("describe", tuple_names()))
            )
        si
    si
si
