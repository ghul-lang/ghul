namespace InferenceOracle is
    use default

    use System.Text.RegularExpressions.Regex

    // The disassembly with everything that differs between two compiles of
    // the same program removed: the assembly header (ildasm's banner, the
    // MVID, the image base), instruction offsets and code sizes, which move
    // whenever any earlier instruction does, and the numbers the compiler
    // gives its generated members, which count in the order they are made
    // rather than anything about what they are.
    normalise(text: string) -> string is
        let out = LIST[string]()
        let in_members mut = false

        let lines = text.split(['\n'])

        for i in 0..lines.count do
            let line = lines[i]

            if line.contains("CLASS MEMBERS DECLARATION") then
                in_members = true
                continue
            fi

            if !in_members then
                continue
            fi

            if line.contains("DISASSEMBLY COMPLETE") \/ line.trim().starts_with("// Code size") then
                continue
            fi

            // A literal's proven purity is carried as an attribute on
            // its return and its parameters, and writing a type out can
            // add or drop it without changing what was resolved.
            if line.contains("Ghul.Internal.PURE_ATTRIBUTE") then
                continue
            fi

            if line.trim().starts_with(".param [") /\ i + 1 < lines.count /\ lines[i + 1].contains("Ghul.Internal.PURE_ATTRIBUTE") then
                continue
            fi

            // A custom attribute's blob is dumped as hex with the text beside
            // it, and one naming a type carries the file-derived namespace.
            let without_comment = Regex.replace(line.trim_end(), "\\s+//.*$", "")

            if Regex.is_match(without_comment, "^\\s*([0-9A-F]{{2}}\\s*)+\\)?\\s*$") then
                continue
            fi

            let without_blobs = Regex.replace(without_comment, "= \\( [0-9A-F][0-9A-F] .*$", "= ( ... )")

            // ildasm wraps a long string literal onto `+ "..."` lines at a
            // width that depends on the instruction's offset text.
            if without_blobs.trim().starts_with("+ \"") /\ out.count > 0 then
                out[out.count - 1] = "{out[out.count - 1].trim_end('"')}{without_blobs.trim().substring(3)}"

                continue
            fi

            // A file with no namespace gets one made from its path, and
            // the two programs are compiled from different directories.
            let without_paths = Regex.replace(without_blobs, "__(inferred|explicit)__", "__program__")

            let without_offsets = Regex.replace(without_paths, "IL_[0-9a-f]{{4}}", "IL_")

            if without_offsets.trim().length == 0 then
                continue
            fi

            out.add(without_offsets)
        od

        let result = System.Text.StringBuilder()

        for line in out do
            // An assert message carries the source position it was
            // written at, which annotating moves. Matched once a wrapped
            // string has been joined back into one line.
            result.append(Regex.replace(line, "ldstr\\s+\"([^\" ]*\\.ghul) [0-9]+,[0-9]+\\.\\.[0-9]+,[0-9]+: ", "ldstr \"$1: ")).append('\n')
        od

        settle_numbering(canonicalise_class_order(canonicalise_generic_methods(canonicalise_frames(result.to_string()))))
    si

    // Class order and generated numbering depend on each other: two
    // classes differing only in their numbers tie in the order, so they
    // keep the order the compiler emitted them in, and renumbering by
    // first appearance then numbers them from that order. So the two are
    // settled together, re-sorting on the renumbered text until neither
    // changes the other.
    settle_numbering(text: string) -> string is
        let current mut = renumber(text)

        for _ in 0..4 do
            let next = renumber(canonicalise_class_order(current))

            if next =~ current then
                return current
            fi

            current = next
        od

        current
    si

    // A generated member's name ends in one or more numbers that count
    // in the order the compiler made things; each distinct name is
    // renumbered in order of first appearance among those sharing its
    // prefix. Last, so that the order is the canonical one.
    renumber(text: string) -> string is
        let numbering = MAP[string, string]()

        Regex.replace(
            text,
            "\\$[A-Za-z$_]*[A-Za-z$](?:_[0-9]+)+",
            (m: System.Text.RegularExpressions.Match) -> string is
                let key = m.value

                if !numbering.contains_key(key) then
                    let prefix = Regex.replace(key, "_[0-9]+", "")
                    let used = numbering.values |> filter(v => v.starts_with("{prefix}_")) |> count()

                    numbering[key] = "{prefix}_{used}"
                fi

                numbering[key]
            si
        )
    si

    // The index of the `>` closing the `<` at `open`.
    matching_close(text: string, open: int) -> int is
        let depth mut = 0

        for i in open..text.length do
            if text[i] == '<' then
                depth = depth + 1
            elif text[i] == '>' then
                depth = depth - 1

                if depth == 0 then
                    return i
                fi
            fi
        od

        -1
    si

    // The top-level comma-separated items between `open` and `close`.
    split_arguments(text: string, open: int, close: int) -> LIST[string] is
        let result = LIST[string]()
        let depth mut = 0
        let start mut = open + 1

        for i in open + 1..close do
            if text[i] == '<' then
                depth = depth + 1
            elif text[i] == '>' then
                depth = depth - 1
            elif text[i] == ',' /\ depth == 0 then
                result.add(text.substring(start, i - start))
                start = i + 1
            fi
        od

        result.add(text.substring(start, close - start))

        result
    si

    // Each occurrence of a closure frame class's name followed by its type
    // arguments: the frame's name, where its `<` is and where its `>` is.
    frame_references(line: string) -> LIST[(name: string, open: int, close: int)] is
        let result = LIST[(name: string, open: int, close: int)]()

        let found = Regex.matches(line, "\\$frame_[0-9]+<")

        for k in 0..found.count do
            let m = found[k]

            let open = m.index + m.length - 1
            let close = matching_close(line, open)

            if close > 0 then
                result.add((name = m.value.substring(0, m.length - 1), open = open, close = close))
            fi
        od

        result
    si

    // A closure frame class takes the type parameters its lambda captures, in
    // the order the compiler first meets them, and writing a type out can
    // change that order. Two frames differing only in it are the same class,
    // so each frame's type parameters are put in name order, and every
    // reference to the frame and to its parameters by index follows.
    canonicalise_frames(text: string) -> string is
        let lines = text.split(['\n'])

        // For each frame, the new index of each of its type parameters.
        let permutations = MAP[string, ARRAY[int]]()

        for line in lines do
            if line.starts_with(".class ") then
                let m = Regex.match(line, "(\\$frame_[0-9]+)<")

                if m.success then
                    let open = m.index + m.length - 1
                    let close = matching_close(line, open)

                    if close > 0 then
                        // A parameter may carry a constraint in front of
                        // its name - `(class X<!K>) K` - so the name is the
                        // last word of each.
                        let parameters = LIST[string]()

                        for argument in split_arguments(line, open, close) do
                            let words = argument.trim().split([' '])

                            parameters.add(words[words.count - 1])
                        od

                        let sorted = LIST[string](parameters)

                        sorted.sort()

                        let permutation = LIST[int]()

                        for p in parameters do
                            permutation.add(sorted.index_of(p))
                        od

                        permutations[m.groups[1].value] = permutation.to_array()
                    fi
                fi
            fi
        od

        let result = System.Text.StringBuilder()
        let current_frame: string? mut = null
        let continued_owner: string? mut = null
        let open_parentheses mut = 0

        for original in lines do
            let line mut = original

            if line.starts_with(".class ") then
                let m = Regex.match(line, "(\\$frame_[0-9]+)<")

                current_frame = if m.success then m.groups[1].value else null fi
            fi

            // An index written after `::` belongs to the type named before
            // it; anywhere else in a frame's body it belongs to the frame.
            // A signature ildasm wraps onto following lines keeps the owner
            // of the line it started on.
            let owner mut =
                if continued_owner? then
                    continued_owner
                elif line.contains("::") then
                    null
                else
                    current_frame
                fi

            let starts_signature = !continued_owner?

            for reference in frame_references(line) do
                if reference.close + 2 < line.length /\ line.substring(reference.close + 1, 2) =~ "::" then
                    owner = reference.name
                fi
            od

            open_parentheses = open_parentheses + line.split(['(']).count - line.split([')']).count

            continued_owner =
                if open_parentheses > 0 /\ (!starts_signature \/ line.contains("::")) then
                    owner
                else
                    open_parentheses = 0
                    null
                fi

            if let permutation = if owner? /\ permutations.contains_key(owner) then permutations[owner] else null fi then
                line = Regex.replace(
                    line,
                    "(?<![!\\w])!([0-9]+)",
                    (m: System.Text.RegularExpressions.Match) -> string is
                        let index = int.parse(m.groups[1].value)

                        if index < permutation.count then "!{permutation[index]}" else m.value fi
                    si
                )
            fi

            // Reorder the type arguments of each reference, last first so the
            // earlier positions stay valid.
            let references = frame_references(line)

            for i in 0..references.count do
                let reference = references[references.count - 1 - i]

                if permutations.contains_key(reference.name) then
                    let permutation = permutations[reference.name]
                    let arguments = split_arguments(line, reference.open, reference.close)

                    if arguments.count == permutation.count then
                        let reordered = LIST[string](arguments)

                        for j in 0..arguments.count do
                            reordered[permutation[j]] = arguments[j]
                        od

                        let before = line.substring(0, reference.open + 1)
                        let joined = reordered |> join(",")
                        let after = line.substring(reference.close)

                        line = "{before}{joined}{after}"
                    fi
                fi
            od

            if line.starts_with("}} // end of class") then
                current_frame = null
            fi

            result.append(line).append('\n')
        od

        result.to_string()
    si

    // A generic literal's method takes the type parameters its body uses,
    // in the order the compiler first meets them, and writing a type out
    // can change that order - as for a closure frame. The method's own
    // signature and body name its parameters, so only the declaration's
    // list and each reference need reordering: a reference instantiates
    // the method in declaration order, and indexes its parameters in the
    // signature it writes out.
    canonicalise_generic_methods(text: string) -> string is
        let lines = text.split(['\n'])
        let declaration_pattern = "(\\$anon_[0-9]+)<([A-Za-z_][^<>(),!]*(?:,[A-Za-z_][^<>(),!]*)*)>\\("

        // For each generic method, the new index of each of its type
        // parameters.
        let permutations = MAP[string, ARRAY[int]]()

        for line in lines do
            let m = Regex.match(line, declaration_pattern)

            if m.success /\ !line.contains("::") then
                let parameters = LIST[string]()

                for parameter in m.groups[2].value.split([',']) do
                    let words = parameter.trim().split([' '])

                    parameters.add(words[words.count - 1])
                od

                let sorted = LIST[string](parameters)

                sorted.sort()

                let permutation = LIST[int]()

                for p in parameters do
                    permutation.add(sorted.index_of(p))
                od

                permutations[m.groups[1].value] = permutation.to_array()
            fi
        od

        if permutations.count == 0 then
            return text
        fi

        let result = System.Text.StringBuilder()
        let continued: ARRAY[int]? mut = null
        let open_parentheses mut = 0

        for i in 0..lines.count do
            let line mut = lines[i]

            let declaration = Regex.match(line, declaration_pattern)

            if declaration.success /\ !line.contains("::") /\ permutations.contains_key(declaration.groups[1].value) then
                let names = LIST[string](declaration.groups[2].value.split([',']))
                let order = permutations[declaration.groups[1].value]
                let reordered = LIST[string](names)

                for j in 0..names.count do
                    reordered[order[j]] = names[j]
                od

                let group = declaration.groups[2]

                line = "{line.substring(0, group.index)}{reordered |> join(",")}{line.substring(group.index + group.length)}"
            fi

            let reference = Regex.match(line, "::(\\$anon_[0-9]+)<")

            let permutation: ARRAY[int]? mut = continued
            let instantiation_open mut = -1
            let instantiation_close mut = -1

            if reference.success /\ permutations.contains_key(reference.groups[1].value) then
                permutation = permutations[reference.groups[1].value]
                instantiation_open = reference.index + reference.length - 1
                instantiation_close = matching_close(line, instantiation_open)
            fi

            if let p = permutation then
                if instantiation_close > 0 then
                    let arguments = split_arguments(line, instantiation_open, instantiation_close)
                    let reordered = LIST[string](arguments)

                    if arguments.count == p.count then
                        for j in 0..arguments.count do
                            reordered[p[j]] = arguments[j]
                        od
                    fi

                    // Every index outside the instantiation is the
                    // method's own, in the signature the reference writes.
                    let before = remap_method_indices(line.substring(0, instantiation_open + 1), p)
                    let after = remap_method_indices(line.substring(instantiation_close), p)

                    line = "{before}{reordered |> join(",")}{after}"
                else
                    line = remap_method_indices(line, p)
                fi

                // ildasm wraps a long signature onto following lines, which
                // belong to the same reference.
                open_parentheses = open_parentheses + line.split(['(']).count - line.split([')']).count

                if open_parentheses > 0 then
                    continued = p
                else
                    continued = null
                    open_parentheses = 0
                fi
            fi

            result.append(line)

            if i + 1 < lines.count then
                result.append('\n')
            fi
        od

        result.to_string()
    si

    remap_method_indices(segment: string, permutation: ARRAY[int]) -> string =>
        Regex.replace(
            segment,
            "(?<![!\\w])!!([0-9]+)",
            (m: System.Text.RegularExpressions.Match) -> string is
                let index = int.parse(m.groups[1].value)

                if index < permutation.count then "!!{permutation[index]}" else m.value fi
            si
        )

    // Top-level classes in name order. A closure frame or a generated
    // class is emitted where the compiler first needed it, which a
    // written type can move without changing the class.
    canonicalise_class_order(text: string) -> string is
        let lines = text.split(['\n'])

        let blocks = LIST[LIST[string]]()
        let current: LIST[string]? mut = null

        for line in lines do
            if line.starts_with(".class ") then
                current = LIST[string]()
                blocks.add(current!)
            fi

            if let block = current then
                block.add(line)
            else
                let loose = LIST[string]()

                loose.add(line)
                blocks.add(loose)
            fi

            if line.starts_with("}} // end of class") then
                current = null
            fi
        od

        let classes = LIST[LIST[string]](blocks |> filter(b => b.count > 0 /\ b[0].starts_with(".class ")))
        let others = LIST[LIST[string]](blocks |> filter(b => b.count == 0 \/ !b[0].starts_with(".class ")))

        // Ordered by content with the generated numbers stripped, so that
        // two classes differing only in numbering sort the same way.
        let key = (block: LIST[string]) -> string => Regex.replace(block |> join("\n"), "(\\$[A-Za-z$_]*[A-Za-z$])(?:_[0-9]+)+", "$1")

        // Ties - classes identical but for their numbers - fall back to the
        // numbered text, which is canonical once the numbering is settled.
        let exact = (block: LIST[string]) -> string => block |> join("\n")

        classes.sort((a: LIST[string], b: LIST[string]) -> int =>
            let by_key = string.compare_ordinal(key(a), key(b)) in
            if by_key != 0 then by_key else string.compare_ordinal(exact(a), exact(b)) fi)

        let result = System.Text.StringBuilder()

        for block in others do
            for line in block do
                result.append(line).append('\n')
            od
        od

        for block in classes do
            for line in block do
                result.append(line).append('\n')
            od
        od

        result.to_string()
    si
si
