// Lists every external type an assembly references, by assembly and
// namespace, with the members it references through each. Usage:
//   bcl-subset <assembly.dll>

use IO.Std.write_line
use Collections.MAP
use Collections.SET
use Collections.LIST
use Ghul.Pipes

use System.Reflection.Metadata.MetadataReader
use System.Reflection.Metadata.PEReaderExtensions
use System.Reflection.Metadata.HandleKind
use System.Reflection.Metadata.EntityHandle
use System.Reflection.Metadata.TypeReferenceHandle
use System.Reflection.Metadata.AssemblyReferenceHandle
use System.Reflection.Metadata.TypeSpecificationHandle
use System.Reflection.Metadata.MemberReferenceHandle
use System.Reflection.PortableExecutable.PEReader

class TYPE_USE(assembly: string, full_name: string) is
    members: SET[string] public

    init(..) is
        members = SET[string]()
    si
si

entry(args: ARRAY[string]) is
    let image = IO.File.open_read(args[0])
    let pe = PEReader(image)
    let reader = PEReaderExtensions.get_metadata_reader(pe)

    let uses = MAP[string, TYPE_USE]()

    resolve(handle: TypeReferenceHandle) -> TYPE_USE is
        let type_ref = reader.get_type_reference(handle)
        let name = reader.get_string(type_ref.name)
        let scope = type_ref.resolution_scope

        let assembly mut = "?"
        let full_name mut = name

        if scope.kind == HandleKind.ASSEMBLY_REFERENCE then
            let assembly_ref = reader.get_assembly_reference(cast AssemblyReferenceHandle(scope))
            assembly = reader.get_string(assembly_ref.name)
            let ns = reader.get_string(type_ref.namespace)
            full_name = if ns.length > 0 then "{ns}.{name}" else name fi
        elif scope.kind == HandleKind.TYPE_REFERENCE then
            let outer = resolve(cast TypeReferenceHandle(scope))
            assembly = outer.assembly
            full_name = "{outer.full_name}/{name}"
        fi

        let key = "{assembly}|{full_name}"

        if !uses.contains_key(key) then
            uses[key] = TYPE_USE(assembly, full_name)
        fi

        uses[key]
    si

    for handle in reader.type_references do
        resolve(handle)
    od

    let unresolved_parents mut = 0

    for handle in reader.member_references do
        let member = reader.get_member_reference(handle)
        let parent = member.parent
        let name = reader.get_string(member.name)

        if parent.kind == HandleKind.TYPE_REFERENCE then
            resolve(cast TypeReferenceHandle(parent)).members.add(name)
        elif parent.kind == HandleKind.TYPE_SPECIFICATION then
            let spec = reader.get_type_specification(cast TypeSpecificationHandle(parent))
            let blob mut = reader.get_blob_reader(spec.signature)
            let first = blob.read_byte()

            if first == 0x15ub then
                blob.read_byte()
                let target = blob.read_type_handle()

                if target.kind == HandleKind.TYPE_REFERENCE then
                    resolve(cast TypeReferenceHandle(target)).members.add(name)
                else
                    unresolved_parents = unresolved_parents + 1
                fi
            else
                unresolved_parents = unresolved_parents + 1
            fi
        else
            unresolved_parents = unresolved_parents + 1
        fi
    od

    let by_assembly = MAP[string, LIST[TYPE_USE]]()

    for u in uses.values do
        if !by_assembly.contains_key(u.assembly) then
            by_assembly[u.assembly] = LIST[TYPE_USE]()
        fi

        by_assembly[u.assembly].add(u)
    od

    let assemblies = LIST[string](by_assembly.keys)
    assemblies.sort((a: string, b: string) -> int => string.compare_ordinal(a, b))

    let total_types mut = 0
    let total_members mut = 0

    for assembly in assemblies do
        let types = by_assembly[assembly]
        types.sort((a: TYPE_USE, b: TYPE_USE) -> int => string.compare_ordinal(a.full_name, b.full_name))

        write_line("")
        write_line("## {assembly}: {types.count} types")

        for t in types do
            let members = LIST[string](t.members)
            members.sort((a: string, b: string) -> int => string.compare_ordinal(a, b))

            total_types = total_types + 1
            total_members = total_members + members.count

            write_line("{t.full_name} ({members.count}): {members |> join(", ")}")
        od
    od

    write_line("")
    write_line("total: {total_types} types, {total_members} distinct members, {unresolved_parents} member refs on array/pointer/generic-param parents")
si
