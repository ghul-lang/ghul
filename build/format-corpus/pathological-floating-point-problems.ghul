use default

struct RATIONAL is
    numerator: bigint
    denominator: bigint

    init(n: bigint, d: bigint) is
        let divisor = bigint.greatest_common_divisor(n, d) * d.sign
        numerator = n / divisor
        denominator = d / divisor
    si

    +(other: RATIONAL) -> RATIONAL =>
        RATIONAL(
            numerator * other.denominator + other.numerator * denominator,
            denominator * other.denominator
        )

    -(other: RATIONAL) -> RATIONAL =>
        RATIONAL(
            numerator * other.denominator - other.numerator * denominator,
            denominator * other.denominator
        )

    *(other: RATIONAL) -> RATIONAL =>
        RATIONAL(
            numerator * other.numerator,
            denominator * other.denominator
        )

    /(other: RATIONAL) -> RATIONAL =>
        RATIONAL(
            numerator * other.denominator,
            denominator * other.numerator
        )

    decimal(places: int) -> string =>
        let
            sign = if numerator.sign < 0 then "-" else "" fi,
            n = bigint.abs(numerator),
            whole = n / denominator,
            scaled = (n % denominator) * bigint.pow(10n, places),
            fraction = scaled / denominator,
            digits = fraction.to_string().pad_left(places, '0')
        in
            "{sign}{whole}.{digits}"

si

whole(n: bigint) -> RATIONAL => RATIONAL(n, 1n)

write_line("Task 1: the sequence v")

let v = LIST([whole(0n), whole(2n), whole(-4n)])

for n in 3::100 do
    let a = v[n - 1]
    let b = v[n - 2]
    v.add(whole(111n) - whole(1130n) / a + whole(3000n) / (a * b))
od

let naive = LIST([0.0, 2.0, -4.0])

for n in 3::100 do
    let a = naive[n - 1]
    let b = naive[n - 2]
    naive.add(111.0 - 1130.0 / a + 3000.0 / (a * b))
od

write_line("           exact                    double")

for n in [3, 4, 5, 6, 7, 8, 20, 30, 50, 100] do
    write_line("  n = {n,3}  {v[n].decimal(20),-23}  {naive[n]:R}")
od

write_line()
write_line("Task 2: the Chaotic Bank Society")

let e =
    0::40
        |> map(k =>
            RATIONAL(1n, 1::k |> reduce(1n, (f, i) => f * bigint(i)))
        )
        |> reduce(whole(0n), * + *)

let balance =
    1::25
        |> reduce(
            e - whole(1n),
            (bal, year) => bal * whole(bigint(year)) - whole(1n)
        )

let naive_balance =
    1::25 |> reduce(Ghul.Math.e - 1.0, (bal, year) => bal * year - 1.0)

write_line("  exact:  ${balance.decimal(16)}")
write_line("  double: ${naive_balance:R}")

write_line()
write_line("Task 3: Siegfried Rump's example")

let a = whole(77617n)
let b = whole(33096n)
let b2 = b * b
let b4 = b2 * b2
let b6 = b4 * b2
let b8 = b4 * b4

let f =
    RATIONAL(1335n, 4n) * b6 +
    a * a * (whole(11n) * a * a * b2 - b6 - whole(121n) * b4 - whole(2n)) +
    RATIONAL(11n, 2n) * b8 +
    a / (whole(2n) * b)

write_line("  f(77617, 33096) = {f.decimal(30)}")

let x = 77617.0
let y = 33096.0

let naive_f =
    333.75 * pow(y, 6.0) +
    x *
    x *
    (11.0 * x * x * y * y - pow(y, 6.0) - 121.0 * pow(y, 4.0) - 2.0) +
    5.5 * pow(y, 8.0) +
    x / (2.0 * y)

write_line("  in double precision: {naive_f:R}")
