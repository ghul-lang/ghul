{
    // How the compiler's suites are run. `dotnet ghul-test --config <name>`
    // runs one; with no option, `local` runs.
    "default": "local",
    "configurations": {
        // The compiler published to publish/ by `dotnet publish --output
        // publish/`, with the runtime it was built against.
        "published": {
            "compiler": { "publish": "publish" },
            "runtime": "beside-compiler"
        },

        // The same, with a test that runs under wasm given the runtime
        // library's sources, core and runtime, from the first checkout found:
        // CI's under libraries/, or the workspace's beside this repository or
        // beside the worktree's primary checkout. A test built for llvm is passed
        // over: its runs are made only by a configuration whose run_targets
        // names llvm, on a machine with ghul-llvm on the PATH.
        "local": {
            "extends": "published",
            "run_targets": ["dotnet", "wasm"],
            "targets": {
                "wasm": {
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"],
                            "loader": "ghul-core/host/loader.mjs"
                        }
                    ]
                }
            }
        },

        // Only the runs built for llvm, which link a native executable with
        // the ghul-llvm on the PATH (build/ghul-llvm.sh fetches it), given
        // the same libraries as wasm. CI runs this one too, with the
        // bootstrapped compiler downloaded into publish/.
        "llvm": {
            "extends": "local",
            "compiler": { "path": "publish/ghul.dll" },
            "run_targets": ["llvm"],
            "targets": {
                "llvm": {
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"],
                            "loader": "ghul-core/host/loader.mjs"
                        }
                    ]
                }
            }
        },

        // CI's integration shards: the freshly built compiler installed as
        // the local tool, and the runtime it ships with.
        "ci": {
            "extends": "local",
            "compiler": "tool",
            "runtime": { "path": "bootstrap-tool/ghul-runtime.dll" }
        },

        // The cross-assembly and source-library suites, built by MSBuild with
        // the published compiler.
        "cross-assembly": {
            "build": "msbuild",
            "compiler": { "path": "publish/ghul.dll" }
        },

        // The same in CI, with the bootstrapped compiler.
        "ci-cross-assembly": {
            "extends": "cross-assembly",
            "compiler": { "path": "bootstrap-tool/ghul.dll" }
        }
    }
}
