{
    // How the compiler's suites are run. `dotnet ghul-test --config <name>`
    // runs one; with no option, `local` runs.
    "default": "local",
    "configurations": {
        // The compiler published to publish/ by `dotnet publish --output
        // publish/`, with the runtime it was built against.
        "published": {
            "compiler": { "publish": "publish" },
            "runtime": "beside-compiler"
        },

        // The same, with a test that runs under wasm given the runtime
        // library's sources, core and runtime, from the first checkout found:
        // CI's under libraries/, or the workspace's beside this repository or
        // beside the worktree's primary checkout. A test built for llvm is passed
        // over: its runs are made only by a configuration whose run_targets
        // names llvm, on a machine with ghul-llvm on the PATH.
        "local": {
            "extends": "published",
            "run_targets": ["dotnet", "wasm"],
            "targets": {
                "wasm": {
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"],
                            "loader": "ghul-core/host/loader.mjs"
                        }
                    ]
                }
            }
        },

        // Only the runs built for llvm, which link a native executable with
        // the ghul-llvm on the PATH (build/ghul-llvm.sh fetches it), given
        // the same libraries as wasm. CI runs this one too, with the
        // bootstrapped compiler downloaded into publish/.
        "llvm": {
            "extends": "local",
            "compiler": { "path": "publish/ghul.dll" },
            "run_targets": ["llvm"],
            "targets": {
                "llvm": {
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"],
                            "loader": "ghul-core/host/loader.mjs"
                        }
                    ]
                }
            }
        },

        // The compiler hosted outside .NET: built for wasm and run by Node,
        // for the wasm tests, eight at a time since each holds a whole
        // compiler; and built for llvm, for the llvm tests. Each is built into
        // hosts/<target>/, as build/analysis-tests-on.sh builds it with
        // ANALYSIS_TESTS_ON_DIR naming that directory. Such a compiler reads
        // no assemblies, so it is handed none.
        "host-wasm": {
            "extends": "local",
            "compiler": { "path": "hosts/wasm/ghul.mjs", "reference_assemblies": false },
            "run_targets": ["wasm"],
            "processes": 8
        },

        "host-llvm": {
            "extends": "llvm",
            "compiler": { "path": "hosts/llvm/ghul", "reference_assemblies": false, "fork_server": true }
        },

        // Every test built for llvm by the native compiler in hosts/llvm/,
        // as a contributor without .NET runs the suite. A test whose
        // build_targets leave llvm out is passed over: that is how a test
        // whose point is .NET says so.
        "host-llvm-all": {
            "extends": "host-llvm",
            "build_targets": ["llvm"]
        },

        // CI's integration shards: the freshly built compiler installed as
        // the local tool, and the runtime it ships with. The wasm runs are
        // made by ci-native-o0 instead.
        "ci": {
            "extends": "local",
            "compiler": "tool",
            "runtime": { "path": "bootstrap-tool/ghul-runtime.dll" },
            "run_targets": ["dotnet"]
        },

        // CI's native shards: every test built for llvm by the native
        // compiler CI's llvm lineage builds (its stage 2) in hosts/llvm/,
        // optimised as the compiler does by default.
        "ci-native": {
            "extends": "host-llvm"
        },

        // The same unoptimised, together with every test built for wasm.
        "ci-native-o0": {
            "extends": "ci-native",
            "run_targets": ["llvm", "wasm"],
            "targets": {
                "llvm": {
                    "flags": "--optimise 0",
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"],
                            "loader": "ghul-core/host/loader.mjs"
                        }
                    ]
                }
            }
        },

        // CI's main integration run: every test built for llvm by the native
        // compiler, unoptimised, and every test built for wasm as well. A test
        // whose build_targets leave llvm out is passed over here, and
        // ci-dotnet-only builds it instead. Run with --not-tag llvm-gap: the
        // tests tagged llvm-gap do not pass on llvm yet, and ci builds them.
        "ci-native-all": {
            "extends": "ci-native-o0",
            "build_targets": ["llvm"]
        },

        // CI's .NET run: only the tests whose build_targets name dotnet. A
        // test that gives none is built for llvm here, and passed over.
        "ci-dotnet-only": {
            "extends": "ci",
            "build_targets": ["llvm"]
        },

        // The cross-assembly and source-library suites, built by MSBuild with
        // the published compiler.
        "cross-assembly": {
            "build": "msbuild",
            "compiler": { "path": "publish/ghul.dll" }
        },

        // The same in CI, with the bootstrapped compiler.
        "ci-cross-assembly": {
            "extends": "cross-assembly",
            "compiler": { "path": "bootstrap-tool/ghul.dll" }
        }
    }
}
